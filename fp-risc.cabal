      compiler/cbits/vecgpu.c
      compiler/cbits/handjit.c
      compiler/cbits/native_git.c
      compiler/cbits/native_archive.c
      compiler/cbits/native_host.c
  pkgconfig-depends: libgit2 >= 1.9, libarchive >= 3.6
  if !os(darwin)
    extra-libraries:  EGL GL
  build-depends:
      base          >=4.16 && <5
    , binary
    , deepseq
    , array
    , bytestring
    , containers
    , directory
    , filepath
    , megaparsec   >=9
    , mtl
    , network
    , process
    , text
    , unix
    , time
    , utf8-string

executable fpr
  main-is:            Main.hs
  hs-source-dirs:     app
  default-language:   Haskell2010
  -- -O1 matches the Makefile: the compiler deploys ship and the suites
  -- run (2026-10-18-COMPILER-BUILD-OPT.md found -O2 equal to it);
  -- FPRISC/Sol.Bytecode/Sol.Cache opt in to -O2.  Keep the threaded RTS
  -- for subprocess I/O; a 1 ms tick reduces macOS timer-thread shutdown
  -- latency; a 64 MiB nursery (-A64m, GHC's default is 4 MiB) halves the
  -- compiler's GC time for 64 MiB more peak RSS.  Override with
  -- +RTS -V0.01 -A4m -RTS or GHCRTS.
  ghc-options:        -O1 -rtsopts -threaded "-with-rtsopts=-V0.001 -A64m"
  if flag(dev)
    ghc-options:      -O0
  build-depends:
      base
    , fp-risc

-- The Haskell checks in tests/: `cabal test` builds them against the
-- library once and runs them all.  Frontend and FrameEmitters take
-- arguments from their scripts (check_frontend.py, frame_emitter.py) and
-- stay script-only; the Python checks still drive native execution.
common unit-test
  hs-source-dirs:     tests
  -- GHC2021, as runghc gives the scripts
  default-language:   GHC2021
  ghc-options:        -O0 -w -threaded
  build-depends:
      base          >=4.16 && <5
    , binary
    , deepseq
    , array
    , bytestring
    , containers
    , directory
    , filepath
    , megaparsec   >=9
    , mtl
    , network
    , process
    , text
    , unix
    , time
    , utf8-string
    , fp-risc

test-suite AllocIR

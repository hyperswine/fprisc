cabal-version:      2.4
name:               fp-risc
version:            0.12.0
synopsis:           The FP-RISC compiler: one grammar, five backends, one binary
description:
  fpr -- AOT (rv32/rv64/a64/a64mac/x64/qx64/qa64), the HostedBytecode
  profile (sol: VM + hand-rolled native JIT (x86-64 / A64) + GPU Vec tier + transactional
  runtime), fpr commit/push/pull, and the safety line (Safety.hs).
  .
  The build knowledge that used to live only in the Makefile's fpr
  recipe is declared here: the C shims and the native libraries
  they need.  The Makefile remains the driver for everything cabal was
  never going to do -- cross-compilation, QEMU boots, .qa packaging,
  disk seeding, and the sweep (check-all.sh).  `make fpr-cabal` builds
  through cabal and drops the binary where the sweep expects it.
license:            NONE
author:             Jasen
build-type:         Simple

-- `make fpr-dev` (docs/2026-10-19-COMPILER-DEFAULTS.md): the same
-- compiler built with -O0, in its own cabal build dir (dist-dev) so it
-- never clobbers the default build's objects.  Off by default: the
-- compiler's own rebuilds measured the same at -O0 and -O1, and the
-- -O1 compiler compiles programs twice as fast.
flag dev
  description:        Build the compiler with -O0 (make fpr-dev)
  default:            False
  manual:             True

executable fpr
  main-is:            Main.hs
  hs-source-dirs:     compiler
  default-language:   Haskell2010
  -- -O1 matches the Makefile: the compiler deploys ship and the suites
  -- run (2026-10-18-COMPILER-BUILD-OPT.md found -O2 equal to it);
  -- FPRISC/Sol.Bytecode/Sol.Cache opt in to -O2.  Keep the threaded RTS
  -- for subprocess I/O; a 1 ms tick reduces macOS timer-thread shutdown
  -- latency; a 64 MiB nursery (-A64m, GHC's default is 4 MiB) halves the
  -- compiler's GC time for 64 MiB more peak RSS.  Override with
  -- +RTS -V0.01 -A4m -RTS or GHCRTS.
  ghc-options:        -O1 -rtsopts -threaded "-with-rtsopts=-V0.001 -A64m"
  if flag(dev)
    ghc-options:      -O0
  other-modules:
      A64
      Arc
      Build
      RV64
      Publish
      Representation
      Interrupt
      Codegen
      Codegen.IR
      Codegen.Verify
      Codegen.Dump
      Codegen.Eval
      Codegen.Lower
      Codegen.Policy
      Codegen.Selected
      Codegen.Frame
      Codegen.Place
      Codegen.Liveness
      Codegen.Allocate
      Codegen.Bounds
      Codegen.Target.Common
      Codegen.Target.X64
      Codegen.Target.A64
      KernelKinds
      Workers
      Reuse
      Commit
      Compile
      FPRISC
      Home
      Exhaust
      Infer
      Inline
      ReceiveTurns
      Mono
      Modules
      Peephole
      Precond
      Safety
      Cost
      Manifest
      StdBridge
      StdCheck
      Struct
      Target
      X64
      Sol.Startup
      Sol.Cache
      Sol.Diagnostic
      Sol.Bytecode
      Sol.Gpu
      Sol.HandJIT
      Sol.Infer
      Sol.JitCore
      Sol.KIR
      Sol.AsmX64
      Sol.AsmA64
      Sol.Lang
      Sol.Main
      Sol.Mod
      Sol.Native
      Sol.Preamble
      Sol.Txn
      Sol.VM
      Sol.Val
      Sol.Web
      Sol.WebAssets
      Sol.Width
  c-sources:
      compiler/cbits/fsx.c
      compiler/cbits/vecgpu.c
      compiler/cbits/handjit.c
      compiler/cbits/native_git.c
      compiler/cbits/native_archive.c
      compiler/cbits/native_host.c
  pkgconfig-depends: libgit2 >= 1.9, libarchive >= 3.6
  if !os(darwin)
    extra-libraries:  EGL GL
  build-depends:
      base          >=4.16 && <5
    , binary
    , deepseq
    , array
    , bytestring
    , containers
    , directory
    , filepath
    , megaparsec   >=9
    , mtl
    , network
    , process
    , text
    , unix
    , time
    , utf8-string

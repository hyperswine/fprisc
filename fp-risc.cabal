cabal-version:      2.4
name:               fp-risc
version:            0.12.0
synopsis:           The FP-RISC compiler: one grammar, five backends, one binary
description:
  fpr -- AOT (rv32/rv64/a64/a64mac/x64/qx64/qa64), the HostedBytecode
  profile (sol: VM + hand-rolled native JIT (x86-64 / A64) + GPU Vec tier + transactional
  runtime), fpr commit/push/pull, and the safety line (Safety.hs).
  .
  The build knowledge that used to live only in the Makefile's fpr
  recipe is declared here: the three C shims and the native libraries
  they need.  The Makefile remains the driver for everything cabal was
  never going to do -- cross-compilation, QEMU boots, .qa packaging,
  disk seeding, and the sweep (check-all.sh).  `make fpr-cabal` builds
  through cabal and drops the binary where the sweep expects it.
license:            NONE
author:             Jasen
build-type:         Simple

executable fpr
  main-is:            Main.hs
  hs-source-dirs:     compiler
  default-language:   Haskell2010
  -- -O0 matches the Makefile: this is a working compiler rebuilt many
  -- times a session; flip to -O2 for release measurements
  ghc-options:        -O0
  other-modules:
      A64
      Codegen
      Commit
      Compile
      FPRISC
      Home
      Infer
      Modules
      Precond
      Safety
      StdBridge
      StdCheck
      Struct
      Target
      X64
      Sol.Bytecode
      Sol.Gpu
      Sol.HandJIT
      Sol.Infer
      Sol.JitCore
      Sol.KIR
      Sol.AsmX64
      Sol.AsmA64
      Sol.Lang
      Sol.Main
      Sol.Mod
      Sol.Preamble
      Sol.Txn
      Sol.VM
      Sol.Val
      Sol.Web
      Sol.Width
  c-sources:
      compiler/cbits/fsx.c
      compiler/cbits/vecgpu.c
      compiler/cbits/handjit.c
  if !os(darwin)
    extra-libraries:  EGL GL
  build-depends:
      base          >=4.16 && <5
    , array
    , bytestring
    , containers
    , directory
    , filepath
    , megaparsec   >=9
    , mtl
    , network
    , process
    , time
    , utf8-string

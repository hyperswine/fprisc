# heap.fpr -- the BareMetal-Builtin allocator, in FP-RISC.
#
# The same allocator as heap.c -- single-threaded, coalescing, first-fit,
# a 16-byte meta pair (capacity, reference count) before every payload,
# the ARC release worklist threaded through dead blocks -- written over
# Word/Addr and raw memory only, so it allocates nothing to allocate.
# Compiled as a LIBRARY unit (make ... HEAP=fpr) its exports carry the
# C symbols heap.c defined, and the C runtime, the ARC adapters and the
# program link against it unchanged.
#
# Its one piece of state lives at a linker symbol (Addr.symbol
# "_heap_state", hal/builtin/link.ld): head, low, high.  An FP-RISC unit
# has no globals; a C static is exactly a cell at a link-time address,
# and that is the primitive this file needed and the language now has.
#
# Block header, 64 bytes, then the 16-byte meta pair, then the payload:
#     0 size   8 prev   16 next   24 used   32 fields   40 pending
#    48 layout 56 (pad) 64 meta.capacity 72 meta.rc   80 payload
# Sizes and counts are compared as Ints (Word.toInt keeps 63 bits, which
# is every size and address this machine has); pointers with Addr.eq.
#
# One grammar rule this file lives by: a `case` is never written inside
# a NON-FINAL arm of another case without parentheses.  The arms that
# follow it attach to the inner case, and the outer one is left with
# one arm -- a runtime "no matching pattern", not a parse error (the
# first cut's realloc died exactly so).  Every nested decision here is a
# helper function, which also reads better.

# ---- words, addresses, the state cell -------------------------------------------------
w n = Word.fromInt n.
i x = Word.toInt x.
rd a o = Mem.readWord (Addr.add a o).
wr a o v = Mem.writeWord (Addr.add a o) v.
rdA a o = Addr.fromWord (Mem.readWord (Addr.add a o)).
wrA a o p = Mem.writeWord (Addr.add a o) (Addr.toWord p).
nil u = Addr.null Unit.
isNil p = Addr.eq p (Addr.null Unit).
notB b = case b of True -> False | False -> True.
both a b = case a of True -> b | False -> False.
st u = Addr.symbol "_heap_state".
headB u = rdA (st Unit) 0.
low u = rd (st Unit) 8.
high u = rd (st Unit) 16.
alignUp x = Word.and (Word.add x (w 15)) (Word.not (w 15)).
prefix u = 80.

# block fields
sizeOf b = rd b 0.
prev b = rdA b 8.
next b = rdA b 16.
used b = i (rd b 24) != 0.
fields b = i (rd b 32).
layout b = rdA b 48.
rc b = rd b 72.
payload b = Addr.add b 80.
blockOf p = Addr.add p (0 - 80).

zeroWords a n = case n <= 0 of
    True -> Unit
  | False ->
    _ = Mem.writeWord a (w 0);
    zeroWords (Addr.add a 8) (n - 1).
copyWords dst src n = case n <= 0 of
    True -> Unit
  | False ->
    _ = Mem.writeWord dst (Mem.readWord src);
    copyWords (Addr.add dst 8) (Addr.add src 8) (n - 1).

# ---- init ------------------------------------------------------------------------------
heapInit : Addr -> Addr -> Unit .
heapInit start end =
  lo = alignUp (Addr.toWord start);
  hi = Word.and (Addr.toWord end) (Word.not (w 15));
  _ = case i hi <= i lo of True -> error "Builtin: heap too small" | False -> Unit;
  _ = case i (Word.sub hi lo) < 96 of True -> error "Builtin: heap too small" | False -> Unit;
  h = Addr.fromWord lo;
  _ = zeroWords h 8;
  _ = wr h 0 (Word.sub hi lo);
  _ = wr (st Unit) 0 lo;
  _ = wr (st Unit) 8 lo;
  wr (st Unit) 16 hi.

# ---- queries ---------------------------------------------------------------------------
# a live heap payload: not a tagged Int, inside [low + prefix, high)
inHeap : Addr -> Bool .
inHeap v =
  x = Addr.toWord v;
  case Word.bitTest x 0 of
    True -> False
  | False -> both (i x >= i (low Unit) + 80) (i x < i (high Unit)).

# the block owning a live payload, or a panic: the C `find`
findFrom b v = case isNil b of
    True -> error "Builtin: invalid allocation pointer"
  | False -> findHere b v.
findHere b v = case both (Addr.eq (payload b) v) (used b) of
    True -> b
  | False -> findFrom (next b) v.
find v = findFrom (headB Unit) v.

liveAllocations : Unit -> Word .
liveAllocations u = w (countUsed (headB Unit) 0).
countUsed b n = case isNil b of
    True -> n
  | False -> countUsed (next b) (case used b of True -> n + 1 | False -> n).

# ---- alloc / free / realloc -----------------------------------------------------------
split b size = case i (Word.sub (sizeOf b) size) < 96 of
    True -> Unit
  | False ->
    n = Addr.add b (i size);
    _ = zeroWords n 8;
    _ = wr n 0 (Word.sub (sizeOf b) size);
    _ = wrA n 8 b;
    _ = wrA n 16 (next b);
    _ = linkBack (next b) n;
    _ = wrA b 16 n;
    wr b 0 size.
linkBack nb n = case isNil nb of True -> Unit | False -> wrA nb 8 n.

claim b size =
  _ = split b size;
  _ = wr b 24 (w 1);
  _ = wr b 32 (w 0);
  _ = wr b 40 (w 0);
  _ = wr b 48 (w 0);
  _ = wr b 64 (Word.sub (sizeOf b) (w 64));
  _ = wr b 72 (w 1);
  p = payload b;
  _ = zeroWords p ((i (sizeOf b) - 80) / 8);
  p.

firstFit b size = case isNil b of
    True -> error "Builtin: out of memory"
  | False -> fitHere b size.
fitHere b size = case both (notB (used b)) (i (sizeOf b) >= i size) of
    True -> claim b size
  | False -> firstFit (next b) size.

alloc : Word -> Addr .
alloc bytes =
  _ = case Word.bitTest bytes 62 of True -> error "Builtin: allocation overflow" | False -> Unit;
  _ = case Word.bitTest bytes 63 of True -> error "Builtin: allocation overflow" | False -> Unit;
  size0 = Word.add (w 80) (alignUp bytes);
  size = case Word.eq size0 (w 80) of True -> w 96 | False -> size0;
  firstFit (headB Unit) size.

merge b =
  n = next b;
  case isNil n of
    True -> Unit
  | False -> mergeNext b n.
mergeNext b n = case used n of
    True -> Unit
  | False -> absorb b n.
absorb b n =
  _ = wr b 0 (Word.add (sizeOf b) (sizeOf n));
  _ = wrA b 16 (next n);
  linkBack (next n) b.

free : Addr -> Unit .
free v = case isNil v of
    True -> Unit
  | False -> freeLive (find v).
# (a panic's text must be a LITERAL at the call: a raw unit is checked
# allocation-free, and `error` through a variable cannot be)
freeLive b =
  _ = case Word.eq (rc b) (w 1) of True -> Unit | False -> error "Builtin: free of shared allocation";
  _ = wr b 24 (w 0);
  _ = merge b;
  mergePrev (prev b).
mergePrev p = case isNil p of
    True -> Unit
  | False -> mergeIfFree p.
mergeIfFree p = case used p of True -> Unit | False -> merge p.

# (a `case` arm whose body is a `_ = e; body` block takes the arms after
# it into the block, so the blocks live in helpers)
freeNull v = _ = free v; Addr.null Unit.
realloc : Addr -> Word -> Addr .
realloc v bytes = case isNil v of
    True -> allocOrNull bytes
  | False -> reallocLive (find v) v bytes.
allocOrNull bytes = case Word.eq bytes (w 0) of True -> Addr.null Unit | False -> alloc bytes.
reallocLive b v bytes =
  _ = case Word.eq (rc b) (w 1) of True -> Unit | False -> error "Builtin: realloc of shared allocation";
  case Word.eq bytes (w 0) of
    True -> freeNull v
  | False -> grow b v bytes.
grow b v bytes =
  cap = Word.sub (sizeOf b) (w 80);
  case i bytes <= i cap of
    True -> v
  | False -> move v bytes (i cap).
move v bytes cap =
  n = alloc bytes;
  _ = copyWords n v (cap / 8);
  _ = free v;
  n.

# ---- ownership -------------------------------------------------------------------------
retain : Addr -> Addr .
retain v = case inHeap v of
    False -> v
  | True -> retainLive (find v) v.
retainLive b v =
  _ = case Word.eq (rc b) (Word.not (w 0)) of True -> error "Builtin: reference count overflow" | False -> Unit;
  _ = wr b 72 (Word.add (rc b) (w 1));
  v.

allocAdt : Word -> Word -> Addr .
allocAdt bytes n =
  _ = case i bytes < 8 of True -> error "Builtin: invalid ADT layout" | False -> Unit;
  _ = case i n > (i bytes - 8) / 8 of True -> error "Builtin: invalid ADT layout" | False -> Unit;
  v = alloc bytes;
  _ = wr (blockOf v) 32 n;
  v.

# ARC release: the worklist is threaded through the dead blocks' own
# `pending` words -- no recursion, no allocation, no queue capacity.  A
# queued block stays allocated until its fields have been visited.
release : Addr -> Unit .
release v = drain (enqueue v (Addr.null Unit)).

enqueue v work = case inHeap v of
    False -> work
  | True -> enqueueLive (find v) work.
enqueueLive b work =
  _ = case Word.eq (rc b) (w 0) of True -> error "Builtin: duplicate ownership or cycle" | False -> Unit;
  left = Word.sub (rc b) (w 1);
  _ = wr b 72 left;
  case Word.eq left (w 0) of
    True -> push b work
  | False -> work.
push b work = _ = wrA b 40 work; b.

drain work = case isNil work of
    True -> Unit
  | False ->
    b = work;
    rest = rdA b 40;
    rest2 = visit b (Addr.add (payload b) 8) 0 (fields b) rest;
    _ = wr b 72 (w 1);
    _ = free (payload b);
    drain rest2.

# field k of block b holds an owning edge when the layout says 't' (or
# there is no layout: every field managed)
visit b fp k n work = case k >= n of
    True -> work
  | False -> visit b (Addr.add fp 8) (k + 1) n (visitField (layout b) fp k work).
visitField lay fp k work = case isManaged lay k of
    True -> enqueue (rdA fp 0) work
  | False -> work.
isManaged lay k = case isNil lay of
    True -> True
  | False -> Mem.read8 (Addr.add lay (16 + k)) == 116.

# ---- layouts ---------------------------------------------------------------------------
setLayout : Addr -> Addr -> Unit .
setLayout v descriptor =
  b = find v;
  _ = case Word.eq (Mem.read32 descriptor) (w 9000) of True -> Unit | False -> error "Builtin: invalid field descriptor";
  _ = case i (rd descriptor 8) == fields b of True -> Unit | False -> error "Builtin: invalid field descriptor";
  wrA b 48 descriptor.

fieldCount : Addr -> Word .
fieldCount v = w (fields (find v)).

fieldKind : Addr -> Word -> Word .
fieldKind v k =
  b = find v;
  _ = case i k >= fields b of True -> error "Builtin: field index out of range" | False -> Unit;
  kindIn (layout b) (i k).
kindIn lay k = case isNil lay of
    True -> w 116
  | False -> w (Mem.read8 (Addr.add lay (16 + k))).

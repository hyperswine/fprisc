-- macOS with Homebrew: copy to cabal.project.local, then run cabal build.
-- Install the native dependencies with: brew install pkgconf libgit2 libarchive
-- libarchive is keg-only. Cabal's solver needs its pkg-config metadata;
-- extra-lib-dirs alone does not satisfy pkgconfig-depends.
-- The wrapper supports Apple Silicon and Intel Homebrew prefixes.
program-locations
  pkg-config-location: tools/pkg-config-homebrew

-- Optional per-package knobs:
-- package fp-risc
--   profiling: True

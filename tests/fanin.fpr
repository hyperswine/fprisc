# fanin.fpr -- many senders into one hub: the actor runtime's shared
# overflow ring (past the 7 dedicated per-sender channels) must keep
# every reply addressed: each client's receiveFrom must see ITS reply.
unsafe program.

Q = Type (Ask who k | Reply who k | Done who).

hub me = hubLoop me 0.
hubLoop me n =
  m = receive me;
  _ = drop m;
  case m of
    Ask who k -> _ = send who (Reply who k); hubLoop me (n + 1)
  | o -> hubLoop me n.

client hub boss me = clLoop hub boss me 0.
clLoop hub boss me k | k >= 1500 = _ = send boss (Done me); k.
clLoop hub boss me k =
  _ = send hub (Ask me k);
  r = receiveFrom me hub;
  Reply who k2 = r;
  _ = drop r;
  _ = case who == me of True -> 0 | False -> error "fanin: reply addressed to another client";
  _ = case k2 == k of True -> 0 | False -> error "fanin: reply out of order";
  _ = case k % 97 == 0 of True -> yield me | False -> 0;
  clLoop hub boss me (k + 1).

spawnAll hub boss n k | k >= n = 0.
spawnAll hub boss n k =
  _ = spawnOn (1 + k % (Sys.harts Unit - 1)) (client hub boss);
  spawnAll hub boss n (k + 1).

waitAll me n | n == 0 = 0.
waitAll me n = m = receive me; _ = drop m; waitAll me (n - 1).

main =
  me = myself 0;
  h = spawn hub;
  _ = spawnAll h me 40 0;
  _ = waitAll me 40;
  "fanin: ok, 40 clients x 1500 addressed replies through one hub".

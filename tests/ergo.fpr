# ergonomics probe: arm bindings, lambda bindings, negative literals
classify v = case v > 0 of
    True ->
      d = v * 2;
      lbl = "pos";
      (lbl, d)
  | False ->
      d = v * 3;
      (case v == 0 of True -> "zero" | False -> "neg", d).

main =
  a = -5;
  b = -2.5;
  c = -3f;
  f = fn x ->
        y = x + 1;
        y * y;
  (l1, d1) = classify 4;
  (l2, d2) = classify a;
  (l3, d3) = classify 0;
  neg = a * -1 + (0 - a) * 2;   # tight literal in arg position
  fneg = F64.str (b * -2.0);
  "ergo: {l1}{d1} {l2}{d2} {l3}{d3} f5={f 5} neg={neg} fneg={fneg} f32={F32.str c}".

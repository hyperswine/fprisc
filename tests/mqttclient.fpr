unsafe base.
Q = use "../std/mqtt".
TLS = use "../std/tls".
T = use "../std/transport".
R = use "../std/readiness".
P = use "../std/program".
String = use "../std/string".
L = use "../std/list".
need r = case r of Ok x -> x | Err why -> error "MQTT client fixture: {why}".
check why yes = if yes then Unit else error "MQTT client fixture: {why}".
exercise mode conn =
  config = need (if String.contains "auth" mode or String.contains "reject" mode then Q.configAuth (Q.UserPassword "fpr-test" (if String.contains "reject" mode then "wrong-test-only" else "test-only")) "fpr-native-test" False 1 2000 8 else Q.config "fpr-native-test" False 1 2000 8);
  client = need (Q.create config 65536 4096 conn);
  limit = need (T.forMs 4000);
  (_, c1) = Q.begin limit client;
  (connected, c2) = Q.next limit c1;
  _ = if String.contains "reject" mode then
    _ = check "real broker rejects invalid authentication" (L.any (fn effect -> case effect of Q.Down _ _ -> True | _ -> False) (need connected) and c2.session.phase == Q.Offline);
    P.exit 0
  else Unit;
  _ = check "broker CONNACK" (L.any (fn effect -> case effect of Q.Up _ _ -> True | _ -> False) (need connected));
  (_, c3) = Q.subscribe limit [("fpr-test/#",1)] c2;
  (subscribed, c4) = Q.next limit c3;
  _ = check "broker SUBACK" (need subscribed == [Q.Subscribed 1 [1]]);
  (_, c5) = Q.publish limit "fpr-test/echo" "native payload" 1 False c4;
  c6 = deliveries limit c5 False False;
  before = c6.session.lastSent;
  (idle, c7) = Q.next (need (T.forMs 1500)) c6;
  _ = check "idle TLS/TCP keepalive remains online" (need idle == Nil and c7.session.phase == Q.Online and c7.session.lastSent > before);
  (stopped, _) = Q.stop (need (T.forMs 1000)) c7;
  _ = need stopped;
  Unit.
deliveries budget client gotAck gotPayload = if gotAck and gotPayload then client else
  (result, next) = Q.next budget client;
  notes = need result;
  _ = check "expected QoS1 notices before budget" (notes != Nil);
  ack = gotAck or L.any (fn effect -> case effect of Q.Acked 2 -> True | _ -> False) notes;
  payload = gotPayload or L.any (fn effect -> case effect of Q.Delivered "fpr-test/echo" "native payload" 1 _ _ -> True | _ -> False) notes;
  deliveries budget next ack payload.
main = case P.args Unit of
    [portText, roots, mode] ->
      port = need (String.toInt portText);
      pool = need (T.resolverCreate 2);
      p = R.start Unit;
      tcp = need (T.connectWith (T.watchWait p) (need (T.forMs 2000)) pool "127.0.0.1" port 16384);
      _ = if String.startsWith "tls" mode then
        secure = need (TLS.upgrade (need (T.forMs 2000)) "server.example" (TLS.CaFile roots) TLS.TLS12 tcp);
        exercise mode secure
      else exercise mode tcp;
      _ = R.stop p;
      _ = need (T.resolverClose pool);
      print "MQTT {mode}: broker subscribe/publish/QoS1 echo and idle keepalive PASS"
  | _ -> error "MQTT fixture needs port roots mode".

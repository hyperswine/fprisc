# bigfree.fpr -- big blocks come back: the "larger blocks leak by
# design in this PoC" allocator rule, retired.
#
# Blocks above the bucket ceiling (16 * FPR_NBUCKETS = 8 KiB) used to
# stay bump-allocated in their slab until actor death -- so an
# IMMORTAL actor that builds and frees big Vec columns (whose VList
# blocks double past 8 KiB immediately at this size) bled the arena
# every cycle: ~40 cycles of a 100k-int vector leaked tens of MB.
# Now fpr_free pushes them onto the pool's exact-fit bigfree LIFO and
# fpr_alloc reuses them, so the arena stops growing after the first
# cycle warms the free list.
#
#   make qos-app PROG=tests/bigfree.fpr
#   (cd ../qos && make portable && ./qosp --yes ../fp-risc/app.qa)
#
# Expected: "BIGFREE HOLDS: ..." with the arena flat across 40 cycles.

fill : (n : Int | measure n) -> Vector -> Vector .
fill n v = case n <= 0 of True -> v | False -> fill (n - 1) (Vec.push n v).

cycle : (k : Int | measure k) -> Int -> Int .
cycle k acc | k <= 0 = acc.
cycle k acc =
  v = fill 100000 (Vec.new Unit);
  (s, v2) = Vec.fold addI 0 v;
  _ = Vec.free v2;
  cycle (k - 1) (acc + s).
addI : Int -> Int -> Int .
addI a b = a + b.

main =
  a0 = cycle 3 0;                      # warm-up: reach steady state
  (g1, mb1) = Sys.memStats 0;
  a1 = cycle 40 0;
  (g2, mb2) = Sys.memStats 0;
  ok = case mb2 <= mb1 + 1 of True -> 1 | False -> 0;
  case ok == 1 of
    True -> "BIGFREE HOLDS: 40 cycles of 100k-int vec build+free, arena {mb1}MB -> {mb2}MB (sum {a1})"
  | False -> "BIGFREE FAILED: arena grew {mb1}MB -> {mb2}MB".

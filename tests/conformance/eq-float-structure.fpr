# clause: v1.0 semantics §5 (equality). `==` is structural to any depth, and a
# float inside a tuple, list, record or polymorphic comparison follows IEEE.
eq : a -> a -> Bool.
eq x y = x == y.
main =
  r1 = {a = 1.5, b = 2};
  r2 = {a = 1.5, b = 2};
  _ = print "{(1, 1.5) == (1, 1.5)}";
  _ = print "{[1.5, 2.5] == [1.5, 2.5]}";
  _ = print "{r1 == r2}";
  _ = print "{(1, 1.5) == (1, 2.5)}";
  print "{eq 1.5 1.5}".

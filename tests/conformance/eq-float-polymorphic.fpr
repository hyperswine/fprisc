# clause: v1.0 semantics §5 (equality). A polymorphic `==` instantiated at a
# float must not crash. Today it does (exit 139): a type variable cannot be
# refused at its definition, and the runtime cannot recognise raw float bits.
eq : a -> a -> Bool.
eq x y = x == y.
main = print "{eq (1, 1.5) (1, 1.5)}".

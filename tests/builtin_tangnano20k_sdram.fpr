profile builtin.
check ok = case ok of True -> Unit | False -> error "SDRAM builtin check failed".
writePages p n = case n == 32 of True -> Unit | False ->
  _ = Mem.writeWord (Addr.add p (n * 65536)) (Word.fromInt (n + 12345));
  writePages p (n + 1).
readPages p n = case n == 32 of True -> Unit | False ->
  _ = check (Word.eq (Mem.readWord (Addr.add p (n * 65536))) (Word.fromInt (n + 12345)));
  readPages p (n + 1).
main =
  _ = print "SDRAM ALLOC START";
  p = Mem.alloc 2097152;
  _ = print "SDRAM ALLOC COMPLETE";
  _ = writePages p 0;
  _ = readPages p 0;
  _ = Mem.write8 (Addr.add p 2097151) 171;
  _ = check (Mem.read8 (Addr.add p 2097151) == 171);
  _ = Mem.free p;
  print "SDRAM FP-RISC 2MiB HOLDS".

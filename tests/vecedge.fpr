# vecedge.fpr -- interaction probes for the Vec/SoA/lens/fusion cluster:
# every claim in docs/VEC.md that involves TWO features at once, plus
# the edges.  Verdict style: each leg prints ok/FAIL, final line seals.

Pt = Type (Pt a b).   # an ADT CONSTRUCTOR (not a record): boxed rows

mkR i = {x = i, y = i * 2}.
mkN i = {pose = {x = i, y = i + 1}, hp = 100 + i}.
mk5 i = {a = i, b = i + 1, c = i + 2, d = i + 3, e = i + 4}.

fillR : Vector -> (i : Int | measure (lim - i)) -> (lim : Int) -> Vector .
fillR v i lim | i > lim = v.
fillR v i lim = fillR (Vec.push (mkR i) v) (i + 1) lim.
fillT : Vector -> (i : Int | measure (lim - i)) -> (lim : Int) -> Vector .
fillT v i lim | i > lim = v.
fillT v i lim = fillT (Vec.push (i, i * i) v) (i + 1) lim.
fillC : Vector -> (i : Int | measure (lim - i)) -> (lim : Int) -> Vector .
fillC v i lim | i > lim = v.
fillC v i lim = fillC (Vec.push (Pt i (i + 5)) v) (i + 1) lim.
fillN : Vector -> (i : Int | measure (lim - i)) -> (lim : Int) -> Vector .
fillN v i lim | i > lim = v.
fillN v i lim = fillN (Vec.push (mkN i) v) (i + 1) lim.
fill5 : Vector -> (i : Int | measure (lim - i)) -> (lim : Int) -> Vector .
fill5 v i lim | i > lim = v.
fill5 v i lim = fill5 (Vec.push (mk5 i) v) (i + 1) lim.
fillI : Vector -> (i : Int | measure (lim - i)) -> (lim : Int) -> Vector .
fillI v i lim | i > lim = v.
fillI v i lim = fillI (Vec.push i v) (i + 1) lim.

# named element fns (candidates for notes/duals)
f1 v = v * 3 + 1.
f2 v = v - 2.
f3 v = v * 2.
bumpN p = {p | pose.x = p.pose.x + 10}.       # nested lens in a map
bump5 p = {p | a = p.a * 2, e = p.e + 1}.     # 5-field record map
sumR a p = a + p.x * 10 + p.y.
matchElem p = case p of Pt a b -> a + b.       # pattern-matching elem fn

lsum : (l : List _ | measure l) -> Int -> Int .
lsum l acc = case l of Nil -> acc | p :: r -> lsum r (acc + p.x + p.y).

verdict n b = case b of True -> print "ok {n}" | False -> print "FAIL {n}".

r3 : (i : Int | measure (lim - i)) -> (lim : Int) -> Int .
r3 i lim | i > lim = 0.
r3 i lim = ((i * 3 + 1 - 2) * 2) + r3 (i + 1) lim.

main =
  # 1. records SoA -> get -> PROJECT -> reconstruct -> push back (AoS round trip)
  a1 = fillR (Vec.new Unit) 1 100;
  (p, a2) = Vec.get 7 a1;
  u1 = verdict "soa-get-project" (p.x == 7);
  a3 = Vec.push {x = p.x + 1000, y = p.y} a2;
  (n1, a4) = Vec.len a3;
  (q, a5) = Vec.get n1 a4;
  u2 = verdict "soa-pushback" (q.x == 1007);
  _ = Vec.free a5;

  # 2. tuples SoA -> get -> destructure
  b1 = fillT (Vec.new Unit) 1 50;
  (t, b2) = Vec.get 6 b1;
  (ta, tb) = t;
  u3 = verdict "tuple-soa-destructure" (ta + tb == 6 + 36);
  _ = Vec.free b2;

  # 3. ADT constructor rows -> get -> CASE MATCH back
  c1 = fillC (Vec.new Unit) 1 50;
  (pc, c2) = Vec.get 9 c1;
  m = case pc of Pt a b -> a * 100 + b;
  u4 = verdict "adt-get-match" (m == 914);
  cm = Vec.map matchElem c2;              # pattern-matching elem fn: generic tier
  (mv, cm2) = Vec.get 9 cm;
  u5 = verdict "adt-map-match" (mv == 23);
  _ = Vec.free cm2;

  # 4. nested records + nested lens through Vec.map
  d1 = fillN (Vec.new Unit) 1 50;
  d2 = Vec.map bumpN d1;
  (nd, d3) = Vec.get 5 d2;
  u6 = verdict "nested-lens-map" (nd.pose.x == 15);
  u7 = verdict "nested-untouched" (nd.pose.y == 6);
  u8 = verdict "nested-flat-field" (nd.hp == 105);
  _ = Vec.free d3;

  # 5. SoA -> toList (AoS cons cells) -> walk with projections
  e1 = fillR (Vec.new Unit) 1 20;
  el = Vec.toList e1;
  u9 = verdict "soa-tolist" (lsum el 0 == 20 * 21 / 2 * 3);

  # 6. fromList of records -> SoA vec -> get
  g1 = Vec.fromList (mkR 4 :: mkR 8 :: Nil);
  (gp, g2) = Vec.get 2 g1;
  u10 = verdict "fromlist-soa" (gp.y == 16);
  _ = Vec.free g2;

  # 7. THREE-map chain: outer pair fuses, all three apply
  h1 = fillI (Vec.new Unit) 1 200;
  h2 = Vec.map f3 (Vec.map f2 (Vec.map f1 h1));
  (hs, h3) = Vec.fold (fn a x -> a + x) 0 h2;
  u11 = verdict "three-chain" (hs == r3 1 200);
  _ = Vec.free h3;

  # 8. fold-of-map (must NOT fuse; map writes visible after)
  i1 = fillI (Vec.new Unit) 1 100;
  (is, i2) = Vec.fold (fn a x -> a + x) 0 (Vec.map f1 i1);
  (iv, i3) = Vec.get 100 i2;
  u12 = verdict "fold-of-map-sum" (is == 100 * 101 / 2 * 3 + 100);
  u13 = verdict "fold-of-map-writes" (iv == 301);
  _ = Vec.free i3;

  # 9. record filter (compaction over columns) then map then fold
  j1 = fillR (Vec.new Unit) 1 100;
  j2 = Vec.filter (fn p -> p.x > 90) j1;
  j3 = Vec.map (fn p -> {p | y = p.y + 1}) j2;
  (js, j4) = Vec.fold sumR 0 j3;
  (jn, j5) = Vec.len j4;
  u14 = verdict "rec-filter-map-fold" (js == 91 * 10 + 183 + 92 * 10 + 185 + 93 * 10 + 187 + 94 * 10 + 189 + 95 * 10 + 191 + 96 * 10 + 193 + 97 * 10 + 195 + 98 * 10 + 197 + 99 * 10 + 199 + 100 * 10 + 201);
  u15 = verdict "rec-filter-len" (jn == 10);
  _ = Vec.free j5;

  # 10. 5-field record map: SoA storage, generic-tier map (note expected)
  k1 = fill5 (Vec.new Unit) 1 30;
  k2 = Vec.map bump5 k1;
  (k5, k3) = Vec.get 30 k2;
  u16 = verdict "five-field-map" (k5.a == 60);
  u17 = verdict "five-field-e" (k5.e == 35);
  _ = Vec.free k3;

  # 11. empty vec: map / fold / filter on a never-pushed vector
  m1 = Vec.map f1 (Vec.new Unit);
  (ms, m2) = Vec.fold (fn a x -> a + x) 0 m1;
  m3 = Vec.filter (fn x -> x > 0) m2;
  (mn, m4) = Vec.len m3;
  u18 = verdict "empty-map-fold-filter" (ms + mn == 0);
  _ = Vec.free m4;

  print "VEC EDGES DONE".

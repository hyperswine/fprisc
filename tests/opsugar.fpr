# opsugar.fpr -- the ordinary operators on ordinary types, backed by
# PRELUDE code (Str/List structs), not per-example helpers:
#   +  Str/List concatenation        -  deconcatenation (suffix removal)
# Laws checked: (a + b) - b == a, and a - x == a when x is not a suffix.
# SAFE by construction: the prelude fold scheme carries the recursion,
# |> carries the value -- no custom recursion, no marker, no parens.
sumL l = l |> listFold (fn x acc -> x * 10 + acc) 0 .
doubleSum l = l |> List.map (fn x -> x * 2) |> List.fold (fn x acc -> x + acc) 0 .
# head-clause pattern guard (the preferred shape over nested case)
headOr d l | x :: _ <- l = x.
headOr d l = d.
verdict b = case b of True -> "OPS AGREE" | False -> "OPS MISMATCH".
boom b = case b of True -> error "boolean operator failed to short-circuit" | False -> False.
bounded : (n : Int | n >= 0 and n <= 10) -> Int .
bounded n = n.
main =
  a = "fold" + "ability";
  b = a - "ability";
  c = a - "zzz";
  xs = [1, 2] + [3, 4];
  ys = xs - [3, 4];
  zs = xs - [9];
  _ = print "str: {a} / {b} / {c}";
  _ = print $ "head: {headOr 0 xs} (guard-bound) empty-falls-back: {headOr 42 []}";
  _ = print "list: {sumL xs} / {sumL ys} / {sumL zs}";
  ok1 = a == "foldability";
  ok2 = b == "fold";
  ok3 = c == "foldability";
  ok4 = sumL xs == 100;
  ok5 = sumL ys == 30;
  ok6 = sumL zs == 100;
  _ = print (verdict (ok1 == True));
  _ = print (verdict (ok2 == ok3));
  _ = print (verdict (ok4 == ok5 == ok6 == True));
  _ = print (verdict (True or False and boom True));
  _ = print (verdict (doubleSum xs == 20));
  _ = print (verdict (([True, True, False] |> List.fold (and) True) == False));
  _ = print (verdict (bounded 5 == 5));
  0 .

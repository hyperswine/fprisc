# measure.fpr -- DECLARED TERMINATION MEASURES: the user names what
# decreases, the compiler verifies it, and `unsafe` disappears.
#
#   (l : List a | measure l)         structural: every self-call passes
#                                    a strict subterm bound by pattern
#                                    matching
#   (n : Int | measure n)            linear countdown: decreases by >=1
#                                    per call, FLOOR (measure >= 0)
#                                    derived from the base guard
#   (i : Int | measure (lim - i))    an EXPRESSION over params: count-up
#                                    loops measured by remaining span,
#                                    floor from the body's case guard
#
# NO unsafe marker appears in this file; every recursive function is
# PROVEN terminating, with the bound measure(entry) iterations -- the
# "explicit-measure kind" of recursion docs/SAFETY.md sanctions,
# promoted from the std proof pass into the main compile.  The
# check-all leg also asserts both REFUSALS: a non-decreasing measure
# and a floorless countdown are loud compile errors.

lsum : (l : List Int | measure l) -> Int -> Int .
lsum l acc = case l of Nil -> acc | h :: r -> lsum r (acc + h).

fact : (n : Int | measure n) -> Int -> Int .
fact n acc | n <= 0 = acc.
fact n acc = fact (n - 1) (acc * n).

sumTo : Int -> (i : Int | measure (lim - i)) -> Int -> Int .
sumTo lim i acc = case i > lim of
    True -> acc
  | False -> sumTo lim (i + 1) (acc + i).

main = "measure: {lsum [1,2,3,4] 0} {fact 5 1} {sumTo 10 1 0} (zero unsafe markers)".

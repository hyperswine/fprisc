profile builtin.
Tree = Type (Empty | Node value left right).
check ok = case ok of True -> Unit | False -> error "tree stress check failed".
build lo hi = case lo > hi of True -> Empty | False ->
  mid = (lo + hi) / 2;
  Node mid (build lo (mid - 1)) (build (mid + 1) hi).
sum tree = case tree of Empty -> 0 | Node value left right -> value + sum left + sum right.
rounds n = case n == 0 of True -> Unit | False ->
  before = Mem.liveAllocations Unit;
  tree = build 1 447;
  _ = check (Mem.liveAllocations Unit == before + 447);
  _ = check (sum tree == 100128);
  _ = Rc.release tree;
  _ = check (Mem.liveAllocations Unit == before);
  rounds (n - 1).
main = _ = print "BEGIN tree"; _ = rounds 8; print "TREE nodes=447 rounds=8 sum=100128".

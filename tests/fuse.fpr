# fuse.fpr — stream fusion v1 + capture-free record-map specialization.
#
#   * adjacent Vec.map passes collapse into ONE specialized column loop
#     (`Vec.map f (Vec.map g v)` and the let-pipeline spelling both);
#     the composite is a real supercombinator, so scalar AND record
#     duals fuse through the unchanged machinery
#   * a 1-ary record -> record map (no capture) now takes the in-place
#     SoA loop -- including `{p | x = ...}` lens-style update lowering,
#     without writing axpb by hand
#   * heapUsed deltas are the EXECUTION witnesses: the specialized
#     loops mutate columns in place (delta ~0), the generic tier would
#     rebuild the vector per pass

P2 = {x : Int, y : Int}.

scaleUp v = v * 3 + 1.
shiftDn v = v - 2.

bump p = {p | x = 2 * p.x + 1, y = p.y - 4}.
swirl p = {x = p.x + p.y, y = p.x - p.y}.

fillI : Vector -> (i : Int | measure (lim - i)) -> Int -> Vector .
fillI v i lim | i > lim = v.
fillI v i lim = fillI (Vec.push i v) (i + 1) lim.

fillP : Vector -> (i : Int | measure (lim - i)) -> Int -> Vector .
fillP v i lim | i > lim = v.
fillP v i lim = fillP (Vec.push {x = i, y = i * 3} v) (i + 1) lim.

sumI vv = Vec.fold (fn a x -> a + x) 0 vv .
sumP vv = Vec.fold (fn a p -> a + p.x * 5 + p.y) 0 vv .

# scalar reference for the fused scalar pipeline: shiftDn (scaleUp i)
refI : (i : Int | measure (lim - i)) -> Int -> Int .
refI i lim | i > lim = 0.
refI i lim = (i * 3 + 1 - 2) + refI (i + 1) lim.

# record reference for the fused record pipeline: swirl (bump p)
refP : (i : Int | measure (lim - i)) -> Int -> Int .
refP i lim | i > lim = 0.
refP i lim =
  bx = 2 * i + 1;
  by = i * 3 - 4;
  (bx + by) * 5 + (bx - by) + refP (i + 1) lim.

verdict n b = case b of True -> print "ok {n}" | False -> error "FAIL {n}".

main =
  # ---- scalar map . map, nested spelling ----
  a1 = fillI (Vec.new Unit) 1 4000;
  h0 = heapUsed Unit;
  a2 = Vec.map shiftDn (Vec.map scaleUp a1);
  h1 = heapUsed Unit;
  (s1, a3) = sumI a2;
  _ = Vec.free a3;
  u0 = verdict "fused-scalar-nested" (s1 == refI 1 4000);
  u1 = verdict "fused-scalar-inplace" (h1 - h0 < 4096);

  # ---- scalar map . map, let-pipeline spelling ----
  b1 = fillI (Vec.new Unit) 1 4000;
  b2 = Vec.map scaleUp b1;
  b3 = Vec.map shiftDn b2;
  (s2, b4) = sumI b3;
  _ = Vec.free b4;
  u2 = verdict "fused-scalar-pipeline" (s2 == refI 1 4000);

  # ---- capture-free record map: the point-8 shape, no axpb spelled ----
  c1 = fillP (Vec.new Unit) 1 4000;
  h2 = heapUsed Unit;
  c2 = Vec.map bump c1;
  h3 = heapUsed Unit;
  (s3, c3) = sumP c2;
  _ = Vec.free c3;
  u3 = verdict "record-map0" (s3 == refP0 1 4000);
  u4 = verdict "record-map0-inplace" (h3 - h2 < 4096);

  # ---- record map . map: the composite goes through the SoA dual ----
  d1 = fillP (Vec.new Unit) 1 4000;
  h4 = heapUsed Unit;
  d2 = Vec.map swirl (Vec.map bump d1);
  h5 = heapUsed Unit;
  (s4, d3) = sumP d2;
  _ = Vec.free d3;
  u5 = verdict "fused-record" (s4 == refP 1 4000);
  u6 = verdict "fused-record-inplace" (h5 - h4 < 4096);
  print "FUSION HOLDS".

# reference for the un-fused record single map: sumP of bump
refP0 : (i : Int | measure (lim - i)) -> Int -> Int .
refP0 i lim | i > lim = 0.
refP0 i lim = (2 * i + 1) * 5 + (i * 3 - 4) + refP0 (i + 1) lim.

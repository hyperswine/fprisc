unsafe base.
R9 = { f0:Int, f1:Int, f2:Int, f3:Int, f4:Int, f5:Int, f6:Int, f7:Int, f8:Int }.
sampleRow b = { f0=b+0, f1=b+1, f2=b+2, f3=b+3, f4=b+4, f5=b+5, f6=b+6, f7=b+7, f8=b+8 }.
total r = r.f0 + r.f1 + r.f2 + r.f3 + r.f4 + r.f5 + r.f6 + r.f7 + r.f8.
rotate : R9 -> R9.
rotate r = { f0=total r, f1=r.f0, f2=r.f1, f3=r.f2, f4=r.f3, f5=r.f4, f6=r.f5, f7=r.f6, f8=r.f7 }.
capture : R9 -> R9 -> R9.
capture c r = { f0=c.f0*r.f8+c.f1, f1=r.f1, f2=r.f2, f3=r.f3, f4=r.f4, f5=r.f5, f6=r.f6, f7=r.f7, f8=r.f8 }.
keepRecord r = total r > 400.
step scale bias acc r = acc + scale * (r.f0 + r.f1 + r.f2 + r.f3 + r.f4 + r.f5 + r.f6 + r.f7 + r.f8) + bias.
probeRecordMap v = Vec.map rotate v.
probeRecordCaptured c v = Vec.map (capture c) v.
probeRecordFilter v = Vec.filter keepRecord v.
probeRecordFold scale bias seed v = Vec.fold (step scale bias) seed v.
fill : (Vector R9) -> (i:Int | measure(n-i)) -> (n:Int) -> (Vector R9).
fill v i n | i >= n = v.
fill v i n = fill (Vec.push (sampleRow i) v) (i+1) n.
main = v=fill (Vec.new Unit) 0 100; w=probeRecordMap v; x=probeRecordCaptured (sampleRow 2) w; y=probeRecordFilter x; (s,z)=probeRecordFold 2 3 7 y; _=Vec.free z; print s.

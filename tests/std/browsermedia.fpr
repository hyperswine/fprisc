B = use "std/browser".
unsafe base.
L = use "std/list".
check why yes = if yes then Unit else error "browsermedia: {why}".
labels = {off = "off", paused = "paused", connecting = "connecting", connected = "connected", failed = "failed"}.
main =
  _ = L.each (fn selected -> L.each (fn visible -> L.each (fn live ->
    s = {selected = selected, visible = visible, live = live};
    expected = selected and visible and live;
    _ = check "shared active rule" (B.mediaEvaluate s B.mediaActive == expected);
    _ = check "new source" (B.mediaPhase s False B.Connected == (if expected then B.Connecting else if selected then B.Paused else B.Off));
    _ = check "retained source" (B.mediaPhase s True B.Connected == (if expected then B.Connected else if selected then B.Paused else B.Off));
    check "failure stays failed until source removed" (B.mediaPhase s True B.Failed == (if expected then B.Failed else if selected then B.Paused else B.Off))
  ) [False, True]) [False, True]) [False, True];
  _ = check "labels are typed phase data" (B.mediaMessage labels B.Connecting == "connecting" and B.mediaMessage labels B.Paused == "paused");
  _ = print "browsermedia: shared source policy, phases, retained failure and suspension PASS";
  0.

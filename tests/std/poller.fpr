unsafe base.
Clock = use "std/clock".
Poller = use "std/poller".
Tcp = use "std/tcp".
Stream = use "std/stream".
String = use "std/string".
List = use "std/list".

spin me n = if n == 0 then Unit else _ = receiveNow me; spin me (n - 1).

# the server side of one connection, waiting THROUGH the poller
echo p conn peer = echoGo (Stream.readerOn p conn) conn.
echoGo r conn = case Stream.readLine r of (res, r2) ->
  (case res of
      Err _ -> Unit
    | Ok line -> (if line == "bye" then _ = Stream.write "goodbye\n" conn; Unit
                  else _ = Stream.write "{String.toUpper line}\n" conn; echoGo r2 conn)).

client port n =
  conn = (case Tcp.connect "127.0.0.1" port of Ok c -> c | Err e -> error e);
  _ = Stream.write "hello {n}\nbye\n" conn;
  all = Stream.readAll conn;
  _ = Stream.close conn;
  all.

# `spin` is a receive loop, so the compiler runs it as receive turns
# (compiler/ReceiveTurns.hs): its entry builds the turn's closure and a tuple
# of the live parameters in the caller's pool, two cells the runtime hands
# back to the pool's buckets when the loop returns.  heapUsed counts bytes
# bumped, not bucket hits, so the first activation shows those two cells
# once; a one-ask warm-up puts them in the buckets, and the measured window
# then holds only what the asks themselves allocate -- and would show the
# two cells again if the runtime stopped recycling them
# (docs/2026-10-19-STD-SUITE-REPAIRS.md).
main =
  me = myself 0;
  _ = print "empty: {receiveNow me}";
  _ = spin me 1;
  h0 = heapUsed Unit;
  _ = spin me 100000;
  _ = print "100,000 asks of an empty mailbox allocated {heapUsed Unit - h0} bytes";
  _ = spawn (fn self -> _ = Sys.sleepUs 30000; send me "late");
  _ = print "within 5 ms: {Clock.receiveWithin 5 me}";
  _ = print "within 500 ms: {Clock.receiveWithin 500 me}";
  p = Poller.start Unit;
  l = (case Tcp.listen "127.0.0.1" 0 of Ok x -> x | Err e -> error e);
  _ = spawn (fn self -> Tcp.serveOn p l (echo p));
  _ = print "through the poller: {List.map (client (Tcp.port l)) (List.range 1 3)}";
  _ = Tcp.stop l;
  print "done".

# std/game: one transition per input, effects once and in order, decoders that
# may refuse, a quit that ends the run, view that performs nothing.
Game = use "std/game".
O = use "std/option".

Msg = Type (Bump n | Say | Shot | Leave | Beat | Save | Saved r | Fetch | Fetched r).

init flags = ({ n = flags, beats = 0 }, Game.log "start {flags}").
update (Bump k) m = ({ m | n = m.n + k }, Game.none).
update Say m = (m, Game.batch [Game.log "n is {m.n}", Game.sound "blip" m.n, Game.log "said"]).
update Shot m = (m, Game.capture).
update Leave m = (m, Game.batch [Game.log "bye", Game.quit]).
update Beat m = ({ m | beats = m.beats + 1 }, Game.none).
# a save is asked for, and only its result says it happened; a fetch chains a save
update Save m = (m, Game.attempt (Game.append "log" "n {m.n}") Saved).
update (Saved (Ok r)) m = ({ m | n = m.n + 100 }, Game.log "saved").
update (Saved (Err why)) m = (m, Game.log "not saved: {why}").
update Fetch m = (m, Game.attempt (Game.readLatest "log") Fetched).
update (Fetched (Ok text)) m = (m, Game.batch [Game.log "fetched {text}", Game.attempt (Game.append "log" "seen") Saved]).
update (Fetched (Err why)) m = (m, Game.log "nothing stored: {why}").

# both the arrow and W bump; an unknown key is nobody's
decode 103 = O.Some (Bump 1).
decode 17 = O.Some (Bump 1).
decode 108 = O.Some (Bump (0 - 1)).
decode 57 = O.Some Say.
decode 25 = O.Some Shot.
decode 16 = O.Some Leave.
decode 31 = O.Some Save.
decode 33 = O.Some Fetch.
decode k = O.None.
# the tick is asked for only while n is not negative: a model that stops time
subs m = if m.n < 0 then [Game.keys decode] else [Game.keys decode, Game.tick 40 Beat].
view m = Game.layers m.n m.beats.

a = Game.app init update subs view.

effect (Game.ELog s) = "log {s}".
effect (Game.ESound n v) = "sound {n} {v}".
effect (Game.EMusic n v) = "music {n} {v}".
effect Game.ECapture = "capture".
effect Game.EQuit = "quit".
effect (Game.ETask (Game.Append name text) f) = "task append {name} [{text}]".
effect (Game.ETask (Game.ReadLatest name) f) = "task readLatest {name}".
effect (Game.ETask (Game.Replay name) f) = "task replay {name}".
effect (Game.ELatest key rev j f) = "latest {key} r{rev}".
effect (Game.ECancel key) = "cancel {key}".
show label inputs = case Game.play a 5 inputs of (m, es) ->
  _ = print "{label}: n={m.n} beats={m.beats}";
  showAll es.
disk (Game.Append name text) = Ok "".
disk (Game.ReadLatest name) = Ok "n 5".
disk (Game.Replay name) = Ok "n 5\n".
empty task = Err "no record".
showWith label answer inputs = case Game.playWith answer a 5 inputs of (m, es) ->
  _ = print "{label}: n={m.n} beats={m.beats}";
  showAll es.
count : (xs : List b | measure xs) -> Int .
count xs = case xs of Nil -> 0 | x :: more -> 1 + count more.
late (Game.ETask task toMsg :: more) m = Game.apply a (toMsg (Ok "")) m.
late es m = (m, Nil).
showAll : (es : List Game.Effect | measure es) -> Unit .
showAll es = case es of
    Nil -> Unit
  | e :: more -> _ = print "  {effect e}"; showAll more.

main =
  _ = show "two bindings" [Game.Key 103, Game.Key 17, Game.Key 57];
  _ = show "unknown key" [Game.Key 999, Game.Key 57];
  _ = show "capture once" [Game.Key 25, Game.Key 57];
  _ = show "quit ends the run" [Game.Key 103, Game.Key 16, Game.Key 103, Game.Key 57];
  _ = show "ticks" [Game.Elapsed 40, Game.Elapsed 40, Game.Elapsed 16, Game.Key 57];
  _ = show "no tick below zero" [Game.Key 108, Game.Key 108, Game.Key 108, Game.Key 108, Game.Key 108, Game.Key 108, Game.Elapsed 40, Game.Elapsed 40];
  # tasks: play refuses them; playWith answers them, in order, before the next input
  _ = show "a refused save" [Game.Key 31, Game.Key 57];
  _ = showWith "a stored save" disk [Game.Key 31, Game.Key 57];
  _ = showWith "a fetch chains a save" disk [Game.Key 33];
  _ = showWith "an empty store" empty [Game.Key 33];
  # a test that holds a completion back: step, keep the task, deliver it later
  (s0, e0) = Game.play a 5 Nil;
  (s1, e1) = Game.step a (Game.Key 31) s0;
  (s2, e2) = Game.step a (Game.Key 103) s1;
  _ = print "held back: n={s2.n} asked {count e1}";
  (s3, e3) = late e1 s2;
  _ = print "delivered late: n={s3.n}";
  _ = showAll e3;
  (m, es) = Game.play a 5 [Game.Key 103];
  # view twice: the same element, and nothing to perform
  same = (case (Game.view a m, Game.view a m) of (Game.Layers w1 o1, Game.Layers w2 o2) -> w1 == w2 and o1 == o2);
  _ = print "view twice equal: {same}";
  _ = print "period {Game.period (subs m)} keys {Game.wantsKeys (subs m)}";
  _ = testLatest Unit;
  print "game: done".

# ---- replaceable job test app ---------------------------------------------------------------
JMsg = Type (JAsk tag rev steps | JGot tag rev res | JCancel).
jInit u = ({ rev = 0, got = "none" }, Game.none).
jUpdate (JAsk tag rev steps) m =
  mk = Game.job (fn u -> (tag, steps)) (fn st -> (t, k) = st; if k <= 1 then Game.done "{t}-ok" else Game.more (t, k - 1));
  ({ m | rev = rev }, Game.latest "search" rev mk (fn r res -> JGot tag r res)).
jUpdate (JGot tag r res) m =
  if r == m.rev then ({ m | got = res }, Game.none)
  else (m, Game.log "ignored stale {tag} r{r}").
jUpdate JCancel m = ({ m | rev = m.rev + 1, got = "cancelled" }, Game.cancel "search").
jSubs m = Nil.
jView m = Game.layers m.rev m.got.
jApp = Game.app jInit jUpdate jSubs jView.

testLatest u =
  (m0, e0) = Game.start jApp 0;
  # submit A (rev 1, 3 chunks), step 1 chunk -> still More
  (m1, e1) = Game.apply jApp (JAsk "A" 1 3) m0;
  q1 = Game.queueJobs e1 Nil;
  (q2, m2, e2) = Game.stepJobs jApp q1 m1;
  _ = print "after chunk 1 of A: got={m2.got}";
  # replace with B (rev 2) then C (rev 3) within one chunk -> B never runs, C completes
  (m3, e3) = Game.apply jApp (JAsk "B" 2 2) m2;
  (m4, e4) = Game.apply jApp (JAsk "C" 3 2) m3;
  q3 = Game.queueJobs e4 (Game.queueJobs e3 q2);
  (q4, m5, e5) = Game.drainJobs 10 jApp q3 m4 Nil;
  _ = print "after replace B->C: got={m5.got} rev={m5.rev}";
  # deliver a stale A completion: model must not change
  (m6, e6) = Game.apply jApp (JGot "A" 1 "A-ok") m5;
  _ = print "after stale A: got={m6.got}";
  _ = showAll e6;
  # submit D (rev 4, 3 chunks), cancel before completion
  (m7, e7) = Game.apply jApp (JAsk "D" 4 3) m6;
  q5 = Game.queueJobs e7 q4;
  (q6, m8, e8) = Game.stepJobs jApp q5 m7;
  (m9, e9) = Game.apply jApp JCancel m8;
  q7 = Game.queueJobs e9 q6;
  (q8, m10, e10) = Game.drainJobs 10 jApp q7 m9 Nil;
  print "after cancel: got={m10.got} rev={m10.rev}".

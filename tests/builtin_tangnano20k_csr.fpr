profile builtin.
check ok = case ok of True -> Unit | False -> error "Tang Nano CSR check failed".
main =
  _ = check (CPU.csrRead 769 == I64.or (I64.shl (I64.trunc 1) 30) (I64.trunc 4352));
  _ = check (CPU.csrRead 3860 == I64.trunc 0);
  _ = CPU.csrWrite 832 (I64.trunc 305419896);
  _ = check (CPU.csrRead 832 == I64.trunc 305419896);
  _ = CPU.csrWrite 832 (I64.trunc -1);
  _ = check (CPU.csrRead 832 == I64.mask 32 0);
  _ = CPU.csrWrite 768 (I64.trunc 136);
  _ = check (CPU.csrRead 768 == I64.trunc 6280);
  _ = CPU.csrWrite 772 (I64.trunc -1);
  _ = check (CPU.csrRead 772 == I64.trunc 2184);
  _ = CPU.csrWrite 784 (I64.trunc -1);
  _ = check (CPU.csrRead 784 == I64.trunc 0);
  _ = CPU.csrWrite 836 (I64.trunc -1);
  _ = check (CPU.csrRead 836 == I64.trunc 0);
  _ = CPU.csrWrite 833 (I64.trunc 291);
  _ = check (CPU.csrRead 833 == I64.trunc 288);
  _ = CPU.csrWrite 834 (I64.trunc 7);
  _ = check (CPU.csrRead 834 == I64.trunc 7);
  _ = CPU.csrWrite 835 (I64.trunc 57005);
  _ = check (CPU.csrRead 835 == I64.trunc 57005);
  _ = CPU.csrWrite 2944 (I64.trunc 0);
  _ = CPU.csrWrite 2816 (I64.trunc -1);
  _ = check (CPU.csrRead 2944 == I64.trunc 1);
  _ = check (CPU.csrRead 3200 == I64.trunc 1);
  _ = CPU.csrWrite 2946 (I64.trunc 5);
  _ = CPU.csrWrite 2818 (I64.trunc 100);
  before = CPU.csrRead 3074;
  after = CPU.csrRead 2818;
  _ = check (after > before);
  _ = check (CPU.csrRead 3202 == I64.trunc 5);
  _ = check (CPU.csrRead 2946 == I64.trunc 5);
  _ = CPU.csrWrite 773 (I64.trunc 259);
  _ = check (CPU.csrRead 773 == I64.trunc 256);
  # Leave mtvec installed: the finisher must bypass guest trap handling.
  print "TANG NANO CSR HOLDS".

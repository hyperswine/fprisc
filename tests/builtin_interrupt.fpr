# QEMU virt CLINT software interrupt. Scratch RAM is outside the test heap.
machineInterrupt cause pc value =
  msip = Addr.ofI64 (I64.trunc 33554432);
  flag = Addr.ofI64 (I64.trunc 2164260864);
  _ = Mem.write32 msip (I32.trunc 0);
  _ = Mem.write64 flag (Mem.read64 flag + I64.trunc 1);
  Unit.
check b = case b of True -> Unit | False -> error "interrupt did not resume".
waitFor flag = case I64.toInt (Mem.read64 flag) == 0 of
  True -> waitFor flag
| False -> Unit.
fire n = case n == 0 of
  True -> Unit
| False ->
  flag = Addr.ofI64 (I64.trunc 2164260864);
  _ = Mem.write64 flag (I64.trunc 0);
  _ = Mem.write32 (Addr.ofI64 (I64.trunc 33554432)) (I32.trunc 1);
  _ = waitFor flag;
  xs = [n, n + 1];
  _ = check (xs == [n, n + 1]);
  fire (n - 1).
main =
  _ = CPU.csrWrite 772 (I64.trunc 8);
  _ = CPU.irqEnable Unit;
  _ = fire 1000;
  _ = CPU.irqSave Unit;
  print "INTERRUPTS RESUME".

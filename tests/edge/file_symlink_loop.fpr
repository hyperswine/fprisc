unsafe base.
S = use "std/string".
L = use "std/list".
O = use "std/os".
J = use "std/json".
main =
  _ = Os.run ("sh" :: "-c" :: "rm -f /tmp/fpr-loop-a /tmp/fpr-loop-b; ln -s /tmp/fpr-loop-a /tmp/fpr-loop-b; ln -s /tmp/fpr-loop-b /tmp/fpr-loop-a" :: Nil) "/tmp" "" Nil 5000;
  case O.readFile "/tmp/fpr-loop-a" of Ok s -> print "read {strlen s}" | Err e -> print "Err({e})".

# actors.fpr — spawn / send / receive / kill on the cooperative runtime.
#
# Every actor primitive arrives through the same fpr_g_ contract as the
# devices — the compiler knows nothing about actors. Servers are plain
# tail-recursive functions (TCO makes them O(1) stack); state is just
# the accumulator argument, exactly the Erlang shape.

# device "uart" / UART0 becomes stdout on POSIX targets
uart = device "uart" .

# ---- console (same as demo.fpr) --------------------------------------
lsrReady =
  v = read (reg8 uart 5);
  BITTEST v 5 .

putc : unsafe Int -> Unit .
putc c | lsrReady = write (reg8 uart 0) c.
putc c = putc c .
# console text over THIS file's putc (the prelude cannot host these:
# putc is per-target device code, and the prelude is a cached unit)
puts : unsafe String -> Unit .
puts s = putsFrom s 1 .
putsFrom : unsafe String -> Int -> Unit .
putsFrom s i | i > strlen s = Unit.
putsFrom s i = putc (charAt s i) >> putsFrom s (i + 1) .
nl : unsafe Unit .
nl = putc 13 >> putc 10 .



# ---- actors ------------------------------------------------------------

# echo: doubles what you send it, forever. Drops each message after
# use (the manual stand-in for compiler-inserted RC).
echo : unsafe Int -> p36 .
echo me =
  m = receive me;
  case m of
    (replyTo, n) -> send replyTo (n * 2) >> drop m >> echo me .

# counter: stateful server. State = tail-call accumulator. Never drops
# its messages -- deliberately, so the ARC live count shows the leak.
counter : unsafe Int -> u36 .
counter me = counterLoop me 0 .
counterLoop : unsafe Int -> Int -> r36 .
counterLoop me total =
  m = receive me;
  case m of
    (replyTo, k) -> send replyTo (total + k) >> counterLoop me (total + k) .

# ---- main (which is itself actor 0) ------------------------------------

main =
  me = myself 0;
  _ = nl >> puts "actor demo: cooperative scheduler, ring mailboxes, ARC on send" >> nl >> nl;
  e = spawn echo;
  c = spawn counter;
  _ = send e (me, 21);
  r = receive me;
  _ = puts "echo (me, 21)      -> {r}" >> nl;
  _ = send c (me, 5);
  a = receive me;
  _ = puts "counter (me, 5)    -> {a}" >> nl;
  _ = send c (me, 7);
  b = receive me;
  _ = puts "counter (me, 7)    -> {b}   (state held in the TCO'd server loop)" >> nl;
  _ = puts "ARC live objects: {arcLive 0}   (echo dropped its message, counter kept 2)" >> nl;
  _ = kill c;
  _ = send c (me, 100);
  _ = puts "killed counter; send to dead actor is a silent no-op" >> nl;
  puts "actor demo done" >> nl .

# msgpack.fpr -- packed message slabs under fire (docs/MEMORY.md): four
# producers stream tuples carrying lists into one hub while spawned
# churners allocate and die (so freed blocks are reused at once); the
# hub verifies every payload after the compiler's autodrop (the borrow
# window), relays every third one to a sink by sendLinear (the zero-
# copy move changes the dropper), and the sink verifies again.  Any
# stale or overwritten byte shows up as a checksum miss.
unsafe program.

AC = use "../std/actor".

mk 0 acc = acc.
mk n acc = mk (n - 1) ((n * 7) :: acc).
sumL Nil s = s.
sumL (x :: xs) s = sumL xs (s + x).
# 50 items n*7 for n = 1..50: sum = 7 * 1275 = 8925
expect = 8925.

producer hub id me =
  prod hub id 1 me.
prod hub id 2001 me = 0.
prod hub id i me =
  _ = AC.sendOrDie hub (id, i, mk 50 Nil);
  prod hub id (i + 1) me.

churn me =
  xs = mk 3000 Nil;
  sumL xs 0.

hub sink main me =
  hubLoop sink main 0 0 0 me.
hubLoop sink main 8000 bad relayed me =
  _ = AC.sendOrDie sink (0, 0, Nil);
  _ = AC.sendOrDie main (bad, relayed);
  0.
hubLoop sink main n bad relayed me =
  m = receive me;
  (id, i, xs) = m;
  ok = sumL xs 0 == expect and id >= 1 and id <= 4;
  bad2 = case ok of True -> bad | False -> bad + 1;
  c = case i % 50 == 0 of True -> spawn churn | False -> 0;
  case i % 3 == 0 of
    True -> _ = AC.sendOrDie sink (id, i, xs); hubLoop sink main (n + 1) bad2 (relayed + 1) me
  | False -> hubLoop sink main (n + 1) bad2 relayed me.

sink main me = sinkLoop main 0 0 me.
sinkLoop main got bad me =
  (id, i, xs) = receive me;
  case id == 0 of
    True -> _ = AC.sendOrDie main (got, bad); 0
  | False -> sinkLoop main (got + 1) (bad + (case sumL xs 0 == expect of True -> 0 | False -> 1)) me.

main =
  me = myself 0;
  s = AC.spawnWith (AC.Dynamic 64) (sink me);
  h = AC.spawnWith (AC.Dynamic 64) (hub s me);
  p1 = spawn (producer h 1);
  p2 = spawn (producer h 2);
  p3 = spawn (producer h 3);
  p4 = spawn (producer h 4);
  (bad, relayed) = receiveFrom me h;
  (got, sbad) = receiveFrom me s;
  info = Sys.memInfo 0;
  _ = print "msgpack: 8000 messages, {bad} bad at the hub; {relayed} relayed by sendLinear, sink got {got}, {sbad} bad; mem {info}";
  _ = print (verdict (bad == 0 and sbad == 0 and got == relayed));
  0.
verdict True = "MSGPACK HOLDS".
verdict False = "MSGPACK BROKEN".

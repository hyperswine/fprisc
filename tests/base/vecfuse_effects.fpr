# Two materializing maps run the first over EVERY element before the second
# starts.  A fused pass would interleave them: first 1, second 1, first 2,
# second 2 -- a different observable trace.  Element functions that print
# (or could fail) must therefore not fuse; pure ones still do.
unsafe base.
first x = _ = print "first {x}"; x.
second x = _ = print "second {x}"; x.
double x = x * 2.
inc x = x + 1.
main =
  v = Vec.fromList [1, 2];
  a = Vec.map first v;
  b = Vec.map second a;
  _ = Vec.free b;
  w = Vec.fromList [10, 20];
  h0 = heapUsed Unit;
  w2 = Vec.map inc (Vec.map double w);
  grew = heapUsed Unit - h0;
  (s, w3) = Vec.fold (fn acc x -> acc + x) 0 w2;
  _ = Vec.free w3;
  print "pure pair: {s} (pool grew {grew} B)".

# a received message dies with the turn that took it: no `drop` anywhere, by
# the program or by the compiler (docs/2026-10-24-REGIONS-STAGE1.md).  Both
# bodies here are the bare `case <receive> of` that autodrop missed until
# 2026-10-19 (docs/2026-10-19-AUTODROP-BARE-CASE.md: 1,000,000 live Arc
# entries, 101 MB resident, for tests/bench/pingpong.fpr); the ARC gauges come
# from tests/arc_churn/arcprobe.c (`fpr build --with`), and rx_grows says no
# actor ever held more roots in one turn than its inline list of eight.
Arc.live : Unit -> Int .
Arc.rxGrows : Unit -> Int .
# shape 5, bare: the bench ponger, verbatim
ponger : unsafe Int -> a .
ponger self = case receive self of (who, n) -> send who (n + 1) >> ponger self.
ping : unsafe Int -> Int -> Int -> Int -> Int .
ping me p k acc = if k == 0 then acc else
  _ = send p (me, k);
  r = receiveFrom me p;
  ping me p (k - 1) (acc + r).
# shape 5b, bare: the Result-wrapped receive as the whole body, root read in the arm
worker : Int -> Int -> Unit .
worker boss self = _ = send boss (True, 7); Unit.
takeRes : Int -> Int -> Int .
takeRes me w = case receiveFromRes me w of Ok m -> (case m of (a, b) -> b) | Err e -> 0.
roundRes : unsafe Int -> Int -> Int .
roundRes 0 acc = acc.
roundRes n acc = me = myself 0; w = spawn (worker me); k = takeRes me w; _ = receiveFromRes me w; roundRes (n - 1) (acc + k).
main =
  me = myself 0;
  p = spawn ponger;
  s = ping me p 100000 0;
  r = roundRes 1000 0;
  print "autodrop3: pingpong {s} and {r} Result-wrapped: arc_live = {Arc.live Unit} rx_grows = {Arc.rxGrows Unit}".

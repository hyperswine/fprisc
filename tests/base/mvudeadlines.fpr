# Service refusal/death exits through Result and releases the owned worker.
unsafe base.
MV = use "std/mvu".
AC = use "std/actor".
Sys.alive : Int -> Bool .
check yes why = if yes then Unit else error "mvufailure: {why}".
init env = {mode = env.mode, port = env.port, n = 0}.
update me env ev m = case ev of
    MV.ETick -> ({m | n = m.n + 1}, MV.MQuit :: Nil)
  | other -> (m, Nil).
subs m = case m.mode of
    3 -> MV.SKeys :: Nil
  | 4 -> MV.SPort m.port :: Nil
  | 5 -> MV.SEvents m.port :: Nil
  | 7 -> MV.STick 1 :: Nil
  | other -> Nil.
key m = 0.
statics vp m = 0.
vals self env vp m = if env.mode == 6 then _ = Sys.sleepUs 2000000; 0 else 0.
done m = "done".
backend mode me =
  message = receive me;
  (from, q) = keep message;
  _ = drop message;
  case q of
      MV.Dims u -> if mode == 1 then _ = Sys.sleepUs 2000000; Unit else _ = AC.sendSure me from (80, 24); backend mode me
    | MV.Render st vs sc fr -> if mode == 2 then _ = Sys.sleepUs 2000000; Unit else _ = AC.sendSure me from (0, 0); backend mode me
    | MV.Poll u -> if mode == 3 then _ = Sys.sleepUs 2000000; Unit else _ = AC.sendSure me from (0, 0, 0); backend mode me.
runCase me render input port mode =
  cfg = {env = {mode = mode, port = port}, mt = 0, tick = 10000, input = input, render = render};
  app = MV.MApp init update key statics vals done subs;
  MV.runResultWithin (if mode == 7 then 500 else 30) me cfg app.
refused why result = case result of Err text -> text == why | other -> False.
ended me = a = spawn (fn self -> Unit); _ = Sys.sleepUs 20000; a.
full self = _ = Sys.sleepUs 2000000; Unit.
fill who n = if n == 0 then Unit else _ = send who n; fill who (n - 1).

checkTimeout result = case result of
    Err why -> check (strIndexOf "deadline exceeded" why >= 0) "timeout diagnostic"
  | Ok text -> error "mvudeadlines: unexpected success".
main =
  me = myself 0;
  _ = checkTimeout (runCase me (spawn (backend 1)) 0 0 1);
  rd2 = spawn (backend 2);
  _ = checkTimeout (runCase me rd2 0 0 2);
  _ = kill rd2;
  rd3 = spawn (backend 3);
  _ = checkTimeout (runCase me rd3 rd3 0 3);
  _ = kill rd3;
  rd = spawn (backend 0);
  pa = spawn full;
  _ = checkTimeout (runCase me rd 0 pa 4);
  _ = checkTimeout (runCase me rd 0 pa 5);
  _ = checkTimeout (runCase me rd 0 0 6);
  _ = kill pa;
  watcher = spawn (fn self -> receive self);
  bad = spawn (backend 1);
  cfg = {env = {mode = 1, port = 0}, mt = 0, tick = 0, input = 0, render = bad};
  app = MV.MApp init update key statics vals done subs;
  _ = checkTimeout (MV.runWatchedWithin 30 me cfg app MV.noReload (fn caller port -> Ok watcher));
  _ = check (not (Sys.alive watcher)) "watcher remains live";
  _ = kill bad;
  result = runCase me rd 0 0 7;
  _ = check (case result of Ok text -> strIndexOf "done [mvu:" text == 0 | other -> False) "healthy run after timeout";
  _ = kill rd;
  print "mvudeadlines: live dimensions/input/ports/render/worker deadlines and watcher cleanup HOLDS".

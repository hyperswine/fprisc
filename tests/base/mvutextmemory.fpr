unsafe base.
MV = use "std/mvu".
AC = use "std/actor".
freeKiB u = case Sys.memInfo 0 of _ :: f :: _ -> f | _ -> 0.
requests me render n = if n == 0 then Unit else
  _ = send render (me, MV.Poll 0);
  reply = receiveFrom me render;
  (kind, a, b) = reply;
  _ = if kind == 0 and a == 0 and b == 0 then Unit else error "text renderer reply";
  _ = drop reply;
  requests me render (n - 1).
main =
  me = myself 0;
  render = AC.spawnWith (AC.Dynamic 8) MV.textRender;
  _ = requests me render 100;
  before = freeKiB Unit;
  roots = arcLive 0;
  _ = requests me render 20000;
  retained = before - freeKiB Unit;
  extra = arcLive 0 - roots;
  _ = kill render;
  _ = if retained < 4096 and extra <= 4 then Unit
      else error "text renderer: retained={retained} KiB roots={extra}";
  print "mvutextmemory: 20000 requests bounded, received roots released HOLDS".

# a frame must hold the argument slots of DIRECT primitive calls: here the
# only staged arguments belong to primitives (substr, strJoin), and each
# argument's own evaluation calls into C -- a frame sized without them put
# the slots below sp, where those calls' frames overwrote them
f : String -> String .
f s = substr (strJoin "" [s, s, s]) (strlen (strJoin "-" [s, "x"]) - 1) (strlen (strJoin "+" [s, s]) + 1).
g : Int -> String .
g n = strJoin (substr "-=+" n 1) [substr "abcdef" (n - 1) 2, substr "uvwxyz" (n + 1) 3, strJoin "" ["p", substr "qrs" (n - 1) 1]].
main =
  _ = print "f: {f "abc"}";
  print "g: {g 1} {g 2}".

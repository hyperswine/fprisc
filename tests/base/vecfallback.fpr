unsafe base.
# Vector specializations whose generic fallback builds a closure on the
# stack (tests/check_vector_fallback_frames.py).  Tuple elements have no
# scalar kernel, so every call below leaves through its fallback frame.
label tag p = "{tag}".
add3 k acc p = acc + k.
twice n p = n * 2.
first v = (x, v2) = Vec.at 0 v; _ = Vec.free v2; x.
main =
  t = Vec.push (7, 8) (Vec.push (1, 2) (Vec.new Unit));
  t2 = Vec.push (7, 2.5) (Vec.new Unit);
  a = first (Vec.map (fn p -> "ok") t);
  b = first (Vec.map (fn p -> 5) t2);
  c = first (Vec.map (label "cap") (Vec.push (3, 4) (Vec.new Unit)));
  (s, w) = Vec.fold (add3 10) 7 (Vec.push (5, 6) (Vec.push (1, 2) (Vec.new Unit)));
  _ = Vec.free w;
  (u, w2) = Vec.fold (fn acc n -> acc + n) 1 (Vec.map (twice 21) (Vec.push (1, 1) (Vec.new Unit)));
  _ = Vec.free w2;
  print "fallback frames: {a} {b} {c} {s} {u}".

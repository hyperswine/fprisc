unsafe base.
V = use "std/view".
L = use "std/list".
P = use "std/program".
Input = {id : Int, text : String, editing : Bool}.
render input = V.key "item-{input.id}" (V.El "div" [V.Cls "card"]
  (if input.editing then [V.El "textarea" [V.Att "data-input" "edit"] Nil]
   else [V.Dyn input.text])).
check yes = if yes then Unit else error "viewcache regression".
run version verify old inputs = V.cacheMany (fn input -> str input.id) render inputs (V.cacheBegin version verify old).
compare nodes inputs =
  cached = V.El "section" Nil nodes;
  fresh = V.El "section" Nil (L.map render inputs);
  _ = check (V.render cached == V.render fresh);
  check (V.allClasses cached Nil == V.allClasses fresh Nil).
a = {id = 1, text = "one", editing = False}.
b = {id = 2, text = "two", editing = False}.
c = {id = 3, text = "<tag>λ", editing = False}.
main =
  (case run "v1" True (V.cacheEmpty Unit) [a,b] of (nodes, cold) ->
    _ = compare nodes [a,b];
    _ = check (V.cacheStats cold == (0,2,2));
    old = V.cacheFinish cold;
    (case P.args Unit of
        "stale" :: Nil -> (case V.cacheItem "1" a (fn input -> V.Txt "changed renderer") (V.cacheBegin "v1" True old) of _ -> error "undetected stale renderer")
      | "duplicate" :: Nil -> (case run "v1" True old [a,a] of _ -> error "undetected duplicate")
      | _ ->
          (case V.cacheItem "1" a (fn input -> error "hit evaluated renderer") (V.cacheBegin "v1" False old) of (_, hit) ->
            _ = check (V.cacheStats hit == (1,0,1));
            (case run "v1" True old [c,b,a] of (reordered, next) ->
              _ = check (V.cacheStats next == (2,1,3));
              _ = compare reordered [c,b,a];
              changed = {a | text = "updated"};
              (case run "v1" True (V.cacheFinish next) [c,b,changed] of (updated, f) ->
                _ = compare updated [c,b,changed];
                _ = check (V.cacheStats f == (2,1,3));
                editing = {changed | editing = True};
                (case run "v1" True (V.cacheFinish f) [c,b,editing] of (edited, e) ->
                  _ = compare edited [c,b,editing];
                  _ = check (V.cacheStats e == (2,1,3));
                  (case run "v1" True (V.cacheFinish e) [b] of (remaining, r) ->
                    _ = compare remaining [b];
                    _ = check (V.cacheSize (V.cacheFinish r) == 1);
                    (case run "v1" True (V.cacheFinish r) [a,b] of (_, restored) ->
                      _ = check (V.cacheStats restored == (1,1,2));
                      (case run "v2" True old [a,b] of (versioned, v) ->
                        _ = compare versioned [a,b];
                        _ = check (V.cacheStats v == (0,2,2));
                        (case run "v1" True (V.cacheEmpty Unit) [editing,b] of (other, o) ->
                          _ = compare other [editing,b];
                          _ = check (V.cacheStats o == (0,2,2));
                          (case run "v1" True old Nil of (_, empty) ->
                            _ = check (V.cacheSize (V.cacheFinish empty) == 0);
                            # retain: a later page keeps the most recently used earlier
                            # entries up to the bound (a, then b were drawn: b is newer)
                            (case run "v1" True old [c] of (_, onlyC) ->
                              kept = V.cacheRetain 2 onlyC;
                              _ = check (V.cacheSize kept == 2);
                              _ = check (V.cacheSize (V.cacheRetain 1 onlyC) == 1);
                              _ = check (V.cacheSize (V.cacheRetain 9 onlyC) == 3);
                              (case run "v1" True kept [b,c] of (back, kb) ->
                                _ = compare back [b,c];
                                _ = check (V.cacheStats kb == (2,0,2));
                                (case run "v1" True kept [a] of (_, ka) ->
                                  _ = check (V.cacheStats ka == (0,1,1));
                                  _ = print "cache: hits skip rendering; edits, reordering, eviction, retention, version, session isolation, slots and CSS agree";
                                  0)))))))))))))).

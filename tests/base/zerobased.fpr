# zerobased.fpr -- every position is 0-based (docs/2026-10-02-ZERO-BASED.md).
# The primitives at their first and last valid index, and "not found";
# check_base runs it natively and under Sol (fpr sol), which must agree,
# and probes the out-of-range panics separately.
main =
  s = "hello";
  first = charAt s 0;
  last = charAt s (strlen s - 1);
  mid = substr s 1 3;
  tail = substr s 4 10;
  past = substr s 5 2;
  found = strIndexOf "l" s;
  none = strIndexOf "z" s;
  from = strIndexFrom "l" s 3;
  fromNone = strIndexFrom "h" s 1;
  xs = 10 :: 20 :: 30 :: Nil;
  head = xs ! 0;
  end = xs ! 2;
  viaStr = Str.at s 0;
  print "charAt {first} {last}; substr [{mid}] [{tail}] [{past}]; index {found} {none} {from} {fromNone}; list {head} {end}; Str.at {viaStr}".

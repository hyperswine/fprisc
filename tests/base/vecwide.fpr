# a float record: the layout is INFERRED from the element type
P = { x : F64, y : F64, k : Int }.
fillP : (Vector P) -> (i : Int | measure (n - i)) -> (n : Int) -> (Vector P) .
fillP v i n | i >= n = v.
fillP v i n = fillP (Vec.push { x = 1.5, y = 2.25, k = i } v) (i + 1) n.
runP =
  v = fillP (Vec.new Unit) 0 4;
  (p, v2) = Vec.at 2 v;
  (n, v3) = Vec.len v2;
  _ = Vec.free v3;
  print "float record: n={n} x={p.x} y={p.y} k={p.k}".
# width 1 and width 0 records are boxed rows, and still work
One = { a : Int }.
runOne =
  v = Vec.push { a = 2 } (Vec.push { a = 1 } (Vec.new Unit));
  (s, v2) = Vec.fold (fn acc r -> acc + r.a) 0 v;
  _ = Vec.free v2;
  print "one: {s}".
main =
  _ = run2;
  _ = run4;
  _ = run8;
  _ = run9;
  _ = run32;
  _ = run65;
  _ = run128;
  _ = runP;
  runOne.

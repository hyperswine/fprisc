# Vectors of records of every width, through push, get, set, map, filter,
# fold, an actor round trip (the deep copier) and free.  The descriptor is
# sized to the record: no eight-column slot limit, no bitmap
# (docs/2026-10-03-VECTOR-DESCRIPTORS.md).  Expected output computed in
# tests/check_base.py.
unsafe base.
AC = use "std/actor".
R2 = { f0 : Int, f1 : Int }.
mk2 b = { f0 = b * 1, f1 = b * 2 }.
fill2 : (Vector R2) -> (i : Int | measure (n - i)) -> (n : Int) -> (Vector R2) .
fill2 v i n | i >= n = v.
fill2 v i n = fill2 (Vec.push (mk2 i) v) (i + 1) n.
sum2 : R2 -> Int .
sum2 r = r.f0 + r.f1.
bump2 r = { r | f0 = r.f0 + 1000 }.
keep2 r = r.f1 > 5.
run2 = 
  v = fill2 (Vec.new Unit) 0 10;
  (r3, v2) = Vec.at 3 v;
  v3 = Vec.put 0 (mk2 7) v2;
  v4 = Vec.map bump2 v3;
  v5 = Vec.filter keep2 v4;
  (n, v6) = Vec.len v5;
  (s, v7) = Vec.fold (fn a r -> a + sum2 r) 0 v6;
  me = myself 0;
  echo = spawn (fn self -> (from, m) = receive self; send from m);
  _ = send echo (me, v7);
  back = receive me;
  (s2, v8) = Vec.fold (fn a r -> a + sum2 r) 0 back;
  _ = Vec.free v8;
  print "w2: at3={sum2 r3} kept={n} sum={s} echoed={s2}".
R4 = { f0 : Int, f1 : Int, f2 : Int, f3 : Int }.
mk4 b = { f0 = b * 1, f1 = b * 2, f2 = b * 3, f3 = b * 4 }.
fill4 : (Vector R4) -> (i : Int | measure (n - i)) -> (n : Int) -> (Vector R4) .

keep4 r = r.f1 > 5.
run4 = 
  v = fill4 (Vec.new Unit) 0 10;
  (r3, v2) = Vec.at 3 v;
  v3 = Vec.put 0 (mk4 7) v2;
  v4 = Vec.map bump4 v3;
  v5 = Vec.filter keep4 v4;
  (n, v6) = Vec.len v5;
  (s, v7) = Vec.fold (fn a r -> a + sum4 r) 0 v6;
  me = myself 0;
  echo = spawn (fn self -> (from, m) = receive self; send from m);
  _ = send echo (me, v7);
  back = receive me;
  (s2, v8) = Vec.fold (fn a r -> a + sum4 r) 0 back;
  _ = Vec.free v8;
  print "w4: at3={sum4 r3} kept={n} sum={s} echoed={s2}".

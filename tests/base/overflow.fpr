# overflow.fpr -- recursion that is not a tail call goes as deep as its input,
# and an actor's stack GROWS to hold it (docs/2026-09-19-BOUNDS.md): 200,000 frames is
# just a program.  Recursion that never ends is a NAMED panic at the stack's
# policy ceiling (fpr_stack_max; FPR_STACK_MAX_MB for a run) -- never a bare
# signal, and never the machine's memory.
unsafe base.
build n = case n of 0 -> Nil | _ -> n :: build (n - 1).
buildAcc n acc = case n of 0 -> acc | _ -> buildAcc (n - 1) (n :: acc).
len xs acc = case xs of Nil -> acc | _ :: r -> len r (acc + 1).
forever n = 1 + forever (n + 1).
main =
  _ = print "accumulator: {len (buildAcc 200000 Nil) 0}";
  _ = print "recursion: {len (build 200000) 0}";
  print "forever: {forever 0}".

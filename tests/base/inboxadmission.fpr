unsafe program.
Sys.spawnInbox : Int -> Int -> Int -> (Int -> a) -> Result Int String .
Probe.failNext : Int -> Unit .
Probe.denials : Unit -> Int .
Probe.pauseNext : Int -> Int -> Unit .
worker boss self = _ = send boss 42; Unit.
refused (Err "fixed heap: admission denied") = True.
refused _ = False.
freeKiB u = case Sys.memInfo 0 of _ :: n :: _ -> n | _ -> 0.
failed me phase =
  before = Sys.actLive 0;
  _ = Probe.failNext phase;
  result = Sys.spawnInbox (0 - 1) 8 1048576 (worker me);
  refused result and before == Sys.actLive 0 and (case receiveNow me of Err _ -> True | _ -> False).
round me 0 = True.
round me n = failed me 2 and failed me 3 and failed me 4 and failed me 5 and failed me 6 and failed me 7 and round me (n - 1).
canceller boss phase self = _ = Probe.pauseNext boss phase; _ = Sys.spawnInbox (0 - 1) 8 1048576 (worker boss); send boss False.
cancelOne me phase =
  before = Sys.actLive 0;
  child = spawn (canceller me phase);
  _ = receive me;
  _ = kill child;
  _ = receiveFromRes me child;
  _ = Sys.sleepUs 20000;
  before == Sys.actLive 0 and (case receiveNow me of Err _ -> True | _ -> False).
main =
  me = myself 0;
  warm = round me 1;
  _ = Sys.sleepUs 20000;
  before = freeKiB Unit;
  checks = round me 50;
  _ = Sys.sleepUs 20000;
  after = freeKiB Unit;
  cancelled = cancelOne me 2 and cancelOne me 3 and cancelOne me 4 and cancelOne me 5 and cancelOne me 6 and cancelOne me 7;
  count = Probe.denials Unit;
  child = case Sys.spawnInbox (0 - 1) 8 1048576 (worker me) of Ok a -> a | Err why -> error why;
  value = receiveFrom me child;
  _ = if warm and checks and cancelled and after >= before and count == 306 and value == 42 then Unit else error "inbox admission rollback";
  print "inboxadmission: six reservation rollback/cancellation phases, bounded reserve reuse and later spawn HOLDS".

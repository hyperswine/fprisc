unsafe base.
Auth = use "../std/sessionauth".
Crypto = use "../std/crypto".
Socket = use "../std/sockettransport".
E = use "../std/encoding".
P = use "../std/program".
CryptoHost.randomBegin : Int -> Int -> Result Int String .
CryptoHost.poll : Int -> Result (Bool, String) String .
CryptoHost.close : Int -> Result Unit String .
need answer = case answer of Ok value -> value | Err why -> error "auth fixture: {why}".
main =
  # RFC 8032 test 1, public conformance vector, not a private credential.
  key = need (E.fromHex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a");
  signature = need (E.fromHex "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b");
  budget = need (Socket.forMs 2000);
  _ = if need (Crypto.verify budget 1 key "" signature) and not (need (Crypto.verify budget 1 key "different" signature)) then Unit else error "Ed25519 vector";
  a = need (Crypto.random budget 1 32);
  b = need (Crypto.random budget 1 32);
  _ = if strlen a == 32 and strlen b == 32 and a != b then Unit else error "entropy";
  # An owner retains admission even after its worker has completed, until close.
  held = need (CryptoHost.randomBegin 32 1);
  _ = case CryptoHost.randomBegin 32 1 of Err "native crypto busy" -> Unit | _ -> error "crypto admission";
  _ = need (Crypto.await budget held);
  _ = case CryptoHost.randomBegin 32 1 of Err "native crypto busy" -> Unit | _ -> error "completed owner lost admission";
  _ = need (CryptoHost.close held);
  _ = need (Crypto.random budget 1 32);
  _ = case CryptoHost.poll held of Err _ -> Unit | _ -> error "closed crypto identity remained usable";
  print "native crypto: Ed25519 vector, mismatch, entropy, retained admission and close PASS".

# format (SPEC.md): build and hold 1M formatted report lines, then summarise
List = use "std/list".
String = use "std/string".
O = use "std/option".

two : Int -> String .
two n = if n < 10 then "0{n}" else "{n}".

status : Int -> String .
status i = if i % 3 == 0 then "open" else if i % 3 == 1 then "paid" else "shipped".

line : Int -> String .
line i =
  cents = (i * 104729) % 1000000;
  "order {i} cust c{(i * 7919) % 10007} qty {i % 17 + 1} total {cents / 100}.{two (cents % 100)} status {status i}".

at : Int -> List String -> String .
at i ls = case List.get i ls of O.Some l -> l | O.None -> "".

main =
  ls = List.map line (List.range 0 999999);
  bytes = List.fold (fn b l -> b + String.length l) 0 ls;
  h = List.fold (fn h l -> (h * 31 + String.length l) % 1000000007) 0 ls;
  _ = print "lines {List.length ls} bytes {bytes} hash {h}";
  _ = print (at 0 ls);
  _ = print (at 499999 ls);
  print (at 999999 ls).

# word frequency: std/map keyed by String (ordered AVL; std has no hash map), top 10
List = use "std/list".
String = use "std/string".
Map = use "std/map".
O = use "std/option".
Ord = use "std/order".

bump : O.Option Int -> O.Option Int .
bump old = case old of O.Some c -> O.Some (c + 1) | O.None -> O.Some 1.

byCount : (String, Int) -> (String, Int) -> Ord.Ordering .
byCount a b = case a of
  (wa, ca) -> (case b of (wb, cb) -> if ca != cb then Ord.int cb ca else Ord.string wa wb).

main =
  path = case Sys.args Unit of p :: _ -> p | Nil -> "data/corpus.txt";
  ws = String.words (fileRead path);
  counts = List.fold (fn m w -> Map.update w bump m) Map.strings ws;
  top = List.take 10 (List.sortWith byCount (Map.entries counts));
  _ = print "distinct {Map.size counts} total {List.length ws}";
  List.each (fn e -> case e of (w, c) -> print "{w} {c}") top.

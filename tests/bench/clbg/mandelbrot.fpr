# mandelbrot (SPEC.md): a binary PBM of the Mandelbrot set
String = use "std/string".
List = use "std/list".
Bytes = use "std/bytes".
OS = use "std/os".

inSet : (k : Int | measure k) -> F64 -> F64 -> F64 -> F64 -> F64 -> F64 -> Bool .
inSet k cr ci zr zi tr ti = if tr + ti > 4.0 then False else if k <= 0 then True else
  zi1 = 2.0 * zr * zi + ci;
  zr1 = tr - ti + cr;
  inSet (k - 1) cr ci zr1 zi1 (zr1 * zr1) (zi1 * zi1).

shl : Int -> (k : Int | measure k) -> Int .
shl b k = if k <= 0 then b else shl (b * 2) (k - 1).

# one row's bytes into the buffer, most significant bit first, padded to a whole byte;
# answers how many bytes the row took
row : Int -> F64 -> (n : Int) -> (x : Int | measure (n - x)) -> Int -> Int -> Int -> Vector Int -> (Int, Vector Int) .
row n2 ci n x bits byte at b = if x >= n then
    (if bits == 0 then (at, b) else (at + 1, Bytes.put at (shl byte (8 - bits)) b))
  else
  cr = 2.0 * F64.ofInt x / F64.ofInt n2 - 1.5;
  v = byte * 2 + (if inSet 50 cr ci 0.0 0.0 0.0 0.0 then 1 else 0);
  if bits == 7 then row n2 ci n (x + 1) 0 0 (at + 1) (Bytes.put at v b) else row n2 ci n (x + 1) (bits + 1) v at b.

rows : (n : Int) -> (y : Int | measure (n - y)) -> List String -> Vector Int -> (List String, Vector Int) .
rows n y acc b = if y >= n then (List.reverse acc, b) else
  ci = 2.0 * F64.ofInt y / F64.ofInt n - 1.0;
  (used, b1) = row n ci n 0 0 0 0 b;
  (line, b2) = Bytes.pack 0 used b1;
  rows n (y + 1) (line :: acc) b2.

main =
  n = case Sys.args Unit of s :: _ -> (case String.toInt s of Ok v -> v | Err _ -> 4000) | Nil -> 4000;
  _ = print "P4\n{n} {n}";
  (image, b) = rows n 0 Nil (Bytes.new ((n + 7) / 8));
  _ = OS.write 1 (strJoin "" image);
  Bytes.free b.

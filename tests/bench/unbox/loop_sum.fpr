# unbox bench baseline: the same sum as list_sum with no list (ideal fused form)
loop : unsafe Int -> Int -> Int -> Int .
loop i n acc = if i > n then acc else loop (i + 1) n (acc + i).
go : unsafe Int -> Int -> Int .
go r acc = if r == 0 then acc else go (r - 1) (acc + loop 1 1000000 0).
main = print "list_sum {go 20 0}".

# linpap.fpr -- partial applications and lambdas HOLDING LINEAR VALUES,
# the "PoC unsupported" refusal retired:
#
#   * a partial application over a linear argument (a Vector here) is a
#     LINEAR PAP: the handle is consumed into it, and the PAP itself
#     must be applied exactly once -- the same counting discipline as
#     any linear variable, no new rules
#   * a lambda may CAPTURE a linear value: defining it consumes the
#     variable, the body must use it exactly once, and the closure is
#     linear too
#   * using such a closure twice is still refused (the negative probe
#     in the check-all leg asserts the exact error)
#
#   make qos-app PROG=tests/linpap.fpr
#   (cd ../qos && make portable && ./qosp --yes ../fp-risc/app.qa)
#
# Expected: "linpap: x=5 y=10 z=108"

mk : (n : Int | measure n) -> Vector -> Vector .
mk n v = case n <= 0 of True -> v | False -> mk (n - 1) (Vec.push n v).

# arg order puts the VECTOR first, so partially applying it is exactly
# the previously-refused shape
flipGet : Vector -> Int -> (Int, Vector) .
flipGet v i = Vec.get i v.

addAt : Int -> Int -> Vector -> Vector .
addAt i d v =
  (old, v2) = Vec.get i v;
  Vec.set i (old + d) v2.

main =
  v = mk 10 (Vec.new Unit);          # [10,9,...,1]
  hold = flipGet v;                  # LINEAR PAP: owns v now
  (x, v2) = hold 6;                  # applied exactly once: x = v[6] = 5
  lam = fn d -> addAt 3 d v2;        # lambda CAPTURING the linear v2
  v3 = lam 100;                      # applied exactly once: v[3] += 100
  (y, v4) = Vec.get 1 v3;
  (z, v5) = Vec.get 3 v4;
  _ = Vec.free v5;
  "linpap: x={x} y={y} z={z}".

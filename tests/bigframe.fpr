# bigframe.fpr -- 300+ live let-slots in one function: the old
# codegen refused this at compile time ("frame too large for PoC
# (12-bit imm)"); the frame is now built in 12-bit-legal steps and
# deep slots ride a scratch register, so the ~2.4KB frame just works
# (all targets: rv64 assembles it, x64/a64 fold the immediates).
#
#   expected: bigframe: sum3=57569 add3=70315

add3 a b c = a + b + c.


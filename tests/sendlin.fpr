# sendlin.fpr -- the send triad's MOVE verb (docs/MEMORY.md v2).
#
# The frame is the WHOLE message: receive returns the vector itself,
# sendLinear hands it on.  Both directions of the relay are ZERO-COPY
# (the message slab changes hands; fpr_arc_movable_root in the
# runtime), nobody drops a frame -- the move IS the release -- and the
# checker CONSUMES the sender's binding, so `sendLinear r f` followed
# by another use of f is a compile-time linearity error (check-all
# proves that refusal by message).
#
# The verdict: arcLive after bounce 200 == after bounce 1.  One frame
# root is live at any moment; it just changes owners.

wMax = 64.

render : unsafe Int -> a .
render me =
  m = receive me;
  (p, z) = m;
  _ = drop m;
  rloop me p .
rloop : unsafe Int -> Int -> a .
rloop me p =
  f = receive me;
  f2 = paint f 1;
  _ = sendLinear p f2;
  rloop me p .

paint : unsafe Vector -> Int -> Vector .
paint fb i | i > wMax = fb.
paint fb i = paint (Vec.set i (i * 3) fb) (i + 1) .

fill : unsafe Vector -> Int -> Int -> Vector .
fill v i lim | i > lim = v.
fill v i lim = fill (Vec.push 0 v) (i + 1) lim .

ploop : unsafe Int -> Int -> Vector -> Int -> Int -> Vector .
ploop me r f n stop | n > stop = f.
ploop me r f n stop =
  _ = sendLinear r f;
  g = receive me;
  ploop me r g (n + 1) stop .

main =
  me = myself 0;
  r = spawn render;
  _ = send r (me, 0);
  f0 = fill (Vec.new Unit) 1 wMax;
  f1 = ploop me r f0 1 1;
  base = arcLive 0;
  f2 = ploop me r f1 2 200;
  lv = arcLive 0;
  vr = Vec.get 7 f2;
  (x, f3) = vr;
  ok = case lv == base of True -> "ARC FLAT" | False -> "ARC GREW {base}->{lv}";
  _ = print "sendlin: {ok} bounces=200 cell7={x}";
  _ = Vec.free f3;
  Unit .

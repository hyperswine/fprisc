# float columns + the specialized column loop
scale x = x * 2.0 + 1.0.
keepBig : F64 -> Bool .
keepBig x = x > 4.0.
addf : F64 -> F64 -> F64 .
addf a b = a + b.

build : (n : Int | measure n) -> Vector -> Vector .
build n v = case n <= 0 of True -> v | False -> build (n - 1) (Vec.push (F64.ofInt n) v).

main =
  v = build 1000 (Vec.newAs "d");
  v1 = Vec.map scale v;              # specialized float loop: fmul.d/fadd.d
  (s1, v2) = Vec.fold addf 0.0 v1;
  u0 = print "mapped-sum={F64.str s1}";
  v3 = Vec.filter keepBig v2;
  (n3, v4) = Vec.len v3;
  u1 = print "kept={n3}";
  (e, v5) = Vec.get 1 v4;
  u2 = print "first={F64.str e}";
  _ = Vec.free v5;
  print "FLOATVEC2 HOLDS".

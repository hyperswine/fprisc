# demo.fpr — FPRISC driving QEMU virt devices through the HAL glue.
#
# Nothing here knows an address. `uart`, `clint`, `read`, `write`,
# `reg8`, `reg32`, BITSET/BITCLEAR/BITTEST/BITMASK/BITSHIFT*, bitsLE/
# bitsBE/toInt, charAt/strlen all resolve to fpr_g_* symbols provided
# by hal.c / runtime.c at link time.
#
# NOTE (PoC codegen): no tail-call optimization, so unbounded spin
# loops would grow the stack. Fine here: QEMU's UART LSR.THRE is
# essentially always set.

# ---- devices, looked up by name in the HAL's device table -----------
# `device "name"` walks hal.c's devtable; on real hardware the same
# table would be populated from the DTB by the boot ROM instead of a
# static initializer, and this line would not change.

uart = device "uart" .
clint = device "clint" .

# ---- console: built in FPRISC on top of raw UART registers -------------

lsrReady =
  v = read (reg8 uart 5);
  BITTEST v 5 .

putc : unsafe Int -> Unit .
putc c =
  case lsrReady of
    True -> write (reg8 uart 0) c
  | False -> putc c .

puts : unsafe String -> Unit .
puts s = putsFrom s 1 .

putsFrom : unsafe String -> Int -> Unit .
putsFrom s i =
  n = strlen s;
  case i > n of
    True -> Unit
  | False -> putc (charAt s i) >> putsFrom s (i + 1) .

nl : unsafe Unit .
nl = putc 13 >> putc 10 .

putRes : unsafe Bool -> Unit .
putRes ok = case ok of True -> puts "OK" | False -> puts "FAIL" .

# ---- hex printing: nibble extraction with the bit ops ----------------

nib d = case d < 10 of True -> d + 48 | False -> d + 87 .

putHexN : unsafe Int -> Int -> Unit .
putHexN v k =
  case k == 0 of
    True -> Unit
  | False ->
      putc (nib (band (BITSHIFTR v ((k - 1) * 4)) (BITMASK 4 0)))
        >> putHexN v (k - 1) .

putHex32 : unsafe Int -> Unit .
putHex32 v = puts "0x" >> putHexN v 8 .

# ---- device tests -----------------------------------------------------

# UART scratch register (offset 7): a real write/readback through MMIO.
scrTest : unsafe Unit .
scrTest =
  scr = reg8 uart 7;
  _ = write scr 90;
  r = read scr;
  puts "uart SCR: wrote 90, read {r} ... " >> putRes (r == 90) >> nl .

# UART line control (offset 3): build 8N1 (= 3) with BITSET, write, verify.
lcrTest : unsafe Unit .
lcrTest =
  lcr = reg8 uart 3;
  v = BITSET (BITSET 0 0) 1;
  _ = write lcr v;
  r = read lcr;
  puts "uart LCR: 8N1 built with BITSET = {v}, read back {r} ... "
    >> putRes (r == v) >> nl .

# CLINT mtime (offset 0xBFF8 = 49144): time must advance across a print.
mtimeTest : unsafe Unit .
mtimeTest =
  mt = reg32 clint 49144;
  a = read mt;
  _ = puts "clint mtime: {a}" >> nl;
  b = read mt;
  _ = puts "clint mtime: {b}  (delta {b - a})" >> nl;
  puts "mtime advancing ... " >> putRes (b > a) >> nl .

# Array Bit: same value 1, LE vs BE indexing.
bitsDemo : unsafe Unit .
bitsDemo =
  x = bitsLE 8 1;
  y = bitsBE 8 1;
  s = BITSET x 3;
  _ = puts "Array Bit, value 1, len 8:" >> nl;
  _ = puts "  LE bit0 = {BITTEST x 0}   (LSB first)" >> nl;
  _ = puts "  BE bit0 = {BITTEST y 0}, BE bit7 = {BITTEST y 7}   (MSB first)" >> nl;
  puts "  LE with bit3 set -> {toInt s}" >> nl .

hexDemo : unsafe Unit .
hexDemo =
  v = read (reg32 clint 49144);
  puts "mtime low word: " >> putHex32 v >> nl .

# ---- main -------------------------------------------------------------

main =
  _ = nl >> puts "FPRISC on bare-metal RISC-V (QEMU virt)" >> nl;
  _ = puts "console below is FPRISC code doing MMIO through the HAL glue" >> nl >> nl;
  _ = scrTest;
  _ = lcrTest;
  _ = mtimeTest;
  _ = bitsDemo;
  _ = hexDemo;
  puts "all device tests done" >> nl .

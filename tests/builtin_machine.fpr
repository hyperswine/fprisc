# RV64 machine-mode primitives. Run with ARC=1 ARC_CHECK=1.
check b = case b of True -> Unit | False -> error "machine primitive check failed".
bits =
  top = I64.setBit (I64.trunc 0) 63;
  _ = check (I64.testBit top 63);
  _ = check (I64.clearBit top 63 == I64.trunc 0);
  _ = check (I64.shr top 63 == I64.trunc 1);
  _ = check (I64.shl (I64.trunc 1) 63 == top);
  _ = check (I64.and top (I64.not top) == I64.trunc 0);
  check (I64.or top (I64.not top) == I64.mask 64 0).
atomics =
  p = Mem.alloc 8;
  full = I64.not (I64.trunc 0);
  _ = Mem.write64 p full;
  _ = check (Mem.atomicExchange p (I64.trunc 7) == full);
  _ = check (Mem.compareExchange p (I64.trunc 9) full == I64.trunc 7);
  _ = check (Mem.read64 p == I64.trunc 7);
  _ = check (Mem.compareExchange p (I64.trunc 7) full == I64.trunc 7);
  _ = check (Mem.read64 p == full);
  _ = Mem.fence Unit;
  Mem.free p.
csrs =
  before = CPU.csrRead 832;
  full = I64.not (I64.trunc 0);
  _ = CPU.csrWrite 832 full;
  _ = check (CPU.csrRead 832 == full);
  _ = CPU.csrWrite 832 before;
  _ = check (CPU.csrRead 832 == before);
  check (CPU.csrRead 3860 == I64.trunc 0).
interrupts =
  original = CPU.irqSave Unit;
  sources = CPU.csrRead 772;
  _ = CPU.csrWrite 772 (I64.trunc 0);
  _ = CPU.irqEnable Unit;
  enabled = CPU.irqSave Unit;
  _ = check (enabled == 8);
  nested = CPU.irqSave Unit;
  _ = check (nested == 0);
  _ = CPU.irqRestore nested;
  _ = check (I64.and (CPU.csrRead 768) (I64.trunc 8) == I64.trunc 0);
  _ = CPU.irqRestore enabled;
  again = CPU.irqSave Unit;
  _ = check (again == 8);
  _ = CPU.csrWrite 772 sources;
  CPU.irqRestore original.
main =
  _ = bits;
  _ = atomics;
  _ = csrs;
  _ = interrupts;
  _ = CPU.instructionFence Unit;
  _ = check (Mem.liveAllocations Unit == 0);
  print "MACHINE PRIMITIVES HOLD".

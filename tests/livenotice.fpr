B = use "std/browser".
unsafe base.
G = use "std/view".
check b = case b of True -> Unit | False -> error "reload notice check failed".
main =
  disabled = B.noticeInit False 3000;
  _ = check (B.noticeAdoptedAt 100 0 "policy" "abc" disabled == disabled);
  _ = check (B.noticeAdopted "policy" "abc" disabled == disabled);
  zero = B.noticeInit True 0;
  _ = check (B.noticeAdoptedAt 100 0 "policy" "abc" zero == zero);
  negative = B.noticeInit True (0 - 1);
  _ = check (negative.durationMs == 0);
  first = B.noticeAdoptedAt 100 0 "policy" "abc" (B.noticeInit True 3000);
  _ = check (first.text == "Live Reload new policy#abc 1970-01-01T00:00:00Z");
  _ = check (first.untilUs == 3000100);
  _ = check (B.noticeExpireAt 3000099 first == first);
  _ = check (not (B.noticePending (B.noticeExpireAt 3000100 first)));
  # A newer adoption replaces the deadline; an older timer cannot clear it.
  newer = B.noticeAdoptedAt 2000100 1 "policy" "def" first;
  _ = check (B.noticeExpireAt first.untilUs newer == newer);
  _ = check (newer.text == "Live Reload new policy#def 1970-01-01T00:00:01Z");
  gone = B.noticeExpireAt newer.untilUs newer;
  _ = check (gone.text == "" and gone.untilUs == 0);
  _ = check (B.noticeExpireAt (newer.untilUs + 1) gone == gone);
  (statics, dynamics) = G.render (B.noticeView first.text);
  (emptyStatics, emptyDynamics) = G.render (B.noticeView "");
  _ = check (statics == emptyStatics and dynamics != emptyDynamics);
  _ = print "reload notice: opt-in, UTC text, deadline, replacement and stable view PASS";
  0.

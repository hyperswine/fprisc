unsafe base.
# std/view's generated stylesheet: utilities, app styles as values,
# breakpoint prefixes and the empty-slot opt-out.
#   ./fpr run tests/viewcss.fpr
G = use "std/view".
check what b = case b of True -> Unit | False -> error "viewcss: {what}".
# the first index of s in css, or -1
at : unsafe String -> String -> Int .
at css s = atGo css s 0.
atGo : unsafe String -> String -> Int -> Int .
atGo css s i | i + strlen s > strlen css = 0 - 1.
atGo css s i | substr css i (strlen s) == s = i.
atGo css s i = atGo css s (i + 1).
has css s = at css s >= 0.

main =
  tree = G.El "div" [G.Cls "screen col narrow:row card-x wide:card-x pre show-empty"]
           [G.El "div" [G.Cls "flex-auto min-h-0 truncate hide-empty"] [G.Dyn "x"]];
  styles = G.Style "card-x" [G.Width (G.Px 180), G.MaxWidth (G.Less (G.Pct 50) (G.Px 4)), G.Basis (G.Vh 46)] ::
           G.Style "col" [G.Prop "display" "grid"] :: Nil;
  css = G.cssWith styles tree;
  _ = check "utility" (has css ".flex-auto\{flex:1 1 auto}");
  _ = check "screen" (has css ".screen\{height:100vh;height:100dvh;width:100vw;max-width:100vw;overflow:hidden}");
  _ = check "screen locks the body" (has css "body:has(.screen)\{overflow:hidden}");
  _ = check "hide-empty" (has css ".hide-empty:has(>[data-slot]:empty)\{display:none}");
  _ = check "show-empty opts out" (has css ".pre:not(.show-empty):has(>[data-slot]:empty)");
  _ = check "app style, typed lengths" (has css ".card-x\{width:180px;max-width:calc(50% - 4px);flex-basis:46vh}");
  _ = check "app style replaces a utility" (has css ".col\{display:grid}");
  _ = check "narrow" (has css "@media (max-width:760px)\{\n.narrow\\:row\{display:flex;flex-direction:row}\n}");
  _ = check "wide app style" (has css "@media (min-width:761px)\{\n.wide\\:card-x\{width:180px;");
  _ = check "media after plain" (at css "@media" > at css ".card-x\{");
  _ = check "unused utility absent" (not (has css ".flex-none"));
  plain = G.cssFor (G.El "div" [G.Cls "row"] Nil);
  _ = check "cssFor unchanged" (has plain ".row\{display:flex;flex-direction:row}" and not (has plain "@media"));
  _ = print "view css: utilities, typed app styles, breakpoints, empty slots PASS";
  0.

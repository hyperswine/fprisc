# memory.fpr -- the memory actor (docs/MEMORY.md): one actor owns the
# buddy; every slab, stack and ring the runtime needs from actor
# context is a request to it, and a dead actor's blocks go home as
# one-way frees from the reaper.  Two hundred workers come and go, each
# building enough to grow its pool; afterwards the free space is back
# where it started (within the permanent residue: acbs, channel
# blocks, the ARC table) and the ledger shows every take served and
# none denied.  Sized for the bare-metal kernel's 128 MiB: a hundred
# workers all alive at once (inline takes let the spawner run ahead of
# them) at a stack and a slab or two each.
#
#   make qos-app PROG=tests/memory.fpr && (cd ../qos && ./qosp --yes ../fp-risc/app.qa)
#   make bare-metal-run PROG=tests/memory.fpr
unsafe program.

AC = use "../std/actor".

nth 0 (x :: xs) = x.
nth n (x :: xs) = nth (n - 1) xs.
nth n Nil = 0.

# a worker: builds a list of tuples big enough to need a second slab,
# sums it, reports the sum and dies
build 0 acc = acc.
build n acc = build (n - 1) ((n, n * 2, n * 3) :: acc).
sumT Nil s = s.
sumT ((a, b, c) :: xs) s = sumT xs (s + a + b + c).
worker main me =
  xs = build 2000 Nil;
  _ = AC.sendOrDie main (sumT xs 0);
  0.

launch me 0 = 0.
launch me n =
  w = spawn (worker me);
  launch me (n - 1).
gather me 0 acc = acc.
gather me n acc =
  s = receive me;
  gather me (n - 1) (acc + s).
settle me 0 = 0.
settle me n =
  _ = yield me;
  _ = Sys.sleepUs 2000;
  settle me (n - 1).

main =
  me = myself 0;
  i0 = Sys.memInfo 0;
  arena = nth 0 i0;
  free0 = nth 1 i0;
  _ = print "memory: boot arena {arena} KiB free {free0} KiB, {nth 7 i0} inline {nth 2 i0} queued {nth 4 i0} direct {nth 6 i0} denied";
  _ = launch me 100;
  total = gather me 100 0;
  _ = settle me 20;
  i1 = Sys.memInfo 0;
  free1 = nth 1 i1;
  reqs = nth 2 i1;
  waits = nth 3 i1;
  direct = nth 4 i1;
  frees = nth 5 i1;
  denied = nth 6 i1;
  inl = nth 7 i1;
  pct = free1 * 100 / free0;
  each = 2000 * (2000 + 1) / 2 * 6;
  sumOk = total == each * 100;
  back = pct >= 95;
  served = reqs + inl > 100 and frees > 100 and denied == 0;
  _ = print "memory: arena {arena} KiB, free {free0} -> {free1} KiB ({pct}%) after 100 workers; {inl} served inline, {reqs} queued on the actor ({waits} parked), {direct} direct, {frees} frees, {denied} denied";
  _ = print (verdict sumOk back served);
  0.
verdict True True True = "MEMORY HOLDS (sums right, blocks came home, every take served, none denied)".
verdict s b v = "MEMORY BROKEN (sums {s}, came home {b}, served {v})".

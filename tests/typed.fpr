# typed.fpr — the ML-style modules + SString regression.
#
# Exercises, ON THE METAL (QEMU virt):
#   1. operator dispatch: + on Int (prim opcode) and String (Str.+)
#   2. structure methods as flat globals: Int.max / Int.mod / Str.len
#   3. a generic over a sig carrier, monomorphized at compile time:
#      total (s : Add) resolves s.(+) / s.zero per structure
#   4. SString: the fixed 128B linear inline string, push/at/toStr
#   5. VList grouping over the SoA vector (map/fold via the namespace)

# generic over the Add sig: works for any structure implementing it
# sig-generic AND scheme-carried: the fold does the recursion, the
# carrier does the arithmetic -- no custom recursion, no unsafe marker
total (s : Add) xs = listFold (fn x acc -> x + acc) s.zero xs.

main =
  # -- 1. operator dispatch --
  a = 40 + 2;
  b = "fp" + "risc";

  # -- 2. structure methods --
  m = Int.max 3 9;
  d = 17 % 5;
  n = Str.len b;

  # -- 3. monomorphized generics: Int sum and Str concat via ONE generic --
  si = total Int [1, 2, 3, 4];
  ss = total Str ["a", "b", "c"];

  # -- 4. SString: linear 128B inline string --
  s0 = SStr.new Unit;
  s1 = SStr.push s0 104;
  s2 = SStr.push s1 105;
  # reads THREAD the handle (the Vec.len convention; enforced now that
  # the linearity checker sees inferred and builtin shapes)
  (ln, s3) = SStr.len s2;
  (c1, s4) = SStr.at s3 1;
  (hs, s5) = SStr.toStr s4;
  _ = drop s5;

  # -- 5. VList over the SoA vector --
  v0 = Vec.fromList [1, 2, 3];
  v1 = VList.map (fn x -> x * 10) v0;
  sm = VList.fold (fn acc x -> acc + x) 0 v1;

  _ = print "ops: {a} {b}";
  _ = print "methods: max={m} mod={d} len={n}";
  _ = print "generic: total Int={si} total Str={ss}";
  _ = print "sstring: len={ln} at1={c1} str={hs}";
  print "vlist: fold={sm}".

profile base.
# Explicit 32-bit fixed-width integer bit and wrapping operations.
check yes = if yes then Unit else error "RV32 I32 check failed".
main : Unit .
main =
  zero = I32.trunc 0;
  one = I32.trunc 1;
  hi = I32.shl one 31;
  all = I32.not zero;
  _ = check (I32.testBit hi 31);
  _ = check (I32.shr hi 31 == one);
  _ = check (all + one == zero);
  _ = check (zero - one == all);
  _ = check (I32.or hi one == I32.setBit hi 0);
  print "RV32 WORD32 HOLDS".

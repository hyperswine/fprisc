# frames.fpr — the memory model's steady-state pattern, demonstrated:
# ONE linear frame RELAYED between actors by sendLinear — zero copies,
# NO Arc growth per frame.
#
# v2 (docs/MEMORY.md): `send` deep-copies with no exceptions, so the
# old ping-pong spelling — destructure a frame out of a message, drop
# the root, keep using the frame — is exactly the copy-on-retain
# violation the laws name (it was only ever sound while vectors rode
# messages by CoW share).  The honest spelling is the MOVE verb: the
# frame IS the whole message, `sendLinear` hands the message slab
# across zero-copy, and nobody drops a frame — the move is the
# release.  The proof is the number printed at the end: arcLive after
# 200 frames == arcLive after frame 1.  One frame root is live at any
# moment; it just changes owners.

uart = device "uart" .
lsrReady = v = read (reg8 uart 5); BITTEST v 5 .
putc : unsafe Int -> Unit .
putc c | lsrReady = write (reg8 uart 0) c.
putc c = putc c .
# console text over THIS file's putc (the prelude cannot host these:
# putc is per-target device code, and the prelude is a cached unit)
puts : unsafe String -> Unit .
puts s = putsFrom s 1 .
putsFrom : unsafe String -> Int -> Unit .
putsFrom s i | i > strlen s = Unit.
putsFrom s i = putc (charAt s i) >> putsFrom s (i + 1) .
nl : unsafe Unit .
nl = putc 13 >> putc 10 .

wMax = 64.

# ---- the renderer: a service owning NOTHING ----------------------------
# It receives the frame itself, mutates it through the linear handle,
# and MOVES it straight back.  It retains no reference and drops no
# root: sendLinear consumed what receive handed it.  A renderer that
# kept a frame would be a compile-time linearity error in its own code
# and a visible arcLive climb here.

render : unsafe Int -> a .
render me =
  m = receive me;
  (p, z) = m;
  _ = drop m;
  rloop me p .
rloop : unsafe Int -> Int -> a .
rloop me p =
  fb = receive me;
  fb2 = paint fb 0 1;
  _ = sendLinear p fb2;
  rloop me p .

# paint: bulk mutation through the linear handle — in place, no
# allocation, the same handle threads out.
paint : unsafe Vector -> Int -> Int -> Vector .
paint fb v i | i > wMax = fb.
paint fb v i = paint (Vec.set i v fb) v (i + 1) .

# ---- the producer loop: the relay -------------------------------------
# ONE frame exists.  It shuttles between producer and renderer by
# ownership move; frame lifetime is the LOOP STRUCTURE, not a
# collector's discovery, and the steady state copies NOTHING per frame.

loop : unsafe Int -> Int -> Vector -> Int -> Int -> Vector .
loop me r fb n stop | n > stop = fb.
loop me r fb n stop =
  _ = sendLinear r fb;
  g = receive me;
  loop me r g (n + 1) stop .

main =
  me = myself 0;
  _ = nl >> puts "frames: linear frame relay (sendLinear), Arc-flat steady state" >> nl;
  r = spawn render;
  _ = send r (me, 0);
  fbA = Vec.iota wMax;
  fb1 = loop me r fbA 1 1;
  base = arcLive 0;
  _ = puts "after frame 1:    arcLive = {base}" >> nl;
  fb2 = loop me r fb1 2 200;
  lv = arcLive 0;
  _ = puts "after frame 200:  arcLive = {lv}" >> nl;
  vr = Vec.get 7 fb2;
  (x, fb3) = vr;
  _ = puts "spot check: frame cell 7 = {x} (painted by the last owner)" >> nl;
  _ = verdict (lv == base);
  _ = Vec.free fb3;
  Unit .

verdict : unsafe Bool -> Unit .
verdict True = puts "ARC FLAT: 199 frames, zero copies -- the sendLinear relay holds" >> nl.
verdict _ = puts "ARC GREW: move discipline broken somewhere" >> nl.

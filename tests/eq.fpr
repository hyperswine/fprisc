# eq.fpr -- what `==` means, as an executable spec.
#
# It used to mean less than it looked like: ints compared by value,
# strings by content, and EVERYTHING else by its header alone, so two
# tuples of the same shape were equal whatever they held --
# `(1, 2) == (3, 4)` was True, and so was `[1, 2] == [3, 4]`.  Every
# program comparing structured values was quietly wrong, and nothing
# said so.  Equality is deep now (hal/core/runtime.c veq), over the
# field counts the allocation header has always carried.
#
#   make qos-app PROG=tests/eq.fpr && (cd ../qos && ./qosp --yes ../fp-risc/app.qa)
unsafe program.

Shape = Type (Nought | One a | Two a b).
Pair = Type (Pair x y).

expect what got want = case got == want of
    True -> print "ok  {what}"
  | False -> print "FAIL {what}: got {got}, wanted {want}".
yes what b = case b of True -> print "ok  {what}" | False -> print "FAIL {what}: wanted True".
no what b = case b of False -> print "ok  {what}" | True -> print "FAIL {what}: wanted False".

# a value built twice, so nothing can pass by pointer identity
mkPair n = Pair n (n + 1).
mkList n = n :: n + 1 :: n + 2 :: Nil.
mkNest n = (n, (n + 1, n :: Nil)).

main =
  # ---- ints, the case that always worked ----
  _ = yes "1 == 1" (1 == 1);
  _ = no "1 == 2" (1 == 2);
  _ = no "0 - 1 == 1" (0 - 1 == 1);

  # ---- tuples: the headline bug ----
  _ = yes "(1, 2) == (1, 2)" ((1, 2) == (1, 2));
  _ = no "(1, 2) == (3, 4)" ((1, 2) == (3, 4));
  _ = no "(1, 2) == (1, 9)  -- one field differing is enough" ((1, 2) == (1, 9));
  _ = yes "a tuple built twice is still equal" (mkPair 3 == mkPair 3);
  _ = no "and not to its neighbour" (mkPair 3 == mkPair 4);
  # (a 2-tuple against a 3-tuple is refused by the TYPE checker, which
  # is the right place for it -- there is no runtime case to test)

  # ---- lists ----
  _ = yes "[] == []" (Nil == Nil);
  _ = yes "[1,2,3] == [1,2,3]" (mkList 1 == mkList 1);
  _ = no "[1,2,3] == [2,3,4]" (mkList 1 == mkList 2);
  _ = no "a longer list is not equal" ((1 :: 2 :: Nil) == (1 :: 2 :: 3 :: Nil));
  _ = no "nor a shorter one" ((1 :: 2 :: 3 :: Nil) == (1 :: 2 :: Nil));
  _ = no "[] is not [0]" (Nil == (0 :: Nil));

  # ---- strings, which already compared by content ----
  _ = yes "\"ab\" == \"ab\"" ("ab" == "ab");
  _ = no "\"ab\" == \"ac\"" ("ab" == "ac");
  _ = no "prefixes are not equal" ("ab" == "abc");
  _ = yes "the empty string" ("" == "");

  # ---- constructors: variant AND payload ----
  _ = yes "Nought == Nought" (Nought == Nought);
  _ = no "Nought != One 1" (Nought == One 1);
  _ = yes "One 1 == One 1" (One 1 == One 1);
  _ = no "One 1 != One 2" (One 1 == One 2);
  _ = yes "Two 1 \"a\" == Two 1 \"a\"" (Two 1 "a" == Two 1 "a");
  _ = no "Two 1 \"a\" != Two 1 \"b\"" (Two 1 "a" == Two 1 "b");

  # ---- nesting: the recursion has to go all the way down ----
  _ = yes "nested, same" (mkNest 1 == mkNest 1);
  _ = no "nested, one leaf differs" (mkNest 1 == mkNest 2);
  _ = no "a difference inside a list inside a tuple"
        ((1, (2, 3 :: Nil)) == (1, (2, 4 :: Nil)));

  # ---- records ----
  _ = yes "records by field" ({ a = 1, b = "x" } == { a = 1, b = "x" });
  _ = no "records differ by field" ({ a = 1, b = "x" } == { a = 1, b = "y" });

  # ---- != is the negation, everywhere ----
  _ = yes "!= on tuples" ((1, 2) != (3, 4));
  _ = no "!= on equal tuples" ((1, 2) != (1, 2));
  _ = yes "!= on lists" (mkList 1 != mkList 9);

  # ---- bools and unit, the cases the old shallow rule did get right ----
  _ = yes "True == True" (True == True);
  _ = no "True == False" (True == False);
  _ = yes "Unit == Unit" (Unit == Unit);
  _ = print "eq: done";
  0.

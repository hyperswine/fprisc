# Appended to the actual application with main renamed. No LAN/config access.
SessionProgram = use "examples/printer-dashboard/sessionprogram".
main =
  _ = List.map (fn test -> case test of (raw, places, expected) ->
    actual = reading places "value" (Json.object [("value", (case Json.parse raw of Ok value -> value | _ -> Json.Null))]);
    if actual == expected then Unit else error "reading {raw}: wanted {expected}, got {actual}")
    [("219.49999999999", 0, "219"), ("219.5", 0, "220"), ("59.9999999999", 0, "60"),
     ("-0.4", 0, "0"), ("-0.5", 0, "-1"), ("-12.6", 0, "-13"), ("0", 0, "0"),
     ("0.0666666666667", 1, "0.1"), ("1.9999999999999", 1, "2"), ("null", 0, "—"), ("\"bad\"", 0, "—"), ("1e100", 0, "—")];
  p = Json.object [("id", Json.Text "sample"), ("name", Json.Text "Workshop printer"),
    ("nozzle", Json.Real "219.999999999999"), ("bed", Json.Real "59.999999999999"),
    ("report_hz", Json.Real "0.3333333333333"), ("nozzle_target", Json.Real "220.00000000000"), ("bed_target", Json.Real "60.00000000000"),
    ("model", Json.Text "P1S"), ("location", Json.Text "Workshop"), ("connection", Json.Text "ONLINE"),
    ("alerts", Json.Sequence [Json.object [("title", Json.Text "Filament runout reported"), ("severity", Json.Text "error"), ("source", Json.Text "HMS"), ("code", Json.Text "0700200000020001"), ("url", Json.Text "https://e.bambulab.com/?e=0700200000020001")], Json.object [("title", Json.Text "Printer health alert"), ("severity", Json.Text "unknown"), ("source", Json.Text "HMS"), ("code", Json.Text "FFFFFFFF00000001"), ("url", Json.Text "https://e.bambulab.com/?e=FFFFFFFF00000001")]]),
    ("print_error_reported", Json.Boolean True), ("hms_reported", Json.Boolean True),
    ("state", Json.Text "PAUSE"), ("progress", Json.Integer 37), ("camera_available", Json.Boolean True)];
  v = {printers = [p], now = 1, generated = 1, tickUs = 0, ticks = 0, demo = True, issue = "", care = Care.empty, careProblem = "",
    session = {noSess | sid = 1, expanded = ["sample"], cameras = ["sample"]}};
  (ss, ds) = view 1000 1 v;
  _ = print (Json.render (Json.object [("s", Json.strings ss), ("d", Json.strings ds),
    ("media", Json.Text cameraScript), ("session", Json.Text (SessionProgram.src Unit)), ("body", Json.Text (G.attrsOf UI.document)), ("css", Json.Text (G.localCss (G.atomNames (G.localAtoms UI.document))))]));
  0.

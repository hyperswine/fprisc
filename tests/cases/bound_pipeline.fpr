# Historical undersized proof, retained as an expected UNPROVED regression.
# Std map's growing reverse accumulator cannot be priced at its initial size.
# See bound_pipeline_direct.fpr for the separately justified positive case.
L = use "std/list".
double : Int -> Int | work double <= 1 .
double x = x * 2.
total : (xs : List Int) -> Int | work total <= 19 * len xs + 27 .
total xs = L.sum (L.map double xs).
main = print (total (L.range 1 10)).

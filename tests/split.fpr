# split.fpr -- a function's clauses may be split by another definition:
# the inferencer always read every clause of a name; the desugarer used
# to keep only the LAST contiguous run, so `f 0` below would have fallen
# through to "n1" with no error.  Expected: "split: zero n6 one".
unsafe program.

f 0 = "zero".
helper x = x + 1.
f n = "n{helper n}".
g 1 = "one".
main = "split: {f 0} {f 5} {g 1}".

# tpar.fpr -- the TRANSPARENT-ACB proof, loaded as a process:
#   * spawn works from a loaded process (the workers land in the
#     KERNEL's per-hart queues, donated/stolen like System.qa's own)
#   * every worker inherits the process pid (myPid) from its spawner
#   * hartId inside each worker shows which kernel hart actually ran
#     it -- a mask with more than one bit set is the multi-hart proof

work : (n : Int | measure n) -> Int -> Int .
work n acc | n <= 0 = acc.
work n acc = work (n - 1) (acc + n).

worker : Int -> Unit .
worker me =
  m = receive me;
  (replyTo, n) = m;
  _ = send replyTo (myPid 0, hartId 0, work n 0);
  Unit.

launch : Int -> (k : Int | measure k) -> Int -> Unit .
launch me k n | k <= 0 = Unit.
launch me k n =
  w = spawn worker;
  _ = send w (me, n);
  launch me (k - 1) n.

collect : Int -> (k : Int | measure k) -> Int -> Int -> Int -> (Int, Int, Int) .
collect me k pids hmask sum | k <= 0 = (pids, hmask, sum).
collect me k pids hmask sum =
  r = receive me;
  (p, h, s) = r;
  collect me (k - 1) (pids + p) (BITSET hmask h) (sum + s).

bit : Int -> Int -> Int .
bit m i = case BITTEST m i of True -> 1 | False -> 0.

verdict : Int -> Int -> Int -> String .
verdict pids hcount sum | pids != 8 * (myPid 0) = "FAIL: pid sum {pids}, want {8 * (myPid 0)}".
verdict pids hcount sum | sum != 8 * 500000500000 = "FAIL: work sum {sum}".
verdict pids hcount sum = "ok pid={myPid 0} pidsum={pids} harts={hcount} sum={sum}".

main =
  me = myself 0;
  _ = launch me 8 1000000;
  (pids, hmask, sum) = collect me 8 0 0 0;
  hcount = (bit hmask 0) + (bit hmask 1) + (bit hmask 2) + (bit hmask 3);
  r = verdict pids hcount sum;
  "tpar: {r}".

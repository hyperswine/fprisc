# Standalone unsafe Builtin smoke test; no prelude or scheduler.
Node = Type (Node a b).
check ok = case ok of True -> Unit | False -> error "Builtin check failed".
sum n acc = case n == 0 of True -> acc | False -> sum (n - 1) (acc + n).
stress n = case n == 0 of
  True -> Unit
| False ->
  a = [n];
  b = Rc.retain a;
  node = Node a b;
  alias = Rc.retain node;
  _ = Rc.release node;
  _ = check (case alias of Node l r -> l == r);
  _ = Rc.release alias;
  stress (n - 1).
main =
  _ = check (sum 100000 0 == 5000050000);
  _ = stress 10000;
  all = I64.not (I64.trunc 0);
  _ = check (all == I64.mask 64 0);
  _ = check (I64.toInt all == -1);
  high = I64.shl (I64.trunc 1) 63;
  _ = check (I64.shr high 63 == I64.trunc 1);
  _ = check (I64.and all high == high);
  _ = check (I64.xor all all == I64.mask 0 64);
  _ = check (all + I64.trunc 1 == I64.trunc 0);
  _ = check (Addr.toI64 (Addr.ofI64 all) == all);
  p = Mem.alloc 16;
  _ = Mem.write8 p 171;
  p2 = Addr.add p 2;
  _ = Mem.write16 p2 48879;
  p8 = Addr.add p 8;
  _ = Mem.write64 p8 all;
  q = Mem.realloc p 4096;
  _ = check (Mem.read8 q == 171);
  _ = check (Mem.read16 (Addr.add q 2) == 48879);
  _ = check (Mem.read64 (Addr.add q 8) == all);
  _ = Mem.write32 q (I32.not (I32.trunc 0));
  _ = check (Mem.read32 q == I32.mask 32 0);
  _ = Mem.fence Unit;
  z = Mem.realloc q 0;
  _ = check (Addr.eq z (Addr.null Unit));
  _ = Mem.free z;
  xs = [1, 2, 3];
  ys = Rc.retain xs;
  _ = Rc.release xs;
  _ = check (ys == [1, 2, 3]);
  _ = Rc.release ys;
  print "BUILTIN HOLDS".

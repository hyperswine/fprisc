# precond.fpr — type-level preconditions (contracts) PoC.
#
# A signature part may NAME and CONSTRAIN a parameter:
#
#     addAmount : (n : Int | n > 0) -> State -> State.
#
# The predicate lives in the smallest decidable fragment (comparisons
# over +,-,* of vars and ints, and2/or2) so "provable" vs "checked" is
# a stable line, never solver-mood.  Obligations are discharged
# STATICALLY where a local fact proves them — clause guards, case
# discrimination, the caller's own preconditions — and compile to a
# call-boundary check with blame otherwise (see precondviol.fpr for
# the crash side).  The compiler reports every obligation:
#
#     precond: update -> addAmount requires (n > 0): discharged statically
#
# The style showcase: an Elm-style update — one clause per Msg, one
# guard per invariant, one pipeline per transformation.  Which case
# (clause head), is it valid (guard), what happens (pipeline) — three
# axes, three places, no nesting.

State = { amount : Int, hist : Int }.

Msg = Type (Increment Int | Decrement Int | Reset).

# ---- guarded transitions: the contract IS the signature -------------

addAmount : (n : Int | n > 0) -> State -> State.
addAmount n s = { s | amount = s.amount + n, hist = s.hist + 1 }.

subAmount : (n : Int | n > 0) -> State -> State.
subAmount n s = { s | amount = s.amount - n, hist = s.hist + 1 }.

clampToMax : State -> State.
clampToMax s = case s.amount > 100 of True -> { s | amount = 100 } | False -> s.

clampToMin : State -> State.
clampToMin s = case s.amount < 0 of True -> { s | amount = 0 } | False -> s.

recordHistory : State -> State.
recordHistory s = s.

resetToDefault : State -> State.
resetToDefault s = { amount = 0, hist = s.hist + 1 }.

# ---- the update function --------------------------------------------

update : Msg -> State -> State.
update (Increment n) s | n > 0 =
  s
  |> addAmount n
  |> clampToMax
  |> recordHistory.
update (Increment _) s = s.

update (Decrement n) s | n > 0 =
  s
  |> subAmount n
  |> clampToMin
  |> recordHistory.
update (Decrement _) s = s.

update Reset s =
  s |> resetToDefault.

# ---- propagation: my own precondition discharges the builtin --------
# (the (/) axiom — divisor != 0 — is proven by avg's own contract, so
# every caller of avg carries the obligation instead)

avg : Int -> (n : Int | n != 0) -> Int.
avg total n = total / n.

# ---- case discrimination as the proof term --------------------------
# (falling through past the 0 arm IS the fact n != 0)

safeAvg : Int -> Int -> Int.
safeAvg total n = case n of
  0 -> 0
| _ -> avg total n.

# ---- an obligation nothing local proves: runtime check, passes ------

bump : Int -> State -> State.
bump k s = addAmount k s.

main =
  s0 = { amount = 50, hist = 0 };
  s1 = update (Increment 30) s0;
  s2 = update (Increment 40) s1;
  s3 = update (Decrement 25) s2;
  s4 = update (Increment 0) s3;
  s5 = update Reset s4;
  s6 = bump 7 s5;
  a = avg 90 s3.hist;
  b = safeAvg 10 0;
  _ = print "amount: {s1.amount} {s2.amount} {s3.amount} {s4.amount} {s5.amount} {s6.amount}";
  _ = print "hist: {s6.hist}";
  print "avg: {a} {b}  precond done".

# pingpong.fpr -- cross-hart wake stress, the FPRLive acceptor's shape:
# a PINNED actor on hart 1 round-trips a request to an UNPINNED replier
# spawned on hart 0, yielding and napping like a poll loop; a third actor
# spams the replier from hart 2 so its channels see traffic from more
# than one sender.  A lost wake shows up as the deadlock detector's dump.
unsafe program.

Q = Type (Ask who | Reply n | Spam k).

replier me = replLoop me 0.
replLoop me n =
  m = receive me;
  _ = drop m;
  case m of
    Ask who -> _ = send who (Reply n); replLoop me (n + 1)
  | o -> replLoop me n.

St = Type (St rep boss k).
poller rep boss me = pollLoop me (St rep boss 0).
pollLoop me st =
  St rep boss k = st;
  case k >= 20000 of
    True -> _ = send boss (Reply k); k
  | False -> pollTurn me st.
pollTurn me st =
  St rep boss k = st;
  _ = send rep (Ask me);
  r = receiveFrom me rep;
  Reply n = r;
  _ = drop r;
  _ = yield me;
  _ = case k % 8 == 0 of True -> Sys.sleepUs 100 | False -> Sys.sleepUs 0;
  st2 = St rep boss (k + 1);
  case k % 64 == 0 of
    True -> pollLoop me (boundary me st2)
  | False -> pollLoop me st2.
# the FPRLive frame boundary: state to self, reset, read back
boundary me st =
  _ = send me st;
  _ = Sys.poolReset 0;
  m = receiveFrom me me;
  st2 = keep m;
  _ = drop m;
  st2.

spammer rep me = spamLoop rep me 0.
spamLoop rep me k | k >= 20000 = k.
spamLoop rep me k =
  _ = send rep (Spam k);
  _ = case k % 64 == 0 of True -> yield me | False -> yield me;
  spamLoop rep me (k + 1).

waiter who me = w = receiveFrom me who; _ = drop w; 0.

main =
  me = myself 0;
  rep = spawn replier;
  pol = spawnOn 1 (poller rep me);
  spm = spawnOn (Sys.harts Unit - 1) (spammer rep);
  r = receiveFrom me pol;
  Reply k = r;
  _ = drop r;
  "pingpong: ok after {k} round trips".

# dtree.fpr -- a histogram-binned decision tree (classification,
# entropy gain), pure FP-RISC, mirroring the Haskell reference design:
#
#   * dataset is COLUMN-MAJOR: one F64 Vec per feature
#   * each column is pre-binned once into 256 equal-width bins, giving
#     an Int code per cell; all split search happens on codes
#   * at each node, per column: one O(n) pass scatters a
#     (bins x classes) class-count histogram into a flat Vec, then one
#     O(bins) prefix sweep scores every threshold; best (column, bin)
#     wins if its gain clears minGain
#   * stopping: purity, maxDepth, minLeaf, or nothing clears minGain
#
# What the port exercises: F64 columns and folds, the linear Vec
# discipline (get/set/fold return the handle; every reader threads
# it), scatter writes into a flat histogram, constructor trees, and a
# hand-rolled log2 (F64 has sqrt but no log: normalize to [1,2) then
# 48 squaring steps -- the classic bit-by-bit fraction).
#
#   make qos-app PROG=tests/dtree.fpr
#   (cd ../qos && make portable && ./qosp --yes ../fp-risc/app.qa)
#
# The demo is noisy XOR (4000 train / 1000 test, 5% label noise, LCG
# uniforms) -- the canonical "no linear tally can do this" dataset.
# The Haskell reference (GHC -O2, exact logBase) lands nodes=133
# depth=8, train 0.94675, test 0.949, root col 1 @ -0.9374044427531771
# -- and this port reproduces ALL of it bit-for-bit: the 48-bit log2
# leaves every gain comparison on the same side as libm's.
#
# One sharp edge, learned here: a float FIELD pulled out of a Type
# constructor interpolates as raw bits ({thr} segfaulted -- the
# tid-directed render cannot see an untyped field's floatness, and the
# compile-time refusal misses the case too); the v1 discipline is the
# explicit F64.str, as in rootLine below.

# ---- params + tree ----------------------------------------------------------

P = Type (P bins maxDepth minGain minLeaf k).
Tree = Type (Leaf c | Split col thr l r).

# ---- small helpers ----------------------------------------------------------

neqB a b = case a of True -> (case b of True -> False | False -> True) | False -> b.
cvec n v = Vec.axpb 0 v (Vec.iota n).

fminf : F64 -> F64 -> F64 .
fminf a b = case b < a of True -> b | False -> a.
fmaxf : F64 -> F64 -> F64 .
fmaxf a b = case b > a of True -> b | False -> a.

iotaL : unsafe Int -> Int -> List Int .
iotaL i n = case i >= n of True -> Nil | False -> i :: iotaL (i + 1) n.

# class-count vectors as small lists (k entries)
zerosL : unsafe Int -> List Int .
zerosL k = case k == 0 of True -> Nil | False -> 0 :: zerosL (k - 1).
bumpL : unsafe List Int -> Int -> List Int .
bumpL Nil j = Nil.
bumpL (c :: r) 0 = (c + 1) :: r.
bumpL (c :: r) j = c :: bumpL r (j - 1).
sumL : unsafe List Int -> Int .
sumL l = case l of Nil -> 0 | c :: r -> c + sumL r.
addL : unsafe List Int -> List Int -> List Int .
addL a b = case a of Nil -> Nil | x :: r -> addL2 r b x.
addL2 : unsafe List Int -> List Int -> Int -> List Int .
addL2 r b x = case b of Nil -> Nil | y :: s -> (x + y) :: addL r s.
subL : unsafe List Int -> List Int -> List Int .
subL a b = case a of Nil -> Nil | x :: r -> subL2 r b x.
subL2 : unsafe List Int -> List Int -> Int -> List Int .
subL2 r b x = case b of Nil -> Nil | y :: s -> (x - y) :: subL r s.
# first index of the maximum (U.maxIndex's tie rule)
argmaxL : unsafe List Int -> Int .
argmaxL (c :: r) = amGo r c 0 1.
argmaxL Nil = 0.
amGo : unsafe List Int -> Int -> Int -> Int -> Int .
amGo Nil bv bi i = bi.
amGo (c :: r) bv bi i | c > bv = amGo r c i (i + 1).
amGo (c :: r) bv bi i = amGo r bv bi (i + 1).

# ---- log2: normalize to [1,2), then 48 bit-by-bit fraction steps ------------

log2f : unsafe F64 -> F64 .
log2f x = l2n x 0.
l2n : unsafe F64 -> Int -> F64 .
l2n x e | x >= 2.0 = l2n (x * 0.5) (e + 1).
l2n x e | x < 1.0 = l2n (x * 2.0) (e - 1).
l2n x e = F64.ofInt e + l2f x 0.0 0.5 48.
l2f : unsafe F64 -> F64 -> F64 -> Int -> F64 .
l2f x acc sc 0 = acc.
l2f x acc sc i = l2g (x * x) acc sc i.
l2g : unsafe F64 -> F64 -> F64 -> Int -> F64 .
l2g x2 acc sc i | x2 >= 2.0 = l2f (x2 * 0.5) (acc + sc) (sc * 0.5) (i - 1).
l2g x2 acc sc i = l2f x2 acc (sc * 0.5) (i - 1).

# ---- entropy over a class-count list ----------------------------------------

entL : unsafe List Int -> F64 .
entL cnts = entN cnts (sumL cnts).
entN : unsafe List Int -> Int -> F64 .
entN cnts n | n <= 0 = 0.0.
entN cnts n = entGo cnts (F64.ofInt n) 0.0.
entGo : unsafe List Int -> F64 -> F64 -> F64 .
entGo Nil n acc = acc.
entGo (c :: r) n acc | c == 0 = entGo r n acc.
entGo (c :: r) n acc = entP r n acc (F64.ofInt c / n).
entP : unsafe List Int -> F64 -> F64 -> F64 -> F64 .
entP r n acc p = entGo r n (acc - p * log2f p).

# ---- class counts at a node -------------------------------------------------

ccounts : unsafe Vector -> List Int -> Int -> _ .
ccounts ys idxs k = ccGo ys idxs (zerosL k).
ccGo : unsafe Vector -> List Int -> List Int -> _ .
ccGo ys Nil acc = (acc, ys).
ccGo ys (i :: r) acc =
  (y, ys2) = Vec.get (i + 1) ys;
  ccGo ys2 r (bumpL acc y).

# ---- the histogram: one scatter pass over the node's rows -------------------

histB : unsafe Vector -> Vector -> Vector -> List Int -> Int -> _ .
histB h cs ys Nil k = (h, cs, ys).
histB h cs ys (i :: r) k =
  (b, cs2) = Vec.get (i + 1) cs;
  (y, ys2) = Vec.get (i + 1) ys;
  pos = b * k + y + 1;
  (old, h2) = Vec.get pos h;
  histB (Vec.set pos (old + 1) h2) cs2 ys2 r k.

# the k counts of bin row t
rowL : unsafe Vector -> Int -> Int -> Int -> _ .
rowL h base j k = case j >= k of True -> (Nil, h) | False -> rowGo h base j k.
rowGo : unsafe Vector -> Int -> Int -> Int -> _ .
rowGo h base j k =
  (v, h2) = Vec.get (base + j + 1) h;
  (rest, h3) = rowL h2 base (j + 1) k;
  (v :: rest, h3).

# ---- the prefix sweep: score every threshold once ---------------------------
# best = (gain, bin, found); an earlier best survives a tie (g0 >= g),
# the reference's rule.

sweep : unsafe Vector -> Int -> List Int -> F64 -> Int -> Int -> P -> Int -> F64 -> List Int -> _ .
sweep h t lc bg bt has ps n parentH totalC =
  P bins md mg ml k = ps;
  case t >= bins - 1 of
    True -> ((bg, bt, has), h)
  | False -> swRow h t lc bg bt has ps n parentH totalC.
swRow : unsafe Vector -> Int -> List Int -> F64 -> Int -> Int -> P -> Int -> F64 -> List Int -> _ .
swRow h t lc bg bt has ps n parentH totalC =
  P bins md mg ml k = ps;
  (row, h2) = rowL h (t * k) 0 k;
  lc2 = addL lc row;
  nl = sumL lc2;
  case nl < ml of
    True -> sweep h2 (t + 1) lc2 bg bt has ps n parentH totalC
  | False -> case n - nl < ml of
      True -> sweep h2 (t + 1) lc2 bg bt has ps n parentH totalC
    | False -> swScore h2 t lc2 bg bt has ps n parentH totalC nl.
swScore : unsafe Vector -> Int -> List Int -> F64 -> Int -> Int -> P -> Int -> F64 -> List Int -> Int -> _ .
swScore h t lc2 bg bt has ps n parentH totalC nl =
  wl = F64.ofInt nl / F64.ofInt n;
  wr = F64.ofInt (n - nl) / F64.ofInt n;
  g = parentH - (wl * entL lc2 + wr * entL (subL totalC lc2));
  case has == 1 of
    True -> (case bg >= g of
        True -> sweep h (t + 1) lc2 bg bt has ps n parentH totalC
      | False -> sweep h (t + 1) lc2 g t 1 ps n parentH totalC)
  | False -> sweep h (t + 1) lc2 g t 1 ps n parentH totalC.

# ---- best split of one column ----------------------------------------------

bsc : unsafe P -> F64 -> Vector -> Vector -> List Int -> Int -> List Int -> _ .
bsc ps parentH cs ys idxs n totalC =
  P bins md mg ml k = ps;
  h0 = cvec (bins * k) 0;
  (h1, cs2, ys2) = histB h0 cs ys idxs k;
  (best, h2) = sweep h1 0 (zerosL k) 0.0 0 0 ps n parentH totalC;
  _ = Vec.free h2;
  (best, cs2, ys2).

# ---- partition a node's rows by code <= t -----------------------------------
# (prepend-built; every consumer is order-insensitive -- counts,
# histograms, and the next partition see the same SET)

part : unsafe Vector -> List Int -> Int -> List Int -> List Int -> _ .
part cs Nil t al ar = (al, ar, cs).
part cs (i :: rest) t al ar =
  (b, cs2) = Vec.get (i + 1) cs;
  case b <= t of
    True -> part cs2 rest t (i :: al) ar
  | False -> part cs2 rest t al (i :: ar).

# ---- tree building ----------------------------------------------------------
# B carries each column's binning (lo, width) so a bin threshold maps
# back to the raw value edge lo + (t+1)*w without an edges vector.

B = Type (B lo0 w0 lo1 w1).

build : unsafe P -> B -> Vector -> Vector -> Vector -> Int -> List Int -> _ .
build ps bn c0 c1 ys depth idxs =
  P bins md mg ml k = ps;
  n = List.len idxs;
  (counts, ys2) = ccounts ys idxs k;
  case depth >= md of
    True -> (Leaf (argmaxL counts), c0, c1, ys2)
  | False -> case n < 2 * ml of
      True -> (Leaf (argmaxL counts), c0, c1, ys2)
    | False -> buildH ps bn c0 c1 ys2 depth idxs n counts (entL counts).
buildH : unsafe P -> B -> Vector -> Vector -> Vector -> Int -> List Int -> Int -> List Int -> F64 -> _ .
buildH ps bn c0 c1 ys depth idxs n counts parentH =
  case parentH == 0.0 of
    True -> (Leaf (argmaxL counts), c0, c1, ys)
  | False -> buildS ps bn c0 c1 ys depth idxs n counts parentH.
buildS : unsafe P -> B -> Vector -> Vector -> Vector -> Int -> List Int -> Int -> List Int -> F64 -> _ .
buildS ps bn c0 c1 ys depth idxs n counts parentH =
  ((g0, t0, f0), c0b, ys2) = bsc ps parentH c0 ys idxs n counts;
  ((g1, t1, f1), c1b, ys3) = bsc ps parentH c1 ys2 idxs n counts;
  # earlier column survives a tie (the reference's ifoldl rule)
  case f0 == 1 of
    True -> (case f1 == 1 of
        True -> (case g0 >= g1 of
            True -> buildGo ps bn c0b c1b ys3 depth idxs counts g0 0 t0
          | False -> buildGo ps bn c0b c1b ys3 depth idxs counts g1 1 t1)
      | False -> buildGo ps bn c0b c1b ys3 depth idxs counts g0 0 t0)
  | False -> case f1 == 1 of
      True -> buildGo ps bn c0b c1b ys3 depth idxs counts g1 1 t1
    | False -> (Leaf (argmaxL counts), c0b, c1b, ys3).
buildGo : unsafe P -> B -> Vector -> Vector -> Vector -> Int -> List Int -> List Int -> F64 -> Int -> Int -> _ .
buildGo ps bn c0 c1 ys depth idxs counts gain col t =
  P bins md mg ml k = ps;
  case gain >= mg of
    False -> (Leaf (argmaxL counts), c0, c1, ys)
  | True -> case col == 0 of
      True -> buildL0 ps bn c0 c1 ys depth idxs t
    | False -> buildL1 ps bn c0 c1 ys depth idxs t.
buildL0 : unsafe P -> B -> Vector -> Vector -> Vector -> Int -> List Int -> Int -> _ .
buildL0 ps bn c0 c1 ys depth idxs t =
  B lo0 w0 lo1 w1 = bn;
  (l, r, c0b) = part c0 idxs t Nil Nil;
  (tl, c0c, c1b, ys2) = build ps bn c0b c1 ys (depth + 1) l;
  (tr, c0d, c1c, ys3) = build ps bn c0c c1b ys2 (depth + 1) r;
  (Split 0 (lo0 + F64.ofInt (t + 1) * w0) tl tr, c0d, c1c, ys3).
buildL1 : unsafe P -> B -> Vector -> Vector -> Vector -> Int -> List Int -> Int -> _ .
buildL1 ps bn c0 c1 ys depth idxs t =
  B lo0 w0 lo1 w1 = bn;
  (l, r, c1b) = part c1 idxs t Nil Nil;
  (tl, c0b, c1c, ys2) = build ps bn c0 c1b ys (depth + 1) l;
  (tr, c0c, c1d, ys3) = build ps bn c0b c1c ys2 (depth + 1) r;
  (Split 1 (lo1 + F64.ofInt (t + 1) * w1) tl tr, c0c, c1d, ys3).

# ---- binning: raw F64 column -> Int codes -----------------------------------

binCol : unsafe Vector -> Int -> _ .
binCol col nb =
  (n, col1) = Vec.len col;
  inf = 1.0 / 0.0;
  (lo, col2) = Vec.fold fminf inf col1;
  (hi, col3) = Vec.fold fmaxf (0.0 - inf) col2;
  w0 = (hi - lo) / F64.ofInt nb;
  w = case w0 <= 0.0 of True -> 1.0 | False -> w0;
  (codes, col4) = binGo col3 0 n lo w nb (Vec.new Unit);
  (codes, lo, w, col4).
binGo : unsafe Vector -> Int -> Int -> F64 -> F64 -> Int -> Vector -> _ .
binGo col i n lo w nb acc = case i >= n of
    True -> (acc, col)
  | False -> binPut col i n lo w nb acc.
binPut : unsafe Vector -> Int -> Int -> F64 -> F64 -> Int -> Vector -> _ .
binPut col i n lo w nb acc =
  (x, col2) = Vec.get (i + 1) col;
  binGo col2 (i + 1) n lo w nb (Vec.push (Int.min (nb - 1) (F64.toInt ((x - lo) / w))) acc).

# ---- prediction + accuracy --------------------------------------------------

predAt : unsafe Tree -> Vector -> Vector -> Int -> _ .
predAt (Leaf c) xs zs i = (c, xs, zs).
predAt (Split col thr l r) xs zs i = case col == 0 of
    True -> pred0 thr l r xs zs i
  | False -> pred1 thr l r xs zs i.
pred0 : unsafe F64 -> Tree -> Tree -> Vector -> Vector -> Int -> _ .
pred0 thr l r xs zs i =
  (v, xs2) = Vec.get (i + 1) xs;
  case v < thr of True -> predAt l xs2 zs i | False -> predAt r xs2 zs i.
pred1 : unsafe F64 -> Tree -> Tree -> Vector -> Vector -> Int -> _ .
pred1 thr l r xs zs i =
  (v, zs2) = Vec.get (i + 1) zs;
  case v < thr of True -> predAt l xs zs2 i | False -> predAt r xs zs2 i.

accGo : unsafe Tree -> Vector -> Vector -> Vector -> Int -> Int -> Int -> _ .
accGo tree xs zs ys i n hits = case i >= n of
    True -> (hits, xs, zs, ys)
  | False -> accOne tree xs zs ys i n hits.
accOne : unsafe Tree -> Vector -> Vector -> Vector -> Int -> Int -> Int -> _ .
accOne tree xs zs ys i n hits =
  (p, xs2, zs2) = predAt tree xs zs i;
  (y, ys2) = Vec.get (i + 1) ys;
  case p == y of
    True -> accGo tree xs2 zs2 ys2 (i + 1) n (hits + 1)
  | False -> accGo tree xs2 zs2 ys2 (i + 1) n hits.

# ---- tree stats -------------------------------------------------------------

sizeT : unsafe Tree -> Int .
sizeT (Leaf c) = 1.
sizeT (Split col thr l r) = 1 + sizeT l + sizeT r.
depthT : unsafe Tree -> Int .
depthT (Leaf c) = 0.
depthT (Split col thr l r) = 1 + Int.max (depthT l) (depthT r).

# ---- the demo dataset: noisy XOR, LCG uniforms ------------------------------
# us = tail (iterate (\s -> (1103515245*s + 12345) mod 2^31) seed):
# first n are x, next n are z (both mapped to [-1,1)), next n the
# label-noise draws.  5% of labels flip.

lcgN s = (1103515245 * s + 12345) % 2147483648.

fillM : unsafe Int -> Int -> Vector -> _ .
fillM cnt s v = case cnt == 0 of
    True -> (v, s)
  | False -> fillM2 cnt (lcgN s) v.
fillM2 : unsafe Int -> Int -> Vector -> _ .
fillM2 cnt s2 v =
  fillM (cnt - 1) s2 (Vec.push (F64.ofInt s2 / 2147483648.0 * 2.0 - 1.0) v).
fillU : unsafe Int -> Int -> Vector -> _ .
fillU cnt s v = case cnt == 0 of
    True -> (v, s)
  | False -> fillU2 cnt (lcgN s) v.
fillU2 : unsafe Int -> Int -> Vector -> _ .
fillU2 cnt s2 v =
  fillU (cnt - 1) s2 (Vec.push (F64.ofInt s2 / 2147483648.0) v).

lbl : unsafe Int -> Int -> Vector -> Vector -> Vector -> Vector -> _ .
lbl i n xs zs ns ys = case i >= n of
    True -> (ys, xs, zs, ns)
  | False -> lblOne i n xs zs ns ys.
lblOne : unsafe Int -> Int -> Vector -> Vector -> Vector -> Vector -> _ .
lblOne i n xs zs ns ys =
  (x, xs2) = Vec.get (i + 1) xs;
  (z, zs2) = Vec.get (i + 1) zs;
  (nz, ns2) = Vec.get (i + 1) ns;
  c = case neqB (x > 0.0) (z > 0.0) of True -> 1 | False -> 0;
  y = case nz < 0.05 of True -> 1 - c | False -> c;
  lbl (i + 1) n xs2 zs2 ns2 (Vec.push y ys).

gen : unsafe Int -> Int -> _ .
gen seed n =
  (xs, s1) = fillM n seed (Vec.newAs "d");
  (zs, s2) = fillM n s1 (Vec.newAs "d");
  (ns, s3) = fillU n s2 (Vec.newAs "d");
  (ys, xs2, zs2, ns2) = lbl 0 n xs zs ns (Vec.new Unit);
  _ = Vec.free ns2;
  (xs2, zs2, ys).

# ---- main -------------------------------------------------------------------

main =
  ps = P 256 8 0.001 5 2;
  (txs, tzs, tys) = gen 42 4000;
  (exs, ezs, eys) = gen 7 1000;
  (c0, lo0, w0, txs2) = binCol txs 256;
  (c1, lo1, w1, tzs2) = binCol tzs 256;
  bn = B lo0 w0 lo1 w1;
  (tree, c0b, c1b, tys2) = build ps bn c0 c1 tys 0 (iotaL 0 4000);
  _ = Vec.free c0b;
  _ = Vec.free c1b;
  _ = print "nodes={sizeT tree} depth={depthT tree}";
  (thits, txs3, tzs3, tys3) = accGo tree txs2 tzs2 tys2 0 4000 0;
  trainA = F64.ofInt thits / 4000.0;
  _ = print "train acc: {trainA}";
  (ehits, exs2, ezs2, eys2) = accGo tree exs ezs eys 0 1000 0;
  testA = F64.ofInt ehits / 1000.0;
  _ = print "test  acc: {testA}";
  rootLine tree.
rootLine (Split c thr l r) = "root split: col {c} @ {F64.str thr}".
rootLine t = "root: leaf".

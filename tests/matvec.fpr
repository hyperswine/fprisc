# matvec.fpr -- the Mat4/Vec4 surface: `mvp * vert` is real syntax, and
# Vec.map (fn vert -> mvp * vert) verts specializes to an in-place SoA
# column loop whose per-column bodies are the fused multiply-add (axpb)
# chains -- no fine-grained Vec prims in sight.  Verified against the
# same multiply applied scalar-wise through Vec.get.
Vec4 = {x : Int, y : Int, z : Int, w : Int}.
Mat4 = {m00 : Int, m01 : Int, m02 : Int, m03 : Int,
        m10 : Int, m11 : Int, m12 : Int, m13 : Int,
        m20 : Int, m21 : Int, m22 : Int, m23 : Int,
        m30 : Int, m31 : Int, m32 : Int, m33 : Int}.

mulMV m v =
  { x = m.m00 * v.x + m.m01 * v.y + m.m02 * v.z + m.m03 * v.w,
    y = m.m10 * v.x + m.m11 * v.y + m.m12 * v.z + m.m13 * v.w,
    z = m.m20 * v.x + m.m21 * v.y + m.m22 * v.z + m.m23 * v.w,
    w = m.m30 * v.x + m.m31 * v.y + m.m32 * v.z + m.m33 * v.w } .

fill : Vector -> (i : Int | measure (lim - i)) -> Int -> Vector .
fill v i lim | i > lim = v.
fill v i lim = fill (Vec.push {x = i, y = i * 2 - 3, z = 7 - i, w = 1} v) (i + 1) lim.

sumRows vv = Vec.fold (fn a r -> a + r.x * 3 + r.y * 5 + r.z * 7 + r.w) 0 vv .

# the SAFE version of the reference loop: no custom recursion -- the
# std fold scheme carries the iteration, so no unsafe marker is needed
STD = use "../std/std".
Std = STD.Std.
refSum m lim =
  Std.fold 1 lim
    (fn i acc -> acc + score (mulMV m {x = i, y = i * 2 - 3, z = 7 - i, w = 1})) 0 .
score r = r.x * 3 + r.y * 5 + r.z * 7 + r.w .

verdict b = case b of True -> "MATVEC AGREES" | False -> "MATVEC MISMATCH".

main =
  mvp = {m00 = 2, m01 = 0, m02 = 1, m03 = 5,
         m10 = 0, m11 = 3, m12 = 0, m13 = 11,
         m20 = 1, m21 = 1, m22 = 4, m23 = 0,
         m30 = 0, m31 = 0, m32 = 0, m33 = 1};
  verts = fill (Vec.new Unit) 1 4000;
  h0 = heapUsed Unit;
  out = Vec.map (fn vert -> mvp * vert) verts;
  h1 = heapUsed Unit;
  (s1, out2) = sumRows out;
  ref = refSum mvp 4000;
  # execution proof, not just emission: the specialized loop mutates the
  # SoA columns IN PLACE (zero steady-state allocation), while the
  # generic tier rebuilds the whole vector row by row.  A near-zero
  # heap delta across the map is the in-language witness that the spec
  # path actually ran -- the guard-failed years are over.
  _ = print "matvec: spec = {s1}";
  _ = print "matvec: ref  = {ref}";
  # 4000 rows through the GENERIC tier would rebuild the vector (4 new
  # columns' worth of blocks + 4000 record cells, >100 KB); the spec
  # writes columns in place.  32 KB of slack covers the result tuple
  # and incidental cells without ever passing a generic rebuild.
  _ = print (case h1 - h0 < 32768 of
    True -> "matvec: spec loop EXECUTED (in-place, heap delta {h1 - h0})"
  | False -> "MATVEC SPEC DID NOT RUN (heap delta {h1 - h0}: generic rebuild)");
  _ = print (verdict (s1 == ref));
  Vec.free out2 .

# recfold.fpr -- NAMED record folds now DUALIZE (the audit's "record
# folds decline even for named fns" edge, closed).
#
# A row-polymorphic named fn like `sxy a p = a + p.x * p.y` never
# carries a shape-dispatch chain (projField binds each field against
# its unique candidate shape and emits a bare CProj), so the fold
# dualizer used to bail on "no shape test".  It now accepts the
# zero-test body -- the dual is exactly as shape-checked as the
# generic tier -- and the fold runs the SoA column loop: no boxing,
# no per-row apply, in place.
#
# A RECORD-accumulator fold (raStep) still declines, with the note --
# fold duals are scalar-acc; that bound is documented in VEC.md.
#
#   make bare-metal-run PROG=tests/recfold.fpr
#
# Expected: ok sxy-sum / sxy-inplace, then "recfold: OK 1015050 5050 15150"

P2 = {x : Int, y : Int}.

fillP : Vector -> (i : Int | measure (lim - i)) -> Int -> Vector .
fillP v i lim | i > lim = v.
fillP v i lim = fillP (Vec.push {x = i, y = i * 3} v) (i + 1) lim.

sxy a p = a + p.x * p.y.

raStep a p = {sx = a.sx + p.x, sy = a.sy + p.y}.

verdict n b = case b of True -> print "ok {n}" | False -> error "FAIL {n}".

main =
  v = fillP (Vec.new Unit) 1 100;
  h0 = heapUsed Unit;
  (s1, v2) = Vec.fold sxy 0 v;
  h1 = heapUsed Unit;
  u0 = verdict "sxy-sum" (s1 == 1015050);
  u1 = verdict "sxy-inplace" (h1 - h0 < 4096);
  # the record-acc fold: generic tier, still correct
  (r, v3) = Vec.fold raStep {sx = 0, sy = 0} v2;
  _ = Vec.free v3;
  "recfold: OK {s1} {r.sx} {r.sy}".

# vfilter.fpr — Vec.filter is EAGER COMPACTION, in place.
#
# The kept rows slide down with two cursors inside the SAME vector:
# len shrinks, zero allocation, and every later map/fold stays dense
# and mask-free.  Verified here on both a scalar and a RECORD (SoA)
# vector, with a heapUsed delta as the in-place witness.

keepEven x = x - (x / 2) * 2 == 0.
keepBig p = p.x > 20.

fillI : unsafe Vector -> Int -> Int -> Vector .
fillI v i lim | i > lim = v.
fillI v i lim = fillI (Vec.push i v) (i + 1) lim.

fillP : unsafe Vector -> Int -> Int -> Vector .
fillP v i lim | i > lim = v.
fillP v i lim = fillP (Vec.push {x = i, y = i * 2} v) (i + 1) lim.

sumI vv = Vec.fold (fn a x -> a + x) 0 vv .
sumP vv = Vec.fold (fn a p -> a + p.x + p.y) 0 vv .

verdict n b = case b of True -> print "ok {n}" | False -> error "FAIL {n}".

main =
  a1 = fillI (Vec.new Unit) 1 1000;
  h0 = heapUsed Unit;
  a2 = Vec.filter keepEven a1;
  h1 = heapUsed Unit;
  (n1, a2b) = Vec.len a2;
  (s1, a3) = sumI a2b;
  # 2+4+...+1000 = 250500, and 500 survivors
  u0 = verdict "scalar-sum" (s1 == 250500);
  u1 = verdict "scalar-len" (n1 == 500);
  u2 = verdict "scalar-in-place" (h1 - h0 < 4096);

  # the compacted vector is still a normal dense vector afterwards
  a4 = Vec.map (fn x -> x * 2) a3;
  (s2, a5) = sumI a4;
  _ = Vec.free a5;
  u3 = verdict "dense-after-filter" (s2 == 501000);

  # records: every column compacts together, so rows stay aligned
  b1 = fillP (Vec.new Unit) 1 1000;
  h2 = heapUsed Unit;
  b2 = Vec.filter keepBig b1;
  h3 = heapUsed Unit;
  (n2, b2b) = Vec.len b2;
  (s3, b3) = sumP b2b;
  _ = Vec.free b3;
  # x from 21..1000 summed, plus y = 2x  =>  3 * sum(21..1000)
  u4 = verdict "record-sum" (s3 == 3 * (500500 - 210));
  u5 = verdict "record-len" (n2 == 980);
  u6 = verdict "record-in-place" (h3 - h2 < 65536);
  print "FILTER COMPACTS".

# patguard.fpr — pattern guards (`| p <- e`) + guard sequencing + the
# join-point clause compilation.
#
#   f x | Some y <- g x = y + 1.
#
# Guards run left to right; a pattern guard binds its pattern for the
# guards to its right and for the body, and FALLS THROUGH to the next
# clause on a non-match — same semantics as Sol. Clause fallthrough
# compiles to a saturated tail call into a lifted join function, so the
# deep-fallthrough loop at the bottom is the stack/fuel proof: 200000
# iterations, each falling through three guarded clauses, would overflow
# any stack-consuming dispatch and stalls forever without fuel yields.

Opt = Type (None | Some x).
Pair = Type (Pair a b).

expect name got want = case got == want of
  True -> print "ok {name}"
| False -> error "FAIL {name}: {got} vs {want}".

# ---- the basic form --------------------------------------------------------

half n = case n % 2 of 0 -> Some (n / 2) | _ -> None.

evenHalf n | Some h <- half n = h.
evenHalf n = 0 - 1.

# ---- sequencing: bool, pat, bool, pat in one guard -------------------------

quarter n | Some h <- half n, h > 0, Some q <- half h = q.
quarter n = 0 - 1.

# ---- fallthrough order + nested pattern guards -----------------------------

classify p | Pair (Some a) (Some b) <- p, a > b = "both, a wins".
classify p | Pair (Some a) (Some b) <- p = "both, b holds".
classify p | Pair (Some a) None <- p = "only a".
classify p | Pair None (Some b) <- p = "only b".
classify p = "neither".

# ---- multi-test clauses (the join-point shape) -----------------------------

shape (Pair (Some 1) (Some 1)) = "unit diag".
shape (Pair (Some a) (Some b)) | a == b = "diag {a}".
shape (Pair (Some a) (Some b)) = "off {a},{b}".
shape p = "sparse".

# ---- the stack + fuel proof ------------------------------------------------
# every iteration falls through THREE guarded clauses before matching:
# with inlined-duplicated fallthrough this is code-size pain, with
# call-based fallthrough it is stack death unless the calls are TCO'd
# tail calls — 200000 deep says they are.

spin : (n : Int | measure n) -> Int -> Int .
spin n acc | n < 0 = acc.
spin n acc | Some h <- half n, h > n = acc.      # never: h <= n
spin n acc | None <- half (2 * n + 2) = acc.     # never: even
spin n acc = spin (n - 1) (acc + 1).

main u =
  e1 = expect "evenHalf 10" (evenHalf 10) 5;
  e2 = expect "evenHalf 7 falls through" (evenHalf 7) (0 - 1);
  e3 = expect "quarter 12" (quarter 12) 3;
  e4 = expect "quarter 6 (odd half) falls through" (quarter 6) (0 - 1);
  e5 = expect "quarter 2 (h>0 fails after pat)" (quarter 0) (0 - 1);
  c1 = expect "classify both/a" (classify (Pair (Some 9) (Some 4))) "both, a wins";
  c2 = expect "classify both/b" (classify (Pair (Some 4) (Some 9))) "both, b holds";
  c3 = expect "classify only a" (classify (Pair (Some 4) None)) "only a";
  c4 = expect "classify only b" (classify (Pair None (Some 9))) "only b";
  c5 = expect "classify neither" (classify (Pair None None)) "neither";
  s1 = expect "shape unit diag" (shape (Pair (Some 1) (Some 1))) "unit diag";
  s2 = expect "shape diag" (shape (Pair (Some 3) (Some 3))) "diag 3";
  s3 = expect "shape off" (shape (Pair (Some 3) (Some 4))) "off 3,4";
  s4 = expect "shape sparse" (shape (Pair (Some 3) None)) "sparse";
  d = expect "200000 guarded fallthroughs, O(1) stack" (spin 199999 0) 200000;
  print "patguard done".

# fmath.fpr -- the F64 transcendentals (freestanding runtime.c
# implementations: no libm anywhere in these links), checked against
# host-double references to 1e-13 relative:
#
#   F64.log / F64.log2    atanh-series on [sqrt(1/2), sqrt(2)) + exact
#                         exponent (log2's integer part is exact)
#   F64.exp               Cody-Waite ln2 reduction + 14-term Taylor
#   exp ^ (y ln x); negative base for integer y
#   F64.sin / F64.cos     two-word pi/2 reduction + Taylor kernels
#
#   make qos-app PROG=tests/fmath.fpr
#   (cd ../qos && make portable && ./qosp --yes ../fp-risc/app.qa)
#
# Expected: 16 ok lines and "FMATH HOLDS (16 checks)".

absF x = case x < 0.0 of True -> 0.0 - x | False -> x.

# |got - want| <= tol * max(1, |want|)
near got want tol = nearGo (absF (got - want)) (absF want) tol.
nearGo d aw tol = case aw < 1.0 of
    True -> d <= tol
  | False -> d <= tol * aw.

ck name got want n | near got want 0.0000000000001 = ckOk name n.
ck name got want n = error "FMATH FAIL {name}: got {got} want {want}".
ckOk name n =
  _ = print "ok {name}";
  n + 1.

main =
  e = 2.718281828459045;
  n1 = ck "log2-pow2" (F64.log2 1048576.0) 20.0 0;
  n2 = ck "log2-small" (F64.log2 0.001) (0.0 - 9.965784284662087) n1;
  n3 = ck "log2-one" (F64.log2 1.0) 0.0 n2;
  n4 = ck "log-e" (F64.log e) 1.0 n3;
  n5 = ck "exp-one" (F64.exp 1.0) e n4;
  n6 = ck "exp-zero" (F64.exp 0.0) 1.0 n5;
  n7 = ck "exp-neg" (F64.exp (0.0 - 20.5)) 0.0000000012501528663867426 n6;
  n8 = ck "pow-int" (2.0 ^ 10.0) 1024.0 n7;
  n9 = ck "pow-frac" (2.5 ^ 3.5) 24.705294220065465 n8;
  n10 = ck "pow-negbase" ((0.0 - 2.0) ^ 3.0) (0.0 - 8.0) n9;
  n11 = ck "sin-one" (F64.sin 1.0) 0.8414709848078965 n10;
  n12 = ck "cos-one" (F64.cos 1.0) 0.5403023058681398 n11;
  n13 = ck "sin-hundred" (F64.sin 100.0) (0.0 - 0.5063656411097588) n12;
  n14 = ck "cos-hundred" (F64.cos 100.0) 0.8623188722876839 n13;
  # identities close the loop between the implementations
  n15 = ck "exp-log-roundtrip" (F64.exp (F64.log 7.0)) 7.0 n14;
  s = F64.sin 0.7;
  c = F64.cos 0.7;
  n16 = ck "pythagorean" (s * s + c * c) 1.0 n15;
  "FMATH HOLDS ({n16} checks)".

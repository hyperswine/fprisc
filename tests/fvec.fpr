scale x = x * 2.0.
addf : F64 -> F64 -> F64 .
addf a b = a + b.
main =
  v = Vec.newAs "d";
  v2 = Vec.push 1.5 v;
  v3 = Vec.push 2.5 v2;
  v4 = Vec.push 3.0 v3;
  (n, v5) = Vec.len v4;
  (e, v6) = Vec.get 2 v5;
  u0 = print "len={n} elem2={F64.str e}";
  v7 = Vec.map scale v6;
  (s, v8) = Vec.fold addf 0.0 v7;
  u1 = print "sum={F64.str s}";
  _ = Vec.free v8;
  print "FLOATVEC HOLDS".

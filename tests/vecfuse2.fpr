# vecfuse2.fpr -- fusion FIXPOINT + the WRITE-BACK FOLD.
#
#   * a 3-map chain now collapses COMPLETELY (round 1 fuses the outer
#     pair, round 2 fuses the composite over the inner map -- the
#     _vfuse_1_* name in the emitted asm is the round-2 witness); one
#     specialized pass, in place
#   * Vec.fold f z (Vec.map g v) fuses into ONE pass that writes g(el)
#     back into the column AND folds f over it -- the map's writes stay
#     program-visible through the returned vector (re-folding it is the
#     witness), which is exactly what the map/map rewrite could never
#     express
#
#   make bare-metal-run PROG=tests/vecfuse2.fpr
#
# Expected: ok chain-sum / chain-inplace / wfold-sum / wfold-writeback /
#           wfold-inplace, then "vecfuse2: OK"

# v0 comes from Vec.range: the native bulk fill (one HAL loop, no
# per-element push) -- `Vec.range 1 n |> Vec.map f` is the fast
# spelling of "generate n samples", mirrored from the Sol tier.
inc x = x + 1.
dbl x = x * 2.
mneg x = 0 - x.
addA a x = a + x.

# reference for mneg (dbl (inc i)) summed over 1..lim
refC : (i : Int | measure (lim - i)) -> Int -> Int .
refC i lim | i > lim = 0.
refC i lim = (0 - (i + 1) * 2) + refC (i + 1) lim.

verdict n b = case b of True -> print "ok {n}" | False -> error "FAIL {n}".

main =
  v0 = Vec.range 1 1000;

  # ---- the 3-chain, pipeline spelling: must fully collapse ----
  h0 = heapUsed Unit;
  v1 = Vec.map inc v0;
  v2 = Vec.map dbl v1;
  v3 = Vec.map mneg v2;
  h1 = heapUsed Unit;
  (s1, v4) = Vec.fold addA 0 v3;
  u0 = verdict "chain-sum" (s1 == refC 1 1000);
  u1 = verdict "chain-inplace" (h1 - h0 < 4096);

  # ---- write-back fold: fold-of-map in ONE pass ----
  h2 = heapUsed Unit;
  (s2, v5) = Vec.fold addA 0 (Vec.map dbl v4);
  h3 = heapUsed Unit;
  u2 = verdict "wfold-sum" (s2 == 2 * s1);
  # the map's writes must have LANDED: folding the returned vector
  # again sees the doubled elements
  (s3, v6) = Vec.fold addA 0 v5;
  u3 = verdict "wfold-writeback" (s3 == s2);
  u4 = verdict "wfold-inplace" (h3 - h2 < 4096);

  _ = Vec.free v6;
  "vecfuse2: OK".

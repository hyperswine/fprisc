# sendarc.fpr -- the send triad's SHARE verb (docs/MEMORY.md v2).
#
# sendArc is the ONE path by which a value becomes cross-actor shared:
# the pointer crosses (no copy), the object is frozen by contract, and
# the count is the number of HOLDERS -- the sender's standing share is
# created at first promotion, each send adds the receiver's, and every
# holder releases with `drop`.  Here one flat tuple is shared with TWO
# readers at once; both read it, both drop, the sender drops -- and
# arcLive lands back exactly on the pre-share baseline.  (A Vector by
# sendArc is a compile-run refusal: linear bulk moves or copies.)

reader : unsafe Int -> a .
reader me =
  m = receive me;
  (p, z) = m;
  _ = drop m;
  _ = send p (0, 0);   # ack: setup root dropped, baseline may be read
  s = receive me;
  (a, b) = s;
  _ = send p (a + b, 0);
  _ = drop s;
  reader me .

main =
  me = myself 0;
  r1 = spawn reader;
  r2 = spawn reader;
  _ = send r1 (me, 0);
  _ = send r2 (me, 0);
  a1 = receive me;
  _ = drop a1;
  a2 = receive me;
  _ = drop a2;
  t = (20, 22);
  base = arcLive 0;
  _ = sendArc r1 t;
  _ = sendArc r2 t;
  m1 = receive me;
  (x1, u1) = m1;
  _ = drop m1;
  m2 = receive me;
  (x2, u2) = m2;
  _ = drop m2;
  _ = drop t;
  lv = arcLive 0;
  ok = case lv == base of True -> "ARC BALANCED" | False -> "ARC LEAKED {base}->{lv}";
  print "sendarc: r1={x1} r2={x2} {ok} (one tuple, three holders, zero copies)" .

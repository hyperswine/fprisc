profile base.
# Read-only sector evidence after the approved card-specific file test.
Sd = use "std/tangnano20k/sd".
Hex = use "tests/tangnano20k_sd_backup".
need r = case r of Ok value -> value | Err why -> error why.
dump card block = print "SD AUDIT {block} {Hex.hex (need (Sd.read card block))}".
main : Unit .
main =
  card = need (Sd.open 7);
  _ = if Sd.blocks card == 122152960 and Sd.product card == "SDABC" then Unit else error "SD audit card differs";
  _ = dump card 0;
  _ = dump card 8194;
  _ = dump card 8195;
  _ = dump card 120913920;
  _ = dump card 120913921;
  _ = dump card 120914049;
  _ = dump card 120914177;
  _ = dump card 120914209;
  print "FP SD INDEPENDENT SECTOR AUDIT HOLDS".

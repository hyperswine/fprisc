# paths.fpr -- first-class paths, both tiers (docs/PATHS.md):
#
#   TYPED literal   @Model.hp / @Model.ui.tag -> {get, set, segs},
#                   validated at elaboration against the declared
#                   shapes; a bad field is a COMPILE error
#   STRING schema   @Model -> the flattened leaf list; sets/gets by
#                   dotted string via std.lens, leaf values parsed and
#                   rendered by tag; a bad path is a transactional Err
#   COMPOSE         L.comp of two literals = the same nested path
#
#   make qos-app PROG=tests/paths.fpr
#   (cd ../qos && ./qosp --yes ../fp-risc/app.qa)
#
# Expected:
#   paths: OK hp=99 name=zed fg=7 comp-fg=8 via-str hp=250 tag=live
#   segs=ui.fg leaves=4 bad=no schema leaf 'ui.nope'
#   (leaves=4: hp, name, ui.fg, ui.tag -- ks : List Int is typed-tier-
#   only, the schema skips it)

L = use "../std/lens".

Style = {fg : Int, tag : String}.
Model = {hp : Int, name : String, ui : Style, ks : List Int}.

joinSegs : unsafe List String -> String -> String .
joinSegs l acc = case l of
    Nil -> acc
  | s :: r -> joinSegs r (joinOne acc s).
joinOne acc s = case strlen acc == 0 of True -> s | False -> "{acc}.{s}".

main =
  m0 = {hp = 10, name = "ada", ui = {fg = 2, tag = "boot"}, ks = 1 :: Nil};

  # ---- typed tier: literals are ordinary {get,set,segs} values ----
  hpP = @Model.hp;
  nameP = @Model.name;
  fgP = @Model.ui.fg;
  tagP = @Model.ui.tag;
  m1 = hpP.set 99 m0;
  m2 = nameP.set "zed" m1;
  m3 = fgP.set 7 m2;

  # ---- composition: @Model.ui then @Style.fg IS @Model.ui.fg ----
  fgC = L.comp (@Model.ui) (@Style.fg);
  mC = fgC.set 8 m3;
  compFg = fgC.get mC;

  # ---- string tier: the schema is the SAME closures, found by string ----
  sch = @Model;
  m4 = case L.set sch "hp" "250" m3 of
      Ok m -> m
    | Err e -> error e;               # "int" leaf: parsed
  m5 = case L.setWords sch "ui.tag live" m4 of
      Ok m -> m
    | Err e -> error e;               # the wire form, "str" leaf verbatim
  gotHp = case L.get sch "hp" m5 of Ok s -> s | Err e -> error e;
  bad = case L.set sch "ui.nope" "1" m5 of
      Ok m -> "ACCEPTED?!"
    | Err e -> e;                     # refused, model untouched

  "paths: OK hp={hpP.get m3} name={nameP.get m5} fg={fgP.get m5} comp-fg={compFg} via-str hp={gotHp} tag={tagP.get m5} segs={joinSegs fgP.segs ""} leaves={List.len sch} bad={bad}".

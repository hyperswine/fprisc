profile builtin.
Node = Type (Node a b).
check ok = case ok of True -> Unit | False -> error "Tang Nano builtin check failed".
sum n acc = case n == 0 of True -> acc | False -> sum (n - 1) (acc + n).
stress n = case n == 0 of True -> Unit | False ->
  xs = [n];
  alias = Rc.retain xs;
  node = Node xs alias;
  _ = Rc.release node;
  stress (n - 1).
main =
  _ = check (sum 1000 0 == 500500);
  before = Mem.liveAllocations Unit;
  _ = stress 100;
  _ = check (Mem.liveAllocations Unit == before);
  all = I32.not (I32.trunc 0);
  _ = check (all == I32.mask 32 0);
  high = I32.shl (I32.trunc 1) 31;
  _ = check (I32.shr high 31 == I32.trunc 1);
  _ = check (all + I32.trunc 1 == I32.trunc 0);
  p = Mem.alloc 16;
  _ = Mem.write8 p 171;
  _ = Mem.write16 (Addr.add p 2) 48879;
  _ = Mem.write32 (Addr.add p 8) all;
  q = Mem.realloc p 512;
  _ = check (Mem.read8 q == 171);
  _ = check (Mem.read16 (Addr.add q 2) == 48879);
  _ = check (Mem.read32 (Addr.add q 8) == all);
  _ = Mem.free q;
  _ = Mem.fence Unit;
  print "TANG NANO BUILTIN HOLDS".

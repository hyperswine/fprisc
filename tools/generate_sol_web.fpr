# Development/build generator, never invoked by View.serve. Authoring stays in
# sol/web/*.fpr; checked-in exports make a clean compiler build self-contained.
unsafe base.
G = use "std/view".
L = use "std/list".
J = use "std/json".
F = use "std/file".
P = use "std/program".
Style = use "sol/web/presentation".
Client = use "sol/web/client".
need value = case value of Ok answer -> answer | Err why -> P.fail 1 "Sol web generation: {why}".
hs text = "\"{strJoin "" (L.reverse (hsChars text 0 Nil))}\"".
hsChars : unsafe String -> Int -> List String -> List String .
hsChars text at acc = if at >= strlen text then acc else
  c = charAt text at;
  hsChars text (at + 1) ("\\{c}\\&" :: acc).
atom (G.Atom scope property css) = "({scope},{J.quote property},{J.quote (G.atomClass (G.Atom scope property css))})".
binding pair = case pair of (name, attrs) -> "{name} = Utilities [{strJoin "," (L.map atom (G.localAtoms attrs))}].\n".
solStyles u = "# Generated by tools/generate_sol_web.fpr from typed std/view declarations.\n# Do not edit this export; edit sol/web/presentation.fpr and regenerate.\nAppearance = Type (Utilities (List (Int, String, String))).\n" +
  strJoin "" (L.map binding Style.presets) +
  "\n# Compose per-node atoms with the same stage/property last-wins contract.\nclasses styles = styles |> List.fold (fn acc style -> case style of Utilities atoms -> acc + atoms) [] |> List.rev |> List.fold retain [] |> List.map (fn atom -> (s, p, name) = atom; name).\nretain kept atom = (stage, property, name) = atom; case List.any (fn entry -> (s, p, n) = entry; and (s == stage) (p == property)) kept of True -> kept | False -> atom :: kept.\n".
page u =
  tree = G.El "html" Nil [G.El "head" Nil
    [G.El "meta" [G.Att "charset" "utf-8"] Nil,
     G.El "meta" [G.Att "name" "viewport", G.Att "content" "width=device-width,initial-scale=1"] Nil,
     G.El "title" Nil [G.Txt "Sol view"],
     G.El "link" [G.Att "rel" "stylesheet", G.Att "href" "/_sol/style.css"] Nil,
     G.El "script" [G.Att "src" "/_sol/client.js", G.Att "defer" ""] Nil],
    G.El "body" Style.body [G.El "div" [G.Att "id" "root"] Nil]];
  (statics, dynamics) = G.render tree;
  "<!doctype html>" + strJoin "" statics.
assets u = "-- Generated by tools/generate_sol_web.fpr. Do not edit.\nmodule Sol.WebAssets (clientPage, clientScript, clientStyles) where\n\nclientPage, clientScript, clientStyles :: String\nclientPage = {hs (page Unit)}\nclientScript = {hs (Client.program Unit)}\nclientStyles = {hs Style.css}\n".
main = case P.args Unit of
    ["--check"] ->
      _ = if need (F.readText "compiler/Sol/WebAssets.hs") == assets Unit and need (F.readText "sol/lib/webstyles.sol") == solStyles Unit then print "Sol web exports reproducible PASS" else P.fail 1 "Sol web exports are stale; regenerate";
      Unit
  | Nil -> _ = need (F.writeText "compiler/Sol/WebAssets.hs" (assets Unit));
      _ = need (F.writeText "sol/lib/webstyles.sol" (solStyles Unit)); print "generated Sol web assets and local style bindings"
  | _ -> P.fail 2 "usage: generate_sol_web [--check]".

# pin.fpr -- find a project's toolchain pin, for fprmeta's launcher.
#
# Walks up from a directory to the nearest manifest:
#   fpr.toml  [toolchain] fpr = "0.12.0" | "=0.12.3"
#   qos.toml  [sdk] version = "0.3.0" | "=0.3.0"   (qos.toml v2)
#
# This reads only the one line it needs. The compiler (compiler/Project.hs)
# still validates the whole manifest when the chosen fpr runs, so a launcher
# that tolerates a key it does not know never weakens that check.

S = use "std/string".
L = use "std/list".
O = use "std/option".
J = use "std/json".
F = use "std/file".
P = use "std/path".

Found = { file : String, value : String, line : Int }.

# Strip comments outside basic/literal strings, including section comments.
# Pin values are versions, but the rest of a project may contain quoted '#'.
commentEnd : unsafe String -> Int -> Int -> Bool -> Int .
commentEnd s i quote escaped = if i >= strlen s then i
  else c = charAt s i;
    if escaped then commentEnd s (i + 1) quote False
    else if quote == 34 and c == 92 then commentEnd s (i + 1) quote True
    else if quote != 0 and c == quote then commentEnd s (i + 1) 0 False
    else if quote == 0 and (c == 34 or c == 39) then commentEnd s (i + 1) c False
    else if quote == 0 and c == 35 then i
    else commentEnd s (i + 1) quote False.
clean : unsafe String -> String .
clean raw = S.trim (S.left (commentEnd raw 0 0 False) raw).

quoted value = if S.startsWith "'" value and S.endsWith "'" value and strlen value >= 2 then
    body = S.slice 1 (strlen value - 1) value;
    if S.contains "'" body then Err "text after a pin string" else Ok body
  else case J.parse value of
    Ok (J.Text s) -> Ok s
  | _ -> Err "a pin must be one quoted version string".

# Read the complete pin section: malformed or duplicate keys must not turn
# into a missing pin and silently select the default. Other project policy
# remains the selected compiler/SDK's responsibility.
readValue : unsafe List String -> String -> String -> String -> Int -> O.Option (String, Int) -> Result (O.Option (String, Int)) String .
readValue lines section key current n found = case lines of
    Nil -> Ok found
  | raw :: rest ->
      line = clean raw;
      if S.startsWith "[" line then
        if not (S.endsWith "]" line) then Err "line {n}: malformed section header"
        else readValue rest section key (S.trim (S.slice 1 (strlen line - 1) line)) (n + 1) found
      else if current == section then
        (case S.indexOf "=" line of
            O.Some at ->
              if S.trim (S.left at line) != key then readValue rest section key current (n + 1) found
              else (case found of
                O.Some _ -> Err "line {n}: {section}.{key} is given twice"
              | O.None -> (case quoted (S.trim (S.dropLeft (at + 1) line)) of
                    Err why -> Err "line {n}: {section}.{key}: {why}"
                  | Ok value -> readValue rest section key current (n + 1) (O.Some (value, n))))
          | O.None -> if line == key then Err "line {n}: expected {key} = \"VERSION\""
                      else readValue rest section key current (n + 1) found)
      else readValue rest section key current (n + 1) found.

# the nearest directory at or above `dir` holding `name`
nearest : unsafe String -> String -> O.Option String .
nearest name dir =
  candidate = P.join dir name;
  if F.isFile candidate then O.Some candidate
  else
    up = P.parent dir;
    if up == dir or up == "" then O.None else nearest name up.

# (manifest file, pinned text, 1-based line) for a launcher kind: "fpr" or "qos"
find : unsafe String -> String -> Result (O.Option Found) String .
find kind dir =
  (name, section, key) = if kind == "qos" then ("qos.toml", "sdk", "version") else ("fpr.toml", "toolchain", "fpr");
  case nearest name dir of
      O.None -> Ok O.None
    | O.Some file ->
        (case F.readText file of
            Err why -> Err "{file}: {why}"
          | Ok text ->
              (case readValue (S.lines text) section key "" 1 O.None of
                  Err why -> Err "{file}: {why}"
                | Ok O.None -> if kind == "fpr" then Err "{file}: missing [toolchain] fpr pin" else Ok O.None
                | Ok (O.Some (v, n)) -> Ok (O.Some { file = file, value = v, line = n }))).

# fprmeta.fpr -- the FP-RISC toolchain manager and launcher (and qosmeta).
#
# One binary, many names (docs/2026-11-01-TOOLCHAIN-MANAGER.md):
#   fprmeta  manage FP-RISC toolchains in ~/.fpr   (FPRMETA_HOME overrides)
#   qosmeta  manage QOS SDKs in ~/.qos             (QOSMETA_HOME overrides)
#   fpr, sol launch the chosen FP-RISC toolchain's command
#   qos      launch the chosen QOS SDK's command
#
# The launcher chooses a version, first match wins:
#   1. `+VERSION` as the first argument      exact
#   2. FPR_TOOLCHAIN (QOS_SDK for qos)       exact
#   3. the project's pin (fpr.toml [toolchain] fpr, qos.toml [sdk] version):
#      "0.12.0" = newest installed 0.12.x not older; "=0.12.3" = exactly that
#   4. the default in settings.toml          exact
# then replaces itself with HOME/VERSION/bin/NAME, keeping NAME as argv[0] so
# `fpr` still acts as Sol when it is started as `sol`. Nothing is downloaded
# by a launch: a missing version stops with status 2 and the command to run.

profile base.

Program = use "std/program".
OS = use "std/os".
Proc = use "std/proc".
F = use "std/file".
Path = use "std/path".
S = use "std/string".
L = use "std/list".
O = use "std/option".
P = use "std/parse".
R = use "std/result".
M = use "std/map".
Json = use "std/json".
Ord = use "std/order".
V = use "std/semver".
Pin = use "pin".
Host = use "host".
Trust = use "trust".

metaVersion = "0.2.1".

# ---- what each name manages -------------------------------------------------------

# The published version lists live beside the formulas in the Homebrew tap.
# --index FILE|URL or FPRMETA_INDEX / QOSMETA_INDEX replace them. The lists
# require an explicitly trusted Ed25519 public key; unsigned lists require
# --allow-unsigned-index. The dedicated trust root is in trust.fpr.
indexBase = "https://raw.githubusercontent.com/hyperswine/homebrew-tap/main/toolchains".

Kind = { kind : String, manager : String, component : String, homeVar : String, homeDir : String,
         pinVar : String, commands : List String, payload : String, metaFile : String,
         invFile : String, invField : String, invBase : String, index : String }.

fprKind = { kind = "fpr", manager = "fprmeta", component = "fprisc", homeVar = "FPRMETA_HOME", homeDir = ".fpr",
            pinVar = "FPR_TOOLCHAIN", commands = ["fpr", "sol"], payload = "libexec/fprisc",
            metaFile = "libexec/fprisc/toolchain.json",
            invFile = "libexec/fprisc/toolchain.json", invField = "files", invBase = "",
            index = "{indexBase}/fprisc.json" }.

qosKind = { kind = "qos", manager = "qosmeta", component = "qos-portable", homeVar = "QOSMETA_HOME", homeDir = ".qos",
            pinVar = "QOS_SDK", commands = ["qos"], payload = "libexec/qos-portable",
            metaFile = "libexec/qos-portable/sdk.json",
            invFile = "libexec/qos-portable/files.sha256.json", invField = "", invBase = "libexec/qos-portable",
            index = "{indexBase}/qos-portable.json" }.

die : Int -> String -> a .
die code why = Program.fail code why.

home : Kind -> String .
home k = Program.env k.homeVar |> O.withDefault (Path.join (Program.envOr "/" "HOME") k.homeDir).

# ---- running small system tools ---------------------------------------------------

run : List String -> Result String String .
run argv =
  Proc.run argv
  |> R.mapError (fn why -> "{S.join " " argv}: {why}")
  |> R.andThen (fn r -> if r.status == 0 then Ok r.out else Err "{S.join " " argv}: exit {r.status}: {S.trim r.err}").

sha256 : String -> Result String String .
sha256 path =
  run ["/usr/bin/shasum", "-a", "256", path]
  |> R.andThen (fn out -> case S.words out of h :: _ -> Ok h | Nil -> Err "shasum gave no digest for {path}").

platform : Unit -> String .
platform _ =
  sys = run ["/usr/bin/uname", "-s"] |> R.map S.trim |> R.withDefault "unknown";
  arch = run ["/usr/bin/uname", "-m"] |> R.map S.trim |> R.withDefault "unknown";
  os = if sys == "Darwin" then "macos" else S.toLower sys;
  machine = if arch == "aarch64" then "arm64" else arch;
  "{os}-{machine}".

# ---- installed versions and the default --------------------------------------------

receiptOf : Kind -> String -> String .
receiptOf k v = Path.joinAll [home k, "receipts", "{v}.json"].

internalReceipt : Kind -> String -> String .
internalReceipt k v = Path.joinAll [home k, v, ".fprmeta-receipt.json"].

hasReceipt : Kind -> String -> Bool .
hasReceipt k v = F.isFile (internalReceipt k v) or F.isFile (receiptOf k v).

Version = { parts : List Int, tag : String, text : String }.
VPin = { exact : Bool, version : Version }.

installed : Kind -> List Version .
installed k =
  F.list (home k)
  |> R.withDefault Nil
  |> L.filterMap (fn n -> case V.parse n of
      Ok v -> if hasReceipt k n and F.isDir (Path.join (home k) n) then O.Some v else O.None
    | Err _ -> O.None)
  |> L.sortWith V.compare.

settingsFile : Kind -> String .
settingsFile k = Path.join (home k) "settings.toml".

defaultOf : Kind -> O.Option String .
defaultOf k = case F.readText (settingsFile k) of
    Err _ -> O.None
  | Ok text -> case Pin.readValue (S.lines text) "toolchain" "default" "" 1 O.None of
      Err why -> die 2 "{settingsFile k}: {why}"
    | Ok value -> O.map (fn found -> (v, _) = found; v) value.

setDefault : unsafe Kind -> O.Option String -> Result Unit String .
setDefault k v =
  body = case v of
      O.Some text -> "# written by {k.manager}\n[toolchain]\ndefault = \"{text}\"\n"
    | O.None -> "# written by {k.manager}\n[toolchain]\n";
  Host.atomicWrite (settingsFile k) body.

# ---- choosing a version -------------------------------------------------------------

Choice = { pin : VPin, source : String }.

exactPin : String -> String -> Result Choice String .
exactPin text source =
  V.parsePin text
  |> R.mapError (fn why -> "{source}: {why}")
  |> R.map (fn p -> { pin = { exact = True, version = p.version }, source = source }).

wanted : Kind -> List String -> Result (O.Option Choice, List String) String .
wanted k (a :: rest) | S.startsWith "+" a =
  exactPin (S.dropLeft 1 a) "the command line ({a})"
  |> R.map (fn c -> (O.Some c, rest)).
wanted k args = fromEnv k args.

fromEnv : Kind -> List String -> Result (O.Option Choice, List String) String .
fromEnv k args = case Program.env k.pinVar of
    O.Some text -> exactPin text k.pinVar |> R.map (fn c -> (O.Some c, args))
  | O.None -> fromProject k args.

fromProject : Kind -> List String -> Result (O.Option Choice, List String) String .
fromProject k args =
  Pin.find k.kind (F.current Unit)
  |> R.andThen (fn found -> case found of
      O.Some f ->
        V.parsePin f.value
        |> R.mapError (fn why -> "{f.file}:{f.line}: {why}")
        |> R.map (fn p -> (O.Some { pin = p, source = "{f.file}:{f.line}" }, args))
    | O.None -> case defaultOf k of
        O.Some d -> exactPin d "the default ({settingsFile k})" |> R.map (fn c -> (O.Some c, args))
      | O.None -> Ok (O.None, args)).

pick : Kind -> Choice -> O.Option Version .
pick k c = installed k |> L.filter (V.satisfies c.pin) |> L.last.

texts : List Version -> String .
texts Nil = "none".
texts vs = vs |> L.map (fn v -> v.text) |> S.join ", ".

missing : Kind -> String -> Choice -> a .
missing k name c =
  asked = if c.pin.exact then c.pin.version.text else "{c.pin.version.text} or a later compatible release";
  die 2 "{name}: {c.source} asks for {k.component} {asked}, which is not installed (installed: {texts (installed k)}).\nInstall it with: {k.manager} install {c.pin.version.text}".

resolve : Kind -> String -> List String -> (Version, Choice, List String) .
resolve k name args = case wanted k args of
    Err why -> die 2 "{name}: {why}"
  | Ok (O.None, _) ->
      die 2 "{name}: no {k.component} version is chosen here: no project pin and no default.\nInstall one with `{k.manager} install VERSION`, then `{k.manager} default VERSION`."
  | Ok (O.Some c, rest) -> case pick k c of O.Some v -> (v, c, rest) | O.None -> missing k name c.

launch : Kind -> String -> List String -> Unit .
launch k name args =
  (v, _, rest) = resolve k name args;
  binary = Path.joinAll [home k, v.text, "bin", name];
  if not (F.exists binary) then die 2 "{name}: {k.component} {v.text} has no {name} command ({binary})"
  else case OS.exec (binary :: rest) of
      Ok _ -> Unit
    | Err why -> die 126 "{name}: could not start {binary}: {why}".

# ---- installing ---------------------------------------------------------------------

jsonText : List String -> Json.Value -> O.Option String .
jsonText = Json.stringAt.

# every regular file under dir except toolchain.json/sdk.json, as path -> sha256
inventoryOf : String -> String -> Result (M.Map String String) String .
inventoryOf dir metaName =
  script = "cd \"$1\" && find . -type f ! -path \"./$2\" ! -path ./.fprmeta-receipt.json -print0 | xargs -0 /usr/bin/shasum -a 256";
  run ["/bin/sh", "-c", script, "sh", dir, metaName]
  |> R.map (fn out ->
      S.lines out
      |> L.fold (fn m line -> case S.indexOf "  ./" line of
          O.Some at -> M.insert (S.dropLeft (at + 4) line) (S.left at line) m
        | O.None -> m) (M.empty Ord.string)).

readInventoryListing : Kind -> String -> O.Option (M.Map String Json.Value) .
readInventoryListing k top =
  F.readText (Path.join top k.invFile)
  |> R.andThen Json.parse
  |> R.map (fn v -> if k.invField == "" then Json.asObject v else Json.field k.invField v |> O.andThen Json.asObject)
  |> R.withDefault O.None.

# the archive's own inventory (toolchain.json's "files", or the SDK's
# files.sha256.json) must match exactly what was unpacked
checkInventory : Kind -> String -> Result Unit String .
checkInventory k top =
  invName = if k.invBase == "" then k.invFile else Path.fileName k.invFile;
  invDir = if k.invBase == "" then top else Path.join top k.invBase;
  case readInventoryListing k top of
      O.None -> Err "no readable file inventory ({k.invFile})"
    | O.Some files ->
        inventoryOf invDir invName |> R.andThen (fn found ->
          bad = M.keys files |> L.filter (fn p -> case (M.get p found, M.get p files |> O.andThen Json.asString) of
              (O.Some a, O.Some b) -> a != b
            | _ -> True);
          extra = M.keys found |> L.filter (fn p -> not (M.member p files));
          if not (L.isEmpty bad) then Err "files differ from the archive's inventory: {S.join ", " (L.take 5 bad)}"
          else if not (L.isEmpty extra) then Err "files not in the archive's inventory: {S.join ", " (L.take 5 extra)}"
          else Ok Unit).

expectedSha : String -> O.Option String -> Result String String .
expectedSha _ (O.Some h) = Ok (S.toLower h).
expectedSha archive O.None =
  sums = Path.join (Path.parent archive) "SHA256SUMS";
  name = Path.fileName archive;
  F.readText sums
  |> R.mapError (fn u -> "no checksum for {archive}: pass --sha256 HEX or keep its SHA256SUMS beside it")
  |> R.andThen (fn text ->
      matchLine = fn l -> case S.words l of _ :: n :: Nil -> n == name or n == "*{name}" | _ -> False;
      case S.lines text |> L.find matchLine of
          O.None -> Err "{sums} has no line for {name}"
        | O.Some l -> case S.words l of h :: _ -> Ok (S.toLower h) | Nil -> Err "empty SHA256SUMS line").

lockDir : Kind -> String .
lockDir k = Path.join (home k) "lock".

withLock : unsafe Kind -> (Unit -> Result a String) -> Result a String .
withLock k body =
  _ = F.create (home k);
  if F.isDir (lockDir k) then Err "another {k.manager} is installing (legacy lock directory: {lockDir k})"
  else case Host.lock (lockDir k) of
      Err why -> Err "another {k.manager} is installing: {why}"
    | Ok fd ->
        result = body Unit;
        _ = Host.unlock fd;
        result.

withTempDir : unsafe Kind -> String -> (String -> Result a String) -> Result a String .
withTempDir k pattern body =
  _ = F.create (home k);
  Host.tempDir (Path.join (home k) pattern) |> R.andThen (fn tmp ->
    result = body tmp;
    _ = run ["/bin/chmod", "-R", "u+w", tmp];
    _ = F.removeAll tmp;
    result).

validSha : String -> Bool .
validSha h = strlen h == 64 and S.allChars P.isHexDigit h.

# Optional index fields remain optional for old format-1 release lists. If
# supplied, none is ignored. Payload identity/platform are always checked.
Entry = { version : Version, url : String, sha256 : String,
          minimumOS : String, size : Int, requires : List String, yanked : Bool }.

checkMinimum : String -> Result Unit String .
checkMinimum "" = Ok Unit.
checkMinimum minimum =
  case (run ["/usr/bin/sw_vers", "-productVersion"], V.numbers (S.split "." minimum) Nil) of
      (Ok current, Ok need) ->
        trimmed = S.trim current;
        V.numbers (S.split "." trimmed) Nil |> R.andThen (fn have ->
          pad = fn xs -> L.take 3 (L.append xs [0, 0, 0]);
          if V.notLess (V.listCompare (pad have) (pad need))
            then Ok Unit
            else Err "release needs macOS {minimum}; this host is {trimmed}")
    | _ -> Err "invalid minimumOS or cannot determine the host OS".

checkRequirement : String -> Result Unit String .
checkRequirement "xcode-clt" =
  # Build-only: installing/running Sol does not require developer tools.
  case run ["/usr/bin/xcode-select", "-p"] of
      Ok _ -> Ok Unit
    | Err _ -> _ = print "note: native builds need Command Line Tools: xcode-select --install"; Ok Unit.
checkRequirement r | S.startsWith "homebrew:" r and L.member (S.dropLeft 9 r) ["libgit2", "libarchive", "glfw"] =
  if F.isDir (Path.join "/opt/homebrew/opt" (S.dropLeft 9 r)) then Ok Unit
  else Err "missing runtime requirement {r}; install it with Homebrew".
checkRequirement r = Err "unsupported release requirement {r}".

checkRequirements : List String -> Result Unit String .
checkRequirements = R.each checkRequirement.

payloadPlatform : Kind -> Json.Value -> String .
payloadPlatform k meta | k.kind == "fpr" =
  "{O.withDefault "" (jsonText ["host", "system"] meta)}-{O.withDefault "" (jsonText ["host", "machine"] meta)}".
payloadPlatform _ meta =
  "{O.withDefault "" (jsonText ["os"] meta)}-{O.withDefault "" (jsonText ["architecture"] meta)}".

checkPayload : Kind -> Json.Value -> O.Option Entry -> Result Unit String .
checkPayload k meta expected =
  normalized = payloadPlatform k meta
    |> S.replace "Darwin" "macos"
    |> S.replace "darwin" "macos"
    |> S.replace "aarch64" "arm64";
  minimum = O.withDefault "" (jsonText ["minimumMacOS"] meta);
  if (Json.field "format" meta |> O.andThen Json.asInt) != O.Some 1 then Err "unsupported payload metadata format"
  else if normalized != platform Unit then Err "payload platform {normalized} differs from host {platform Unit}"
  else if minimum == "" then Err "payload must declare minimumMacOS"
  else case expected of
      O.None -> checkMinimum minimum
    | O.Some e ->
        if jsonText ["release"] meta != O.Some e.version.text then Err "index version {e.version.text} differs from payload release"
        else if e.minimumOS != "" and e.minimumOS != minimum then Err "index minimumOS differs from payload minimumMacOS"
        else checkMinimum minimum.

installArchive : unsafe Kind -> String -> O.Option String -> String -> Result String String .
installArchive k archive given source = installExpected k archive given source O.None.

installExpected : unsafe Kind -> String -> O.Option String -> String -> O.Option Entry -> Result String String .
installExpected k archive given source expected | not (F.isFile archive) = Err "no such archive: {archive}".
installExpected k archive given source expected =
  expectedSha archive given |> R.andThen (fn want ->
    if not (validSha want) then Err "SHA-256 must be 64 hexadecimal digits"
    else withLock k (fn u -> withTempDir k "install-XXXXXX" (fn tmp ->
      snapshot = Path.join tmp "archive.tar.gz";
      run ["/bin/cp", archive, snapshot]
      |> R.andThen (fn u -> verifySnapshot archive snapshot want expected)
      |> R.andThen (fn got -> unpackInstall k snapshot got source tmp expected)))).

verifySnapshot : unsafe String -> String -> String -> O.Option Entry -> Result String String .
verifySnapshot archive snapshot want expected =
  sha256 snapshot |> R.andThen (fn got ->
    Host.size snapshot |> R.andThen (fn size ->
      if got != want then Err "{archive}: SHA-256 is {got}, expected {want}"
      else if size > 268435456 then Err "archive exceeds 256 MiB limit"
      else case expected of
          O.Some e -> if e.size > 0 and size != e.size then Err "archive size differs from index" else Ok got
        | O.None -> Ok got)).

unpackInstall : unsafe Kind -> String -> String -> String -> String -> O.Option Entry -> Result String String .
unpackInstall k archive sha source tmp expected =
  unpacked = Path.join tmp "unpacked";
  _ = F.create unpacked;
  Host.extract archive unpacked
  |> R.andThen (fn u -> F.list unpacked)
  |> R.andThen (fn items -> case items of
      one :: Nil -> placeTop k archive sha source (Path.join unpacked one) expected
    | _ -> Err "{archive}: expected exactly one top-level folder").

placeTop : unsafe Kind -> String -> String -> String -> String -> O.Option Entry -> Result String String .
placeTop k archive sha source top expected =
  F.readText (Path.join top k.metaFile)
  |> R.mapError (fn u -> "{archive} is not a {k.component} release (no {k.metaFile})")
  |> R.andThen (fn text -> Json.parse text |> R.mapError (fn why -> "{k.metaFile}: {why}"))
  |> R.andThen (fn meta ->
      checkPayload k meta expected
      |> R.andThen (fn u -> case jsonText ["release"] meta of
          O.None -> Err "{archive}: {k.metaFile} names no release version"
        | O.Some release -> V.parse release))
  |> R.andThen (fn v ->
      final = Path.join (home k) v.text;
      if F.exists final then Err "{k.component} {v.text} is already installed ({final})"
      else checkInventory k top
        |> R.mapError (fn why -> "{archive}: {why}")
        |> R.andThen (fn u -> links k top)
        |> R.andThen (fn u -> finish k v archive sha source top final)).

# the commands a version provides: bin/NAME links to the payload's binary
links : Kind -> String -> Result Unit String .
links k top =
  bin = Path.join top "bin";
  _ = F.create bin;
  if k.kind == "qos" then
    if F.exists (Path.join bin "qos") then Ok Unit
    else Err "this QOS SDK archive has no bin/qos of its own; qosmeta needs an SDK release that ships its command (docs/2026-11-01-SDK-PROCESS-APPS.md)"
  else
    k.commands |> L.fold (fn acc name -> acc |> R.andThen (fn u ->
      if F.exists (Path.join bin name) then Ok Unit
      else run ["/bin/ln", "-s", "../{k.payload}/fpr", Path.join bin name] |> R.map (fn u -> Unit))) (Ok Unit).

receipt : Kind -> String -> String -> String -> Json.Value .
receipt k version sha source = Json.object [
  ("component", Json.Text k.component), ("version", Json.Text version),
  ("sha256", Json.Text sha), ("source", Json.Text source),
  ("installedAt", Json.Integer (OS.wallClock Unit)), ("manager", Json.Text "{k.manager} {metaVersion}")].

finish : unsafe Kind -> Version -> String -> String -> String -> String -> String -> Result String String .
finish k v archive sha source top final =
  # The receipt travels in the same atomic rename as the verified payload.
  # A crash before settings/legacy-receipt publication leaves a usable install.
  body = "{Json.render (receipt k v.text sha source)}\n";
  Host.atomicWrite (Path.join top ".fprmeta-receipt.json") body
  |> R.andThen (fn u -> run ["/bin/sh", "-c", "find \"$1\" -mindepth 1 ! -type l -exec /bin/chmod a-w \{\} +", "sh", top])
  |> R.andThen (fn u -> OS.rename top final |> R.mapError (fn why -> "{final}: {why}"))
  |> R.andThen (fn u ->
      _ = run ["/bin/chmod", "a-w", final];
      _ = F.create (Path.join (home k) "receipts");
      _ = Host.atomicWrite (receiptOf k v.text) body;
      case defaultOf k of
          O.Some _ -> Ok v.text
        | O.None ->
            setDefault k (O.Some v.text)
            |> R.map (fn u -> v.text)
            |> R.mapError (fn why -> "installed {v.text}; could not set default: {why}. Run {k.manager} default {v.text}")).

repairOne : unsafe Kind -> Version -> Result Unit String .
repairOne k v =
  top = Path.join (home k) v.text;
  if not (F.isDir top) then Ok Unit
  else
    F.readText (Path.join top k.metaFile)
    |> R.andThen Json.parse
    |> R.andThen (fn meta ->
        checkPayload k meta O.None
        |> R.andThen (fn u ->
            if jsonText ["release"] meta != O.Some v.text
              then Err "{top}: release differs from directory"
              else checkInventory k top))
    |> R.andThen (fn u ->
        _ = F.create (Path.join (home k) "receipts");
        fallback = "{Json.render (receipt k v.text "" "recovered local install; archive hash unavailable")}\n";
        body = F.readText (internalReceipt k v.text) |> R.withDefault fallback;
        Host.atomicWrite (receiptOf k v.text) body).

# Recover interrupted old installs only after full metadata/inventory checks.
# New installs already have their receipt at the atomic publication boundary.
repair : unsafe Kind -> Result String String .
repair k = withLock k (fn u ->
  F.list (home k) |> R.andThen (fn names ->
    versions = names |> L.filterMap (fn n -> case V.parse n of Ok v -> O.Some v | Err _ -> O.None);
    versions
    |> L.fold (fn acc v -> acc |> R.andThen (fn u -> repairOne k v |> R.map (fn u -> "receipts repaired")))
         (Ok "receipts repaired; choose a default with the default command if needed"))).

# ---- the version list ---------------------------------------------------------------

readLocation : String -> Result String String .
readLocation where | S.startsWith "https://" where or S.startsWith "file://" where =
  run ["/usr/bin/curl", "-fsSL", "--max-filesize", "1048576", "--proto", "=https,file", "--proto-redir", "=https,file", where].
readLocation where = F.readText where.

# SSHSIG uses the OS's Ed25519 verifier; no Homebrew crypto dependency.
# The key is supplied independently of the index. Never fetch it beside it.
verifyIndex : unsafe Kind -> List String -> String -> String -> Result Unit String .
verifyIndex k args where text =
  trusted = case flag "--trusted-key" args of
      O.Some p -> O.Some p
    | O.None -> Program.env "{S.toUpper k.manager}_TRUSTED_KEY";
  case trusted of
      O.None ->
        if L.member "--allow-unsigned-index" args then Ok Unit
        else verifyKey k where text Trust.publicKey
    | O.Some keyFile ->
        F.readText keyFile
        |> R.mapError (fn why -> "trusted public key: {why}")
        |> R.andThen (verifyKey k where text).

verifyKey : unsafe Kind -> String -> String -> String -> Result Unit String .
verifyKey k where text key =
  trimmed = S.trim key;
  words = S.words trimmed;
  if L.length words < 2 or not (S.startsWith "ssh-ed25519 " trimmed) or L.length (S.lines trimmed) != 1
    then Err "trusted key must be one OpenSSH ssh-ed25519 public key"
  else
    readLocation "{where}.sig"
    |> R.mapError (fn why -> "index signature: {why} (unsigned indexes require explicit --allow-unsigned-index)")
    |> R.andThen (fn sig -> withTempDir k "verify-XXXXXX" (fn tmp ->
        allowed = Path.join tmp "allowed";
        signature = Path.join tmp "index.sig";
        F.writeText allowed "fpr-release namespaces=\"fprmeta-index\" {S.join " " (L.take 2 words)}\n"
        |> R.andThen (fn u -> F.writeText signature sig)
        |> R.andThen (fn u -> Proc.pipeTo ["/usr/bin/ssh-keygen", "-Y", "verify", "-f", allowed, "-I", "fpr-release", "-n", "fprmeta-index", "-s", signature] text)
        |> R.andThen (fn r -> if r.status == 0 then Ok Unit else Err "index signature verification failed: {S.trim r.err}"))).

readIndex : unsafe Kind -> List String -> String -> Result Json.Value String .
readIndex k args where =
  readLocation where
  |> R.mapError (fn why -> "the version list {where}: {why}")
  |> R.andThen (fn text ->
      if strlen text > 1048576 then Err "index exceeds 1 MiB limit"
      else verifyIndex k args where text
        |> R.andThen (fn u -> Json.parse text |> R.mapError (fn why -> "the version list {where}: {why}")))
  |> R.andThen (fn index ->
      if (Json.field "format" index |> O.andThen Json.asInt) != O.Some 1 then Err "unsupported index format"
      else if jsonText ["component"] index != O.Some k.component then Err "index component differs from {k.component}"
      else Ok index).

parseEntry : Json.Value -> Result Entry String .
parseEntry e = case (jsonText ["version"] e, jsonText ["url"] e, jsonText ["sha256"] e) of
    (O.Some version, O.Some url, O.Some sha) ->
      V.parse version |> R.andThen (fn v ->
        size = Json.field "size" e |> O.andThen Json.asInt |> O.withDefault 0;
        minimum = jsonText ["minimumOS"] e |> O.withDefault "";
        requires = Json.field "requires" e |> O.andThen Json.asList |> O.withDefault Nil;
        if not (validSha sha) then Err "invalid SHA-256 in index"
        else if not (S.startsWith "https://" url or S.startsWith "file://" url) then Err "index URL must use HTTPS or file://"
        else if Json.field "size" e != O.None and (size <= 0 or size > 268435456) then Err "invalid index size"
        else if Json.field "minimumOS" e != O.None and minimum == "" then Err "invalid minimumOS"
        else if Json.field "requires" e != O.None and (Json.field "requires" e |> O.andThen Json.asList) == O.None then Err "requires must be an array"
        else if not (L.all (fn r -> Json.asString r != O.None) requires) then Err "requires must contain strings"
        else if Json.field "yanked" e != O.None and (Json.field "yanked" e |> O.andThen Json.asBool) == O.None then Err "yanked must be boolean"
        else Ok { version = v, url = url, sha256 = S.toLower sha, size = size,
                  minimumOS = minimum, requires = L.filterMap Json.asString requires,
                  yanked = Json.field "yanked" e |> O.andThen Json.asBool |> O.withDefault False })
  | _ -> Err "index entry needs version, url and sha256".

addEntry : Kind -> String -> Result (List Entry) String -> Json.Value -> Result (List Entry) String .
addEntry k plat acc item = acc |> R.andThen (fn seen ->
  if jsonText ["component"] item == O.None or jsonText ["platform"] item == O.None
    then Err "index entry needs component and platform"
  else if jsonText ["component"] item != O.Some k.component or jsonText ["platform"] item != O.Some plat
    then Ok seen
  else parseEntry item |> R.andThen (fn e ->
    if L.any (fn old -> old.version.text == e.version.text) seen
      then Err "duplicate index entry for {e.version.text}"
      else Ok (e :: seen))).

entries : Kind -> String -> Json.Value -> Result (List Entry) String .
entries k plat index = case Json.field "entries" index |> O.andThen Json.asList of
    O.None -> Err "index needs an entries array"
  | O.Some items ->
      items
      |> L.fold (addEntry k plat) (Ok Nil)
      |> R.map (L.filter (fn e -> not e.yanked)).

installFromIndex : unsafe Kind -> O.Option String -> String -> List String -> Result String String .
installFromIndex k version where args =
  readIndex k args where
  |> R.andThen (entries k (platform Unit))
  |> R.andThen (fn offered ->
      all = L.sortWith (fn a b -> V.compare a.version b.version) offered;
      chosen = case version of
          O.Some text -> L.find (fn e -> e.version.text == text) all
        | O.None -> all |> L.filter (fn e -> e.version.tag == "") |> L.last;
      case chosen of
          O.None -> Err "{where} has no {k.component} {O.withDefault "stable release" version} for {platform Unit} (available: {texts (L.map (fn e -> e.version) all)})"
        | O.Some e -> Ok e)
  |> R.andThen (fn e ->
      checkMinimum e.minimumOS
      |> R.andThen (fn u -> checkRequirements e.requires)
      |> R.andThen (fn u -> withTempDir k "download-XXXXXX" (fn tmp ->
          file = Path.join tmp "release.tar.gz";
          run ["/usr/bin/curl", "-fsSL", "--max-filesize", "268435456", "--proto", "=https,file", "--proto-redir", "=https,file", "-o", file, e.url]
          |> R.andThen (fn u -> installExpected k file (O.Some e.sha256) e.url (O.Some e))))).

# ---- the commands -------------------------------------------------------------------

usage : Kind -> String .
usage k = S.join "\n" [
  "usage: {k.manager} COMMAND",
  "  install [VERSION] [--index FILE|URL]   download, verify and install a version (default: the newest)",
  "  install --archive FILE [--sha256 HEX]   install a release tarball you already have",
  "  uninstall VERSION                       remove one version (projects are untouched)",
  "  list                                    installed versions and the default",
  "  repair                                  recover verified interrupted installs/receipts",
  "  default [VERSION]                       show or set the default version",
  "  which [{S.join "|" k.commands}] [--json]        the binary this directory would run, and why",
  "  pin [VERSION]                           pin this project exactly (=VERSION)",
  "  available [--index FILE|URL]            the versions the version list offers",
  "Index trust: --trusted-key FILE (Ed25519 public key), or explicit --allow-unsigned-index.",
  "Versions live in {home k} ({k.homeVar} overrides it)."].

flag : String -> (args : List String | measure args) -> O.Option String .
flag name args = case args of
    Nil -> O.None
  | a :: rest -> case rest of
      v :: _ -> if a == name then O.Some v else flag name rest
    | Nil -> O.None.

positional : (args : List String | measure args) -> List String .
positional args = case args of
    Nil -> Nil
  | a :: rest ->
      if a == "--allow-unsigned-index" then positional rest
      else if S.startsWith "--" a then (case rest of _ :: more -> positional more | Nil -> Nil)
      else a :: positional rest.

report : Kind -> Result String String -> Unit .
report _ (Ok msg) = print msg.
report k (Err why) = die 1 "{k.manager}: {why}".

cmdInstall : unsafe Kind -> List String -> Unit .
cmdInstall k args =
  before = defaultOf k;
  formatDone = fn v -> "installed {k.component} {v} in {Path.join (home k) v}{if before == O.None then " (now the default)" else ""}";
  res = case flag "--archive" args of
      O.Some archive -> installArchive k archive (flag "--sha256" args) archive
    | O.None ->
        version = positional args |> L.head;
        installFromIndex k version (indexOf k args) args;
  report k (R.map formatDone res).

cmdUninstall : unsafe Kind -> List String -> Unit .
cmdUninstall k args = case positional args of
    v :: Nil ->
      _ = case V.parse v of Ok _ -> Unit | Err why -> die 2 why;
      dir = Path.join (home k) v;
      if not (F.isDir dir) or not (hasReceipt k v) then die 1 "{k.manager}: {k.component} {v} is not installed"
      else report k (withLock k (fn u ->
          _ = run ["/bin/chmod", "-R", "u+w", dir];
          F.removeAll dir
          |> R.mapError (fn why -> "{dir}: {why}")
          |> R.andThen (fn u ->
              _ = F.remove (receiptOf k v);
              if defaultOf k == O.Some v
                then setDefault k O.None |> R.map (fn u -> "uninstalled {k.component} {v}; it was the default, so there is no default now")
                else Ok "uninstalled {k.component} {v}")))
  | _ -> die 2 (usage k).

cmdList : Kind -> Unit .
cmdList k =
  d = defaultOf k;
  vs = installed k;
  if L.isEmpty vs then print "no {k.component} versions installed in {home k}"
  else L.each (fn v -> print (if d == O.Some v.text then "{v.text}  (default)" else v.text)) vs.

cmdDefault : unsafe Kind -> List String -> Unit .
cmdDefault k args = case positional args of
    Nil -> print (O.withDefault "no default" (defaultOf k))
  | v :: Nil ->
      report k (withLock k (fn u ->
        if not (L.any (fn i -> i.text == v) (installed k))
          then Err "{k.component} {v} is not installed (installed: {texts (installed k)})"
          else setDefault k (O.Some v) |> R.map (fn u -> "default {k.component} is now {v}")))
  | _ -> die 2 (usage k).

defaultCommand : Kind -> String .
defaultCommand k = k.commands |> L.head |> O.withDefault k.kind.

cmdWhich : Kind -> List String -> Unit .
cmdWhich k args =
  name = positional args |> L.head |> O.withDefault (defaultCommand k);
  (v, c, _) = resolve k name Nil;
  binary = Path.joinAll [home k, v.text, "bin", name];
  payload = Path.joinAll [home k, v.text, k.payload];
  if L.member "--json" args then
    compiler = Path.join payload (if k.kind == "qos" then "compiler/fpr" else "fpr");
    moduleHome = Path.join payload (if k.kind == "qos" then "modules" else "");
    modulePaths = if k.kind == "qos" then [Path.join payload "compiler", Path.join payload "modules/programs"] else Nil;
    checkArgs = if k.kind == "qos" then ["--target=qa64", "--prelude={Path.join payload "compiler/core/prelude.fpr"}"] else ["--system=posix"];
    print (Json.render (Json.object [
      ("format", Json.Integer 1), ("component", Json.Text k.component), ("version", Json.Text v.text),
      ("command", Json.Text name), ("binary", Json.Text binary), ("compiler", Json.Text compiler),
      ("moduleHome", Json.Text moduleHome), ("modulePaths", Json.Sequence (L.map Json.Text modulePaths)),
      ("checkArgs", Json.Sequence (L.map Json.Text checkArgs)),
      ("foreign", Json.Text (if k.kind == "qos" then Path.join payload "modules/core/foreign.fpr" else "")),
      ("source", Json.Text c.source), ("requested", Json.Text (V.pinText c.pin)),
      ("metadata", Json.Text (Path.joinAll [home k, v.text, k.metaFile]))]))
  else print "{binary}\n{k.component} {v.text}, chosen by {c.source} (asks for {V.pinText c.pin})".

cmdPin : Kind -> List String -> Unit .
cmdPin k args =
  manifest = if k.kind == "qos" then "qos.toml" else "fpr.toml";
  case Pin.find k.kind (F.current Unit) of
      Err why -> die 1 "{k.manager}: {why}"
    | Ok O.None -> die 2 "{k.manager}: no {manifest} with a pin line above {F.current Unit}"
    | Ok (O.Some found) ->
        version = case positional args of
            v :: _ -> v
          | Nil -> (case resolve k (defaultCommand k) Nil of (v, _, _) -> v.text);
        _ = case V.parse version of Err why -> die 2 "{k.manager}: {why}" | Ok _ -> Unit;
        text = case F.readText found.file of Err why -> die 1 "{found.file}: {why}" | Ok t -> t;
        edited = S.lines text |> L.indexedMap (fn i line ->
            if i + 1 != found.line then line
            else
              at = O.withDefault 0 (S.indexOf "=" line);
              comment = S.dropLeft (Pin.commentEnd line 0 0 False) line;
              sep = if comment == "" then "" else " ";
              S.replace "# this fpr or a later compatible one" "# exactly this fpr" "{S.left (at + 1) line} \"={version}\"{sep}{comment}");
        note = if L.any (fn v -> v.text == version) (installed k) then ""
               else "\n(not installed yet: {k.manager} install {version})";
        report k (F.writeText found.file "{S.join "\n" edited}\n"
          |> R.map (fn u -> "{found.file}:{found.line}: pinned exactly to {version} (was \"{found.value}\"){note}")).

indexOf : Kind -> List String -> String .
indexOf k args = case flag "--index" args of
    O.Some w -> w
  | O.None -> Program.env "{S.toUpper k.manager}_INDEX" |> O.withDefault k.index.

cmdAvailable : unsafe Kind -> List String -> Unit .
cmdAvailable k args =
  where = indexOf k args;
  plat = platform Unit;
  have = installed k;
  res = readIndex k args where |> R.andThen (entries k plat);
  case res of
      Err why -> die 1 "{k.manager}: {why}"
    | Ok offered ->
        all = L.sortWith (fn a b -> V.compare a.version b.version) offered;
        if L.isEmpty all then print "{where} offers no {k.component} release for {plat}"
        else L.each (fn e -> print (if L.any (fn i -> i.text == e.version.text) have then "{e.version.text}  (installed)" else e.version.text)) all.

manage : unsafe Kind -> List String -> Unit .
manage k ("install" :: rest)   = cmdInstall k rest.
manage k ("uninstall" :: rest) = cmdUninstall k rest.
manage k ("repair" :: _)       = report k (repair k).
manage k ("list" :: _)         = cmdList k.
manage k ("available" :: rest) = cmdAvailable k rest.
manage k ("default" :: rest)   = cmdDefault k rest.
manage k ("which" :: rest)     = cmdWhich k rest.
manage k ("pin" :: rest)       = cmdPin k rest.
manage k ("--version" :: _)    = print "{k.manager} {metaVersion}".
manage k ("help" :: _)         = print (usage k).
manage k ("--help" :: _)       = print (usage k).
manage k _                     = die 2 (usage k).

dispatch : unsafe String -> List String -> Unit .
dispatch "fprmeta" args = manage fprKind args.
dispatch "qosmeta" args = manage qosKind args.
dispatch name args | L.member name fprKind.commands = launch fprKind name args.
dispatch name args | L.member name qosKind.commands = launch qosKind name args.
dispatch name _ = die 2 "fprmeta: started as \"{name}\"; link this binary as fprmeta, qosmeta, fpr, sol or qos".

main = dispatch (Program.name Unit) (Program.args Unit).

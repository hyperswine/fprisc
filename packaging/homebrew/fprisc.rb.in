# Generated by tools/package-toolchain.py from a qualified, clean release
# archive. Projects, services and Sol state live outside the Cellar.
class Fprisc < Formula
  desc "FP-RISC compiler, native build driver and Sol scripting VM"
  homepage "https://github.com/hyperswine/fprisc"
  url "https://github.com/hyperswine/fprisc/releases/download/v__VERSION__/__ARCHIVE__"
  version "__VERSION__"
  sha256 "__SHA256__"
  license "MIT"

  # The binary records its own minimum macOS; the packager refuses a mismatch.
  depends_on arch: :arm64
  depends_on macos: :golden_gate
  depends_on "libarchive"
  depends_on "libgit2"

  conflicts_with "qos-fpr", because: "both install fpr and sol"
  # QOS Portable 0.1.0 exports its private compiler as fpr. A QOS release that
  # builds apps with `qos build` only removes this conflict.
  conflicts_with "qos-portable", because: "QOS Portable 0.1.0 also installs fpr"

  def install
    libexec.install "libexec/fprisc"
    # Symlinks: fpr finds core/, std/ and the runtime beside its real path.
    bin.install_symlink libexec/"fprisc/fpr" => "fpr"
    bin.install_symlink libexec/"fprisc/fpr" => "sol"
  end

  def caveats
    <<~EOS
      Native builds (fpr build, fpr run) need a C compiler, linker and the
      macOS SDK: install the Xcode Command Line Tools with
        xcode-select --install
      Sol scripts and the REPL (sol script.sol, sol --repl) do not.
      Keep projects, service data and Sol recovery state outside the Cellar;
      upgrading or removing this package leaves them alone.
      QOS Portable apps are built with QOS's own `qos build`.
    EOS
  end

  test do
    assert_match "fpr __VERSION__", shell_output("#{bin}/fpr --version")
    (testpath/"s.sol").write "B = use \"sol/lib/base\".\n> print \"sol: {B.max0 7}\".\n"
    assert_match "sol: 7", shell_output("#{bin}/sol s.sol")
    (testpath/"hello.fpr").write "main = print \"fpr: {List.len (1 :: 2 :: Nil)}\".\n"
    assert_match "fpr: 2", shell_output("#{bin}/fpr run hello.fpr")
    output = shell_output("#{bin}/fpr build --target=qos-portable 2>&1", 2)
    assert_match "qos build", output
  end
end

firstOdd : (n : Int | measure n) -> Int -> Int .
firstOdd n x = if n <= 0 then 0 - 1 else (if band x 1 == 1 then x else firstOdd (n - 1) (x + 1)).
loop : unsafe Int -> Int -> Int .
loop i acc = if i == 0 then acc else y = firstOdd 3 (band i 6); loop (i - 1) (if y >= 0 then acc + y else acc).
main = print "{loop 10000000 0}".

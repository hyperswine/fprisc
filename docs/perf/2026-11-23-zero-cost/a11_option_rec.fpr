O = use "std/option".
firstOdd : (n : Int | measure n) -> Int -> O.Option Int .
firstOdd n x = if n <= 0 then O.None else (if band x 1 == 1 then O.Some x else firstOdd (n - 1) (x + 1)).
loop : unsafe Int -> Int -> Int .
loop i acc = if i == 0 then acc else loop (i - 1) (case firstOdd 3 (band i 6) of O.Some y -> acc + y | O.None -> acc).
main = print "{loop 10000000 0}".

Meters = Type (Meters Int).
addM : Meters -> Meters -> Meters .
addM a b = case a of Meters x -> (case b of Meters y -> Meters (band (x + y) 1048575)).
loop : unsafe Int -> Meters -> Meters .
loop i m = if i == 0 then m else loop (i - 1) (addM m (Meters i)).
main = print "{case loop 10000000 (Meters 0) of Meters v -> v}".

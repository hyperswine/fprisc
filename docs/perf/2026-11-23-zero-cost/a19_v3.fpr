add3 : {x : F64, y : F64, z : F64} -> {x : F64, y : F64, z : F64} -> {x : F64, y : F64, z : F64} .
add3 a b = {x = a.x + b.x, y = a.y + b.y, z = a.z * 0.5 + b.z}.
loop : unsafe Int -> {x : F64, y : F64, z : F64} -> F64 .
loop i v = if i == 0 then v.x + v.y + v.z else loop (i - 1) (add3 v {x = 0.5, y = 0.25, z = 1.0}).
main = print "{F64.toInt (loop 10000000 {x = 0.0, y = 0.0, z = 0.0})}".

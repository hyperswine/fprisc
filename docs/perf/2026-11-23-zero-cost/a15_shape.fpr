Shape = Type (Circle Int | Rect Int Int).
mk : Int -> Shape .
mk i = if band i 1 == 0 then Circle (band i 255) else Rect (band i 15) (band i 31).
area : Shape -> Int .
area s = case s of Circle r -> 3 * r * r | Rect w h -> w * h.
loop : unsafe Int -> Int -> Int .
loop i acc = if i == 0 then acc else loop (i - 1) (band (acc + area (mk i)) 1048575).
main = print "{loop 10000000 0}".

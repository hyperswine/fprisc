# ---- typed client state (std/view: locals, hold, setTo, step, toggle, showIf, bindInt,
# sendWith).  The page holds every value as TEXT.  A FAMILY (a client field of type
# List (String, a)) arrives as an array of [key, text] pairs and is held one entry
# per key, under `name[key]`; the mirror hands it back as the pairs.  The first
# declaration of a name wins, and is what a password field mirrors as.
attrOf el name = JS.Call (JS.Field (JS.Name el) "getAttribute") [JS.Text name].
hasAttr el name = JS.Call (JS.Field (JS.Name el) "hasAttribute") [JS.Text name].
localAt k = JS.Index (JS.Name "locals") k.
isArray x = JS.Call (JS.Field (JS.Name "Array") "isArray") [x].
fresh k table = JS.Unary JS.Not (JS.Binary JS.In k (JS.Name table)).

declareBody u = [
  JS.If (isArray (JS.Name "v"))
    [JS.Do (JS.AssignValue (JS.Index (JS.Name "families") (JS.Name "k")) (JS.Boolean True)),
     JS.If (fresh (JS.Name "k") "locals") [JS.Do (JS.AssignValue (localAt (JS.Name "k")) (JS.Name "v"))] [],
     JS.ForOf "p" (JS.Name "v")
       [JS.If (JS.Binary JS.And (JS.Binary JS.And (isArray (JS.Name "p")) (JS.Binary JS.Equal (JS.Field (JS.Name "p") "length") (JS.Number 2)))
                 (JS.Binary JS.Equal (JS.Unary JS.TypeOf (JS.Index (JS.Name "p") (JS.Number 0))) (JS.Text "string")))
          [JS.Do (JS.Call (JS.Name "declare") [JS.Binary JS.Add (JS.Binary JS.Add (JS.Binary JS.Add (JS.Name "k") (JS.Text "[")) (JS.Index (JS.Name "p") (JS.Number 0))) (JS.Text "]"),
                                               JS.Call (JS.Name "String") [JS.Index (JS.Name "p") (JS.Number 1)]])] []],
     JS.ReturnVoid] [],
  JS.If (fresh (JS.Name "k") "locals") [JS.Do (JS.AssignValue (localAt (JS.Name "k")) (JS.Name "v"))] [],
  JS.If (fresh (JS.Name "k") "initial") [JS.Do (JS.AssignValue (JS.Index (JS.Name "initial") (JS.Name "k")) (JS.Name "v"))] []
].

# shown while the local's text is (data-is) or is not (data-is-not) one of a list

  JS.While (JS.Name "cursor") [JS.Var "stale" (JS.Name "cursor"), JS.Do (JS.AssignValue (JS.Name "cursor") (JS.Field (JS.Name "cursor") "nextSibling")), JS.Do (JS.Call (JS.Field (JS.Name "parent") "removeChild") [(JS.Name "stale")])]

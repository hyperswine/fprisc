# fprlivejs.fpr -- the FPRLive client: one websocket, statics + dynamics,
# locals.  Hand-written (the long-poll client in livejs.fpr is generated
# by tools/livegen.sol); braces are escaped for the FPRISC string literal.

src u = "/* fprlive.js -- the FPRLive client.
 *
 *  1. a page is STATICS interleaved with DYNAMICS:
 *     html = s[0] + d[0] + s[1] + d[1] + ... + s[n]
 *     the statics are markup; every dynamic is TEXT in <span data-slot>
 *     (textContent both on first paint and on delta, so a dynamic that
 *     carries user input can never become markup).
 *  2. the server pushes: \{s,d} = a full render, \{d:\{i:txt}} = a delta,
 *     over ONE websocket at /ws; the client sends \{msg,arg} text frames.
 *  3. LOCALS are client-only state declared in the tree (x-data,
 *     data-set/data-val, data-show, data-text, data-input); they cross
 *     the wire only as the arg of a data-click / data-enter.
 */
'use strict';
(function () \{
  var S = window.__LV__ || \{ s: [], d: [] };
  var root = document.getElementById('lv-root');
  var locals = Object.create(null);
  var ws = null, wait = 500, sent = 0, t0 = 0;

  // Keys identify siblings, never positions. Dynamic slot numbers may change
  // after an insertion, so patch the detached tree before matching old nodes.
  function keyOf(node) \{
    return node.nodeType === 1 ? node.getAttribute('data-lv-key') : null;
  }

  function compatible(a, b) \{
    return a.nodeType === b.nodeType && a.nodeName === b.nodeName;
  }

  function reconcile(parent, wanted) \{
    var keyed = new Map();
    Array.from(parent.childNodes).forEach(function (n) \{
      var key = keyOf(n);
      if (key !== null) \{
        if (keyed.has(key)) throw new Error('duplicate view key: ' + key);
        keyed.set(key, n);
      }
    });
    var cursor = parent.firstChild, seen = new Set();
    Array.from(wanted.childNodes).forEach(function (next) \{
      var key = keyOf(next), old = null;
      if (key !== null) \{
        if (seen.has(key)) throw new Error('duplicate view key: ' + key);
        seen.add(key);
        old = keyed.get(key);
      } else if (cursor && keyOf(cursor) === null && compatible(cursor, next)) \{
        old = cursor;
      }
      if (old && compatible(old, next)) \{
        if (old !== cursor) parent.insertBefore(old, cursor);
        if (old.nodeType === 1) \{
          Array.from(old.attributes).forEach(function (a) \{
            if (!next.hasAttribute(a.name)) old.removeAttribute(a.name);
          });
          Array.from(next.attributes).forEach(function (a) \{
            if (old.getAttribute(a.name) !== a.value) old.setAttribute(a.name, a.value);
          });
          // The browser owns live form values, selection and composition.
          // Server-controlled values use the existing explicit client ports.
          if (!old.matches('textarea[data-input],select[data-input]')) reconcile(old, next);
        } else if (old.nodeValue !== next.nodeValue) old.nodeValue = next.nodeValue;
        cursor = old.nextSibling;
      } else \{
        parent.insertBefore(next, cursor);
      }
    });
    while (cursor) \{
      var stale = cursor;
      cursor = cursor.nextSibling;
      parent.removeChild(stale);
    }
  }

  function build() \{
    var out = '';
    for (var i = 0; i < S.s.length; i++) \{
      out += S.s[i];
      if (i < S.d.length) out += '<span data-slot=\"' + i + '\"></span>';
    }
    var wanted = document.createElement('div');
    wanted.innerHTML = out;
    wanted.querySelectorAll('[data-slot]').forEach(function (el) \{
      el.textContent = S.d[Number(el.getAttribute('data-slot'))];
    });
    var active = document.activeElement;
    var start = active && active.selectionStart, end = active && active.selectionEnd;
    var direction = active && active.selectionDirection;
    reconcile(root, wanted);
    // Moving an ancestor can blur an input. Restore only an element that
    // survived; removing an edit form must not focus its replacement.
    if (active && root.contains(active) && document.activeElement !== active) \{
      active.focus(\{preventScroll: true});
      if (typeof start === 'number') active.setSelectionRange(start, end, direction);
    }
    scanLocals();
    wire();
    paintLocals();
  }

  function slot(k, txt, flash) \{
    var el = root.querySelector('[data-slot=\"' + k + '\"]');
    if (!el) return;
    el.textContent = txt;
    if (flash) \{ el.classList.remove('lv-flash'); void el.offsetWidth; el.classList.add('lv-flash'); }
  }

  function scanLocals() \{
    root.querySelectorAll('[x-data]').forEach(function (el) \{
      el.getAttribute('x-data').split(';').forEach(function (pair) \{
        if (!pair) return;
        var eq = pair.indexOf('='), n = pair.slice(0, eq);
        if (!(n in locals)) locals[n] = pair.slice(eq + 1);
      });
    });
  }

  function paintLocals() \{
    root.querySelectorAll('[data-text]').forEach(function (el) \{
      el.textContent = locals[el.getAttribute('data-text')] ?? '';
    });
    root.querySelectorAll('[data-show]').forEach(function (el) \{
      var spec = el.getAttribute('data-show').split(':');
      var v = locals[spec[0]];
      var on = spec.length > 1 ? String(v) === spec[1] : (v && v !== '0' && v !== 'false');
      el.style.display = on ? '' : 'none';
    });
    root.querySelectorAll('[data-on]').forEach(function (el) \{
      var spec = el.getAttribute('data-on').split(':');
      el.classList.toggle('is-on', String(locals[spec[0]]) === spec[1]);
    });
    root.querySelectorAll('[data-input]').forEach(function (el) \{
      var n = el.getAttribute('data-input');
      if (el !== document.activeElement) el.value = locals[n] ?? '';
    });
  }

  function applySet(name, val) \{
    var cur = locals[name];
    if (val === 'toggle') locals[name] = (cur === '1' ? '0' : '1');
    else if (val[0] === '+' || val[0] === '-') locals[name] = String((+cur || 0) + (+val));
    else locals[name] = val;
  }

  function argOf(el) \{
    if (el.hasAttribute('data-lit')) return el.getAttribute('data-lit');
    var a = el.getAttribute('data-arg');
    if (!a) return '';
    return a.split(',').map(function (n) \{ return locals[n] ?? ''; }).join('|');
  }

  function wire() \{
    // Reused elements must not retain handlers for attributes removed by a patch.
    root.querySelectorAll('*').forEach(function (el) \{
      el.onclick = el.onchange = el.oninput = el.onkeydown = null;
    });
    root.querySelectorAll('[data-set]').forEach(function (el) \{
      el.onclick = function () \{
        applySet(el.getAttribute('data-set'), el.getAttribute('data-val'));
        paintLocals();
      };
    });
    root.querySelectorAll('[data-click]').forEach(function (el) \{
      el.onclick = function () \{
        var set = el.getAttribute('data-set');
        if (set) applySet(set, el.getAttribute('data-val'));
        send(el.getAttribute('data-click'), argOf(el));
        paintLocals();
      };
    });
    // a file input: read the chosen file and send it as the message's final
    // field, as name:base64 (View.uploadWith)
    root.querySelectorAll('[data-file]').forEach(function (el) \{
      el.onchange = function () \{
        var f = el.files && el.files[0];
        if (!f) return;
        var rd = new FileReader();
        rd.onload = function () \{ send(el.getAttribute('data-file'), f.name + ':' + String(rd.result).split(',')[1]); };
        rd.readAsDataURL(f);
      };
    });
    root.querySelectorAll('[data-input]').forEach(function (el) \{
      var n = el.getAttribute('data-input');
      el.oninput = function () \{ locals[n] = el.value; paintLocals(); };
      el.onkeydown = function (e) \{
        if (e.key === 'Enter' && el.hasAttribute('data-enter')) send(el.getAttribute('data-enter'), argOf(el));
      };
    });
  }

  function send(msg, arg) \{
    if (!ws || ws.readyState !== 1) return;
    t0 = performance.now(); sent++;
    ws.send(JSON.stringify(\{ msg: msg, arg: String(arg) }));
  }

  function spliced(old, patch) \{
    if (!Array.isArray(patch) || patch.length !== 3 ||
        !Number.isInteger(patch[0]) || !Number.isInteger(patch[1]) ||
        patch[0] < 0 || patch[1] < 0 || patch[0] + patch[1] > old.length ||
        !Array.isArray(patch[2]) || !patch[2].every(x => typeof x === 'string')) \{
      throw new Error('invalid structural patch');
    }
    return old.slice(0, patch[0]).concat(patch[2], old.slice(patch[0] + patch[1]));
  }

  // v3: a list of splices, applied in order (each start counts in the array
  // as the ones before it left it); the old array is never modified
  function splicedAll(old, patches) \{
    if (!Array.isArray(patches)) throw new Error('invalid structural patch list');
    var cur = old;
    for (var i = 0; i < patches.length; i++) cur = spliced(cur, patches[i]);
    return cur;
  }

  function apply(res) \{
    // server-to-client COMMANDS (std/live.fpr): go somewhere, or hand a named
    // event to the page's own script (document.addEventListener('live:name', ...))
    if (res.nav) \{ location.href = res.nav; return; }
    if (res.emit) \{ document.dispatchEvent(new CustomEvent('live:' + res.emit, \{ detail: res.detail })); return; }
    if (res.p !== undefined) \{
      if (res.p !== 2 && res.p !== 3) throw new Error('unsupported live protocol');
      var next = res.p === 3 ? \{s: splicedAll(S.s, res.s), d: splicedAll(S.d, res.d)}
                             : \{s: spliced(S.s, res.s), d: spliced(S.d, res.d)};
      if (next.s.length !== next.d.length + 1) throw new Error('invalid view shape');
      S = next;
      build();
      return;
    }
    if (res.s) \{ S = \{ s: res.s, d: res.d }; build(); return; }
    var n = 0;
    for (var k in res.d) \{ S.d[k] = res.d[k]; slot(k, res.d[k], true); n++; }
    var w = document.getElementById('lv-wire');
    if (w && t0) \{ w.textContent = n + ' slot(s) · ' + (performance.now() - t0).toFixed(1) + ' ms'; t0 = 0; }
  }

  function status(s) \{
    var el = document.getElementById('lv-link');
    if (el) el.textContent = s;
  }

  function connect() \{
    var url = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws?lv=3';
    ws = new WebSocket(url);
    ws.onopen = function () \{ wait = 500; status('live'); };
    ws.onmessage = function (ev) \{
      var res; try \{ res = JSON.parse(ev.data); } catch (e) \{ ws.close(4002, 'resync'); return; }
      try \{ apply(res); } catch (e) \{
        // Closing with an error reconnects to a fresh full snapshot. Ordered
        // WebSocket frames need no per-patch ack on a surviving connection.
        console.error('live patch rejected', e);
        ws.close(4002, 'resync');
      }
    };
    ws.onclose = function (ev) \{
      status('offline (' + ev.code + ')');
      if (ev.code === 1000 || ev.code === 1001) return;   /* deliberate close: stay down */
      setTimeout(connect, wait);
      wait = Math.min(wait * 2, 8000);
    };
    ws.onerror = function () \{};
  }

  build();
  connect();
})();
".

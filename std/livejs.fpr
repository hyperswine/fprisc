# Structured browser capability program. FP-RISC syntax values are authoritative.
# No foreign source asset or Raw node is read at runtime.
JS = use "std/javascript".
G = use "std/view".
# the node the client writes its connection state into ("live", "offline (1006)")
link : G.Attr .
link = G.Att "id" linkId.
linkId = "lv-link".
src u = JS.program [
  JS.Strict,
  JS.Do (JS.Call (JS.Function [] (bodyBody1 Unit)) [])
].

keyOfBody2 u = [
  JS.Return (JS.Choose (JS.Binary JS.Equal (JS.Field (JS.Name "node") "nodeType") (JS.Number 1)) (JS.Call (JS.Field (JS.Name "node") "getAttribute") [(JS.Text "data-lv-key")]) (JS.Null))
].

compatibleBody3 u = [
  JS.Return (JS.Binary JS.And (JS.Binary JS.Equal (JS.Field (JS.Name "a") "nodeType") (JS.Field (JS.Name "b") "nodeType")) (JS.Binary JS.Equal (JS.Field (JS.Name "a") "nodeName") (JS.Field (JS.Name "b") "nodeName")))
].

bodyBody5 u = [
  JS.Var "key" (JS.Call (JS.Name "keyOf") [(JS.Name "n")]),
  JS.If (JS.Binary JS.NotEqual (JS.Name "key") (JS.Null)) [JS.If (JS.Call (JS.Field (JS.Name "keyed") "has") [(JS.Name "key")]) [JS.Throw (JS.New (JS.Name "Error") [(JS.Binary JS.Add (JS.Text "duplicate view key: ") (JS.Name "key"))])] [], JS.Do (JS.Call (JS.Field (JS.Name "keyed") "set") [(JS.Name "key"), (JS.Name "n")])] []
].

bodyBody7 u = [
  JS.If (JS.Unary JS.Not (JS.Call (JS.Field (JS.Name "next") "hasAttribute") [(JS.Field (JS.Name "a") "name")])) [JS.Do (JS.Call (JS.Field (JS.Name "old") "removeAttribute") [(JS.Field (JS.Name "a") "name")])] []
].

bodyBody8 u = [
  JS.If (JS.Binary JS.NotEqual (JS.Call (JS.Field (JS.Name "old") "getAttribute") [(JS.Field (JS.Name "a") "name")]) (JS.Field (JS.Name "a") "value")) [JS.Do (JS.Call (JS.Field (JS.Name "old") "setAttribute") [(JS.Field (JS.Name "a") "name"), (JS.Field (JS.Name "a") "value")])] []
].

bodyBody6 u = [
  JS.Var "key" (JS.Call (JS.Name "keyOf") [(JS.Name "next")]),
  JS.Var "old" (JS.Null),
  JS.If (JS.Binary JS.NotEqual (JS.Name "key") (JS.Null)) [JS.If (JS.Call (JS.Field (JS.Name "seen") "has") [(JS.Name "key")]) [JS.Throw (JS.New (JS.Name "Error") [(JS.Binary JS.Add (JS.Text "duplicate view key: ") (JS.Name "key"))])] [], JS.Do (JS.Call (JS.Field (JS.Name "seen") "add") [(JS.Name "key")]), JS.Do (JS.AssignValue (JS.Name "old") (JS.Call (JS.Field (JS.Name "keyed") "get") [(JS.Name "key")]))] [JS.If (JS.Binary JS.And (JS.Binary JS.And (JS.Name "cursor") (JS.Binary JS.Equal (JS.Call (JS.Name "keyOf") [(JS.Name "cursor")]) (JS.Null))) (JS.Call (JS.Name "compatible") [(JS.Name "cursor"), (JS.Name "next")])) [JS.Do (JS.AssignValue (JS.Name "old") (JS.Name "cursor"))] []],
  JS.If (JS.Binary JS.And (JS.Name "old") (JS.Call (JS.Name "compatible") [(JS.Name "old"), (JS.Name "next")])) [JS.If (JS.Binary JS.NotEqual (JS.Name "old") (JS.Name "cursor")) [JS.Do (JS.Call (JS.Field (JS.Name "parent") "insertBefore") [(JS.Name "old"), (JS.Name "cursor")])] [], JS.If (JS.Binary JS.Equal (JS.Field (JS.Name "old") "nodeType") (JS.Number 1)) [JS.Do (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "Array") "from") [(JS.Field (JS.Name "old") "attributes")]) "forEach") [(JS.Function ["a"] (bodyBody7 Unit))]), JS.Do (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "Array") "from") [(JS.Field (JS.Name "next") "attributes")]) "forEach") [(JS.Function ["a"] (bodyBody8 Unit))]), JS.If (JS.Unary JS.Not (JS.Call (JS.Field (JS.Name "old") "matches") [(JS.Text "textarea[data-input],select[data-input]")])) [JS.Do (JS.Call (JS.Name "reconcile") [(JS.Name "old"), (JS.Name "next")])] []] [JS.If (JS.Binary JS.NotEqual (JS.Field (JS.Name "old") "nodeValue") (JS.Field (JS.Name "next") "nodeValue")) [JS.Do (JS.AssignValue (JS.Field (JS.Name "old") "nodeValue") (JS.Field (JS.Name "next") "nodeValue"))] []], JS.Do (JS.AssignValue (JS.Name "cursor") (JS.Field (JS.Name "old") "nextSibling"))] [JS.Do (JS.Call (JS.Field (JS.Name "parent") "insertBefore") [(JS.Name "next"), (JS.Name "cursor")])]
].

reconcileBody4 u = [
  JS.Var "keyed" (JS.New (JS.Name "Map") []),
  JS.Do (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "Array") "from") [(JS.Field (JS.Name "parent") "childNodes")]) "forEach") [(JS.Function ["n"] (bodyBody5 Unit))]),

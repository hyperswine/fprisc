    (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "JSON") "parse") [JS.Name "is"]) "includes") [JS.Name "t"])
    (JS.Unary JS.Not (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "JSON") "parse") [JS.Binary JS.Nullish (attrOf "el" "data-is-not") (JS.Text "[]")]) "includes") [JS.Name "t"]))),
  JS.Do (JS.AssignValue (JS.Field (JS.Field (JS.Name "el") "style") "display") (JS.Choose (JS.Name "on") (JS.Text "") (JS.Text "none")))
].


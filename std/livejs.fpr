bodyBody10 u = [
  JS.Do (JS.AssignValue (JS.Field (JS.Name "el") "textContent") (JS.Index (JS.Field (JS.Name "S") "d") (JS.Call (JS.Name "Number") [(JS.Call (JS.Field (JS.Name "el") "getAttribute") [(JS.Text "data-slot")])])))

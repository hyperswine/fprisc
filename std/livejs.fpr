buildBody9 u = [
  JS.Var "out" (JS.Text ""),
  JS.For [JS.Var "i" (JS.Number 0)] (JS.Binary JS.Less (JS.Name "i") (JS.Field (JS.Field (JS.Name "S") "s") "length")) (JS.Increment (JS.Name "i")) [JS.Do (JS.AssignValue (JS.Name "out") (JS.Binary JS.Add (JS.Name "out") (JS.Index (JS.Field (JS.Name "S") "s") (JS.Name "i")))), JS.If (JS.Binary JS.Less (JS.Name "i") (JS.Field (JS.Field (JS.Name "S") "d") "length")) [JS.Do (JS.AssignValue (JS.Name "out") (JS.Binary JS.Add (JS.Name "out") (JS.Binary JS.Add (JS.Binary JS.Add (JS.Text "<span data-slot=\"") (JS.Name "i")) (JS.Text "\"></span>"))))] []],
  JS.Var "wanted" (JS.Call (JS.Field (JS.Name "document") "createElement") [(JS.Text "div")]),
  JS.Do (JS.AssignValue (JS.Field (JS.Name "wanted") "innerHTML") (JS.Name "out")),
  JS.Do (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "wanted") "querySelectorAll") [(JS.Text "[data-slot]")]) "forEach") [(JS.Function ["el"] (bodyBody10 Unit))]),
  JS.Var "active" (JS.Field (JS.Name "document") "activeElement"),
  JS.Var "start" (JS.Binary JS.And (JS.Name "active") (JS.Field (JS.Name "active") "selectionStart")),
  JS.Var "end" (JS.Binary JS.And (JS.Name "active") (JS.Field (JS.Name "active") "selectionEnd")),
  JS.Var "direction" (JS.Binary JS.And (JS.Name "active") (JS.Field (JS.Name "active") "selectionDirection")),
  JS.Do (JS.Call (JS.Name "reconcile") [(JS.Name "root"), (JS.Name "wanted")]),
  JS.If (JS.Binary JS.And (JS.Binary JS.And (JS.Name "active") (JS.Call (JS.Field (JS.Name "root") "contains") [(JS.Name "active")])) (JS.Binary JS.NotEqual (JS.Field (JS.Name "document") "activeElement") (JS.Name "active"))) [JS.Do (JS.Call (JS.Field (JS.Name "active") "focus") [(JS.Object [("preventScroll", JS.Boolean True)])]), JS.If (JS.Binary JS.Equal (JS.Unary JS.TypeOf (JS.Name "start")) (JS.Text "number")) [JS.Do (JS.Call (JS.Field (JS.Name "active") "setSelectionRange") [(JS.Name "start"), (JS.Name "end"), (JS.Name "direction")])] []] [],
  JS.Do (JS.Call (JS.Name "scanLocals") []),
  JS.Do (JS.Call (JS.Name "wire") []),
  JS.Do (JS.Call (JS.Name "paintLocals") [])
].

slotBody11 u = [
  JS.Var "el" (JS.Call (JS.Field (JS.Name "root") "querySelector") [(JS.Binary JS.Add (JS.Binary JS.Add (JS.Text "[data-slot=\"") (JS.Name "k")) (JS.Text "\"]"))]),
  JS.If (JS.Unary JS.Not (JS.Name "el")) [JS.ReturnVoid] [],
  JS.Do (JS.AssignValue (JS.Field (JS.Name "el") "textContent") (JS.Name "txt")),
  JS.If (JS.Name "flash") [JS.Do (JS.Call (JS.Field (JS.Name "el") "animate")
    [JS.Array [JS.Object [("color", JS.Text (G.colourCss (G.Rgb 87 226 210)))], JS.Object [("color", JS.Text (G.colourCss G.CurrentColour))]], JS.Object [("duration", JS.Number 550), ("easing", JS.Text "ease-out")]])] [],
  JS.Do (JS.Call (JS.Name "paintOwned") [])
].

bodyBody14 u = [
  JS.If (JS.Unary JS.Not (JS.Name "pair")) [JS.ReturnVoid] [],
  JS.Var "eq" (JS.Call (JS.Field (JS.Name "pair") "indexOf") [(JS.Text "=")]),
  JS.Var "n" (JS.Call (JS.Field (JS.Name "pair") "slice") [(JS.Number 0), (JS.Name "eq")]),
  JS.Do (JS.Call (JS.Name "declare") [JS.Name "n", JS.Call (JS.Field (JS.Name "pair") "slice") [JS.Binary JS.Add (JS.Name "eq") (JS.Number 1)]])
].

bodyBody13 u = [
  JS.Do (JS.Call (JS.Field (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "el") "getAttribute") [(JS.Text "x-data")]) "split") [(JS.Text ";")]) "forEach") [(JS.Function ["pair"] (bodyBody14 Unit))])
].

scanLocalsBody12 u = [
  JS.Do (JS.Call (JS.Field (JS.Call (JS.Field (JS.Name "root") "querySelectorAll") [(JS.Text "[x-data]")]) "forEach") [(JS.Function ["el"] (bodyBody13 Unit))]),
  JS.ForOf "el" (JS.Call (JS.Field (JS.Name "root") "querySelectorAll") [JS.Text "[x-json]"])
    [JS.Const "held" (JS.Call (JS.Field (JS.Name "JSON") "parse") [attrOf "el" "x-json"]),
     JS.ForIn "k" (JS.Name "held") [JS.Do (JS.Call (JS.Name "declare") [JS.Name "k", JS.Index (JS.Name "held") (JS.Name "k")])]]

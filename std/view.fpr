cssRule "mt-2" = declsCss [MarginTop (Px 8)].
cssRule "mt-4" = declsCss [MarginTop (Px 18)].
cssRule "mb-2" = declsCss [MarginBottom (Px 8)].
cssRule "mb-4" = declsCss [MarginBottom (Px 18)].
cssRule "text-xs" = declsCss [FontSize (Px 11)].
cssRule "text-sm" = declsCss [FontSize (Px 13)].
cssRule "text-lg" = declsCss [FontSize (Px 18)].
cssRule "text-2xl" = declsCss [FontSize (Px 30)].
cssRule "text-4xl" = declsCss [FontSize (Px 46)].
cssRule "bold" = declsCss [FontWeight 700].
cssRule "mono" = declsCss [FontFamily MonoFont].
cssRule "upper" = declsCss [TextCase UpperCase, LetterSpacing (Em 180)].
cssRule "dim" = declsCss [Foreground (ThemeColour (Dim))].
cssRule "ink" = declsCss [Foreground (ThemeColour (Ink))].
cssRule "acc" = declsCss [Foreground (Rgb 87 226 210)].
cssRule "warm" = declsCss [Foreground (Rgb 255 138 92)].
cssRule "panel" = declsCss [BackgroundImages [TokenImage Panel], BorderWidth (Px 1), BorderStyle SolidBorder, BorderColour (ThemeColour (Line))].
cssRule "card" = declsCss [Background (ThemeColour (Card)), BorderWidth (Px 1), BorderStyle SolidBorder, BorderColour (ThemeColour (Line))].
cssRule "round" = declsCss [Radius (Px 14)].
cssRule "pill" = declsCss [Radius (Px 999)].
cssRule "btn" = declsCss [Cursor PointerCursor, BorderWidth (Px 1), BorderStyle SolidBorder, BorderColour (ThemeColour (Line)), Background (ThemeColour (Card)), Foreground (ThemeColour (Dim)), TransitionAll 150].
cssRule "glow" = declsCss [Shadow (Px 0) (Px 0) (Px 24) (Px 0) (RgbaPercent 87 226 210 22)].

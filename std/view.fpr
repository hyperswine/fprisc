# std/view.fpr -- View: an Elm/LiveView-style view tree (it was
# qos/programs/mods/genview.fpr: the application library belongs in std).
#
# A view is a TREE, not a string. Rendering it splits the page the way
# Phoenix LiveView does:
#
#   render tree -> (statics, dynamics)
#   page = s0 ++ d0 ++ s1 ++ d1 ++ ... ++ sn        (statics = n+1)
#
# The statics are fixed by the SHAPE of the tree; only the dynamics
# move. So an update that changes one value ships one string, and the
# client patches one node. If the shape itself changes (a branch flips)
# the statics differ and the server says so, and the client re-renders.
#
# THE TWO KINDS OF STATE, both declared in the same tree:
#
#   Dyn v            server state. Comes from the model, arrives as a
#                    dynamic slot, updates by delta.
#   Local n init     client state (Alpine-style). Declared on an
#                    element; lives only in the browser; never
#                    round-trips on its own.
#   LTxt n           print a local.
#   ShowIf n         show/hide by a local -- zero server involvement.
#   OnSet n v        click mutates a local ("+1" / "-1" / "toggle" / lit).
#   OnClick msg n    click sends msg TO THE SERVER carrying local n's
#                    current value -- the bridge between the two halves,
#                    i.e. onClick=Msg.pressed @press.
#   OnSend msg lit   click sends msg carrying a LITERAL arg (a catalog
#                    index, a tab name): no local needed.
#   Inp attrs        a text input; Input n binds it to local n (typing
#                    updates the local), OnEnter msg n sends on Enter.
#
# CSS is generated from the tree too: only the utility classes actually
# used anywhere in it are emitted, so the stylesheet is a function of
# the view, not a 3MB file you filter later.  An app's own classes are
# VALUES (Style, below), never a string of CSS, and any class takes a
# breakpoint prefix: `narrow:col` is `col` on a narrow screen.
# New code can compose typed declarations directly on an element with
# utilities/narrow/wide/hover/focus/disabled; no named Style is required.
# See docs/2026-10-14-LOCAL-UI-AND-NATIVE-SERVICES.md for precedence and scope.


Encoding = use "encoding".

Attr = Type (Cls String | Utilities (List Utility) | Att String String | Local String String
           | OnClick String String | OnSet String String | ShowIf String
           | OnBoth String String String String
           | OnSend String String | Input String | OnEnter String String | OnFile String).
Node = Type (El String (List Attr) (List Node) | Txt String | Dyn String | LTxt String
           | Inp (List Attr) | Fragment (List String) (List String) (List String)).

# A stable identity among siblings. Keys preserve DOM nodes across structural
# snapshots; they do not change the existing (statics, dynamics) wire format.
# Keys must be unique within a parent and stable for the lifetime of an item.
key : String -> Node -> Node .
key k n = case n of
    El tag attrs kids -> El tag (Att "data-lv-key" k :: attrs) kids
  | Inp attrs -> Inp (Att "data-lv-key" k :: attrs)
  | _ -> error "View.key needs an element".

Ctx = Type (Ctx cur statics dyns).

# ---- rendering: tree -> (statics, dynamics) --------------------------------

render n = fin (goN (Ctx "" Nil Nil) n).
# At the FINAL page render, carry the current local rules in the normal view
# protocol. New conditional styles then travel with their elements. Component
# caches still use render; their class lists retain these rule definitions.
renderStyled : Node -> (List String, List String) .
renderStyled n =
  css = localCss (nub (allClasses n Nil));
  # Keep the style node even when empty: adding/removing the final utility
  # must not replace an unkeyed page root and lose its form state.
  start = "<style data-lv-local-css=\"\">{css}</style>";
  fin (goN (Ctx start Nil Nil) n).
fin (Ctx cur ss ds) = (rev (cur :: ss), rev ds).

goN : unsafe Ctx -> Node -> Ctx .
goN c (Fragment ss ds _) = appendFragment c ss ds.
goN c (Txt s) = emit c (esc s).
goN c (Dyn v) = slot c v.
goN c (LTxt n) = emit c "<span data-text=\"{n}\"></span>".
goN c (Inp attrs) = emit c "<input{attrsOf attrs}>".
goN c (El tag attrs kids) =
  c1 = emit c "<{tag}{attrsOf attrs}>";
  c2 = goKids c1 kids;
  emit c2 "</{tag}>".

# Cached fragments have LOCAL slots. Compose them into this render's context;
# global slot indices are assigned only by the final interleaved arrays.
appendFragment : unsafe Ctx -> List String -> List String -> Ctx .
appendFragment c ss ds = case (ss, ds) of
    (s :: Nil, Nil) -> emit c s
  | (s :: rest, d :: more) -> appendFragment (slot (emit c s) d) rest more
  | _ -> error "View: invalid cached fragment shape".

goKids : unsafe Ctx -> List Node -> Ctx .
goKids c Nil = c.
goKids c (k :: r) = goKids (goN c k) r.

emit (Ctx cur ss ds) s = Ctx (strcat cur s) ss ds.
slot (Ctx cur ss ds) v = Ctx "" (cur :: ss) (v :: ds).

# ---- attributes ------------------------------------------------------------

# locals MERGE into one x-data: two x-local attributes on one element
# would be a duplicate attribute name, and HTML keeps only the first --
# a silent single-local ceiling. One attribute, Alpine-shaped.
# Classes merge the same way, for the same reason: Ma's `card` is
# `vsA 3 [Cls "bg-surface ..."]`, a Cls from the layout and a Cls from the
# caller on one element -- and with two class attributes the browser kept the
# first, so no card ever had its surface.  One attribute, every class.
attrsOf as = strcat (xdata (localsOf as)) (strcat (classAttr (joinSp (classesOf as) (atomClasses (localAtoms as)))) (others as)).
localsOf : unsafe List Attr -> String .
localsOf Nil = "".
localsOf (Local n init :: r) = join2 (localsOf r) "{n}={init}".
localsOf (a :: r) = localsOf r.
xdata "" = "".
xdata s = " x-data=\"{s}\"".
classesOf : unsafe List Attr -> String .
classesOf Nil = "".
classesOf (Cls s :: r) = joinSp s (classesOf r).
classesOf (a :: r) = classesOf r.
joinSp "" b = b.
joinSp a "" = a.
joinSp a b = strcat a (strcat " " b).
classAttr "" = "".
classAttr s = " class=\"{s}\"".
others : unsafe List Attr -> String .
others Nil = "".
others (Local n init :: r) = others r.
others (Cls s :: r) = others r.
others (Utilities _ :: r) = others r.
others (a :: r) = strcat (attrOf a) (others r).

attrOf (Cls s) = " class=\"{s}\"".
attrOf (Att k v) = " {k}=\"{esc v}\"".
attrOf (ShowIf n) = " data-show=\"{n}\"".
attrOf (OnSet n v) = " data-set=\"{n}\" data-val=\"{v}\"".
attrOf (OnClick msg arg) = " data-click=\"{esc msg}\" data-arg=\"{arg}\"".
attrOf (OnBoth msg arg n v) = " data-click=\"{esc msg}\" data-arg=\"{arg}\" data-set=\"{n}\" data-val=\"{v}\"".
attrOf (OnSend msg lit) = " data-click=\"{esc msg}\" data-lit=\"{esc lit}\"".
attrOf (Input n) = " data-input=\"{n}\"".
attrOf (OnEnter msg arg) = " data-enter=\"{esc msg}\" data-arg=\"{arg}\"".
attrOf (OnFile msg) = " type=\"file\" data-file=\"{esc msg}\"".
# client state is not an attribute: it is collected into the element's
# x-data (`xdata`) instead.  `others` already skips it, so this clause is
# how the function stays total rather than depending on that one caller.
attrOf (Local n init) = "".
attrOf (Utilities _) = "".

# ---- CSS: only the classes this tree actually uses -------------------------
#
# A class is a utility from the table below, or one the APP defines as a
# value and passes to cssWith:
#
#   G.Style "pcard" [G.Width (G.Px 180), G.Height (G.Px 140)]
#
# An app style with a utility's name replaces it.  Any class, a utility or
# the app's, takes a breakpoint prefix:
#
#   narrow:col     `col` when the screen is at most 760px wide
#   wide:col       `col` when it is wider
#
# Prefixed rules are emitted after every plain one, inside their @media,
# so on their screen they win over the plain class they contradict.

# lengths and declarations: what an app style is made of
Len = Type (Px Int | Pct Int | Vh Int | Vw Int | Less Len Len | Auto).
Decl = Type (Width Len | Height Len | MinWidth Len | MinHeight Len
           | MaxWidth Len | MaxHeight Len | Basis Len
           | Display DisplayMode | Direction FlexDirection | Gap Len
           | Padding Len | PaddingX Len | PaddingY Len
           | PaddingTop Len | PaddingRight Len | PaddingBottom Len | PaddingLeft Len
           | Radius Len | FontSize Len | Foreground Colour | Background Colour
           | Margin Len | MarginX Len | MarginY Len
           | MarginTop Len | MarginRight Len | MarginBottom Len | MarginLeft Len
           | AlignItems Alignment | JustifyContent Justification | FlexWrap WrapMode
           | Overflow OverflowMode | OverflowX OverflowMode | OverflowY OverflowMode
           | WhiteSpace WhiteSpaceMode | PointerEvents PointerMode | ScrollbarWidth ScrollbarMode
           | Position PositionMode | Top Len | Right Len | Bottom Len | Left Len | ZIndex Int
           | Transform (List TransformOp) | Shadow Len Len Len Len Colour
           | Shadows (List ShadowPart) | DefineShadows ThemeToken (List ShadowPart)
           | BackgroundImages (List BackgroundImage) | DefineImage ThemeToken BackgroundImage
           | BackgroundAttachment Attachment | BackgroundRepeat RepeatMode
           | BorderWidth Len | BorderColour Colour | BorderStyle BorderMode | AlignSelf Alignment
           | Cursor CursorMode
           | ColourScheme ColourMode
           | FontFamily Typeface | FontWeight Int | LineHeight Int | WordWrap WordWrapMode
           | DefineColour ThemeToken Colour
           | Opacity Int
           | Prop String String).   # any other property: the escape hatch
Style = Type (Style String (List Decl)).

DisplayMode = Type (Block | InlineBlock | Flex | Grid | Hidden).
FlexDirection = Type (Row | Column).
Colour = Type (Rgb Int Int Int | Rgba Int Int Int Int | RgbaPercent Int Int Int Int | Transparent | CurrentColour | ThemeColour ThemeToken).
ShadowPart = Type (ShadowPart Len Len Len Len Colour).
GradientStop = Type (Stop Colour Len).
BackgroundImage = Type (LinearGradient Int (List GradientStop)
                      | RadialGradient Len Len Len Len (List GradientStop)).
Attachment = Type (FixedBackground | ScrollBackground).
RepeatMode = Type (NoRepeat | Repeat).
BorderMode = Type (SolidBorder | DashedBorder | NoBorder).
CursorMode = Type (PointerCursor | DefaultCursor).
ColourMode = Type (LightScheme | DarkScheme).
Alignment = Type (AlignStart | AlignCenter | AlignEnd | AlignStretch | AlignBaseline).
Justification = Type (JustifyStart | JustifyCenter | JustifyEnd | SpaceBetween | SpaceAround | SpaceEvenly).
WrapMode = Type (NoWrap | Wrap | WrapReverse).
OverflowMode = Type (OverflowAuto | OverflowHidden | OverflowScroll | OverflowVisible).
WhiteSpaceMode = Type (NormalSpace | NoWrapSpace | PreSpace | PreWrapSpace).
PointerMode = Type (PointerAuto | PointerNone).
ScrollbarMode = Type (ScrollbarAuto | ScrollbarThin | ScrollbarNone).
PositionMode = Type (Static | Relative | Absolute | Fixed | Sticky).
TransformOp = Type (TranslateX Len | TranslateY Len).
Typeface = Type (SystemFont | MonoFont | ReadingFont).
WordWrapMode = Type (WrapNormal | WrapAnywhere).
# Explicit inherited colour scopes. Tokens are fixed names, not arbitrary CSS.
ThemeToken = Type (Bg | Ink | Dim | Card | Panel | Line | NamedToken String).
Theme = { bg : Colour, ink : Colour, dim : Colour, card : Colour, panel : Colour, line : Colour }.
theme : Theme -> Attr .
theme colours = utilities [DefineColour Bg colours.bg, DefineColour Ink colours.ink,
  DefineColour Dim colours.dim, DefineColour Card colours.card,
  DefineColour Panel colours.panel, DefineColour Line colours.line].

# Local utility composition. Multiple Utilities attributes merge in attribute
# order, last declaration wins per property and condition. Shorthands expand
# BEFORE merging. No selector/class registry and no stylesheet-order conflicts.
# Prop remains available to legacy Style; local utilities deliberately refuse it.
Utility = Type (Base (List Decl) | Narrow (List Decl) | Wide (List Decl)
              | Hover (List Decl) | Focus (List Decl) | Disabled (List Decl)).
utilities : List Decl -> Attr .
utilities ds = Utilities [Base ds].
narrow : List Decl -> Attr .
narrow ds = Utilities [Narrow ds].
wide : List Decl -> Attr .
wide ds = Utilities [Wide ds].
hover : List Decl -> Attr .
hover ds = Utilities [Hover ds].
focus : List Decl -> Attr .
focus ds = Utilities [Focus ds].
disabled : List Decl -> Attr .
disabled ds = Utilities [Disabled ds].

Atom = Type (Atom Int String String).
localAtoms : List Attr -> List Atom .
localAtoms attrs = lastAtoms (collectAtoms attrs).
collectAtoms : unsafe List Attr -> List Atom .
collectAtoms Nil = Nil.
collectAtoms (Utilities us :: rest) = append (utilityAtoms us) (collectAtoms rest).
collectAtoms (_ :: rest) = collectAtoms rest.
utilityAtoms : unsafe List Utility -> List Atom .
utilityAtoms Nil = Nil.
utilityAtoms (u :: rest) = append (oneUtility u) (utilityAtoms rest).
oneUtility (Base ds) = declarations 0 ds.
oneUtility (Narrow ds) = declarations 1 ds.
oneUtility (Wide ds) = declarations 2 ds.
oneUtility (Hover ds) = declarations 3 ds.
oneUtility (Focus ds) = declarations 4 ds.
oneUtility (Disabled ds) = declarations 5 ds.
declarations : unsafe Int -> List Decl -> List Atom .
declarations scope Nil = Nil.
declarations scope (d :: rest) = append (declaration scope d) (declarations scope rest).
declaration scope (Padding l) = declarations scope [PaddingTop l, PaddingRight l, PaddingBottom l, PaddingLeft l].
declaration scope (PaddingX l) = declarations scope [PaddingLeft l, PaddingRight l].
declaration scope (PaddingY l) = declarations scope [PaddingTop l, PaddingBottom l].
declaration scope (Margin l) = declarations scope [MarginTop l, MarginRight l, MarginBottom l, MarginLeft l].
declaration scope (MarginX l) = declarations scope [MarginLeft l, MarginRight l].
declaration scope (MarginY l) = declarations scope [MarginTop l, MarginBottom l].
declaration scope (Overflow mode) = declarations scope [OverflowX mode, OverflowY mode].
declaration scope (Prop _ _) = error "View.utilities: Prop is a legacy escape hatch; use typed declarations".
declaration scope d =
  css = declCss d;
  [Atom scope (substr css 0 (strIndexOf ":" css)) css].
lastAtoms : unsafe List Atom -> List Atom .
lastAtoms Nil = Nil.
lastAtoms (Atom scope property css :: rest) =
  if hasAtom scope property rest then lastAtoms rest
  else Atom scope property css :: lastAtoms rest.
hasAtom : unsafe Int -> String -> List Atom -> Bool .
hasAtom scope property Nil = False.
hasAtom scope property (Atom s p _ :: rest) = (scope == s and property == p) or hasAtom scope property rest.
# Encoding the declaration is collision-free, deterministic and CSS-safe. The
# class carries enough information for cached Fragment classes to emit CSS too.
atomClass (Atom scope _ css) = "fpr-u-{scope}-{Encoding.hex css}".
atomClasses : unsafe List Atom -> String .
atomClasses Nil = "".
atomClasses (a :: rest) = joinSp (atomClass a) (atomClasses rest).
atomNames : unsafe List Atom -> List String .
atomNames Nil = Nil.
atomNames (a :: rest) = atomClass a :: atomNames rest.

# Fixed precedence: base, viewport, hover, focus, disabled. State rules share
# specificity, so disabled wins even when focus and hover are also active.
localCss cs = localStages 0 cs.
localStages : unsafe Int -> List String -> String .
localStages scope cs = if scope > 5 then "" else strcat (localStage scope cs) (localStages (scope + 1) cs).
localStage : unsafe Int -> List String -> String .
localStage scope Nil = "".
localStage scope (c :: rest) = strcat (localRule scope c) (localStage scope rest).
localRule scope c = if hasPrefix "fpr-u-{scope}-" c then
    case Encoding.fromHex (substr c 8 (strlen c)) of
        Err _ -> ""
      | Ok css -> (case scope of
          0 -> rule1 ".{c}" css
        | 1 -> wrapMedia "(max-width:760px)" (rule1 ".{c}" css)
        | 2 -> wrapMedia "(min-width:761px)" (rule1 ".{c}" css)
        | 3 -> rule1 ".{c}:hover" css
        | 4 -> rule1 ".{c}:focus-visible" css
        | _ -> rule1 ".{c}:disabled" css)
  else "".

cssFor tree = cssWith Nil tree.

cssWith : List Style -> Node -> String .
cssWith styles tree =
  cs = nub (allClasses tree Nil);
  strcat cssBase (strcat (rules styles cs)
    (strcat (media styles "narrow" "(max-width:760px)" cs)
      (strcat (media styles "wide" "(min-width:761px)" cs) (localCss cs)))).

rules : unsafe List Style -> List String -> String .
rules styles Nil = "".
rules styles (c :: r) = strcat (strcat (rule1 ".{c}" (declsOf styles c)) (cssExtra c)) (rules styles r).
rule1 sel "" = "".
rule1 sel d = "{sel}\{{d}}\n".

# the breakpoint's rules: every `name:` class in the tree, as its base class
media : unsafe List Style -> String -> String -> List String -> String .
media styles name query cs = wrapMedia query (mediaGo styles name cs "").
wrapMedia q "" = "".
wrapMedia q body = "@media {q}\{\n{body}}\n".
mediaGo : unsafe List Style -> String -> List String -> String -> String .
mediaGo styles name Nil acc = acc.
mediaGo styles name (c :: r) acc | hasPrefix "{name}:" c = mediaGo styles name r (strcat acc (mediaRule styles name (dropPrefix (strlen name + 1) c))).
mediaGo styles name (c :: r) acc = mediaGo styles name r acc.
mediaRule styles name base = rule1 ".{name}\\:{base}" (declsOf styles base).
hasPrefix : unsafe String -> String -> Bool .
hasPrefix pre s = and2 (strlen s > strlen pre) (strEq (substr s 0 (strlen pre)) pre).
dropPrefix : unsafe Int -> String -> String .
dropPrefix n s = substr s n (strlen s - n).

# a class's declarations: the app's style of that name, else the utility's
declsOf : unsafe List Style -> String -> String .
declsOf Nil c = cssRule c.
declsOf (Style n ds :: r) c | strEq n c = declsCss ds.
declsOf (st :: r) c = declsOf r c.

declsCss : unsafe List Decl -> String .
declsCss Nil = "".
declsCss (d :: Nil) = declCss d.
declsCss (d :: r) = "{declCss d};{declsCss r}".
declCss : unsafe Decl -> String .
declCss (Width l) = "width:{lenCss l}".
declCss (Height l) = "height:{lenCss l}".
declCss (MinWidth l) = "min-width:{lenCss l}".
declCss (MinHeight l) = "min-height:{lenCss l}".
declCss (MaxWidth l) = "max-width:{lenCss l}".
declCss (MaxHeight l) = "max-height:{lenCss l}".
declCss (Basis l) = "flex-basis:{lenCss l}".
declCss (Display mode) = "display:{displayCss mode}".
declCss (Direction direction) = "flex-direction:{directionCss direction}".
declCss (Gap l) = "gap:{lenCss l}".
declCss (Padding l) = "padding:{lenCss l}".
declCss (PaddingX l) = "padding-left:{lenCss l};padding-right:{lenCss l}".
declCss (PaddingY l) = "padding-top:{lenCss l};padding-bottom:{lenCss l}".
declCss (PaddingTop l) = "padding-top:{lenCss l}".
declCss (PaddingRight l) = "padding-right:{lenCss l}".
declCss (PaddingBottom l) = "padding-bottom:{lenCss l}".
declCss (PaddingLeft l) = "padding-left:{lenCss l}".
declCss (Radius l) = "border-radius:{lenCss l}".
declCss (FontSize l) = "font-size:{lenCss l}".
declCss (Foreground colour) = "color:{colourCss colour}".
declCss (Background colour) = "background-color:{colourCss colour}".
declCss (Margin l) = "margin:{lenCss l}".
declCss (MarginX l) = "margin-left:{lenCss l};margin-right:{lenCss l}".
declCss (MarginY l) = "margin-top:{lenCss l};margin-bottom:{lenCss l}".
declCss (MarginTop l) = "margin-top:{lenCss l}".
declCss (MarginRight l) = "margin-right:{lenCss l}".
declCss (MarginBottom l) = "margin-bottom:{lenCss l}".
declCss (MarginLeft l) = "margin-left:{lenCss l}".
declCss (AlignItems value) = "align-items:{alignmentCss value}".
declCss (AlignSelf value) = "align-self:{alignmentCss value}".
declCss (JustifyContent value) = "justify-content:{justificationCss value}".
declCss (FlexWrap value) = "flex-wrap:{wrapCss value}".
declCss (Overflow value) = "overflow:{overflowCss value}".
declCss (OverflowX value) = "overflow-x:{overflowCss value}".
declCss (OverflowY value) = "overflow-y:{overflowCss value}".
declCss (WhiteSpace value) = "white-space:{whiteSpaceCss value}".
declCss (PointerEvents PointerAuto) = "pointer-events:auto".
declCss (PointerEvents PointerNone) = "pointer-events:none".
declCss (ScrollbarWidth ScrollbarAuto) = "scrollbar-width:auto".
declCss (ScrollbarWidth ScrollbarThin) = "scrollbar-width:thin".
declCss (ScrollbarWidth ScrollbarNone) = "scrollbar-width:none".
declCss (Position value) = "position:{positionCss value}".
declCss (Top l) = "top:{lenCss l}".
declCss (Right l) = "right:{lenCss l}".
declCss (Bottom l) = "bottom:{lenCss l}".
declCss (Left l) = "left:{lenCss l}".
declCss (ZIndex n) = "z-index:{n}".
declCss (Transform ops) = "transform:{transformCss ops}".
declCss (Shadow x y blur spread colour) = "box-shadow:{lenCss x} {lenCss y} {lenCss blur} {lenCss spread} {colourCss colour}".
declCss (Shadows parts) = "box-shadow:{shadowsCss parts}".
declCss (DefineShadows token parts) = "--{themeName token}:{shadowsCss parts}".
declCss (BackgroundImages images) = "background-image:{imagesCss images}".
declCss (DefineImage token image) = "--{themeName token}:{imageCss image}".
declCss (BackgroundAttachment FixedBackground) = "background-attachment:fixed".
declCss (BackgroundAttachment ScrollBackground) = "background-attachment:scroll".
declCss (BackgroundRepeat NoRepeat) = "background-repeat:no-repeat".
declCss (BackgroundRepeat Repeat) = "background-repeat:repeat".
declCss (BorderWidth l) = "border-width:{lenCss l}".
declCss (BorderColour colour) = "border-color:{colourCss colour}".
declCss (BorderStyle SolidBorder) = "border-style:solid".
declCss (BorderStyle DashedBorder) = "border-style:dashed".
declCss (BorderStyle NoBorder) = "border-style:none".
declCss (Cursor PointerCursor) = "cursor:pointer".
declCss (Cursor DefaultCursor) = "cursor:default".
declCss (ColourScheme LightScheme) = "color-scheme:light".
declCss (ColourScheme DarkScheme) = "color-scheme:dark".
declCss (FontFamily SystemFont) = "font-family:system-ui".
declCss (FontFamily MonoFont) = "font-family:ui-monospace,monospace".
declCss (FontFamily ReadingFont) = "font-family:'Archivo',system-ui,sans-serif".
declCss (FontWeight n) = if n >= 1 and n <= 1000 then "font-weight:{n}" else error "View.FontWeight: expected 1..1000".
declCss (LineHeight n) = if n >= 0 then "line-height:{n}%" else error "View.LineHeight: expected a nonnegative percentage".
declCss (WordWrap WrapNormal) = "overflow-wrap:normal".
declCss (WordWrap WrapAnywhere) = "overflow-wrap:anywhere".
declCss (DefineColour token colour) = "--{themeName token}:{colourCss colour}".
declCss (Opacity n) = if n >= 0 and n <= 100 then "opacity:{n}%" else error "View.Opacity: expected 0..100".
declCss (Prop p v) = "{p}:{v}".
displayCss Block = "block".
displayCss InlineBlock = "inline-block".
displayCss Flex = "flex".
displayCss Grid = "grid".
displayCss Hidden = "none".
directionCss Row = "row".
directionCss Column = "column".
colourCss (Rgb r g b) = if r >= 0 and r <= 255 and g >= 0 and g <= 255 and b >= 0 and b <= 255 then "rgb({r},{g},{b})" else error "View.Rgb: expected channels 0..255".
colourCss (Rgba r g b a) = if r >= 0 and r <= 255 and g >= 0 and g <= 255 and b >= 0 and b <= 255 and a >= 0 and a <= 255 then "#{Encoding.hexInt 2 r}{Encoding.hexInt 2 g}{Encoding.hexInt 2 b}{Encoding.hexInt 2 a}" else error "View.Rgba: expected channels 0..255".
colourCss (RgbaPercent r g b a) = if r >= 0 and r <= 255 and g >= 0 and g <= 255 and b >= 0 and b <= 255 and a >= 0 and a <= 100 then "rgba({r},{g},{b},{a}%)" else error "View.RgbaPercent: expected RGB 0..255 and alpha 0..100".
colourCss Transparent = "transparent".
colourCss CurrentColour = "currentColor".
colourCss (ThemeColour token) = "var(--{themeName token})".
themeName Bg = "bg".
themeName Ink = "ink".
themeName Dim = "dim".
themeName Card = "card".
themeName Panel = "panel".
themeName Line = "line".
themeName (NamedToken name) = if validToken name then name else error "View.NamedToken: expected a lowercase letter followed by lowercase letters, digits or hyphens".
validToken name = if strlen name == 0 then False else charAt name 0 >= 97 and charAt name 0 <= 122 and tokenTail name 1.
tokenTail : unsafe String -> Int -> Bool .
tokenTail name i = if i >= strlen name then True else
  c = charAt name i;
  ((c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45) and tokenTail name (i + 1).
shadowsCss Nil = "none".
shadowsCss parts = strJoin "," (shadowParts parts).
shadowParts : unsafe List ShadowPart -> List String .
shadowParts Nil = Nil.
shadowParts (ShadowPart x y blur spread colour :: rest) =
  "{lenCss x} {lenCss y} {lenCss blur} {lenCss spread} {colourCss colour}" :: shadowParts rest.
imagesCss Nil = "none".
imagesCss images = strJoin "," (imageParts images).
imageParts : unsafe List BackgroundImage -> List String .
imageParts Nil = Nil.
imageParts (image :: rest) = imageCss image :: imageParts rest.
imageCss (LinearGradient degrees stops) = "linear-gradient({degrees}deg,{stopsCss stops})".
imageCss (RadialGradient x y atX atY stops) = "radial-gradient({lenCss x} {lenCss y} at {lenCss atX} {lenCss atY},{stopsCss stops})".
stopsCss stops = case stops of
    _ :: _ :: _ -> strJoin "," (stopParts stops)
  | _ -> error "View.gradient: expected at least two stops".
stopParts : unsafe List GradientStop -> List String .
stopParts Nil = Nil.
stopParts (Stop colour at :: rest) = "{colourCss colour} {lenCss at}" :: stopParts rest.
alignmentCss AlignStart = "flex-start".
alignmentCss AlignCenter = "center".
alignmentCss AlignEnd = "flex-end".
alignmentCss AlignStretch = "stretch".
alignmentCss AlignBaseline = "baseline".
justificationCss JustifyStart = "flex-start".
justificationCss JustifyCenter = "center".
justificationCss JustifyEnd = "flex-end".
justificationCss SpaceBetween = "space-between".
justificationCss SpaceAround = "space-around".
justificationCss SpaceEvenly = "space-evenly".
wrapCss NoWrap = "nowrap".
wrapCss Wrap = "wrap".
wrapCss WrapReverse = "wrap-reverse".
overflowCss OverflowAuto = "auto".
overflowCss OverflowHidden = "hidden".
overflowCss OverflowScroll = "scroll".
overflowCss OverflowVisible = "visible".
whiteSpaceCss NormalSpace = "normal".
whiteSpaceCss NoWrapSpace = "nowrap".
whiteSpaceCss PreSpace = "pre".
whiteSpaceCss PreWrapSpace = "pre-wrap".
positionCss Static = "static".
positionCss Relative = "relative".
positionCss Absolute = "absolute".
positionCss Fixed = "fixed".
positionCss Sticky = "sticky".
transformCss Nil = "none".
transformCss ops = transformOps ops.
transformOps : unsafe List TransformOp -> String .
transformOps Nil = "".
transformOps (TranslateX l :: rest) = joinSp "translateX({lenCss l})" (transformOps rest).
transformOps (TranslateY l :: rest) = joinSp "translateY({lenCss l})" (transformOps rest).
lenCss : unsafe Len -> String .
lenCss (Px n) = "{n}px".
lenCss (Pct n) = "{n}%".
lenCss (Vh n) = "{n}vh".
lenCss (Vw n) = "{n}vw".
lenCss (Less a b) = "calc({lenCss a} - {lenCss b})".
lenCss Auto = "auto".

# what a utility needs beyond its own rule (the page around it, a state)
cssExtra "screen" = "body:has(.screen)\{overflow:hidden}\n".
cssExtra "hide-empty" = ".hide-empty:has(>[data-slot]:empty)\{display:none}\n".
cssExtra c = "".

allClasses : unsafe Node -> List String -> List String .
allClasses (El tag attrs kids) acc = allKids kids (append (atomNames (localAtoms attrs)) (attrCls attrs acc)).
allClasses (Fragment _ _ classes) acc = append classes acc.
allClasses (Inp attrs) acc = append (atomNames (localAtoms attrs)) (attrCls attrs acc).
allClasses n acc = acc.
allKids : unsafe List Node -> List String -> List String .
allKids Nil acc = acc.
allKids (k :: r) acc = allKids r (allClasses k acc).
attrCls : unsafe List Attr -> List String -> List String .
attrCls Nil acc = acc.
attrCls (Cls s :: r) acc = attrCls r (append (splitSp s) acc).
attrCls (a :: r) acc = attrCls r acc.

# the utility table. Adding a rule here makes a class available to the
# whole app; using one anywhere in the tree is what emits it.
cssRule "row" = "display:flex;flex-direction:row".
cssRule "col" = "display:flex;flex-direction:column".
cssRule "wrap" = "flex-wrap:wrap".
cssRule "center" = "align-items:center".
cssRule "between" = "justify-content:space-between".
cssRule "grow" = "flex:1".
cssRule "gap-1" = "gap:4px".
cssRule "gap-2" = "gap:8px".
cssRule "gap-3" = "gap:12px".
cssRule "gap-4" = "gap:18px".
cssRule "gap-6" = "gap:28px".
cssRule "p-2" = "padding:8px".
cssRule "p-3" = "padding:12px".
cssRule "p-4" = "padding:18px".
cssRule "p-6" = "padding:26px".
cssRule "px-3" = "padding-left:12px;padding-right:12px".
cssRule "py-2" = "padding-top:8px;padding-bottom:8px".
cssRule "mt-2" = "margin-top:8px".
cssRule "mt-4" = "margin-top:18px".
cssRule "mb-2" = "margin-bottom:8px".
cssRule "mb-4" = "margin-bottom:18px".
cssRule "text-xs" = "font-size:11px".
cssRule "text-sm" = "font-size:13px".
cssRule "text-lg" = "font-size:18px".
cssRule "text-2xl" = "font-size:30px".
cssRule "text-4xl" = "font-size:46px".
cssRule "bold" = "font-weight:700".
cssRule "mono" = "font-family:ui-monospace,'SF Mono',Menlo,monospace".
cssRule "upper" = "text-transform:uppercase;letter-spacing:.18em".
cssRule "dim" = "color:var(--dim)".
cssRule "ink" = "color:var(--ink)".
cssRule "acc" = "color:#57e2d2".
cssRule "warm" = "color:#ff8a5c".
cssRule "panel" = "background:var(--panel);border:1px solid var(--line)".
cssRule "card" = "background:var(--card);border:1px solid var(--line)".
cssRule "round" = "border-radius:14px".
cssRule "pill" = "border-radius:999px".
cssRule "btn" = "cursor:pointer;border:1px solid var(--line);background:var(--card);color:var(--dim);transition:.15s".
cssRule "glow" = "box-shadow:0 0 24px rgba(87,226,210,.22)".
cssRule "rule" = "border-top:1px solid var(--line)".
cssRule "big" = "font-size:64px;line-height:1".
cssRule "tabular" = "font-variant-numeric:tabular-nums".
cssRule "field" = "background:var(--card);border:1px solid var(--line);color:var(--ink);padding:8px 12px;border-radius:10px;font:inherit;outline:none".
cssRule "w-full" = "width:100%".
cssRule "pre" = "white-space:pre-wrap".
# roles: a badge takes a role, never a colour (red / amber / green carry
# meaning only); palette tokens are inherited from an explicit page scope
cssRule "badge" = "display:inline-block;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line);color:var(--dim)".
cssRule "bad" = "background:#3a1220;border-color:#7a2238;color:#ff7d95".
cssRule "warn" = "background:#3a2a10;border-color:#7a5a18;color:#ffc65c".
cssRule "ok" = "background:#0f3328;border-color:#1f6b50;color:#57e2a6".
cssRule "celebrate" = "background:#2a1a3a;border-color:#6b3f9a;color:#d9a6ff".
cssRule "toast" = "padding:10px 14px;border-radius:12px;border:1px solid var(--line);background:var(--panel)".
cssRule "scroll" = "max-height:52vh;overflow:auto".
cssRule "w-cart" = "width:400px;flex:none".
cssRule "w-40" = "width:40px".
cssRule "w-24" = "width:96px".
cssRule "right" = "text-align:right".
cssRule "tr" = "border-bottom:1px solid var(--line);padding:6px 0".
cssRule "page" = "max-width:1120px;margin:0 auto;width:100%".
cssRule "mx-auto" = "margin-left:auto;margin-right:auto".
cssRule "gap-5" = "gap:22px".
cssRule "p-5" = "padding:22px".
# layout: regions sized by the viewport, content scrolling inside them
cssRule "screen" = "height:100vh;height:100dvh;width:100vw;max-width:100vw;overflow:hidden".
cssRule "flex-auto" = "flex:1 1 auto".
cssRule "flex-none" = "flex:none".
cssRule "min-h-0" = "min-height:0".
cssRule "min-w-0" = "min-width:0".
cssRule "overflow-auto" = "overflow:auto".
cssRule "overflow-hidden" = "overflow:hidden".
cssRule "content-start" = "align-content:flex-start".
cssRule "justify-end" = "justify-content:flex-end".
cssRule "text-center" = "text-align:center".
cssRule "truncate" = "white-space:nowrap;overflow:hidden;text-overflow:ellipsis".
# an empty live slot hides its .toast / .pre (cssBase) unless the element
# says show-empty; hide-empty gives any element that behaviour (cssExtra)
cssRule "show-empty" = "".
cssRule "hide-empty" = "".
cssRule c = "".

cssBase = "*\{box-sizing:border-box;margin:0}
html\{min-height:100%}
body\{min-height:100vh;font:15px/1.55 'Archivo',system-ui,sans-serif}
a\{color:inherit}
.btn:hover\{color:var(--ink);border-color:var(--line)}
.btn.is-on\{background:var(--ink);color:var(--bg);border-color:var(--ink)}
[data-slot]\{transition:color .2s}
.lv-flash\{animation:lvf .55s ease-out}
.toast:not(.show-empty):has(>[data-slot]:empty),.pre:not(.show-empty):has(>[data-slot]:empty)\{display:none}
button\{font:inherit}
@keyframes lvf\{from\{color:#57e2d2;text-shadow:0 0 16px rgba(87,226,210,.9)}to\{color:inherit}}
".

# ---- delta: which dynamic slots changed ------------------------------------
# The whole point of the split, in five clauses.

deltaJson : unsafe List String -> List String -> String .
deltaJson old new = strcat "\{" (strcat (dGo old new 0 "") "}").
dGo : unsafe List String -> List String -> Int -> String -> String .
dGo Nil Nil i acc = acc.
dGo Nil ns i acc = acc.
dGo os Nil i acc = acc.
dGo (o :: os) (n :: ns) i acc | strEq o n = dGo os ns (i + 1) acc.
dGo (o :: os) (n :: ns) i acc = dGo os ns (i + 1) (join acc "\"{i}\":\"{jesc n}\"").

sameStatics : unsafe List String -> List String -> Bool .
sameStatics Nil Nil = True.
sameStatics Nil b = False.
sameStatics a Nil = False.
sameStatics (a :: as) (b :: bs) | strEq a b = sameStatics as bs.
sameStatics a b = False.

# statics + dynamics as JSON arrays (the first paint, and any reshape)
jarr : unsafe List String -> String .
jarr xs = strcat "[" (strcat (jaGo xs "") "]").
jaGo : unsafe List String -> String -> String .
jaGo Nil acc = acc.
jaGo (s :: r) acc = jaGo r (join acc "\"{jesc s}\"").
join "" x = x.
join acc x = strcat acc (strcat "," x).
join2 "" x = x.
join2 acc x = strcat acc (strcat ";" x).

# ---- string helpers --------------------------------------------------------

esc : unsafe String -> String .
esc s = escGo s 0 (strlen s) "".
escGo : unsafe String -> Int -> Int -> String -> String .
escGo s i n acc | i >= n = acc.
escGo s i n acc = escGo s (i + 1) n (strcat acc (escCh (charAt s i))).
escCh 38 = "&amp;".
escCh 60 = "&lt;".
escCh 62 = "&gt;".
escCh 34 = "&quot;".
escCh c = chr c.

# runs of plain bytes are copied whole (substr), so a long dynamic -- a
# receipt log -- costs garbage proportional to its escapes, not its length
jesc : unsafe String -> String .
jesc s = strJoin "" (rev (jGo s 0 0 (strlen s) Nil)).
jGo : unsafe String -> Int -> Int -> Int -> List String -> List String .
jGo s st i n acc | i >= n = jRunTo s st i acc.
jGo s st i n acc | jPlain (charAt s i) = jGo s st (i + 1) n acc.
jGo s st i n acc = jGo s (i + 1) (i + 1) n (jCh (charAt s i) :: jRunTo s st i acc).
jRunTo s st i acc | i > st = substr s st (i - st) :: acc.
jRunTo s st i acc = acc.
jPlain c = and2 (c >= 32) (and2 (c != 34) (c != 92)).
jCh 34 = "\\\"".
jCh 92 = "\\\\".
jCh 10 = "\\n".
jCh 13 = "".
jCh c = " ".

strEq a b = a == b.
and2 a b = a and b.

splitSp : unsafe String -> List String .
splitSp s = spGo s 0 (strlen s) "" Nil.
spGo : unsafe String -> Int -> Int -> String -> List String -> List String .
spGo s i n cur acc | i >= n = revAdd cur acc.
spGo s i n cur acc | charAt s i == 32 = spGo s (i + 1) n "" (revAdd cur acc).
spGo s i n cur acc = spGo s (i + 1) n (strcat cur (chr (charAt s i))) acc.
revAdd "" acc = acc.
revAdd cur acc = cur :: acc.

nub : unsafe List String -> List String .
nub Nil = Nil.
nub (x :: r) | memS x r = nub r.
nub (x :: r) = x :: nub r.
memS : unsafe String -> List String -> Bool .
memS x Nil = False.
memS x (y :: r) | strEq x y = True.
memS x (y :: r) = memS x r.

append : unsafe List a -> List a -> List a .
append xs ys = case xs of Nil -> ys | x :: r -> x :: append r ys.
rev : unsafe List t84 -> List t84 .
rev l = rvGo l Nil.
rvGo : unsafe List o84 -> List o84 -> List o84 .
rvGo Nil acc = acc.
rvGo (x :: r) acc = rvGo r (x :: acc).

# ---- TYPED events and client state: no names in strings ----------------------------------------
# The attributes above take a message NAME and a local's NAME, as text; a typo
# in either is a silent no-op.  These take the app's own values instead:
#
#   a MESSAGE is a value of the app's Msg type, put on the wire by the codec the
#   compiler mints from the type's declaration (`@Msg`: FPRISC.hs codecFor):
#
#       V.send codec (Bump 10)                  a complete message
#       V.sendWith codec (Add "") @Client.draft  its LAST field comes from client
#                                                state when the event fires
#
#   CLIENT STATE is a field of a declared record, named by a path literal
#   (`@Client.tab`), so a field that does not exist is a COMPILE error:
#
#       V.locals @Client { tab = "1", draft = "" }     declare them, with initial values
#       V.showIf @Client.tab "2"   V.setTo @Client.tab "2"   V.bind @Client.draft
#
# On the wire a typed message is "=" or "+" and the JSON of its Wire form, the
# array [name, field, ...] (fields may be records and lists):
# "=" is complete, "+" takes the event's argument as its final field.
# (std/live.fpr decodes it with the same codec; anything else is refused.)

J = use "json".

wire : { enc : m -> Wire | r } -> m -> String .
wire codec msg = strcat "=" (J.render (J.fromWire (codec.enc msg))).

# the message without its LAST field, which the event will supply
wireOpen : { enc : m -> Wire | r } -> m -> String .
wireOpen codec msg = strcat "+" (J.render (J.fromWire (case codec.enc msg of WCon n as -> WCon n (dropLast as) | w -> w))).

dropLast : unsafe List a -> List a .
dropLast xs = case xs of Nil -> Nil | x :: Nil -> Nil | x :: r -> x :: dropLast r.

# the local's name a path stands for: @Client.ui.tab -> "ui_tab"
localName : { segs : List String | r } -> String .
localName path = strJoin "_" path.segs.

send : { enc : m -> Wire | r } -> m -> Attr .
send codec msg = OnSend (wire codec msg) "".

sendWith : { enc : m -> Wire | r } -> m -> { segs : List String | q } -> Attr .
sendWith codec msg path = OnClick (wireOpen codec msg) (localName path).

enterWith : { enc : m -> Wire | r } -> m -> { segs : List String | q } -> Attr .
enterWith codec msg path = OnEnter (wireOpen codec msg) (localName path).

# on an `Inp`: a file picker.  The chosen file arrives as the message's LAST
# field, "name:base64" -- `View.uploadWith codec (Uploaded "")`, and
# `Encoding.fromBase64` on the part after the first ":".
uploadWith : { enc : m -> Wire | r } -> m -> Attr .
uploadWith codec msg = OnFile (wireOpen codec msg).

showIf : { segs : List String | r } -> String -> Attr .
showIf path value = ShowIf "{localName path}:{value}".

setTo : { segs : List String | r } -> String -> Attr .
setTo path value = OnSet (localName path) value.

bind : { segs : List String | r } -> Attr .
bind path = Input (localName path).

text : { segs : List String | r } -> Node .
text path = LTxt (localName path).

# every leaf of the client-state record, declared with its initial value: the
# bare literal `@Client` is its schema (docs/2026-08-27-PATHS.md)
locals : List { path : String, get : c -> String | r } -> c -> List Attr .
locals schema init = localsGo schema init.
localsGo : unsafe List { path : String, get : c -> String | r } -> c -> List Attr .
localsGo schema init = case schema of
    Nil -> Nil
  | e :: rest -> Local (dots e.path 0 Nil) (e.get init) :: localsGo rest init.
# "ui.tab" -> "ui_tab", the spelling localName gives
dots : unsafe String -> Int -> List String -> String .
dots p i acc = case i >= strlen p of
    True -> strJoin "" (rev acc)
  | False -> dots p (i + 1) ((case charAt p i == 46 of True -> "_" | False -> chr (charAt p i)) :: acc).

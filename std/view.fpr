cssRule "field" = declsCss [Background (ThemeColour (Card)), BorderWidth (Px 1), BorderStyle SolidBorder, BorderColour (ThemeColour (Line)), Foreground (ThemeColour (Ink)), PaddingY (Px 8), PaddingX (Px 12), Radius (Px 10), FontFamily InheritFont, FontSize Inherit, OutlineWidth (Px 0)].

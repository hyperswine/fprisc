# std/dir.fpr -- Directory: listing, walking, creating, removing.
#
#   Dir = use "std/dir".
#   Dir.walk "src" |> Result.map (List.filter (Path.hasExtension "fpr"))
#
# Listings are SORTED by name: the same directory gives the same list on every
# run and every file system.  Errors are the system's own words.

OS = use "osfs".
P = use "path".
S = use "string".

rev : unsafe List a -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# the names in a directory (not paths), sorted; no "." or ".."
list : String -> Result (List String) String .
list dir = OS.listDir dir.

# the same, as paths: Dir.entries "src" = ["src/a.fpr", "src/lib", ...]
entries : String -> Result (List String) String .
entries dir = case OS.listDir dir of
    Err e -> Err e
  | Ok names -> Ok (prefixGo dir names Nil).
prefixGo : unsafe String -> List String -> List String -> List String .
prefixGo dir names acc = case names of Nil -> rev acc Nil | n :: r -> prefixGo dir r (P.join dir n :: acc).

# every FILE under a directory, depth first, sorted within each directory.
# A directory that cannot be read ends the walk with its error.
walk : String -> Result (List String) String .
walk dir = case walkGo (dir :: Nil) Nil of Ok fs -> Ok (rev fs Nil) | Err e -> Err e.
# `todo` is a stack of paths still to visit; `acc` the files found, newest first
walkGo : unsafe List String -> List String -> Result (List String) String .
walkGo todo acc = case todo of
    Nil -> Ok acc
  | p :: rest -> (case OS.stat p of
        Err e -> Err (strJoin ": " (p :: e :: Nil))
      | Ok (kind, _, _) -> (case kind == 1 of
            False -> walkGo rest (p :: acc)
          | True -> (case entries p of
                Err e -> Err (strJoin ": " (p :: e :: Nil))
              | Ok children -> walkGo (pushAll children rest) acc))).
# children in front of the rest, keeping their order
pushAll : List String -> List String -> List String .
pushAll children rest = rev (rev children Nil) rest.

# a name against a pattern where "*" is any run of bytes and "?" any one:
#   Dir.matches "*.fpr" "list.fpr"
matches : String -> String -> Bool .
matches pat name = matchGo pat 1 name 1.
matchGo : unsafe String -> Int -> String -> Int -> Bool .
matchGo pat i name j = case i > strlen pat of
    True -> j > strlen name
  | False -> (case charAt pat i == 42 of
        True -> starGo pat (i + 1) name j
      | False -> (case j > strlen name of
            True -> False
          | False -> (case charAt pat i == 63 of
                True -> matchGo pat (i + 1) name (j + 1)
              | False -> (case charAt pat i == charAt name j of
                    True -> matchGo pat (i + 1) name (j + 1)
                  | False -> False)))).
# "*" tries every suffix of the name, shortest skip first
starGo : unsafe String -> Int -> String -> Int -> Bool .
starGo pat i name j = case matchGo pat i name j of
    True -> True
  | False -> (case j > strlen name of True -> False | False -> starGo pat i name (j + 1)).

# the entries of ONE directory whose NAME matches: Dir.glob "*.md" "docs"
glob : String -> String -> Result (List String) String .
glob pat dir = case OS.listDir dir of
    Err e -> Err e
  | Ok names -> Ok (globGo pat dir names Nil).
globGo : unsafe String -> String -> List String -> List String -> List String .
globGo pat dir names acc = case names of
    Nil -> rev acc Nil
  | n :: r -> (case matches pat n of True -> globGo pat dir r (P.join dir n :: acc) | False -> globGo pat dir r acc).

# the directory and every missing parent; existing is fine
create : String -> Result Unit String .
create dir = createGo (P.parts dir) (case P.isAbsolute dir of True -> "/" | False -> "").
createGo : unsafe List String -> String -> Result Unit String .
createGo ps sofar = case ps of
    Nil -> Ok Unit
  | p :: r -> (case OS.mkdir (P.join sofar p) of
        Err e -> Err (strJoin ": " (P.join sofar p :: e :: Nil))
      | Ok _ -> createGo r (P.join sofar p)).

# an EMPTY directory
remove : String -> Result Unit String .
remove dir = OS.remove dir.

# a directory and everything in it.  Asked for by this name on purpose.
removeAll : String -> Result Unit String .
removeAll dir = case OS.stat dir of
    Err e -> Err e
  | Ok (kind, _, _) -> (case kind == 1 of
        False -> OS.remove dir
      | True -> (case entries dir of
            Err e -> Err e
          | Ok children -> (case removeEach children of Err e -> Err e | Ok _ -> OS.remove dir))).
removeEach : unsafe List String -> Result Unit String .
removeEach ps = case ps of
    Nil -> Ok Unit
  | p :: r -> (case removeAll p of Err e -> Err e | Ok _ -> removeEach r).

current : Unit -> String .
current u = OS.cwd u.

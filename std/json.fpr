# Profile boundary: this implementation constructs UTF-8 byte strings.
# Hosted Sol uses Unicode code-point Strings: use sol/lib/json.sol there.
# Importing this module in Sol does not establish Unicode compatibility.
# std/json.fpr -- JSON: text to a Value and back (ExtBase).
#
#   Json = use "std/json".
#   case Json.parse text of
#       Ok v -> Json.at ("server" :: "port" :: Nil) v |> Option.andThen Json.asInt
#     | Err why -> ...                     # "line 3, column 14: expected ':'"
#
# `Value` is the design's flexible-data type: what external data is before you
# decode it into your own records.  An Object is a Map, so its keys iterate in
# order and `render` is deterministic: the same value is always the same text.
#
# Numbers: an integer literal is an `Integer`; anything with a fraction or an
# exponent is kept as `Real` with its TEXT (no float parsing to get wrong --
# `asReal` hands you the text to convert when you need arithmetic).  An
# integer literal an Int cannot hold EXACTLY (past 62 bits, or "-0") is kept as
# `Real` with its text too: it used to wrap silently, so parse then render
# turned 12345678901234567890 into 3122306864379792082.  What is parsed is
# rendered as it was written, or it is not parsed as an Integer.
# Strings: every escape is decoded, \uXXXX (and surrogate pairs) to UTF-8.

M = use "map".
O = use "option".
S = use "string".

Value = Type (Null | Boolean Bool | Integer Int | Real String | Text String | Sequence (List Value) | Object (M.Map String Value)).

rev : (xs : List a | measure xs) -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# ---- reading a Value -------------------------------------------------------------
asString : Value -> O.Option String .
asString v = case v of Text s -> O.Some s | _ -> O.None.

asInt : Value -> O.Option Int .
asInt v = case v of Integer n -> O.Some n | _ -> O.None.

asBool : Value -> O.Option Bool .
asBool v = case v of Boolean b -> O.Some b | _ -> O.None.

# a Real's digits, or an Integer's
asReal : Value -> O.Option String .
asReal v = case v of Real t -> O.Some t | Integer n -> O.Some (str n) | _ -> O.None.

asList : Value -> O.Option (List Value) .
asList v = case v of Sequence xs -> O.Some xs | _ -> O.None.

asObject : Value -> O.Option (M.Map String Value) .
asObject v = case v of Object m -> O.Some m | _ -> O.None.

isNull : Value -> Bool .
isNull v = case v of Null -> True | _ -> False.

# one key of an Object
field : String -> Value -> O.Option Value .
field k v = case v of Object m -> M.get k m | _ -> O.None.

# typed field accessors (subject Value last, for chaining with |>)
stringField : String -> Value -> O.Option String .
stringField k v = field k v |> O.andThen asString.

stringOr : String -> String -> Value -> String .
stringOr dflt k v = stringField k v |> O.withDefault dflt.

stringIs : String -> String -> Value -> Bool .
stringIs want k v = stringField k v == O.Some want.

intField : String -> Value -> O.Option Int .
intField k v = field k v |> O.andThen asInt.

intOr : Int -> String -> Value -> Int .
intOr dflt k v = intField k v |> O.withDefault dflt.

boolField : String -> Value -> O.Option Bool .
boolField k v = field k v |> O.andThen asBool.

boolOr : Bool -> String -> Value -> Bool .
boolOr dflt k v = boolField k v |> O.withDefault dflt.

listField : String -> Value -> O.Option (List Value) .
listField k v = field k v |> O.andThen asList.

objectField : String -> Value -> O.Option (M.Map String Value) .
objectField k v = field k v |> O.andThen asObject.

stringListField : String -> Value -> List String .
stringListField k v = case listField k v of
    O.Some xs -> filterStrings xs Nil
  | O.None -> Nil.
filterStrings : (xs : List Value | measure xs) -> List String -> List String .
filterStrings xs acc = case xs of
    Nil -> rev acc Nil
  | Text s :: r -> filterStrings r (s :: acc)
  | _ :: r -> filterStrings r acc.

# a path of keys: Json.at ("a" :: "b" :: Nil) v
at : (path : List String | measure path) -> Value -> O.Option Value .
at path v = case path of
    Nil -> O.Some v
  | k :: r -> (case field k v of O.None -> O.None | O.Some inner -> at r inner).

stringAt : List String -> Value -> O.Option String .
stringAt path v = at path v |> O.andThen asString.

intAt : List String -> Value -> O.Option Int .
intAt path v = at path v |> O.andThen asInt.

# the same JSON, whatever order an object's keys were written in (`==` would
# compare the Maps' trees: std/map.fpr)
equal : Value -> Value -> Bool .
equal a b = equalGo a b.
equalGo : unsafe Value -> Value -> Bool .
equalGo a b = case a of
    Object ma -> (case b of Object mb -> M.equalBy equalGo ma mb | _ -> False)
  | Sequence xs -> (case b of Sequence ys -> allEq xs ys | _ -> False)
  | _ -> a == b.
allEq : unsafe List Value -> List Value -> Bool .
allEq xs ys = case xs of
    Nil -> (case ys of Nil -> True | _ -> False)
  | x :: xr -> (case ys of Nil -> False | y :: yr -> if equalGo x y then allEq xr yr else False).

# ---- making a Value --------------------------------------------------------------
object : List (String, Value) -> Value .
object kvs = Object (M.fromList S.compare kvs).

strings : List String -> Value .
strings xs = Sequence (textsGo xs Nil).
textsGo : (xs : List String | measure xs) -> List Value -> List Value .
textsGo xs acc = case xs of Nil -> rev acc Nil | x :: r -> textsGo r (Text x :: acc).

# ---- rendering ---------------------------------------------------------------------
# compact, keys ascending
render : Value -> String .
render v = strJoin "" (rev (emit v Nil) Nil).

# pieces, newest first
emit : unsafe Value -> List String -> List String .
emit v acc = case v of
    Null -> "null" :: acc
  | Boolean b -> (if b then "true" else "false") :: acc
  | Integer n -> str n :: acc
  | Real t -> t :: acc
  | Text s -> quote s :: acc
  | Sequence xs -> "]" :: emitItems xs True ("[" :: acc)
  | Object m -> "\}" :: emitFields (M.entries m) True ("\{" :: acc).
emitItems : unsafe List Value -> Bool -> List String -> List String .
emitItems xs first acc = case xs of
    Nil -> acc
  | x :: r -> emitItems r False (emit x (if first then acc else "," :: acc)).
emitFields : unsafe List (String, Value) -> Bool -> List String -> List String .
emitFields kvs first acc = case kvs of
    Nil -> acc
  | (k, x) :: r -> emitFields r False (emit x (":" :: quote k :: (if first then acc else "," :: acc))).

# a JSON string literal: quotes, backslashes and control bytes escaped; UTF-8 passes
quote : String -> String .
quote s = strJoin "" ("\"" :: rev ("\"" :: quoteGo s 0 0 (strlen s) Nil) Nil).
# [from, i) is a clean run not yet emitted
quoteGo : String -> Int -> Int -> (rem : Int | measure rem) -> List String -> List String .
quoteGo s from i rem acc =
  if rem <= 0 then substr s from (i - from) :: acc
  else case escapeOf (charAt s i) of
      O.None -> quoteGo s from (i + 1) (rem - 1) acc
    | O.Some e -> quoteGo s (i + 1) (i + 1) (rem - 1) (e :: substr s from (i - from) :: acc).
escapeOf : Int -> O.Option String .
escapeOf c =
  if c == 34 then O.Some "\\\""
  else if c == 92 then O.Some "\\\\"
  else if c >= 32 then O.None
  else if c == 10 then O.Some "\\n"
  else if c == 9 then O.Some "\\t"
  else if c == 13 then O.Some "\\r"
  else O.Some (strcat "\\u00" (hex2 c)).
hex2 : Int -> String .
hex2 c = strcat (hexDigit (c / 16)) (hexDigit (c - (c / 16) * 16)).
hexDigit : Int -> String .
hexDigit d = chr (if d < 10 then 48 + d else 87 + d).

# ---- parsing -----------------------------------------------------------------------
# A parser step answers Ok (value, next position) or Err (position, what was
# expected); `parse` turns the position into a line and a column.
parse : String -> Result Value String .
parse s = case value s (skip s 0) of
    Err (at, why) -> Err (located s at why)
  | Ok (v, next) ->
      after = skip s next;
      if after >= strlen s then Ok v
      else Err (located s after "unexpected text after the value").

located : String -> Int -> String -> String .
located s at why = case lineCol s 0 at 1 1 of (l, c) -> "line {l}, column {c}: {why}".
lineCol : String -> Int -> (rem : Int | measure rem) -> Int -> Int -> (Int, Int) .
lineCol s i rem l c =
  if rem <= 0 then (l, c)
  else if charAt s i == 10 then lineCol s (i + 1) (rem - 1) (l + 1) 1
  else lineCol s (i + 1) (rem - 1) l (c + 1).

skip : String -> Int -> Int .
skip s i = skipGo s i (strlen s - i).
skipGo : String -> Int -> (rem : Int | measure rem) -> Int .
skipGo s i rem =
  if rem <= 0 then i
  else if S.isSpace (charAt s i) then skipGo s (i + 1) (rem - 1)
  else i.

value : unsafe String -> Int -> Result (Value, Int) (Int, String) .
value s i =
  if i >= strlen s then Err (i, "expected a value, found the end of the text")
  else valueAt s i (charAt s i).
valueAt : unsafe String -> Int -> Int -> Result (Value, Int) (Int, String) .
valueAt s i c =
  if c == 123 then members s (skip s (i + 1)) (M.empty S.compare)
  else if c == 91 then items s (skip s (i + 1)) Nil
  else if c == 34 then (case stringLit s (i + 1) of Ok (t, next) -> Ok (Text t, next) | Err e -> Err e)
  else case keyword s i of
      O.Some r -> Ok r
    | O.None -> number s i.

keyword : String -> Int -> O.Option (Value, Int) .
keyword s i =
  if substr s i 4 == "true" then O.Some (Boolean True, i + 4)
  else if substr s i 5 == "false" then O.Some (Boolean False, i + 5)
  else if substr s i 4 == "null" then O.Some (Null, i + 4)
  else O.None.

# after "[" (and whitespace): items until "]"
items : unsafe String -> Int -> List Value -> Result (Value, Int) (Int, String) .
items s i acc =
  if charAtOr s i == 93 then
    case acc of Nil -> Ok (Sequence Nil, i + 1) | _ -> Err (i, "expected a value after ','")
  else case value s i of
      Err e -> Err e
    | Ok (v, next) -> itemsSep s (skip s next) (v :: acc).
itemsSep : unsafe String -> Int -> List Value -> Result (Value, Int) (Int, String) .
itemsSep s i acc =
  if charAtOr s i == 44 then items s (skip s (i + 1)) acc
  else if charAtOr s i == 93 then Ok (Sequence (rev acc Nil), i + 1)
  else Err (i, "expected ',' or ']'").

# after "{": "key" : value pairs until "}".  A repeated key keeps the LAST.
members : unsafe String -> Int -> M.Map String Value -> Result (Value, Int) (Int, String) .
members s i m =
  if charAtOr s i == 125 then
    if M.isEmpty m then Ok (Object m, i + 1) else Err (i, "expected a key after ','")
  else if charAtOr s i != 34 then Err (i, "expected a string key")
  else case stringLit s (i + 1) of
      Err e -> Err e
    | Ok (k, next) -> memberValue s (skip s next) k m.
memberValue : unsafe String -> Int -> String -> M.Map String Value -> Result (Value, Int) (Int, String) .
memberValue s i k m =
  if charAtOr s i != 58 then Err (i, "expected ':'")
  else case value s (skip s (i + 1)) of
      Err e -> Err e
    | Ok (v, next) -> membersSep s (skip s next) (M.insert k v m).
membersSep : unsafe String -> Int -> M.Map String Value -> Result (Value, Int) (Int, String) .
membersSep s i m =
  if charAtOr s i == 44 then
    next = skip s (i + 1);
    if charAtOr s next == 125 then Err (next, "expected a key after ','")
    else members s next m
  else if charAtOr s i == 125 then Ok (Object m, i + 1)
  else Err (i, "expected ',' or '}'").

# 0 past the end, so comparisons just fail
charAtOr : String -> Int -> Int .
charAtOr s i = if i >= strlen s then 0 else charAt s i.

# ---- numbers ---------------------------------------------------------------------
number : String -> Int -> Result (Value, Int) (Int, String) .
number s i =
  j = if charAtOr s i == 45 then i + 1 else i;
  k = digits s j;
  if k == j then Err (i, "expected a value")
  else numberTail s i k.
numberTail : String -> Int -> Int -> Result (Value, Int) (Int, String) .
numberTail s i k =
  f = if charAtOr s k == 46 then digits s (k + 1) else k;
  e = expEnd s f;
  if e == k then
    raw = substr s i (k - i);
    case S.toInt raw of
        Ok n -> Ok (if str n == raw then Integer n else Real raw, k)
      | Err _ -> Ok (Real raw, k)
  else if f == k + 1 then Err (k, "expected digits after '.'")
  else Ok (Real (substr s i (e - i)), e).
digits : String -> Int -> Int .
digits s i = digitsGo s i (strlen s - i).
digitsGo : String -> Int -> (rem : Int | measure rem) -> Int .
digitsGo s i rem =
  if rem <= 0 then i
  else if S.isDigit (charAt s i) then digitsGo s (i + 1) (rem - 1)
  else i.
# past an exponent at i, or i itself
expEnd : String -> Int -> Int .
expEnd s i = if charAtOr s i == 101 or charAtOr s i == 69 then expDigits s i else i.
expDigits : String -> Int -> Int .
expDigits s i =
  c = charAtOr s (i + 1);
  j = if c == 43 or c == 45 then i + 2 else i + 1;
  k = digits s j;
  if k == j then i else k.

# ---- strings ---------------------------------------------------------------------
# `i` is just past the opening quote; answers the decoded text and the position
# past the closing quote
stringLit : String -> Int -> Result (String, Int) (Int, String) .
stringLit s i = stringGo s i i (strlen s - i) Nil.
# [from, i) is a clean run; acc the decoded pieces, newest first
stringGo : String -> Int -> Int -> (rem : Int | measure rem) -> List String -> Result (String, Int) (Int, String) .
stringGo s from i rem acc =
  if rem <= 0 then Err (i, "unterminated string")
  else
    c = charAt s i;
    if c == 34 then Ok (strJoin "" (rev (substr s from (i - from) :: acc) Nil), i + 1)
    else if c == 92 then
      acc1 = substr s from (i - from) :: acc;
      case decodeEscape s i of
          Err e -> Err e
        | Ok (t, step) ->
            if step == 2 then stringGo s (i + 2) (i + 2) (rem - 2) (t :: acc1)
            else if step == 6 then stringGo s (i + 6) (i + 6) (rem - 6) (t :: acc1)
            else stringGo s (i + 12) (i + 12) (rem - 12) (t :: acc1)
    else if c < 32 then Err (i, "a control character inside a string")
    else stringGo s from (i + 1) (rem - 1) acc.

# `i` is at the backslash; returns (decoded, bytesConsumed >= 2)
decodeEscape : String -> Int -> Result (String, Int) (Int, String) .
decodeEscape s i =
  c = charAtOr s (i + 1);
  if c == 117 then decodeUnicode s i
  else case simpleEscape c of
      O.None -> Err (i, "unknown escape")
    | O.Some t -> Ok (t, 2).
simpleEscape : Int -> O.Option String .
simpleEscape c =
  if c == 110 then O.Some "\n"
  else if c == 116 then O.Some "\t"
  else if c == 114 then O.Some "\r"
  else if c == 98 then O.Some (chr 8)
  else if c == 102 then O.Some (chr 12)
  else if c == 34 then O.Some "\""
  else if c == 92 then O.Some "\\"
  else if c == 47 then O.Some "/"
  else O.None.

# \uXXXX at i, possibly the first half of a surrogate pair
decodeUnicode : String -> Int -> Result (String, Int) (Int, String) .
decodeUnicode s i = case hex4 s (i + 2) of
    O.None -> Err (i, "expected four hex digits after \\u")
  | O.Some hi ->
      if hi < 55296 or hi > 56319 then Ok (utf8 hi, 6)
      else if substr s (i + 6) 2 != "\\u" then Err (i, "a lone surrogate")
      else case hex4 s (i + 8) of
          O.None -> Err (i + 6, "expected four hex digits after \\u")
        | O.Some lo -> Ok (utf8 (65536 + (hi - 55296) * 1024 + (lo - 56320)), 12).

hex4 : String -> Int -> O.Option Int .
hex4 s i = hexGo s i 4 0.
hexGo : String -> Int -> (n : Int | measure n) -> Int -> O.Option Int .
hexGo s i n acc =
  if n <= 0 then O.Some acc
  else case hexVal (charAtOr s i) of
      O.None -> O.None
    | O.Some d -> hexGo s (i + 1) (n - 1) (acc * 16 + d).
hexVal : Int -> O.Option Int .
hexVal c =
  if S.isDigit c then O.Some (c - 48)
  else if c >= 97 and c <= 102 then O.Some (c - 87)
  else if c >= 65 and c <= 70 then O.Some (c - 55)
  else O.None.

# a code point as UTF-8 bytes
utf8 : Int -> String .
utf8 cp =
  if cp < 128 then chr cp
  else if cp < 2048 then
    strJoin "" (chr (192 + cp / 64) :: chr (128 + (cp - (cp / 64) * 64)) :: Nil)
  else if cp < 65536 then
    strJoin "" (chr (224 + cp / 4096) :: chr (128 + (cp / 64 - (cp / 4096) * 64)) :: chr (128 + (cp - (cp / 64) * 64)) :: Nil)
  else
    strJoin "" (chr (240 + cp / 262144) :: chr (128 + (cp / 4096 - (cp / 262144) * 64)) :: chr (128 + (cp / 64 - (cp / 4096) * 64)) :: chr (128 + (cp - (cp / 64) * 64)) :: Nil).

# ---- Wire: what a compiler-minted codec speaks (the prelude's neutral tree) ---------------
# `@Msg` and `@Model.field` literals carry `enc : a -> Wire` and `dec : Wire ->
# Result a String`.  These two turn a Wire into a Value and back, so any such
# type is JSON with no hand-written encoder: a record is an object, a list an
# array, and a constructor the array [name, field, ...].
fromWire : Wire -> Value .
fromWire w = fromWireGo w.
fromWireGo : unsafe Wire -> Value .
fromWireGo w = case w of
    WInt n -> Integer n
  | WStr t -> Text t
  | WBool b -> Boolean b
  | WList xs -> Sequence (wiresGo xs Nil)
  | WRec fs -> Object (fieldsGo fs (M.empty S.compare))
  | WCon n as -> Sequence (Text n :: wiresGo as Nil).
wiresGo : unsafe List Wire -> List Value -> List Value .
wiresGo xs acc = case xs of Nil -> rev acc Nil | x :: r -> wiresGo r (fromWireGo x :: acc).
fieldsGo : unsafe List (String, Wire) -> M.Map String Value -> M.Map String Value .
fieldsGo fs m = case fs of Nil -> m | (k, v) :: r -> fieldsGo r (M.insert k (fromWireGo v) m).

# (a Real has no Wire form: it arrives as its text)
toWire : Value -> Wire .
toWire v = toWireGo v.
toWireGo : unsafe Value -> Wire .
toWireGo v = case v of
    Null -> WStr ""
  | Boolean b -> WBool b
  | Integer n -> WInt n
  | Real t -> WStr t
  | Text t -> WStr t
  | Sequence xs -> WList (valuesGo xs Nil)
  | Object m -> WRec (pairsGo (M.entries m) Nil).
valuesGo : unsafe List Value -> List Wire -> List Wire .
valuesGo xs acc = case xs of Nil -> rev acc Nil | x :: r -> valuesGo r (toWireGo x :: acc).
pairsGo : unsafe List (String, Value) -> List (String, Wire) -> List (String, Wire) .
pairsGo kvs acc = case kvs of Nil -> rev acc Nil | (k, x) :: r -> pairsGo r ((k, toWireGo x) :: acc).

# the TEXT a page holds for a value (std/view's client state): a number, true or
# false, a string as itself, a bare constructor by its name -- what the prelude's
# decoders read back -- and anything else as its JSON
wireText : Wire -> String .
wireText w = case w of
    WInt n -> str n
  | WStr t -> t
  | WBool b -> if b then "true" else "false"
  | WCon n Nil -> n
  | other -> render (fromWire other).

# text <-> any type with a codec: Json.encode codec value, Json.decode codec text
encode : { enc : a -> Wire | r } -> a -> String .
encode codec x = render (fromWire (codec.enc x)).

decode : { dec : Wire -> Result a String | r } -> String -> Result a String .
decode codec text = case parse text of Err why -> Err why | Ok v -> codec.dec (toWire v).

# std/http.fpr -- Http: a client and a server, HTTP/1.1 (ExtBase).
#
#   Http = use "std/http".
#   case Http.get "http://example.org/data.json" of
#       Ok r -> (case r.status == 200 of True -> Json.parse r.body | False -> Err "HTTP {r.status}")
#     | Err why -> Err why                 # it never got an answer
#
#   Http.serve listener (fn req -> case req.path == "/health" of
#       True -> Http.text 200 "ok" | False -> Http.text 404 "no such page")
#
# A Request is { method, path, query, headers, body }; a Response is
# { status, headers, body }.  Header NAMES are lower-case in both, because
# HTTP says their case means nothing: `Http.header "content-type" r`.
# A non-2xx status is an Ok response you inspect; Err means there was none.
#
# HTTP and HTTPS clients use checked native transports, with bounded DNS,
# absolute deadlines and strict header/body framing. HTTPS requires a linked
# TLS engine; missing support is an explicit error. Never falls back to tools.

TCP = use "tcp".
ST = use "stream".
S = use "string".
L = use "list".
O = use "option".
PL = use "poller".
T = use "transport".
TLS = use "tls".
E = use "encoding".

rev : unsafe List a -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# ---- headers ---------------------------------------------------------------------
# the first header of that (lower-case) name
header : String -> { headers : List (String, String) | r } -> O.Option String .
header name m = headerGo (S.toLower name) m.headers.
headerGo : unsafe String -> List (String, String) -> O.Option String .
headerGo name hs = case hs of
    Nil -> O.None
  | (k, v) :: r -> (case k == name of True -> O.Some v | False -> headerGo name r).

# "Name: value" lines -> pairs, names lower-cased; a line without ":" is dropped
parseHeaders : List String -> List (String, String) .
parseHeaders ls = parseHeadersGo ls Nil.
parseHeadersGo : unsafe List String -> List (String, String) -> List (String, String) .
parseHeadersGo ls acc = case ls of
    Nil -> rev acc Nil
  | l :: r ->
      at = strIndexOf ":" l;
      (case at < 0 of
          True -> parseHeadersGo r acc
        | False -> parseHeadersGo r ((S.toLower (S.trim (S.left at l)), S.trim (S.dropLeft (at + 1) l)) :: acc)).

renderHeaders : List (String, String) -> String .
renderHeaders hs = strJoin "" (renderHeadersGo hs Nil).
renderHeadersGo : unsafe List (String, String) -> List String -> List String .
renderHeadersGo hs acc = case hs of
    Nil -> rev acc Nil
  | (k, v) :: r -> renderHeadersGo r ("\r\n" :: v :: ": " :: k :: acc).

# ---- responses, for a server -------------------------------------------------------
response : Int -> String -> String -> { status : Int, headers : List (String, String), body : String } .
response status contentType body = { status = status, headers = ("content-type", contentType) :: Nil, body = body }.

text : Int -> String -> { status : Int, headers : List (String, String), body : String } .
text status body = response status "text/plain; charset=utf-8" body.

html : Int -> String -> { status : Int, headers : List (String, String), body : String } .
html status body = response status "text/html; charset=utf-8" body.

# the body is JSON TEXT (Json.render value)
json : Int -> String -> { status : Int, headers : List (String, String), body : String } .
json status body = response status "application/json" body.

reason : Int -> String .
reason status = case status of
    200 -> "OK" | 201 -> "Created" | 204 -> "No Content" | 301 -> "Moved Permanently" | 302 -> "Found"
  | 304 -> "Not Modified" | 400 -> "Bad Request" | 401 -> "Unauthorized" | 403 -> "Forbidden"
  | 404 -> "Not Found" | 405 -> "Method Not Allowed" | 408 -> "Request Timeout" | 409 -> "Conflict" | 413 -> "Content Too Large"
  | 431 -> "Request Header Fields Too Large"
  | 500 -> "Internal Server Error" | 503 -> "Service Unavailable" | _ -> "Status".

# ---- the server --------------------------------------------------------------------
limits : { header : Int, body : Int, readMs : Int } .
limits = { header = 65536, body = 1048576, readMs = 10000 }.

serve : TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serve listener handler = serveWith limits listener handler.
serveWith : { header : Int, body : Int, readMs : Int } -> TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serveWith lim listener handler = TCP.serve listener (fn conn peer -> answerWith lim (ST.reader conn) handler conn).

serveOn : PL.Poller -> TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serveOn p listener handler = serveOnWith limits p listener handler.
serveOnWith : { header : Int, body : Int, readMs : Int } -> PL.Poller -> TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serveOnWith lim p listener handler = TCP.serveOn p listener (fn conn peer -> answerWith lim (ST.readerOn p conn) handler conn).

answerWith lim rd handler conn = case serverRequestOn lim rd of
    Err why -> ST.write (renderResponse (text (refusedStatus why) "bad request: {why}\n")) conn
  | Ok req -> ST.write (renderResponse (handler req)) conn.

refusedStatus : String -> Int .
refusedStatus why = case S.startsWith "header: no separator" why of
    True -> 431
  | False -> (case S.startsWith "body: larger" why of
        True -> 413
      | False -> (case why == "header: timed out" or why == "body: timed out" of
            True -> 408
          | False -> 400)).

readRequest : ST.Stream -> Result { method : String, path : String, query : String, headers : List (String, String), body : String } String .
readRequest conn = serverRequestOn limits (ST.reader conn).
readRequestWith : { header : Int, body : Int, readMs : Int } -> ST.Stream -> Result { method : String, path : String, query : String, headers : List (String, String), body : String } String .
readRequestWith lim conn = serverRequestOn lim (ST.reader conn).
serverRequestOn lim rd = case ST.readUntilWithin lim.readMs lim.header "\r\n\r\n" rd of (res, r) ->
  (case res of
      Err why -> Err "header: {why}"
    | Ok head -> requestFrom lim (S.split "\r\n" head) r).

requestFrom lim ls r = case ls of
    Nil -> Err "empty request"
  | line :: hs -> (case S.split " " line of
        method :: target :: _ -> withBody lim method target (parseHeaders hs) r
      | _ -> Err "malformed request line").

withBody lim method target hs r =
  at = strIndexOf "?" target;
  path = (case at < 0 of True -> target | False -> S.left at target);
  query = (case at < 0 of True -> "" | False -> S.dropLeft (at + 1) target);
  case bodyLength hs of
    Err why -> Err why
  | Ok n -> (case n > lim.body of
        True -> Err "body: larger than {lim.body} bytes (content-length {n})"
      | False -> (case n == 0 of
            True -> Ok { method = method, path = path, query = query, headers = hs, body = "" }
          | False -> (case ST.readExactlyWithin lim.readMs n r of (res, _) ->
                (case res of
                    Ok body -> Ok { method = method, path = path, query = query, headers = hs, body = body }
                  | Err why -> Err "body: {why}")))).

bodyLength : List (String, String) -> Result Int String .
bodyLength hs = case headerGo "content-length" hs of
    O.None -> Ok 0
  | O.Some t -> (case S.toInt (S.trim t) of
        Err _ -> Err "content-length is not a number: {t}"
      | Ok v -> (case v < 0 of True -> Err "content-length is negative: {t}" | False -> Ok v)).

renderResponse : { status : Int, headers : List (String, String), body : String } -> String .
renderResponse resp = strJoin "" (
     "HTTP/1.1 " :: str resp.status :: " " :: reason resp.status :: "\r\n"
  :: renderHeaders resp.headers
  :: "content-length: " :: str (strlen resp.body) :: "\r\nconnection: close\r\n\r\n"
  :: resp.body :: Nil).

# a whole reply: status line, headers, blank line, body (chunked or not)
parseResponse : String -> Result { status : Int, headers : List (String, String), body : String } String .
parseResponse raw =
  at = strIndexOf "\r\n\r\n" raw;
  case at < 0 of
    True -> Err "malformed reply (no end of headers)"
  | False -> responseFrom (S.split "\r\n" (S.left at raw)) (S.dropLeft (at + 4) raw).
responseFrom ls body = case ls of
    Nil -> Err "empty reply"
  | line :: hs -> (case S.split " " line of
        _ :: code :: _ -> (case S.toInt code of
            Err _ -> Err "malformed status line: {line}"
          | Ok status -> finish status (parseHeaders hs) body)
      | _ -> Err "malformed status line: {line}").
finish status hs body = case headerGo "transfer-encoding" hs of
    O.Some enc -> (case S.contains "chunked" (S.toLower enc) of
        True -> (case dechunk body 0 Nil of Ok b -> Ok { status = status, headers = hs, body = b } | Err e -> Err e)
      | False -> Ok { status = status, headers = hs, body = body })
  | O.None -> Ok { status = status, headers = hs, body = body }.

dechunk : unsafe String -> Int -> List String -> Result String String .
dechunk s i acc =
  eol = strIndexFrom "\r\n" s i;
  case eol < 0 of
    True -> Err "malformed chunked body"
  | False -> (case hexSize s i eol 0 of
        O.None -> Err "malformed chunk size"
      | O.Some n -> (case n == 0 of
            True -> Ok (strJoin "" (rev acc Nil))
          | False -> dechunk s (eol + 2 + n + 2) (substr s (eol + 2) n :: acc))).
hexSize : unsafe String -> Int -> Int -> Int -> O.Option Int .
hexSize s i e acc = case i >= e or charAt s i == 59 of
    True -> O.Some acc
  | False -> (case hexVal (charAt s i) of O.None -> O.None | O.Some d -> hexSize s (i + 1) e (acc * 16 + d)).
hexVal : Int -> O.Option Int .
hexVal c = case c >= 48 and c <= 57 of
    True -> O.Some (c - 48)
  | False -> (case c >= 97 and c <= 102 of
        True -> O.Some (c - 87)
      | False -> (case c >= 65 and c <= 70 of True -> O.Some (c - 55) | False -> O.None)).

# ---- Bounded native HTTP/1.1 client (TCP/TLS, no child processes) ----------------
Options = { headerBytes : Int, bodyBytes : Int, timeoutMs : Int, trust : TLS.Trust, minimum : TLS.Minimum }.
defaults = {headerBytes = 16384, bodyBytes = 4194304, timeoutMs = 60000, trust = TLS.DefaultRoots, minimum = TLS.TLS12}.
clientDefaults = defaults.
invalid why = Err (T.Invalid why).
controls : unsafe String -> Int -> Bool .
controls text at = if at >= strlen text then False else
  c = charAt text at;
  c < 32 or c == 127 or controls text (at + 1).
token : String -> Bool .
token s = strlen s > 0 and tokenGo s 0.
tokenGo : unsafe String -> Int -> Bool .
tokenGo s i = if i >= strlen s then True else
  c = charAt s i;
  ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or
    strIndexOf (chr c) "!#$%&'*+-.^_`|~" >= 0) and tokenGo s (i + 1).
fieldValue : unsafe String -> Int -> Bool .
fieldValue s i = if i >= strlen s then True else
  c = charAt s i;
  (c == 9 or (c >= 32 and c != 127)) and fieldValue s (i + 1).
decimal text = if strlen text == 0 then invalid "empty content-length" else digits text 0 0 (2 ^ 62 - 1).
digits : unsafe String -> Int -> Int -> Int -> Result Int T.Failure .
digits text i n hi = if i >= strlen text then Ok n else
  d = charAt text i - 48;
  if d < 0 or d > 9 or n > (hi - d) / 10 then invalid "invalid content-length" else digits text (i + 1) (n * 10 + d) hi.
firstDelimiter : unsafe String -> Int -> Int .
firstDelimiter s i = if i >= strlen s then i else
  c = charAt s i;
  if c == 47 or c == 63 or c == 35 then i else firstDelimiter s (i + 1).
parseUrl url =
  at = strIndexOf "://" url;
  if at < 0 then Err "not a URL (no scheme): {url}" else
  scheme = S.toLower (S.left at url);
  rest = S.dropLeft (at + 3) url;
  cut = firstDelimiter rest 0;
  authority = S.left cut rest;
  suffix = S.dropLeft cut rest;
  target = if suffix == "" then "/" else if S.startsWith "?" suffix then "/{suffix}" else suffix;
  if scheme != "http" and scheme != "https" then Err "unsupported scheme: {scheme}" else
  if strlen authority == 0 or controls url 0 or strIndexOf " " url >= 0 or strIndexOf "#" url >= 0 or strIndexOf "@" authority >= 0 then Err "invalid HTTP URL" else
  parts = if S.startsWith "[" authority then
      end = strIndexOf "]" authority;
      if end < 2 then Err "invalid bracketed host" else
      tail = S.dropLeft (end + 1) authority;
      if tail == ":" or (tail != "" and not (S.startsWith ":" tail)) then Err "invalid host suffix" else
      Ok (substr authority 1 (end - 1), if tail == "" then "" else S.dropLeft 1 tail)
    else
      colon = strIndexOf ":" authority;
      if colon < 0 then Ok (authority, "") else
      if colon == strlen authority - 1 then Err "empty port" else Ok (S.left colon authority, S.dropLeft (colon + 1) authority);
  case parts of Err why -> Err why | Ok (host, portText) ->
    port = if portText == "" then Ok (if scheme == "https" then 443 else 80) else decimal portText;
    case port of Err _ -> Err "bad port in the URL" | Ok p ->
      if host == "" or p < 1 or p > 65535 then Err "invalid host or port" else Ok {scheme = scheme, host = host, port = p, target = target}.
validHeaders hs = L.all (fn pair -> case pair of (key, value) -> token key and fieldValue value 0 and
  not (L.member (S.toLower key) ["host", "content-length", "transfer-encoding", "connection", "accept-encoding", "expect"])) hs.
requestHead q u =
  host = if strIndexOf ":" u.host >= 0 then "[{u.host}]" else u.host;
  authority = if (u.scheme == "http" and u.port == 80) or (u.scheme == "https" and u.port == 443) then host else "{host}:{u.port}";
  "{q.method} {u.target} HTTP/1.1\r\nhost: {authority}\r\n{renderHeaders q.headers}content-length: {strlen q.body}\r\nconnection: close\r\naccept-encoding: identity\r\n\r\n".
clientRequest options q = case T.forMs options.timeoutMs of Err why -> Err why | Ok budget ->
  case T.resolverCreate 1 of Err why -> Err why | Ok pool ->
    result = requestOn T.timerWait budget pool options q;
    cleanup = T.resolverClose pool;
    case cleanup of Ok _ -> result | Err why -> case result of Ok _ -> Err why | Err before -> Err (T.CleanupFailed before why).
requestOn wait budget pool options q = if options.headerBytes < 4 or options.bodyBytes < 0 then invalid "invalid HTTP limits" else
  if not (token q.method) or not (validHeaders q.headers) then invalid "invalid or reserved HTTP request header/method" else
  if strlen q.body > options.bodyBytes then invalid "HTTP request body exceeds limit" else
  case parseUrl q.url of Err why -> invalid why | Ok u ->
    head = requestHead q u;
    if strlen head > options.headerBytes then invalid "HTTP request header exceeds limit" else
    case T.connectWith wait budget pool u.host u.port 16384 of
      Err why -> Err why
    | Ok tcp -> if u.scheme == "https" then
        case TLS.upgrade budget u.host options.trust options.minimum tcp of
          Err why -> Err why
        | Ok tls -> T.withConnection tls (exchange budget options q.method head q.body)
      else T.withConnection tcp (exchange budget options q.method head q.body).
exchange budget options method head body conn = case T.writeAll budget head conn of
    (Err (why, _), c) -> (Err why, c)
  | (Ok _, c) -> case T.writeAll budget body c of
      (Err (why, _), c2) -> (Err why, c2)
    | (Ok _, c2) -> readResponse budget options method 0 "" c2.
line : unsafe T.Budget -> Int -> String -> T.Connection s -> (Result String T.Failure, String, T.Connection s) .
line budget limit pending conn =
  at = strIndexOf "\r\n" pending;
  if at >= 0 then if at + 2 > limit then (invalid "HTTP line exceeds limit", pending, conn)
    else (Ok (S.left at pending), S.dropLeft (at + 2) pending, conn)
  else if strlen pending >= limit then (invalid "HTTP line exceeds limit", pending, conn) else
    room = limit - strlen pending;
    case T.readSome budget (if room < 4096 then room else 4096) conn of
      (Err (why, _), c) -> (Err why, pending, c)
    | (Ok bytes, c) -> if bytes == "" then (Err T.EndOfStream, pending, c) else line budget limit (pending + bytes) c.
headers : unsafe T.Budget -> Int -> Int -> List (String, String) -> String -> T.Connection s -> (Result (List (String, String)) T.Failure, String, T.Connection s) .
headers budget left count acc pending conn = if count > 100 then (invalid "too many HTTP headers", pending, conn) else
  case line budget left pending conn of
    (Err why, rest, c) -> (Err why, rest, c)
  | (Ok raw, rest, c) -> if raw == "" then (Ok (L.reverse acc), rest, c) else
      at = strIndexOf ":" raw;
      key = if at < 1 then "" else S.left at raw;
      value = if at < 0 then "" else S.dropLeft (at + 1) raw;
      if at < 1 or not (token key) or not (fieldValue value 0) then (invalid "malformed HTTP header", rest, c) else
      headers budget (left - strlen raw - 2) (count + 1) ((S.toLower key, S.trim value) :: acc) rest c.
readResponse : unsafe T.Budget -> Options -> String -> Int -> String -> T.Connection s -> (Result {status : Int, headers : List (String, String), body : String} T.Failure, T.Connection s) .
readResponse budget options method interim pending conn = case line budget options.headerBytes pending conn of
    (Err why, _, c) -> (Err why, c)
  | (Ok statusLine, rest, c) ->
      status = case S.split " " statusLine of version :: code :: _ ->
          if (version != "HTTP/1.1" and version != "HTTP/1.0") or strlen code != 3 then invalid "malformed HTTP status" else decimal code
        | _ -> invalid "malformed HTTP status";
      case status of Err why -> (Err why, c) | Ok code ->
        if code < 100 or code > 599 or controls statusLine 0 then (invalid "malformed HTTP status", c) else
        case headers budget (options.headerBytes - strlen statusLine - 2) 0 Nil rest c of
          (Err why, _, c2) -> (Err why, c2)
        | (Ok hs, body, c2) -> if code >= 100 and code < 200 then
            if code == 101 or interim >= 8 then (invalid "unsupported HTTP upgrade or excessive interim responses", c2) else
            readResponse budget options method (interim + 1) body c2
          else if method == "HEAD" or code == 204 or code == 304 then (Ok {status = code, headers = hs, body = ""}, c2) else
            (result, c3) = readBody budget options hs body c2;
            (case result of Err why -> Err why | Ok bytes -> Ok {status = code, headers = hs, body = bytes}, c3).
readBody budget options hs pending conn =
  lengths = L.filter (fn pair -> case pair of (k, _) -> k == "content-length") hs;
  encodings = L.filter (fn pair -> case pair of (k, _) -> k == "transfer-encoding") hs;
  if L.length lengths > 1 or L.length encodings > 1 or (lengths != Nil and encodings != Nil) then (invalid "ambiguous HTTP body framing", conn) else
  case encodings of
    [(_, value)] -> if S.toLower value != "chunked" then (invalid "unsupported HTTP transfer encoding", conn) else chunked budget options 0 0 Nil pending conn
  | _ -> case lengths of
      [(_, value)] -> (case decimal value of Err why -> (Err why, conn) | Ok n ->
        if n > options.bodyBytes then (invalid "HTTP body exceeds limit", conn) else
        case exact budget n pending conn of (result, _, c) -> (result, c))
    | _ -> untilEnd budget options.bodyBytes (strlen pending) [pending] conn.
exact budget n pending conn = if strlen pending >= n then (Ok (S.left n pending), S.dropLeft n pending, conn) else
  case T.readExactly budget (n - strlen pending) conn of
    (Err (why, _), c) -> (Err why, "", c)
  | (Ok bytes, c) -> (Ok (pending + bytes), "", c).
untilEnd : unsafe T.Budget -> Int -> Int -> List String -> T.Connection s -> (Result String T.Failure, T.Connection s) .
untilEnd budget limit count acc conn = if count > limit then (invalid "HTTP body exceeds limit", conn) else
  room = limit - count;
  case T.readSome budget (if room < 4096 then room + 1 else 4096) conn of
    (Err (why, _), c) -> (Err why, c)
  | (Ok bytes, c) -> if bytes == "" then (Ok (strJoin "" (L.reverse acc)), c) else untilEnd budget limit (count + strlen bytes) (bytes :: acc) c.
chunkSize text =
  semicolon = strIndexOf ";" text;
  digits = if semicolon < 0 then text else S.left semicolon text;
  if strlen digits == 0 or not (fieldValue text 0) then invalid "invalid HTTP chunk size" else hexGo digits 0 0 (2 ^ 62 - 1).
hexGo : unsafe String -> Int -> Int -> Int -> Result Int T.Failure .
hexGo text i n hi = if i >= strlen text then Ok n else
  d = E.hexVal (charAt text i);
  if d < 0 or n > (hi - d) / 16 then invalid "invalid HTTP chunk size" else hexGo text (i + 1) (n * 16 + d) hi.
chunked : unsafe T.Budget -> Options -> Int -> Int -> List String -> String -> T.Connection s -> (Result String T.Failure, T.Connection s) .
chunked budget options count chunks acc pending conn = if chunks >= 65536 then (invalid "too many HTTP chunks", conn) else
  case line budget options.headerBytes pending conn of
    (Err why, _, c) -> (Err why, c)
  | (Ok raw, rest, c) -> case chunkSize raw of Err why -> (Err why, c) | Ok n ->
      if n > options.bodyBytes - count then (invalid "HTTP body exceeds limit", c) else
      if n == 0 then case headers budget options.headerBytes 0 Nil rest c of
          (Err why, _, c2) -> (Err why, c2)
        | (Ok trailers, _, c2) -> if L.any (fn pair -> case pair of (k, _) -> L.member k ["content-length", "transfer-encoding", "host"]) trailers then (invalid "forbidden HTTP trailer", c2)
            else (Ok (strJoin "" (L.reverse acc)), c2)
      else case exact budget n rest c of
        (Err why, _, c2) -> (Err why, c2)
      | (Ok bytes, after, c2) -> case exact budget 2 after c2 of
          (Err why, _, c3) -> (Err why, c3)
        | (Ok crlf, more, c3) -> if crlf != "\r\n" then (invalid "malformed HTTP chunk terminator", c3) else
            chunked budget options (count + n) (chunks + 1) (bytes :: acc) more c3.

get url = request { method = "GET", url = url, headers = Nil, body = "" }.
post url contentType body = request { method = "POST", url = url, headers = [("content-type", contentType)], body = body }.
request q = requestWith clientDefaults q.
requestWith options q = case parseUrl q.url of Err why -> Err why | Ok _ -> (case clientRequest options q of
    Ok resp -> Ok resp
  | Err why -> Err (case why of T.Io message -> message | _ -> "{why}")).

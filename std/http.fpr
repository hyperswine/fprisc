# std/http.fpr -- Http: a client and a server, HTTP/1.1 (ExtBase).
#
#   Http = use "std/http".
#   case Http.get "http://example.org/data.json" of
#       Ok r -> (case r.status == 200 of True -> Json.parse r.body | False -> Err "HTTP {r.status}")
#     | Err why -> Err why                 # it never got an answer
#
#   Http.serve listener (fn req -> case req.path == "/health" of
#       True -> Http.text 200 "ok" | False -> Http.text 404 "no such page")
#
# A Request is { method, path, query, headers, body }; a Response is
# { status, headers, body }.  Header NAMES are lower-case in both, because
# HTTP says their case means nothing: `Http.header "content-type" r`.
# A non-2xx status is an Ok response you inspect; Err means there was none.
#
# HTTP and HTTPS clients use checked native transports, with bounded DNS,
# absolute deadlines and strict header/body framing. HTTPS requires a linked
# TLS engine; missing support is an explicit error. Never falls back to tools.
# Server compatibility APIs and whole-buffer parsing remain in httpcore.

C = use "httpcore".
TCP = use "tcp".
ST = use "stream".
PL = use "poller".
O = use "option".
Native = use "httpclient".
T = use "transport".

# ---- the portable part: std/httpcore, the same names -------------------------------
header : String -> { headers : List (String, String) | r } -> O.Option String .
header name m = C.header name m.
parseHeaders : List String -> List (String, String) .
parseHeaders ls = C.parseHeaders ls.
renderHeaders : List (String, String) -> String .
renderHeaders hs = C.renderHeaders hs.
response : Int -> String -> String -> { status : Int, headers : List (String, String), body : String } .
response status contentType body = C.response status contentType body.
text : Int -> String -> { status : Int, headers : List (String, String), body : String } .
text status body = C.text status body.
html : Int -> String -> { status : Int, headers : List (String, String), body : String } .
html status body = C.html status body.
json : Int -> String -> { status : Int, headers : List (String, String), body : String } .
json status body = C.json status body.
reason : Int -> String .
reason status = C.reason status.
serve : TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serve listener handler = C.serve listener handler.
serveOn : PL.Poller -> TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serveOn p listener handler = C.serveOn p listener handler.
readRequest : ST.Stream -> Result { method : String, path : String, query : String, headers : List (String, String), body : String } String .
readRequest conn = C.readRequest conn.
# the bounds a connection is held to (std/httpcore `limits`): header bytes,
# body bytes, milliseconds to arrive; `serve`/`serveOn`/`readRequest` use `limits`
limits : { header : Int, body : Int, readMs : Int } .
limits = C.limits.
serveWith : { header : Int, body : Int, readMs : Int } -> TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serveWith lim listener handler = C.serveWith lim listener handler.
serveOnWith : { header : Int, body : Int, readMs : Int } -> PL.Poller -> TCP.Listener -> ({ method : String, path : String, query : String, headers : List (String, String), body : String } -> { status : Int, headers : List (String, String), body : String }) -> String .
serveOnWith lim p listener handler = C.serveOnWith lim p listener handler.
readRequestWith : { header : Int, body : Int, readMs : Int } -> ST.Stream -> Result { method : String, path : String, query : String, headers : List (String, String), body : String } String .
readRequestWith lim conn = C.readRequestWith lim conn.
renderResponse : { status : Int, headers : List (String, String), body : String } -> String .
renderResponse resp = C.renderResponse resp.
parseUrl : String -> Result { scheme : String, host : String, port : Int, target : String } String .
parseUrl url = Native.parseUrl url.
parseResponse : String -> Result { status : Int, headers : List (String, String), body : String } String .
parseResponse raw = C.parseResponse raw.

# Native client. Reuse HttpClient.requestOn for a caller-owned DNS pool,
# shared readiness service, cancellation budget and explicit aggregate admission.
clientDefaults = Native.defaults.
get url = request { method = "GET", url = url, headers = Nil, body = "" }.
post url contentType body = request { method = "POST", url = url, headers = [("content-type", contentType)], body = body }.
request q = requestWith clientDefaults q.
requestWith options q = case Native.parseUrl q.url of Err why -> Err why | Ok _ -> (case Native.request options q of
    Ok response -> Ok response
  | Err why -> Err (case why of T.Io message -> message | _ -> "{why}")).

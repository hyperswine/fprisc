# std/ma.fpr -- Ma: the design system, as a View LIBRARY (it was
# qos/programs/mods/ma.fpr).
#
# tokens.json becomes two things here:
#   1. Explicit inherited custom properties on each page. Utilities read
#      tokens from that scope; day/night pages can coexist without leakage.
#   2. a utility table in Ma's vocabulary (bg-surface, tx-2, r-md,
#      sh-sm, gap-5 ...) -- genview's rule: using a class anywhere in
#      the tree is what emits it; the stylesheet is a function of the
#      view.
#
# And the COMPONENT layer: vstack/hstack/spacer + card/button/badge/
# chip/toast/accordion/navbar/crumbs are plain functions over the Elem
# primitives (El/Txt/Dyn), so an app composes named parts, not nested
# divs.  Layout is stacks only -- tokens.json says gridAllowed:false,
# and cardGrid is an HStack that wraps (SPEC 0/4).
G = use "view".
L = use "list".

# ---- layout primitives ------------------------------------------------------
vstack g kids = G.El "div" [G.Cls "col gap-{g}"] kids.
hstack g kids = G.El "div" [G.Cls "row center gap-{g}"] kids.
zstack kids   = G.El "div" [G.Cls "zstack"] kids.
spacer        = G.El "div" [G.Cls "grow"] Nil.
vsA g attrs kids = G.El "div" (G.Cls "col gap-{g}" :: attrs) kids.
hsA g attrs kids = G.El "div" (G.Cls "row center gap-{g}" :: attrs) kids.

# ---- text roles (type scale from tokens.json) -------------------------------
display s = G.El "div" [G.Cls "t-display tx-1"] [G.Txt s].
title s   = G.El "div" [G.Cls "t-title tx-1"] [G.Txt s].
heading s = G.El "div" [G.Cls "t-heading tx-1"] [G.Txt s].
body s    = G.El "div" [G.Cls "t-body tx-1"] [G.Txt s].
caption s = G.El "div" [G.Cls "t-caption tx-2"] [G.Txt s].
meta s    = G.El "div" [G.Cls "t-caption tx-3"] [G.Txt s].
bodyD v   = G.El "div" [G.Cls "t-body tx-1"] [G.Dyn v].

# ---- surfaces ---------------------------------------------------------------
card kids       = vsA 3 [G.Cls "bg-surface bd-subtle r-md sh-sm p-5 lift"] kids.
cardRaised kids = vsA 3 [G.Cls "bg-raised bd-subtle r-md sh-md p-5"] kids.
divider         = G.El "div" [G.Cls "hr"] Nil.

# cardGrid: NOT a grid (gridAllowed:false) -- a wrapping HStack whose
# children carry a column-width token (SPEC 4).
cardGrid kids = G.El "div" [G.Cls "row wrap gap-5"] kids.
gridCell kids = vsA 3 [G.Cls "w-medium bg-surface bd-subtle r-md sh-sm p-5 lift"] kids.

# ---- interactive ------------------------------------------------------------
button label msg arg =
  G.El "button" [G.Cls "btn t-label", G.OnClick msg arg] [G.Txt label].
buttonPrimary label msg arg =
  G.El "button" [G.Cls "btn btn-primary t-label", G.OnClick msg arg] [G.Txt label].
buttonDanger label msg arg =
  G.El "button" [G.Cls "btn btn-danger t-label", G.OnClick msg arg] [G.Txt label].
btnSet label n v =
  G.El "button" [G.Cls "btn t-label", G.OnSet n v] [G.Txt label].
btnBoth label msg arg n v =
  G.El "button" [G.Cls "btn btn-primary t-label", G.OnBoth msg arg n v] [G.Txt label].

chip label = G.El "span" [G.Cls "chip t-label"] [G.Txt label].

# reserved-role policy (tokens.json): success/warning/danger/
# celebration are MEANINGS, not colors to grab; a badge takes the role.
badge role label = G.El "span" [G.Cls "badge bd-{role} tx-{role} t-label"] [G.Txt label].

# ---- composite: accordion (pure client -- one local per section) ------------
accordion n hd kids =
  vsA 0 [G.Cls "bg-surface bd-subtle r-md sh-sm", G.Local n "0"]
    ( hsA 3 [G.Cls "p-4 pointer", G.OnSet n "toggle"]
        (G.El "span" [G.Cls "t-heading tx-1 grow"] [G.Txt hd]
         :: G.El "span" [G.Cls "t-caption tx-3"] [G.Txt "toggle"] :: Nil)
      :: vsA 3 [G.Cls "p-4 pt-0", G.ShowIf n] kids :: Nil ).

# ---- composite: toast (server decides text, client dismisses) ---------------
toast v =
  hsA 3 [G.Cls "toast bg-raised bd-subtle r-md sh-lg p-4", G.ShowIf "toast"]
    (G.El "span" [G.Cls "t-body tx-1"] [G.Dyn v]
     :: btnSet "dismiss" "toast" "0" :: Nil).

# ---- composite: nav bar + breadcrumb ----------------------------------------
navTab n idx label =
  G.El "button" [G.Cls "btn navbtn t-label", G.Att "data-show" "{n}:{idx}", G.OnSet n idx]
    [G.Txt label].
navBar n tabs = hsA 2 [G.Cls "bg-surface bd-subtle r-full sh-sm px-3 py-2", G.Local n "1"] tabs.

crumb s     = G.El "span" [G.Cls "t-caption tx-3"] [G.Txt s].
crumbSep    = G.El "span" [G.Cls "t-caption tx-3"] [G.Txt " / "].
crumbHere s = G.El "span" [G.Cls "t-caption tx-2"] [G.Txt s].
breadcrumb a b here = hsA 1 Nil [crumb a, crumbSep, crumb b, crumbSep, crumbHere here].

# ---- page root: the MODEL selects scoped token declarations. A theme change
# changes static attributes; text slots continue to ride deltas.
page themeCls kids = G.El "div" [G.Cls "canvas", G.Att "data-ma-theme" themeCls,
  G.utilities (themeDecls (themeCls == "night"))] kids.

# ---- the stylesheet: vars + base + only the utilities the tree uses ---------
maCssFor tree =
  # Include both public page palettes for older render callers that change
  # theme after load. Definitions remain inert until a page carries the class.
  cs = G.nub (L.append (G.allClasses tree Nil) (L.append (paletteNames False) (paletteNames True)));
  strcat maBase (strcat (maRules cs) (G.localCss cs)).
paletteNames : Bool -> List String .
paletteNames dark = G.atomNames (G.localAtoms [G.utilities (themeDecls dark)]).
maRules : unsafe List String -> String .
maRules Nil = "".
maRules (c :: r) = strcat (ma1 c (maRule c)) (maRules r).
ma1 c "" = "".
# a MODIFIER of a component (btn-primary, btn-danger) is a compound selector:
# rules are emitted in the order the tree first uses the classes, so with a
# plain `.btn-primary` a `.btn` used later in the page would win and every
# primary button would come out plain
ma1 "btn-primary" d = ".btn.btn-primary\{{d}}\n".
ma1 "btn-danger" d = ".btn.btn-danger\{{d}}\n".
ma1 c d = ".{c}\{{d}}\n".

# The token vocabulary is named data, validated by View.NamedToken. No global
# :root/.night palette and no application-defined selectors are involved.
colourToken pair = case pair of (name, colour) -> G.DefineColour (G.NamedToken name) colour.
shadow y blur r g b a = G.ShadowPart (G.Px 0) (G.Px y) (G.Px blur) (G.Px 0) (G.RgbaPercent r g b a).
themeDecls : Bool -> List G.Decl .
themeDecls dark = L.append (L.map colourToken (("tx-on", G.Rgb 255 255 255) :: (if dark then nightColours else dayColours)))
  (if dark then
    [G.DefineShadows (G.NamedToken "sh-sm") [shadow 1 2 0 0 0 30],
     G.DefineShadows (G.NamedToken "sh-md") [shadow 4 12 0 0 0 35],
     G.DefineShadows (G.NamedToken "sh-lg") [shadow 12 32 0 0 0 45]]
   else
    [G.DefineShadows (G.NamedToken "sh-sm") [shadow 1 2 30 41 59 6, shadow 1 1 30 41 59 4],
     G.DefineShadows (G.NamedToken "sh-md") [shadow 4 12 30 41 59 8],
     G.DefineShadows (G.NamedToken "sh-lg") [shadow 12 32 30 41 59 12]]).
dayColours = [("bg-canvas", G.Rgb 247 248 250), ("bg-surface", G.Rgb 255 255 255), ("bg-raised", G.Rgb 255 255 255),
  ("bd-subtle", G.Rgb 228 231 236), ("bd-strong", G.Rgb 199 204 214),
  ("tx-1", G.Rgb 26 29 35), ("tx-2", G.Rgb 91 100 114), ("tx-3", G.Rgb 138 147 163),
  ("ac", G.Rgb 61 111 224), ("ac-hover", G.Rgb 53 96 199), ("ac-press", G.Rgb 44 81 173), ("ac-subtle", G.Rgb 234 240 254),
  ("success", G.Rgb 46 158 107), ("warning", G.Rgb 201 138 46), ("danger", G.Rgb 209 78 78), ("celebration", G.Rgb 47 174 110)].
nightColours = [("bg-canvas", G.Rgb 21 23 28), ("bg-surface", G.Rgb 29 32 39), ("bg-raised", G.Rgb 36 40 48),
  ("bd-subtle", G.Rgb 42 47 56), ("bd-strong", G.Rgb 58 64 76),
  ("tx-1", G.Rgb 237 239 243), ("tx-2", G.Rgb 154 163 178), ("tx-3", G.Rgb 107 114 128),
  ("ac", G.Rgb 91 138 240), ("ac-hover", G.Rgb 112 153 245), ("ac-press", G.Rgb 74 120 214), ("ac-subtle", G.Rgb 30 42 69),
  ("success", G.Rgb 76 190 135), ("warning", G.Rgb 224 169 79), ("danger", G.Rgb 232 112 111), ("celebration", G.Rgb 78 210 142)].

maBase = "*\{box-sizing:border-box;margin:0}
body\{margin:0}
.canvas\{min-height:100vh;background:var(--bg-canvas);color:var(--tx-1);
  font:15px/1.47 -apple-system,'Segoe UI','Inter',sans-serif;
  transition:background .32s cubic-bezier(.2,0,0,1),color .32s cubic-bezier(.2,0,0,1);
  padding:32px}
button\{font:inherit}
.btn:hover\{border-color:var(--bd-strong);background:var(--ac-subtle)}
.btn:active\{transform:scale(.99)}
.btn-primary:hover\{background:var(--ac-hover)}
.btn-primary:active\{background:var(--ac-press)}
.lift\{transition:transform .12s cubic-bezier(.2,0,0,1),box-shadow .12s cubic-bezier(.2,0,0,1)}
.lift:hover\{transform:scale(1.02);box-shadow:var(--sh-md)}
.navbtn.is-on\{background:var(--ac);color:var(--tx-on);border-color:var(--ac)}
.toast\{position:fixed;right:24px;bottom:24px}
[data-slot]\{transition:color .2s}
.lv-flash\{animation:lvf .55s ease-out}
@keyframes lvf\{from\{color:var(--ac)}to\{color:inherit}}
".

# the utility table, in Ma's vocabulary (values from tokens.json)
maRule "row" = "display:flex;flex-direction:row".
maRule "col" = "display:flex;flex-direction:column".
maRule "zstack" = "position:relative".
maRule "wrap" = "flex-wrap:wrap".
maRule "center" = "align-items:center".
maRule "grow" = "flex:1".
maRule "pointer" = "cursor:pointer".
maRule "gap-1" = "gap:4px".
maRule "gap-2" = "gap:8px".
maRule "gap-3" = "gap:12px".
maRule "gap-4" = "gap:16px".
maRule "gap-5" = "gap:24px".
maRule "gap-6" = "gap:32px".
maRule "p-3" = "padding:12px".
maRule "p-4" = "padding:16px".
maRule "p-5" = "padding:24px".
maRule "pt-0" = "padding-top:0".
maRule "px-3" = "padding-left:12px;padding-right:12px".
maRule "py-2" = "padding-top:8px;padding-bottom:8px".
maRule "w-narrow" = "width:80px".
maRule "w-medium" = "width:160px;flex:0 0 160px".
maRule "w-wide" = "width:280px".
maRule "t-display" = "font-size:32px;line-height:40px;font-weight:600".
maRule "t-title" = "font-size:22px;line-height:28px;font-weight:600".
maRule "t-heading" = "font-size:17px;line-height:24px;font-weight:600".
maRule "t-body" = "font-size:15px;line-height:22px;font-weight:400".
maRule "t-caption" = "font-size:13px;line-height:18px;font-weight:400".
maRule "t-label" = "font-size:13px;line-height:18px;font-weight:500".
maRule "t-mono" = "font-family:'SF Mono','Cascadia Code',ui-monospace,monospace;font-size:14px;line-height:20px".
maRule "tx-1" = "color:var(--tx-1)".
maRule "tx-2" = "color:var(--tx-2)".
maRule "tx-3" = "color:var(--tx-3)".
maRule "tx-success" = "color:var(--success)".
maRule "tx-warning" = "color:var(--warning)".
maRule "tx-danger" = "color:var(--danger)".
maRule "tx-celebration" = "color:var(--celebration)".
maRule "bg-surface" = "background:var(--bg-surface)".
maRule "bg-raised" = "background:var(--bg-raised)".
maRule "bd-subtle" = "border:1px solid var(--bd-subtle)".
maRule "bd-strong" = "border:1px solid var(--bd-strong)".
maRule "bd-success" = "border:1px solid var(--success)".
maRule "bd-warning" = "border:1px solid var(--warning)".
maRule "bd-danger" = "border:1px solid var(--danger)".
maRule "bd-celebration" = "border:1px solid var(--celebration)".
maRule "r-sm" = "border-radius:6px".
maRule "r-md" = "border-radius:10px".
maRule "r-lg" = "border-radius:16px".
maRule "r-full" = "border-radius:9999px".
maRule "sh-sm" = "box-shadow:var(--sh-sm)".
maRule "sh-md" = "box-shadow:var(--sh-md)".
maRule "sh-lg" = "box-shadow:var(--sh-lg)".
maRule "hr" = "border-top:1px solid var(--bd-subtle)".
maRule "btn" = "cursor:pointer;border:1px solid var(--bd-subtle);background:var(--bg-surface);color:var(--tx-1);border-radius:6px;padding:8px 12px;transition:.12s cubic-bezier(.2,0,0,1)".
maRule "btn-primary" = "background:var(--ac);color:var(--tx-on);border-color:var(--ac)".
maRule "btn-danger" = "background:var(--danger);color:var(--tx-on);border-color:var(--danger)".
maRule "chip" = "background:var(--ac-subtle);color:var(--ac);border-radius:9999px;padding:4px 12px".
maRule "badge" = "border-radius:9999px;padding:4px 12px;background:var(--bg-surface)".
maRule c = "".

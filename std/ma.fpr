# std/ma.fpr -- Ma: the design system, as a View LIBRARY (it was
# qos/programs/mods/ma.fpr).
#
# tokens.json becomes two things here:
#   1. Explicit inherited custom properties on each page. Utilities read
#      tokens from that scope; day/night pages can coexist without leakage.
#   2. Typed local declarations on each component node. Its generated utility
#      classes emit only those declarations. Vocabulary classes remain DOM
#      hooks; the explicit legacy stylesheet API is available for compatibility.
#
# And the COMPONENT layer: vstack/hstack/spacer + card/button/badge/
# chip/toast/accordion/navbar/crumbs are plain functions over the Elem
# primitives (El/Txt/Dyn), so an app composes named parts, not nested
# divs.  Layout is stacks only -- tokens.json says gridAllowed:false,
# and cardGrid is an HStack that wraps (SPEC 0/4).
G = use "view".
L = use "list".

element tag attrs kids = G.El tag (G.utilities [G.BoxSizing G.BorderBox, G.Margin (G.Px 0), G.FontFamily G.InheritFont] ::
  (if tag == "button" then G.hover [G.BorderColour (G.ThemeColour (G.NamedToken "bd-strong")), G.Background (G.ThemeColour (G.NamedToken "ac-subtle"))] :: attrs else attrs)) kids.
spacing n = case n of 0 -> 0 | 1 -> 4 | 2 -> 8 | 3 -> 12 | 4 -> 16 | 5 -> 24 | _ -> 32.
# ---- layout primitives ------------------------------------------------------
vstack g kids = element "div" [G.utilities [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px (spacing g))]] kids.
hstack g kids = element "div" [G.utilities [G.Display G.Flex, G.Direction G.Row, G.AlignItems G.AlignCenter, G.Gap (G.Px (spacing g))]] kids.
zstack kids   = element "div" [G.Utilities [G.Base [G.Position G.Relative]], G.Cls "zstack"] kids.
spacer        = element "div" [G.Utilities [G.Base [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0)]], G.Cls "grow"] Nil.
vsA g attrs kids = element "div" (G.utilities [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px (spacing g))] :: attrs) kids.
hsA g attrs kids = element "div" (G.utilities [G.Display G.Flex, G.Direction G.Row, G.AlignItems G.AlignCenter, G.Gap (G.Px (spacing g))] :: attrs) kids.

# ---- text roles (type scale from tokens.json) -------------------------------
display s = element "div" [G.Utilities [G.Base [G.FontSize (G.Px 32), G.LineHeightLength (G.Px 40), G.FontWeight 600, G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))]], G.Cls "t-display tx-1"] [G.Txt s].
title s   = element "div" [G.Utilities [G.Base [G.FontSize (G.Px 22), G.LineHeightLength (G.Px 28), G.FontWeight 600, G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))]], G.Cls "t-title tx-1"] [G.Txt s].
heading s = element "div" [G.Utilities [G.Base [G.FontSize (G.Px 17), G.LineHeightLength (G.Px 24), G.FontWeight 600, G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))]], G.Cls "t-heading tx-1"] [G.Txt s].
body s    = element "div" [G.Utilities [G.Base [G.FontSize (G.Px 15), G.LineHeightLength (G.Px 22), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))]], G.Cls "t-body tx-1"] [G.Txt s].
caption s = element "div" [G.Utilities [G.Base [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-2"))]], G.Cls "t-caption tx-2"] [G.Txt s].
meta s    = element "div" [G.Utilities [G.Base [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-3"))]], G.Cls "t-caption tx-3"] [G.Txt s].
bodyD v   = element "div" [G.Utilities [G.Base [G.FontSize (G.Px 15), G.LineHeightLength (G.Px 22), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))]], G.Cls "t-body tx-1"] [G.Dyn v].

# ---- surfaces ---------------------------------------------------------------
card kids       = vsA 3 [G.Utilities [G.Base [G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Radius (G.Px 10), G.ShadowToken (G.NamedToken "sh-sm"), G.Padding (G.Px 24)]], G.Cls "bg-surface bd-subtle r-md sh-sm p-5 lift"] kids.
cardRaised kids = vsA 3 [G.Utilities [G.Base [G.Background (G.ThemeColour (G.NamedToken "bg-raised")), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Radius (G.Px 10), G.ShadowToken (G.NamedToken "sh-md"), G.Padding (G.Px 24)]], G.Cls "bg-raised bd-subtle r-md sh-md p-5"] kids.
divider         = element "div" [G.Utilities [G.Base [G.BorderTop (G.Px 1) (G.ThemeColour (G.NamedToken "bd-subtle"))]], G.Cls "hr"] Nil.

# cardGrid: NOT a grid (gridAllowed:false) -- a wrapping HStack whose
# children carry a column-width token (SPEC 4).
cardGrid kids = element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.FlexWrap G.Wrap, G.Gap (G.Px 24)]], G.Cls "row wrap gap-5"] kids.
gridCell kids = vsA 3 [G.Utilities [G.Base [G.Width (G.Px 160), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Px 160), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Radius (G.Px 10), G.ShadowToken (G.NamedToken "sh-sm"), G.Padding (G.Px 24)]], G.Cls "w-medium bg-surface bd-subtle r-md sh-sm p-5 lift"] kids.

# ---- interactive ------------------------------------------------------------
button label msg arg =
  element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.TransitionAll 120, G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.Cls "btn t-label", G.OnClick msg arg] [G.Txt label].
buttonPrimary label msg arg =
  element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.TransitionAll 120, G.Background (G.ThemeColour (G.NamedToken "ac")), G.Foreground (G.ThemeColour (G.NamedToken "tx-on")), G.BorderColour (G.ThemeColour (G.NamedToken "ac")), G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.Cls "btn btn-primary t-label", G.hover [G.Background (G.ThemeColour (G.NamedToken "ac-hover"))], G.OnClick msg arg] [G.Txt label].
buttonDanger label msg arg =
  element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.TransitionAll 120, G.Background (G.ThemeColour (G.NamedToken "danger")), G.Foreground (G.ThemeColour (G.NamedToken "tx-on")), G.BorderColour (G.ThemeColour (G.NamedToken "danger")), G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.Cls "btn btn-danger t-label", G.OnClick msg arg] [G.Txt label].
btnSet label n v =
  element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.TransitionAll 120, G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.Cls "btn t-label", G.OnSet n v] [G.Txt label].
btnBoth label msg arg n v =
  element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.TransitionAll 120, G.Background (G.ThemeColour (G.NamedToken "ac")), G.Foreground (G.ThemeColour (G.NamedToken "tx-on")), G.BorderColour (G.ThemeColour (G.NamedToken "ac")), G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.Cls "btn btn-primary t-label", G.hover [G.Background (G.ThemeColour (G.NamedToken "ac-hover"))], G.OnBoth msg arg n v] [G.Txt label].

chip label = element "span" [G.Utilities [G.Base [G.Background (G.ThemeColour (G.NamedToken "ac-subtle")), G.Foreground (G.ThemeColour (G.NamedToken "ac")), G.Radius (G.Px 9999), G.PaddingY (G.Px 4), G.PaddingX (G.Px 12), G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.Cls "chip t-label"] [G.Txt label].

# reserved-role policy (tokens.json): success/warning/danger/
# celebration are MEANINGS, not colors to grab; a badge takes the role.
badge role label = element "span" [G.Utilities [G.Base [G.Radius (G.Px 9999), G.PaddingY (G.Px 4), G.PaddingX (G.Px 12), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.utilities [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken role)), G.Foreground (G.ThemeColour (G.NamedToken role))]] [G.Txt label].

# ---- composite: accordion (pure client -- one local per section) ------------
accordion n hd kids =
  vsA 0 [G.Utilities [G.Base [G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Radius (G.Px 10), G.ShadowToken (G.NamedToken "sh-sm")]], G.Cls "bg-surface bd-subtle r-md sh-sm", G.Local n "0"]
    ( hsA 3 [G.Utilities [G.Base [G.Padding (G.Px 16), G.Cursor G.PointerCursor]], G.Cls "p-4 pointer", G.OnSet n "toggle"]
        (element "span" [G.Utilities [G.Base [G.FontSize (G.Px 17), G.LineHeightLength (G.Px 24), G.FontWeight 600, G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0)]], G.Cls "t-heading tx-1 grow"] [G.Txt hd]
         :: element "span" [G.Utilities [G.Base [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-3"))]], G.Cls "t-caption tx-3"] [G.Txt "toggle"] :: Nil)
      :: vsA 3 [G.Utilities [G.Base [G.Padding (G.Px 16), G.PaddingTop (G.Px 0)]], G.Cls "p-4 pt-0", G.ShowIf n] kids :: Nil ).

# ---- composite: toast (server decides text, client dismisses) ---------------
toast v =
  hsA 3 [G.Att "data-hide-empty" "", G.Utilities [G.Base [G.Background (G.ThemeColour (G.NamedToken "bg-raised")), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Radius (G.Px 10), G.ShadowToken (G.NamedToken "sh-lg"), G.Padding (G.Px 16)]], G.Cls "toast bg-raised bd-subtle r-md sh-lg p-4", G.ShowIf "toast"]
    (element "span" [G.Utilities [G.Base [G.FontSize (G.Px 15), G.LineHeightLength (G.Px 22), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))]], G.Cls "t-body tx-1"] [G.Dyn v]
     :: btnSet "dismiss" "toast" "0" :: Nil).

# ---- composite: nav bar + breadcrumb ----------------------------------------
navTab n idx label =
  element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.TransitionAll 120, G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]], G.Cls "btn navbtn t-label", G.Att "data-show" "{n}:{idx}", G.OnSet n idx]
    [G.Txt label].
navBar n tabs = hsA 2 [G.Utilities [G.Base [G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Radius (G.Px 9999), G.ShadowToken (G.NamedToken "sh-sm"), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.Cls "bg-surface bd-subtle r-full sh-sm px-3 py-2", G.Local n "1"] tabs.

crumb s     = element "span" [G.Utilities [G.Base [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-3"))]], G.Cls "t-caption tx-3"] [G.Txt s].
crumbSep    = element "span" [G.Utilities [G.Base [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-3"))]], G.Cls "t-caption tx-3"] [G.Txt " / "].
crumbHere s = element "span" [G.Utilities [G.Base [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400, G.Foreground (G.ThemeColour (G.NamedToken "tx-2"))]], G.Cls "t-caption tx-2"] [G.Txt s].
breadcrumb a b here = hsA 1 Nil [crumb a, crumbSep, crumb b, crumbSep, crumbHere here].

# ---- page root: the MODEL selects scoped token declarations. A theme change
# changes static attributes; text slots continue to ride deltas.
page themeCls kids = element "div" [G.utilities [G.MinHeight (G.Vh 100), G.Background (G.ThemeColour (G.NamedToken "bg-canvas")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.FontFamily G.SystemFont, G.FontSize (G.Px 15), G.LineHeight 147, G.Padding (G.Px 32)], G.Cls "canvas", G.Att "data-ma-theme" themeCls,
  G.utilities (themeDecls (themeCls == "night"))] kids.

# ---- the stylesheet: vars + base + only the utilities the tree uses ---------
maCssFor tree = G.localCss (G.nub (G.allClasses tree Nil)).
paletteNames : Bool -> List String .
paletteNames dark = G.atomNames (G.localAtoms [G.utilities (themeDecls dark)]).
maRules : unsafe List String -> String .
maRules Nil = "".
maRules (c :: r) = strcat (ma1 c (maRule c)) (maRules r).
ma1 c "" = "".
# a MODIFIER of a component (btn-primary, btn-danger) is a compound selector:
# rules are emitted in the order the tree first uses the classes, so with a
# plain `.btn-primary` a `.btn` used later in the page would win and every
# primary button would come out plain
ma1 "btn-primary" d = ".btn.btn-primary\{{d}}\n".
ma1 "btn-danger" d = ".btn.btn-danger\{{d}}\n".
ma1 c d = ".{c}\{{d}}\n".

# The token vocabulary is named data, validated by View.NamedToken. No global
# :root/.night palette and no application-defined selectors are involved.
colourToken pair = case pair of (name, colour) -> G.DefineColour (G.NamedToken name) colour.
shadow y blur r g b a = G.ShadowPart (G.Px 0) (G.Px y) (G.Px blur) (G.Px 0) (G.RgbaPercent r g b a).
themeDecls : Bool -> List G.Decl .
themeDecls dark = L.append (L.map colourToken (("tx-on", G.Rgb 255 255 255) :: (if dark then nightColours else dayColours)))
  (if dark then
    [G.DefineShadows (G.NamedToken "sh-sm") [shadow 1 2 0 0 0 30],
     G.DefineShadows (G.NamedToken "sh-md") [shadow 4 12 0 0 0 35],
     G.DefineShadows (G.NamedToken "sh-lg") [shadow 12 32 0 0 0 45]]
   else
    [G.DefineShadows (G.NamedToken "sh-sm") [shadow 1 2 30 41 59 6, shadow 1 1 30 41 59 4],
     G.DefineShadows (G.NamedToken "sh-md") [shadow 4 12 30 41 59 8],
     G.DefineShadows (G.NamedToken "sh-lg") [shadow 12 32 30 41 59 12]]).
dayColours = [("bg-canvas", G.Rgb 247 248 250), ("bg-surface", G.Rgb 255 255 255), ("bg-raised", G.Rgb 255 255 255),
  ("bd-subtle", G.Rgb 228 231 236), ("bd-strong", G.Rgb 199 204 214),
  ("tx-1", G.Rgb 26 29 35), ("tx-2", G.Rgb 91 100 114), ("tx-3", G.Rgb 138 147 163),
  ("ac", G.Rgb 61 111 224), ("ac-hover", G.Rgb 53 96 199), ("ac-press", G.Rgb 44 81 173), ("ac-subtle", G.Rgb 234 240 254),
  ("success", G.Rgb 46 158 107), ("warning", G.Rgb 201 138 46), ("danger", G.Rgb 209 78 78), ("celebration", G.Rgb 47 174 110)].
nightColours = [("bg-canvas", G.Rgb 21 23 28), ("bg-surface", G.Rgb 29 32 39), ("bg-raised", G.Rgb 36 40 48),
  ("bd-subtle", G.Rgb 42 47 56), ("bd-strong", G.Rgb 58 64 76),
  ("tx-1", G.Rgb 237 239 243), ("tx-2", G.Rgb 154 163 178), ("tx-3", G.Rgb 107 114 128),
  ("ac", G.Rgb 91 138 240), ("ac-hover", G.Rgb 112 153 245), ("ac-press", G.Rgb 74 120 214), ("ac-subtle", G.Rgb 30 42 69),
  ("success", G.Rgb 76 190 135), ("warning", G.Rgb 224 169 79), ("danger", G.Rgb 232 112 111), ("celebration", G.Rgb 78 210 142)].

maBase = "".

# the utility table, in Ma's vocabulary (values from tokens.json)
maRule "row" = G.declsCss [G.Display G.Flex, G.Direction G.Row].
maRule "col" = G.declsCss [G.Display G.Flex, G.Direction G.Column].
maRule "zstack" = G.declsCss [G.Position G.Relative].
maRule "wrap" = G.declsCss [G.FlexWrap G.Wrap].
maRule "center" = G.declsCss [G.AlignItems G.AlignCenter].
maRule "grow" = G.declsCss [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0)].
maRule "pointer" = G.declsCss [G.Cursor G.PointerCursor].
maRule "gap-1" = G.declsCss [G.Gap (G.Px 4)].
maRule "gap-2" = G.declsCss [G.Gap (G.Px 8)].
maRule "gap-3" = G.declsCss [G.Gap (G.Px 12)].
maRule "gap-4" = G.declsCss [G.Gap (G.Px 16)].
maRule "gap-5" = G.declsCss [G.Gap (G.Px 24)].
maRule "gap-6" = G.declsCss [G.Gap (G.Px 32)].
maRule "p-3" = G.declsCss [G.Padding (G.Px 12)].
maRule "p-4" = G.declsCss [G.Padding (G.Px 16)].
maRule "p-5" = G.declsCss [G.Padding (G.Px 24)].
maRule "pt-0" = G.declsCss [G.PaddingTop (G.Px 0)].
maRule "px-3" = G.declsCss [G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12)].
maRule "py-2" = G.declsCss [G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)].
maRule "w-narrow" = G.declsCss [G.Width (G.Px 80)].
maRule "w-medium" = G.declsCss [G.Width (G.Px 160), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Px 160)].
maRule "w-wide" = G.declsCss [G.Width (G.Px 280)].
maRule "t-display" = G.declsCss [G.FontSize (G.Px 32), G.LineHeightLength (G.Px 40), G.FontWeight 600].
maRule "t-title" = G.declsCss [G.FontSize (G.Px 22), G.LineHeightLength (G.Px 28), G.FontWeight 600].
maRule "t-heading" = G.declsCss [G.FontSize (G.Px 17), G.LineHeightLength (G.Px 24), G.FontWeight 600].
maRule "t-body" = G.declsCss [G.FontSize (G.Px 15), G.LineHeightLength (G.Px 22), G.FontWeight 400].
maRule "t-caption" = G.declsCss [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400].
maRule "t-label" = G.declsCss [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500].
maRule "t-mono" = G.declsCss [G.FontFamily G.MonoFont, G.FontSize (G.Px 14), G.LineHeightLength (G.Px 20)].
maRule "tx-1" = G.declsCss [G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))].
maRule "tx-2" = G.declsCss [G.Foreground (G.ThemeColour (G.NamedToken "tx-2"))].
maRule "tx-3" = G.declsCss [G.Foreground (G.ThemeColour (G.NamedToken "tx-3"))].
maRule "tx-success" = G.declsCss [G.Foreground (G.ThemeColour (G.NamedToken "success"))].
maRule "tx-warning" = G.declsCss [G.Foreground (G.ThemeColour (G.NamedToken "warning"))].
maRule "tx-danger" = G.declsCss [G.Foreground (G.ThemeColour (G.NamedToken "danger"))].
maRule "tx-celebration" = G.declsCss [G.Foreground (G.ThemeColour (G.NamedToken "celebration"))].
maRule "bg-surface" = G.declsCss [G.Background (G.ThemeColour (G.NamedToken "bg-surface"))].
maRule "bg-raised" = G.declsCss [G.Background (G.ThemeColour (G.NamedToken "bg-raised"))].
maRule "bd-subtle" = G.declsCss [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle"))].
maRule "bd-strong" = G.declsCss [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-strong"))].
maRule "bd-success" = G.declsCss [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "success"))].
maRule "bd-warning" = G.declsCss [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "warning"))].
maRule "bd-danger" = G.declsCss [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "danger"))].
maRule "bd-celebration" = G.declsCss [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "celebration"))].
maRule "r-sm" = G.declsCss [G.Radius (G.Px 6)].
maRule "r-md" = G.declsCss [G.Radius (G.Px 10)].
maRule "r-lg" = G.declsCss [G.Radius (G.Px 16)].
maRule "r-full" = G.declsCss [G.Radius (G.Px 9999)].
maRule "sh-sm" = G.declsCss [G.ShadowToken (G.NamedToken "sh-sm")].
maRule "sh-md" = G.declsCss [G.ShadowToken (G.NamedToken "sh-md")].
maRule "sh-lg" = G.declsCss [G.ShadowToken (G.NamedToken "sh-lg")].
maRule "hr" = G.declsCss [G.BorderTop (G.Px 1) (G.ThemeColour (G.NamedToken "bd-subtle"))].
maRule "btn" = G.declsCss [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.TransitionAll 120].
maRule "btn-primary" = G.declsCss [G.Background (G.ThemeColour (G.NamedToken "ac")), G.Foreground (G.ThemeColour (G.NamedToken "tx-on")), G.BorderColour (G.ThemeColour (G.NamedToken "ac"))].
maRule "btn-danger" = G.declsCss [G.Background (G.ThemeColour (G.NamedToken "danger")), G.Foreground (G.ThemeColour (G.NamedToken "tx-on")), G.BorderColour (G.ThemeColour (G.NamedToken "danger"))].
maRule "chip" = G.declsCss [G.Background (G.ThemeColour (G.NamedToken "ac-subtle")), G.Foreground (G.ThemeColour (G.NamedToken "ac")), G.Radius (G.Px 9999), G.PaddingY (G.Px 4), G.PaddingX (G.Px 12)].
maRule "badge" = G.declsCss [G.Radius (G.Px 9999), G.PaddingY (G.Px 4), G.PaddingX (G.Px 12), G.Background (G.ThemeColour (G.NamedToken "bg-surface"))].
maRule c = "".

# ============================================================================
# actor.fpr -- std.actor: the mailbox contract.
#
# A mailbox has a CAPACITY, chosen at spawn:
#
#   Static n    rings of n messages per sender channel that never grow --
#               a bound you can reason about (WCET, a driver's queue)
#   Dynamic n   rings that start at n and double when full, from the
#               buddy -- a burst costs memory, never messages
#
# `spawn` is Static 64.  Services -- anything many actors send to --
# spawn Dynamic; use Static only where you are sure the queue cannot
# need to grow and want the bound.
#
# And `send` ANSWERS: Result Unit String.  Ok means queued; Err
# "mailbox full" means a Static ring had no room (or a Dynamic one could
# not grow); Err "dead actor" means the target has exited.  The runtime
# never waits for space.  The sender chooses what a refusal means --
# retry, back off, drop, die -- and this module carries the common
# policies.  Most code does not call send directly: MVU, the services
# and the drivers wrap it, and they choose.
#
#   AC = use "../std/actor".
#   fs = AC.spawnWith (AC.Dynamic 64) (QL.actor dev);
#   AC.sendOrDie who msg          # the old behaviour, explicitly
#   AC.sendRetry me who msg 8     # yield between tries, Result back
# ============================================================================

Cap = Type (Static n | Dynamic n).

spawnWith cap f = case cap of
    Static n -> spawnCap 0 n f
  | Dynamic n -> spawnCap 1 n f.
spawnWithOn hart cap f = case cap of
    Static n -> spawnCapOn hart 0 n f
  | Dynamic n -> spawnCapOn hart 1 n f.

# did it go?
sent r = case r of Ok u -> True | Err e -> False.

# a refusal is fatal here: for the places where losing the message is
# worse than stopping (a service's own reply, a driver's one command)
sendOrDie who m = case send who m of
    Ok u -> u
  | Err e -> error "send: {e}".

# up to n retries with a yield between (the sender gives its hart away
# so the receiver can drain); the last Result comes back
sendRetry me who m 0 = send who m.
sendRetry me who m n = case send who m of
    Ok u -> Ok u
  | Err e ->
    _ = yield me;
    sendRetry me who m (n - 1).

# std/order.fpr -- Ordering, and comparators as ordinary functions.
#
#   Order = use "std/order".
#   List.sortWith Order.string names
#   List.sortWith (Order.by size Order.int |> Order.reverse) files
#
# There is no type-class hierarchy: what sorts, and what keys a Map, is a
# function `a -> a -> Ordering` you pass.  These build the common ones.

Ordering = Type (Less | Equal | Greater).

int : Int -> Int -> Ordering .
int a b = case a < b of True -> Less | False -> (case a == b of True -> Equal | False -> Greater).

# bytewise; a prefix sorts first
string : String -> String -> Ordering .
string a b = fromInt (strCmp a b).

# a negative, zero or positive number, as C's comparators answer
fromInt : Int -> Ordering .
fromInt n = case n < 0 of True -> Less | False -> (case n == 0 of True -> Equal | False -> Greater).

reverse : (a -> a -> Ordering) -> a -> a -> Ordering .
reverse cmp a b = cmp b a.

# compare by a key: Order.by size Order.int
by : (a -> k) -> (k -> k -> Ordering) -> a -> a -> Ordering .
by key cmp a b = cmp (key a) (key b).

# `first`, and `second` only to break its ties
thenBy : (a -> a -> Ordering) -> (a -> a -> Ordering) -> a -> a -> Ordering .
thenBy second first a b = case first a b of Equal -> second a b | o -> o.

isLess : Ordering -> Bool .
isLess o = case o of Less -> True | _ -> False.

min : (a -> a -> Ordering) -> a -> a -> a .
min cmp a b = case cmp b a of Less -> b | _ -> a.

max : (a -> a -> Ordering) -> a -> a -> a .
max cmp a b = case cmp b a of Greater -> b | _ -> a.

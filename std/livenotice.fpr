# Optional browser MVU reload status. Keep this state in the model, exclude it
# from persistence, project .text, and include view projectedText in the tree.
# Call adopted ONLY after the reload gate and binder succeed for a new hash.
# While pending, an internal Live.Every subscription should call tick.
Clock = use "std/clock".
G = use "std/view".

Notice = {enabled : Bool, durationMs : Int, text : String, untilUs : Int}.
init : Bool -> Int -> Notice .
init enabled durationMs = {enabled = enabled, durationMs = (case durationMs > 0 of True -> durationMs | False -> 0), text = "", untilUs = 0}.
pending : Notice -> Bool .
pending notice = notice.text != "".
adopted : String -> String -> Notice -> Notice .
adopted name hash notice = case notice.enabled and notice.durationMs > 0 of
    False -> notice
  | True -> adoptedAt (Clock.monotonic Unit) (Clock.now Unit) name hash notice.
# Explicit clocks keep formatting and deadline behavior independently testable.
adoptedAt : Int -> Int -> String -> String -> Notice -> Notice .
adoptedAt mono utc name hash notice = case notice.enabled and notice.durationMs > 0 of
    False -> notice
  | True -> {notice | text = "Live Reload new {name}#{hash} {Clock.iso utc}",
                     untilUs = mono + notice.durationMs * 1000}.
tick : Notice -> Notice .
tick notice = expireAt (Clock.monotonic Unit) notice.
expireAt : Int -> Notice -> Notice .
expireAt mono notice = case pending notice and mono >= notice.untilUs of
    True -> {notice | text = "", untilUs = 0}
  | False -> notice.

# Fixed shape: only the escaped text slot changes on adoption/expiry.
view : String -> G.Node .
view text = G.El "div" [G.Cls "fpr-reload-notice", G.Att "role" "status",
  G.Att "aria-live" "polite", G.Att "aria-atomic" "true"] [G.Dyn text].
css = ".fpr-reload-notice\{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:10000;max-width:calc(100vw - 40px);padding:12px 18px;border-radius:16px;background:#172132;color:#fff;box-shadow:0 6px 24px #0004;font:13px/1.5 system-ui;overflow-wrap:anywhere;pointer-events:none}.fpr-reload-notice:has(>[data-slot]:empty)\{display:none}".

# ============================================================================
# std/lens.fpr -- std.lens: the library half of first-class paths
# (docs/PATHS.md; the compiler half is the @Shape.path literal rewrite).
#
# A Path is an ORDINARY record value the compiler mints from a literal:
#
#   { get : s -> a, set : a -> s -> s, segs : List String }
#
# and a SCHEMA (@Shape, bare) is the flattened list of every string-
# addressable leaf:
#
#   { path : String, tag : "int"|"str",
#     get : s -> String, set : String -> s -> s }
#
# This module supplies what the literal rule deliberately does not:
# composition, and the STRING tier -- resolving a dotted path at
# runtime against the schema and applying it, leaf values parsed and
# rendered by tag.  Both tiers apply the SAME compiler-built closures,
# so a parsed path and a literal path are indistinguishable downstream.
#
#   L = use "../std/lens".
#
#   hpUi  = L.comp p q                     # Path s a -> Path a b -> Path s b
#   r     = L.find sch "ui.fg"             # Result entry String
#   m2    = L.set sch "ui.fg" "7" m        # Result model String (bad path -> Err,
#   s     = L.get sch "ui.fg" m            # Result String String  model untouched)
#   m3    = L.setWords sch "ui.fg 7" m     # the WIRE form: "path value...",
#                                          # value = everything after the first
#                                          # space (a note's text may have spaces)
#
# The wire contract (the MVU debug port speaks this): a set is
# ("set", "<path> <value>"), resolved HERE, inside the model's single
# writer -- a bad path or unparsable value refuses transactionally
# (Err, model unchanged), no backdoor into the model.
# ============================================================================

# ---- composition -----------------------------------------------------------

comp p q =
  { get = fn s -> q.get (p.get s),
    set = fn v s -> p.set (q.set v (p.get s)) s,
    segs = catL p.segs q.segs }.

catL : (xs : List a | measure xs) -> List a -> List a .
catL xs ys = case xs of Nil -> ys | x :: r -> x :: catL r ys.

# ---- string equality (byte strings; strlen-bounded walk) -------------------

strEq : unsafe String -> String -> Bool .
strEq a b = case strlen a == strlen b of
    False -> False
  | True -> strEqAt a b 1.
strEqAt : unsafe String -> String -> Int -> Bool .
strEqAt a b i = case i > strlen a of
    True -> True
  | False -> case charAt a i == charAt b i of
      True -> strEqAt a b (i + 1)
    | False -> False.

# ---- the string tier -------------------------------------------------------

# find the schema entry for a dotted path
find : unsafe List _ -> String -> Result _ String .
find es p = case es of
    Nil -> Err "no schema leaf '{p}'"
  | e :: r -> case strEq e.path p of True -> Ok e | False -> find r p.

# set a leaf from its string form; Err leaves the model untouched
set : unsafe List _ -> String -> String -> _ -> Result _ String .
set es p v m = case find es p of
    Err e -> Err e
  | Ok en -> Ok (en.set v m).

# read a leaf, rendered to its string form
get : unsafe List _ -> String -> _ -> Result String String .
get es p m = case find es p of
    Err e -> Err e
  | Ok en -> Ok (en.get m).

# the wire form: "path value..." -- value is everything after the
# FIRST space (values may contain spaces; "path" alone -> Err)
setWords : unsafe List _ -> String -> _ -> Result _ String .
setWords es pv m =
  cut = spaceAt pv 1;
  case cut == 0 of
    True -> Err "set: want 'path value', got '{pv}'"
  | False -> set es (substr pv 1 (cut - 1)) (substr pv (cut + 1) (strlen pv - cut)) m.
spaceAt : unsafe String -> Int -> Int .
spaceAt s i = case i > strlen s of
    True -> 0
  | False -> case charAt s i == 32 of
      True -> i
    | False -> spaceAt s (i + 1).

# render every leaf as "path=value" lines -- the generic INSPECTOR:
# walk the schema, no per-app code
dump : unsafe List _ -> _ -> String -> String .
dump es m acc = case es of
    Nil -> acc
  | e :: r -> dump r m "{acc}{e.path}={e.get m}\n".

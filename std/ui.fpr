# std/ui.fpr -- UI: layout and appearance as the application's own words.
#
#   UI = use "std/ui".
#   page model = UI.page UI.day { UI.stack | gap = 4 } [
#       UI.hstack { UI.stack | justify = Between, align = Center } [
#           UI.label { UI.txt | size = Title } "Inventory",
#           UI.button { UI.btn | kind = Primary } [G.send codec Save] "Save" ],
#       UI.card UI.panel [ UI.text UI.txt model.note ] ].
#
# A page is columns and rows (`vstack`, `hstack`), text with a role, buttons
# with a kind, inputs, cards, and a page root that owns the theme scope.  Each
# node takes an ATTRIBUTE RECORD and children; a call overrides the fields it
# cares about by record update (`{ UI.stack | gap = 3 }`) and the defaults
# (`stack`, `txt`, `btn`, `field`, `panel`) are ordinary values.  Sizes are
# steps on the spacing scale, never pixels; colours are tones of the theme;
# the type scale is a role.  An application names no tag, class or CSS
# property: every node lowers to the typed `std/view` tree (utilities on the
# element, variants as Narrow/Wide/Hover utilities), so the stylesheet
# generator, the live diff, keys and inputs are the ones std/view has.
# The tokens (tx-1, bg-surface, bd-subtle, ac, danger, ...) came from the Ma
# design system (std/ma, retired 2026-10-15), whose element reset, spacing
# scale and stylesheet are this module's now.
# docs/2026-10-15-DESIGN-GOALS-REVIEW.md is the direction; the record is
# docs/2026-10-15-STD-UI.md.
G = use "view".
L = use "list".

# ---- the element and the scale --------------------------------------------------
# every node is an element with the box reset (border-box, no margin, the
# page's face); a button also shows it is one under the pointer
element : String -> List G.Attr -> List G.Node -> G.Node .
element tag attrs kids = G.El tag (G.utilities [G.BoxSizing G.BorderBox, G.Margin (G.Px 0), G.FontFamily G.InheritFont] ::
  (if tag == "button" then G.hover [G.BorderColour (G.ThemeColour (G.NamedToken "bd-strong")), G.Background (G.ThemeColour (G.NamedToken "ac-subtle"))] :: attrs else attrs)) kids.
# the spacing scale: a gap or a pad is a step on it, never pixels
spacing : Int -> Int .
spacing n = case n of 0 -> 0 | 1 -> 4 | 2 -> 8 | 3 -> 12 | 4 -> 16 | 5 -> 24 | _ -> 32.

# ---- vocabulary ---------------------------------------------------------------
Align = Type (Start | Center | End | Stretch | Baseline).
Justify = Type (Lead | Middle | Trail | Between | Around | Evenly).
# how a stack takes room: its content's, all it can (in its parent's main
# axis), the full width, or the viewport (and the body stops scrolling)
# `Reading`: a reading column, capped and centred (the page's measure)
# `Reading`: a reading column (640px), `Broad`: a broader one (760px), both capped and centred
Fill = Type (Natural | Grow | Wide | Screen | Slim | Reading | Broad).
# `Overline`: the small upper-case label over a field or a tile
Scale = Type (Hero | Title | Heading | Body | Strong | Caption | Tag | Mono | Overline).
Tone = Type (Ink | Muted | Faint | Accent | Danger | Success | Warning | OnAccent).
# `Chip`: a small accent pill (a tag, a filter)
# `Pill`: a rounded secondary button (a tab, a sort, a filter); `Destructive` is
# a danger button; `Chip` a small accent pill (a tag)
Kind = Type (Plain | Primary | Quiet | Destructive | Chip | Pill).
# what a variant may change (the same words as the records)
# `Inverted`: ink on canvas (a selected tab); `Dimmed`: faded and inert (a pager
# at its end); `Rigid`: keeps its size in a scrolling row
# `Stacked`: a row becomes a column (on a narrow screen)
Tweak = Type (GapOf Int | PadOf Int | Hidden | Shown | WrapOf Bool | AlignOf Align | JustifyOf Justify | FillOf Fill | Inverted | Dimmed | Rigid | Stacked).
# a variant: on a narrow screen (<= 760px), a wide one, or under the pointer
# `Always`: no condition; `onState @Client.tab Receipts`: while the page holds
# that value in that client field (std/view's localStyle: a selected tab, the
# current sort).  OnState carries the field's name and the value's text, as
# std/view's client state holds them.
Variant = Type (Always (List Tweak) | OnNarrow (List Tweak) | OnWide (List Tweak) | OnHover (List Tweak) | OnState String String (List Tweak)).
onState : { segs : List String, enc : a -> Wire | r } -> a -> List Tweak -> Variant .
onState path value ts = OnState (G.localName path) (G.textOf path value) ts.

# ---- the theme -------------------------------------------------------------------
# A LOOK (the theme as a value; `Theme` is std/view's token record): the colours
# of the roles a page uses, a type face and a backdrop.  `day` and `night` are std/ma's palettes; an application makes its
# own by record update (`{ UI.day | accent = G.Rgb 0 90 200 }`).  `page` turns
# it into the inherited token scope every tone and surface reads.
Look = { canvas : G.Colour, surface : G.Colour, raised : G.Colour, line : G.Colour, lineStrong : G.Colour,
          ink : G.Colour, dim : G.Colour, faint : G.Colour, accent : G.Colour, accentInk : G.Colour, accentSubtle : G.Colour,
          success : G.Colour, warning : G.Colour, danger : G.Colour,
          face : G.Typeface, textSize : Int, lineHeight : Int, backdrop : List G.BackgroundImage, dark : Bool }.
day : Look .
day = { canvas = G.Rgb 247 248 250, surface = G.Rgb 255 255 255, raised = G.Rgb 255 255 255, line = G.Rgb 228 231 236, lineStrong = G.Rgb 199 204 214,
        ink = G.Rgb 26 29 35, dim = G.Rgb 91 100 114, faint = G.Rgb 138 147 163, accent = G.Rgb 61 111 224, accentInk = G.Rgb 255 255 255, accentSubtle = G.Rgb 234 240 254,
        success = G.Rgb 46 158 107, warning = G.Rgb 201 138 46, danger = G.Rgb 209 78 78,
        face = G.SystemFont, textSize = 15, lineHeight = 147, backdrop = Nil, dark = False }.
night : Look .
night = { day | canvas = G.Rgb 21 23 28, surface = G.Rgb 29 32 39, raised = G.Rgb 36 40 48, line = G.Rgb 42 47 56, lineStrong = G.Rgb 58 64 76,
          ink = G.Rgb 237 239 243, dim = G.Rgb 154 163 178, faint = G.Rgb 107 114 128, accent = G.Rgb 91 138 240, accentSubtle = G.Rgb 30 42 69,
          success = G.Rgb 76 190 135, warning = G.Rgb 224 169 79, danger = G.Rgb 232 112 111, dark = True }.
# the token scope a look defines (the names every tone and surface reads)
themeDecls : Look -> List G.Decl .
themeDecls t = L.append
  (L.map (fn pair -> case pair of (name, colour) -> G.DefineColour (G.NamedToken name) colour)
    [("bg-canvas", t.canvas), ("bg-surface", t.surface), ("bg-raised", t.raised), ("bd-subtle", t.line), ("bd-strong", t.lineStrong),
     ("tx-1", t.ink), ("tx-2", t.dim), ("tx-3", t.faint), ("ac", t.accent), ("ac-hover", t.accent), ("ac-press", t.accent), ("ac-subtle", t.accentSubtle),
     ("tx-on", t.accentInk), ("success", t.success), ("warning", t.warning), ("danger", t.danger), ("celebration", t.success)])
  (if t.dark then
    [G.DefineShadows (G.NamedToken "sh-sm") [shadow 1 2 0 0 0 30], G.DefineShadows (G.NamedToken "sh-md") [shadow 4 12 0 0 0 35], G.DefineShadows (G.NamedToken "sh-lg") [shadow 12 32 0 0 0 45]]
   else
    [G.DefineShadows (G.NamedToken "sh-sm") [shadow 1 2 30 41 59 6, shadow 1 1 30 41 59 4], G.DefineShadows (G.NamedToken "sh-md") [shadow 4 12 30 41 59 8], G.DefineShadows (G.NamedToken "sh-lg") [shadow 12 32 30 41 59 12]]).
shadow : Int -> Int -> Int -> Int -> Int -> Int -> G.ShadowPart .
shadow y blur r g b a = G.ShadowPart (G.Px 0) (G.Px y) (G.Px blur) (G.Px 0) (G.RgbaPercent r g b a).

# ---- records and their defaults ----------------------------------------------
# `scroll`: the content scrolls inside; `scrollX`: a row that scrolls sideways (chips on a phone)
Stack = { gap : Int, pad : Int, align : Align, justify : Justify, fill : Fill, wrap : Bool, scroll : Bool, scrollX : Bool, vary : List Variant }.
stack : Stack .
stack = { gap = 0, pad = 0, align = Stretch, justify = Lead, fill = Natural, wrap = False, scroll = False, scrollX = False, vary = Nil }.
# `pre`: the text keeps its line breaks; `hideEmpty`: the node hides while
# its dynamic slot is empty (std/view's data-hide-empty)
# `tabular`: digits of one width (a count that changes); `fill`: the room it takes in its row
Txt = { size : Scale, tone : Tone, align : Align, wrap : Bool, pre : Bool, hideEmpty : Bool, tabular : Bool, fill : Fill, vary : List Variant }.
txt : Txt .
txt = { size = Body, tone = Ink, align = Start, wrap = True, pre = False, hideEmpty = False, tabular = False, fill = Natural, vary = Nil }.
# `tall`: a thumb-sized target (44px) for a primary action on a phone
Btn = { kind : Kind, size : Scale, tall : Bool, vary : List Variant }.
btn : Btn .
btn = { kind = Plain, size = Tag, tall = False, vary = Nil }.
# what the browser is told about an input: its kind, what it may suggest (the
# autocomplete token: "username", "current-password", "new-password", "off"),
# its longest value (0: unbounded), whether to capitalise or spell-check
FieldKind = Type (TextField | Password | Search | HiddenField).
Field = { size : Scale, fill : Fill, rows : Int, placeholder : String, kind : FieldKind, suggest : String, maxLength : Int, caps : Bool, spell : Bool, vary : List Variant }.
field : Field .
field = { size = Body, fill = Wide, rows = 1, placeholder = "", kind = TextField, suggest = "", maxLength = 0, caps = True, spell = True, vary = Nil }.
# `tile`: a small stat tile that keeps a minimum width in a wrapping row
Panel = { gap : Int, pad : Int, raised : Bool, tile : Bool, vary : List Variant }.
panel : Panel .
panel = { gap = 3, pad = 4, raised = False, tile = False, vary = Nil }.

# ---- layout ------------------------------------------------------------------
vstack : Stack -> List G.Node -> G.Node .
vstack s kids = box G.Column s Nil kids.
hstack : Stack -> List G.Node -> G.Node .
hstack s kids = box G.Row s Nil kids.
# the same with std/view attributes (a key, locals, showIf, events) on the node
vstackWith : Stack -> List G.Attr -> List G.Node -> G.Node .
vstackWith s attrs kids = box G.Column s attrs kids.
hstackWith : Stack -> List G.Attr -> List G.Node -> G.Node .
hstackWith s attrs kids = box G.Row s attrs kids.
# a column whose content scrolls inside it
scroll : Stack -> List G.Node -> G.Node .
scroll s kids = box G.Column { s | scroll = True } Nil kids.
# a row of a list (a receipt, a product): a hairline under it, a little room
# above and below, a height it keeps, and it never shrinks when the list is
# squeezed; `listItem` is the same as a column (a row that opens)
listRow : Stack -> List G.Attr -> List G.Node -> G.Node .
listRow s attrs kids = box G.Row s (ruledAttr :: attrs) kids.
listItem : Stack -> List G.Attr -> List G.Node -> G.Node .
listItem s attrs kids = box G.Column s (ruledAttr :: attrs) kids.
ruledAttr : G.Attr .
ruledAttr = G.utilities [G.BorderBottom (G.Px 1) (G.ThemeColour (G.NamedToken "bd-subtle")), G.PaddingY (G.Px 6), G.MinHeight (G.Px 44),
  G.FlexGrow 0, G.FlexShrink 0, G.Basis G.Auto].
# nothing: the node a branch renders when it has nothing to show
none : Unit -> G.Node .
none u = G.El "span" Nil Nil.
# the filler between siblings
space : Unit -> G.Node .
space u = element "div" [G.utilities [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0)]] Nil.
# a stable identity among siblings (std/view's key)
keyed : String -> G.Node -> G.Node .
keyed k n = G.key k n.

box : G.FlexDirection -> Stack -> List G.Attr -> List G.Node -> G.Node .
box dir s attrs kids = element "div" (G.utilities (stackDecls dir s) :: L.append (variants s.vary) attrs) kids.

stackDecls : G.FlexDirection -> Stack -> List G.Decl .
stackDecls dir s = L.concat [
  [G.Display G.Flex, G.Direction dir, G.Gap (G.Px (spacing s.gap))],
  (if s.pad == 0 then Nil else [G.Padding (G.Px (spacing s.pad))]),
  [G.AlignItems (alignOf s.align), G.JustifyContent (justifyOf s.justify)],
  fillDecls s.fill,
  (if s.wrap then [G.FlexWrap G.Wrap, G.AlignContent G.AlignStart] else Nil),
  (if s.scroll then [G.Overflow G.OverflowAuto, G.MinHeight (G.Px 0), G.MinWidth (G.Px 0)] else Nil),
  (if s.scrollX then [G.OverflowX G.OverflowAuto, G.PaddingBottom (G.Px 4), G.ScrollbarWidth G.ScrollbarThin] else Nil)].

alignOf : Align -> G.Alignment .
alignOf a = case a of Start -> G.AlignStart | Center -> G.AlignCenter | End -> G.AlignEnd | Stretch -> G.AlignStretch | Baseline -> G.AlignBaseline.
justifyOf : Justify -> G.Justification .
justifyOf j = case j of Lead -> G.JustifyStart | Middle -> G.JustifyCenter | Trail -> G.JustifyEnd | Between -> G.SpaceBetween | Around -> G.SpaceAround | Evenly -> G.SpaceEvenly.
fillDecls : Fill -> List G.Decl .
fillDecls f = case f of
    Natural -> Nil
  | Grow -> [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0), G.MinHeight (G.Px 0), G.MinWidth (G.Px 0)]
  | Wide -> [G.Width (G.Pct 100)]
  | Screen -> [G.Height (G.Vh 100), G.Height (G.Dvh 100), G.Width (G.Vw 100), G.MaxWidth (G.Vw 100), G.Overflow G.OverflowHidden]
  | Slim -> [G.MaxWidth (G.Px 420), G.MarginX G.Auto, G.Width (G.Pct 100)]
  | Reading -> [G.MaxWidth (G.Px 640), G.MarginX G.Auto, G.Width (G.Pct 100)]
  | Broad -> [G.MaxWidth (G.Px 760), G.MarginX G.Auto, G.Width (G.Pct 100)].
textAlignOf : Align -> G.TextAlignment .
textAlignOf a = case a of Center -> G.TextCenter | End -> G.TextEnd | _ -> G.TextStart.

# ---- variants ----------------------------------------------------------------
variants : List Variant -> List G.Attr .
variants vs = L.map variant vs.
variant : Variant -> G.Attr .
variant v = case v of
    Always ts -> G.utilities (tweaks ts)
  | OnNarrow ts -> G.narrow (tweaks ts)
  | OnWide ts -> G.wide (tweaks ts)
  | OnHover ts -> G.hover (tweaks ts)
  | OnState name value ts -> G.localStyle name value (tweaks ts).
tweaks : List Tweak -> List G.Decl .
tweaks ts = L.concat (L.map tweak ts).
tweak : Tweak -> List G.Decl .
tweak t = case t of
    GapOf n -> [G.Gap (G.Px (spacing n))]
  | PadOf n -> [G.Padding (G.Px (spacing n))]
  | Hidden -> [G.Display G.Hidden]
  | Shown -> [G.Display G.Flex]
  | WrapOf w -> [G.FlexWrap (if w then G.Wrap else G.NoWrap)]
  | AlignOf a -> [G.AlignItems (alignOf a)]
  | JustifyOf j -> [G.JustifyContent (justifyOf j)]
  | FillOf f -> fillDecls f
  | Inverted -> [G.Background (G.ThemeColour (G.NamedToken "tx-1")), G.Foreground (G.ThemeColour (G.NamedToken "bg-canvas")), G.BorderColour (G.ThemeColour (G.NamedToken "tx-1"))]
  | Dimmed -> [G.Opacity 35, G.PointerEvents G.PointerNone]
  | Rigid -> [G.FlexGrow 0, G.FlexShrink 0, G.Basis G.Auto]
  | Stacked -> [G.Display G.Flex, G.Direction G.Column].

# ---- text --------------------------------------------------------------------
# `label`: fixed text, part of the page's statics.  `text`: a value from the
# model, a dynamic slot that updates by delta.
label : Txt -> String -> G.Node .
label t s = labelWith t Nil s.
text : Txt -> String -> G.Node .
text t v = textWith t Nil v.
# the same with std/view attributes on the node (an id a script scrolls to)
labelWith : Txt -> List G.Attr -> String -> G.Node .
labelWith t attrs s = element "div" (L.append (textAttrs t) attrs) [G.Txt s].
textWith : Txt -> List G.Attr -> String -> G.Node .
textWith t attrs v = element "div" (L.append (textAttrs t) attrs) [G.Dyn v].
# the page's own value of a client field (`@Client.open`, an entry), shown where it is
local : Txt -> { segs : List String | r } -> G.Node .
local t path = localWith t Nil path.
localWith : Txt -> List G.Attr -> { segs : List String | r } -> G.Node .
localWith t attrs path = element "div" (L.append (textAttrs t) attrs) [G.text path].
textAttrs : Txt -> List G.Attr .
textAttrs t = L.append (if t.hideEmpty then [G.hideEmpty] else Nil) (G.utilities (textDecls t) :: variants t.vary).
textDecls : Txt -> List G.Decl .
textDecls t = L.concat [scaleDecls t.size, [G.Foreground (tone t.tone), G.TextAlign (textAlignOf t.align)], fillDecls t.fill,
  (if t.tabular then [G.Numerals G.TabularNumerals] else Nil),
  (if t.wrap then Nil else [G.WhiteSpace G.NoWrapSpace, G.Overflow G.OverflowHidden, G.TextOverflow G.Ellipsis]),
  (if t.pre then [G.WhiteSpace G.PreWrapSpace, G.WordWrap G.WrapAnywhere] else Nil)].
# the type scale (std/ma's tokens.json roles)
scaleDecls : Scale -> List G.Decl .
scaleDecls s = case s of
    Hero -> [G.FontSize (G.Px 32), G.LineHeightLength (G.Px 40), G.FontWeight 600]
  | Title -> [G.FontSize (G.Px 22), G.LineHeightLength (G.Px 28), G.FontWeight 600]
  | Heading -> [G.FontSize (G.Px 17), G.LineHeightLength (G.Px 24), G.FontWeight 600]
  | Body -> [G.FontSize (G.Px 15), G.LineHeightLength (G.Px 22), G.FontWeight 400]
  | Strong -> [G.FontSize (G.Px 15), G.LineHeightLength (G.Px 22), G.FontWeight 600]
  | Caption -> [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 400]
  | Tag -> [G.FontSize (G.Px 13), G.LineHeightLength (G.Px 18), G.FontWeight 500]
  | Mono -> [G.FontFamily G.MonoFont, G.FontSize (G.Px 14), G.LineHeightLength (G.Px 20), G.FontWeight 400]
  | Overline -> [G.FontSize (G.Px 11), G.LineHeightLength (G.Px 16), G.FontWeight 500, G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180)].
tone : Tone -> G.Colour .
tone t = G.ThemeColour (G.NamedToken (case t of
    Ink -> "tx-1" | Muted -> "tx-2" | Faint -> "tx-3" | Accent -> "ac"
  | Danger -> "danger" | Success -> "success" | Warning -> "warning" | OnAccent -> "tx-on")).

# ---- controls ------------------------------------------------------------------
# the events are std/view's typed ones: `G.send codec Msg`, `G.sendWith codec
# Msg @Client.field`, `G.setTo @Client.open "1"`; the message VALUE travels
button : Btn -> List G.Attr -> String -> G.Node .
button b events s = element "button" (G.utilities (buttonDecls b) :: L.append (variants b.vary) events) [G.Txt s].
buttonDecls : Btn -> List G.Decl .
buttonDecls b = L.concat [
  [G.Cursor G.PointerCursor, G.TransitionAll 120],
  (case b.kind of
      Chip -> [G.Radius (G.Px 9999), G.PaddingY (G.Px 4), G.PaddingX (G.Px 12)]
    | Pill -> [G.Radius (G.Px 9999), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12)]
    | _ -> [G.Radius (G.Px 6), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12)]),
  (if b.tall then [G.MinHeight (G.Px 44)] else Nil),
  scaleDecls b.size,
  (case b.kind of
      Plain -> [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")),
                G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1"))]
    | Primary -> [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "ac")),
                  G.Background (G.ThemeColour (G.NamedToken "ac")), G.Foreground (G.ThemeColour (G.NamedToken "tx-on"))]
    | Quiet -> [G.BorderStyle G.NoBorder, G.Background G.Transparent, G.Foreground (G.ThemeColour (G.NamedToken "tx-2"))]
    | Destructive -> [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "danger")),
                      G.Background (G.ThemeColour (G.NamedToken "danger")), G.Foreground (G.ThemeColour (G.NamedToken "tx-on"))]
    | Chip -> [G.BorderStyle G.NoBorder, G.Background (G.ThemeColour (G.NamedToken "ac-subtle")), G.Foreground (G.ThemeColour (G.NamedToken "ac"))]
    | Pill -> [G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")),
               G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (G.ThemeColour (G.NamedToken "tx-2"))])].

# a text input; `rows > 1` is a text area.  The binding and the send are
# std/view's (`G.bind @Client.q`, `G.enterWith codec Search @Client.q`).
input : Field -> List G.Attr -> G.Node .
input f attrs = if f.rows > 1
  then element "textarea" (L.append (fieldAttrs f) (G.Att "rows" (str f.rows) :: attrs)) Nil
  else G.Inp (G.utilities [G.BoxSizing G.BorderBox, G.Margin (G.Px 0)] :: L.append (fieldAttrs f) attrs).
fieldAttrs : Field -> List G.Attr .
fieldAttrs f = L.concat [[G.utilities (fieldDecls f), G.focus [G.BorderColour (G.ThemeColour (G.NamedToken "ac"))]],
  (if strlen f.placeholder == 0 then Nil else [G.Att "placeholder" f.placeholder]),
  (case f.kind of TextField -> Nil | Password -> [G.Att "type" "password"] | Search -> [G.Att "type" "search"] | HiddenField -> [G.Att "type" "hidden"]),
  (if strlen f.suggest == 0 then Nil else [G.Att "autocomplete" f.suggest]),
  (if f.maxLength <= 0 then Nil else [G.Att "maxlength" (str f.maxLength)]),
  (if f.caps then Nil else [G.Att "autocapitalize" "none"]),
  (if f.spell then Nil else [G.Att "spellcheck" "false"]),
  variants f.vary].
# an input under its small label (a `label` element: tapping the label focuses the input)
labelled : String -> G.Node -> G.Node .
labelled name kid = G.El "label" [G.utilities [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 4), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0), G.MinWidth (G.Px 0)]]
  [label { txt | size = Overline, tone = Muted } name, kid].
fieldDecls : Field -> List G.Decl .
# an input's text is never under 16px (a phone zooms into a smaller one), and
# an input is never shorter than the 44px a finger needs
fieldDecls f = L.concat [scaleDecls f.size,
  (case f.size of Body -> [G.FontSize (G.Px 16)] | Strong -> [G.FontSize (G.Px 16)] | Caption -> [G.FontSize (G.Px 16)] | Tag -> [G.FontSize (G.Px 16)] | Mono -> [G.FontSize (G.Px 16)] | _ -> Nil),
  (case f.size of Mono -> Nil | _ -> [G.FontFamily G.SystemFont]), fillDecls f.fill,
  [G.MinHeight (G.Px 44), G.Radius (G.Px 8), G.PaddingY (G.Px 10), G.PaddingX (G.Px 12), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder,
   G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")), G.Background (G.ThemeColour (G.NamedToken "bg-surface")),
   G.Foreground (G.ThemeColour (G.NamedToken "tx-1")), G.Resize G.VerticalResize, G.OutlineWidth (G.Px 0)]].

# a small upper-case pill that names a state or a place, in a tone; `status`
# is the same with a value from the model (a dynamic slot), as `text` is to `label`
badge : Tone -> String -> G.Node .
badge t s = badgeWith t Nil s.
badgeWith : Tone -> List G.Attr -> String -> G.Node .
badgeWith t attrs s = element "span" (badgeAttrs t attrs) [G.Txt s].
status : Tone -> List G.Attr -> String -> G.Node .
status t attrs v = element "span" (badgeAttrs t attrs) [G.Dyn v].
badgeAttrs : Tone -> List G.Attr -> List G.Attr .
badgeAttrs t attrs = G.utilities [G.Display G.InlineBlock, G.PaddingY (G.Px 2), G.PaddingX (G.Px 9), G.Radius (G.Px 9999),
  G.FontSize (G.Px 11), G.FontWeight 700, G.LetterSpacing (G.Em 60), G.TextCase G.UpperCase,
  G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (tone t), G.Foreground (tone t)] :: attrs.
# a notice from the server in a tone, hidden while it has nothing to say
toast : Tone -> String -> G.Node .
toast t v = element "div" [G.hideEmpty, G.utilities [G.PaddingY (G.Px 10), G.PaddingX (G.Px 14), G.Radius (G.Px 12),
  G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (tone t), G.Background (G.ThemeColour (G.NamedToken "bg-surface")), G.Foreground (tone t)]] [G.Dyn v].

# ---- fixed sizes, by what they hold ---------------------------------------------
# A page says what a fixed size is FOR; the numbers are std/ui's, on its 4px grid
# like the spacing scale, and in this one place.
# a column of a list row, so the rows line up: a count, a badge (centred), a
# button, a figure (an amount, an id, a short name)
Column = Type (Count | Mark | Act | Figure).
column : Column -> G.Attr .
column c = G.utilities (case c of
    Count -> [G.Width (G.Px 40)]
  | Mark -> [G.Width (G.Px 56), G.TextAlign G.TextCenter]
  | Act -> [G.Width (G.Px 72)]
  | Figure -> [G.Width (G.Px 96)]).
# a card in a wrapping grid of cards (a product): a fixed tile, two to a row on a
# phone, the grid's gap (a step of the spacing scale) shared between them
tile : Int -> List G.Attr .
tile gap = [G.utilities [G.Width (G.Px 180), G.Height (G.Px 140)], G.narrow [G.Width (G.Less (G.Pct 50) (G.Px (spacing gap / 2)))]].
# a panel beside the main region (a cart, an inspector); on a phone, docked
# below it at a share of the screen's height
side : List G.Attr .
side = [G.utilities [G.Width (G.Px 400), G.MinHeight (G.Px 0)], G.narrow [G.Basis (G.Vh 46)]].
# a short list opened in place (a receipt's lines): it scrolls past a few rows
peek : G.Attr .
peek = G.utilities [G.MaxHeight (G.Px 180)].
# a box of output (a console, a profile): a few lines at least, half the screen
# at most, scrolling inside
console : G.Attr .
console = G.utilities [G.MinHeight (G.Px 120), G.MaxHeight (G.Vh 50), G.Overflow G.OverflowAuto].
# the document's body under a std/ui page (std/live's serve...Body): no margin,
# the page has its own padding; `screenBody` for a page that is the screen
# (`fill = Screen`), whose regions scroll and which never does
body : List G.Attr .
body = [G.utilities [G.Margin (G.Px 0)]].
screenBody : List G.Attr .
screenBody = [G.utilities [G.Margin (G.Px 0), G.Overflow G.OverflowHidden]].

# ---- surfaces ----------------------------------------------------------------
card : Panel -> List G.Node -> G.Node .
card p kids = cardWith p Nil kids.
cardWith : Panel -> List G.Attr -> List G.Node -> G.Node .
cardWith p attrs kids = element "div" (G.utilities (L.concat [stackDecls G.Column { stack | gap = p.gap, pad = p.pad }, cardDecls p.raised, (if p.tile then [G.MinWidth (G.Px 96)] else Nil)]) :: L.append (variants p.vary) attrs) kids.
cardDecls : Bool -> List G.Decl .
cardDecls raised = [G.Background (G.ThemeColour (G.NamedToken (if raised then "bg-raised" else "bg-surface"))),
  G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.NamedToken "bd-subtle")),
  G.Radius (G.Px 10), G.ShadowToken (G.NamedToken (if raised then "sh-md" else "sh-sm"))].
rule : Unit -> G.Node .
rule u = element "div" [G.utilities [G.BorderTop (G.Px 1) (G.ThemeColour (G.NamedToken "bd-subtle"))]] Nil.

# ---- the page ------------------------------------------------------------------
# the root owns the theme scope (day or night tokens) and the canvas; it is a
# column like any other, so `{ stack | gap = 4, pad = 4, fill = Screen }` works
page : Look -> Stack -> List G.Node -> G.Node .
page t s kids = pageWith t s Nil kids.
pageWith : Look -> Stack -> List G.Attr -> List G.Node -> G.Node .
pageWith t s attrs kids = element "div"
  (G.utilities (themeDecls t)
   :: G.utilities (L.concat [
        [G.MinHeight (G.Vh 100), G.Background (G.ThemeColour (G.NamedToken "bg-canvas")), G.Foreground (G.ThemeColour (G.NamedToken "tx-1")),
         G.FontFamily t.face, G.FontSize (G.Px t.textSize), G.LineHeight t.lineHeight],
        (if L.isEmpty t.backdrop then Nil else [G.BackgroundImages t.backdrop, G.BackgroundAttachment G.FixedBackground, G.BackgroundRepeat G.NoRepeat]),
        stackDecls G.Column s])
   :: L.append (variants s.vary) attrs) kids.

# the stylesheet of a page: only the utilities the tree uses (std/view's generator)
css : G.Node -> String .
css tree = G.localCss (G.nub (G.allClasses tree Nil)).

# std/tcp.fpr -- Tcp: connections, and a server that gives each one an actor.
#
#   Tcp = use "std/tcp".
#   case Tcp.listen "127.0.0.1" 8080 of
#       Ok l -> Tcp.serve l (fn conn peer -> ... Stream.write reply conn ...)
#     | Err why -> ...
#
# A connection is a Stream (std/stream.fpr): read, write, close.  Waiting for
# a connection or for bytes sleeps the ACTOR, never the hart, so a server and
# its clients can live in one process -- the tests do exactly that.
# Plain TCP: there is no TLS here (std/http.fpr says what that means for HTTPS).

OS = use "osnet".
IO = use "osio".
ST = use "stream".
PL = use "poller".

Listener = Type (Listener Int).

connect : String -> Int -> Result ST.Stream String .
connect host port = case OS.connect host port of Ok f -> Ok (ST.Stream f) | Err e -> Err e.

# address "" = every interface; port 0 = any free port (ask `port` which)
listen : String -> Int -> Result Listener String .
listen addr port = case OS.listen addr port of Ok f -> Ok (Listener f) | Err e -> Err e.

port : Listener -> Int .
port l = case l of Listener f -> (case OS.localPort f of Ok p -> p | Err _ -> 0).

# the next connection and who it is from
accept : Listener -> Result (ST.Stream, String) String .
accept l = case l of Listener f -> acceptGo f 100.
acceptGo : unsafe Int -> Int -> Result (ST.Stream, String) String .
acceptGo f wait = case IO.ready f of
    False -> _ = Sys.sleepUs wait; acceptGo f (if wait >= 4000 then 4000 else wait * 2)
  | True -> (case OS.accept f of
        Ok (c, peer) -> Ok (ST.Stream c, peer)
      | Err why -> (if why == "again" then acceptGo f 100 else
          if busy why then _ = shortage why; acceptGo f 100 else Err why)).

# accept failed for a reason that passes (out of descriptors or buffers, a
# client that gave up first): the server keeps going.  It used to end the
# accept loop, so a server that ran out of descriptors under load stopped
# serving for good.  Said on stderr -- a limit is never silent -- and backed
# off a little, so a full table is not spun on.
busy : String -> Bool .
busy why = strIndexOf "busy: " why == 1.
shortage : String -> Unit .
shortage why = _ = Sys.stderr "tcp: accept: {substr why 7 (strlen why - 6)} (still serving)\n"; Sys.sleepUs 20000.

stop : Listener -> Result Unit String .
stop l = case l of Listener f -> IO.close f.

# accept forever; each connection gets its OWN actor running `handler conn peer`,
# and is closed when the handler returns.  Answers only when accepting fails
# for good (which `stop` from another actor causes: that is how a server is
# shut down); a shortage that passes is said on stderr and served past.
serve : Listener -> (ST.Stream -> String -> a) -> String .
serve l handler = serveGo l handler.
serveGo : unsafe Listener -> (ST.Stream -> String -> a) -> String .
serveGo l handler = case accept l of
    Err why -> why
  | Ok (conn, peer) ->
      _ = spawn (fn self -> _ = handler conn peer; ST.close conn);
      serveGo l handler.

# the same server, waiting for connections on a Poller (std/poller.fpr) instead
# of polling the listener on a timer
serveOn : PL.Poller -> Listener -> (ST.Stream -> String -> a) -> String .
serveOn p l handler = serveOnGo p l handler.
serveOnGo : unsafe PL.Poller -> Listener -> (ST.Stream -> String -> a) -> String .
serveOnGo p l handler = case l of Listener f ->
  case PL.awaitResult f p of
    Err why -> why
  | Ok _ -> (case acceptAll f handler of
      "" -> serveOnGo p l handler
    | why -> why).

# one wake, EVERY connection that is waiting: a burst must not sit in the
# kernel's backlog (128 on macOS) while we take one per poller turn.  "" = the
# backlog is empty; anything else is why accepting failed.
acceptAll : unsafe Int -> (ST.Stream -> String -> a) -> String .
acceptAll f handler = case OS.accept f of
    Ok (c, peer) ->
      _ = spawn (fn self -> _ = handler (ST.Stream c) peer; ST.close (ST.Stream c));
      acceptAll f handler
  | Err why -> (if why == "again" then "" else if busy why then _ = shortage why; "" else why).

# std/poller.fpr -- Poller: ONE actor that waits on every descriptor, so nobody
# else has to.
#
#   Poller = use "std/poller".
#   p = Poller.start Unit
#   Poller.await fd p          # this actor sleeps -- really sleeps, in its mailbox --
#                              # until fd has something to read
#
# A hart is a thread many actors share, so no actor may wait inside the kernel.
# Without a poller every waiting actor polls ITS descriptor on a timer: a
# thousand idle sessions are a thousand timers and a thousand system calls a
# tick (half a core, measured: docs/LIVE.md).  With one, the waiters block on
# their mailboxes, which costs nothing, and ONE actor makes ONE poll(2) over
# everything being waited for.
#
# `await` is one-shot, like EPOLLONESHOT: the poller tells you once and forgets
# the descriptor; you read, and ask again when you next want to wait.  It is
# level-triggered underneath, so data that arrived before you asked is not
# missed.  A descriptor that has gone bad counts as ready: the read says why.
#
# THE WAIT IS THE KERNEL'S.  The poller hands its descriptors to a host thread
# outside the hart pool (Os.watchArm, machine/posix/os.c), which blocks in
# poll(2); when something is ready the thread raises an INTERRUPT, the IRQ hart
# delivers it to a small waker actor bound with Sys.irqBind -- a device
# interrupt, as on bare metal -- and the waker tells the poller.  So an idle
# server's first byte is answered at once, and an idle poller costs nothing:
# it is blocked in `receive`, and the thread is blocked in the kernel.
#
# (It used to poll without blocking and sleep between polls, backing off to
# 5 ms: the first message after a quiet spell waited up to 5 ms for the next
# tick.  That loop is still here, for a machine that cannot start a watcher.)

OS = use "os".
M = use "map".
O = use "option".
Ord = use "order".
A = use "actor".

Poller = Type (Poller Int).

# Woke: the watcher found something ready (from the waker actor)
Req = Type (Watch fd who | Woke).
Note = Type (Readable fd).

start : Unit -> Poller .
start u = Poller (A.spawnWith (A.Dynamic 256) (fn self -> begin self)).

# a watcher and its waker, or -- when the host cannot give one -- the ticking loop
begin : unsafe Int -> Unit .
begin me = case OS.watchOpen Unit of
    Err why ->
      _ = Sys.stderr "poller: no watcher ({why}); polling on a timer instead\n";
      idle me (M.empty Ord.int) A.tidy0
  | Ok irq ->
      w = spawn (fn self -> waker me irq self);
      # the waker is bound before anything is armed: an interrupt raised for an
      # unbound source would be claimed and dropped
      m = receiveFrom me w;
      _ = drop m;
      parked me irq (M.empty Ord.int) A.tidy0.

# the interrupt's actor: bound to the watcher's irq, it turns each delivery (a
# plain Int) into a Woke for the poller -- a mailbox has one type
waker : unsafe Int -> Int -> Int -> Unit .
waker poller irq self =
  _ = Sys.irqBind irq self;
  _ = A.sendSure self poller Woke;
  waking poller irq self.
waking : unsafe Int -> Int -> Int -> Unit .
waking poller irq self =
  m = receive self;
  _ = drop m;
  _ = Sys.irqAck irq;
  _ = A.sendSure self poller Woke;
  waking poller irq self.

# blocked in `receive` between events: no timer, no tick.  Each turn takes
# everything already queued (one arm for a burst of Watches), then hands the
# watcher the descriptors still wanted.
parked : unsafe Int -> Int -> M.Map Int Int -> A.Tidy -> Unit .
parked me irq owners0 t0 = case A.tidy me (owners0, t0) of (owners, t) ->
  m = receive me;
  o2 = handle me irq m owners;
  _ = drop m;
  o3 = queued me irq o2;
  _ = OS.watchArm irq (M.keys o3);
  parked me irq o3 t.

handle me irq m owners = case m of
    Watch fd who -> M.insert fd who owners
  | Woke -> notify me (OS.watchTake irq) owners.

queued : unsafe Int -> Int -> M.Map Int Int -> M.Map Int Int .
queued me irq owners = case receiveNow me of
    Ok m -> o2 = handle me irq m owners; _ = drop m; queued me irq o2
  | Err _ -> owners.

# sleep until `fd` has something to read (or an end of stream to learn of)
await : Int -> Poller -> Unit .
await fd p = case p of Poller a ->
  me = myself 0;
  _ = A.sendSure me a (Watch fd me); # a lost Watch is a waiter that never wakes
  m = receiveFrom me a;
  _ = drop m;
  Unit.

# nothing to watch: block until somebody asks
idle : unsafe Int -> M.Map Int Int -> A.Tidy -> Unit .
idle me owners t =
  m = receive me;
  o2 = (case m of Watch fd who -> M.insert fd who owners | Woke -> owners);
  _ = drop m;
  ticking me o2 (M.keys o2) 100 t.

# watching.  One request, or one poll, per turn; the QUIET turn -- nothing asked,
# nothing ready -- builds no value at all, so it really does allocate nothing.
# Turns that did something take the (amortized) boundary.
ticking : unsafe Int -> M.Map Int Int -> List Int -> Int -> A.Tidy -> Unit .
ticking me owners fds wait t = case receiveNow me of
    Ok m ->
      o2 = (case m of Watch fd who -> M.insert fd who owners | Woke -> owners);
      _ = drop m;
      tidied me o2 t
  | Err _ -> (case OS.poll fds of
        Nil -> _ = Sys.sleepUs wait; ticking me owners fds (if wait >= 5000 then 5000 else wait * 2) t
      | ready -> tidied me (notify me ready owners) t).

tidied : unsafe Int -> M.Map Int Int -> A.Tidy -> Unit .
tidied me owners0 t0 = case A.tidy me (owners0, t0) of (owners, t) ->
  (case M.isEmpty owners of
      True -> idle me owners t
    | False -> ticking me owners (M.keys owners) 100 t).

# tell each owner once, and forget the descriptor
notify : unsafe Int -> List Int -> M.Map Int Int -> M.Map Int Int .
notify me ready owners = case ready of
    Nil -> owners
  | fd :: r -> (case M.get fd owners of
        O.Some who -> _ = A.sendSure me who (Readable fd); notify me r (M.remove fd owners)
      | O.None -> notify me r owners).

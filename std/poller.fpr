# std/poller.fpr -- Poller: ONE actor that waits on every descriptor, so nobody
# else has to.
#
#   Poller = use "std/poller".
#   p = Poller.start Unit
#   Poller.await fd p          # this actor sleeps -- really sleeps, in its mailbox --
#                              # until fd has something to read
#
# A hart is a thread many actors share, so no actor may wait inside the kernel.
# Without a poller every waiting actor polls ITS descriptor on a timer: a
# thousand idle sessions are a thousand timers and a thousand system calls a
# tick (half a core, measured: docs/2026-09-20-LIVE.md).  With one, the waiters block on
# their mailboxes, which costs nothing, and ONE actor makes ONE poll(2) over
# everything being waited for.
#
# `await` is one-shot, like EPOLLONESHOT: the poller tells you once and forgets
# the descriptor; you read, and ask again when you next want to wait.  It is
# level-triggered underneath, so data that arrived before you asked is not
# missed.  A descriptor that has gone bad counts as ready: the read says why.
#
# THE WAIT IS THE KERNEL'S.  The poller hands its descriptors to a host thread
# outside the hart pool (Os.watchArm, machine/posix/os_watch.c), which blocks in
# poll(2); when something is ready the thread raises an INTERRUPT, the IRQ hart
# delivers it to a small waker actor bound with Sys.irqBind -- a device
# interrupt, as on bare metal -- and the waker tells the poller.  So an idle
# server's first byte is answered at once, and an idle poller costs nothing:
# it is blocked in `receive`, and the thread is blocked in the kernel.
#
# (It used to poll without blocking and sleep between polls, backing off to
# 5 ms: the first message after a quiet spell waited up to 5 ms for the next
# tick.  That loop is still here, for a machine that cannot start a watcher.)

OS = use "oswatch".
M = use "map".
Ord = use "order".
A = use "actor".

Poller = Type (Poller Int).

# Stop is owner-coordinated: all registration sends must finish before stop,
# with no new waits or concurrent stops afterward. Existing waits are cancelled. Discard the Poller after stop; do not kill its actor.
Req = Type (Watch fd who | Woke | Stop who | WakerStopped).
Note = Type (Readable fd | Cancelled | Stopped).

start : Unit -> Poller .
start u = Poller (A.spawnWith (A.Dynamic 256) (fn self -> begin self)).

begin : unsafe Int -> Unit .
begin me = case OS.watchOpen Unit of
    Err why ->
      _ = Sys.stderr "poller: no watcher ({why}); polling on a timer instead\n";
      loop me 0 0 (M.empty Ord.int) A.tidy0 100
  | Ok irq ->
      w = spawn (fn self -> waker me irq self);
      m = receiveFrom me w;
      _ = drop m;
      loop me irq w (M.empty Ord.int) A.tidy0 100.

waker : unsafe Int -> Int -> Int -> Unit .
waker poller irq self =
  _ = Sys.irqBind irq self;
  _ = A.sendSure self poller Woke;
  waking poller irq self.
waking : unsafe Int -> Int -> Int -> Unit .
waking poller irq self =
  m = receive self;
  done = m == 0;
  _ = drop m;
  if done then
    _ = unbind irq;
    _ = A.sendSure self poller WakerStopped;
    Unit
  else
    _ = Sys.irqAck irq;
    _ = A.sendSure self poller Woke;
    waking poller irq self.
unbind irq = if Sys.irqUnbind irq then Unit else
  _ = Sys.sleepUs 1000;
  unbind irq.

# All waiters for a descriptor are retained, including simultaneous readers.
add fd who owners = M.insert fd (who :: M.getOr Nil fd owners) owners.
tell me people note = case people of
    Nil -> Unit
  | who :: rest -> _ = A.sendSure me who note; tell me rest note.
notify me ready owners = case ready of
    Nil -> owners
  | fd :: rest ->
      _ = tell me (M.getOr Nil fd owners) (Readable fd);
      notify me rest (M.remove fd owners).
cancel me entries = case entries of
    Nil -> Unit
  | (_, people) :: rest -> _ = tell me people Cancelled; cancel me rest.

# Host watcher blocks in receive; fallback polls only while descriptors exist.
loop me irq w owners0 t0 wait = case A.tidy me (owners0, t0) of (owners, t) ->
  if irq == 0 and not (M.isEmpty owners) then
    case receiveNow me of
      Ok m -> dispatch me irq w owners t m
    | Err _ ->
        fresh = notify me (OS.poll (M.keys owners)) owners;
        _ = Sys.sleepUs wait;
        loop me irq w fresh t (if wait >= 5000 then 5000 else wait * 2)
  else dispatch me irq w owners t (receive me).

dispatch me irq w owners t m = case m of
    Stop who ->
      _ = drop m;
      _ = cancel me (M.entries owners);
      shutdown me irq w who
  | Watch fd who ->
      fresh = add fd who owners;
      _ = drop m;
      drain me irq w fresh t
  | Woke ->
      fresh = if irq == 0 then owners else notify me (OS.watchTake irq) owners;
      _ = drop m;
      drain me irq w fresh t
  | WakerStopped -> _ = drop m; drain me irq w owners t.
drain me irq w owners t = case receiveNow me of
    Ok m -> dispatch me irq w owners t m
  | Err _ ->
      _ = if irq == 0 then Unit else OS.watchArm irq (M.keys owners);
      loop me irq w owners t 100.

# Quiesce delivery and unbind before the IRQ slot can be reused. Drain queued
# Watches and Wokes during this handshake so the waker cannot block sending.
shutdown me irq w who = if irq == 0 then finish me who else
  _ = OS.watchArm irq Nil;
  _ = A.sendSure me w 0;
  retiring me irq w who.
retiring me irq w who =
  m = receive me;
  case m of
    WakerStopped -> _ = drop m; _ = closeWatcher irq; finish me who
  | Watch fd client -> _ = drop m; _ = A.sendSure me client Cancelled; retiring me irq w who
  | Woke -> _ = drop m; retiring me irq w who
  | Stop client -> error "Poller.stop: concurrent stops are not supported".
closeWatcher irq = if OS.watchClose irq then Unit else
  _ = Sys.sleepUs 1000;
  closeWatcher irq.
finish me who = case receiveNow me of
    Ok m -> (case m of
        Watch fd client -> _ = drop m; _ = A.sendSure me client Cancelled; finish me who
      | Stop client -> error "Poller.stop: concurrent stops are not supported"
      | _ -> _ = drop m; finish me who)
  | Err _ -> _ = A.sendSure me who Stopped; Unit.

awaitResult : Int -> Poller -> Result Unit String .
awaitResult fd p = case p of Poller a ->
  me = myself 0;
  if A.sendSure me a (Watch fd me) then
    m = receiveFrom me a;
    result = case m of Readable _ -> Ok Unit | _ -> Err "poller stopped";
    _ = drop m;
    result
  else Err "poller stopped".

# Compatibility API: cancellation is explicit failure, never fake readiness.
await : Int -> Poller -> Unit .
await fd p = case awaitResult fd p of Ok u -> u | Err why -> error why.

# The owner must ensure all registration sends have completed and prevent new
# waits/concurrent stops before this call. Existing waits may finish normally
# or receive cancellation. After return, discard the handle.
stop : Poller -> Unit .
stop p = case p of Poller a ->
  me = myself 0;
  if A.sendSure me a (Stop me) then
    m = receiveFrom me a;
    _ = drop m;
    Unit
  else Unit.

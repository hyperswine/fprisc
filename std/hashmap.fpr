# std/hashmap.fpr -- HashMap: keys to values, found by their hash.
#
#   HashMap = use "std/hashmap".
#   counts = words |> List.fold (fn m w -> HashMap.update w bump m) HashMap.strings   # a HashMap.Map String Int
#   HashMap.get "cat" counts
#
# The contracts:
#   * keys are hashed by a function you give once, when the map is made
#     (`HashMap.strings` and `HashMap.ints` use the runtime's strHash and
#     intHash: deterministic, unseeded), with a comparator for the rare keys
#     whose hashes are equal.  A key is hashed once and the hash chooses the
#     way down, four bits a level: a lookup reads one node per level (about
#     log16 n of them) and compares the keys themselves once, at the end.
#   * a HashMap is a persistent value, like Map: insert and remove return a
#     new map and share the rest (a hash trie: the nodes on the way down are
#     copied, sixteen words each).  When a map is threaded through a loop
#     from one of the empty maps and nothing else holds it, the compiler
#     writes those nodes in place (owned maps,
#     docs/2026-11-11-STATIC-REUSE-PLAN.md): a table's costs without a
#     separate API.
#   * iteration is DETERMINISTIC, in an order fixed by the keys' hashes (the
#     hash read four bits at a time from the low end; key order among equal
#     hashes), whatever order the keys went in: entries, keys, values and
#     fold.  `toMap cmp` gives an ascending std/map Map.
#   * absence is an Option.  Nothing here panics.
#   * EQUALITY: two maps with the same entries may hold different trees (a
#     removal leaves the nodes it emptied), so compare with
#     `HashMap.equal a b` (entries are canonical), not `==`.
#
# The names the owned-map rewriting knows (Reuse.hs) are kept: the wrapper
# Map with the tree third, the empty tree Leaf, the walkers insGo and altGo
# answering (tree, what happened).

O = use "option".
Ord = use "order".
M = use "map".
L = use "list".

# Leaf: nothing.  Tip: one entry, with its key's whole hash.  More: the
# entries of keys with one hash (two or more, ascending by the comparator).
# Node: sixteen subtrees, chosen by four bits of the hash; which four is the
# node's depth, which the walkers carry (the shift s: the child for hash h
# is number `band (BITSHIFTR h s) 15`).  A Node is read and
# rebuilt by field number (nodeGet, nodeWith), never matched field by field.
Tree k v = Type (Leaf | Tip Int k v | More Int (List (k, v))
  | Node (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v)
         (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v) (Tree k v)).
Ops k = Type (Ops (k -> Int) (k -> k -> Ord.Ordering)).
Map k v = Type (Map (Ops k) Int (Tree k v)).

# ---- making --------------------------------------------------------------------
empty : (k -> Int) -> (k -> k -> Ord.Ordering) -> Map k v .
empty hash cmp = Map (Ops hash cmp) 0 Leaf.

strings = empty strHash Ord.string.
ints = empty intHash Ord.int.

fromList : (k -> Int) -> (k -> k -> Ord.Ordering) -> List (k, v) -> Map k v .
fromList hash cmp kvs = insertAll kvs (empty hash cmp).

# later pairs win
insertAll : List (k, v) -> Map k v -> Map k v .
insertAll kvs m = insertAllGo kvs m.
insertAllGo : (kvs : List (k, v) | measure kvs) -> Map k v -> Map k v .
insertAllGo kvs m = case kvs of Nil -> m | (k, v) :: r -> insertAllGo r (insert k v m).

# ---- reading -------------------------------------------------------------------
size : Map k v -> Int
  | work size <= 5 | alloc size <= 0 .
size (Map _ n _) = n.

isEmpty : Map k v -> Bool
  | work isEmpty <= 8 | alloc isEmpty <= 16 .
isEmpty m = size m == 0.

get : k -> Map k v -> O.Option v .
get k (Map (Ops hash cmp) _ t) = getGo cmp (hash k) k 0 t.
getGo : (k -> k -> Ord.Ordering) -> Int -> k -> (s : Int | measure (64 - s)) -> Tree k v -> O.Option v .
getGo cmp h k s t = case t of
    Leaf -> O.None
  | Tip h2 k2 v2 -> (if h == h2 then (case cmp k k2 of Ord.Equal -> O.Some v2 | _ -> O.None) else O.None)
  | More h2 kvs -> (if h == h2 then bucketGet cmp k kvs else O.None)
  | _ -> (if s >= 64 then O.None else getGo cmp h k (s + 4) (nodeGet (band (BITSHIFTR h s) 15) t)).

getOr : v -> k -> Map k v -> v .
getOr d k m = case get k m of O.Some v -> v | O.None -> d.

member : k -> Map k v -> Bool .
member k m = case get k m of O.Some _ -> True | O.None -> False.

# ---- equal hashes: a short list, ascending by the comparator -------------------
bucketGet : (k -> k -> Ord.Ordering) -> k -> (kvs : List (k, v) | measure kvs) -> O.Option v .
bucketGet cmp k kvs = case kvs of
    Nil -> O.None
  | (k2, v2) :: r -> (case cmp k k2 of Ord.Equal -> O.Some v2 | Ord.Less -> O.None | Ord.Greater -> bucketGet cmp k r).

# (the new list, 1 if the key is new else 0)
bucketPut : (k -> k -> Ord.Ordering) -> k -> v -> (kvs : List (k, v) | measure kvs) -> (List (k, v), Int) .
bucketPut cmp k v kvs = case kvs of
    Nil -> ((k, v) :: Nil, 1)
  | (k2, v2) :: r -> (case cmp k k2 of
        Ord.Equal -> ((k2, v) :: r, 0)
      | Ord.Less -> ((k, v) :: kvs, 1)
      | Ord.Greater -> (case bucketPut cmp k v r of (r2, a) -> ((k2, v2) :: r2, a))).

# the list without k (k is in it)
bucketDrop : (k -> k -> Ord.Ordering) -> k -> (kvs : List (k, v) | measure kvs) -> List (k, v) .
bucketDrop cmp k kvs = case kvs of
    Nil -> Nil
  | (k2, v2) :: r -> (case cmp k k2 of Ord.Equal -> r | _ -> (k2, v2) :: bucketDrop cmp k r).

# the tree of one hash's entries
bucketTree : Int -> List (k, v) -> Tree k v .
bucketTree h kvs = case kvs of
    Nil -> Leaf
  | (k, v) :: r -> (case r of Nil -> Tip h k v | _ -> More h kvs).

# ---- the trie ------------------------------------------------------------------
emptyNode = Node Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf Leaf.

# two subtrees whose hashes differ, under the first node that tells them
# apart (they differ in some four bits, so this ends)
pair : (s : Int | measure (64 - s)) -> Int -> Tree k v -> Int -> Tree k v -> Tree k v .
pair s h1 t1 h2 t2 | s >= 64 = t1.
pair s h1 t1 h2 t2 =
  i1 = band (BITSHIFTR h1 s) 15;
  i2 = band (BITSHIFTR h2 s) 15;
  if i1 == i2 then nodeWith 16 i1 emptyNode (pair (s + 4) h1 t1 h2 t2)
  else nodeSet i2 (nodeWith 16 i1 emptyNode t1) t2.

# ---- writing ---------------------------------------------------------------------
insert : k -> v -> Map k v -> Map k v .
insert k v (Map ops n t) = case ops of
  Ops hash cmp -> (case insGo cmp (hash k) k v 0 t of (t2, added) -> Map ops (n + added) t2).
# (the new tree, 1 if the key is new else 0)
insGo : (k -> k -> Ord.Ordering) -> Int -> k -> v -> (s : Int | measure (64 - s)) -> Tree k v -> (Tree k v, Int) .
insGo cmp h k v s t = case t of
    Leaf -> (Tip h k v, 1)
  | Tip h2 k2 v2 -> (if h == h2 then (case cmp k k2 of
          Ord.Equal -> (Tip h k2 v, 0)
        | Ord.Less -> (More h ((k, v) :: (k2, v2) :: Nil), 1)
        | Ord.Greater -> (More h ((k2, v2) :: (k, v) :: Nil), 1))
      else (pair s h (Tip h k v) h2 (Tip h2 k2 v2), 1))
  | More h2 kvs -> (if h == h2 then (case bucketPut cmp k v kvs of (kvs2, a) -> (More h kvs2, a))
      else (pair s h (Tip h k v) h2 (More h2 kvs), 1))
  | _ -> (if s >= 64 then (t, 0) else
      i = band (BITSHIFTR h s) 15;
      c = nodeGet i t;
      (case insGo cmp h k v (s + 4) c of (c2, a) -> (nodeWith 16 i t c2, a))).

remove : k -> Map k v -> Map k v .
remove k m = alter k (fn old -> O.None) m.

# change, add or drop one key, in one descent (Map.alter's contract): `f`
# sees the current value (None when absent) and says what to keep (None
# drops the key); when nothing changes the map you passed comes back as it was
alter : k -> (O.Option v -> O.Option v) -> Map k v -> Map k v .
alter k f m = case m of
  Map ops n t -> (case ops of
    Ops hash cmp -> (case altGo cmp (hash k) k f 0 t of
      (t2, d) -> if d == 2 then m else Map ops (n + d) t2)).
# (the new tree, what happened): 1 added, 0 - 1 removed, 0 replaced in
# place, 2 nothing changed (the caller keeps its own tree).  `f` is only
# ever applied here, never handed to a helper: a copy of altGo made for one
# known `f` then has no `f` left, at every depth.
altGo : (k -> k -> Ord.Ordering) -> Int -> k -> (O.Option v -> O.Option v) -> (s : Int | measure (64 - s)) -> Tree k v -> (Tree k v, Int) .
altGo cmp h k f s t = case t of
    Leaf -> (case f O.None of
        O.Some v -> (Tip h k v, 1)
      | O.None -> (Leaf, 2))
  | Tip h2 k2 v2 -> (if h == h2 then (case cmp k k2 of
          Ord.Equal -> (case f (O.Some v2) of
              O.Some v -> (Tip h k2 v, 0)
            | O.None -> (Leaf, 0 - 1))
        | Ord.Less -> (case f O.None of
              O.Some v -> (More h ((k, v) :: (k2, v2) :: Nil), 1)
            | O.None -> (t, 2))
        | Ord.Greater -> (case f O.None of
              O.Some v -> (More h ((k2, v2) :: (k, v) :: Nil), 1)
            | O.None -> (t, 2)))
      else (case f O.None of
          O.Some v -> (pair s h (Tip h k v) h2 (Tip h2 k2 v2), 1)
        | O.None -> (t, 2)))
  | More h2 kvs -> (if h == h2 then (case bucketGet cmp k kvs of
          O.Some old -> (case f (O.Some old) of
              O.Some v -> (case bucketPut cmp k v kvs of (kvs2, a) -> (More h kvs2, 0))
            | O.None -> (bucketTree h (bucketDrop cmp k kvs), 0 - 1))
        | O.None -> (case f O.None of
              O.Some v -> (case bucketPut cmp k v kvs of (kvs2, a) -> (More h kvs2, 1))
            | O.None -> (t, 2)))
      else (case f O.None of
          O.Some v -> (pair s h (Tip h k v) h2 (More h2 kvs), 1)
        | O.None -> (t, 2)))
  | _ -> (if s >= 64 then (t, 2) else
      i = band (BITSHIFTR h s) 15;
      c = nodeGet i t;
      (case altGo cmp h k f (s + 4) c of
          (c2, d) -> if d == 2 then (t, 2) else (nodeWith 16 i t c2, d))).

update : k -> (O.Option v -> O.Option v) -> Map k v -> Map k v .
update k f m = alter k f m.

# insert, or where the key is already there store `f old v` instead
insertWith : (v -> v -> v) -> k -> v -> Map k v -> Map k v .
insertWith f k v m = alter k (fn old -> case old of
    O.Some o -> O.Some (f o v)
  | O.None -> O.Some v) m.

# ---- traversing (the order the hashes fix) ---------------------------------------
fold : (b -> k -> v -> b) -> b -> Map k v -> b .
fold f z (Map _ _ t) = foldGo f z t.
# a Node's sixteen subtrees in slot order (matched here, where every one is
# visited: the descent is plainly on a part of t)
foldGo : (b -> k -> v -> b) -> b -> (t : Tree k v | measure t) -> b .
foldGo f z t = case t of
    Leaf -> z
  | Tip _ k v -> f z k v
  | More _ kvs -> foldBucket f z kvs
  | Node c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 ->
      foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f (foldGo f z c0) c1) c2) c3) c4) c5) c6) c7) c8) c9) c10) c11) c12) c13) c14) c15.
foldBucket : (b -> k -> v -> b) -> b -> (kvs : List (k, v) | measure kvs) -> b .
foldBucket f z kvs = case kvs of Nil -> z | (k, v) :: r -> foldBucket f (f z k v) r.

rev : (xs : List a | measure xs) -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

entries : Map k v -> List (k, v) .
entries m = rev (fold (fn acc k v -> (k, v) :: acc) Nil m) Nil.

keys : Map k v -> List k .
keys m = rev (fold (fn acc k v -> k :: acc) Nil m) Nil.

values : Map k v -> List v .
values m = rev (fold (fn acc k v -> v :: acc) Nil m) Nil.

map : (v -> w) -> Map k v -> Map k w .
map f (Map ops n t) = Map ops n (mapGo f t).
mapGo : (v -> w) -> (t : Tree k v | measure t) -> Tree k w .
mapGo f t = case t of
    Leaf -> Leaf
  | Tip h k v -> Tip h k (f v)
  | More h kvs -> More h (mapBucket f kvs)
  | Node c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 ->
      Node (mapGo f c0) (mapGo f c1) (mapGo f c2) (mapGo f c3) (mapGo f c4) (mapGo f c5) (mapGo f c6) (mapGo f c7) (mapGo f c8) (mapGo f c9) (mapGo f c10) (mapGo f c11) (mapGo f c12) (mapGo f c13) (mapGo f c14) (mapGo f c15).
mapBucket : (v -> w) -> (kvs : List (k, v) | measure kvs) -> List (k, w) .
mapBucket f kvs = case kvs of Nil -> Nil | (k, v) :: r -> (k, f v) :: mapBucket f r.

filter : (k -> v -> Bool) -> Map k v -> Map k v .
filter p m = case m of Map (Ops hash cmp) _ _ ->
  fold (fn acc k v -> if p k v then insert k v acc else acc) (empty hash cmp) m.

# every key of either; where both have it, `a`'s value
union : Map k v -> Map k v -> Map k v .
union a b = fold (fn acc k v -> insert k v acc) b a.

# the same keys with equal values (entries are in a canonical order)
equal : Map k v -> Map k v -> Bool .
equal a b = entries a == entries b.

# the ascending, ordered std/map Map of the same entries: sorted once, then
# built balanced in O(n) (keys are distinct, so fromDistinctAscList trusts them)
toMap : (k -> k -> Ord.Ordering) -> Map k v -> M.Map k v .
toMap cmp m = M.fromDistinctAscList cmp (L.sortWith (fn a b -> case a of (ka, _) -> (case b of (kb, _) -> cmp ka kb)) (entries m)).

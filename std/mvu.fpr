# ============================================================================
# std/mvu.fpr -- std.MVU: the MVU driver as a library, extracted from
# pshell's SECOND architecture (the one that survived the Pi soaks),
# so no app hand-rolls these laws again:
#
#   PERSISTENT RENDER WORKER   one actor for the life of the app; the
#                              frame loop SENDS a request instead of
#                              spawning (no per-frame acb ledger)
#   TURN REGIONS               Sys.loop at every frame boundary:
#                              frame-per-actor memory semantics without
#                              the actor; frame temporaries are reclaimed
#                              after each frame (received roots still drop)
#   STATICS CACHE              view is rebuilt ONLY when skey(model)
#                              changes -- the rebuilt statics VALUE is
#                              the renderer's recompile trigger
#   DROP LAWS                  drain drops every poll reply; the worker
#                              forwards the render reply then drops its
#                              own ref; advance drops the PREVIOUS
#                              frame's reply (one live ARC entry per
#                              frame otherwise -- the ~50s idle fuse)
#   SELECTIVE RECEIVE          receiveFrom on both sides of the frame
#                              round trip: a driver that also holds
#                              service conversations inside update can
#                              never eat the worker's reply by mistake
#
# Dispatch/input + update live in the CALLER's actor. A persistent render
# worker and reusable legacy-call session are owned by each run; drawing is
# a caller-owned RENDER SERVICE -- any actor answering the Rv protocol.  textRender below is the reference
# implementation (headless); pshell's GLES walker is another, and a
# voxel-class software renderer holding its world batch is a third.
#
# ---------------------------------------------------------------------------
# THE ELM SURFACE (v2).  An app is FOUR functions over its own Model --
#
#   App init update subs view
#     init env             -> model
#     update env ev model  -> (model, List MC)     ev : Ev
#     subs model           -> List Sub             re-read EVERY frame
#     view model           -> scene                whatever the render
#                                                  service draws
#
# -- and events are DATA, not ints:
#
#   Ev  = ETick | EKey k | EMsg m a | EResize w h | EWheel dy dx
#         | EReload info | EReloadRefused info reason
#   Sub = STick ms | SKeys | SPort p | SEvents p
#
# Subscriptions are elm's: update hears ONLY what subs(model) asks for.
# STick ms delivers ETick when ms milliseconds elapsed (event pacing,
# decoupled from the frame rate -- drop it from the list and time
# stops, which is how an app pauses); SKeys turns the input drain on.
# EResize arrives unsubscribed (kind-5 input events, plus once at
# start with the render service's dims) -- a viewport is a fact, not a
# subscription.  EMsg is the external-message arm: the LiveView driver
# (programs/mods/liveview.fpr) feeds browser events through it, and a
# game feeding update from its own service actors uses the same arm.
#
#   MVU.game me cfg app      the gfx/game driver: this module's frame
#                            loop, view computed per frame IN THE
#                            WORKER (it may svcCall), whole scene as
#                            dynamics, no statics rebuilds
#   LiveApp init update subs view has view env model -> scene.
#   gameWatched/runWatched additionally own a platform watcher and its port.
#   gameLive me cfg app reload / runLive me cfg mapp reload give the runner
#   an adapter reload me info env -> Result env String. SEvents port supplies
#   typed events; successful swaps precede update and invalidate statics.
#
#   LV.server app            the browser driver, same legacy App value --
#                            see programs/mods/liveview.fpr
#
# The POWERED surface underneath (MApp) adds what the formal four
# leave out -- a statics split (skey/view vs vals), a custom result
# (done) -- and the drivers are adapters onto it:
#
#   MApp ini upd sk vw vl dn sbs
#     ini env                  -> model
#     upd me env ev model      -> (model, List MC)   ev : Ev
#     sk model                 -> Int                statics identity
#     vw vp model              -> statics            rebuilt on sk change
#     vl self env vp model     -> vals               per frame, IN THE
#                                 WORKER (may svcCall services)
#     dn model                 -> String             the run's result
#     sbs model                -> List Sub
#
# cfg is a RECORD, not a constructor: { env, mt, tick, input, render }.
# tick is the FRAME budget (10MHz monotonic ticks, a runtime setting);
# mt is retained for existing cfg records; the driver uses Sys.mtime now.
# STick is whether update HEARS time (a subscription).  Consumers
# project the fields they use; apps may add fields freely (rows are
# open) -- adding a capability never breaks arity again.
#
# THE std PLACEMENT, honestly: std's charter is "no unbounded worst
# case", and an MVU loop is unbounded BY DESIGN.  The contract here is
# per-frame: one drain+update+render iteration is the WCET-carrying
# unit (the loop itself is declared unsafe).  Teaching --stdcheck a
# bounded-step-loop scheme is named future work, as is the registry
# hook (tick/vp addressable live, the snake-CLI pattern).
#
# The render protocol (Rv): Dims u -> (w, h); Render st vs sc fr ->
# (draws, bytes).  The input protocol: Poll u -> (kind, a, b) with
# kind 0 none / 1 ascii / 4 evdev-press / 5 resize; input actor 0 =
# no input (tick-driven apps).
# ============================================================================

AC = use "actor".

MC   = Type (MQuit | MLog s).
Reload = {name : String, from : String, to : String, version : String}.
# These protocol fields are concrete values. Unconstrained constructor
# fields would hide their ownership from automatic receive-turn analysis.
Ev   = Type (ETick | EKey Int | EMsg String String | EResize Int Int | EWheel Int Int
             | EReload Reload | EReloadRefused Reload String).
Sub  = Type (STick Int | SKeys | SPort Int | SEvents Int).
App  = Type (App ini upd sbs vw | LiveApp ini upd sbs vw).
MApp = Type (MApp ini upd sk vw vl dn sbs).
Rv   = Type (Render st vs sc fr | Dims u | Poll u).
Rq   = Type (Rq st model env vw vh sc fr deadline).
Ms   = Type (Ms model fr sc lastR ltt).

# ---- helpers ----------------------------------------------------------------

# Existing renderer/input services use the uncorrelated (caller, request)
# wire and send only replies to a caller. Keep that ABI, but check admission
# and observe service death. Callers that own cleanup use the Result API.
svcCallRes : unsafe Int -> Int -> q -> Result r String .
svcCallRes me a q = AC.sendAwait me a (me, q).
svcCall me a q = serviceValue "service" (svcCallRes me a q).
serviceValue label result = case result of
    Ok value -> value
  | Err why -> error "mvu {label}: {why}".

lenL : unsafe List a -> Int .
lenL l = case l of Nil -> 0 | x :: r -> 1 + lenL r.
apnd : unsafe List a -> a -> List a .
apnd l x = case l of Nil -> x :: Nil | h :: r -> h :: apnd r x.
revK : unsafe List a -> List a -> List a .
revK acc l = case l of Nil -> acc | x :: r -> revK (x :: acc) r.

# ---- subscriptions: the list, folded to (tickMs, keysOn, port) --------------

subsOf app m =
  MApp ini upd sk vw vl dn sbs = app;
  subFold (sbs m) (0, 0, 0).
subFold : unsafe List Sub -> (Int, Int, Int) -> (Int, Int, Int) .
subFold l acc = case l of Nil -> acc | s :: r -> subOne r acc s.
subOne : unsafe List Sub -> (Int, Int, Int) -> Sub -> (Int, Int, Int) .
subOne r acc s =
  (t, k, p) = acc;
  case s of
    STick ms -> subFold r (ms, k, p)
  | SKeys -> subFold r (t, 1, p)
  | SPort pa -> subFold r (t, k, pa)
  | SEvents pa -> subFold r acc.

# ---- the message port: EMsg from ANY actor, one writer, per-frame -----------
# The debug/wire channel the paths design asks for (docs/2026-08-27-PATHS.md): a
# shell, a supervisor, a script sends (tag, arg) STRING PAIRS to the
# port actor; the loop drains it once per frame (SPort port in subs)
# and hands each pair to update as EMsg tag arg -- the SAME arm the
# LiveView driver feeds browser events through.  The model actor stays
# the single writer (a path-set is applied BY update, transactionally),
# messages from one sender arrive in order (per-sender FIFO), and a
# reload nudge is just another message -- so a code swap lands exactly
# at a step boundary, never inside one.
#
#   port = spawn MV.port;              # anyone: send port ("set", "cap 9")
#   subs m = SPort port :: ...         # the app: hear it as EMsg
#
# Each input root is kept into owned queue state and dropped in its turn.
# The drained list root on the driver side is dropped after copying strings.

PortQ = Type (PDrain from | PBarrier from).

port : unsafe Int -> Unit .
port me =
  _ = Sys.loop Nil (portStep me);
  Unit.
# Queue owned values, not received roots: a turn may copy its live queue.
# Flushing discards that value state; no list spine or message root survives.
portStep me q =
  received = receive me;
  m = keep received;
  _ = drop received;
  next = case m of
      PDrain from -> _ = AC.sendSure me from (revK Nil q); Nil
    | PBarrier from -> _ = AC.sendSure me from Unit; q
    | _ -> m :: q;
  (True, next).
# Per-sender FIFO barrier: return only after this sender's queued events have
# reached the port. A render/test driver can use it before replying to a frame.
portSyncRes : unsafe Int -> Int -> Result Unit String .
portSyncRes me pa = AC.sendAwait me pa (PBarrier me).
portSync me pa = serviceValue "port barrier" (portSyncRes me pa).

# loop side: drain the subscribed port into EMsg events.
portEvsRes : unsafe Int -> Int -> Result (List Ev) String .
portEvsRes me pa = if pa == 0 then Ok Nil else portAskRes me pa.
portEvs : unsafe Int -> Int -> List Ev .
portEvs me pa = serviceValue "port" (portEvsRes me pa).
portAskRes : unsafe Int -> Int -> Result (List Ev) String .
portAskRes me pa = case AC.sendAwait me pa (PDrain me) of
    Err why -> Err "message port: {why}"
  | Ok ms -> Ok (portConv ms Nil).
portAsk : unsafe Int -> Int -> List Ev .
portAsk me pa = serviceValue "port" (portAskRes me pa).
portConv : unsafe List _ -> List Ev -> List Ev .
portConv ms acc = case ms of
    Nil -> revK Nil acc
  | tv :: r -> portConv1 r acc tv.
portConv1 : unsafe List _ -> List Ev -> _ -> List Ev .
portConv1 r acc tv =
  (tag, arg) = tv;
  portConv r (EMsg (strCopy tag) (strCopy arg) :: acc).
# fresh allocation: the EMsg outlives the drained list root
strCopy s = substr s 0 (strlen s).

catEvs : unsafe List Ev -> List Ev -> List Ev .
catEvs a b = case a of Nil -> b | x :: r -> x :: catEvs r b.

# Typed event port: a watcher (or a test driver) sends Ev values. Reuse the
# port's queue/drop laws; COPY strings before dropping the drain reply.
# SEvents preserves the order of reloads and ordinary events on this port.
eventsPort me = port me.
eventSub : unsafe List Sub -> Int .
eventSub l = case l of
    Nil -> 0
  | SEvents p :: r -> p
  | s :: r -> eventSub r.
eventEvsRes : unsafe Int -> Int -> Result (List Ev) String .
eventEvsRes me pa = if pa == 0 then Ok Nil else eventAskRes me pa.
eventEvs : unsafe Int -> Int -> List Ev .
eventEvs me pa = serviceValue "event port" (eventEvsRes me pa).
# Drain each subscribed typed port once, preserving subscription/FIFO order.
eventPorts : unsafe Int -> List Sub -> List Int -> List Ev .
eventPorts me ss seen = serviceValue "event ports" (eventPortsRes me ss seen).
eventPortsRes : unsafe Int -> List Sub -> List Int -> Result (List Ev) String .
eventPortsRes me ss seen = eventPortsAccRes me ss seen Nil.
eventPortsAcc : unsafe Int -> List Sub -> List Int -> List Ev -> List Ev .
eventPortsAcc me ss seen acc = serviceValue "event ports" (eventPortsAccRes me ss seen acc).
eventPortsAccRes : unsafe Int -> List Sub -> List Int -> List Ev -> Result (List Ev) String .
eventPortsAccRes me ss seen acc = case ss of
    Nil -> Ok (revK Nil acc)
  | SEvents p :: rest -> (case hasPort p seen of
      True -> eventPortsAccRes me rest seen acc
    | False -> case eventEvsRes me p of
          Err why -> Err why
        | Ok evs -> eventPortsAccRes me rest (p :: seen) (revK acc evs))
  | other :: rest -> eventPortsAccRes me rest seen acc.
hasPort : unsafe Int -> List Int -> Bool .
hasPort p seen = case seen of Nil -> False | x :: rest -> x == p or hasPort p rest.
eventAskRes : unsafe Int -> Int -> Result (List Ev) String .
eventAskRes me pa = case AC.sendAwait me pa (PDrain me) of
    Err why -> Err "event port: {why}"
  | Ok ms -> Ok (eventCopy ms).
eventAsk : unsafe Int -> Int -> List Ev .
eventAsk me pa = serviceValue "event port" (eventAskRes me pa).
eventCopy : unsafe List Ev -> List Ev .
eventCopy l = case l of Nil -> Nil | e :: r -> copyEv e :: eventCopy r.
copyReload : Reload -> Reload .
copyReload i = {name = strCopy i.name, from = strCopy i.from,
                to = strCopy i.to, version = strCopy i.version}.
copyEv e = case e of
    ETick -> ETick
  | EKey k -> EKey k
  | EMsg t a -> EMsg (strCopy t) (strCopy a)
  | EResize w h -> EResize w h
  | EWheel y x -> EWheel y x
  | EReload i -> EReload (copyReload i)
  | EReloadRefused i why -> EReloadRefused (copyReload i) (strCopy why).

# ---- input: drain the poll service, ARRIVAL order ---------------------------
# (prepend-built, reversed before applying -- the voxel-interactive law)

ascii2code c = case c == 27 of
    True -> 1
  | False -> case c == 10 of
      True -> 28
    | False -> case c == 13 of
        True -> 28
      | False -> case c == 127 of
          True -> 14
        | False -> case c == 8 of
            True -> 14
          | False -> 0 - c.        # negative = literal ascii

drain : unsafe Int -> Int -> Int -> List Ev -> List Ev .
drain me inp n acc = serviceValue "input" (drainRes me inp n acc).
drainRes : unsafe Int -> Int -> Int -> List Ev -> Result (List Ev) String .
drainRes me inp n acc = if n == 0 then Ok (revK Nil acc) else
  case svcCallRes me inp (Poll 0) of
      Err why -> Err "input: {why}"
    | Ok ev -> (kind, a, b) = ev; drainEvRes me inp n acc kind a b.
drainOne me inp n acc = drain me inp n acc.
drainEv : unsafe Int -> Int -> Int -> List Ev -> Int -> Int -> Int -> List Ev .
drainEv me inp n acc kind a b = serviceValue "input" (drainEvRes me inp n acc kind a b).
drainEvRes : unsafe Int -> Int -> Int -> List Ev -> Int -> Int -> Int -> Result (List Ev) String .
drainEvRes me inp n acc kind a b = case kind == 0 of
    True -> Ok (revK Nil acc)
  | False -> case kind == 4 of
      True -> drainRes me inp (n - 1) (if b == 1 then EKey a :: acc else acc)
    | False -> case kind == 1 of
        True -> drainRes me inp (n - 1) (EKey (ascii2code a) :: acc)
      | False -> case kind == 5 of
          True -> drainRes me inp (n - 1) (EResize a b :: acc)
        | False -> case kind == 6 of
            True -> drainRes me inp (n - 1) (EWheel a b :: acc)
          | False -> drainRes me inp (n - 1) acc.

drainKey : unsafe Int -> Int -> Int -> List Ev -> Int -> Int -> List Ev .
drainKey me inp n acc a b = case b == 1 of
    True -> drain me inp (n - 1) (EKey a :: acc)
  | False -> drain me inp (n - 1) acc.

# keys only when subscribed AND an input service exists
evsOf me inp keysOn = case keysOn == 0 of
    True -> Nil
  | False -> evsIn me inp.
evsIn me inp = case inp == 0 of
    True -> Nil
  | False -> drain me inp 16 Nil.

# ---- update + commands ------------------------------------------------------

applyEvs : unsafe Int -> a -> MApp -> List Ev -> (b, Int) -> (b, Int) .
applyEvs me env app evs mq = case evs of
    Nil -> mq
  | e :: r -> applyOne me env app r e mq.
applyOne : unsafe Int -> a -> MApp -> List Ev -> Ev -> (b, Int) -> (b, Int) .
applyOne me env app r e mq =
  (m, q) = mq;
  MApp ini upd sk vw vl dn sbs = app;
  (m2, cs) = upd me env e m;
  applyEvs me env app r (m2, doCmds cs q).
# The runner owns the env. An adapter attaches/gates a candidate and returns
# a COMPLETE successor env, or Err with the old env left usable. Call it only
# between updates; deliver the result event with the corresponding env.
noReload : Int -> Reload -> env -> Result env String .
noReload me info env = Err "this runner has no reload adapter".
applyLiveEvs : unsafe Int -> _ -> env -> MApp -> List Ev -> (model, Int) -> Int -> (env, model, Int, Int) .
applyLiveEvs me reload env app evs mq changed = case evs of
    Nil -> liveResult env mq changed
  | e :: r -> liveEvent me reload env app r e mq changed.
liveResult env mq changed = (m, q) = mq; (env, m, q, changed).
liveEvent me reload env app r e mq changed = case e of
    EReload info -> liveReload me reload env app r info mq changed
  | other -> liveUpdate me reload env app r e mq changed.
liveReload me reload env app r info mq changed = case reload me info env of
    Ok next -> liveUpdate me reload next app r (EReload info) mq 1
  | Err why -> liveUpdate me reload env app r (EReloadRefused info why) mq changed.
liveUpdate me reload env app r e mq changed =
  (m, q) = mq;
  MApp ini upd sk vw vl dn sbs = app;
  (m2, cs) = upd me env e m;
  liveContinue me reload env app r (m2, doCmds cs q) changed.
# MQuit is a turn boundary too: do not attach another candidate after quit.
liveContinue me reload env app r mq changed =
  (m, q) = mq;
  case q == 1 of
    True -> (env, m, q, changed)
  | False -> applyLiveEvs me reload env app r mq changed.

doCmds : unsafe List MC -> Int -> Int .
doCmds cs q = case cs of
    Nil -> q
  | c :: r -> doCmd r q c.
doCmd : unsafe List MC -> Int -> MC -> Int .
doCmd r q c = case c of
    MQuit -> doCmds r 1
  | MLog s -> logGo r q s.
logGo : unsafe List MC -> Int -> String -> Int .
logGo r q s =
  _ = Sys.logAt 0 s;
  doCmds r q.

# ---- the statics cache: skey is the identity --------------------------------
# cache = (key, statics); the statics value is pointer-stable while
# cached, which is the renderer's recompile trigger when it swaps.

ensure app vp cache key model =
  (k, st) = cache;
  case k == key of
    True -> (cache, 0)
  | False -> rebuild app vp key model.
rebuild app vp key model =
  MApp ini upd sk vw vl dn sbs = app;
  ((key, vw vp model), 1).

# ---- the persistent render worker -------------------------------------------
# One actor, forever: request in, vals computed HERE (this is the actor
# that may svcCall services from vals), one render call, reply
# forwarded, received roots released, and only the callback state survives.

# `vl` is the app's vals function, and it is CALLED here, so it is spelled
# as one: a bare `b` promised the caller any type at all for something this
# body applies to four arguments (fprisc/docs/2026-08-25-SAFETY.md).
renderWorker : unsafe Int -> Int -> (Int -> env -> (Int, Int) -> model -> vals) -> Int -> Unit .
renderWorker parent render vl self =
  _ = Sys.loop (parent, render, vl) (renderStep self);
  Unit.
renderStep self state =
  (parent, render, vl) = state;
  case receiveFromRes self parent of
      Err why -> (False, state)
    | Ok m -> renderRequest self state m.
renderRequest self state m =
  (parent, render, vl) = state;
  (from, id, Rq st model env vw vh sc fr deadline) = m;
  vs = vl self env (vw, vh) model;
  result = AC.sendAwaitUntil deadline self render (self, Render st vs sc fr);
  _ = AC.sendSure self from (id, result);
  _ = drop m;
  (AC.sent result, state).

# ---- the loop ---------------------------------------------------------------

waitTick : unsafe Int -> Int -> Int -> Int .
waitTick mt t0 tick = case Sys.mtime Unit - t0 >= tick of
    True -> Sys.mtime Unit
  | False -> napTick mt t0 tick.
# sleep the REMAINDER instead of pegging a core on mtime; the loop
# re-checks because the hook may undershoot (and the bare-metal weak
# default is a no-op, i.e. today's spin, unchanged)
napTick : unsafe Int -> Int -> Int -> Int .
napTick mt t0 tick =
  _ = Sys.sleepUs ((tick - (Sys.mtime Unit - t0)) / 10);   # 10MHz mt -> us
  waitTick mt t0 tick.
tickWait mt t0 tick = case tick == 0 of
    True -> 0
  | False -> waitTick mt t0 tick.

# STick ms: deliver ETick when ms elapsed since the LAST delivery --
# event pacing rides the subscription, frame pacing rides cfg.tick
dueTick evs t0 ltt tickMs = case tickMs == 0 of
    True -> (evs, ltt)
  | False -> dueTick2 evs t0 ltt tickMs.
dueTick2 evs t0 ltt tickMs = case t0 - ltt >= tickMs * 10000 of
    True -> (apnd evs ETick, t0)
  | False -> (evs, ltt).

loopM : unsafe Int -> _ -> MApp -> Int -> (Int, Int) -> (Int, c) -> Ms -> _ .
loopM me cfg app rw vp cache ms =
  env = cfg.env; mt = cfg.mt; input = cfg.input;
  Ms model fr sc lastR ltt = ms;
  t0 = Sys.mtime Unit;
  MApp ini upd sk vw vl dn sbs = app;
  ss = sbs model;
  (tickMs, keysOn, portA) = subFold ss (0, 0, 0);
  events = case AC.deadlineAfter cfg.serviceMs of
      Err why -> Err why
    | Ok deadline -> collectEventsUntil deadline me cfg.calls input keysOn portA ss;
  case events of
      Err why -> failedLoop rw cfg cache ms why
    | Ok evs0 -> loopEvents me cfg app rw vp cache ms t0 tickMs evs0.
collectEvents me input keysOn portA ss =
  case (if input == 0 or keysOn == 0 then Ok Nil else drainRes me input 16 Nil) of
      Err why -> Err why
    | Ok keys -> case portEvsRes me portA of
          Err why -> Err why
        | Ok messages -> case eventPortsRes me ss Nil of
              Err why -> Err why
            | Ok events -> Ok (catEvs (catEvs keys messages) events).
# One reusable legacy session supplies a disposable return address on failure.
# A single absolute deadline covers all input polls and subscribed ports in
# this turn. Caller-owned render/input/port services remain caller-owned.
collectEventsUntil deadline me calls input keysOn portA ss =
  case (if input == 0 or keysOn == 0 then Ok Nil else drainUntil deadline me calls input 16 Nil) of
      Err why -> Err why
    | Ok keys -> case (if portA == 0 then Ok Nil else messagePortUntil deadline me calls portA) of
          Err why -> Err why
        | Ok messages -> case eventPortsUntil deadline me calls ss Nil Nil of
              Err why -> Err why
            | Ok events -> Ok (catEvs (catEvs keys messages) events).
drainUntil : unsafe Int -> Int -> Int -> Int -> Int -> List Ev -> Result (List Ev) String .
drainUntil deadline me calls input n acc = if n == 0 then Ok (revK Nil acc) else
  case AC.sessionCallUntil deadline me calls input (fn ret -> (ret, Poll 0)) of
      Err why -> Err "input: {why}"
    | Ok ev ->
        (kind, a, b) = ev;
        if kind == 0 then Ok (revK Nil acc) else
          drainUntil deadline me calls input (n - 1) (inputEvent kind a b acc).
inputEvent kind a b acc = case kind of
    4 -> if b == 1 then EKey a :: acc else acc
  | 1 -> EKey (ascii2code a) :: acc
  | 5 -> EResize a b :: acc
  | 6 -> EWheel a b :: acc
  | other -> acc.
messagePortUntil deadline me calls port =
  case AC.sessionCallUntil deadline me calls port (fn ret -> PDrain ret) of
      Err why -> Err "message port: {why}"
    | Ok messages -> Ok (portConv messages Nil).
eventPortsUntil : unsafe Int -> Int -> Int -> List Sub -> List Int -> List Ev -> Result (List Ev) String .
eventPortsUntil deadline me calls ss seen acc = case ss of
    Nil -> Ok (revK Nil acc)
  | SEvents p :: rest -> (if hasPort p seen or p == 0 then eventPortsUntil deadline me calls rest seen acc else
      case AC.sessionCallUntil deadline me calls p (fn ret -> PDrain ret) of
          Err why -> Err "event port: {why}"
        | Ok messages -> eventPortsUntil deadline me calls rest (p :: seen) (revK acc (eventCopy messages)))
  | other :: rest -> eventPortsUntil deadline me calls rest seen acc.
loopEvents me cfg app rw vp cache ms t0 tickMs evs0 =
  env = cfg.env;
  Ms model fr sc lastR ltt = ms;
  (evs, ltt2) = dueTick evs0 t0 ltt tickMs;
  (env2, m2, quit, changed) = applyLiveEvs me cfg.reload env app evs (model, 0) 0;
  cache1 = liveCache cache changed;
  case quit == 1 of
    True -> (False, (cfg, cache, Ms m2 fr sc (0, 0) ltt2, Ok (finishWorker rw app m2 fr sc lastR)))
  | False -> frame me {cfg | env = env2} app rw vp cache1 (Ms m2 fr sc lastR ltt2) t0.
# Force the statics build after a successful swap even when skey is unchanged.
# This generation marker is separate from the app key (which may be any Int).
liveCache cache changed = (key, st) = cache; (key, st, changed).
frame : unsafe Int -> _ -> MApp -> Int -> (Int, Int) -> (Int, c, Int) -> Ms -> Int -> _ .
frame me cfg app rw vp cache ms t0 =
  mt = cfg.mt; tick = cfg.tick;
  Ms m2 fr sc lastR ltt = ms;
  (vw, vh) = vp;
  key = skeyOf app m2;
  (oldKey, oldSt, changed) = cache;
  (cache2, rebuilt) = liveEnsure app vp (oldKey, oldSt) key m2 changed;
  (k2, st2) = cache2;
  result = case AC.deadlineAfter cfg.serviceMs of
      Err why -> Err why
    | Ok deadline -> frameReply (AC.callUntil deadline me rw (Rq st2 m2 cfg.env vw vh (sc + rebuilt) fr deadline));
  case result of
      Err why -> failedLoop rw cfg cache2 ms why
    | Ok r ->
        _ = drop lastR;
        _ = tickWait mt t0 tick;
        (True, (cfg, cache2, Ms m2 (fr + 1) (sc + rebuilt) (0, 0) ltt, Ok "")).
frameReply result = case result of
    Err why -> Err "render worker: {why}"
  | Ok reply -> case reply of Ok r -> Ok r | Err why -> Err "render: {why}".
failedLoop rw cfg cache ms why =
  _ = kill rw;
  (False, (cfg, cache, ms, Err "mvu: {why}")).

driverStep me app rw vp state =
  (cfg, cache, ms, result) = state;
  loopM me cfg app rw vp cache ms.
liveEnsure app vp cache key m changed = case changed == 1 of
    True -> rebuild app vp key m
  | False -> ensure app vp cache key m.
skeyOf app m =
  MApp ini upd sk vw vl dn sbs = app;
  sk m.
finishWorker rw app m fr sc lastR =
  _ = kill rw;
  finish app m fr sc lastR.
finish app m fr sc lastR =
  MApp ini upd sk vw vl dn sbs = app;
  _ = drop lastR;
  "{dn m} [mvu: {fr} frames, {sc} statics builds]".

# run me cfg app -> the result string.  Spawns the worker, asks the
# render service for its dimensions, initializes, delivers the first
# EResize (the viewport is a fact the model may record), loops.
run me cfg app = serviceValue "run" (runResult me cfg app).
runResult me cfg app = runResultWithin 5000 me cfg app.
# A configurable bound for each event collection and render turn (ms).
# App update/reload callbacks are synchronous; the driver cannot preempt them.
runResultWithin ms me cfg app = runLiveResultWithin ms me cfg app noReload.

# All drivers reclaim every frame's scratch allocations. Configuration,
# model, cache and reload callbacks have value semantics: a Vector in this
# state (including captured storage) is refused by Sys.loop. Stable mutable
# buffers belong in an explicit owner using Sys.loopWith.
# The caller's pool is never reset; its shutdown handles remain valid.
# Compatibility names now select the same default behavior.
runScoped me cfg app = run me cfg app.
runLiveScoped me cfg app reload = runLive me cfg app reload.

# reload me info env -> Result env String: a platform adapter, not app update.
runLive me cfg app reload = serviceValue "run" (runLiveResult me cfg app reload).
runLiveResult me cfg app reload = runLiveResultWithin 5000 me cfg app reload.
runLiveResultWithin ms me cfg app reload =
  runWithResultWithin ms me {env = cfg.env, mt = cfg.mt, tick = cfg.tick, input = cfg.input,
              render = cfg.render, reload = reload} app.
# The runner owns the extra typed port and the watcher returned by start.
# start me port -> Result actor String. Other app subscriptions still work.
runWatched me cfg app reload start = runWatchedWithin 5000 me cfg app reload start.
runWatchedWithin ms me cfg app reload start =
  port = AC.spawnWith (AC.Dynamic 64) eventsPort;
  runWatchStartedWithin ms me cfg app reload port (start me port).
runWatchStarted me cfg app reload port started = runWatchStartedWithin 5000 me cfg app reload port started.
runWatchStartedWithin ms me cfg app reload port started = case started of
    Err why -> _ = kill port; Err why
  | Ok worker -> runWatchOwnedWithin ms me cfg app reload port worker.
runWatchOwned me cfg app reload port worker = runWatchOwnedWithin 5000 me cfg app reload port worker.
runWatchOwnedWithin ms me cfg app reload port worker =
  result = runLiveResultWithin ms me cfg (withEventPort app port) reload;
  _ = kill worker;
  _ = kill port;
  result.
withEventPort app port =
  MApp ini upd sk vw vl dn sbs = app;
  MApp ini upd sk vw vl dn (watchSubs sbs port).
watchSubs sbs port m = catSubs (sbs m) (SEvents port :: Nil).
catSubs : unsafe List Sub -> List Sub -> List Sub .
catSubs xs ys = case xs of Nil -> ys | x :: rest -> x :: catSubs rest ys.
gameWatched me cfg app reload start = runWatched me cfg (gameApp app) reload start.

runWith me cfg app = serviceValue "run" (runWithResult me cfg app).
runWithResult me cfg app = runWithResultWithin 5000 me cfg app.
runWithResultWithin ms me cfg app = case AC.deadlineAfter ms of
    Err why -> Err "mvu: {why}"
  | Ok deadline ->
      calls = spawn (AC.session me);
      owned = {env = cfg.env, mt = cfg.mt, tick = cfg.tick, input = cfg.input,
               render = cfg.render, reload = cfg.reload, calls = calls, serviceMs = ms};
      result = runStartedResult deadline me owned app;
      _ = kill calls;
      result.
runStartedResult deadline me cfg app =
  MApp ini upd sk vw vl dn sbs = app;
  case AC.sessionCallUntil deadline me cfg.calls cfg.render (fn ret -> (ret, Dims 0)) of
      Err why -> Err "mvu dimensions: {why}"
    | Ok vp ->
        rw = AC.spawnWith (AC.Dynamic 64) (renderWorker me cfg.render vl);
        run2Result me cfg app rw vp (ini cfg.env).
run2 me cfg app rw vp m0 = serviceValue "run" (run2Result me cfg app rw vp m0).
run2Result me cfg app rw vp m0 =
  (w0, h0) = vp;
  (m1, quit) = applyEvs me cfg.env app (EResize w0 h0 :: Nil) (m0, 0);
  case quit == 1 of
    True -> Ok (finishWorker rw app m1 0 0 (0, 0))
  | False -> run3Result me cfg app rw vp m1.
run3 me cfg app rw vp m1 = serviceValue "run" (run3Result me cfg app rw vp m1).
run3Result me cfg app rw vp m1 =
  MApp ini upd sk vw vl dn sbs = app;
  # A real view value keeps statics polymorphic; -1 forces the first rebuild.
  cache = (0 - 1, vw vp m1);
  ms = Ms m1 0 0 (0, 0) (Sys.mtime Unit);
  (finalCfg, finalCache, finalMs, result) = Sys.loop (cfg, cache, ms, Ok "") (driverStep me app rw vp);
  result.

# ---- the elm façade: MVU.game -----------------------------------------------
# The formal four run on the engine: view is computed per frame IN THE
# WORKER (so a scene's per-frame allocation dies at the pool reset,
# and view may svcCall the services it reads), the whole scene rides
# the dynamics slot of the Render protocol, statics are the unit value
# built once (a voxel-class render service owns its own world batch;
# a service that does want a statics split uses MApp directly).

game me cfg app = run me cfg (gameApp app).
gameLive me cfg app reload = runLive me cfg (gameApp app) reload.
gameApp app = case app of
    App ini upd sbs vw -> MApp ini (gUpd upd) gSk gVw (gVl vw) gDn sbs
  | LiveApp ini upd sbs vw -> MApp ini (gUpd upd) gSk gVw (gLiveVl vw) gDn sbs.
gUpd upd me env ev m = upd env ev m.
gSk m = 0.
gVw vp m = 0.
gVl vw self env vp m = vw m.
gLiveVl vw self env vp m = vw env m.
gDn m = "game over".

# ---- textRender: the reference render service (headless) --------------------
# statics = List String, vals = List String.  Prints the statics on
# every rebuild (the recompile trigger made visible) and a vals line
# every 10th frame; replies (draws, bytes) like the GLES walker.

textRender : unsafe Int -> a .
textRender me = trLoop me (0 - 1).
trLoop : unsafe Int -> Int -> a .
trLoop me lastSc =
  borrowed = receive me;
  m = keep borrowed;
  _ = drop borrowed;
  (replyTo, q) = m;
  trMsg me lastSc replyTo q.
trMsg : unsafe Int -> Int -> Int -> Rv -> a .
trMsg me lastSc replyTo q = case q of
    Dims u -> AC.sendSure me replyTo (80, 24) >> trLoop me lastSc
  | Render st vs sc fr -> trFrame me lastSc replyTo st vs sc fr
  | Poll u -> AC.sendSure me replyTo (0, 0, 0) >> trLoop me lastSc.
trFrame : unsafe Int -> Int -> Int -> List String -> List String -> Int -> Int -> a .
trFrame me lastSc replyTo st vs sc fr =
  _ = trStatics st sc lastSc;
  _ = trVals vs sc fr;
  _ = AC.sendSure me replyTo (lenL vs, trBytes vs 0);
  trLoop me sc.
trStatics : unsafe List String -> Int -> Int -> Int .
trStatics st sc lastSc = case sc == lastSc of
    True -> 0
  | False -> trBanner st sc.
trBanner : unsafe List String -> Int -> Int .
trBanner st sc =
  _ = print "-- statics build #{sc} --";
  trPrintAll st.
trPrintAll : unsafe List String -> Int .
trPrintAll l = case l of
    Nil -> 0
  | s :: r -> trP1 r s.
trP1 : unsafe List String -> String -> Int .
trP1 r s = _ = print "  | {s}"; trPrintAll r.
trVals : unsafe List String -> Int -> Int -> Int .
trVals vs sc fr = case (fr % 10) == 0 of
    True -> trPrintVals vs fr
  | False -> 0.
trPrintVals : unsafe List String -> Int -> Int .
trPrintVals vs fr = trPV vs fr "".
trPV : unsafe List String -> Int -> String -> Int .
trPV vs fr acc = case vs of
  Nil -> print "f{fr}: {acc}" >> 0
  | v :: r -> trPV r fr "{acc}{v}  ".
trBytes : unsafe List String -> Int -> Int .
trBytes vs n = case vs of
    Nil -> n
  | v :: r -> trBytes r (n + strlen v).

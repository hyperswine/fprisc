# Parallel work with ordered results and explicit join failure (ExtBase).
# Each batch owns a collector inbox and its worker handles. Worker death is
# detected even when another worker stalls; failure cancels the siblings and
# retires the inbox, isolating late completions from the caller's messages.
# Base program panics remain program panics: fallible work should return Result.
M = use "map".
A = use "actor".
Ord = use "order".

JoinPoll = Type (Waiting | Ready worker index value | Failed String).
worker parent f i x self = _ = A.sendSure self parent (i, f x); Unit.

map : (a -> b) -> List a -> Result (List b) String .
map f xs = mapBounded 0 f xs.
# 0 = unlimited; negative limits are refused.
mapBounded : Int -> (a -> b) -> List a -> Result (List b) String .
mapBounded limit f xs = start 0 limit f xs.
# The budget covers the entire batch, including queued inputs and admission.
mapWithin ms f xs = mapBoundedWithin ms 0 f xs.
mapBoundedWithin ms limit f xs = case A.deadlineAfter ms of
    Err why -> Err why
  | Ok deadline -> start deadline limit f xs.
start : unsafe Int -> Int -> (a -> b) -> List a -> Result (List b) String .
start deadline limit f xs = if limit < 0 then Err "task: invalid concurrency limit" else
  me = myself 0;
  collector = spawn (join me deadline limit f xs);
  # the collector's answer is received inside a region of its own: the answer
  # is copied out to the caller and the message dies at the region's end,
  # whatever loop the caller is in (a batch must leave nothing behind)
  Sys.arena (fn u -> case receiveFromRes me collector of
      Err why -> Err "task collector: {why}"
    | Ok m -> m).

join parent deadline limit f xs self =
  _ = Sys.loop (xs, 0, Nil, 0, M.empty Ord.int) (joinStep self parent deadline limit f);
  Unit.
# No completion or abandoned result is ever sent to the caller's general
# inbox. Sys.loop also bounds scratch while repeatedly polling stalled work,
# and each completion it receives dies with the step that polled it; the
# value kept in `done` is copied out with the state.
joinStep me parent deadline limit f state =
  (xs, next, active, count, done) = state;
  if not (ownerAlive me parent) then
      _ = cancel active;
      (False, state)
  else if deadline > 0 and A.nowUs Unit >= deadline then
      stop me parent active state (Err "task: deadline exceeded")
  else case xs of
      x :: rest -> if limit == 0 or count < limit then
          w = spawn (worker me f next x);
          (True, (rest, next + 1, (w, next) :: active, count + 1, done))
        else collect me parent state
    | Nil -> if count == 0 then stop me parent active state (Ok (M.values done))
        else collect me parent state.
# a dead owner is "dead actor", or "dead actor: <why>" when it failed or was killed
ownerAlive me parent = case receiveFromNow me parent of
    Err why -> strIndexOf "dead actor" why != 0
  | Ok m -> _ = drop m; True.
collect me parent state =
  (xs, next, active, count, done) = state;
  case poll me active of
      Failed why -> stop me parent active state (Err "task: {why}")
    | Waiting -> _ = Sys.sleepUs 100; (True, state)
    | Ready w i value ->
        (True, (xs, next, remove w active, count - 1, M.insert i value done)).
poll : unsafe Int -> List (Int, Int) -> JoinPoll .
poll me active = case active of
    Nil -> Waiting
  | (w, i) :: rest -> case receiveFromNow me w of
        Err why -> if why == "empty" then poll me rest else Failed "worker {i}: {why}"
      | Ok m ->
          (index, value) = m;
          if index == i then Ready w i value else Failed "worker {i}: invalid completion".
remove : unsafe Int -> List (Int, Int) -> List (Int, Int) .
remove worker active = case active of
    Nil -> Nil
  | (w, i) :: rest -> if w == worker then rest else (w, i) :: remove worker rest.
cancel : unsafe List (Int, Int) -> Unit .
cancel active = case active of
    Nil -> Unit
  | (w, i) :: rest -> _ = kill w; cancel rest.
stop me parent active state result =
  _ = cancel active;
  _ = A.sendSure me parent result;
  (False, state).

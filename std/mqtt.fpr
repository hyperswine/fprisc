# MQTT 3.1.1 packets in FP-RISC: anonymous or username/password CONNECT,
# QoS 0/1, subscriptions, acknowledgements, ping and disconnect. QoS 2/wills
# remain refused. Authentication bytes must travel over a verified transport.

B = use "binary".
L = use "list".
S = use "string".
O = use "option".
M = use "map".
Ord = use "order".
T = use "transport".
OT = use "ownedtransport".

Credentials = Type (UserName String | UserPassword String String).
Packet = Type (Connect String Bool Int | ConnectAuth String Bool Int Credentials | ConnAck Bool Int |
  Publish String String Int Int Bool Bool | PubAck Int |
  Subscribe Int (List (String, Int)) | SubAck Int (List Int) |
  Unsubscribe Int (List String) | UnsubAck Int | PingReq | PingResp | Disconnect).
Decoder = Type (Decoder Int Int String).
Length = Type (Incomplete | Sized Int Int).

identifier n = n > 0 and n <= 65535.

# Strict UTF-8, no NUL, surrogate or Unicode noncharacter scalars. BOM remains
# part of the string. This also rejects overlong encodings and bad continuations.
utf8 : String -> Bool .
utf8 text = utfGo (strlen text + 1) text 0.
utfGo : (fuel : Int | measure fuel) -> String -> Int -> Bool .
utfGo fuel text at | fuel <= 0 = False.
utfGo fuel text at | at >= strlen text = True.
utfGo fuel text at =
  lead = charAt text at;
  if lead < 128 then lead != 0 and utfGo (fuel - 1) text (at + 1) else
  count = if lead >= 194 and lead <= 223 then 1 else if lead >= 224 and lead <= 239 then 2 else if lead >= 240 and lead <= 244 then 3 else 0;
  if count == 0 or at + count >= strlen text then False else
  cp = continuation text (at + 1) count (band lead (if count == 1 then 31 else if count == 2 then 15 else 7));
  cp >= (if count == 1 then 128 else if count == 2 then 2048 else 65536) and cp <= 1114111 and
  not (cp >= 55296 and cp <= 57343) and not (cp >= 64976 and cp <= 65007) and band cp 65535 < 65534 and
  utfGo (fuel - 1) text (at + count + 1).
continuation : String -> Int -> (left : Int | measure left) -> Int -> Int .
continuation text at left value | left <= 0 = value.
continuation text at left value =
  b = charAt text at;
  if b < 128 or b > 191 then 0 - 1 else continuation text (at + 1) (left - 1) (value * 64 + b - 128).
topic text = strlen text > 0 and utf8 text and not (S.contains "+" text) and not (S.contains "#" text).
filter text = strlen text > 0 and utf8 text and filterLevels (S.split "/" text).
filterLevels : (levels : List String | measure levels) -> Bool .
filterLevels levels = case levels of Nil -> True | level :: rest ->
  if level == "#" then rest == Nil else
  if level == "+" then filterLevels rest else
  not (S.contains "#" level) and not (S.contains "+" level) and filterLevels rest.
field text = if strlen text > 65535 or not (utf8 text) then Err "invalid MQTT UTF-8 field" else Ok (strcat (B.putU16be (strlen text)) text).
takeField bytes = if strlen bytes < 2 then Err "short MQTT field" else
  n = charAt bytes 0 * 256 + charAt bytes 1;
  if n > strlen bytes - 2 then Err "short MQTT field" else
  text = substr bytes 2 n;
  if not (utf8 text) then Err "invalid MQTT UTF-8 field" else Ok (text, substr bytes (n + 2) (strlen bytes - n - 2)).
remaining : Int -> String .
remaining n = remainingGo 8 n.
remainingGo : (fuel : Int | measure fuel) -> Int -> String .
remainingGo fuel n | fuel <= 0 = B.putU8 n.
remainingGo fuel n | n < 128 = B.putU8 n.
remainingGo fuel n = strcat (B.putU8 (n % 128 + 128)) (remainingGo (fuel - 1) (n / 128)).
frame header body = if strlen body > 268435455 then Err "MQTT packet too large" else Ok (strJoin "" [B.putU8 header, remaining (strlen body), body]).
fields : (xs : List String | measure xs) -> Result String String .
fields xs = case xs of Nil -> Ok "" | text :: rest -> case field text of
  Err why -> Err why | Ok part -> case fields rest of Err why -> Err why | Ok tail -> Ok (strcat part tail).
subscriptions : (xs : List (String, Int) | measure xs) -> Result String String .
subscriptions xs = case xs of Nil -> Ok "" | (text, qos) :: rest ->
  if not (filter text) or qos < 0 or qos > 1 then Err "unsupported MQTT filter/QoS" else
  case field text of Err why -> Err why | Ok part -> case subscriptions rest of Err why -> Err why | Ok tail -> Ok (strJoin "" [part, B.putU8 qos, tail]).
# MQTT usernames are UTF-8; passwords are length-delimited BINARY bytes,
# including empty values, NUL and non-UTF-8. Errors never include their values.
binaryField text = if strlen text > 65535 then Err "MQTT binary field too long" else Ok (strcat (B.putU16be (strlen text)) text).
takeBinary bytes = if strlen bytes < 2 then Err "short MQTT binary field" else
  n = charAt bytes 0 * 256 + charAt bytes 1;
  if n > strlen bytes - 2 then Err "short MQTT binary field" else Ok (substr bytes 2 n, substr bytes (n + 2) (strlen bytes - n - 2)).
credentials auth = case auth of
    UserName name -> (case field name of Err why -> Err why | Ok user -> Ok (128, user))
  | UserPassword name secret -> case field name of Err why -> Err why | Ok user ->
      case binaryField secret of Err why -> Err why | Ok password -> Ok (192, strcat user password).
connectPacket client clean keepalive auth = case auth of O.None -> Connect client clean keepalive | O.Some c -> ConnectAuth client clean keepalive c.
connectBody client clean keepalive flags payload = if strlen client == 0 or keepalive < 0 or keepalive > 65535 then Err "invalid MQTT CONNECT" else
  case field client of Err why -> Err why | Ok name -> frame 16 (strJoin "" [B.putU16be 4, "MQTT", B.putU8 4, B.putU8 (flags + (if clean then 2 else 0)), B.putU16be keepalive, name, payload]).
encode packet = case packet of
    Connect client clean keepalive -> connectBody client clean keepalive 0 ""
  | ConnectAuth client clean keepalive auth -> (case credentials auth of Err why -> Err why | Ok (flags, payload) -> connectBody client clean keepalive flags payload)
  | ConnAck present code -> if code < 0 or code > 5 or (present and code != 0) then Err "invalid CONNACK" else frame 32 (strcat (B.putU8 (if present then 1 else 0)) (B.putU8 code))
  | Publish name data qos id retain dup ->
      if not (topic name) or qos < 0 or qos > 1 or (qos == 1 and not (identifier id)) or (qos == 0 and (id != 0 or dup)) then Err "invalid/unsupported MQTT PUBLISH" else
      (case field name of Err why -> Err why | Ok text -> frame (48 + qos * 2 + (if retain then 1 else 0) + (if dup then 8 else 0))
        (strJoin "" [text, (if qos == 1 then B.putU16be id else ""), data]))
  | PubAck id -> idPacket 64 id
  | Subscribe id topics -> if not (identifier id) or topics == Nil then Err "invalid SUBSCRIBE" else
      (case subscriptions topics of Err why -> Err why | Ok bytes -> frame 130 (strcat (B.putU16be id) bytes))
  | SubAck id grants -> if not (identifier id) or grants == Nil or not (L.all (fn q -> q == 0 or q == 1 or q == 2 or q == 128) grants) then Err "invalid SUBACK" else frame 144 (strcat (B.putU16be id) (strJoin "" (L.map B.putU8 grants)))
  | Unsubscribe id topics -> if not (identifier id) or topics == Nil or not (L.all filter topics) then Err "invalid UNSUBSCRIBE" else
      (case fields topics of Err why -> Err why | Ok bytes -> frame 162 (strcat (B.putU16be id) bytes))
  | UnsubAck id -> idPacket 176 id
  | PingReq -> frame 192 ""
  | PingResp -> frame 208 ""
  | Disconnect -> frame 224 "".
idPacket header id = if identifier id then frame header (B.putU16be id) else Err "invalid MQTT packet identifier".
lengthAt : String -> (at : Int | measure (5 - at)) -> Int -> Int -> Result Length String .
lengthAt bytes at value multiplier | at > 4 = Err "MQTT Remaining Length exceeds four bytes".
lengthAt bytes at value multiplier | at >= strlen bytes = Ok Incomplete.
lengthAt bytes at value multiplier =
  b = charAt bytes at;
  total = value + band b 127 * multiplier;
  if b < 128 then
    if at > 1 and b == 0 then Err "noncanonical MQTT Remaining Length" else Ok (Sized (at + 1) total)
  else if at == 4 then Err "MQTT Remaining Length exceeds four bytes" else lengthAt bytes (at + 1) total (multiplier * 128).
decoder packetLimit chunkLimit = if packetLimit < 1 or packetLimit > 268435455 or chunkLimit < 1 then Err "invalid MQTT decoder limits" else Ok (Decoder packetLimit chunkLimit "").
feed bytes dec = case dec of Decoder packetLimit chunkLimit pending ->
  if strlen bytes > chunkLimit then Err "MQTT input chunk exceeds limit" else
    combined = strcat pending bytes;
    decodeFrames (strlen combined + 1) packetLimit chunkLimit combined Nil.
decodeFrames : (fuel : Int | measure fuel) -> Int -> Int -> String -> List Packet -> Result (List Packet, Decoder) String .
decodeFrames fuel limit chunk bytes acc | fuel <= 0 = Ok (L.reverse acc, Decoder limit chunk bytes).
decodeFrames fuel limit chunk bytes acc | strlen bytes < 2 = Ok (L.reverse acc, Decoder limit chunk bytes).
decodeFrames fuel limit chunk bytes acc =
  case lengthAt bytes 1 0 1 of
    Err why -> Err why
  | Ok Incomplete -> Ok (L.reverse acc, Decoder limit chunk bytes)
  | Ok (Sized header n) -> if n > limit then Err "MQTT packet exceeds limit" else
      if strlen bytes - header < n then Ok (L.reverse acc, Decoder limit chunk bytes) else
      case decodePacket (charAt bytes 0) (substr bytes header n) of
        Err why -> Err why
      | Ok packet -> decodeFrames (fuel - 1) limit chunk (substr bytes (header + n) (strlen bytes - header - n)) (packet :: acc).
readId bytes = if strlen bytes < 2 then Err "short MQTT identifier" else
  id = charAt bytes 0 * 256 + charAt bytes 1;
  if identifier id then Ok (id, substr bytes 2 (strlen bytes - 2)) else Err "zero MQTT identifier".
decodeSubscriptions : String -> Result (List (String, Int)) String .
decodeSubscriptions bytes = decodeSubsGo (strlen bytes + 1) bytes.
decodeSubsGo : (fuel : Int | measure fuel) -> String -> Result (List (String, Int)) String .
decodeSubsGo fuel bytes | fuel <= 0 = Ok Nil.
decodeSubsGo fuel bytes | strlen bytes == 0 = Ok Nil.
decodeSubsGo fuel bytes = case takeField bytes of
    Err why -> Err why
  | Ok (text, rest) -> if strlen rest == 0 or not (filter text) or charAt rest 0 > 1 then Err "invalid/unsupported subscription" else
      case decodeSubsGo (fuel - 1) (substr rest 1 (strlen rest - 1)) of Err why -> Err why | Ok tail -> Ok ((text, charAt rest 0) :: tail).
decodeFields : String -> Result (List String) String .
decodeFields bytes = decodeFieldsGo (strlen bytes + 1) bytes.
decodeFieldsGo : (fuel : Int | measure fuel) -> String -> Result (List String) String .
decodeFieldsGo fuel bytes | fuel <= 0 = Ok Nil.
decodeFieldsGo fuel bytes | strlen bytes == 0 = Ok Nil.
decodeFieldsGo fuel bytes = case takeField bytes of
    Err why -> Err why
  | Ok (text, rest) -> if not (filter text) then Err "invalid topic filter" else
      case decodeFieldsGo (fuel - 1) rest of Err why -> Err why | Ok tail -> Ok (text :: tail).
decodePacket first body =
  kind = first / 16;
  flags = first % 16;
  if kind != 3 and flags != (if kind == 8 or kind == 10 then 2 else 0) then Err "invalid MQTT fixed flags" else
  case kind of
    1 -> (case takeField body of Err why -> Err why | Ok (protocol, rest) ->
      if protocol != "MQTT" or strlen rest < 4 or charAt rest 0 != 4 then Err "unsupported MQTT protocol" else
      flags = charAt rest 1;
      if band flags 61 != 0 or (band flags 64 != 0 and band flags 128 == 0) then Err "unsupported/invalid CONNECT flags" else
      case takeField (substr rest 4 (strlen rest - 4)) of Err why -> Err why | Ok (client, tail) ->
        if strlen client == 0 then Err "invalid MQTT CONNECT payload" else
        clean = band flags 2 != 0; keepalive = charAt rest 2 * 256 + charAt rest 3;
        if band flags 128 == 0 then
          if tail != "" then Err "invalid MQTT CONNECT payload" else Ok (Connect client clean keepalive)
        else case takeField tail of Err why -> Err why | Ok (user, more) ->
          if band flags 64 == 0 then
            if more != "" then Err "invalid MQTT CONNECT payload" else Ok (ConnectAuth client clean keepalive (UserName user))
          else case takeBinary more of Err why -> Err why | Ok (secret, extra) ->
            if extra != "" then Err "invalid MQTT CONNECT payload" else Ok (ConnectAuth client clean keepalive (UserPassword user secret)))
  | 2 -> if strlen body != 2 then Err "invalid CONNACK size" else
      present = charAt body 0; code = charAt body 1;
      if present > 1 or code > 5 or (code != 0 and present != 0) then Err "invalid CONNACK" else Ok (ConnAck (present == 1) code)
  | 3 ->
      qos = band (BITSHIFTR flags 1) 3;
      dup = band flags 8 != 0;
      if qos > 1 or (qos == 0 and dup) then Err "unsupported/invalid PUBLISH QoS" else
      (case takeField body of Err why -> Err why | Ok (name, rest) ->
        if not (topic name) then Err "invalid PUBLISH topic" else
        if qos == 0 then Ok (Publish name rest 0 0 (band flags 1 != 0) dup) else
        (case readId rest of Err why -> Err why | Ok (id, payload) -> Ok (Publish name payload 1 id (band flags 1 != 0) dup)))
  | 4 -> (case readId body of Err why -> Err why | Ok (id, rest) -> if rest == "" then Ok (PubAck id) else Err "invalid PUBACK size")
  | 8 -> (case readId body of Err why -> Err why | Ok (id, rest) -> case decodeSubscriptions rest of Err why -> Err why | Ok xs -> if xs == Nil then Err "empty SUBSCRIBE" else Ok (Subscribe id xs))
  | 9 -> (case readId body of Err why -> Err why | Ok (id, rest) ->
      grants = L.map (fn at -> charAt rest at) (L.range 0 (strlen rest - 1));
      if strlen rest == 0 or not (L.all (fn q -> q == 0 or q == 1 or q == 2 or q == 128) grants) then Err "invalid SUBACK grants" else Ok (SubAck id grants))
  | 10 -> (case readId body of Err why -> Err why | Ok (id, rest) -> case decodeFields rest of Err why -> Err why | Ok xs -> if xs == Nil then Err "empty UNSUBSCRIBE" else Ok (Unsubscribe id xs))
  | 11 -> (case readId body of Err why -> Err why | Ok (id, rest) -> if rest == "" then Ok (UnsubAck id) else Err "invalid UNSUBACK size")
  | 12 -> if body == "" then Ok PingReq else Err "invalid PINGREQ size"
  | 13 -> if body == "" then Ok PingResp else Err "invalid PINGRESP size"
  | 14 -> if body == "" then Ok Disconnect else Err "invalid DISCONNECT size"
  | _ -> Err "unsupported MQTT control packet".

# ---- Pure MQTT 3.1.1 session state/effects -------------------------------------
# Pure MQTT 3.1.1 client state/effects. Connection epochs exclude late events.
# QoS 1 stays in flight until PUBACK; retransmission is on explicit reconnect,
# with DUP and the original ID. State survives reconnect, not process restart.
Phase = Type (Offline | Connecting | Online).
Config = Type (Config String Bool Int Int Int (O.Option Credentials)).
Pending = Type (Publication Packet | Subscription (List (String, Int)) | Unsubscription (List String)).
Event = Type (Start Int | Received Int Int Packet | PublishMsg Int String String Int Bool |
  SubscribeTo Int (List (String, Int)) | UnsubscribeFrom Int (List String) | Tick Int | Lost Int String | Stop Int).
Effect = Type (Send Int Packet | Delivered String String Int Bool Bool |
  Acked Int | Subscribed Int (List Int) | Unsubscribed Int | Up Int Bool | Down Int String | Rejected String).
config client clean keepalive ackMs capacity = configWith O.None client clean keepalive ackMs capacity.
configAuth auth client clean keepalive ackMs capacity = configWith (O.Some auth) client clean keepalive ackMs capacity.
configWith auth client clean keepalive ackMs capacity =
  if strlen client == 0 or strlen client > 65535 or not (utf8 client) or keepalive < 0 or keepalive > 65535 or ackMs < 1 or capacity < 1 or capacity > 65535 then Err "invalid MQTT session configuration"
  else case encode (connectPacket client clean keepalive auth) of
    Err _ -> Err "invalid MQTT authentication configuration"
  | Ok _ -> Ok (Config client clean keepalive ackMs capacity auth).
initial cfg = {config = cfg, phase = Offline, pending = M.empty Ord.int,
  order = Nil, nextId = 1, lastSent = 0, ping = O.None, epoch = 0, connDeadline = 0}.
ackMs cfg = case cfg of Config _ _ _ ms _ _ -> ms.
clean cfg = case cfg of Config _ value _ _ _ _ -> value.
capacity cfg = case cfg of Config _ _ _ _ n _ -> n.
keepMs cfg = case cfg of Config _ _ sec _ _ _ -> sec * 1000.
nextIdentifier id pending = if M.member id pending then nextIdentifier (if id == 65535 then 1 else id + 1) pending else id.
down why state = ({state | phase = Offline, ping = O.None,
  order = if clean state.config then Nil else state.order,
  pending = if clean state.config then M.empty Ord.int else state.pending}, [Down state.epoch why]).
retry id item = case item of
    Publication (Publish topic payload qos packetId retain _) -> Publish topic payload qos packetId retain True
  | Publication packet -> packet
  | Subscription topics -> Subscribe id topics
  | Unsubscription topics -> Unsubscribe id topics.
resend now state =
  pending = M.map (fn pair -> case pair of (item, _) -> (item, now + ackMs state.config)) state.pending;
  effects = L.filterMap (fn id -> case M.get id pending of O.None -> O.None | O.Some (item, _) -> O.Some (Send state.epoch (retry id item))) state.order;
  ({state | pending = pending, lastSent = if effects == Nil then state.lastSent else now}, effects).
admit now item packet id state = case encode packet of
    Err why -> (state, [Rejected why])
  | Ok _ ->
      pending = if id == 0 then state.pending else M.insert id (item, now + ackMs state.config) state.pending;
      ({state | pending = pending, order = if id == 0 then state.order else L.append state.order [id], lastSent = now, nextId = if id == 0 then state.nextId else if id == 65535 then 1 else id + 1}, [Send state.epoch packet]).
step event state =
  now = case event of Start n -> n | Received _ n _ -> n | PublishMsg n _ _ _ _ -> n | SubscribeTo n _ -> n | UnsubscribeFrom n _ -> n | Tick n -> n | Lost _ _ -> state.lastSent | Stop n -> n;
  if now < 0 then (state, [Rejected "invalid MQTT clock"]) else
  case event of
    Start _ ->
      if state.phase != Offline then (state, [Rejected "already connected/connecting"]) else
      (case state.config of Config client clean keepalive _ _ auth ->
        epoch = state.epoch + 1;
        ({state | phase = Connecting, epoch = epoch, connDeadline = now + ackMs state.config, lastSent = now, ping = O.None}, [Send epoch (connectPacket client clean keepalive auth)]))
  | Lost epoch why -> if epoch != state.epoch then (state, Nil) else down why state
  | Stop _ ->
      (next, notes) = down "client stopped" state;
      (next, if state.phase == Offline then notes else Send state.epoch Disconnect :: notes)
  | PublishMsg _ topic payload qos retain ->
      if state.phase != Online then (state, [Rejected "not connected"]) else
      if qos == 1 and M.size state.pending >= capacity state.config then (state, [Rejected "MQTT in-flight limit"]) else
      id = if qos == 1 then nextIdentifier state.nextId state.pending else 0;
      packet = Publish topic payload qos id retain False;
      admit now (Publication packet) packet id state
  | SubscribeTo _ topics -> if state.phase != Online then (state, [Rejected "not connected"]) else
      if M.size state.pending >= capacity state.config then (state, [Rejected "MQTT in-flight limit"]) else
      id = nextIdentifier state.nextId state.pending;
      admit now (Subscription topics) (Subscribe id topics) id state
  | UnsubscribeFrom _ topics -> if state.phase != Online then (state, [Rejected "not connected"]) else
      if M.size state.pending >= capacity state.config then (state, [Rejected "MQTT in-flight limit"]) else
      id = nextIdentifier state.nextId state.pending;
      admit now (Unsubscription topics) (Unsubscribe id topics) id state
  | Tick _ -> tick now state
  | Received epoch _ packet -> if epoch != state.epoch or state.phase == Offline then (state, Nil) else
      if state.phase == Connecting then (case packet of
        ConnAck present code -> if code != 0 then down "broker refused CONNECT ({code})" state else
          if present and clean state.config then down "session present with clean CONNECT" state else
          (fresh, sends) = resend now {state | phase = Online};
          (fresh, Up epoch present :: sends)
      | _ -> down "expected CONNACK" state)
      else incoming now packet state.
incoming now packet state = case packet of
    Publish pubTopic payload qos id retain dup ->
      if not (topic pubTopic) or qos < 0 or qos > 1 or (qos == 1 and not (identifier id)) or (qos == 0 and (id != 0 or dup)) then down "invalid server PUBLISH" state else
      ({state | lastSent = if qos == 1 then now else state.lastSent},
       Delivered pubTopic payload qos retain dup :: (if qos == 1 then [Send state.epoch (PubAck id)] else Nil))
  | PubAck id -> (case M.get id state.pending of
      O.Some (Publication _, _) -> ({state | pending = M.remove id state.pending, order = L.filter (fn n -> n != id) state.order}, [Acked id])
    | _ -> down "unexpected PUBACK identifier" state)
  | SubAck id grants -> (case M.get id state.pending of
      O.Some (Subscription topics, _) ->
        if L.length topics != L.length grants or not (L.all (fn pair -> case pair of ((_, requested), grant) -> grant == 128 or (grant >= 0 and grant <= requested)) (L.zip topics grants)) then down "invalid SUBACK grants" state
        else ({state | pending = M.remove id state.pending, order = L.filter (fn n -> n != id) state.order}, [Subscribed id grants])
    | _ -> down "unexpected SUBACK identifier" state)
  | UnsubAck id -> (case M.get id state.pending of
      O.Some (Unsubscription _, _) -> ({state | pending = M.remove id state.pending, order = L.filter (fn n -> n != id) state.order}, [Unsubscribed id])
    | _ -> down "unexpected UNSUBACK identifier" state)
  | PingResp -> if state.ping == O.None then down "unsolicited PINGRESP" state else ({state | ping = O.None}, Nil)
  | _ -> down "unexpected server control packet" state.
tick now state = if state.phase == Connecting then
  if now >= state.connDeadline then down "CONNACK timed out" state else (state, Nil)
  else if state.phase != Online then (state, Nil) else
  if L.any (fn pair -> case pair of (_, deadline) -> now >= deadline) (M.values state.pending) then down "acknowledgement timed out" state else
  case state.ping of
    O.Some deadline -> if now >= deadline then down "PINGRESP timed out" state else (state, Nil)
  | O.None -> if keepMs state.config > 0 and now - state.lastSent >= keepMs state.config then
      ({state | lastSent = now, ping = O.Some (now + ackMs state.config)}, [Send state.epoch PingReq])
    else (state, Nil).
minDeadline a b = case (a, b) of (O.None, x) -> x | (x, O.None) -> x | (O.Some x, O.Some y) -> O.Some (if x < y then x else y).
nextDeadline state =
  base = if state.phase == Connecting then O.Some state.connDeadline else O.None;
  pending = M.fold (fn d id pair -> case pair of (_, deadline) -> minDeadline d (O.Some deadline)) base state.pending;
  ping = case state.ping of O.Some deadline -> O.Some deadline | O.None -> if state.phase == Online and keepMs state.config > 0 then O.Some (state.lastSent + keepMs state.config) else O.None;
  minDeadline ping pending.

# ---- Single-owner MQTT pump over Transport -------------------------------------
# A single-owner MQTT pump over any Transport, including native TLS. next uses
# one-attempt reads and shorter readiness wakes for keepalive; an idle deadline
# returns Ok Nil and retains the pending read instead of abandoning it.
# std/ownedmqtt supplies the linear application-facing owner of this pump.
create config packetLimit chunkLimit connection = case decoder packetLimit chunkLimit of
    Err why -> Err (T.Invalid why)
  | Ok decoder -> Ok {session = initial config, decoder = decoder, connection = connection,
      packetLimit = packetLimit, chunkLimit = chunkLimit, outbox = Nil, canSend = True, undelivered = Nil}.
now u = Sys.timeUs Unit / 1000.
update event client =
  (session, effects) = step event client.session;
  packets = L.filterMap (fn effect -> case effect of Send epoch packet -> if epoch == session.epoch then O.Some packet else O.None | _ -> O.None) effects;
  notices = L.filter (fn effect -> case effect of Send _ _ -> False | _ -> True) effects;
  ({client | session = session, outbox = L.append client.outbox packets}, notices).
lost why client =
  (session, _) = step (Lost client.session.epoch "{why}") client.session;
  (reason, conn) = T.failed why client.connection;
  (_, closed) = T.close conn;
  (Err reason, {client | session = session, connection = closed, outbox = Nil}).
flush budget client = if not client.canSend then (Ok Unit, client) else case client.outbox of
    Nil -> (Ok Unit, client)
  | packet :: rest -> (case encode packet of
      Err why -> lost (T.Invalid why) client
    | Ok bytes -> if not (withinLimit client.packetLimit bytes) then lost (T.Invalid "outgoing MQTT packet exceeds limit") client else
        case T.writeAll budget bytes client.connection of
          (Err (why, _), conn) -> lost why {client | connection = conn}
        | (Ok _, conn) -> flush budget {client | connection = conn, outbox = rest}).
withinLimit limit bytes = case lengthAt bytes 1 0 1 of Ok (Sized _ n) -> n <= limit | _ -> False.
needsRoom event = case event of PublishMsg _ _ _ _ _ -> True | SubscribeTo _ _ -> True | UnsubscribeFrom _ _ -> True | _ -> False.
apply budget event client = if needsRoom event and L.length client.outbox >= capacity client.session.config then (Err (T.Invalid "MQTT outgoing queue full"), client) else
  (updated, notices) = update event client;
  case flush budget updated of (Err why, next) -> (Err why, next) | (Ok _, next) -> (Ok notices, next).
begin budget client = apply budget (Start (now Unit)) client.
publish budget topic payload qos retain client = if strlen topic > client.packetLimit or strlen payload > client.packetLimit - strlen topic then
  (Err (T.Invalid "outgoing MQTT packet exceeds limit"), client)
  else apply budget (PublishMsg (now Unit) topic payload qos retain) client.
subscribe budget topics client = apply budget (SubscribeTo (now Unit) topics) client.
unsubscribe budget topics client = apply budget (UnsubscribeFrom (now Unit) topics) client.
received packets client = case packets of
    Nil -> (client, Nil)
  | packet :: rest ->
      (updated, notices) = update (Received client.session.epoch (now Unit) packet) client;
      (next, more) = received rest updated;
      (next, L.append notices more).
wakeBudget budget session =
  deadline = case nextDeadline session of
    O.None -> T.deadline budget
  | O.Some ms -> if ms * 1000 < T.deadline budget then ms * 1000 else T.deadline budget;
  case budget of T.Uncancelled _ -> T.Uncancelled deadline | T.Budget _ cancelled -> T.Budget deadline cancelled.
next budget client = if T.isCancelled budget then lost T.Cancelled client else
  if Sys.timeUs Unit >= T.deadline budget then (Ok Nil, client) else
  (ticked, notices) = update (Tick (now Unit)) client;
  if ticked.session.phase == Offline then
    (_, closed) = T.close ticked.connection;
    (Ok notices, {ticked | connection = closed, outbox = Nil})
  else case flush budget ticked of
    (Err why, fresh) -> (Err why, fresh)
  | (Ok _, fresh) -> (case T.attemptRead budget fresh.chunkLimit fresh.connection of
      (Err (why, _), conn) -> lost why {fresh | connection = conn}
    | (Ok step, conn) ->
        current = {fresh | connection = conn};
        case step of
          T.End -> lost T.EndOfStream current
        | T.ReadFault why -> lost why current
        | T.Data bytes -> (case feed bytes current.decoder of
            Err why -> lost (T.Invalid why) current
          | Ok (packets, decoder) ->
              (updated, notes) = received packets {current | decoder = decoder, canSend = True};
              if updated.session.phase == Offline then
                (_, closed) = T.close updated.connection;
                (Ok notes, {updated | connection = closed, outbox = Nil})
              else case flush budget {updated | undelivered = notes} of
                (Err why, final) -> (Err why, final)
              | (Ok _, final) -> if notes == Nil then next budget final else (Ok notes, {final | undelivered = Nil}))
        | T.ReadWait interest ->
            waiting = {current | canSend = interest == T.Readable or interest == T.ReadWrite};
            # A timer can emit PINGREQ while the retained TLS read waits for
            # readable I/O. Flush it before blocking on that read again.
            if waiting.canSend and waiting.outbox != Nil then next budget waiting else
            case T.pause (wakeBudget budget waiting.session) interest waiting.connection of
              (Err T.TimedOut, conn2) -> next budget {waiting | connection = conn2}
            | (Err why, conn2) -> lost why {waiting | connection = conn2}
            | (Ok _, conn2) -> next budget {waiting | connection = conn2}).
reattach connection client =
  (_, _) = T.close client.connection;
  (session, _) = step (Lost client.session.epoch "connection replaced") client.session;
  dec = case decoder client.packetLimit client.chunkLimit of Ok d -> d | Err why -> error why;
  {client | connection = connection, session = session, decoder = dec, outbox = Nil, canSend = True}.
# A received publication is retained even when sending its PUBACK fails. Drain
# these notices on the error path; retries do not imply application deduplication.
takeNotices client = (client.undelivered, {client | undelivered = Nil}).
stop budget client =
  (result, next) = apply budget (Stop (now Unit)) client;
  (_, closed) = T.close next.connection;
  (if next.outbox != Nil then Err (T.Io "MQTT DISCONNECT was not sent before close") else result, {next | connection = closed, outbox = Nil}).

# ---- Linear application-facing MQTT owner --------------------------------------
# The raw protocol pump stays a mechanism; this facade owns it linearly.
# Explicit sum types keep ownership visible in constructor patterns without
# relying on generic Option/Result's currently shallow linearity shapes.
Client 1 s = Type (Client s).
Slot 1 s = Type (Empty | Active (Client s)).
Created 1 s = Type (Created (Client s) | CreateFailed T.Failure).
ownedCreate config packetLimit chunkLimit owner =
  OT.Connection raw = owner;
  case create config packetLimit chunkLimit raw of
    Err why -> (case T.close raw of
        (Ok _, terminal) -> CreateFailed why
      | (Err cleanup, terminal) -> CreateFailed (T.CleanupFailed why cleanup))
  | Ok client -> Created (Client client).
ownedBegin budget owner = Client raw = owner; (r, next) = begin budget raw; (r, Client next).
ownedNext budget owner = Client raw = owner; (r, next) = next budget raw; (r, Client next).
ownedSubscribe budget topics owner = Client raw = owner; (r, next) = subscribe budget topics raw; (r, Client next).
ownedPublish budget topic payload qos retain owner = Client raw = owner; (r, next) = publish budget topic payload qos retain raw; (r, Client next).
ownedTakeNotices owner = Client raw = owner; (notes, next) = takeNotices raw; (notes, Client next).
ownedPhase owner = Client raw = owner; (raw.session.phase, Client raw).
ownedClose owner = Client raw = owner; (r, terminal) = T.close raw.connection; r.
ownedStop budget owner = Client raw = owner; (r, terminal) = stop budget raw; r.
closeSlot slot = case slot of Empty -> Ok Unit | Active client -> ownedClose client.

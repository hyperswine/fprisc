# std/wire.fpr -- Wire bytes: one binary format for what a compiler-minted codec
# speaks (the prelude's `Wire`) and for std/json's `Value`, with a dial between
# speed and size.
#
#   W = use "std/wire".
#   bytes = W.pickle W.Compact @Model.cart cart       # a header and one frame
#   W.unpickle @Model.cart bytes                      # Ok cart, or Err why
#
# THE DIAL.  Every value is a tag byte followed by varints and bytes.
#   Fast     names (record fields, constructors) and strings are written inline:
#            each record decodes alone, like a JSON line, only smaller and faster
#   Compact  a NAME is written once per stream and then referred to by number
#   Small    every STRING is, too (keys, repeated text values)
# Interning makes records depend on the ones before them in the same stream, so
# a stream (a log file) is read from its start; that is how a log is read anyway.
#
# FRAMES.  A stream is a header -- "FPRW", a version byte, the level -- then
# frames: a varint length, the payload, and an Adler-32 of the payload.  Reading
# keeps the valid PREFIX: a torn or damaged frame ends the read, and how many
# bytes were left unread is reported, never silently dropped.
#
# The format is a contract: data written by one compiler and runtime is read by
# any later one (it never depends on the heap's layout, unlike a memory image).

J = use "json".
M = use "map".
S = use "string".
O = use "option".
Ord = use "order".

Level = Type (Fast | Compact | Small).

# encoder: the level, the strings already numbered, the next number
Enc = Type (Enc Level (M.Map String Int) Int).
# decoder: the numbers already defined, the next number
Dec = Type (Dec (M.Map Int String) Int).

encoder : Level -> Enc .
encoder level = Enc level (M.empty S.compare) 0.
decoder : Unit -> Dec .
decoder u = Dec (M.empty Ord.int) 0.

levelByte : Level -> Int .
levelByte level = case level of Fast -> 0 | Compact -> 1 | Small -> 2.
levelOf : Int -> Result Level String .
levelOf b = case b of 0 -> Ok Fast | 1 -> Ok Compact | 2 -> Ok Small | _ -> Err "wire: unknown level {b}".

# the tags
tUint = 0.
tNeg = 1.
tFalse = 2.
tTrue = 3.
tNull = 4.
tText = 5.
tRef = 6.
tDef = 7.
tList = 8.
tRec = 9.
tCon = 10.
tReal = 11.

# ---- writing: pieces gathered in reverse, joined once --------------------------------
rev : unsafe List a -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# a varint, low seven bits first (n >= 0)
varint : unsafe Int -> List String -> List String .
varint n acc = if n < 128 then chr n :: acc else varint (BITSHIFTR n 7) (chr (bor (band n 127) 128) :: acc).

bytes : unsafe String -> List String -> List String .
bytes s acc = s :: varint (strlen s) acc.

int : unsafe Int -> List String -> List String .
int n acc = if n >= 0 then varint n (chr tUint :: acc) else varint (0 - (n + 1)) (chr tNeg :: acc).

# a string: inline, or numbered on first sight and referred to after
str : unsafe Bool -> String -> Enc -> List String -> (List String, Enc) .
str intern s e acc = case intern of
    False -> (bytes s (chr tText :: acc), e)
  | True -> strNumbered s e acc.
strNumbered : unsafe String -> Enc -> List String -> (List String, Enc) .
strNumbered s e acc = case e of
  Enc level seen next -> (case M.get s seen of
      O.Some i -> (varint i (chr tRef :: acc), e)
    | O.None -> (bytes s (chr tDef :: acc), Enc level (M.insert s next seen) (next + 1))).

internNames : Enc -> Bool .
internNames e = case e of Enc level _ _ -> (case level of Fast -> False | _ -> True).
internStrings : Enc -> Bool .
internStrings e = case e of Enc level _ _ -> (case level of Small -> True | _ -> False).

# a name (record field, constructor) and a string value, at the encoder's level
name : unsafe String -> Enc -> List String -> (List String, Enc) .
name s e acc = str (internNames e) s e acc.
text : unsafe String -> Enc -> List String -> (List String, Enc) .
text s e acc = str (internStrings e) s e acc.

# ---- a Wire ----
wire : unsafe Wire -> Enc -> List String -> (List String, Enc) .
wire w e acc = case w of
    WInt n -> (int n acc, e)
  | WBool b -> (chr (if b then tTrue else tFalse) :: acc, e)
  | WStr s -> text s e acc
  | WList xs -> wires xs e (varint (listLen xs) (chr tList :: acc))
  | WRec fs -> fields fs e (varint (listLen fs) (chr tRec :: acc))
  | WCon c xs -> conArgs xs (name c e (chr tCon :: acc)).
conArgs : unsafe List Wire -> (List String, Enc) -> (List String, Enc) .
conArgs xs got = case got of (acc, e) -> wires xs e (varint (listLen xs) acc).
wires : unsafe List Wire -> Enc -> List String -> (List String, Enc) .
wires xs e acc = case xs of
    Nil -> (acc, e)
  | x :: r -> (case wire x e acc of (acc2, e2) -> wires r e2 acc2).
fields : unsafe List (String, Wire) -> Enc -> List String -> (List String, Enc) .
fields fs e acc = case fs of
    Nil -> (acc, e)
  | (k, v) :: r -> (case name k e acc of (acc2, e2) -> (case wire v e2 acc2 of (acc3, e3) -> fields r e3 acc3)).

# ---- a Json.Value (lossless: null and reals have tags of their own) ----
value : unsafe J.Value -> Enc -> List String -> (List String, Enc) .
value v e acc = case v of
    J.Null -> (chr tNull :: acc, e)
  | J.Boolean b -> (chr (if b then tTrue else tFalse) :: acc, e)
  | J.Integer n -> (int n acc, e)
  | J.Real t -> (bytes t (chr tReal :: acc), e)
  | J.Text s -> text s e acc
  | J.Sequence xs -> values xs e (varint (listLen xs) (chr tList :: acc))
  | J.Object m -> members (M.entries m) e (varint (M.size m) (chr tRec :: acc)).
values : unsafe List J.Value -> Enc -> List String -> (List String, Enc) .
values xs e acc = case xs of
    Nil -> (acc, e)
  | x :: r -> (case value x e acc of (acc2, e2) -> values r e2 acc2).
members : unsafe List (String, J.Value) -> Enc -> List String -> (List String, Enc) .
members kvs e acc = case kvs of
    Nil -> (acc, e)
  | (k, v) :: r -> (case name k e acc of (acc2, e2) -> (case value v e2 acc2 of (acc3, e3) -> members r e3 acc3)).

# the pieces of one payload, as a String (and the encoder after it)
join : unsafe (List String, Enc) -> (String, Enc) .
join got = case got of (acc, e) -> (strJoin "" (rev acc Nil), e).

putWire : Enc -> Wire -> (String, Enc) .
putWire e w = join (wire w e Nil).
putValue : Enc -> J.Value -> (String, Enc) .
putValue e v = join (value v e Nil).
putInt : Int -> String .
putInt n = strJoin "" (rev (int n Nil) Nil).
putName : Enc -> String -> (String, Enc) .
putName e s = join (name s e Nil).
putText : Enc -> String -> (String, Enc) .
putText e s = join (text s e Nil).

# ---- reading: (value, next position, decoder), or why not ------------------------------
Got a = Type (Got a Int Dec | Bad String).

varAt : unsafe String -> Int -> Int -> Int -> Result (Int, Int) String .
varAt s at shift acc = case at >= strlen s of
    True -> Err "wire: truncated number"
  | False -> varByte s at shift acc (charAt s at).
varByte : unsafe String -> Int -> Int -> Int -> Int -> Result (Int, Int) String .
varByte s at shift acc b = case shift > 56 or (shift == 56 and band b 127 > 63) of
    True -> Err "wire: number too large"
  | False -> (case b >= 128 of
      True -> varAt s (at + 1) (shift + 7) (bor acc (BITSHIFTL (b - 128) shift))
    | False -> Ok (bor acc (BITSHIFTL b shift), at + 1)).

# a string in one of its three forms (inline, defined here, referred to)
strAt : unsafe String -> Int -> Dec -> Got String .
strAt s at d = case at >= strlen s of
    True -> Bad "wire: truncated string"
  | False -> strTag s (at + 1) d (charAt s at).
strTag : unsafe String -> Int -> Dec -> Int -> Got String .
strTag s at d tag = case varAt s at 0 0 of
    Err why -> Bad why
  | Ok (n, p) -> (case tag == tRef of
      True -> (case d of Dec seen next -> (case M.get n seen of
          O.Some t -> Got t p d
        | O.None -> Bad "wire: string {n} referred to before it was defined"))
    | False -> (case p + n > strlen s of
        True -> Bad "wire: truncated string"
      | False -> strDef s p n d tag)).
strDef : String -> Int -> Int -> Dec -> Int -> Got String .
strDef s p n d tag = case tag == tText or tag == tReal of
    True -> Got (substr s p n) (p + n) d
  | False -> (case tag == tDef of
      True -> (case d of Dec seen next -> Got (substr s p n) (p + n) (Dec (M.insert next (substr s p n) seen) (next + 1)))
    | False -> Bad "wire: expected a string, found tag {tag}").

getWire : Dec -> String -> Int -> Got Wire .
getWire d s at = wireAt s at d.
wireAt : unsafe String -> Int -> Dec -> Got Wire .
wireAt s at d = case at >= strlen s of
    True -> Bad "wire: truncated value"
  | False -> wireTag s at d (charAt s at).
wireTag : unsafe String -> Int -> Dec -> Int -> Got Wire .
wireTag s at d tag = case tag of
    0 -> intGot (varAt s (at + 1) 0 0) False d WInt
  | 1 -> intGot (varAt s (at + 1) 0 0) True d WInt
  | 2 -> Got (WBool False) (at + 1) d
  | 3 -> Got (WBool True) (at + 1) d
  | 8 -> (case varAt s (at + 1) 0 0 of Err why -> Bad why | Ok (n, p) -> wireList s p d n Nil)
  | 9 -> (case varAt s (at + 1) 0 0 of Err why -> Bad why | Ok (n, p) -> wireFields s p d n Nil)
  | 10 -> (case strAt s (at + 1) d of
        Bad why -> Bad why
      | Got c p d2 -> (case varAt s p 0 0 of Err why -> Bad why | Ok (n, q) -> wireCon c s q d2 n Nil))
  | _ -> (case tag == tText or tag == tRef or tag == tDef of
        True -> (case strAt s at d of Bad why -> Bad why | Got t p d2 -> Got (WStr t) p d2)
      | False -> Bad "wire: no Wire value has tag {tag}").
intGot : Result (Int, Int) String -> Bool -> Dec -> (Int -> a) -> Got a .
intGot r neg d k = case r of
    Err why -> Bad why
  | Ok (m, p) -> Got (k (if neg then 0 - m - 1 else m)) p d.
wireList : unsafe String -> Int -> Dec -> Int -> List Wire -> Got Wire .
wireList s at d n acc = case n == 0 of
    True -> Got (WList (rev acc Nil)) at d
  | False -> (case wireAt s at d of Bad why -> Bad why | Got w p d2 -> wireList s p d2 (n - 1) (w :: acc)).
wireCon : unsafe String -> String -> Int -> Dec -> Int -> List Wire -> Got Wire .
wireCon c s at d n acc = case n == 0 of
    True -> Got (WCon c (rev acc Nil)) at d
  | False -> (case wireAt s at d of Bad why -> Bad why | Got w p d2 -> wireCon c s p d2 (n - 1) (w :: acc)).
wireFields : unsafe String -> Int -> Dec -> Int -> List (String, Wire) -> Got Wire .
wireFields s at d n acc = case n == 0 of
    True -> Got (WRec (rev acc Nil)) at d
  | False -> (case strAt s at d of
      Bad why -> Bad why
    | Got k p d2 -> (case wireAt s p d2 of Bad why -> Bad why | Got w q d3 -> wireFields s q d3 (n - 1) ((k, w) :: acc))).

getValue : Dec -> String -> Int -> Got J.Value .
getValue d s at = valueAt s at d.
valueAt : unsafe String -> Int -> Dec -> Got J.Value .
valueAt s at d = case at >= strlen s of
    True -> Bad "wire: truncated value"
  | False -> valueTag s at d (charAt s at).
valueTag : unsafe String -> Int -> Dec -> Int -> Got J.Value .
valueTag s at d tag = case tag of
    0 -> intGot (varAt s (at + 1) 0 0) False d J.Integer
  | 1 -> intGot (varAt s (at + 1) 0 0) True d J.Integer
  | 2 -> Got (J.Boolean False) (at + 1) d
  | 3 -> Got (J.Boolean True) (at + 1) d
  | 4 -> Got J.Null (at + 1) d
  | 8 -> (case varAt s (at + 1) 0 0 of Err why -> Bad why | Ok (n, p) -> valueList s p d n Nil)
  | 9 -> (case varAt s (at + 1) 0 0 of Err why -> Bad why | Ok (n, p) -> valueMembers s p d n (M.empty S.compare))
  | 11 -> (case strAt s at d of Bad why -> Bad why | Got t p d2 -> Got (J.Real t) p d2)
  | _ -> (case tag == tText or tag == tRef or tag == tDef of
        True -> (case strAt s at d of Bad why -> Bad why | Got t p d2 -> Got (J.Text t) p d2)
      | False -> Bad "wire: no Json value has tag {tag}").
valueList : unsafe String -> Int -> Dec -> Int -> List J.Value -> Got J.Value .
valueList s at d n acc = case n == 0 of
    True -> Got (J.Sequence (rev acc Nil)) at d
  | False -> (case valueAt s at d of Bad why -> Bad why | Got v p d2 -> valueList s p d2 (n - 1) (v :: acc)).
valueMembers : unsafe String -> Int -> Dec -> Int -> M.Map String J.Value -> Got J.Value .
valueMembers s at d n m = case n == 0 of
    True -> Got (J.Object m) at d
  | False -> (case strAt s at d of
      Bad why -> Bad why
    | Got k p d2 -> (case valueAt s p d2 of Bad why -> Bad why | Got v q d3 -> valueMembers s q d3 (n - 1) (M.insert k v m))).

getInt : String -> Int -> Got Int .
getInt s at = case at >= strlen s of
    True -> Bad "wire: truncated number"
  | False -> (case charAt s at of
      0 -> intGot (varAt s (at + 1) 0 0) False (decoder Unit) (fn n -> n)
    | 1 -> intGot (varAt s (at + 1) 0 0) True (decoder Unit) (fn n -> n)
    | t -> Bad "wire: expected a number, found tag {t}").
getString : Dec -> String -> Int -> Got String .
getString d s at = strAt s at d.

# ---- frames and streams -------------------------------------------------------------------
# Adler-32 of a String, as four bytes (little-endian)
adler : String -> Int .
adler s = adlerGo s 0 (strlen s) 1 0.
adlerGo : unsafe String -> Int -> Int -> Int -> Int -> Int .
adlerGo s i n a b = case i >= n of
    True -> b * 65536 + a
  | False -> adlerStep s (i + 1) n ((a + charAt s i) % 65521) b.
adlerStep : unsafe String -> Int -> Int -> Int -> Int -> Int .
adlerStep s i n a b = adlerGo s i n a ((b + a) % 65521).
u32 : Int -> String .
u32 v = strJoin "" (chr (band v 255) :: chr (band (BITSHIFTR v 8) 255) :: chr (band (BITSHIFTR v 16) 255) :: chr (band (BITSHIFTR v 24) 255) :: Nil).
u32At : String -> Int -> Int .
u32At s at = charAt s at + charAt s (at + 1) * 256 + charAt s (at + 2) * 65536 + charAt s (at + 3) * 16777216.

magic : String .
magic = "FPRW".
version : Int .
version = 1.

header : Level -> String .
header level = strJoin "" (magic :: chr version :: chr (levelByte level) :: Nil).
headerSize : Int .
headerSize = 6.

# does this byte string start like a Wire stream?
isStream : String -> Bool .
isStream s = strlen s >= headerSize and substr s 0 4 == magic.

frame : String -> String .
frame payload = strJoin "" (strJoin "" (rev (varint (strlen payload) Nil) Nil) :: payload :: u32 (adler payload) :: Nil).

# a stream's level, its frames' payloads in order (the valid prefix), and how
# many bytes after that prefix could not be read
Stream = Type (Stream Level (List String) Int).
frames : String -> Result Stream String .
frames s = case isStream s of
    False -> Err "wire: not a Wire stream (no FPRW header)"
  | True -> (case charAt s 4 == version of
      False -> Err "wire: unknown version {charAt s 4}"
    | True -> (case levelOf (charAt s 5) of
        Err why -> Err why
      | Ok level -> Ok (framesGo s headerSize level Nil))).
framesGo : unsafe String -> Int -> Level -> List String -> Stream .
framesGo s at level acc = case at >= strlen s of
    True -> Stream level (rev acc Nil) 0
  | False -> (case varAt s at 0 0 of
      Err _ -> Stream level (rev acc Nil) (strlen s - at)
    | Ok (n, p) -> (case p + n + 4 > strlen s of
        True -> Stream level (rev acc Nil) (strlen s - at)
      | False -> frameCheck s at p n level acc)).
frameCheck : unsafe String -> Int -> Int -> Int -> Level -> List String -> Stream .
frameCheck s at p n level acc = case adler (substr s p n) == u32At s (p + n) of
    True -> framesGo s (p + n + 4) level (substr s p n :: acc)
  | False -> Stream level (rev acc Nil) (strlen s - at).

# ---- one value, whole: a header and one frame ---------------------------------------------
pickle : Level -> { enc : a -> Wire | r } -> a -> String .
pickle level codec x = case putWire (encoder level) (codec.enc x) of
  (payload, _) -> strcat (header level) (frame payload).

unpickle : { dec : Wire -> Result a String | r } -> String -> Result a String .
unpickle codec s = case frames s of
    Err why -> Err why
  | Ok (Stream _ fs bad) -> (case fs of
      p :: Nil -> (case bad == 0 of
          False -> Err "wire: {bad} damaged byte(s) after the value"
        | True -> (case getWire (decoder Unit) p 0 of
            Bad why -> Err why
          | Got w _ _ -> codec.dec w))
    | _ -> Err "wire: expected one value, found {listLen fs} (and {bad} damaged byte(s))").

pickleValue : Level -> J.Value -> String .
pickleValue level v = case putValue (encoder level) v of
  (payload, _) -> strcat (header level) (frame payload).

unpickleValue : String -> Result J.Value String .
unpickleValue s = case frames s of
    Err why -> Err why
  | Ok (Stream _ fs bad) -> (case fs of
      p :: Nil -> (case bad == 0 of
          False -> Err "wire: {bad} damaged byte(s) after the value"
        | True -> (case getValue (decoder Unit) p 0 of Bad why -> Err why | Got v _ _ -> Ok v))
    | _ -> Err "wire: expected one value, found {listLen fs}").

# an encoder that continues a stream a decoder has read to its end: the same
# numbers for the same strings, so appends can refer to what is already there
continuing : Level -> Dec -> Enc .
continuing level d = case d of Dec seen next -> Enc level (M.fold (fn m i t -> M.insert t i m) (M.empty S.compare) seen) next.

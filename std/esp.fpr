J = use "job".
# std/esp.fpr -- the ESP32 chip itself, from FP-RISC (the posix system's
# esp-idf host: --host=esp-idf).
#
#   Esp = use "std/esp".
#   Esp.core Unit            which CPU core this actor is running on
#   Esp.ms Unit              milliseconds since boot (wraps after ~12 days)
#   Esp.freeKb Unit          free heap left to ESP-IDF, KiB
#   Esp.random Unit          30 bits from the hardware RNG
#
# What the board has beyond the chip is in the platform libraries, whose
# names say what they are rather than whose they are: std/wifi, std/ble,
# std/gpio (platform/esp-idf), and files through std/file and std/dir.
#
# Ints are 31 bits on this chip (rv32): times are in units that fit.
Esp.core : Unit -> Int .
Esp.ms : Unit -> Int .
Esp.freeKb : Unit -> Int .
Esp.random : Unit -> Int .

core : Unit -> Int .
core u = Esp.core u.
ms : Unit -> Int .
ms u = Esp.ms u.
freeKb : Unit -> Int .
freeKb u = Esp.freeKb u.
random : Unit -> Int .
random u = Esp.random u.

# ---- BLE (formerly std/ble.fpr) ------------------------------------------------
# std/ble.fpr -- Bluetooth LE: scan for devices, advertise a name.
#
#   Ble = use "std/ble".
#   case Ble.scan 5000 of
#       Ok ds -> List.each (fn d -> print "{d.address} {d.rssi} {d.name}") ds
#     | Err why -> print why
#
# Every call blocks only the calling actor (std/job.fpr).  On the ESP32-P4 the
# host is NimBLE and the controller is the board's ESP32-C6
# (platform/esp-idf/bluetooth.c); the first call brings them up, which can
# take seconds.  A platform without a Bluetooth library fails a program
# importing this at LINK time, by name -- and a program that does not import
# it does not carry the Bluetooth stack.

BleHost.scan : Int -> Int -> Int .
BleHost.advertise : Int -> String -> Int -> Int .


# the devices heard in `ms` milliseconds, strongest first; name "" if none was sent
bleScan : Int -> Result (List { address : String, rssi : Int, name : String }) String .
bleScan ms = case J.result (J.run (fn slot -> BleHost.scan slot ms)) of
    Err why -> Err why
  | Ok rs -> J.parseAll (fn r -> case J.number 1 r of Err e -> Err e | Ok rssi -> Ok { address = J.field 0 r, rssi = rssi, name = J.field 2 r }) rs.

# advertise as `name` (1-26 bytes: a legacy advertisement's room) for `ms`
# milliseconds, 0 for until the next call; non-connectable, discoverable.
# Answers once it has begun, with the address it advertises from.
bleAdvertise : String -> Int -> Result { name : String, address : String } String .
bleAdvertise name ms = case J.result (J.run (fn slot -> BleHost.advertise slot name ms)) of
    Err why -> Err why
  | Ok rs -> J.one (fn r -> Ok { name = J.field 0 r, address = J.field 1 r }) rs.

# ---- Wi-Fi (formerly std/wifi.fpr) ---------------------------------------------
# std/wifi.fpr -- Wi-Fi: the radio's state, a scan, an access point.
#
#   Wifi = use "std/wifi".
#   case Wifi.scan Unit of
#       Ok nets -> List.each (fn n -> print "{n.ssid} {n.rssi} dBm ch {n.channel}") nets
#     | Err why -> print why
#
# Every call blocks only the calling actor: the radio work runs on the
# platform's broker (std/job.fpr), and on the ESP32-P4 it is a round trip to
# the board's ESP32-C6 (platform/esp-idf/wifi.c).  A platform without a
# radio library fails a program importing this at LINK time, by name.
#
# startAp's password rule is the protocol's, refused by name, never bent:
# "" is an open network, anything else is 8-63 characters or 64 hex digits;
# an SSID is 1-32 bytes.  It answers once the access point's interface is up.

WifiHost.info : Int -> Int .
WifiHost.scan : Int -> Int .
WifiHost.ap : Int -> String -> String -> Int .
WifiHost.stations : Int -> Int .
WifiHost.stop : Int -> Int .


# the radio's own addresses, and its mode: "off", "station", "ap" or "station+ap"
wifiInfo : Unit -> Result { station : String, ap : String, mode : String } String .
wifiInfo u = case J.result (J.run (fn slot -> WifiHost.info slot)) of
    Err why -> Err why
  | Ok rs -> J.one (fn r -> Ok { station = J.field 0 r, ap = J.field 1 r, mode = J.field 2 r }) rs.

# the networks in range; auth is "open", "wpa2", "wpa2/wpa3", ...
wifiScan : Unit -> Result (List { ssid : String, rssi : Int, channel : Int, auth : String }) String .
wifiScan u = case J.result (J.run (fn slot -> WifiHost.scan slot)) of
    Err why -> Err why
  | Ok rs -> J.parseAll network rs.
network r = case J.number 1 r of
    Err e -> Err e
  | Ok rssi -> (case J.number 2 r of
        Err e -> Err e
      | Ok ch -> Ok { ssid = J.field 0 r, rssi = rssi, channel = ch, auth = J.field 3 r }).

# an access point named ssid; the answer says where it is
wifiStartAp : String -> String -> Result { ssid : String, channel : Int, auth : String, ip : String, bssid : String } String .
wifiStartAp ssid pass = case J.result (J.run (fn slot -> WifiHost.ap slot ssid pass)) of
    Err why -> Err why
  | Ok rs -> J.one accessPoint rs.
accessPoint r = case J.number 1 r of
    Err e -> Err e
  | Ok ch -> Ok { ssid = J.field 0 r, channel = ch, auth = J.field 2 r, ip = J.field 3 r, bssid = J.field 4 r }.

# the stations joined to our access point
wifiStations : Unit -> Result (List { mac : String, rssi : Int }) String .
wifiStations u = case J.result (J.run (fn slot -> WifiHost.stations slot)) of
    Err why -> Err why
  | Ok rs -> J.parseAll (fn r -> case J.number 1 r of Err e -> Err e | Ok rssi -> Ok { mac = J.field 0 r, rssi = rssi }) rs.

# the radio off (the access point with it)
wifiStop : Unit -> Result Unit String .
wifiStop u = case J.result (J.run (fn slot -> WifiHost.stop slot)) of
    Err why -> Err why
  | Ok _ -> Ok Unit.

# std/esp.fpr -- the ESP32 chip itself, from FP-RISC (the posix system's
# esp-idf host: --host=esp-idf).
#
#   Esp = use "std/esp".
#   Esp.core Unit            which CPU core this actor is running on
#   Esp.ms Unit              milliseconds since boot (wraps after ~12 days)
#   Esp.freeKb Unit          free heap left to ESP-IDF, KiB
#   Esp.random Unit          30 bits from the hardware RNG
#
# What the board has beyond the chip is in the platform libraries, whose
# names say what they are rather than whose they are: std/wifi, std/ble,
# std/gpio (platform/esp-idf), and files through std/file and std/dir.
#
# Ints are 31 bits on this chip (rv32): times are in units that fit.
Esp.core : Unit -> Int .
Esp.ms : Unit -> Int .
Esp.freeKb : Unit -> Int .
Esp.random : Unit -> Int .

core : Unit -> Int .
core u = Esp.core u.
ms : Unit -> Int .
ms u = Esp.ms u.
freeKb : Unit -> Int .
freeKb u = Esp.freeKb u.
random : Unit -> Int .
random u = Esp.random u.

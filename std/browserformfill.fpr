# Structured browser form-fill capability. FP-RISC syntax values are authoritative.
# No foreign source asset or Raw node is read at runtime.
JS = use "std/javascript".

n = JS.Name.
t = JS.Text.
f = JS.Field.
call name args = JS.Call (n name) args.
method target name args = JS.Call (f target name) args.
doMethod target name args = JS.Do (method target name args).

src u = JS.program [
  JS.Do (JS.Call (JS.Function Nil (setupNodes Unit)) Nil)
].

applyInputValue u = [
  JS.Do (JS.AssignValue (f (n "el") "value") (JS.Index (n "pending") (n "n"))),
  doMethod (n "el") "dispatchEvent" [JS.New (n "Event") [t "input"]]
].

fillField u = [
  JS.Var "els" (method (n "document") "querySelectorAll" [
    JS.Binary JS.Add (JS.Binary JS.Add (t "[data-input=\"") (n "n")) (t "\"]")
  ]),
  JS.If (JS.Unary JS.Not (f (n "els") "length")) [JS.ReturnVoid] Nil,
  doMethod (n "els") "forEach" [JS.Function ["el"] (applyInputValue Unit)],
  JS.Do (JS.Unary JS.Delete (JS.Index (n "pending") (n "n")))
].

fillPending u = [
  doMethod (method (n "Object") "keys" [n "pending"]) "forEach" [JS.Function ["n"] (fillField Unit)]
].

recordPendingKey u = [
  JS.Do (JS.AssignValue (JS.Index (n "pending") (n "n")) (JS.Index (n "vals") (n "n")))
].

onLiveSet u = [
  JS.Var "vals" (method (n "JSON") "parse" [f (n "e") "detail"]),
  doMethod (method (n "Object") "keys" [n "vals"]) "forEach" [JS.Function ["n"] (recordPendingKey Unit)],
  JS.Do (call "fill" Nil)
].

setupNodes u = [
  JS.Var "pending" (method (n "Object") "create" [JS.Null]),
  JS.Define "fill" Nil (fillPending Unit),
  doMethod (n "document") "addEventListener" [t "live:set", JS.Function ["e"] (onLiveSet Unit)],
  doMethod (JS.New (n "MutationObserver") [n "fill"]) "observe" [
    method (n "document") "getElementById" [t "lv-root"],
    JS.Object [("childList", JS.Boolean True), ("subtree", JS.Boolean True)]
  ]
].

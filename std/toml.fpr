# std/toml.fpr -- TOML parser into std/json's Value.
#
#   Toml = use "std/toml".
#   Toml.parse text            -- Ok (Json.Object ...) or Err "line N: why"
#
# Supported: comments; [table] and [[array.of.tables]] headers; bare, quoted
# and dotted keys; basic and literal strings (one line); decimal and 0x/0o/0b
# integers with underscores; true/false; arrays (over several lines, trailing
# comma); one-line inline tables. Refused by name, never misread: floats,
# dates and times, multi-line strings. A key or table defined twice is an
# error, as TOML requires.

J = use "json".
L = use "list".
M = use "map".
O = use "option".
R = use "result".
S = use "string".

parse : unsafe String -> Result J.Value String .
parse s = doc s 0 Nil (J.Object (M.empty S.compare)) Nil.

lineOf s i = lineGo s 0 i 1.
lineGo : String -> Int -> (rem : Int | measure rem) -> Int -> Int .
lineGo s k rem n =
  if rem <= 0 then n
  else lineGo s (k + 1) (rem - 1) (if charAt s k == 10 then n + 1 else n).

fail s i why = Err "line {lineOf s i}: {why}".
at s i = if i >= strlen s then 0 else charAt s i.

# spaces and tabs
blank s i = blankGo s i (strlen s - i).
blankGo : String -> Int -> (rem : Int | measure rem) -> Int .
blankGo s i rem =
  if rem <= 0 then i
  else if charAt s i == 32 or charAt s i == 9 then blankGo s (i + 1) (rem - 1)
  else i.

toEol s i = toEolGo s i (strlen s - i).
toEolGo : String -> Int -> (rem : Int | measure rem) -> Int .
toEolGo s i rem =
  if rem <= 0 then i
  else if charAt s i == 10 then i
  else toEolGo s (i + 1) (rem - 1).

# blank lines and comment lines
gap : unsafe String -> Int -> Int .
gap s i =
  j = blank s i;
  c = at s j;
  if c == 35 then gap s (toEol s j)
  else if c == 10 or c == 13 then gap s (j + 1)
  else j.

# after a value: blanks, an optional comment, then a newline or the end
lineEnd s i =
  j = blank s i;
  k = if at s j == 35 then toEol s j else j;
  if k >= strlen s then Ok k
  else if charAt s k == 10 then Ok (k + 1)
  else if charAt s k == 13 and at s (k + 1) == 10 then Ok (k + 2)
  else fail s k "expected the end of the line".

# ---- the document ---------------------------------------------------------------
# path: the current table; defined: header paths seen ([a.b] once each)
doc : unsafe String -> Int -> List String -> J.Value -> List String -> Result J.Value String .
doc s i path root defined =
  j = gap s i;
  if j >= strlen s then Ok root
  else if charAt s j == 91 then header s j root defined
  else pair s j path root defined.

header : unsafe String -> Int -> J.Value -> List String -> Result J.Value String .
header s i root defined =
  if at s (i + 1) == 91 then
    keyPath s (blank s (i + 2)) Nil
    |> R.andThen (fn kp ->
        (ks, k) = kp;
        if not (at s k == 93 and at s (k + 1) == 93) then fail s k "expected ']]'"
        else lineEnd s (k + 2) |> R.andThen (fn next ->
          update root ks (appendTable ks)
          |> R.mapError (fn e -> "line {lineOf s i}: {e}")
          |> R.andThen (fn r -> doc s next ks r defined)))
  else
    keyPath s (blank s (i + 1)) Nil
    |> R.andThen (fn kp ->
        (ks, k) = kp;
        if at s k != 93 then fail s k "expected ']'"
        else lineEnd s (k + 1) |> R.andThen (fn next ->
          dotted = S.join "." ks;
          if L.member dotted defined then fail s i "table [{dotted}] is defined twice"
          else update root ks (openTable ks)
            |> R.mapError (fn e -> "line {lineOf s i}: {e}")
            |> R.andThen (fn r -> doc s next ks r (dotted :: defined)))).

# [[a]]: a new table at the end of the array a
appendTable _ O.None = Ok (J.Sequence [J.Object (M.empty S.compare)]).
appendTable _ (O.Some (J.Sequence xs)) = Ok (J.Sequence (L.append xs [J.Object (M.empty S.compare)])).
appendTable ks (O.Some _) = Err "{S.join "." ks} is not an array of tables".

# [a]: the table a, created if missing (it may already exist implicitly)
openTable _ O.None = Ok (J.Object (M.empty S.compare)).
openTable _ (O.Some (J.Object m)) = Ok (J.Object m).
openTable ks (O.Some _) = Err "{S.join "." ks} is not a table".

pair : unsafe String -> Int -> List String -> J.Value -> List String -> Result J.Value String .
pair s i path root defined =
  keyPath s i Nil
  |> R.andThen (fn kp ->
      (ks, k) = kp;
      if at s k != 61 then fail s k "expected '=' after the key"
      else value s (blank s (k + 1)) |> R.andThen (fn va ->
        (v, after) = va;
        lineEnd s after |> R.andThen (fn next ->
          update root (L.append path ks) (fresh ks v)
          |> R.mapError (fn e -> "line {lineOf s i}: {e}")
          |> R.andThen (fn r -> doc s next path r defined)))).

fresh _ v O.None = Ok v.
fresh ks _ (O.Some _) = Err "key {S.join "." ks} is defined twice".

# Update the value at a key path; f sees the old value, if any.  The tables
# on the way are created; the last table of an array of tables is entered.
update : J.Value -> (ks : List String | measure ks) -> (O.Option J.Value -> Result J.Value String) -> Result J.Value String .
update t ks f = case t of
    J.Object m -> (case ks of
        Nil -> Err "empty key"
      | k :: Nil -> f (M.get k m) |> R.map (fn v -> J.Object (M.insert k v m))
      | k :: rest -> (case M.get k m of
          O.None -> update (J.Object (M.empty S.compare)) rest f |> R.map (fn v -> J.Object (M.insert k v m))
        | O.Some (J.Object c) -> update (J.Object c) rest f |> R.map (fn v -> J.Object (M.insert k v m))
        | O.Some (J.Sequence xs) -> (case lastSplit xs of
            O.None -> Err "{k} is an empty array"
          | O.Some (front, J.Object c) ->
              update (J.Object c) rest f
              |> R.map (fn v -> J.Object (M.insert k (J.Sequence (L.append front [v])) m))
          | O.Some _ -> Err "{k} is not a table")
        | O.Some _ -> Err "{k} is not a table"))
  | _ -> Err "not a table".

lastSplit : (xs : List a | measure xs) -> O.Option (List a, a) .
lastSplit xs = case xs of
    Nil -> O.None
  | x :: Nil -> O.Some (Nil, x)
  | x :: r -> lastSplit r |> O.map (fn p -> (front, l) = p; (x :: front, l)).

# ---- keys -------------------------------------------------------------------------
keyPath : unsafe String -> Int -> List String -> Result (List String, Int) String .
keyPath s i acc =
  keyPart s i |> R.andThen (fn kj ->
    (k, j) = kj;
    n = blank s j;
    if at s n == 46 then keyPath s (blank s (n + 1)) (k :: acc)
    else Ok (L.reverse (k :: acc), n)).

keyPart : unsafe String -> Int -> Result (String, Int) String .
keyPart s i = case at s i of
    34 -> basicString s (i + 1) Nil
  | 39 -> literalString s (i + 1)
  | _ ->
      j = bareEnd s i (strlen s - i);
      if j == i then fail s i "expected a key" else Ok (substr s i (j - i), j).

bareEnd : String -> Int -> (rem : Int | measure rem) -> Int .
bareEnd s i rem =
  if rem <= 0 then i
  else if bareChar (charAt s i) then bareEnd s (i + 1) (rem - 1)
  else i.

bareChar c = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or S.isDigit c or c == 95 or c == 45.

# ---- values -----------------------------------------------------------------------
value : unsafe String -> Int -> Result (J.Value, Int) String .
value s i = case at s i of
    34 ->
      if at s (i + 1) == 34 and at s (i + 2) == 34 then fail s i "multi-line strings are not supported in this file"
      else basicString s (i + 1) Nil |> R.map (fn tj -> (t, j) = tj; (J.Text t, j))
  | 39 ->
      if at s (i + 1) == 39 and at s (i + 2) == 39 then fail s i "multi-line strings are not supported in this file"
      else literalString s (i + 1) |> R.map (fn tj -> (t, j) = tj; (J.Text t, j))
  | 91 -> items s (gap s (i + 1)) Nil
  | 123 -> inline s (blank s (i + 1)) (J.Object (M.empty S.compare)) True
  | _ -> scalar s i.

items : unsafe String -> Int -> List J.Value -> Result (J.Value, Int) String .
items s i acc =
  if at s i == 93 then Ok (J.Sequence (L.reverse acc), i + 1)
  else if i >= strlen s then fail s i "unterminated array"
  else value s i |> R.andThen (fn vj ->
    (v, j) = vj;
    k = gap s j;
    case at s k of
        44 -> items s (gap s (k + 1)) (v :: acc)
      | 93 -> Ok (J.Sequence (L.reverse (v :: acc)), k + 1)
      | _ -> fail s k "expected ',' or ']' in the array").

inline : unsafe String -> Int -> J.Value -> Bool -> Result (J.Value, Int) String .
inline s i t first =
  if at s i == 125 then
    if first then Ok (t, i + 1) else fail s i "expected a key after ','"
  else keyPath s i Nil |> R.andThen (fn kp ->
    (ks, k) = kp;
    if at s k != 61 then fail s k "expected '=' after the key"
    else value s (blank s (k + 1)) |> R.andThen (fn vj ->
      (v, j) = vj;
      update t ks (fresh ks v)
      |> R.mapError (fn e -> "line {lineOf s i}: {e}")
      |> R.andThen (fn t2 ->
          n = blank s j;
          case at s n of
              44 -> inline s (blank s (n + 1)) t2 False
            | 125 -> Ok (t2, n + 1)
            | _ -> fail s n "expected ',' or '}' in the inline table"))).

# after the opening quote
basicString : unsafe String -> Int -> List String -> Result (String, Int) String .
basicString s i acc =
  if i >= strlen s then fail s i "unterminated string"
  else case charAt s i of
      34 -> Ok (acc |> L.reverse |> S.concat, i + 1)
    | 10 -> fail s i "unterminated string"
    | 92 -> escape s (i + 1) |> R.andThen (fn tj -> (t, j) = tj; basicString s j (t :: acc))
    | c ->
        if c < 32 and c != 9 then fail s i "control character in a string"
        else
          j = plainEnd s i (strlen s - i);
          basicString s j (substr s i (j - i) :: acc).

plainEnd : String -> Int -> (rem : Int | measure rem) -> Int .
plainEnd s i rem =
  if rem <= 0 then i
  else
    c = charAt s i;
    if c == 34 or c == 92 or (c < 32 and c != 9) then i
    else plainEnd s (i + 1) (rem - 1).

escape s i = case at s i of
    98  -> Ok (chr 8, i + 1)
  | 116 -> Ok (chr 9, i + 1)
  | 110 -> Ok (chr 10, i + 1)
  | 102 -> Ok (chr 12, i + 1)
  | 114 -> Ok (chr 13, i + 1)
  | 101 -> Ok (chr 27, i + 1)
  | 34  -> Ok ("\"", i + 1)
  | 92  -> Ok ("\\", i + 1)
  | 117 -> unicode s (i + 1) 4
  | 85  -> unicode s (i + 1) 8
  | _   -> fail s i "invalid escape in a string".

unicode s i n = case hexValue s i n 0 of
    O.None -> fail s i "invalid \\u escape"
  | O.Some cp ->
      if cp > 1114111 or (cp >= 55296 and cp <= 57343) then fail s i "invalid code point"
      else Ok (J.utf8 cp, i + n).

hexValue : String -> Int -> (n : Int | measure n) -> Int -> O.Option Int .
hexValue s i n acc =
  if n <= 0 then O.Some acc
  else case hexDigit (at s i) of
      O.None -> O.None
    | O.Some d -> hexValue s (i + 1) (n - 1) (acc * 16 + d).

hexDigit c | c >= 48 and c <= 57 = O.Some (c - 48).
hexDigit c | c >= 97 and c <= 102 = O.Some (c - 87).
hexDigit c | c >= 65 and c <= 70 = O.Some (c - 55).
hexDigit _ = O.None.

literalString s i = litGo s i i (strlen s - i).
litGo : String -> Int -> Int -> (rem : Int | measure rem) -> Result (String, Int) String .
litGo s start i rem =
  if rem <= 0 then fail s i "unterminated string"
  else if charAt s i == 39 then Ok (substr s start (i - start), i + 1)
  else if charAt s i == 10 then fail s i "unterminated string"
  else litGo s start (i + 1) (rem - 1).

scalar s i =
  j = tokenEnd s i (strlen s - i);
  t = substr s i (j - i);
  case t of
      "true"  -> Ok (J.Boolean True, j)
    | "false" -> Ok (J.Boolean False, j)
    | ""      -> fail s i "expected a value"
    | _ -> case integer t of
        O.Some n -> Ok (J.Integer n, j)
      | O.None -> fail s i "unsupported value {t}: this file takes strings, integers, booleans, arrays and tables (no floats or dates)".

tokenEnd : String -> Int -> (rem : Int | measure rem) -> Int .
tokenEnd s i rem =
  if rem <= 0 then i
  else if tokenChar (charAt s i) then tokenEnd s (i + 1) (rem - 1)
  else i.
tokenChar c = bareChar c or c == 43 or c == 46 or c == 58.

# TOML integers: [+-]digits with single underscores between digits and no
# leading zero; 0x 0o 0b unsigned forms
integer "" = O.None.
integer t | S.startsWith "0x" t = radix (substr t 2 (strlen t - 2)) 16.
integer t | S.startsWith "0o" t = radix (substr t 2 (strlen t - 2)) 8.
integer t | S.startsWith "0b" t = radix (substr t 2 (strlen t - 2)) 2.
integer t | charAt t 0 == 45 = decimal (substr t 1 (strlen t - 1)) |> O.map (fn n -> 0 - n).
integer t | charAt t 0 == 43 = decimal (substr t 1 (strlen t - 1)).
integer t = decimal t.

decimal "" = O.None.
decimal t | strlen t > 1 and charAt t 0 == 48 = O.None.
decimal t = radix t 10.

radix "" _ = O.None.
radix t _ | charAt t 0 == 95 or charAt t (strlen t - 1) == 95 = O.None.
radix t base = radixGo t 0 (strlen t) base 0 False.

radixGo : String -> Int -> (rem : Int | measure rem) -> Int -> Int -> Bool -> O.Option Int .
radixGo t i rem base acc under =
  if rem <= 0 then O.Some acc
  else if charAt t i == 95 then
    if under then O.None else radixGo t (i + 1) (rem - 1) base acc True
  else case hexDigit (charAt t i) of
      O.None -> O.None
    | O.Some d ->
        if d >= base or acc > 230584300921369395 then O.None
        else radixGo t (i + 1) (rem - 1) base (acc * base + d) False.

# Structured browser pending/connection feedback capability. FP-RISC syntax values
# are authoritative. No foreign source asset or Raw node is read at runtime.
JS = use "std/javascript".
G = use "std/view".

n = JS.Name.
t = JS.Text.
f = JS.Field.
num = JS.Number.
call name args = JS.Call (n name) args.
method target name args = JS.Call (f target name) args.
doMethod target name args = JS.Do (method target name args).

src u = JS.program [
  JS.Do (JS.Call (JS.Function Nil (setupFeedback Unit)) Nil)
].

readThemeVar u = [
  JS.Var "p" (method (n "root") "querySelector" [t "[data-theme]"]),
  JS.Return (JS.Choose (n "p") (method (call "getComputedStyle" [n "p"]) "getPropertyValue" [n "v"]) (t ""))
].

cancelAnimation u = [
  doMethod (n "a") "cancel" Nil
].

clearPendingState u = [
  JS.Do (call "clearTimeout" [n "showT"]),
  JS.Do (JS.AssignValue (n "showT") JS.Null),
  JS.Do (call "clearTimeout" [n "failT"]),
  JS.Do (JS.AssignValue (n "failT") JS.Null),
  JS.If (n "anim") [doMethod (n "anim") "cancel" Nil, JS.Do (JS.AssignValue (n "anim") JS.Null)] Nil,
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "display") (t (G.displayCss G.Hidden))),
  doMethod (n "pulses") "forEach" [JS.Function ["a"] (cancelAnimation Unit)],
  JS.Do (JS.AssignValue (n "pulses") (JS.Array Nil)),
  JS.If (n "faded") [
    JS.Do (JS.AssignValue (f (f (n "faded") "style") "opacity") (t "")),
    JS.Do (JS.AssignValue (n "faded") JS.Null)
  ] Nil
].

showPendingVisuals u = [
  JS.Do (JS.AssignValue (n "showT") JS.Null),
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "background")
    (JS.Binary JS.Or (call "theme" [t "--ink"]) (t (G.colourCss (G.Rgb 136 136 136))))),
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "display") (t (G.displayCss G.Block))),
  JS.Do (JS.AssignValue (n "anim") (method (n "bar") "animate" [
    JS.Array [
      JS.Object [("transform", t (G.transformCss [G.TranslateX (G.Pct (0 - 100))]))],
      JS.Object [("transform", t (G.transformCss [G.TranslateX (G.Pct 340)]))]
    ],
    JS.Object [("duration", num 900), ("iterations", n "Infinity"), ("easing", t "ease-in-out")]
  ])),
  JS.If (JS.Binary JS.And (n "el") (method (n "document") "contains" [n "el"])) [
    doMethod (n "pulses") "push" [method (n "el") "animate" [
      JS.Array [
        JS.Object [("opacity", num 1)],
        JS.Object [("opacity", JS.Real "0.45")],
        JS.Object [("opacity", num 1)]
      ],
      JS.Object [("duration", num 800), ("iterations", n "Infinity")]
    ]]
  ] Nil,
  JS.Do (JS.AssignValue (n "faded") (method (n "root") "querySelector" [t "[data-lv-key=\"items\"]"])),
  JS.If (n "faded") [
    JS.Do (JS.AssignValue (f (f (n "faded") "style") "transition")
      (t (G.declCss (G.TransitionOpacity 150) |> (fn css -> substr css 11 (strlen css - 11))))),
    JS.Do (JS.AssignValue (f (f (n "faded") "style") "opacity") (t ".55"))
  ] Nil
].

startWaiting u = [
  JS.If (n "paused") [JS.ReturnVoid] Nil,
  JS.Do (call "clearTimeout" [n "failT"]),
  JS.Do (JS.AssignValue (n "failT") (call "setTimeout" [n "done", n "ms"])),
  JS.If (JS.Binary JS.Or (n "showT") (n "anim")) [JS.ReturnVoid] Nil,
  JS.Do (JS.AssignValue (n "showT") (call "setTimeout" [JS.Function Nil (showPendingVisuals Unit), num 100]))
].

onPointerDown u = [
  JS.If (n "paused") [JS.ReturnVoid] Nil,
  JS.Var "b" (JS.Binary JS.And (f (f (n "e") "target") "closest")
    (method (f (n "e") "target") "closest" [t "#lv-root button"])),
  JS.If (n "b") [doMethod (n "b") "animate" [
    JS.Array [
      JS.Object [("transform", t (G.transformCss [G.Scale 100]))],
      JS.Object [("transform", t (G.transformCss [G.Scale 94]))],
      JS.Object [("transform", t (G.transformCss [G.Scale 100]))]
    ],
    JS.Object [("duration", num 160), ("easing", t "ease-out")]
  ]] Nil
].

onClickAction u = [
  JS.Var "b" (JS.Binary JS.And (f (f (n "e") "target") "closest")
    (method (f (n "e") "target") "closest" [t "#lv-root [data-click], #lv-root button[data-sync-now]"])),
  JS.If (n "b") [JS.Do (call "waiting" [n "b", num 2500])] Nil
].

onSyncInput u = [
  JS.If (JS.Binary JS.And (f (f (n "e") "target") "hasAttribute")
    (method (f (n "e") "target") "hasAttribute" [t "data-sync-now"]))
    [JS.Do (call "waiting" [JS.Null, num 1200])] Nil
].

onEnterKey u = [
  JS.If (JS.Binary JS.And
    (JS.Binary JS.And (JS.Binary JS.Equal (f (n "e") "key") (t "Enter")) (f (f (n "e") "target") "hasAttribute"))
    (method (f (n "e") "target") "hasAttribute" [t "data-enter"]))
    [JS.Do (call "waiting" [JS.Null, num 2500])] Nil
].

syncLinkBadge u = [
  JS.Var "up" (JS.Binary JS.Equal (f (n "link") "textContent") (t "live")),
  JS.Do (JS.AssignValue (f (f (n "link") "style") "display")
    (JS.Choose (n "up") (t (G.displayCss G.Hidden)) (t (G.displayCss G.Block)))),
  JS.If (JS.Unary JS.Not (n "up")) [
    JS.Do (JS.Binary JS.And
      (JS.Binary JS.Less (method (f (n "link") "textContent") "indexOf" [t "reconnecting"]) (num 0))
      (JS.AssignValue (f (n "link") "textContent") (t "reconnecting")))
  ] Nil
].

setupFeedback u = [
  JS.Var "root" (method (n "document") "getElementById" [t "lv-root"]),
  JS.Var "paused" (JS.Boolean False),
  JS.Define "theme" ["v"] (readThemeVar Unit),
  JS.Var "bar" (method (method (n "root") "querySelector" [t "[data-pending-bar]"]) "cloneNode" [JS.Boolean True]),
  JS.Var "anim" JS.Null,
  JS.Var "showT" JS.Null,
  JS.Var "failT" JS.Null,
  JS.Var "pulses" (JS.Array Nil),
  JS.Var "faded" JS.Null,
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "display") (t (G.displayCss G.Hidden))),
  doMethod (f (n "document") "body") "appendChild" [n "bar"],
  JS.Define "done" Nil (clearPendingState Unit),
  JS.Define "waiting" ["el", "ms"] (startWaiting Unit),
  doMethod (n "document") "addEventListener" [t "live:frame", n "done"],
  doMethod (n "document") "addEventListener" [t "pointerdown", JS.Function ["e"] (onPointerDown Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "click", JS.Function ["e"] (onClickAction Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "input", JS.Function ["e"] (onSyncInput Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "keydown", JS.Function ["e"] (onEnterKey Unit), JS.Boolean True],
  JS.Var "link" (method (method (n "root") "querySelector" [t "[data-pending-link]"]) "cloneNode" [JS.Boolean True]),
  JS.Do (JS.AssignValue (f (n "link") "id") (t "lv-link")),
  JS.Do (JS.AssignValue (f (f (n "link") "style") "display") (t (G.displayCss G.Hidden))),
  doMethod (f (n "document") "body") "appendChild" [n "link"],
  JS.Var "observer" (JS.New (n "MutationObserver") [JS.Function Nil (syncLinkBadge Unit)]),
  JS.Define "observe" Nil [doMethod (n "observer") "observe" [n "link", JS.Object [("childList", JS.Boolean True), ("characterData", JS.Boolean True), ("subtree", JS.Boolean True)]]],
  JS.Do (call "observe" Nil),
  doMethod (n "window") "addEventListener" [t "pagehide", JS.Function Nil [JS.Assign (n "paused") (JS.Boolean True), JS.Do (call "done" Nil), doMethod (n "observer") "disconnect" Nil]],
  doMethod (n "window") "addEventListener" [t "pageshow", JS.Function Nil [JS.Assign (n "paused") (JS.Boolean False), JS.Do (call "observe" Nil), JS.Do (JS.Call (JS.Function Nil (syncLinkBadge Unit)) Nil)]]
].

# the page's day or night, which the feedback it draws follows
theme : Bool -> G.Attr .
theme light = G.Att "data-theme" (if light then "day" else "night").
prototypes palette = G.El "div" [G.utilities [G.Display G.Hidden]]
  [G.El "div" (G.Att "data-pending-bar" "" :: G.utilities [G.Position G.Fixed, G.Top (G.Px 0), G.Left (G.Px 0), G.Height (G.Px 3), G.Width (G.Pct 30), G.ZIndex 60, G.PointerEvents G.PointerNone, G.Radius (G.Px 3), G.Opacity 60, G.Background (G.ThemeColour G.Ink)] :: palette) Nil,
   G.El "span" [G.Att "data-pending-link" "", G.utilities [G.Position G.Fixed, G.Top (G.Px 10), G.Left (G.Pct 50), G.Transform [G.TranslateX (G.Pct (0 - 50))], G.ZIndex 61, G.PaddingY (G.Px 4), G.PaddingX (G.Px 12), G.Radius (G.Px 999), G.FontSize (G.Px 12), G.Background (G.Rgb 58 42 16), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.Rgb 122 90 24), G.Foreground (G.Rgb 255 198 92)]] Nil].

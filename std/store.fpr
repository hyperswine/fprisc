# std/store.fpr -- Store: a keyed collection kept by SHARD actors, each one
# caching its part in memory and compacting its own log (ExtBase, posix).
#
#   Rows = {rows : List Entry}.                      -- a codec for the element type
#   store = Store.open { dir = "log.store", span = 512, key = (fn e -> e.id), codec = @Rows.rows }
#
#   Store.put entry store        Store.remove id store        Store.get id store
#   Store.page skip take store              -- greatest key first: (rows, total)
#   Store.search pred skip take store       -- the same over the matches: (rows, matches)
#   Store.count store
#
# SHARDS.  Key k lives in shard k / span: an actor of its own that holds its
# part of the collection in memory (a Map) and appends every change to its own
# file, dir/shard-<n>.log -- one JSON line per put or removal.  Its heap, its
# tidy and its compaction are its own: when its file holds more than twice as
# many lines as it has live entries, it rewrites THAT file (written beside
# it, renamed over it).  Compaction is incremental by construction -- one
# small shard at a time, never the rest -- and opening starts every shard at
# once, so the files load in parallel.
#
# THE FRONT.  One actor routes; it never waits on a shard.  A WRITE asks it
# which shard holds the key (it starts the shard if none does), goes to that
# shard directly, and reports the shard's new count back with the shard's write
# version -- the highest version wins, so reports arriving out of order cannot
# roll a count back, and because the writer waits for that report a read that
# follows its write sees it.  A shard takes every write already waiting and
# appends a run of them as ONE write (group commit), so writes to different
# shards run at once and writes to one shard share their appends.  A READ is
# answered with a PLAN (which shards, and what slice of each) and the reader
# asks those shards itself; a search asks every shard at once and they scan in
# parallel, on as many harts as there are.  So fifty tabs loading their pages
# are fifty actors asking shards, not a queue.
#
# THE CODEC is any path literal whose field is a `List a` (the compiler mints
# enc/dec for it from the declaration): an element is written as a list of one.
# Keys are Ints: an id, a timestamp -- whatever orders the collection newest
# last, because pages come greatest key first.

A = use "actor".
M = use "map".
O = use "option".
J = use "json".
F = use "file".
L = use "list".
OS = use "os".
S = use "string".
Ord = use "order".
W = use "wire".
LF = use "logfile".

# how a shard's file is written: JSON lines, or Wire frames at a level of the dial
# (std/wire); `open` keeps what each file is and starts new ones as JSON lines,
# `openWith fmt` starts new shards in `fmt` and compacts every shard into it
Format = Type (Lines | Fast | Compact | Small).
levelOf fmt = case fmt of Small -> W.Small | Compact -> W.Compact | _ -> W.Fast.
formatOf level = case level of W.Small -> Small | W.Compact -> Compact | W.Fast -> Fast.

# the front's handle, and the key function (which also fixes the element type)
Store a = Type (Store Int (a -> Int)).

Freq = Type (FRouteW k | FRouteRm k | FCounted idx n ver | FPlan skip take | FShards | FCount | FRoute k).
Fans = Type (FDone n | FPlanIs n parts | FShardsAre shards | FRouteIs shard | FRoutedTo shard idx).
Sreq = Type (SPut x | SRemove k | SPage skip take | SFilter pred | SGet k | SCount).
Sans = Type (SCountIs n | SRows rows | SOne found | SWrote n ver).

# the front's state: the config, shard actors and their entry counts by index,
# the write version each count was reported at, and the format new shards take
Fs = Type (Fs cfg shards counts vers want).
# a shard's state: its entries, its file's record count, the format the file is
# in and the one compaction writes, the encoder continuing it, the file it
# appends to, and its write version (one more for every put or removal) -- everything that must survive a tidy is IN the tidied value (the
# path is built inside the actor, so outside the state it would dangle after
# the reset)
Sh = Type (Sh entries lines fmt want enc sink ver).

# ---- opening ------------------------------------------------------------------------
open cfg = openGo O.None cfg.
openWith fmt cfg = openGo (O.Some fmt) cfg.
openGo want cfg =
  _ = OS.mkdir cfg.dir;
  case OS.listDir cfg.dir of
    Err why -> Err "store: cannot read {cfg.dir}: {why}"
  | Ok names ->
      idxs = L.filterMap (fn n -> if S.startsWith "shard-" n and S.endsWith ".log" n
                                  then (case S.toInt (S.dropRight 4 (S.dropLeft 6 n)) of Ok i -> O.Some i | Err _ -> O.None) else O.None) names;
      front = A.spawnWith (A.Dynamic 256) (fn self -> frontStart self cfg want idxs);
      Ok (Store front cfg.key).

shardPath dir idx = "{dir}/shard-{idx}.log".

# every existing shard starts at once (they load in parallel), then the front
# learns their counts and starts serving
frontStart : unsafe Int -> { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> O.Option Format -> List Int -> Unit .
frontStart self cfg want idxs =
  shards = L.fold (fn m idx -> M.insert idx (spawnShard cfg want idx) m) (M.empty Ord.int) idxs;
  counts = L.fold (fn m idx -> (case M.get idx shards of
      O.Some sh -> M.insert idx (countOf self sh) m
    | O.None -> m)) (M.empty Ord.int) idxs;
  front self (Fs cfg shards counts (M.empty Ord.int) want) A.tidy0.

spawnShard cfg want idx = A.spawnWith (A.Dynamic 64) (fn self -> shardStart self cfg want idx).

# a request to the front or a shard, answered within 10 s: one that does not
# answer in time is a named failure of the caller, not a caller held for ever
ask : unsafe Int -> Int -> q -> r .
ask me a q = case A.askSureWithin 10000 me a q of
    Ok r -> r
  | Err why -> error "store: no answer: {why}".
countOf me sh =
  r = ask me sh SCount;
  n = (case r of SCountIs c -> c | _ -> 0);
  _ = drop r;
  n.

# ---- the front ---------------------------------------------------------------------------
front : unsafe Int -> Fs -> A.Tidy -> Unit .
front self st0 t0 = case A.tidy self (st0, t0) of (st, t) ->
  m = receive self;
  (from, q) = m;
  next = serveFront self from q st;
  _ = drop m;
  front self next t.

# The front ROUTES; it never waits on a shard.  A writer asks it which shard
# holds a key (starting the shard if none does), writes to that shard itself,
# and reports the shard's new count back, with the shard's write version: the
# highest version wins, so reports that arrive out of order cannot roll a count
# back.  The writer waits for that report's answer, so its own next read plans
# with its write included.
serveFront self from q st = case st of Fs cfg shards counts vers want -> (case q of
    FRouteW k ->
      idx = k / cfg.span;
      (case M.get idx shards of
          O.Some sh -> _ = A.sendSure self from (FRoutedTo sh idx); st
        | O.None -> sh = spawnShard cfg want idx;
                    _ = A.sendSure self from (FRoutedTo sh idx);
                    Fs cfg (M.insert idx sh shards) (M.insert idx 0 counts) vers want)
  | FRouteRm k ->
      idx = k / cfg.span;
      _ = A.sendSure self from (FRoutedTo (O.withDefault 0 (M.get idx shards)) idx);
      st
  | FCounted idx n ver ->
      (if ver > M.getOr 0 idx vers then
         counts2 = M.insert idx n counts;
         _ = A.sendSure self from (FDone (total counts2));
         Fs cfg shards counts2 (M.insert idx ver vers) want
       else _ = A.sendSure self from (FDone (total counts)); st)
  | FPlan skip take ->
      _ = A.sendSure self from (FPlanIs (total counts) (plan shards (L.reverse (M.entries counts)) skip take Nil));
      st
  | FShards ->
      _ = A.sendSure self from (FShardsAre (L.reverse (M.values shards)));
      st
  | FCount -> _ = A.sendSure self from (FDone (total counts)); st
  | FRoute k -> _ = A.sendSure self from (FRouteIs (O.withDefault 0 (M.get (k / cfg.span) shards))); st).

total counts = M.fold (fn acc k n -> acc + n) 0 counts.

# which shards hold [skip, skip + take) of the collection, greatest key first:
# shards are walked from the highest index down, each counting its entries
plan : unsafe M.Map Int Int -> List (Int, Int) -> Int -> Int -> List (Int, Int, Int) -> List (Int, Int, Int) .
plan shards counts skip take acc = if take <= 0 then L.reverse acc
  else (case counts of
      Nil -> L.reverse acc
    | (idx, n) :: rest ->
        (if skip >= n then plan shards rest (skip - n) take acc
         else
           here = (if n - skip < take then n - skip else take);
           (case M.get idx shards of
               O.Some sh -> plan shards rest 0 (take - here) ((sh, skip, here) :: acc)
             | O.None -> plan shards rest 0 take acc))).

# ---- a shard -----------------------------------------------------------------------------
shardStart : unsafe Int -> { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> O.Option Format -> Int -> Unit .
shardStart self cfg want idx =
  path = shardPath cfg.dir idx;
  (entries, lines, fmt0, d, size) = load cfg path;
  fmt = (if size == 0 then O.withDefault Lines want else fmt0);
  _ = LF.truncate path size;
  shard self cfg (Sh entries lines fmt (O.withDefault fmt want) (W.continuing (levelOf fmt) d) (LF.sink path size) 0) A.tidy0.

# a shard's loop: take what is waiting (up to `batch`), write each run of puts
# and removals as ONE append, then answer -- group commit, as std/kvlog does.
# A read first sees the writes queued before it.
batch = 1024.

shard : unsafe Int -> { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> Sh -> A.Tidy -> Unit .
shard self cfg st0 t0 = case A.tidy self (st0, t0) of (st, t) ->
  first = receive self;
  items = drain self (batch - 1) (item first :: Nil);
  shard self cfg (runBatch self cfg st items Nil) t.

# a request, copied out of its message (which is then let go)
item msg =
  (from, q) = msg;
  out = (from, keep q);
  _ = drop msg;
  out.
drain : unsafe Int -> Int -> List (Int, Sreq) -> List (Int, Sreq) .
drain self more acc = case more <= 0 of
    True -> L.reverse acc
  | False -> (case receiveNow self of
      Ok m -> drain self (more - 1) (item m :: acc)
    | Err _ -> L.reverse acc).

runBatch : unsafe Int -> { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> Sh -> List (Int, Sreq) -> List (Int, Sreq) -> Sh .
runBatch self cfg st items pending = case items of
    Nil -> flush self cfg st pending
  | (from, q) :: r -> (case q of
      SPut _ -> runBatch self cfg st r ((from, q) :: pending)
    | SRemove _ -> runBatch self cfg st r ((from, q) :: pending)
    | _ -> readThen self cfg (flush self cfg st pending) from q r).
readThen self cfg st from q r = case serveShard cfg q st of
  (st2, ans) -> _ = A.sendSure self from ans; runBatch self cfg st2 r Nil.

# the writes of one run: applied in order, appended in one write, each writer
# answered with the count and the version after ITS write; then, if superseded
# records now outnumber the live ones, the file is compacted
flush self cfg st pending = case pending of
    Nil -> st
  | _ -> (case applyAll cfg st (L.reverse pending) Nil Nil of
      (st2, recs, answers) -> written self cfg (append cfg st2 recs) answers).
written self cfg st answers =
  _ = L.each (fn a -> (case a of (from, n, ver) -> A.sendSure self from (SWrote n ver))) answers;
  compactIf cfg st.

# each write against the entries; the records to append, in order, and the answers
applyAll : unsafe { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> Sh -> List (Int, Sreq) -> List (Int, O.Option a) -> List (Int, Int, Int) -> (Sh, List (Int, O.Option a), List (Int, Int, Int)) .
applyAll cfg st items recs answers = case items of
    Nil -> (st, L.reverse recs, L.reverse answers)
  | (from, q) :: r -> (case st of Sh entries lines fmt want enc sink ver -> (case q of
      SPut x -> applyAll cfg (Sh (M.insert (cfg.key x) x entries) (lines + 1) fmt want enc sink (ver + 1)) r ((cfg.key x, O.Some x) :: recs) ((from, M.size (M.insert (cfg.key x) x entries), ver + 1) :: answers)
    | SRemove k -> (if M.member k entries
        then applyAll cfg (Sh (M.remove k entries) (lines + 1) fmt want enc sink (ver + 1)) r ((k, O.None) :: recs) ((from, M.size entries - 1, ver + 1) :: answers)
        else applyAll cfg st r recs ((from, M.size entries, ver) :: answers))
    | _ -> applyAll cfg st r recs answers)).

serveShard cfg q st = case st of Sh entries lines fmt want enc sink ver -> (case q of
    SPage skip take -> (st, SRows (L.take take (L.drop skip (newestFirst entries))))
  | SFilter pred -> (st, SRows (M.fold (fn acc k v -> if pred v then v :: acc else acc) Nil entries))
  | SGet k -> (st, SOne (M.get k entries))
  | SCount -> (st, SCountIs (M.size entries))
  | _ -> (st, SCountIs (M.size entries))).

# the entries greatest key first (an ascending fold, consing, reverses the order)
newestFirst entries = M.fold (fn acc k v -> v :: acc) Nil entries.

# an element on the wire and in the file: a list of one, through the list codec
one cfg x = case cfg.codec.enc (x :: Nil) of WList (w :: Nil) -> J.fromWire w | w -> J.fromWire w.
unone cfg v = case cfg.codec.dec (WList (J.toWire v :: Nil)) of
    Ok (x :: Nil) -> O.Some x
  | _ -> O.None.

# append a run of records -- puts (Some x) and removals (None) -- to the shard's
# file, kept open (std/logfile), in ONE write; a write that cannot happen stops
# the program, as the per-put append did
append cfg st recs = case recs of
    Nil -> st
  | _ -> (case st of Sh entries lines fmt want enc sink ver -> appendReady cfg st recs (LF.ready sink)).
appendReady cfg st recs r = case st of Sh entries lines fmt want enc sink ver -> (case r of
    LF.Same s -> appendTo cfg (Sh entries lines fmt want enc s ver) recs
  | LF.Failed s why -> error "store: cannot append to {LF.path s}: {why}"
  | LF.Fresh s -> (case fmt of
      Lines -> appendTo cfg (Sh entries lines fmt want enc s ver) recs
    | _ -> (case LF.write s (W.header (levelOf fmt)) of
        Err why -> error "store: cannot append to {LF.path s}: {why}"
      | Ok s2 -> appendTo cfg (Sh entries lines fmt want (W.encoder (levelOf fmt)) s2 ver) recs))
  | LF.Other s -> (case fmt of
      Lines -> appendTo cfg (Sh entries lines fmt want enc s ver) recs
    | _ -> error "store: {LF.path s} was replaced by a file this store did not write")).
appendTo cfg st recs = case st of Sh entries lines fmt want enc sink ver -> (case encodeAll cfg fmt enc recs Nil of
  (bytes, enc2) -> (case LF.write sink bytes of
      Err why -> error "store: cannot append to {LF.path sink}: {why}"
    | Ok s2 -> Sh entries lines fmt want enc2 s2 ver)).
encodeAll : unsafe { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> Format -> W.Enc -> List (Int, O.Option a) -> List String -> (String, W.Enc) .
encodeAll cfg fmt enc recs acc = case recs of
    Nil -> (strJoin "" (L.reverse acc), enc)
  | (k, mx) :: r -> (case encodeRec cfg fmt enc k mx of (b, enc2) -> encodeAll cfg fmt enc2 r (b :: acc)).

# a record in a format: JSON lines {"k": key, "v": element} or {"k": key, "d": true};
# a frame holds the key and, for a put, the element's Wire
encodeRec cfg fmt enc k mx = case fmt of
    Lines -> (case mx of
        O.Some x -> (strcat (J.render (J.object (("k", J.Integer k) :: ("v", one cfg x) :: Nil))) "\n", enc)
      | O.None -> (strcat (J.render (J.object (("k", J.Integer k) :: ("d", J.Boolean True) :: Nil))) "\n", enc))
  | _ -> (case mx of
        O.Some x -> (case W.putWire enc (wireOf cfg x) of (vb, enc2) -> (W.frame (strcat (W.putInt k) vb), enc2))
      | O.None -> (W.frame (W.putInt k), enc)).
wireOf cfg x = case cfg.codec.enc (x :: Nil) of WList (w :: Nil) -> w | w -> w.
unwire cfg w = case cfg.codec.dec (WList (w :: Nil)) of
    Ok (x :: Nil) -> O.Some x
  | _ -> O.None.

# THIS shard's file only: rewritten with its live entries, in the format
# compaction writes, when superseded records outnumber them -- so no compaction
# ever waits on the rest of the store
compactIf cfg st = case st of Sh entries lines fmt want enc sink ver ->
  (if lines <= 2 * M.size entries + 32 then st
   else (case serialise cfg want entries of
     (bytes, enc2) -> (case LF.replace (LF.path sink) bytes of
         Err why -> st
       | Ok _ -> Sh entries (M.size entries) want want enc2 (LF.replaced sink (strlen bytes)) ver))).
serialise cfg fmt entries = case fmt of
    Lines -> (strJoin "" (L.map (fn kv -> (case kv of (k, v) -> (case encodeRec cfg Lines (W.encoder W.Fast) k (O.Some v) of (b, _) -> b))) (M.entries entries)), W.encoder W.Fast)
  | _ -> serialiseFrames cfg fmt (W.encoder (levelOf fmt)) (M.entries entries) (W.header (levelOf fmt) :: Nil).
serialiseFrames : unsafe { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> Format -> W.Enc -> List (Int, a) -> List String -> (String, W.Enc) .
serialiseFrames cfg fmt enc kvs acc = case kvs of
    Nil -> (strJoin "" (L.reverse acc), enc)
  | (k, v) :: r -> (case encodeRec cfg fmt enc k (O.Some v) of (b, enc2) -> serialiseFrames cfg fmt enc2 r (b :: acc)).

# a shard's file, replayed: the last record of each key wins.  Answers its
# entries, its record count, its format, the decoder at its end, and the length
# that could be read (a torn tail after it is cut off before anything is appended)
load cfg path = case F.readBytes path of
    Err _ -> (M.empty Ord.int, 0, Lines, W.decoder Unit, 0)
  | Ok bytes -> (if W.isStream bytes then loadFrames cfg bytes else loadLines cfg bytes).
loadLines cfg bytes = case S.lines bytes of
  ls -> (L.fold (fn m l -> loadLine cfg m l) (M.empty Ord.int) ls, L.length ls, Lines, W.decoder Unit, LF.wholeLines bytes).
loadLine cfg m l = case J.parse l of
    Err _ -> m
  | Ok v -> (case O.andThen J.asInt (J.field "k" v) of
      O.None -> m
    | O.Some k -> (if O.isSome (J.field "d" v) then M.remove k m
                   else (case O.andThen (unone cfg) (J.field "v" v) of
                       O.Some x -> M.insert k x m
                     | O.None -> m))).
loadFrames cfg bytes = case W.frames bytes of
    Err _ -> (M.empty Ord.int, 0, Lines, W.decoder Unit, 0)
  | Ok (W.Stream level fs bad) -> (case framesGo cfg fs (W.decoder Unit) (M.empty Ord.int) of
      (m, d) -> (m, L.length fs, formatOf level, d, strlen bytes - bad)).
framesGo : unsafe { dir : String, span : Int, key : a -> Int, codec : { enc : List a -> Wire, dec : Wire -> Result (List a) String | r } | q } -> List String -> W.Dec -> M.Map Int a -> (M.Map Int a, W.Dec) .
framesGo cfg fs d m = case fs of
    Nil -> (m, d)
  | p :: r -> (case W.getInt p 0 of
      W.Bad _ -> (m, d)
    | W.Got k at _ -> (if at >= strlen p then framesGo cfg r d (M.remove k m)
        else (case W.getWire d p at of
          W.Bad _ -> (m, d)
        | W.Got w _ d2 -> framesGo cfg r d2 (case unwire cfg w of O.Some x -> M.insert k x m | O.None -> m)))).

# ---- the API: writes through the front, reads from the shards --------------------------------
# a write goes to its shard directly: the front only says which shard (and
# starts it), and hears the shard's new count afterwards -- so writes to
# different shards run at once, and a shard writes a run of them as one append
put : a -> Store a -> Int .
put x store = case store of Store front key ->
  me = myself 0;
  r = ask me front (FRouteW (key x));
  (sh, idx) = (case r of FRoutedTo s i -> (s, i) | _ -> (0, 0));
  _ = drop r;
  wrote me front idx (SPut x) sh.

remove : Int -> Store a -> Int .
remove k store = case store of Store front _ ->
  me = myself 0;
  r = ask me front (FRouteRm k);
  (sh, idx) = (case r of FRoutedTo s i -> (s, i) | _ -> (0, 0));
  _ = drop r;
  (if sh == 0 then count store else wrote me front idx (SRemove k) sh).

# ask the shard, then report its count to the front; answers the store's total
wrote me front idx q sh =
  r = ask me sh q;
  (n, ver) = (case r of SWrote c v -> (c, v) | _ -> (0, 0));
  _ = drop r;
  report me front idx n ver.
report me front idx n ver =
  r = ask me front (FCounted idx n ver);
  total = (case r of FDone c -> c | _ -> 0);
  _ = drop r;
  total.

count : Store a -> Int .
count store = case store of Store front _ ->
  r = ask (myself 0) front FCount;
  n = (case r of FDone c -> c | _ -> 0);
  _ = drop r;
  n.

get : Int -> Store a -> O.Option a .
get k store = case store of Store front _ ->
  me = myself 0;
  r = ask me front (FRoute k);
  sh = (case r of FRouteIs s -> s | _ -> 0);
  _ = drop r;
  (if sh == 0 then O.None
   else r2 = ask me sh (SGet k);
        found = (case r2 of SOne o -> keep o | _ -> O.None);
        _ = drop r2;
        found).

# a page, greatest key first: the front says which shards, the reader asks them
page : Int -> Int -> Store a -> (List a, Int) .
page skip take store = case store of Store front _ ->
  me = myself 0;
  r = ask me front (FPlan skip take);
  (n, parts) = (case r of FPlanIs c ps -> (c, keep ps) | _ -> (0, Nil));
  _ = drop r;
  (L.concatMap (fn part -> (case part of (sh, s, t) -> rowsFrom me sh (SPage s t))) parts, n).

rowsFrom me sh q =
  r = ask me sh q;
  rows = (case r of SRows xs -> keep xs | _ -> Nil);
  _ = drop r;
  rows.

# the matches, greatest key first, and how many there are: every shard scans
# its own part at the same time, and the answers are taken in shard order
search : (a -> Bool) -> Int -> Int -> Store a -> (List a, Int) .
search pred skip take store = case store of Store front _ ->
  me = myself 0;
  r = ask me front FShards;
  shards = (case r of FShardsAre xs -> keep xs | _ -> Nil);
  _ = drop r;
  _ = L.each (fn sh -> A.sendSure me sh (me, SFilter pred)) shards;
  deadline = (case A.deadlineAfter 10000 of Ok d -> d | Err why -> error "store: {why}");
  found = L.concatMap (fn sh -> (case A.awaitFromUntil deadline me sh of
      Ok m -> (case m of SRows ys -> ys | _ -> Nil)
    | Err why -> error "store: a shard did not answer: {why}")) shards;
  (L.take take (L.drop skip found), L.length found).

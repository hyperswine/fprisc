# std/string.fpr -- String: text as bytes (docs/2026-09-19-PRELIM_BASE_LIBRARY_DESIGN.md).
#
#   String = use "std/string".
#   line |> String.trim |> String.split "," |> List.map String.toUpper |> String.join "; "
#
# The contract, the same one the primitives and Sol's `Str` keep:
#   * a String is BYTES.  Positions and lengths count bytes; UTF-8 passes
#     through untouched (split, join, replace and search are all UTF-8 safe
#     because a valid sequence never contains another's prefix), and only the
#     case functions are ASCII-only, by name.
#   * positions are 0-BASED, as `charAt` and `substr` are, and a slice is
#     half-open: `slice from to` is the bytes [from, to).
#   * absence is an Option (`indexOf`), failure a Result (`toInt`): nothing
#     here panics, and out-of-range slices clamp.
# The subject string comes LAST, so calls chain with `|>`.

O = use "option".
Ord = use "order".

length : String -> Int
  | work length <= 4 | alloc length <= 0 .
length s = strlen s.

isEmpty : String -> Bool
  | work isEmpty <= 5 | alloc isEmpty <= 16 .
isEmpty s = strlen s == 0.

rev : (xs : List a | measure xs) -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# ---- joining and splitting -------------------------------------------------------
# one allocation, however many pieces (the strJoin primitive)
join : String -> List String -> String .
join sep xs = strJoin sep xs.

concat : List String -> String .
concat xs = strJoin "" xs.

append : String -> String -> String .
append a b = strcat a b.

# String.split "," "a,b,,c" = ["a", "b", "", "c"]; an empty separator is refused
# the only sensible way: the whole string, unsplit.
split : String -> String -> List String .
split sep s | strlen sep == 0 = s :: Nil.
split sep s = splitGo (strlen s + 1) sep s 0 Nil.
splitGo : (fuel : Int | measure fuel) -> String -> String -> Int -> List String -> List String .
splitGo fuel sep s from acc | fuel <= 0 = rev acc Nil.
splitGo fuel sep s from acc =
  at = strIndexFrom sep s from;
  if at < 0 then rev (substr s from (strlen s - from) :: acc) Nil
  else splitGo (fuel - 1) sep s (at + strlen sep) (substr s from (at - from) :: acc).

# on "\n"; a trailing newline does not make an empty last line, and "\r\n" ends a line too
lines : String -> List String .
lines s = linesTidy (split "\n" s) Nil.
linesTidy : (ls : List String | measure ls) -> List String -> List String .
linesTidy ls acc = case ls of
    Nil -> rev acc Nil
  | l :: Nil -> if strlen l == 0 then rev acc Nil else rev (dropCr l :: acc) Nil
  | l :: r -> linesTidy r (dropCr l :: acc).
dropCr : String -> String .
dropCr l | endsWith "\r" l = substr l 0 (strlen l - 1).
dropCr l = l.

# maximal runs of non-whitespace
words : String -> List String .
words s = wordsGo s 0 (strlen s) Nil.
wordsGo : String -> (pos : Int | measure (n - pos)) -> (n : Int) -> List String -> List String .
wordsGo s pos n acc | pos >= n = rev acc Nil.
wordsGo s pos n acc =
  if isSpace (charAt s pos) then wordsGo s (pos + 1) n acc
  else wordEnd s pos (pos + 1) n acc.
wordEnd : String -> Int -> (pos : Int | measure (n - pos)) -> (n : Int) -> List String -> List String .
wordEnd s start pos n acc | pos >= n = rev (substr s start (pos - start) :: acc) Nil.
wordEnd s start pos n acc =
  if isSpace (charAt s pos) then wordsGo s (pos + 1) n (substr s start (pos - start) :: acc)
  else wordEnd s start (pos + 1) n acc.

# ---- searching ---------------------------------------------------------------------
# where `p` first occurs, from 0; `indexFrom i` looks at or after position i
indexOf : String -> String -> O.Option Int .
indexOf p s = found (strIndexOf p s).
indexFrom : Int -> String -> String -> O.Option Int .
indexFrom i p s = found (strIndexFrom p s i).
found : Int -> O.Option Int .
found at | at < 0 = O.None.
found at = O.Some at.

contains : String -> String -> Bool .
contains p s = strIndexOf p s >= 0.

startsWith : String -> String -> Bool .
startsWith p s = strlen p <= strlen s and substr s 0 (strlen p) == p.

endsWith : String -> String -> Bool .
endsWith p s = strlen p <= strlen s and substr s (strlen s - strlen p) (strlen p) == p.

# how many times, not overlapping
count : String -> String -> Int .
count p s | strlen p == 0 = 0.
count p s = countGo (strlen s + 1) p s 0 0.
countGo : (fuel : Int | measure fuel) -> String -> String -> Int -> Int -> Int .
countGo fuel p s from n | fuel <= 0 = n.
countGo fuel p s from n =
  at = strIndexFrom p s from;
  if at < 0 then n else countGo (fuel - 1) p s (at + strlen p) (n + 1).

# ---- slicing (positions from 0, clamped) ---------------------------------------------
# the bytes [from, to): `from` included, `to` not; String.slice 0 (String.length s) s = s
slice : Int -> Int -> String -> String .
slice from to s = sliceAt (if from < 0 then 0 else from) to s.
sliceAt : Int -> Int -> String -> String .
sliceAt from to s | to <= from = "".
sliceAt from to s = substr s from (to - from).

left : Int -> String -> String .
left n s = substr s 0 n.

right : Int -> String -> String .
right n s | n >= strlen s = s.
right n s = substr s (strlen s - n) n.

dropLeft : Int -> String -> String .
dropLeft n s | n <= 0 = s.
dropLeft n s = substr s n (strlen s - n).

dropRight : Int -> String -> String .
dropRight n s | n <= 0 = s.
dropRight n s = substr s 0 (strlen s - n).

# ---- trimming ------------------------------------------------------------------------
isSpace : Int -> Bool
  | work isSpace <= 8 | alloc isSpace <= 16 .
isSpace c = c == 32 or (c >= 9 and c <= 13).

trim : String -> String .
trim s = s |> trimLeft |> trimRight.

trimLeft : String -> String .
trimLeft s = dropLeft (leadGo s 0 (strlen s)) s.
# the position of the first non-space byte (n when there is none) = how many lead
leadGo : String -> (i : Int | measure (n - i)) -> (n : Int) -> Int .
leadGo s i n | i >= n = i.
leadGo s i n | isSpace (charAt s i) = leadGo s (i + 1) n.
leadGo _ i _ = i.

trimRight : String -> String .
trimRight s = left (trailGo s (strlen s - 1)) s.
# one past the last non-space byte = how many to keep
trailGo : String -> (i : Int | measure i) -> Int .
trailGo s i | i < 0 = 0.
trailGo s i | isSpace (charAt s i) = trailGo s (i - 1).
trailGo _ i = i + 1.

# ---- rewriting -----------------------------------------------------------------------
# every occurrence, left to right, not overlapping
replace : String -> String -> String -> String .
replace old new s | strlen old == 0 = s.
replace old new s = strJoin new (split old s).

repeat : Int -> String -> String .
repeat n s = strJoin "" (repeatGo n s Nil).
repeatGo : (n : Int | measure n) -> String -> List String -> List String .
repeatGo n s acc | n <= 0 = acc.
repeatGo n s acc = repeatGo (n - 1) s (s :: acc).

# to a width, with a pad byte given as a one-byte String: String.padLeft 5 "0" "42"
padLeft : Int -> String -> String -> String .
padLeft w pad s = strcat (repeat (w - strlen s) pad) s.

padRight : Int -> String -> String -> String .
padRight w pad s = strcat s (repeat (w - strlen s) pad).

reverse : String -> String .
reverse s = fromCodes (rev (codes s) Nil).

# ASCII only: a byte outside A-Z / a-z is left alone, so UTF-8 survives
toUpper : String -> String .
toUpper s = mapCodes (fn c -> if c >= 97 and c <= 122 then c - 32 else c) s.

toLower : String -> String .
toLower s = mapCodes (fn c -> if c >= 65 and c <= 90 then c + 32 else c) s.

# ---- bytes ---------------------------------------------------------------------------
codes : String -> List Int .
codes s = codesGo s (strlen s - 1) Nil.
codesGo : String -> (i : Int | measure i) -> List Int -> List Int .
codesGo s i acc | i < 0 = acc.
codesGo s i acc = codesGo s (i - 1) (charAt s i :: acc).

fromCodes : List Int -> String .
fromCodes cs = strJoin "" (chrs cs Nil).
chrs : (cs : List Int | measure cs) -> List String -> List String .
chrs cs acc = case cs of Nil -> rev acc Nil | c :: r -> chrs r (chr c :: acc).

mapCodes : (Int -> Int) -> String -> String .
mapCodes f s = strJoin "" (mapGo f s (strlen s - 1) Nil).
mapGo : (Int -> Int) -> String -> (i : Int | measure i) -> List String -> List String .
mapGo f s i acc | i < 0 = acc.
mapGo f s i acc = mapGo f s (i - 1) (chr (f (charAt s i)) :: acc).

isDigit : Int -> Bool
  | work isDigit <= 6 | alloc isDigit <= 16 .
isDigit c = c >= 48 and c <= 57.

isAlpha : Int -> Bool
  | work isAlpha <= 10 | alloc isAlpha <= 32 .
isAlpha c = (c >= 97 and c <= 122) or (c >= 65 and c <= 90).

# ---- numbers -------------------------------------------------------------------------
fromInt : Int -> String .
fromInt n = str n.

# the WHOLE string must be a decimal integer, with an optional leading "-"
toInt : String -> Result Int String .
toInt s =
  n = strlen s;
  neg = startsWith "-" s;
  first = if neg then 1 else 0;
  if first >= n then Err "not a number: \"{s}\""
  else (case digitsGo s first n 0 of
        Err 1 -> Err "out of range: \"{s}\" (an Int holds {intMin Unit}..{intMax Unit})"
      | Err _ -> Err "not a number: \"{s}\""
      | Ok v ->
          if neg then Ok v
          else if v == intMin Unit then Err "out of range: \"{s}\" (an Int holds {intMin Unit}..{intMax Unit})"
          else Ok (0 - v)).
# The digits accumulate NEGATIVELY so the most negative Int is reachable.
# Err 0: not a digit; Err 1: the value would pass the 63-bit Int (it used
# to wrap silently: "4611686018427387904" answered -4611686018427387904)
digitsGo : String -> (i : Int | measure (n - i)) -> (n : Int) -> Int -> Result Int Int .
digitsGo s i n acc | i >= n = Ok acc.
digitsGo s i n acc =
  c = charAt s i;
  if not (isDigit c) then Err 0
  else if acc < (intMin Unit + (c - 48)) / 10 then Err 1
  else digitsGo s (i + 1) n (acc * 10 - (c - 48)).

# ---- ordering ------------------------------------------------------------------------
compare : String -> String -> Ord.Ordering .
compare a b = Ord.string a b.

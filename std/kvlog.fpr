# std/kvlog.fpr -- KvLog: a durable key-value store that is an APPEND-ONLY log
# (ExtBase).
#
#   KvLog = use "std/kvlog".
#   case KvLog.open "app.kvlog" of
#       Ok db -> _ = KvLog.put "cart/42" value db; KvLog.get "cart/42" db
#     | Err why -> ...
#
# Every `put` appends one line -- {"t": seconds, "k": key, "v": value} -- and
# nothing is ever rewritten.  So the file is the whole HISTORY: opening it
# replays it (the last value of each key wins), `history key` is every value a
# key ever had, and `at time` is the store as it stood then.  State you can
# replay is state you can debug, audit and migrate.
#
# One actor owns the file and the working set (the MVU rule: a single writer;
# everyone else asks).  Values are Json.Value, so anything decodes with
# std/decode.  A torn last line -- the process died mid-append -- fails to
# parse and is skipped, and `open` says how many lines it skipped.
#
# The log only grows until you say otherwise: `compact keepAll db` rewrites it
# with the LATEST record of every key, and the whole history of the keys you
# name (an event journal is only useful whole).  It is written beside the log
# and renamed over it, so a crash leaves the old log or the new one, never half.
#
# Not here: fsync (a put is durable when the OS says the append returned, not
# when the platter has it), multi-process use.

J = use "json".
M = use "map".
O = use "option".
S = use "string".
F = use "file".
C = use "clock".
A = use "actor".

KvLog = Type (KvLog Int String).

Req = Type (Put key value | Get key | Keys | Size | Compact keepAll).
Rep = Type (Done | Value v | Listing ks | Count n | Failed why).

rev : unsafe List a -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# ---- reading a log file (no actor: a file is just data) -------------------------------
# every record in order: (time, key, value); unparsable lines are counted, not fatal
records : String -> Result (List (Int, String, J.Value), Int) String .
records path = case F.exists path of
    False -> Ok (Nil, 0)
  | True -> (case F.lines path of Err why -> Err why | Ok ls -> Ok (recordsGo ls Nil 0)).
recordsGo : unsafe List String -> List (Int, String, J.Value) -> Int -> (List (Int, String, J.Value), Int) .
recordsGo ls acc bad = case ls of
    Nil -> (rev acc Nil, bad)
  | l :: r -> (case record l of
        O.Some rec -> recordsGo r (rec :: acc) bad
      | O.None -> recordsGo r acc (if strlen (S.trim l) == 0 then bad else bad + 1)).
record : String -> O.Option (Int, String, J.Value) .
record line = case J.parse line of
    Err _ -> O.None
  | Ok v -> (case J.field "k" v of
        O.Some (J.Text k) -> (case J.field "v" v of
            O.Some x -> O.Some ((case J.field "t" v of O.Some (J.Integer t) -> t | _ -> 0), k, x)
          | O.None -> O.None)
      | _ -> O.None).

# every value `key` ever had, oldest first, with when
history : String -> String -> Result (List (Int, J.Value)) String .
history path key = case records path of
    Err why -> Err why
  | Ok (recs, _) -> Ok (historyGo key recs Nil).
historyGo : unsafe String -> List (Int, String, J.Value) -> List (Int, J.Value) -> List (Int, J.Value) .
historyGo key recs acc = case recs of
    Nil -> rev acc Nil
  | (t, k, v) :: r -> (if k == key then historyGo key r ((t, v) :: acc) else historyGo key r acc).

# the store as it stood at `time` (seconds): replay, stopping there
at : Int -> String -> Result (M.Map String J.Value) String .
at time path = case records path of
    Err why -> Err why
  | Ok (recs, _) -> Ok (replayGo time recs (M.empty S.compare)).
replayGo : unsafe Int -> List (Int, String, J.Value) -> M.Map String J.Value -> M.Map String J.Value .
replayGo time recs m = case recs of
    Nil -> m
  | (t, k, v) :: r -> (if time > 0 and t > time then m else replayGo time r (M.insert k v m)).

# ---- the store -------------------------------------------------------------------------
# replays the file, then serves it.  `skipped` lines could not be read (a torn tail).
open : String -> Result KvLog String .
open path = case records path of
    Err why -> Err "{path}: {why}"
  | Ok (recs, skipped) ->
      m = replayGo 0 recs (M.empty S.compare);
      _ = (if skipped > 0 then Sys.stderr "kvlog: {path}: skipped {skipped} unreadable line(s)\n" else Unit);
      Ok (KvLog (spawn (fn self -> serveLog self path m)) path).

# the store's loop: the prelude's `serve`, except that a request from nobody
# (a `post`: sender 0) gets no reply -- only a failure worth telling about
serveLog : unsafe Int -> String -> M.Map String J.Value -> a .
serveLog self path m =
  msg = receive self;
  (rt, q) = msg;
  (m2, r) = step path m q;
  _ = (if rt == 0 then (case r of Failed why -> _ = Sys.stderr "kvlog: {path}: a posted write failed: {why}\n"; Unit | _ -> Unit)
       else _ = send rt r; Unit);
  _ = drop msg;
  serveLog self path m2.

# the store's state never holds on to a request: `keep` makes it its own
step : String -> M.Map String J.Value -> Req -> (M.Map String J.Value, Rep) .
step path m q = case q of
  Put k v ->
    (case fileAppend path (strcat (J.render (J.object (("t", J.Integer (C.now Unit)) :: ("k", J.Text k) :: ("v", v) :: Nil))) "\n") of
      Ok _ -> (M.insert (keep k) (keep v) m, Done)
    | Err why -> (m, Failed why))
  | Get k -> (m, (case M.get k m of O.Some v -> Value v | O.None -> Done))
  | Keys -> (m, Listing (M.keys m))
  | Size -> (m, Count (M.size m))
  | Compact keepAll -> (m, (case rewrite path keepAll of Ok dropped -> Count dropped | Err why -> Failed why)).

# the log again, with only what is still worth keeping; answers how many records went
rewrite : String -> List String -> Result Int String .
rewrite path keepAll = case records path of
    Err why -> Err why
  | Ok (recs, _) ->
      latest = lastIndex recs 0 (M.empty S.compare);
      kept = keepGo recs 0 keepAll latest Nil;
      tmp = strcat path ".compact";
      (case F.writeText tmp (strJoin "" kept) of
          Err why -> Err why
        | Ok _ -> (case F.rename tmp path of
              Err why -> Err why
            | Ok _ -> Ok (countOf recs 0 - countOf kept 0))).

# key -> the position of its last record
lastIndex : unsafe List (Int, String, J.Value) -> Int -> M.Map String Int -> M.Map String Int .
lastIndex recs i m = case recs of Nil -> m | (_, k, _) :: r -> lastIndex r (i + 1) (M.insert k i m).

# the lines to keep, in their original order
keepGo : unsafe List (Int, String, J.Value) -> Int -> List String -> M.Map String Int -> List String -> List String .
keepGo recs i keepAll latest acc = case recs of
    Nil -> rev acc Nil
  | (t, k, v) :: r -> (if isIn k keepAll or M.get k latest == O.Some i
      then keepGo r (i + 1) keepAll latest (strcat (J.render (J.object (("t", J.Integer t) :: ("k", J.Text k) :: ("v", v) :: Nil))) "\n" :: acc)
      else keepGo r (i + 1) keepAll latest acc).
isIn : unsafe String -> List String -> Bool .
isIn k ks = case ks of Nil -> False | x :: r -> (if x == k then True else isIn k r).
countOf : unsafe List a -> Int -> Int .
countOf xs n = case xs of Nil -> n | _ :: r -> countOf r (n + 1).

# A reply is a MESSAGE: it is dropped once read (or it pins the store's slab for
# as long as the caller lives), and what is taken out of it to keep is `keep`-copied.
# Compatibility convenience: a failed append stops the caller instead of claiming
# success. Use tryPut when the application can handle a storage error explicitly.
put : String -> J.Value -> KvLog -> Unit .
put key value db = case tryPut key value db of
    Ok _ -> Unit
  | Err why -> error "kvlog: cannot save {key}: {why}".

# On failure the in-memory value is unchanged. An I/O error may still have
# partially appended bytes; this is not a transactional or fsync guarantee.
tryPut : String -> J.Value -> KvLog -> Result Unit String .
tryPut key value db = case db of KvLog a _ ->
  r = A.askSure (myself 0) a (Put key value);
  out = (case r of Done -> Ok Unit | Failed why -> Err (keep why) | _ -> Err "put: unexpected reply");
  _ = drop r;
  out.

# A put WITHOUT waiting: the store appends it in order -- a later get, put or
# sync from the same actor sees it -- and the caller carries on.  For a caller
# that must not stall on the disk (std/live's register writes while every
# session waits on it).  Nobody is waiting to hear of a failure, so it is said
# on stderr.  `sync` returns once every post this actor made has been appended.
post : String -> J.Value -> KvLog -> Unit .
post key value db = case db of KvLog a _ -> _ = A.sendSure (myself 0) a (0, Put key value); Unit.
sync : KvLog -> Unit .
sync db = _ = size db; Unit.

get : String -> KvLog -> O.Option J.Value .
get key db = case db of KvLog a _ ->
  r = A.askSure (myself 0) a (Get key);
  out = (case r of Value v -> O.Some (keep v) | _ -> O.None);
  _ = drop r;
  out.

keys : KvLog -> List String .
keys db = case db of KvLog a _ ->
  r = A.askSure (myself 0) a Keys;
  out = (case r of Listing ks -> keep ks | _ -> Nil);
  _ = drop r;
  out.

size : KvLog -> Int .
size db = case db of KvLog a _ ->
  r = A.askSure (myself 0) a Size;
  out = (case r of Count n -> n | _ -> 0);
  _ = drop r;
  out.

# rewrite the log keeping the latest record of every key and ALL records of the
# keys in `keepAll`; answers how many records were dropped
compact : List String -> KvLog -> Result Int String .
compact keepAll db = case db of KvLog a _ ->
  r = A.askSure (myself 0) a (Compact keepAll);
  out = (case r of Count n -> Ok n | Failed why -> Err (keep why) | _ -> Err "compact: no answer");
  _ = drop r;
  out.

path : KvLog -> String .
path db = case db of KvLog _ p -> p.

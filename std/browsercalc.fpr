# Declarative Live-local projections (ExtBase). All reads, computations and
# DOM effects are structured FP-RISC values. This is a deliberately small
# browser backend, not a compiler for arbitrary FP-RISC functions.
C = use "clientcalc".
L = use "list".

# Targets are DOM hooks, not application CSS selectors. Each nests a scope;
# output hooks and inner loops only search descendants of the current scope.
Target = Type (Attribute String | Id String).
Effect = Type (SetNumber String C.IntExpr | SetText String C.TextExpr |
  ReadAttribute String String | ReadLocal String C.TextExpr |
  ReadTextAttribute String String | Each Target (List Effect) |
  PutText Target C.TextExpr | Show Target C.BoolExpr |
  SetSequence String C.IntListExpr | ReadClock String |
  When C.BoolExpr (List Effect) | PutVisibleText Target C.TextExpr |
  SetTexts String C.TextListExpr | LoadStoredTexts String String |
  SaveStoredTexts String C.TextListExpr | ReadValue String | SetValue C.TextExpr |
  ClearValueLater | PreventDefault | Ancestor Target (List Effect) |
  After Int (List Effect) | AtDocument (List Effect) |
  ScrollBottom Target | ScrollStart Target ScrollBehavior).
ScrollBehavior = Type (Instant | Smooth).
Handler = Type (On String (List Effect) | Every Int (List Effect) |
  OnSuspend (List Effect) | Key Target String (List Effect) |
  Click Target (List Effect)).

JS = use "javascript".
n = JS.Name.
t = JS.Text.
f = JS.Field.
num = JS.Number.
call name args = JS.Call (n name) args.
method target name args = JS.Call (f target name) args.
doMethod target name args = JS.Do (method target name args).
assign target value = JS.Assign target value.
neg value = JS.Unary JS.Not value.
equal = JS.Binary JS.Equal.
object = JS.Object Nil.
empty u = method (n "Object") "create" [JS.Null].
queue body = doMethod (n "_writes") "push" [JS.Function Nil body].
writeAll u = doMethod (n "_writes") "forEach" [JS.Function ["write"] [JS.Do (call "write" Nil)]].
errorEvent = doMethod (n "document") "dispatchEvent" [JS.New (n "CustomEvent") [t "fpr:client-error", JS.Object [("detail", JS.Object [("message", call "String" [f (n "error") "message"])])]]].
# Copies isolate computed state; DOM writes commit after all calculations pass.
invokeAst persistent effects = JS.Function ["_event", "_scope"]
  (L.append [JS.Const "_n" (JS.Binary JS.Or (n "_scope") (n "document")),
    JS.Const "_copies" (if persistent then method (n "_state") "map" [JS.Function ["s"] [JS.Return (method (n "Object") "assign" [empty Unit, n "s"])]] else JS.Array [empty Unit, empty Unit, empty Unit, empty Unit]),
    JS.Const "_ns" (JS.Index (n "_copies") (num 0)), JS.Const "_ss" (JS.Index (n "_copies") (num 1)),
    JS.Const "_ls" (JS.Index (n "_copies") (num 2)), JS.Const "_ts" (JS.Index (n "_copies") (num 3)), JS.Const "_writes" (JS.Array Nil)]
    (L.append (accessorNodes Unit) [JS.Try (L.append (emitNodes effects) (L.append (if persistent then [assign (n "_state") (n "_copies")] else Nil) [writeAll Unit])) "error" [errorEvent] Nil])).
invoke effects = JS.expr (invokeAst True effects).
accessor name table label = JS.Define name ["k"]
  [JS.If (neg (method (n "Object") "hasOwn" [n table, n "k"])) [JS.Throw (call "Error" [JS.Binary JS.Add (t "BrowserCalc: missing {label} ") (n "k")])] Nil,
   JS.Return (JS.Index (n table) (n "k"))].
accessorNodes u = [accessor "_number" "_ns" "number", accessor "_string" "_ss" "text", accessor "_sequence" "_ls" "sequence", accessor "_textSequence" "_ts" "text sequence"].
accessors u = JS.program (accessorNodes u).
program initial handlers = JS.program [JS.Do (JS.Call (JS.Function Nil
  (L.append (runtimeNodes Unit)
    [JS.Let "_state" (JS.Array [empty Unit, empty Unit, empty Unit, empty Unit]), JS.Let "_running" (JS.Boolean False),
     JS.Const "_cleanups" (JS.Array Nil), JS.Const "_timeouts" (JS.New (n "Set") Nil),
     JS.Define "_later" ["fn", "ms"] [JS.Const "id" (call "setTimeout" [JS.Function Nil [doMethod (n "_timeouts") "delete" [n "id"], JS.If (n "_running") [JS.Do (call "fn" Nil)] Nil], n "ms"]), doMethod (n "_timeouts") "add" [n "id"]],
     JS.Do (JS.Call (invokeAst True initial) [JS.Null]),
     JS.Define "_start" Nil (L.append [JS.If (n "_running") [JS.ReturnVoid] Nil, assign (n "_running") (JS.Boolean True)] (L.concatMap subscriptionNodes handlers)),
     JS.Define "_stop" Nil (L.append [JS.If (neg (n "_running")) [JS.ReturnVoid] Nil, assign (n "_running") (JS.Boolean False)]
       (L.append (L.concatMap suspendedNodes handlers)
         [doMethod (method (n "_cleanups") "splice" [num 0]) "forEach" [JS.Function ["cleanup"] [JS.Do (call "cleanup" Nil)]], doMethod (n "_timeouts") "forEach" [n "clearTimeout"], doMethod (n "_timeouts") "clear" Nil])),
     doMethod (n "window") "addEventListener" [t "pagehide", n "_stop"], doMethod (n "window") "addEventListener" [t "pageshow", JS.Function ["e"] [JS.If (f (n "e") "persisted") [JS.Do (call "_start" Nil)] Nil]], JS.Do (call "_start" Nil)])) Nil)].
onLocals effects = if ownsTimeouts effects then error "BrowserCalc: deferred effects require program" else
  JS.program [JS.Do (JS.Call (JS.Function Nil (L.append (runtimeNodes Unit)
    [doMethod (n "document") "addEventListener" [t "live:locals", invokeAst False effects]])) Nil)].
listener name callback capture = [JS.Const "listener" callback,
  doMethod (n "document") "addEventListener" [t name, n "listener", JS.Boolean capture],
  doMethod (n "_cleanups") "push" [JS.Function Nil [doMethod (n "document") "removeEventListener" [t name, n "listener", JS.Boolean capture]]]].
subscriptionNodes handler = [JS.Scope (case handler of
    On name effects -> listener name (invokeAst True effects) False
  | Every ms effects -> if not (validInterval ms) then error "BrowserCalc.Every: interval 1..2147483647 ms" else
      [JS.Const "timer" (call "setInterval" [invokeAst True effects, num ms]), doMethod (n "_cleanups") "push" [JS.Function Nil [JS.Do (call "clearInterval" [n "timer"])]]]
  | OnSuspend _ -> Nil
  | Key target key effects -> listener "keydown" (JS.Function ["e"]
      [JS.If (JS.Binary JS.And (equal (f (n "e") "key") (t key)) (JS.Binary JS.And (JS.Binary JS.InstanceOf (f (n "e") "target") (n "Element")) (method (f (n "e") "target") "matches" [selectorAst target])))
        [JS.Do (JS.Call (invokeAst True effects) [n "e", f (n "e") "target"])] Nil]) True
  | Click target effects -> listener "click" (JS.Function ["e"]
      [JS.Const "node" (JS.Choose (JS.Binary JS.InstanceOf (f (n "e") "target") (n "Element")) (method (f (n "e") "target") "closest" [selectorAst target]) JS.Null), JS.If (n "node") [JS.Do (JS.Call (invokeAst True effects) [n "e", n "node"])] Nil]) True)].
subscription handler = JS.program (subscriptionNodes handler).
suspendedNodes handler = case handler of OnSuspend effects -> [JS.Do (JS.Call (invokeAst True effects) [JS.Null])] | _ -> Nil.
suspended handler = JS.program (suspendedNodes handler).
validInterval ms = ms >= 1 and (ms / 1000000000 < 2 or (ms / 1000000000 == 2 and ms % 1000000000 <= 147483647)).
runtime u = JS.program (runtimeNodes u).
runtimeNodes u =
  [JS.Define "_int" ["n"] [JS.If (JS.Binary JS.Or (JS.Binary JS.Less (n "n") (JS.BigInteger (intMin Unit))) (JS.Binary JS.Greater (n "n") (JS.BigInteger (intMax Unit)))) [JS.Throw (call "Error" [t "BrowserCalc: Int overflow"])] Nil, JS.Return (n "n")],
   JS.Define "_at" ["xs", "i"] [JS.If (outOfBounds Unit) [JS.Throw (call "Error" [t "ClientCalc.At: index out of bounds"])] Nil, JS.Return (JS.Index (n "xs") (call "Number" [n "i"]))],
   JS.Define "_textAt" ["xs", "i"] [JS.Return (JS.Choose (outOfBounds Unit) (t "") (JS.Index (n "xs") (call "Number" [n "i"])))],
   JS.Define "_loadTexts" ["key"] [JS.Try [JS.Const "xs" (method (n "JSON") "parse" [JS.Binary JS.Or (method (n "localStorage") "getItem" [n "key"]) (t "[]")]), JS.Return (JS.Choose (JS.Binary JS.And (method (n "Array") "isArray" [n "xs"]) (method (n "xs") "every" [JS.Function ["x"] [JS.Return (equal (JS.Unary JS.TypeOf (n "x")) (t "string"))]])) (n "xs") (JS.Array Nil))] "e" [JS.Return (JS.Array Nil)] Nil],
   JS.Define "_parse" ["s", "local"] [JS.If (JS.Binary JS.Or (JS.Binary JS.NotEqual (JS.Unary JS.TypeOf (n "s")) (t "string")) (JS.Binary JS.Or (neg (method (JS.Pattern "^-?[0-9]+$" "") "test" [n "s"])) (JS.Binary JS.NotEqual (method (n "s") "trim" Nil) (n "s")))) [JS.If (n "local") [JS.Return (JS.BigInteger 0)] Nil, JS.Throw (call "Error" [t "BrowserCalc: expected decimal attribute"])] Nil, JS.Return (call "_int" [call "BigInt" [n "s"]])]].
outOfBounds u = JS.Binary JS.Or (JS.Binary JS.Less (n "i") (JS.BigInteger 0)) (JS.Binary JS.GreaterEqual (n "i") (call "BigInt" [f (n "xs") "length"])).
selector target = JS.expr (selectorAst target).
selectorAst target = case target of Attribute name -> JS.Binary JS.Add (JS.Binary JS.Add (t "[") (method (n "CSS") "escape" [t name])) (t "]") | Id name -> JS.Binary JS.Add (t "#") (method (n "CSS") "escape" [t name]).
emit effects = JS.program (emitNodes effects).
emitNodes : unsafe List Effect -> List JS.Statement .
emitNodes effects = L.map (fn effect -> JS.Scope (effectNodes effect)) effects.
statement effect = JS.program [JS.Scope (effectNodes effect)].
selected target body = method (n "_n") "querySelectorAll" [selectorAst target] |> (fn nodes -> JS.Do (method nodes "forEach" [JS.Function ["node"] body])).
set table key value = assign (JS.Index (n table) (t key)) value.
effectNodes : unsafe Effect -> List JS.Statement .
effectNodes effect = case effect of
    SetNumber key value -> [set "_ns" key (C.astInt value)]
  | SetText key value -> [set "_ss" key (C.astText value)]
  | ReadAttribute key attr -> [set "_ns" key (call "_parse" [method (n "_n") "getAttribute" [t attr], JS.Boolean False])]
  | ReadLocal key local -> [set "_ns" key (call "_parse" [JS.Index (JS.Binary JS.Or (f (n "_event") "detail") object) (C.astText local), JS.Boolean True])]
  | ReadTextAttribute key attr -> [set "_ss" key (JS.Binary JS.Or (method (n "_n") "getAttribute" [t attr]) (t ""))]
  | Each target body -> [JS.Do (method (method (n "_n") "querySelectorAll" [selectorAst target]) "forEach" [JS.Function ["_n"] (emitNodes body)])]
  | PutText target value -> [JS.Const "text" (C.astText value), selected target [queue [assign (f (n "node") "textContent") (n "text")]]]
  | Show target value -> [JS.Const "show" (C.astBool value), selected target [queue [assign (f (f (n "node") "style") "display") (JS.Choose (n "show") (t "") (t "none"))]]]
  | SetSequence key value -> [set "_ls" key (C.astList value)]
  | ReadClock key -> [set "_ns" key (call "_int" [call "BigInt" [method (n "Math") "floor" [JS.Binary JS.Multiply (method (n "performance") "now" Nil) (num 1000)]]])]
  | When condition body -> [JS.If (C.astBool condition) (emitNodes body) Nil]
  | PutVisibleText target value -> [selected target [JS.If (f (method (n "node") "getClientRects" Nil) "length") [JS.Const "text" (C.astText value), queue [assign (f (n "node") "textContent") (n "text")]] Nil]]
  | SetTexts key value -> [set "_ts" key (C.astTexts value)]
  | LoadStoredTexts key storage -> [set "_ts" key (call "_loadTexts" [t storage])]
  | SaveStoredTexts key value -> [JS.Const "texts" (C.astTexts value), queue [JS.Try [doMethod (n "localStorage") "setItem" [t key, method (n "JSON") "stringify" [n "texts"]]] "e" Nil Nil]]
  | ReadValue key -> [set "_ss" key (f (n "_n") "value")]
  | SetValue value -> [JS.Const "value" (C.astText value), JS.Const "node" (n "_n"), queue [assign (f (n "node") "value") (n "value"), inputEvent Unit]]
  | ClearValueLater -> [JS.Const "node" (n "_n"), JS.Const "value" (f (n "node") "value"), queue [JS.Do (call "_later" [JS.Function Nil [JS.If (JS.Binary JS.And (f (n "node") "isConnected") (equal (f (n "node") "value") (n "value"))) [assign (f (n "node") "value") (t ""), inputEvent Unit] Nil], num 0])]]
  | PreventDefault -> [queue [doMethod (n "_event") "preventDefault" Nil]]
  | Ancestor target body -> [JS.Const "parent" (JS.Choose (JS.Binary JS.InstanceOf (n "_n") (n "Element")) (method (n "_n") "closest" [selectorAst target]) JS.Null), JS.If (n "parent") [JS.Do (JS.Call (JS.Function ["_n"] (emitNodes body)) [n "parent"])] Nil]
  | After ms body -> if ms != 0 and not (validInterval ms) then error "BrowserCalc.After: delay 0..2147483647 ms" else
      [JS.Const "scope" (n "_n"), JS.Const "event" (n "_event"), queue [JS.Do (call "_later" [JS.Function Nil [JS.Do (JS.Call (invokeAst True body) [n "event", n "scope"])], num ms])]]
  | AtDocument body -> [JS.Do (JS.Call (JS.Function ["_n"] (emitNodes body)) [n "document"])]
  | ScrollBottom target -> [selected target [queue [JS.If (f (method (n "node") "getClientRects" Nil) "length") [assign (f (n "node") "scrollTop") (f (n "node") "scrollHeight")] Nil]]]
  | ScrollStart target behavior -> [selected target [queue [JS.If (f (method (n "node") "getClientRects" Nil) "length") [doMethod (n "node") "scrollIntoView" [JS.Object [("block", t "start"), ("behavior", t (scrollBehavior behavior))]]] Nil]]].
inputEvent u = doMethod (n "node") "dispatchEvent" [JS.New (n "Event") [t "input", JS.Object [("bubbles", JS.Boolean True)]]].
scrollBehavior : ScrollBehavior -> String .
scrollBehavior behavior = case behavior of Instant -> "instant" | Smooth -> "smooth".
ownsTimeouts : unsafe List Effect -> Bool .
ownsTimeouts effects = L.any ownsTimeout effects.
ownsTimeout : unsafe Effect -> Bool .
ownsTimeout effect = case effect of
    After _ _ -> True | ClearValueLater -> True
  | Each _ body -> ownsTimeouts body | When _ body -> ownsTimeouts body
  | Ancestor _ body -> ownsTimeouts body | AtDocument body -> ownsTimeouts body
  | _ -> False.

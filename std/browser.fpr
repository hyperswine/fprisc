# std/browser.fpr -- Unified browser & client UI surface (ExtBase).
#
#   Browser = use "std/browser".
#
# Combines DOM effect projections (BrowserCalc), browser capabilities
# (console, storage, formFill, feedback, autocomplete, media, metrics, notice),
# and money formatting helpers under a single module import.

C = use "clientcalc".
L = use "list".
G = use "view".
JS = use "javascript".
Clock = use "clock".

ClientCalc = use "clientcalc".

# ---- DOM effect projections (BrowserCalc) --------------------------------------
# Declarative Live-local projections (ExtBase). All reads, computations and
# DOM effects are structured FP-RISC values. This is a deliberately small
# browser backend, not a compiler for arbitrary FP-RISC functions.

# Targets are DOM hooks, not application CSS selectors. Each nests a scope;
# output hooks and inner loops only search descendants of the current scope.
Target = Type (Attribute String | Id String).
# A hook is ONE value: the page's view places it (`B.mark tax "{m.tax}"`) and
# the script selects by it (`B.Each tax [...]`), so the name is written once.
mark : Target -> String -> G.Attr .
mark (Attribute name) value = G.Att name value.
mark (Id name) value = G.Att "id" value.
# the attribute a target names, for an effect that reads it (ReadAttribute)
attributeOf : Target -> String .
attributeOf (Attribute name) = name.
attributeOf (Id _) = "id".
Effect = Type (SetNumber String C.IntExpr | SetText String C.TextExpr |
  ReadAttribute String String | ReadLocal String C.TextExpr |
  ReadTextAttribute String String | Each Target (List Effect) |
  PutText Target C.TextExpr | Show Target C.BoolExpr |
  SetSequence String C.IntListExpr | ReadClock String |
  When C.BoolExpr (List Effect) | PutVisibleText Target C.TextExpr |
  SetTexts String C.TextListExpr | LoadStoredTexts String String |
  SaveStoredTexts String C.TextListExpr | ReadValue String | SetValue C.TextExpr |
  ClearValueLater | PreventDefault | Ancestor Target (List Effect) |
  After Int (List Effect) | AtDocument (List Effect) |
  ScrollBottom Target | ScrollStart Target ScrollBehavior).
ScrollBehavior = Type (Instant | Smooth).
Handler = Type (On String (List Effect) | Every Int (List Effect) |
  OnSuspend (List Effect) | Key Target String (List Effect) |
  Click Target (List Effect)).

n = JS.Name.
t = JS.Text.
f = JS.Field.
num = JS.Number.
call name args = JS.Call (n name) args.
method target name args = JS.Call (f target name) args.
doMethod target name args = JS.Do (method target name args).
assign target value = JS.Assign target value.
neg value = JS.Unary JS.Not value.
equal = JS.Binary JS.Equal.
object = JS.Object Nil.
empty u = method (n "Object") "create" [JS.Null].
queue body = doMethod (n "_writes") "push" [JS.Function Nil body].
writeAll u = doMethod (n "_writes") "forEach" [JS.Function ["write"] [JS.Do (call "write" Nil)]].
errorEvent = doMethod (n "document") "dispatchEvent" [JS.New (n "CustomEvent") [t "fpr:client-error", JS.Object [("detail", JS.Object [("message", call "String" [f (n "error") "message"])])]]].
# Copies isolate computed state; DOM writes commit after all calculations pass.
invokeWrap : Bool -> List JS.Statement -> JS.Expr .
invokeWrap persistent stmts = JS.Function ["_event", "_scope"]
  (L.append [JS.Const "_n" (JS.Binary JS.Or (n "_scope") (n "document")),
    JS.Const "_copies" (if persistent then method (n "_state") "map" [JS.Function ["s"] [JS.Return (method (n "Object") "assign" [empty Unit, n "s"])]] else JS.Array [empty Unit, empty Unit, empty Unit, empty Unit]),
    JS.Const "_ns" (JS.Index (n "_copies") (num 0)), JS.Const "_ss" (JS.Index (n "_copies") (num 1)),
    JS.Const "_ls" (JS.Index (n "_copies") (num 2)), JS.Const "_ts" (JS.Index (n "_copies") (num 3)), JS.Const "_writes" (JS.Array Nil)]
    (L.append (accessorNodes Unit) [JS.Try (L.append stmts (L.append (if persistent then [assign (n "_state") (n "_copies")] else Nil) [writeAll Unit])) "error" [errorEvent] Nil])).
invokeAst : Bool -> List Effect -> JS.Expr .
invokeAst persistent effects = invokeWrap persistent (emitNodes effects).
invoke effects = JS.expr (invokeAst True effects).
accessor name table label = JS.Define name ["k"]
  [JS.If (neg (method (n "Object") "hasOwn" [n table, n "k"])) [JS.Throw (call "Error" [JS.Binary JS.Add (t "BrowserCalc: missing {label} ") (n "k")])] Nil,
   JS.Return (JS.Index (n table) (n "k"))].
accessorNodes u = [accessor "_number" "_ns" "number", accessor "_string" "_ss" "text", accessor "_sequence" "_ls" "sequence", accessor "_textSequence" "_ts" "text sequence"].
accessors u = JS.program (accessorNodes u).
program initial handlers = JS.program [JS.Do (JS.Call (JS.Function Nil
  (L.append (runtimeNodes Unit)
    [JS.Let "_state" (JS.Array [empty Unit, empty Unit, empty Unit, empty Unit]), JS.Let "_running" (JS.Boolean False),
     JS.Const "_cleanups" (JS.Array Nil), JS.Const "_timeouts" (JS.New (n "Set") Nil),
     JS.Define "_later" ["fn", "ms"] [JS.Const "id" (call "setTimeout" [JS.Function Nil [doMethod (n "_timeouts") "delete" [n "id"], JS.If (n "_running") [JS.Do (call "fn" Nil)] Nil], n "ms"]), doMethod (n "_timeouts") "add" [n "id"]],
     JS.Do (JS.Call (invokeAst True initial) [JS.Null]),
     JS.Define "_start" Nil (L.append [JS.If (n "_running") [JS.ReturnVoid] Nil, assign (n "_running") (JS.Boolean True)] (L.concatMap subscriptionNodes handlers)),
     JS.Define "_stop" Nil (L.append [JS.If (neg (n "_running")) [JS.ReturnVoid] Nil, assign (n "_running") (JS.Boolean False)]
       (L.append (L.concatMap suspendedNodes handlers)
         [doMethod (method (n "_cleanups") "splice" [num 0]) "forEach" [JS.Function ["cleanup"] [JS.Do (call "cleanup" Nil)]], doMethod (n "_timeouts") "forEach" [n "clearTimeout"], doMethod (n "_timeouts") "clear" Nil])),
     doMethod (n "window") "addEventListener" [t "pagehide", n "_stop"], doMethod (n "window") "addEventListener" [t "pageshow", JS.Function ["e"] [JS.If (f (n "e") "persisted") [JS.Do (call "_start" Nil)] Nil]], JS.Do (call "_start" Nil)])) Nil)].
onLocals effects = if ownsTimeouts effects then error "BrowserCalc: deferred effects require program" else
  JS.program [JS.Do (JS.Call (JS.Function Nil (L.append (runtimeNodes Unit)
    [doMethod (n "document") "addEventListener" [t "live:locals", invokeAst False effects]])) Nil)].
listener name callback capture = [JS.Const "listener" callback,
  doMethod (n "document") "addEventListener" [t name, n "listener", JS.Boolean capture],
  doMethod (n "_cleanups") "push" [JS.Function Nil [doMethod (n "document") "removeEventListener" [t name, n "listener", JS.Boolean capture]]]].
subscriptionNodes handler = [JS.Scope (case handler of
    On name effects -> listener name (invokeAst True effects) False
  | Every ms effects -> if not (validInterval ms) then error "BrowserCalc.Every: interval 1..2147483647 ms" else
      [JS.Const "timer" (call "setInterval" [invokeAst True effects, num ms]), doMethod (n "_cleanups") "push" [JS.Function Nil [JS.Do (call "clearInterval" [n "timer"])]]]
  | OnSuspend _ -> Nil
  | Key target key effects -> listener "keydown" (JS.Function ["e"]
      [JS.If (JS.Binary JS.And (equal (f (n "e") "key") (t key)) (JS.Binary JS.And (JS.Binary JS.InstanceOf (f (n "e") "target") (n "Element")) (method (f (n "e") "target") "matches" [selectorAst target])))
        [JS.Do (JS.Call (invokeAst True effects) [n "e", f (n "e") "target"])] Nil]) True
  | Click target effects -> listener "click" (JS.Function ["e"]
      [JS.Const "node" (JS.Choose (JS.Binary JS.InstanceOf (f (n "e") "target") (n "Element")) (method (f (n "e") "target") "closest" [selectorAst target]) JS.Null), JS.If (n "node") [JS.Do (JS.Call (invokeAst True effects) [n "e", n "node"])] Nil]) True)].
subscription handler = JS.program (subscriptionNodes handler).
suspendedNodes handler = case handler of OnSuspend effects -> [JS.Do (JS.Call (invokeAst True effects) [JS.Null])] | _ -> Nil.
suspended handler = JS.program (suspendedNodes handler).
validInterval : Int -> Bool .
validInterval ms = ms >= 1 and (ms / 1000000000 < 2 or (ms / 1000000000 == 2 and ms % 1000000000 <= 147483647)).
runtime u = JS.program (runtimeNodes u).
runtimeNodes u =
  [JS.Define "_int" ["n"] [JS.If (JS.Binary JS.Or (JS.Binary JS.Less (n "n") (JS.BigInteger (0 - (2 ^ 62)))) (JS.Binary JS.Greater (n "n") (JS.BigInteger (2 ^ 62 - 1)))) [JS.Throw (call "Error" [t "BrowserCalc: Int overflow"])] Nil, JS.Return (n "n")],
   JS.Define "_at" ["xs", "i"] [JS.If (outOfBounds Unit) [JS.Throw (call "Error" [t "ClientCalc.At: index out of bounds"])] Nil, JS.Return (JS.Index (n "xs") (call "Number" [n "i"]))],
   JS.Define "_textAt" ["xs", "i"] [JS.Return (JS.Choose (outOfBounds Unit) (t "") (JS.Index (n "xs") (call "Number" [n "i"])))],
   JS.Define "_loadTexts" ["key"] [JS.Try [JS.Const "xs" (method (n "JSON") "parse" [JS.Binary JS.Or (method (n "localStorage") "getItem" [n "key"]) (t "[]")]), JS.Return (JS.Choose (JS.Binary JS.And (method (n "Array") "isArray" [n "xs"]) (method (n "xs") "every" [JS.Function ["x"] [JS.Return (equal (JS.Unary JS.TypeOf (n "x")) (t "string"))]])) (n "xs") (JS.Array Nil))] "e" [JS.Return (JS.Array Nil)] Nil],
   JS.Define "_parse" ["s", "local"] [JS.If (JS.Binary JS.Or (JS.Binary JS.NotEqual (JS.Unary JS.TypeOf (n "s")) (t "string")) (JS.Binary JS.Or (neg (method (JS.Pattern "^-?[0-9]+$" "") "test" [n "s"])) (JS.Binary JS.NotEqual (method (n "s") "trim" Nil) (n "s")))) [JS.If (n "local") [JS.Return (JS.BigInteger 0)] Nil, JS.Throw (call "Error" [t "BrowserCalc: expected decimal attribute"])] Nil, JS.Return (call "_int" [call "BigInt" [n "s"]])]].
outOfBounds u = JS.Binary JS.Or (JS.Binary JS.Less (n "i") (JS.BigInteger 0)) (JS.Binary JS.GreaterEqual (n "i") (call "BigInt" [f (n "xs") "length"])).
selector target = JS.expr (selectorAst target).
selectorAst (Attribute name) = JS.Binary JS.Add (JS.Binary JS.Add (t "[") (method (n "CSS") "escape" [t name])) (t "]").
selectorAst (Id name) = JS.Binary JS.Add (t "#") (method (n "CSS") "escape" [t name]).
emit effects = JS.program (emitNodes effects).
emitNodes : (effects : List Effect | measure effects) -> List JS.Statement .
emitNodes effects = case effects of
    Nil -> Nil
  | effect :: rest -> JS.Scope (effectNodes effect) :: emitNodes rest.
statement effect = JS.program [JS.Scope (effectNodes effect)].
selected target body = method (n "_n") "querySelectorAll" [selectorAst target] |> (fn nodes -> JS.Do (method nodes "forEach" [JS.Function ["node"] body])).
set table key value = assign (JS.Index (n table) (t key)) value.
effectNodes : (effect : Effect | measure effect) -> List JS.Statement .
effectNodes effect = case effect of
    SetNumber key value -> [set "_ns" key (C.astInt value)]
  | SetText key value -> [set "_ss" key (C.astText value)]
  | ReadAttribute key attr -> [set "_ns" key (call "_parse" [method (n "_n") "getAttribute" [t attr], JS.Boolean False])]
  | ReadLocal key local -> [set "_ns" key (call "_parse" [JS.Index (JS.Binary JS.Or (f (n "_event") "detail") object) (C.astText local), JS.Boolean True])]
  | ReadTextAttribute key attr -> [set "_ss" key (JS.Binary JS.Or (method (n "_n") "getAttribute" [t attr]) (t ""))]
  | Each target body -> [JS.Do (method (method (n "_n") "querySelectorAll" [selectorAst target]) "forEach" [JS.Function ["_n"] (emitNodes body)])]
  | PutText target value -> [JS.Const "text" (C.astText value), selected target [queue [assign (f (n "node") "textContent") (n "text")]]]
  | Show target value -> [JS.Const "show" (C.astBool value), selected target [queue [assign (f (f (n "node") "style") "display") (JS.Choose (n "show") (t "") (t "none"))]]]
  | SetSequence key value -> [set "_ls" key (C.astList value)]
  | ReadClock key -> [set "_ns" key (call "_int" [call "BigInt" [method (n "Math") "floor" [JS.Binary JS.Multiply (method (n "performance") "now" Nil) (num 1000)]]])]
  | When condition body -> [JS.If (C.astBool condition) (emitNodes body) Nil]
  | PutVisibleText target value -> [selected target [JS.If (f (method (n "node") "getClientRects" Nil) "length") [JS.Const "text" (C.astText value), queue [assign (f (n "node") "textContent") (n "text")]] Nil]]
  | SetTexts key value -> [set "_ts" key (C.astTexts value)]
  | LoadStoredTexts key storage -> [set "_ts" key (call "_loadTexts" [t storage])]
  | SaveStoredTexts key value -> [JS.Const "texts" (C.astTexts value), queue [JS.Try [doMethod (n "localStorage") "setItem" [t key, method (n "JSON") "stringify" [n "texts"]]] "e" Nil Nil]]
  | ReadValue key -> [set "_ss" key (f (n "_n") "value")]
  | SetValue value -> [JS.Const "value" (C.astText value), JS.Const "node" (n "_n"), queue [assign (f (n "node") "value") (n "value"), inputEvent Unit]]
  | ClearValueLater -> [JS.Const "node" (n "_n"), JS.Const "value" (f (n "node") "value"), queue [JS.Do (call "_later" [JS.Function Nil [JS.If (JS.Binary JS.And (f (n "node") "isConnected") (equal (f (n "node") "value") (n "value"))) [assign (f (n "node") "value") (t ""), inputEvent Unit] Nil], num 0])]]
  | PreventDefault -> [queue [doMethod (n "_event") "preventDefault" Nil]]
  | Ancestor target body -> [JS.Const "parent" (JS.Choose (JS.Binary JS.InstanceOf (n "_n") (n "Element")) (method (n "_n") "closest" [selectorAst target]) JS.Null), JS.If (n "parent") [JS.Do (JS.Call (JS.Function ["_n"] (emitNodes body)) [n "parent"])] Nil]
  | After ms body -> if ms != 0 and not (validInterval ms) then error "BrowserCalc.After: delay 0..2147483647 ms" else
      [JS.Const "scope" (n "_n"), JS.Const "event" (n "_event"), queue [JS.Do (call "_later" [JS.Function Nil [JS.Do (JS.Call (invokeWrap True (emitNodes body)) [n "event", n "scope"])], num ms])]]
  | AtDocument body -> [JS.Do (JS.Call (JS.Function ["_n"] (emitNodes body)) [n "document"])]
  | ScrollBottom target -> [selected target [queue [JS.If (f (method (n "node") "getClientRects" Nil) "length") [assign (f (n "node") "scrollTop") (f (n "node") "scrollHeight")] Nil]]]
  | ScrollStart target behavior -> [selected target [queue [JS.If (f (method (n "node") "getClientRects" Nil) "length") [doMethod (n "node") "scrollIntoView" [JS.Object [("block", t "start"), ("behavior", t (scrollBehavior behavior))]]] Nil]]].
inputEvent u = doMethod (n "node") "dispatchEvent" [JS.New (n "Event") [t "input", JS.Object [("bubbles", JS.Boolean True)]]].
scrollBehavior : ScrollBehavior -> String .
scrollBehavior Instant = "instant".
scrollBehavior Smooth = "smooth".
ownsTimeouts : (effects : List Effect | measure effects) -> Bool .
ownsTimeouts effects = case effects of
    Nil -> False
  | effect :: rest -> ownsTimeout effect or ownsTimeouts rest.
ownsTimeout : (effect : Effect | measure effect) -> Bool .
ownsTimeout effect = case effect of
    After _ _ -> True | ClearValueLater -> True
  | Each _ body -> ownsTimeouts body | When _ body -> ownsTimeouts body
  | Ancestor _ body -> ownsTimeouts body | AtDocument body -> ownsTimeouts body
  | _ -> False.

# ---- Browser console & pager ---------------------------------------------------
# Console history policy and browser effects, expressed as FP-RISC values.

history = C.TextSequence "history".
size = C.TextLength history.
cursor = C.Number "cursor".
command = C.StringVar "command".
# Blank commands do not change history or its cursor. Consecutive duplicates
# do reset the cursor to the newest entry, without taking another slot.
consoleRemembered : (limit : Int | limit >= 1) -> C.TextListExpr .
consoleRemembered limit =
  normalized = C.Trim command;
  C.IfTexts (C.TextEqual normalized (C.Text "")) history
    (C.TextTakeLast limit
      (C.IfTexts (C.TextEqual (C.TextAt history (C.Sub size (C.Literal 1))) normalized)
        history (C.TextSnoc history normalized))).
consoleRecallIndex : Int -> C.IntExpr .
consoleRecallIndex delta =
  moved = C.Add cursor (C.Literal delta);
  C.IfInt (C.Less moved (C.Literal 0)) (C.Literal 0)
    (C.IfInt (C.Less size moved) size moved).
consoleRemember : (limit : Int | limit >= 1) -> String -> List Effect .
consoleRemember limit key =
  [ReadValue "command", SetText "command" (C.Trim command),
   When (C.Not (C.TextEqual command (C.Text "")))
     [SetTexts "history" (consoleRemembered limit),
      SetNumber "cursor" size, SaveStoredTexts key history],
   ClearValueLater].
recall delta =
  [When (C.Less (C.Literal 0) size)
    [SetNumber "cursor" (consoleRecallIndex delta), SetValue (C.TextAt history cursor), PreventDefault]].
console : {scope : Target, input : Target, run : Target, output : Target,
  storageKey : String, limit : Int} -> String .
console cfg =
  limit = cfg.limit;
  if limit < 1 then error "BrowserConsole: history limit must be positive" else
    run = [Ancestor cfg.scope [Each cfg.input (consoleRemember limit cfg.storageKey)]];
    bottom = [Each cfg.scope [ScrollBottom cfg.output]];
    program (L.append
      [LoadStoredTexts "history" cfg.storageKey,
       SetTexts "history" (C.TextTakeLast limit history), SetNumber "cursor" size] bottom)
      [Key cfg.input "Enter" run, Click cfg.run run,
       Key cfg.input "ArrowUp" [Ancestor cfg.scope [Each cfg.input (recall (0 - 1))]],
       Key cfg.input "ArrowDown" [Ancestor cfg.scope [Each cfg.input (recall 1)]],
       On "live:frame" bottom, On "live:locals" bottom].
pager : Target -> Target -> Target -> String .
pager scope button list = program Nil
  [Click button [Ancestor scope
    [After 150 [AtDocument [Each scope [ScrollStart list Smooth]]]]]].

# ---- Browser local storage -----------------------------------------------------
# Device-local persistence capability. Storage refusal is non-fatal; values
# enter Live through the declared input, never by patching its transport.
storage storageKey local input = JS.program [JS.Do (JS.Call (JS.Function Nil
  [JS.Let "ready" (JS.Boolean False),
   JS.Define "stored" Nil [JS.Try [JS.Return (JS.Binary JS.Or (method (n "localStorage") "getItem" [t storageKey]) (t ""))] "error" [JS.Return (t "")] Nil],
   JS.Define "save" ["value"] [JS.Try [JS.If (n "value") [JS.Do (method (n "localStorage") "setItem" [t storageKey, n "value"])] [JS.Do (method (n "localStorage") "removeItem" [t storageKey])]] "error" Nil Nil],
   JS.Do (method (n "document") "addEventListener" [t "live:locals", JS.Function ["event"] [JS.If (JS.Unary JS.Not (n "ready")) [JS.ReturnVoid] Nil,
     JS.Const "value" (JS.Binary JS.Or (JS.Index (f (n "event") "detail") (t local)) (t "")),
     JS.If (JS.Binary JS.NotEqual (n "value") (call "stored" Nil)) [JS.Do (call "save" [n "value"])] Nil]]),
   JS.Const "token" (call "stored" Nil), JS.Const "input" (method (n "document") "querySelector" [selectorAst input]),
   JS.If (JS.Binary JS.And (n "token") (n "input")) [JS.Assign (f (n "input") "value") (n "token"), JS.Do (method (n "input") "dispatchEvent" [JS.New (n "Event") [t "input"]])] Nil,
   JS.Assign (n "ready") (JS.Boolean True)]) Nil)].

# ---- Browser form fill ---------------------------------------------------------
# Structured browser form-fill capability. FP-RISC syntax values are authoritative.
# No foreign source asset or Raw node is read at runtime.


formFill u = JS.program [
  JS.Do (JS.Call (JS.Function Nil (setupNodes Unit)) Nil)
].

applyInputValue u = [
  JS.Do (JS.AssignValue (f (n "el") "value") (JS.Index (n "pending") (n "n"))),
  doMethod (n "el") "dispatchEvent" [JS.New (n "Event") [t "input"]]
].

fillField u = [
  JS.Var "els" (method (n "document") "querySelectorAll" [
    JS.Binary JS.Add (JS.Binary JS.Add (t "[data-input=\"") (n "n")) (t "\"]")
  ]),
  JS.If (JS.Unary JS.Not (f (n "els") "length")) [JS.ReturnVoid] Nil,
  doMethod (n "els") "forEach" [JS.Function ["el"] (applyInputValue Unit)],
  JS.Do (JS.Unary JS.Delete (JS.Index (n "pending") (n "n")))
].

fillPending u = [
  doMethod (method (n "Object") "keys" [n "pending"]) "forEach" [JS.Function ["n"] (fillField Unit)]
].

recordPendingKey u = [
  JS.Do (JS.AssignValue (JS.Index (n "pending") (n "n")) (JS.Index (n "vals") (n "n")))
].

onLiveSet u = [
  JS.Var "vals" (method (n "JSON") "parse" [f (n "e") "detail"]),
  doMethod (method (n "Object") "keys" [n "vals"]) "forEach" [JS.Function ["n"] (recordPendingKey Unit)],
  JS.Do (call "fill" Nil)
].

setupNodes u = [
  JS.Var "pending" (method (n "Object") "create" [JS.Null]),
  JS.Define "fill" Nil (fillPending Unit),
  doMethod (n "document") "addEventListener" [t "live:set", JS.Function ["e"] (onLiveSet Unit)],
  doMethod (JS.New (n "MutationObserver") [n "fill"]) "observe" [
    method (n "document") "getElementById" [t "lv-root"],
    JS.Object [("childList", JS.Boolean True), ("subtree", JS.Boolean True)]
  ]
].

# ---- Browser feedback ----------------------------------------------------------
# Structured browser pending/connection feedback capability. FP-RISC syntax values
# are authoritative. No foreign source asset or Raw node is read at runtime.


feedback u = JS.program [
  JS.Do (JS.Call (JS.Function Nil (setupFeedback Unit)) Nil)
].

readThemeVar u = [
  JS.Var "p" (method (n "root") "querySelector" [t "[data-theme]"]),
  JS.Return (JS.Choose (n "p") (method (call "getComputedStyle" [n "p"]) "getPropertyValue" [n "v"]) (t ""))
].

cancelAnimation u = [
  doMethod (n "a") "cancel" Nil
].

clearPendingState u = [
  JS.Do (call "clearTimeout" [n "showT"]),
  JS.Do (JS.AssignValue (n "showT") JS.Null),
  JS.Do (call "clearTimeout" [n "failT"]),
  JS.Do (JS.AssignValue (n "failT") JS.Null),
  JS.If (n "anim") [doMethod (n "anim") "cancel" Nil, JS.Do (JS.AssignValue (n "anim") JS.Null)] Nil,
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "display") (t (G.displayCss G.Hidden))),
  doMethod (n "pulses") "forEach" [JS.Function ["a"] (cancelAnimation Unit)],
  JS.Do (JS.AssignValue (n "pulses") (JS.Array Nil)),
  JS.If (n "faded") [
    JS.Do (JS.AssignValue (f (f (n "faded") "style") "opacity") (t "")),
    JS.Do (JS.AssignValue (n "faded") JS.Null)
  ] Nil
].

showPendingVisuals u = [
  JS.Do (JS.AssignValue (n "showT") JS.Null),
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "background")
    (JS.Binary JS.Or (call "theme" [t "--ink"]) (t (G.colourCss (G.Rgb 136 136 136))))),
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "display") (t (G.displayCss G.Block))),
  JS.Do (JS.AssignValue (n "anim") (method (n "bar") "animate" [
    JS.Array [
      JS.Object [("transform", t (G.transformCss [G.TranslateX (G.Pct (0 - 100))]))],
      JS.Object [("transform", t (G.transformCss [G.TranslateX (G.Pct 340)]))]
    ],
    JS.Object [("duration", num 900), ("iterations", n "Infinity"), ("easing", t "ease-in-out")]
  ])),
  JS.If (JS.Binary JS.And (n "el") (method (n "document") "contains" [n "el"])) [
    doMethod (n "pulses") "push" [method (n "el") "animate" [
      JS.Array [
        JS.Object [("opacity", num 1)],
        JS.Object [("opacity", JS.Real "0.45")],
        JS.Object [("opacity", num 1)]
      ],
      JS.Object [("duration", num 800), ("iterations", n "Infinity")]
    ]]
  ] Nil,
  JS.Do (JS.AssignValue (n "faded") (method (n "root") "querySelector" [t "[data-lv-key=\"items\"]"])),
  JS.If (n "faded") [
    JS.Do (JS.AssignValue (f (f (n "faded") "style") "transition")
      (t (G.declCss (G.TransitionOpacity 150) |> (fn css -> substr css 11 (strlen css - 11))))),
    JS.Do (JS.AssignValue (f (f (n "faded") "style") "opacity") (t ".55"))
  ] Nil
].

startWaiting u = [
  JS.If (n "paused") [JS.ReturnVoid] Nil,
  JS.Do (call "clearTimeout" [n "failT"]),
  JS.Do (JS.AssignValue (n "failT") (call "setTimeout" [n "done", n "ms"])),
  JS.If (JS.Binary JS.Or (n "showT") (n "anim")) [JS.ReturnVoid] Nil,
  JS.Do (JS.AssignValue (n "showT") (call "setTimeout" [JS.Function Nil (showPendingVisuals Unit), num 100]))
].

feedbackOnPointerDown u = [
  JS.If (n "paused") [JS.ReturnVoid] Nil,
  JS.Var "b" (JS.Binary JS.And (f (f (n "e") "target") "closest")
    (method (f (n "e") "target") "closest" [t "#lv-root button"])),
  JS.If (n "b") [doMethod (n "b") "animate" [
    JS.Array [
      JS.Object [("transform", t (G.transformCss [G.Scale 100]))],
      JS.Object [("transform", t (G.transformCss [G.Scale 94]))],
      JS.Object [("transform", t (G.transformCss [G.Scale 100]))]
    ],
    JS.Object [("duration", num 160), ("easing", t "ease-out")]
  ]] Nil
].

onClickAction u = [
  JS.Var "b" (JS.Binary JS.And (f (f (n "e") "target") "closest")
    (method (f (n "e") "target") "closest" [t "#lv-root [data-click], #lv-root button[data-sync-now]"])),
  JS.If (n "b") [JS.Do (call "waiting" [n "b", num 2500])] Nil
].

onSyncInput u = [
  JS.If (JS.Binary JS.And (f (f (n "e") "target") "hasAttribute")
    (method (f (n "e") "target") "hasAttribute" [t "data-sync-now"]))
    [JS.Do (call "waiting" [JS.Null, num 1200])] Nil
].

onEnterKey u = [
  JS.If (JS.Binary JS.And
    (JS.Binary JS.And (JS.Binary JS.Equal (f (n "e") "key") (t "Enter")) (f (f (n "e") "target") "hasAttribute"))
    (method (f (n "e") "target") "hasAttribute" [t "data-enter"]))
    [JS.Do (call "waiting" [JS.Null, num 2500])] Nil
].

syncLinkBadge u = [
  JS.Var "up" (JS.Binary JS.Equal (f (n "link") "textContent") (t "live")),
  JS.Do (JS.AssignValue (f (f (n "link") "style") "display")
    (JS.Choose (n "up") (t (G.displayCss G.Hidden)) (t (G.displayCss G.Block)))),
  JS.If (JS.Unary JS.Not (n "up")) [
    JS.Do (JS.Binary JS.And
      (JS.Binary JS.Less (method (f (n "link") "textContent") "indexOf" [t "reconnecting"]) (num 0))
      (JS.AssignValue (f (n "link") "textContent") (t "reconnecting")))
  ] Nil
].

setupFeedback u = [
  JS.Var "root" (method (n "document") "getElementById" [t "lv-root"]),
  JS.Var "paused" (JS.Boolean False),
  JS.Define "theme" ["v"] (readThemeVar Unit),
  JS.Var "bar" (method (method (n "root") "querySelector" [t "[data-pending-bar]"]) "cloneNode" [JS.Boolean True]),
  JS.Var "anim" JS.Null,
  JS.Var "showT" JS.Null,
  JS.Var "failT" JS.Null,
  JS.Var "pulses" (JS.Array Nil),
  JS.Var "faded" JS.Null,
  JS.Do (JS.AssignValue (f (f (n "bar") "style") "display") (t (G.displayCss G.Hidden))),
  doMethod (f (n "document") "body") "appendChild" [n "bar"],
  JS.Define "done" Nil (clearPendingState Unit),
  JS.Define "waiting" ["el", "ms"] (startWaiting Unit),
  doMethod (n "document") "addEventListener" [t "live:frame", n "done"],
  doMethod (n "document") "addEventListener" [t "pointerdown", JS.Function ["e"] (feedbackOnPointerDown Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "click", JS.Function ["e"] (onClickAction Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "input", JS.Function ["e"] (onSyncInput Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "keydown", JS.Function ["e"] (onEnterKey Unit), JS.Boolean True],
  JS.Var "link" (method (method (n "root") "querySelector" [t "[data-pending-link]"]) "cloneNode" [JS.Boolean True]),
  JS.Do (JS.AssignValue (f (n "link") "id") (t "lv-link")),
  JS.Do (JS.AssignValue (f (f (n "link") "style") "display") (t (G.displayCss G.Hidden))),
  doMethod (f (n "document") "body") "appendChild" [n "link"],
  JS.Var "observer" (JS.New (n "MutationObserver") [JS.Function Nil (syncLinkBadge Unit)]),
  JS.Define "observe" Nil [doMethod (n "observer") "observe" [n "link", JS.Object [("childList", JS.Boolean True), ("characterData", JS.Boolean True), ("subtree", JS.Boolean True)]]],
  JS.Do (call "observe" Nil),
  doMethod (n "window") "addEventListener" [t "pagehide", JS.Function Nil [JS.Assign (n "paused") (JS.Boolean True), JS.Do (call "done" Nil), doMethod (n "observer") "disconnect" Nil]],
  doMethod (n "window") "addEventListener" [t "pageshow", JS.Function Nil [JS.Assign (n "paused") (JS.Boolean False), JS.Do (call "observe" Nil), JS.Do (JS.Call (JS.Function Nil (syncLinkBadge Unit)) Nil)]]
].

# the page's day or night, which the feedback it draws follows
feedbackTheme : Bool -> G.Attr .
feedbackTheme light = G.Att "data-theme" (if light then "day" else "night").
feedbackPrototypes palette = G.El "div" [G.utilities [G.Display G.Hidden]]
  [G.El "div" (G.Att "data-pending-bar" "" :: G.utilities [G.Position G.Fixed, G.Top (G.Px 0), G.Left (G.Px 0), G.Height (G.Px 3), G.Width (G.Pct 30), G.ZIndex 60, G.PointerEvents G.PointerNone, G.Radius (G.Px 3), G.Opacity 60, G.Background (G.ThemeColour G.Ink)] :: palette) Nil,
   G.El "span" [G.Att "data-pending-link" "", G.utilities [G.Position G.Fixed, G.Top (G.Px 10), G.Left (G.Pct 50), G.Transform [G.TranslateX (G.Pct (0 - 50))], G.ZIndex 61, G.PaddingY (G.Px 4), G.PaddingX (G.Px 12), G.Radius (G.Px 999), G.FontSize (G.Px 12), G.Background (G.Rgb 58 42 16), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.Rgb 122 90 24), G.Foreground (G.Rgb 255 198 92)]] Nil].

# ---- Browser autocomplete ------------------------------------------------------
# Structured browser autocomplete capability. FP-RISC syntax values are authoritative.
# No foreign source asset or Raw node is read at runtime.


autocomplete u = JS.program [
  JS.Do (JS.Call (JS.Function Nil (setupAutocomplete Unit)) Nil)
].

onSuggestEvent u = [
  JS.Try [JS.Do (JS.AssignValue (n "lists") (method (n "JSON") "parse" [f (n "e") "detail"]))] "x" Nil Nil,
  JS.Do (call "refresh" Nil)
].

inputKind u = [
  JS.Return (JS.Choose (JS.Binary JS.And (n "el") (f (n "el") "getAttribute")) (method (n "el") "getAttribute" [t "data-ac"]) JS.Null)
].

scopedInputValue u = [
  JS.Var "scope" (JS.Binary JS.And (n "cur") (method (n "cur") "closest" [t "[data-ac-scope]"])),
  JS.Var "e" (JS.Binary JS.And (n "scope") (method (n "scope") "querySelector" [JS.Binary JS.Add (JS.Binary JS.Add (t "[data-input=\"") (n "name")) (t "\"]")])),
  JS.Return (JS.Choose (n "e") (f (n "e") "value") (t ""))
].

activePrefix u = [
  JS.Var "v" (f (n "el") "value"),
  JS.Return (method (method (JS.Choose (JS.Binary JS.Equal (call "kind" [n "el"]) (t "tags"))
    (method (n "v") "slice" [JS.Binary JS.Add (method (n "v") "lastIndexOf" [t ","]) (num 1)])
    (n "v")) "trim" Nil) "toLowerCase" Nil)
].

notInHere u = [
  JS.Return (JS.Binary JS.Less (method (n "here") "indexOf" [n "x"]) (num 0))
].

normalizeTag u = [
  JS.Return (method (method (n "t") "trim" Nil) "toLowerCase" Nil)
].

notInHave u = [
  JS.Return (JS.Binary JS.Less (method (n "have") "indexOf" [n "t"]) (num 0))
].

candidatePool u = [
  JS.Var "k" (call "kind" [n "el"]),
  JS.Var "sub" (JS.Binary JS.Or (f (n "lists") "sub") (JS.Object Nil)),
  JS.If (JS.Binary JS.Equal (n "k") (t "loc")) [JS.Return (JS.Binary JS.Or (f (n "lists") "loc") (JS.Array Nil))] Nil,
  JS.If (JS.Binary JS.Equal (n "k") (t "sub")) [
    JS.Var "here" (JS.Binary JS.Or (JS.Index (n "sub") (method (method (call "valueOf" [t "loc"]) "trim" Nil) "toLowerCase" Nil)) (JS.Array Nil)),
    JS.Return (method (n "here") "concat" [method (JS.Binary JS.Or (JS.Index (n "sub") (t "*")) (JS.Array Nil)) "filter" [JS.Function ["x"] (notInHere Unit)]])
  ] Nil,
  JS.If (JS.Binary JS.Equal (n "k") (t "tags")) [
    JS.Var "have" (method (method (method (f (n "el") "value") "split" [t ","]) "slice" [num 0, JS.Unary JS.Minus (num 1)]) "map" [JS.Function ["t"] (normalizeTag Unit)]),
    JS.Return (method (JS.Binary JS.Or (f (n "lists") "tags") (JS.Array Nil)) "filter" [JS.Function ["t"] (notInHave Unit)])
  ] Nil,
  JS.Return (JS.Array Nil)
].

bucketCandidate u = [
  JS.Var "l" (method (n "x") "toLowerCase" Nil),
  JS.If (JS.Binary JS.Equal (n "l") (n "p")) [JS.ReturnVoid] Nil,
  JS.If (JS.Binary JS.Or (JS.Unary JS.Not (n "p")) (JS.Binary JS.Equal (method (n "l") "indexOf" [n "p"]) (num 0)))
    [doMethod (n "a") "push" [n "x"]]
    [JS.If (JS.Binary JS.GreaterEqual (method (n "l") "indexOf" [JS.Binary JS.Add (t " ") (n "p")]) (num 0))
      [doMethod (n "b") "push" [n "x"]]
      [JS.If (JS.Binary JS.GreaterEqual (method (n "l") "indexOf" [n "p"]) (num 0))
        [doMethod (n "c") "push" [n "x"]] Nil]]
].

rankCandidates u = [
  JS.Var "p" (call "part" [n "el"]),
  JS.Var "all" (call "pool" [n "el"]),
  JS.Var "a" (JS.Array Nil),
  JS.Var "b" (JS.Array Nil),
  JS.Var "c" (JS.Array Nil),
  doMethod (n "all") "forEach" [JS.Function ["x"] (bucketCandidate Unit)],
  JS.Return (method (method (n "a") "concat" [n "b", n "c"]) "slice" [num 0, num 6])
].

hidePopup u = [
  JS.Do (JS.AssignValue (f (f (n "box") "style") "display") (t "none")),
  JS.Do (JS.AssignValue (n "opts") (JS.Array Nil))
].

clearBoxAttribute u = [
  JS.If (JS.Binary JS.NotEqual (f (n "a") "name") (t "style")) [doMethod (n "box") "removeAttribute" [f (n "a") "name"]] Nil
].

copyFrameAttribute u = [
  doMethod (n "box") "setAttribute" [f (n "a") "name", f (n "a") "value"]
].

onOptionPointerDown u = [
  doMethod (n "e") "preventDefault" Nil,
  JS.Do (call "take" [n "i"])
].

appendOptionButton u = [
  JS.Var "b" (method (method (n "prototypes") "querySelector" [
    JS.Binary JS.Add (JS.Binary JS.Add (t "[data-ac-option=\"")
      (JS.Choose (JS.Binary JS.Equal (n "i") (n "sel")) (t "selected") (t "normal"))) (t "\"]")
  ]) "cloneNode" [JS.Boolean True]),
  JS.Do (JS.AssignValue (f (n "b") "textContent") (n "o")),
  doMethod (n "b") "addEventListener" [t "pointerdown", JS.Function ["e"] (onOptionPointerDown Unit)],
  doMethod (n "box") "appendChild" [n "b"]
].

refreshPopup u = [
  JS.If (JS.Binary JS.Or (JS.Binary JS.Or (JS.Unary JS.Not (n "cur")) (JS.Unary JS.Not (method (n "document") "contains" [n "cur"])))
    (JS.Binary JS.NotEqual (f (n "document") "activeElement") (n "cur")))
    [JS.Do (call "hide" Nil), JS.ReturnVoid] Nil,
  JS.Var "scope" (method (n "cur") "closest" [t "[data-ac-scope]"]),
  JS.Var "prototypes" (JS.Binary JS.And (n "scope") (method (n "scope") "querySelector" [t "[data-ac-prototypes]"])),
  JS.Var "frame" (JS.Binary JS.And (n "prototypes") (method (n "prototypes") "querySelector" [t "[data-ac-frame]"])),
  JS.If (JS.Unary JS.Not (n "frame")) [JS.Do (call "hide" Nil), JS.ReturnVoid] Nil,
  JS.Do (JS.AssignValue (n "opts") (call "rank" [n "cur"])),
  JS.If (JS.Binary JS.GreaterEqual (n "sel") (f (n "opts") "length")) [JS.Do (JS.AssignValue (n "sel") (num 0))] Nil,
  JS.If (JS.Unary JS.Not (f (n "opts") "length")) [JS.Do (call "hide" Nil), JS.ReturnVoid] Nil,
  doMethod (method (n "Array") "from" [f (n "box") "attributes"]) "forEach" [JS.Function ["a"] (clearBoxAttribute Unit)],
  doMethod (method (n "Array") "from" [f (n "frame") "attributes"]) "forEach" [JS.Function ["a"] (copyFrameAttribute Unit)],
  doMethod (n "box") "setAttribute" [t "data-ac-popup", t ""],
  doMethod (n "box") "replaceChildren" Nil,
  doMethod (n "opts") "forEach" [JS.Function ["o", "i"] (appendOptionButton Unit)],
  JS.Var "hint" (method (method (n "prototypes") "querySelector" [t "[data-ac-hint]"]) "cloneNode" [JS.Boolean True]),
  JS.Do (JS.AssignValue (f (n "hint") "textContent")
    (JS.Choose (f (call "matchMedia" [t "(pointer: coarse)"]) "matches")
      (t "tap the field again for the first")
      (t "tab takes the highlighted one"))),
  doMethod (n "box") "appendChild" [n "hint"],
  JS.Var "r" (method (n "cur") "getBoundingClientRect" Nil),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "left") (JS.Binary JS.Add (JS.Binary JS.Add (f (n "r") "left") (n "scrollX")) (t "px"))),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "top") (JS.Binary JS.Add (JS.Binary JS.Add (JS.Binary JS.Add (f (n "r") "bottom") (n "scrollY")) (num 4)) (t "px"))),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "width") (JS.Binary JS.Add (f (n "r") "width") (t "px"))),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "display") (t "flex"))
].

acceptOption u = [
  JS.Var "o" (JS.Index (n "opts") (n "i")),
  JS.Var "v" (f (n "cur") "value"),
  JS.If (JS.Binary JS.Equal (n "o") (n "undefined")) [JS.ReturnVoid] Nil,
  JS.If (JS.Binary JS.Equal (call "kind" [n "cur"]) (t "tags")) [
    JS.Var "head" (method (method (n "v") "slice" [num 0, JS.Binary JS.Add (method (n "v") "lastIndexOf" [t ","]) (num 1)]) "trim" Nil),
    JS.Do (JS.AssignValue (f (n "cur") "value")
      (JS.Binary JS.Add (JS.Binary JS.Add (JS.Choose (n "head") (JS.Binary JS.Add (n "head") (t " ")) (t "")) (n "o")) (t ", ")))
  ] [
    JS.Do (JS.AssignValue (f (n "cur") "value") (n "o"))
  ],
  JS.Do (JS.AssignValue (n "sel") (num 0)),
  JS.Do (JS.AssignValue (n "moved") (JS.Boolean False)),
  doMethod (n "cur") "dispatchEvent" [JS.New (n "Event") [t "input", JS.Object [("bubbles", JS.Boolean True)]]],
  JS.If (JS.Binary JS.Equal (call "kind" [n "cur"]) (t "tags")) [JS.Do (call "refresh" Nil)] [JS.Do (call "hide" Nil)]
].

onFocusIn u = [
  JS.If (call "kind" [f (n "e") "target"])
    [JS.Do (JS.AssignValue (n "cur") (f (n "e") "target")), JS.Do (JS.AssignValue (n "sel") (num 0)), JS.Do (JS.AssignValue (n "moved") (JS.Boolean False)), JS.Do (call "refresh" Nil)]
    [JS.Do (JS.AssignValue (n "cur") JS.Null), JS.Do (call "hide" Nil)]
].

onFocusOut u = [
  JS.If (JS.Binary JS.Equal (f (n "e") "target") (n "cur")) [JS.Do (call "setTimeout" [n "refresh", num 0])] Nil
].

onInputEdit u = [
  JS.If (JS.Binary JS.Equal (f (n "e") "target") (n "cur"))
    [JS.Do (JS.AssignValue (n "sel") (num 0)), JS.Do (JS.AssignValue (n "moved") (JS.Boolean False)), JS.Do (call "refresh" Nil)] Nil
].

onKeyDown u = [
  JS.If (JS.Binary JS.Or (JS.Binary JS.Or (JS.Unary JS.Not (n "cur")) (JS.Binary JS.NotEqual (f (n "e") "target") (n "cur"))) (JS.Unary JS.Not (f (n "opts") "length")))
    [JS.ReturnVoid] Nil,
  JS.If (JS.Binary JS.Or (JS.Binary JS.Equal (f (n "e") "key") (t "ArrowDown")) (JS.Binary JS.Equal (f (n "e") "key") (t "ArrowUp"))) [
    JS.Do (JS.AssignValue (n "sel") (JS.Binary JS.Modulo
      (JS.Binary JS.Add (n "sel") (JS.Choose (JS.Binary JS.Equal (f (n "e") "key") (t "ArrowDown")) (num 1) (JS.Binary JS.Subtract (f (n "opts") "length") (num 1))))
      (f (n "opts") "length"))),
    JS.Do (JS.AssignValue (n "moved") (JS.Boolean True)),
    doMethod (n "e") "preventDefault" Nil,
    JS.Do (call "refresh" Nil)
  ] [
    JS.If (JS.Binary JS.And (JS.Binary JS.And (JS.Binary JS.Equal (f (n "e") "key") (t "Tab")) (JS.Unary JS.Not (f (n "e") "shiftKey")))
      (JS.Binary JS.Or (call "part" [n "cur"]) (n "moved")))
      [doMethod (n "e") "preventDefault" Nil, JS.Do (call "take" [n "sel"])]
      [JS.If (JS.Binary JS.And (JS.Binary JS.Equal (f (n "e") "key") (t "Enter")) (n "moved"))
        [doMethod (n "e") "preventDefault" Nil, JS.Do (call "take" [n "sel"])]
        [JS.If (JS.Binary JS.Equal (f (n "e") "key") (t "Escape")) [JS.Do (call "hide" Nil)] Nil]]
  ]
].

autocompleteOnPointerDown u = [
  JS.Do (JS.AssignValue (n "touchAgain") (JS.Binary JS.And (JS.Binary JS.And
    (JS.Binary JS.And (JS.Binary JS.NotEqual (f (n "e") "pointerType") (t "mouse")) (call "kind" [f (n "e") "target"]))
    (JS.Binary JS.Equal (f (n "e") "target") (n "cur")))
    (JS.Binary JS.Equal (f (n "document") "activeElement") (n "cur"))))
].

onClickTap u = [
  JS.If (JS.Binary JS.And (JS.Binary JS.And (n "touchAgain") (JS.Binary JS.Equal (f (n "e") "target") (n "cur"))) (f (n "opts") "length"))
    [JS.Do (call "take" [n "sel"])] Nil,
  JS.Do (JS.AssignValue (n "touchAgain") (JS.Boolean False))
].

setupAutocomplete u = [
  JS.Var "lists" (JS.Object [("loc", JS.Array Nil), ("sub", JS.Object Nil), ("tags", JS.Array Nil)]),
  JS.Var "cur" JS.Null,
  JS.Var "opts" (JS.Array Nil),
  JS.Var "sel" (num 0),
  JS.Var "moved" (JS.Boolean False),
  JS.Var "touchAgain" (JS.Boolean False),
  JS.Var "box" (method (n "document") "createElement" [t "div"]),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "display") (t "none")),
  doMethod (f (n "document") "body") "appendChild" [n "box"],
  doMethod (n "document") "addEventListener" [t "live:suggest", JS.Function ["e"] (onSuggestEvent Unit)],
  JS.Define "kind" ["el"] (inputKind Unit),
  JS.Define "valueOf" ["name"] (scopedInputValue Unit),
  JS.Define "part" ["el"] (activePrefix Unit),
  JS.Define "pool" ["el"] (candidatePool Unit),
  JS.Define "rank" ["el"] (rankCandidates Unit),
  JS.Define "hide" Nil (hidePopup Unit),
  JS.Define "refresh" Nil (refreshPopup Unit),
  JS.Define "take" ["i"] (acceptOption Unit),
  doMethod (n "document") "addEventListener" [t "focusin", JS.Function ["e"] (onFocusIn Unit)],
  doMethod (n "document") "addEventListener" [t "focusout", JS.Function ["e"] (onFocusOut Unit)],
  doMethod (n "document") "addEventListener" [t "input", JS.Function ["e"] (onInputEdit Unit)],
  JS.Do (call "addEventListener" [t "resize", n "refresh"]),
  JS.Do (call "addEventListener" [t "scroll", n "refresh", JS.Boolean True]),
  doMethod (n "document") "addEventListener" [t "live:frame", n "refresh"],
  JS.Do (call "addEventListener" [t "pagehide", n "hide"]),
  doMethod (n "document") "addEventListener" [t "keydown", JS.Function ["e"] (onKeyDown Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "pointerdown", JS.Function ["e"] (autocompleteOnPointerDown Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "click", JS.Function ["e"] (onClickTap Unit), JS.Boolean True]
].

# ---- the hooks the script reads -----------------------------------------------------
# the region whose inputs complete (prototypes inside it), and an input that
# completes from the server's list `name` ("tags": a comma-separated list)
autocompleteScope : G.Attr .
autocompleteScope = G.Att "data-ac-scope" "".
autocompleteFrom : String -> G.Attr .
autocompleteFrom name = G.Att "data-ac" name.

# ---- the popup the script clones ---------------------------------------------------
# A frame, an option in its two states (normal, selected) and a hint, in the
# page's theme (`palette`: std/view's theme tokens, as std/appearance gives
# them -- a clone is shown at the body, outside the page's own scope).  They
# are ordinary hidden nodes of the page, so their rules are in its stylesheet:
#   UI.vstackWith ... [Att "data-ac-scope" ""] (Autocomplete.prototypes palette :: kids)
autocompletePrototypes : List G.Attr -> G.Node .
autocompletePrototypes palette = G.El "div" [autocompleteReset, G.Att "data-ac-prototypes" "", G.utilities [G.Display G.Hidden]]
  [ G.El "div" (autocompleteReset :: G.Att "data-ac-frame" "" :: G.Att "role" "listbox" :: G.Att "aria-label" "Suggestions" ::
      G.utilities [G.Position G.Absolute, G.ZIndex 50, G.Display G.Flex, G.FlexWrap G.Wrap,
        G.Gap (G.Px 6), G.Padding (G.Px 8), G.Radius (G.Px 12),
        G.Background (G.ThemeColour G.Card), G.Foreground (G.ThemeColour G.Ink),
        G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour G.Line),
        G.Shadow (G.Px 0) (G.Px 8) (G.Px 24) (G.Px 0) (G.RgbaPercent 0 0 0 18),
        G.FontFamily G.ReadingFont, G.FontSize (G.Px 15), G.LineHeight 155] :: palette) Nil
  , option False, option True
  , G.El "span" [autocompleteReset, G.Att "data-ac-hint" "", G.utilities [G.FontSize (G.Px 11), G.Foreground (G.ThemeColour G.Dim), G.AlignSelf G.AlignCenter]] Nil ].
autocompleteReset = G.utilities [G.BoxSizing G.BorderBox, G.Margin (G.Px 0)].
option selected = G.El "button"
  [G.utilities [G.BoxSizing G.BorderBox, G.Margin (G.Px 0), G.FontFamily G.InheritFont, G.FontSize G.Inherit],
   G.Att "data-ac-option" (if selected then "selected" else "normal"), G.Att "type" "button", G.Att "role" "option",
   G.Att "tabindex" "-1", G.Att "aria-selected" (if selected then "true" else "false"), G.utilities [G.MinHeight (G.Px 34)],
   G.utilities [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder,
     G.BorderColour (G.ThemeColour (if selected then G.Ink else G.Line)), G.Radius (G.Px 999),
     G.PaddingX (G.Px 12), G.PaddingY (G.Px 2), G.FontSize (G.Px 13),
     G.Background (G.ThemeColour (if selected then G.Ink else G.Card)),
     G.Foreground (G.ThemeColour (if selected then G.Bg else G.Dim))],
   G.hover (if selected then Nil else [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)])] Nil.

# ---- Browser media -------------------------------------------------------------
mediaCall callee args = JS.Call callee args.

# Owned browser media. Policy and image presentation are FP-RISC values;
# JavaScript is generated through a syntax tree with no foreign-source escape.
Signal = Type (Selected | Visible | Live).
Rule = Type (Signal Signal | Both Rule Rule | Either Rule Rule | Negate Rule).
Signals = {selected : Bool, visible : Bool, live : Bool}.
Phase = Type (Off | Paused | Connecting | Connected | Failed).
Labels = {off : String, paused : String, connecting : String, connected : String, failed : String}.
Config = {hostAttribute : String, onAttribute : String, statusAttribute : String, rootId : String,
  linkId : String, routePrefix : String, routeSuffix : String, image : G.Node, labels : Labels}.
# The same structured rule is evaluated natively and lowered for the browser.
mediaActive = Both (Signal Selected) (Both (Signal Visible) (Signal Live)).
mediaEvaluate : Signals -> (rule : Rule | measure rule) -> Bool .
mediaEvaluate s rule = case rule of
    Signal Selected -> s.selected | Signal Visible -> s.visible | Signal Live -> s.live
  | Both a b -> mediaEvaluate s a and mediaEvaluate s b
  | Either a b -> mediaEvaluate s a or mediaEvaluate s b
  | Negate a -> not (mediaEvaluate s a).
mediaPhase signals hasSource previous = if not (mediaEvaluate signals mediaActive) then
  if signals.selected then Paused else Off
  else if hasSource then previous else Connecting.
mediaMessage labels mediaPhase = case mediaPhase of Off -> labels.off | Paused -> labels.paused | Connecting -> labels.connecting | Connected -> labels.connected | Failed -> labels.failed.
ruleExpr : (rule : Rule | measure rule) -> JS.Expr .
ruleExpr rule = case rule of
    Signal Selected -> JS.Name "selected" | Signal Visible -> JS.Name "visible" | Signal Live -> JS.Name "live"
  | Both a b -> JS.Binary JS.And (ruleExpr a) (ruleExpr b)
  | Either a b -> JS.Binary JS.Or (ruleExpr a) (ruleExpr b)
  | Negate a -> JS.Unary JS.Not (ruleExpr a).
attr target name = method target "getAttribute" [t name].
removeSource state = doMethod (f state "img") "removeAttribute" [t "src"].
stopSource state = [JS.Do (mediaCall (n "clearTimeout") [f state "retry"]), JS.Assign (f state "retry") JS.Null, removeSource state].
setMessage cfg mediaPhase = JS.Assign (f (n "state") "text") (t (mediaMessage cfg.labels mediaPhase)).
# Hook selectors identify capability targets, never appearance. Escape both
# hook names and values, even though the application's hooks are constants.
mediaSelector name = JS.Binary JS.Add (JS.Binary JS.Add (t "[") (method (n "CSS") "escape" [t name])) (t "]").
imageHtml image = case G.renderStyled image of (ss, ds) ->
  if ds != Nil then error "BrowserMedia.image: expected static presentation" else strJoin "" ss.
Retry = {attribute : String, value : String, delayMs : Int, connected : String, failed : String}.
media cfg = mediaWithRetry {attribute = "data-media-retry", value = "", delayMs = 0, connected = cfg.labels.connected, failed = cfg.labels.failed} cfg.
# Native streams recover with bounded backoff; snapshot labels/cadence remain distinct.
Reconnect = {delayMs : Int, maxDelayMs : Int, failed : String}.
mediaWithRetry retry cfg = mediaWithReconnect retry {delayMs = 0, maxDelayMs = 0, failed = cfg.labels.failed} cfg.
mediaWithReconnect retry reconnect cfg = JS.program [JS.Do (mediaCall (JS.Function Nil (definitions retry reconnect cfg)) Nil)].
baseDelay retry reconnect = JS.Choose (retryEnabled retry) (JS.Number retry.delayMs) (JS.Number reconnect.delayMs).
retryEnabled retry = JS.Binary JS.And (JS.Boolean (retry.delayMs > 0)) (equal (attr (n "host") retry.attribute) (t retry.value)).
definitions retry reconnect cfg =
  [JS.Const "media" (JS.New (n "Map") Nil), JS.Let "sequence" (JS.Number 0), JS.Let "queued" (JS.Boolean False), JS.Let "running" (JS.Boolean True),
   JS.Define "stopMedia" Nil [JS.ForOf "state" (method (n "media") "values" Nil) (stopSource (n "state"))],
   JS.Define "schedule" Nil [JS.If (JS.Binary JS.And (n "running") (neg (n "queued")))
      [JS.Assign (n "queued") (JS.Boolean True), JS.Do (mediaCall (n "queueMicrotask") [n "sync"])] Nil],
   JS.Define "sync" Nil (sync retry reconnect cfg),
   JS.Const "root" (method (n "document") "getElementById" [t cfg.rootId]),
   JS.Const "link" (method (n "document") "getElementById" [t cfg.linkId]),
   JS.Const "treeObserver" (JS.New (n "MutationObserver") [n "schedule"]),
   JS.If (n "root") [doMethod (n "treeObserver") "observe" [n "root", JS.Object [("childList",JS.Boolean True),("subtree",JS.Boolean True),("attributes",JS.Boolean True),("attributeFilter",JS.Array [t cfg.onAttribute])]]] Nil,
   JS.Const "linkObserver" (JS.New (n "MutationObserver") [n "schedule"]),
   JS.If (n "link") [doMethod (n "linkObserver") "observe" [n "link", JS.Object [("childList",JS.Boolean True),("subtree",JS.Boolean True),("characterData",JS.Boolean True)]]] Nil,
   doMethod (n "document") "addEventListener" [t "visibilitychange",n "schedule"],
   doMethod (n "window") "addEventListener" [t "pagehide", JS.Function Nil [JS.Assign (n "running") (JS.Boolean False), JS.Do (mediaCall (n "stopMedia") Nil)]],
   doMethod (n "window") "addEventListener" [t "pageshow", JS.Function ["event"] [JS.If (f (n "event") "persisted") [JS.Assign (n "running") (JS.Boolean True), JS.Do (mediaCall (n "schedule") Nil)] Nil]],
   JS.Do (mediaCall (n "schedule") Nil)].
sync retry reconnect cfg =
  [JS.Assign (n "queued") (JS.Boolean False), JS.If (neg (n "running")) [JS.Return JS.Null] Nil,
   JS.Const "link" (method (n "document") "getElementById" [t cfg.linkId]),
   JS.Const "live" (JS.Binary JS.And (n "link") (equal (f (n "link") "textContent") (t "live"))),
   JS.Const "visible" (neg (f (n "document") "hidden")),
   JS.ForOf "entry" (n "media")
    [JS.Const "host" (JS.Index (n "entry") (JS.Number 0)), JS.Const "state" (JS.Index (n "entry") (JS.Number 1)),
     JS.If (neg (f (n "host") "isConnected")) (L.append (stopSource (n "state")) [doMethod (n "media") "delete" [n "host"]]) Nil],
   JS.ForOf "host" (method (n "document") "querySelectorAll" [mediaSelector cfg.hostAttribute]) (syncHost retry reconnect cfg)].
syncHost retry reconnect cfg =
  [JS.Const "id" (attr (n "host") cfg.hostAttribute), JS.Let "label" JS.Null,
   JS.ForOf "candidate" (method (n "document") "querySelectorAll" [mediaSelector cfg.statusAttribute])
     [JS.If (equal (attr (n "candidate") cfg.statusAttribute) (n "id")) [JS.Assign (n "label") (n "candidate")] Nil],
   JS.Let "state" (method (n "media") "get" [n "host"]),
   JS.If (neg (n "state")) (attach retry reconnect cfg) Nil,
   JS.Const "selected" (equal (attr (n "host") cfg.onAttribute) (t "true")),
   JS.If (neg (ruleExpr mediaActive))
     (L.append (stopSource (n "state")) [JS.Assign (f (n "state") "delay") (baseDelay retry reconnect), JS.Assign (f (n "state") "text") (JS.Choose (n "selected") (t cfg.labels.paused) (t cfg.labels.off))])
     [JS.If (neg (method (f (n "state") "img") "hasAttribute" [t "src"]))
       [setMessage cfg Connecting,
        JS.Assign (n "sequence") (JS.Binary JS.Add (n "sequence") (JS.Number 1)),
        JS.Const "route" (JS.Binary JS.Add (JS.Binary JS.Add (t cfg.routePrefix) (mediaCall (n "encodeURIComponent") [n "id"])) (t cfg.routeSuffix)),
        # A reconnect must open a new response, not reuse a cached/broken image.
        JS.Assign (f (f (n "state") "img") "src")
          (JS.Binary JS.Add (n "route") (JS.Binary JS.Add
            (JS.Choose (method (n "route") "includes" [t "?"]) (t "&") (t "?"))
            (JS.Binary JS.Add (t "_media=") (JS.Binary JS.Add (method (n "Date") "now" Nil)
              (JS.Binary JS.Add (t "-") (n "sequence"))))))] Nil],
   JS.If (JS.Binary JS.And (n "label") (JS.Binary JS.NotEqual (f (n "label") "textContent") (f (n "state") "text")))
     [JS.Assign (f (n "label") "textContent") (f (n "state") "text")] Nil].
attach retry reconnect cfg =
  [JS.Const "shadow" (method (n "host") "attachShadow" [JS.Object [("mode",t "open")]]),
   JS.Assign (f (n "shadow") "innerHTML") (t (imageHtml cfg.image)),
   JS.Const "img" (method (n "shadow") "querySelector" [t "img"]),
   JS.Assign (f (n "img") "alt") (JS.Binary JS.Or (attr (n "host") "aria-label") (t "Camera")),
   JS.Assign (n "state") (JS.Object [("img",n "img"),("text",t cfg.labels.off),("retry",JS.Null),("delay",baseDelay retry reconnect)]),
   JS.Assign (f (n "img") "onload") (JS.Function Nil [JS.Do (mediaCall (n "clearTimeout") [f (n "state") "retry"]), JS.Assign (f (n "state") "retry") JS.Null, JS.Assign (f (n "state") "delay") (baseDelay retry reconnect), JS.Assign (f (n "state") "text")
     (JS.Choose (retryEnabled retry) (t retry.connected) (t cfg.labels.connected)), JS.Do (mediaCall (n "schedule") Nil)]),
   JS.Assign (f (n "img") "onerror") (JS.Function Nil [
     JS.If (JS.Binary JS.And (JS.Binary JS.Or (retryEnabled retry) (JS.Boolean (reconnect.delayMs > 0))) (method (n "img") "hasAttribute" [t "src"]))
       [JS.If (equal (f (n "state") "retry") JS.Null) [
        JS.Assign (f (n "state") "text") (JS.Choose (retryEnabled retry) (t retry.failed) (t reconnect.failed)),
        JS.Assign (f (n "state") "retry") (mediaCall (n "setTimeout") [JS.Function Nil
          (L.append (stopSource (n "state")) [JS.Do (mediaCall (n "schedule") Nil)]), JS.Choose (retryEnabled retry) (JS.Number retry.delayMs) (f (n "state") "delay")]),
        JS.Assign (f (n "state") "delay") (JS.Choose (retryEnabled retry) (JS.Number retry.delayMs)
          (method (n "Math") "min" [JS.Number reconnect.maxDelayMs, JS.Binary JS.Multiply (f (n "state") "delay") (JS.Number 2)]))] Nil]
       [setMessage cfg Failed], JS.Do (mediaCall (n "schedule") Nil)]),
   doMethod (n "media") "set" [n "host",n "state"]].

# ---- Live metrics --------------------------------------------------------------
# Observable Live send-to-next-accepted-frame latency. Policy is FP-RISC
# expression/effect data; BrowserCalc supplies clock/event/timer primitives.
# This is not a correlated server processing time or a network-only RTT.

# Microseconds -> one decimal millisecond, rounding half up. Divisor also
# describes an exact all-time average without first truncating to whole us.
metricsMilliseconds : C.IntExpr -> C.IntExpr -> C.TextExpr .
metricsMilliseconds total divisor =
  tenths = C.Quot (C.Add total (C.Mul divisor (C.Literal 50))) (C.Mul divisor (C.Literal 100));
  C.Concat [C.Decimal (C.Quot tenths (C.Literal 10)), C.Text ".", C.Decimal (C.Rem tenths (C.Literal 10))].
metricsMs n = metricsMilliseconds n (C.Literal 1).
metricsSummary : String -> C.TextExpr .
metricsSummary suffix =
  count = C.Number "count";
  recent = C.Sequence "recent";
  median = C.At (C.Sorted recent) (C.Quot (C.Length recent) (C.Literal 2));
  C.IfText (C.Equal count (C.Literal 0)) (C.Text "no round trips yet")
    (C.Concat [C.Text "last ", metricsMs (C.Number "last"), C.Text " ms, median of the last ",
      C.Decimal (C.Length recent), C.Text " ", metricsMs median, C.Text " ms, avg ",
      metricsMilliseconds (C.Number "sum") count, C.Text " ms, max ", metricsMs (C.Number "max"),
      C.Text " ms, over ", C.Decimal count, C.Text suffix]).
metricsInitial : List Effect .
metricsInitial = [SetNumber "pending" (C.Literal 0), SetNumber "sent" (C.Literal 0),
  SetNumber "last" (C.Literal 0), SetNumber "count" (C.Literal 0),
  SetNumber "sum" (C.Literal 0), SetNumber "max" (C.Literal 0),
  SetSequence "recent" (C.Values Nil)].
metricsSent : List Effect .
metricsSent = [ReadClock "sent", SetNumber "pending" (C.Literal 1)].
metricsReset : List Effect .
metricsReset = [SetNumber "pending" (C.Literal 0)].
metricsFrame : List Effect .
metricsFrame = [When (C.Equal (C.Number "pending") (C.Literal 1))
  [ReadClock "now", SetNumber "pending" (C.Literal 0),
   SetNumber "last" (C.IfInt (C.Less (C.Number "now") (C.Number "sent"))
     (C.Literal 0) (C.Sub (C.Number "now") (C.Number "sent"))),
   SetNumber "count" (C.Add (C.Number "count") (C.Literal 1)),
   SetNumber "sum" (C.Add (C.Number "sum") (C.Number "last")),
   SetNumber "max" (C.IfInt (C.Less (C.Number "max") (C.Number "last")) (C.Number "last") (C.Number "max")),
   SetSequence "recent" (C.TakeLast 32 (C.Snoc (C.Sequence "recent") (C.Number "last")))]].
metrics : Target -> String -> String .
metrics target suffix = program metricsInitial
  [On "live:sent" metricsSent, On "live:frame" metricsFrame,
   On "live:disconnected" metricsReset, OnSuspend metricsReset,
   Every 500 [PutVisibleText target (metricsSummary suffix)]].

# ---- Live reload notice --------------------------------------------------------
# Optional browser MVU reload status. Keep this state in the model, exclude it
# from persistence, project .text, and include view projectedText in the tree.
# Call adopted ONLY after the reload gate and binder succeed for a new hash.
# While pending, an internal Live.Every subscription should call tick.

Notice = {enabled : Bool, durationMs : Int, text : String, untilUs : Int}.
noticeInit : Bool -> Int -> Notice .
noticeInit enabled durationMs = {enabled = enabled, durationMs = (case durationMs > 0 of True -> durationMs | False -> 0), text = "", untilUs = 0}.
noticePending : Notice -> Bool .
noticePending notice = notice.text != "".
noticeAdopted : String -> String -> Notice -> Notice .
noticeAdopted name hash notice = case notice.enabled and notice.durationMs > 0 of
    False -> notice
  | True -> noticeAdoptedAt (Clock.monotonic Unit) (Clock.now Unit) name hash notice.
# Explicit clocks keep formatting and deadline behavior independently testable.
noticeAdoptedAt : Int -> Int -> String -> String -> Notice -> Notice .
noticeAdoptedAt mono utc name hash notice = case notice.enabled and notice.durationMs > 0 of
    False -> notice
  | True -> {notice | text = "Live Reload new {name}#{hash} {Clock.iso utc}",
                     untilUs = mono + notice.durationMs * 1000}.
noticeTick : Notice -> Notice .
noticeTick notice = noticeExpireAt (Clock.monotonic Unit) notice.
noticeExpireAt : Int -> Notice -> Notice .
noticeExpireAt mono notice = case noticePending notice and mono >= notice.untilUs of
    True -> {notice | text = "", untilUs = 0}
  | False -> notice.

# Fixed shape: only the escaped text slot changes on adoption/expiry.
noticeView : String -> G.Node .
noticeView text = G.El "div" [G.Cls "fpr-reload-notice", G.hideEmpty, noticeAppearance, G.Att "role" "status",
  G.Att "aria-live" "polite", G.Att "aria-atomic" "true"] [G.Dyn text].
# The notice owns its appearance; the data hook gives the generated client
# local empty-slot visibility without a stylesheet selector.
noticeAppearance = G.utilities
  [ G.Position G.Fixed, G.Bottom (G.Px 20), G.Left (G.Pct 50)
  , G.Transform [G.TranslateX (G.Pct (0 - 50))], G.ZIndex 10000
  , G.MaxWidth (G.Less (G.Vw 100) (G.Px 40))
  , G.PaddingY (G.Px 12), G.PaddingX (G.Px 18), G.Radius (G.Px 16)
  , G.Background (G.Rgb 23 33 50), G.Foreground (G.Rgb 255 255 255)
  , G.Shadow (G.Px 0) (G.Px 6) (G.Px 24) (G.Px 0) (G.Rgba 0 0 0 68)
  , G.FontSize (G.Px 13), G.LineHeight 150, G.FontFamily G.SystemFont
  , G.WordWrap G.WrapAnywhere, G.PointerEvents G.PointerNone ].
# Compatibility for callers that already pass Notice.styles to cssWith.
noticeStyles : List G.Style .
noticeStyles = Nil.

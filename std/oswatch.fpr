# Internal primitive seam: oswatch. Higher-level modules select only needed facilities.
Os.watchOpen : Unit -> Result Int String .
Os.watchArm  : Int -> List Int -> Unit .
Os.watchTake : Int -> List Int .

watchOpen u = Os.watchOpen u.
watchArm w fds = Os.watchArm w fds.
watchTake w = Os.watchTake w.
# Directional off-hart wait, with a relative kernel timer (-1 means untimed).
# Timer-only expiry raises an IRQ; take then returns Nil. Policy lives above.
Os.watchArmEvents : Int -> List (Int, Int) -> Int -> Result Unit String .
Os.watchTakeEvents : Int -> List (Int, Int) .
watchArmEvents w events us = Os.watchArmEvents w events us.
watchTakeEvents w = Os.watchTakeEvents w.
IO = use "osio".
poll fds = IO.poll fds.

# Unsafe owned handle: stop arm/take first; retry after yielding while False.
# True releases the handle, which must never be used again (IRQ slots reuse).
# This does not unbind an IRQ actor or cancel Poller.await callers.
Os.watchClose : Int -> Bool .
watchClose w = Os.watchClose w.

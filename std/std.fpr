# std/std.fpr — the safe tier, FP-RISC side.  std exists on its own:
# it needs no sol, no QOS — only the frontend.  sol USES std (its view
# is std/std.sol); QOS-targeted programs use it over the Svc funnel.
#
# The defining rule: std contains NO operation whose worst-case
# behavior is unbounded.  Recursion is the explicit-measure/scheme
# kind (`fprc --stdcheck` certifies it), waits are bounded retries
# with a stated equation, and anything reaching core/builtin is
# outside this file by construction.
#
# PoC surface: the bounded recursion scheme, clamp, and the std.net
# retry shape (bounded attempts over a caller-supplied effect step —
# the Struct never touches IO itself, so this module is pure and
# profile-independent).

# the builtin bounded recursion scheme: iteration count = hi - lo + 1;
# --stdcheck uses the once-proven Fold bound rather than re-analyzing.
foldRange : unsafe Int -> Int -> (Int -> p36 -> p36) -> p36 -> p36 .
foldRange lo hi f acc = case lo > hi of
  True -> acc
  | False -> foldRange (lo + 1) hi f (f lo acc).

clampInt : Int -> Int -> Int -> Int.
clampInt lo hi x = case x < lo of
  True -> lo
  | False -> case x > hi of True -> hi | False -> x.

# bounded retry: run step up to n times, stop at first success.
# step : Int -> IoV-ish tagged result via caller convention (0 = retry).
# The WCET equation is n * (w(step) + c) — the uncertainty term is the
# caller's step, the bound is std's.
retryN : unsafe Int -> (Int -> Int) -> Int .
retryN n step = foldRange 1 n (fn i acc -> case acc of
  0 -> step i
  | _ -> acc) 0.

# exponential backoff schedule (pure): attempt i waits base * 2^(i-1),
# capped.  The equation IS the documentation.
backoffMs : (base : Int | base > 0) -> (cap : Int | cap > 0) -> (i : Int | i >= 1) -> Int.
backoffMs base cap i = clampInt 0 cap (base * pow2 (i - 1)).

pow2 : (n : Int | n >= 0) -> Int.
pow2 n = foldRange 1 n (fn i acc -> acc * 2) 1.

Std = Struct {
  fold = fn lo hi f acc -> foldRange lo hi f acc,
  clamp = fn lo hi x -> clampInt lo hi x,
  retry = fn n step -> retryN n step,
  backoff = fn base cap i -> backoffMs base cap i
}.

# Pure publication catalog shared by host and QOS transports.
S = use "std/string".
L = use "std/list".
MV = use "std/mvu".
Candidate = Type (Candidate info path).
parse text name cursor =
  ls = S.lines text;
  checked name cursor ls (L.length ls).
checked name cursor ls count | cursor < 0 or cursor > count =
  Err "watch: publication journal cursor invalid (journal truncated)".
checked name cursor ls count =
  parseRows name (L.drop cursor ls) Nil count.
parseRows : String -> (ls : List String | measure ls) -> List Candidate -> Int -> Result (Int, List Candidate) String .
parseRows name ls acc count = case ls of
    Nil -> Ok (count, L.reverse acc)
  | line :: rest ->
      (case S.split "\t" line of
          n :: version :: from :: to :: path :: Nil ->
            if not (strlen n > 0 and strlen version > 0 and strlen to > 0 and strlen path > 0) then
              Err "watch: malformed publication row"
            else if n == name then
              parseRows name rest (Candidate {name = n, from = from, to = to, version = version} path :: acc) count
            else
              parseRows name rest acc count
        | _ -> Err "watch: malformed publication row").
# Feed these onto MV.eventsPort; the runner delivers them at event boundaries.
event (Candidate info _) = MV.EReload info.
image (Candidate _ path) = path.
identity (Candidate info _) = info.

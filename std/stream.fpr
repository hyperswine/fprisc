# std/stream.fpr -- Stream: bytes in order, from a file or a socket.
#
#   Stream = use "std/stream".
#   case Stream.read 4096 s of
#       Ok "" -> ...                 # the end
#     | Ok bytes -> ...
#     | Err why -> ...
#
# A hart is a thread that MANY actors share, so nothing here waits inside the
# kernel: the primitives answer "again" when there is nothing yet, and these
# functions put the ACTOR to sleep and retry -- other actors keep running.
# The wait backs off from 0.1 ms to 10 ms, and returns to 0.1 ms on progress.
# WAITING ALLOCATES NOTHING (`Os.ready` answers a static Bool), so a session
# that idles for a day is the size it was when it started.
#
# A Stream is a plain value (a descriptor).  You close it; `File.withOpen` and
# `Tcp.serve` do it for you on every path.  A LINEAR handle, which the checker
# would refuse to let you forget, is the intended end state (the design's
# `File.read : Int -> File -> (File, ...)`); this is the usable first cut.

OS = use "osio".
PL = use "poller".
O = use "option".

Stream = Type (Stream Int).

fd : Stream -> Int .
fd s = case s of Stream n -> n.

# ---- reading ---------------------------------------------------------------------
# up to `n` bytes, as soon as there are any; "" at the end of the stream
read : Int -> Stream -> Result String String .
read n s = readGo n (fd s) 100 0.

# the same, but give up after `ms`: Err "timed out"
readWithin : Int -> Int -> Stream -> Result String String .
readWithin ms n s = readGo n (fd s) 100 (Sys.timeUs Unit + ms * 1000).

# deadline 0 = none.  First wait until there is something (no allocation),
# then read it.
readGo : unsafe Int -> Int -> Int -> Int -> Result String String .
readGo n f wait deadline = case OS.ready f of
    True -> (case OS.read f n of
        Ok bytes -> Ok bytes
      | Err why -> (if why == "again" then readGo n f wait deadline else Err why))
  | False -> (if deadline > 0 and Sys.timeUs Unit > deadline then Err "timed out"
      else _ = Sys.sleepUs wait; readGo n f (backoff wait) deadline).

backoff : Int -> Int .
backoff wait = if wait >= 10000 then 10000 else wait * 2.

# everything until the end
readAll : Stream -> Result String String .
readAll s = readAllGo s Nil.
readAllGo : unsafe Stream -> List String -> Result String String .
readAllGo s acc = case read 65536 s of
    Err why -> Err why
  | Ok bytes -> (case strlen bytes == 0 of
        True -> Ok (strJoin "" (rev acc Nil))
      | False -> readAllGo s (bytes :: acc)).

rev : unsafe List a -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# ---- writing ---------------------------------------------------------------------
# ALL of the bytes, however many writes that takes
write : String -> Stream -> Result Unit String .
write bytes s = writeGo bytes (fd s) 100.
writeGo : unsafe String -> Int -> Int -> Result Unit String .
writeGo bytes f wait = case strlen bytes == 0 of
    True -> Ok Unit
  | False -> (case OS.write f bytes of
        Ok took -> writeGo (substr bytes took (strlen bytes - took)) f 100
      | Err why -> (case why == "again" of
            False -> Err why
          | True -> _ = Sys.sleepUs wait; writeGo bytes f (backoff wait))).

close : Stream -> Result Unit String .
close s = OS.close (fd s).

# ---- a Reader: a stream plus the bytes read past what you asked for ----------------
# Protocols are framed by text (a line, a blank line, a length), and a read
# returns whatever arrived.  A Reader keeps the rest, and every operation
# hands back the Reader to go on with.
# (the last part is HOW it waits: None = poll its own descriptor on a timer;
# Some poller = sleep in the mailbox until the poller says so -- see readerOn)
#
# The bytes read past what was asked for are kept as the PIECES the reads
# delivered them in: a head piece with the offset of its first unconsumed
# byte, then the later pieces NEWEST FIRST.  A fill is a cons, and the bytes
# are copied once, into the message they belong to, when it is delivered.
# Concatenating each fill onto one buffer copied the buffer per fill (quadratic
# in the message), and a substr of the remainder per read copied the rest again
# (docs/2026-10-18-LINEAR-STRING-BUILDERS.md).  What is buffered is at most
# one fill past the message, kept whole until the next read moves on.
Reader = Type (Reader Stream String Int (List String) (O.Option PL.Poller)).

reader : Stream -> Reader .
reader s = Reader s "" 0 Nil O.None.

# one read for a Reader, waiting its way.  `deadline` (Sys.timeUs, 0 = none)
# bounds the wait on a plain Reader: Err "timed out".  A Reader on a Poller
# sleeps in its mailbox until the poller says readable, and that sleep has
# no deadline yet; the deadline then bounds nothing (stated, not hidden).
fill : O.Option PL.Poller -> Stream -> Result String String .
fill w s = fillBy 0 w s.
fillBy : Int -> O.Option PL.Poller -> Stream -> Result String String .
fillBy deadline w s = case w of O.None -> readGo 65536 (fd s) 100 deadline | O.Some p -> readOn p 65536 s.

# up to and excluding `sep`; the Reader continues after it.
# Err "closed" when the stream ends first (what was buffered is lost with it).
readUntil : String -> Reader -> (Result String String, Reader) .
readUntil sep r = untilGo sep r (buffered r) 0 0 0.
# the same, within `ms` milliseconds and with the separator inside the first
# `max` bytes: Err "timed out", or Err "no separator within N bytes" (also
# when the separator is there but what precedes it is longer than `max`).
# Without a bound the buffer grows with whatever the peer sends and never ends.
readUntilWithin : Int -> Int -> String -> Reader -> (Result String String, Reader) .
readUntilWithin ms max sep r = untilGo sep r (buffered r) 0 max (Sys.timeUs Unit + ms * 1000).
# `have`: the bytes buffered; `from`: where an occurrence could still start
# (no rescanning what was searched)
untilGo : unsafe String -> Reader -> Int -> Int -> Int -> Int -> (Result String String, Reader) .
untilGo sep r have from max deadline = case r of Reader s head off pieces w ->
  at = findSep sep head off pieces have from;
  (case at < 0 or (max > 0 and at > max) of
      True -> (case max > 0 and (at > max or have >= max) of
          True -> (Err "no separator within {max} bytes", r)
        | False -> (case fillBy deadline w s of
              Err why -> (Err why, r)
            | Ok more -> (case strlen more == 0 of
                  True -> (Err "closed", r)
                | False -> untilGo sep (Reader s head off (more :: pieces) w) (have + strlen more) (keep (have - strlen sep + 1)) max deadline)))
    | False -> (case bufTake at head off pieces of (msg, head2, off2, pieces2) ->
        (case tidy (bufDrop (strlen sep) head2 off2 pieces2) of (head3, off3, pieces3) ->
          (Ok msg, Reader s head3 off3 pieces3 w)))).
keep : Int -> Int .
keep n = case n < 0 of True -> 0 | False -> n.

# ---- the buffered pieces ---------------------------------------------------------
buffered : Reader -> Int .
buffered r = case r of Reader s head off pieces w -> strlen head - off + lensOf pieces 0.
lensOf : unsafe List String -> Int -> Int .
lensOf pieces n = case pieces of Nil -> n | p :: r -> lensOf r (n + strlen p).

# the first n buffered bytes as ONE string (n <= buffered), and what is left:
# the piece the cut falls in stays whole behind its offset
bufTake : unsafe Int -> String -> Int -> List String -> (String, String, Int, List String) .
bufTake n head off pieces = case strlen head - off >= n of
    True -> (slice head off n, head, off + n, pieces)
  | False -> takeGo (n - (strlen head - off)) (rev pieces Nil) (runOf head off Nil).
takeGo : unsafe Int -> List String -> List String -> (String, String, Int, List String) .
takeGo need ps parts = case ps of
    Nil -> (strJoin "" (rev parts Nil), "", 0, Nil)
  | p :: more -> (case strlen p >= need of
        True -> (strJoin "" (rev (slice p 0 need :: parts) Nil), p, need, rev more Nil)
      | False -> takeGo (need - strlen p) more (p :: parts)).
bufDrop : unsafe Int -> String -> Int -> List String -> (String, Int, List String) .
bufDrop n head off pieces = case strlen head - off >= n of
    True -> (head, off + n, pieces)
  | False -> dropGo (n - (strlen head - off)) (rev pieces Nil).
dropGo : unsafe Int -> List String -> (String, Int, List String) .
dropGo need ps = case ps of
    Nil -> ("", 0, Nil)
  | p :: more -> (case strlen p >= need of True -> (p, need, rev more Nil) | False -> dropGo (need - strlen p) more).
# a head consumed to its end, with nothing behind it, is let go
tidy : (String, Int, List String) -> (String, Int, List String) .
tidy b = case b of (head, off, pieces) -> (case off >= strlen head of
    True -> (case pieces of Nil -> ("", 0, Nil) | _ -> b)
  | False -> b).
slice : String -> Int -> Int -> String .
slice s o n = case o == 0 and n == strlen s of True -> s | False -> substr s o n.
runOf : String -> Int -> List String -> List String .
runOf head off acc = case off >= strlen head of True -> acc | False -> substr head off (strlen head - off) :: acc.

# the index in the buffered bytes of the first `sep` starting at or after
# `from`, or -1.  A piece is searched whole; an occurrence that straddles the
# end of a piece is found in a window of its last strlen sep - 1 bytes and the
# first strlen sep - 1 bytes after it.  Only the pieces that end past `from`
# are visited: after a fill that is the fill and the tail of what preceded it.
findSep : unsafe String -> String -> Int -> List String -> Int -> Int -> Int .
findSep sep head off pieces have from = case strlen sep == 0 of
    True -> from
  | False -> scanFrom sep (strlen sep) head off pieces have from Nil.
# newest first through `pieces` collecting (oldest first) those that end past
# `from`; `end` is the index past the piece at hand
scanFrom : unsafe String -> Int -> String -> Int -> List String -> Int -> Int -> List String -> Int .
scanFrom sep lp head off pieces end from acc = case pieces of
    p :: more -> (case end <= from of
        True -> findNext sep lp acc end from
      | False -> scanFrom sep lp head off more (end - strlen p) from (p :: acc))
  | Nil -> (case end <= from of
        True -> findNext sep lp acc end from
      | False -> findIn sep lp head off acc 0 from).
findNext : unsafe String -> Int -> List String -> Int -> Int -> Int .
findNext sep lp rest base from = case rest of Nil -> 0 - 1 | q :: more -> findIn sep lp q 0 more base from.
# `p` from its byte `start` lies at buffered index `base`; `rest` follows, oldest first
findIn : unsafe String -> Int -> String -> Int -> List String -> Int -> Int -> Int .
findIn sep lp p start rest base from =
  end = base + strlen p - start;
  lo = start + (case from > base of True -> from - base | False -> 0);
  i = strIndexFrom sep p lo;
  (case i >= 0 of
      True -> base + i - start
    | False -> (case rest of
        Nil -> 0 - 1
      | _ -> found (straddle sep lp p lo rest) sep lp p start rest base end from)).
found : unsafe Int -> String -> Int -> String -> Int -> List String -> Int -> Int -> Int -> Int .
found at sep lp p start rest base end from | at >= 0 = base + at - start.
found at sep lp p start rest base end from = findNext sep lp rest end from.
# an occurrence starting in p's last lp - 1 bytes (at or after `lo`) and
# continuing into `rest`: its index in p, or -1
straddle : unsafe String -> Int -> String -> Int -> List String -> Int .
straddle sep lp p lo rest =
  g0 = (case lo > strlen p - lp + 1 of True -> lo | False -> strlen p - lp + 1);
  tail = strlen p - g0;
  (case tail <= 0 of
      True -> 0 - 1
    | False ->
        j = strIndexOf sep (strcat (substr p g0 tail) (prefixOf (lp - 1) rest Nil));
        (case j >= 0 and j < tail of True -> g0 + j | False -> 0 - 1)).
# the first n bytes of the pieces (oldest first), or all of them
prefixOf : unsafe Int -> List String -> List String -> String .
prefixOf n ps acc = case ps of
    Nil -> strJoin "" (rev acc Nil)
  | q :: more -> (case strlen q >= n of
        True -> strJoin "" (rev (substr q 0 n :: acc) Nil)
      | False -> prefixOf (n - strlen q) more (q :: acc)).

# one line without its "\n" (or "\r\n")
readLine : Reader -> (Result String String, Reader) .
readLine r = case readUntil "\n" r of (res, r2) ->
  (case res of
      Ok l -> (Ok (case strlen l > 0 and charAt l (strlen l - 1) == 13 of True -> substr l 0 (strlen l - 1) | False -> l), r2)
    | Err e -> (Err e, r2)).

# exactly `n` bytes
readExactly : Int -> Reader -> (Result String String, Reader) .
readExactly n r = exactGo (keep n) r (buffered r) 0.
# the same within `ms` milliseconds (Err "timed out"; see fill for a Poller)
readExactlyWithin : Int -> Int -> Reader -> (Result String String, Reader) .
readExactlyWithin ms n r = exactGo (keep n) r (buffered r) (Sys.timeUs Unit + ms * 1000).
exactGo : unsafe Int -> Reader -> Int -> Int -> (Result String String, Reader) .
exactGo n r have deadline = case r of Reader s head off pieces w ->
  (case have >= n of
      True -> (case bufTake n head off pieces of (msg, head2, off2, pieces2) ->
          (case tidy (head2, off2, pieces2) of (head3, off3, pieces3) -> (Ok msg, Reader s head3 off3 pieces3 w)))
    | False -> (case fillBy deadline w s of
          Err why -> (Err why, r)
        | Ok more -> (case strlen more == 0 of
              True -> (Err "closed", r)
            | False -> exactGo n (Reader s head off (more :: pieces) w) (have + strlen more) deadline))).

# what is buffered plus everything until the end
readRest : Reader -> Result String String .
readRest r = case r of Reader s head off pieces _ ->
  (case readAll s of Ok more -> Ok (strJoin "" (runOf head off (rev (more :: pieces) Nil))) | Err e -> Err e).

# ---- waiting on a Poller instead of polling -----------------------------------------------------
# The functions above wait by polling their own descriptor on a timer, which is
# fine for a program with a few streams.  A SERVER hands its streams a Poller
# (std/poller.fpr): the waiting actor then sleeps in its mailbox, and one actor
# polls for everybody.

readOn : PL.Poller -> Int -> Stream -> Result String String .
readOn p n s = readOnGo p n (fd s).
readOnGo : unsafe PL.Poller -> Int -> Int -> Result String String .
readOnGo p n f =
  case PL.awaitResult f p of
    Err why -> Err why
  | Ok _ -> (case OS.read f n of
      Ok bytes -> Ok bytes
    | Err why -> (if why == "again" then readOnGo p n f else Err why)).

# a Reader whose waits go through a Poller: `readUntil`, `readLine`,
# `readExactly` and `readRest` work on it unchanged
readerOn : PL.Poller -> Stream -> Reader .
readerOn p s = Reader s "" 0 Nil (O.Some p).

# std/glob.fpr -- Safe wildcard (`*`, `?`) and ignore-rule path matching.
#
#   Glob = use "std/glob".
#   Glob.match "*.fpr" "main.fpr"                   -- True
#   Glob.matchesPattern "docs/*.md" "docs/a.md"     -- True
#   Glob.matchesPattern "build/" "sub/build/out.o"  -- True
#
# Wildcard matching uses the linear-space star-bookmark algorithm (no
# exponential backtracking on repeated `*`). Ignore rules follow .qrepoignore
# conventions: a bare pattern matches any path component at any depth; a
# pattern with a leading or internal `/` is anchored at the root; a trailing
# `/` is accepted. Every function is total and 100% safe.

L = use "list".
S = use "string".

Rule = { anchored : Bool, parts : List String }.

# ---- single-component wildcard matching (* and ?) ---------------------------------

match : String -> String -> Bool .
match pat name =
  pn = strlen pat;
  sn = strlen name;
  fuel = (pn + 1) * (sn + 1) + pn + 1;
  matchGo pat pn name sn 0 0 (0 - 1) 0 fuel.

matchGo : String -> Int -> String -> Int -> Int -> Int -> Int -> Int -> (fuel : Int | measure fuel) -> Bool .
matchGo pat pn name sn pi si starPi starSi fuel =
  if fuel <= 0 then False
  else if si < sn and pi < pn and (charAt pat pi == 63 or charAt pat pi == charAt name si) then
    matchGo pat pn name sn (pi + 1) (si + 1) starPi starSi (fuel - 1)
  else if pi < pn and charAt pat pi == 42 then
    matchGo pat pn name sn (pi + 1) si pi si (fuel - 1)
  else if si < sn and starPi >= 0 then
    matchGo pat pn name sn (starPi + 1) (starSi + 1) starPi (starSi + 1) (fuel - 1)
  else if si == sn then
    allStars pat pn pi (pn - pi)
  else
    False.

allStars : String -> Int -> Int -> (rem : Int | measure rem) -> Bool .
allStars pat pn pi rem =
  if rem <= 0 then True
  else if pi >= pn then True
  else charAt pat pi == 42 and allStars pat pn (pi + 1) (rem - 1).

# ---- path and ignore rules --------------------------------------------------------

parseRule : String -> Rule .
parseRule rule =
  bare = if S.endsWith "/" rule then S.dropRight 1 rule else rule;
  anchored = S.startsWith "/" bare or S.contains "/" bare;
  trimmed = if S.startsWith "/" bare then S.dropLeft 1 bare else bare;
  { anchored = anchored, parts = S.split "/" trimmed }.

validRule : String -> Bool .
validRule rule =
  r = parseRule rule;
  not (L.isEmpty r.parts)
  and L.all (fn x -> x != "" and x != "." and x != ".." and not (S.contains (chr 0) x)) r.parts.

prefixMatch : (pats : List String | measure pats) -> List String -> Bool .
prefixMatch pats comps = case pats of
    Nil -> True
  | p :: ps -> case comps of
      Nil -> False
    | c :: cs -> match p c and prefixMatch ps cs.

matchesRule : Rule -> String -> Bool .
matchesRule r path =
  comps = S.split "/" path;
  if r.anchored then prefixMatch r.parts comps
  else case r.parts of
      [one] -> L.any (match one) comps
    | _ -> False.

matchesPattern : String -> String -> Bool .
matchesPattern pat path = matchesRule (parseRule pat) path.

matchesAny : List Rule -> String -> Bool .
matchesAny rules path = L.any (fn r -> matchesRule r path) rules.

# Parse newline-separated ignore rules (ignoring blank lines and `#` comments).
parseRules : String -> List Rule .
parseRules text =
  text
  |> S.split "\n"
  |> L.map S.trim
  |> L.filter (fn x -> x != "" and not (S.startsWith "#" x))
  |> L.map parseRule.

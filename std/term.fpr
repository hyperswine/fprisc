# std/term.fpr -- Term: a terminal application, the same shape as a web one.
#
#   Term.run { init, update, view, subs }
#
#     init    : model
#     update  : Term.Ev msg -> model -> (model, List (Term.Cmd msg))
#     view    : (Int, Int) -> model -> List String     the screen, a line each,
#                                                      for a terminal that size
#     subs    : model -> List (Term.Sub msg)
#
# It is std/live's loop with a terminal where the browser was: `update` is a pure
# function of events, effects are data (After, Run, Quit; Every), and the driver
# owns the device.  A KEY is an event the way a click is:
#
#   Term.Key (Term.Char "é")   text, a whole UTF-8 character at a time
#   Term.Key Term.Enter | Escape | Backspace | Tab | BackTab | Up | Down | Left | Right
#          | Home | End | PageUp | PageDown | Insert | Delete | (F 5) | (Ctrl "c") | (Alt "x")
#   Term.Resized cols rows     at the start, and whenever the window changes
#   Term.Msg msg               what a command or a subscription produced
#
# ^C is a key (`Ctrl "c"`): the program decides what it means.  The terminal is
# put back -- raw mode off, the main screen, the cursor -- however the program
# ends, including a panic or a signal.
#
# The decoder is FP-RISC (`decode`, pure: bytes in, keys and the unfinished tail
# out) and the screen is repainted a LINE at a time, only the lines that changed.
# The machine gives two things: raw mode and the window's size (machine/posix/os_term.c).

OS = use "os".
S = use "string".
O = use "option".
A = use "actor".

Key = Type (Char String | Enter | Escape | Backspace | Tab | BackTab | Up | Down | Left | Right
          | Home | End | PageUp | PageDown | Insert | Delete | F Int | Ctrl String | Alt String).

Ev msg = Type (Key Key | Resized Int Int | Msg msg).
Cmd msg = Type (After Int msg | Run (Unit -> msg) | Quit).
Sub msg = Type (Every Int msg).

rev : unsafe List a -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# ---- the screen ------------------------------------------------------------------------
esc = chr 27.
clear = "{esc}[2J{esc}[H".
hideCursor = "{esc}[?25l".
showCursor = "{esc}[?25h".
altScreen = "{esc}[?1049h".
mainScreen = "{esc}[?1049l".
reset = "{esc}[0m".
bold s = "{esc}[1m{s}{esc}[0m".
dim s = "{esc}[2m{s}{esc}[0m".
inverse s = "{esc}[7m{s}{esc}[0m".
# 0 black 1 red 2 green 3 yellow 4 blue 5 magenta 6 cyan 7 white
color : Int -> String -> String .
color c s = "{esc}[3{c}m{s}{esc}[0m".

# row and column from 1
moveTo : Int -> Int -> String .
moveTo row col = "{esc}[{row};{col}H".

# ---- decoding keys (pure) --------------------------------------------------------------------
# the keys in `bytes`, and the tail that is not a whole key yet (an escape
# sequence or a UTF-8 character split across reads).  `final`: no more bytes are
# coming right now, so a lone ESC is the Escape key and not a sequence's start.
decode : Bool -> String -> (List Key, String) .
decode final bytes = decodeGo final bytes 1 Nil.

decodeGo : unsafe Bool -> String -> Int -> List Key -> (List Key, String) .
decodeGo final s i acc = if i > strlen s then (rev acc Nil, "") else
  (case keyAt final s i of
      O.None -> (rev acc Nil, substr s i (strlen s))
    | O.Some (k, next) -> decodeGo final s next (k :: acc)).

# one key at i and where the next begins; None: incomplete
keyAt : Bool -> String -> Int -> O.Option (Key, Int) .
keyAt final s i =
  c = charAt s i;
  n = strlen s;
  if c == 27 then escapeAt final s i n
  else if c == 13 or c == 10 then O.Some (Enter, i + 1)
  else if c == 9 then O.Some (Tab, i + 1)
  else if c == 127 or c == 8 then O.Some (Backspace, i + 1)
  else if c == 0 then O.Some (Ctrl " ", i + 1)
  else if c < 32 then O.Some (Ctrl (chr (c + 96)), i + 1)
  else if c < 128 then O.Some (Char (chr c), i + 1)
  else utf8At s i n (if c >= 240 then 4 else if c >= 224 then 3 else if c >= 192 then 2 else 1).

# a whole UTF-8 character, however many bytes it is
utf8At : String -> Int -> Int -> Int -> O.Option (Key, Int) .
utf8At s i n len = if i + len - 1 > n then O.None else O.Some (Char (substr s i len), i + len).

escapeAt : Bool -> String -> Int -> Int -> O.Option (Key, Int) .
escapeAt final s i n =
  if i == n then (if final then O.Some (Escape, i + 1) else O.None)
  else if charAt s (i + 1) == 91 then csiAt s (i + 2) (i + 2) n
  else if charAt s (i + 1) == 79 then (if i + 2 > n then O.None else O.Some (letterKey (charAt s (i + 2)) 0, i + 3))
  else if charAt s (i + 1) == 27 then O.Some (Escape, i + 1)
  else (case keyAt final s (i + 1) of
      O.Some (Char t, next) -> O.Some (Alt t, next)
    | O.Some (_, next) -> O.Some (Escape, i + 1)
    | O.None -> O.None).

# ESC [ params final : find the final byte (0x40..0x7e), then name the key
csiAt : unsafe String -> Int -> Int -> Int -> O.Option (Key, Int) .
csiAt s from j n = if j > n then O.None
  else if charAt s j >= 64 and charAt s j <= 126 then O.Some (csiKey (charAt s j) (firstNumber s from j 0), j + 1)
  else csiAt s from (j + 1) n.

firstNumber : unsafe String -> Int -> Int -> Int -> Int .
firstNumber s i j acc = if i >= j or not (S.isDigit (charAt s i)) then acc else firstNumber s (i + 1) j (acc * 10 + (charAt s i - 48)).

csiKey : Int -> Int -> Key .
csiKey final num = if final == 126 then tildeKey num else if final == 90 then BackTab else letterKey final num.

letterKey : Int -> Int -> Key .
letterKey c num =
  if c == 65 then Up else if c == 66 then Down else if c == 67 then Right else if c == 68 then Left
  else if c == 72 then Home else if c == 70 then End
  else if c >= 80 and c <= 83 then F (c - 79)
  else Escape.

tildeKey : Int -> Key .
tildeKey n =
  if n == 1 or n == 7 then Home else if n == 4 or n == 8 then End
  else if n == 2 then Insert else if n == 3 then Delete else if n == 5 then PageUp else if n == 6 then PageDown
  else if n >= 11 and n <= 15 then F (n - 10) else if n >= 17 and n <= 21 then F (n - 11)
  else if n == 23 then F 11 else if n == 24 then F 12 else Escape.

# ---- the loop ----------------------------------------------------------------------------------
# state: the model, the screen as last painted, the window, undecoded input
St = Type (St model screen cols rows pending).

run app = case OS.ttyRaw True of
    Err why -> _ = Sys.stderr "term: {why}\n"; 1
  | Ok _ ->
      me = myself 0;
      _ = OS.write 1 (strJoin "" (altScreen :: hideCursor :: clear :: Nil));
      size = OS.ttySize Unit;
      _ = startSubs me (app.subs app.init) Nil;
      code = (case size of (cols, rows) -> loop me app (step me app (Resized cols rows) (St app.init Nil cols rows "")) 100);
      _ = OS.write 1 (strJoin "" (showCursor :: mainScreen :: Nil));
      _ = OS.ttyRaw False;
      code.

# one turn: keys, then messages, then a look at the window's size; sleep when
# nothing happened (0.2 ms backing off to 20 ms; a quiet turn allocates nothing)
#
# `app` is spelled out rather than left as a bare variable: these two
# recursive helpers reach into it (through `step`) for update, subs and
# view, so a signature that said `a` would promise to accept anything and
# then project three fields out of it.  The open tail `| r` is what lets a
# caller's record carry `init` as well.
loop : unsafe Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), subs : model -> List (Sub msg), view : (Int, Int) -> model -> List String | r } -> O.Option St -> Int -> Int .
loop me app st0 wait = case st0 of
    O.None -> 0
  | O.Some st -> (if OS.ready 0 then loop me app (keys me app st) 200
      else (case receiveNow me of
          Ok m -> _ = drop m; loop me app (message me app st m) 200
        | Err _ -> (case st of St model screen cols rows pending ->
            (case OS.ttySize Unit of (c2, r2) ->
                (if c2 != cols or r2 != rows then loop me app (step me app (Resized c2 r2) (St model Nil c2 r2 pending)) 200
                 else if strlen pending > 0 then loop me app (flushPending me app st) 200
                 else _ = Sys.sleepUs wait; loop me app st0 (if wait >= 20000 then 20000 else wait * 2)))))).

message me app st m = case m of Ok msg -> step me app (Msg msg) st | Err _ -> O.Some st.

# what was read, decoded; a lone ESC waits one quiet turn (flushPending) to be sure
keys me app st = case st of St model screen cols rows pending ->
  (case OS.read 0 4096 of
      Err _ -> O.Some st
    | Ok bytes -> (if strlen bytes == 0 then O.None
        else (case decode False (strcat pending bytes) of (ks, rest) -> feed me app ks (St model screen cols rows rest)))).

flushPending me app st = case st of St model screen cols rows pending ->
  (case decode True pending of (ks, rest) -> feed me app ks (St model screen cols rows "")).

feed : unsafe Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), subs : model -> List (Sub msg), view : (Int, Int) -> model -> List String | r } -> List Key -> St -> O.Option St .
feed me app ks st = case ks of
    Nil -> O.Some st
  | k :: r -> (case step me app (Key k) st of O.None -> O.None | O.Some st2 -> feed me app r st2).

# one update, its effects, and the repaint.  None = Quit.
step me app ev st = case st of St model screen cols rows pending ->
  (case app.update ev model of (model2, cmds) ->
      quit = perform me cmds;
      _ = startSubs me (app.subs model2) (app.subs model);
      lines = app.view (cols, rows) model2;
      _ = paint screen lines 1 rows Nil;
      (if quit then O.None else O.Some (St model2 lines cols rows pending))).

perform : unsafe Int -> List (Cmd msg) -> Bool .
perform me cmds = case cmds of
    Nil -> False
  | c :: r -> (case c of
        Quit -> _ = perform me r; True
      | After ms msg -> _ = spawn (fn self -> _ = Sys.sleepUs (ms * 1000); A.sendSure self me (Ok msg)); perform me r
      | Run work -> _ = spawn (fn self -> A.sendSure self me (Ok (work Unit))); perform me r).

# a ticker per NEW subscription: it sends its message every ms (the loop has no
# way to stop one yet, so an app's `subs` should be steady, or ignore stale ticks)
startSubs : unsafe Int -> List (Sub msg) -> List (Sub msg) -> Unit .
startSubs me subs old = case subs of
    Nil -> Unit
  | Every ms msg :: r -> (if member ms msg old then startSubs me r old
      else _ = spawn (fn self -> ticking me ms msg); startSubs me r old).
member : unsafe Int -> msg -> List (Sub msg) -> Bool .
member ms msg subs = case subs of Nil -> False | Every m x :: r -> (if m == ms and x == msg then True else member ms msg r).
ticking : unsafe Int -> Int -> msg -> Unit .
ticking me ms msg = _ = Sys.sleepUs (ms * 1000); _ = send me (Ok msg); ticking me ms msg.

# repaint only the lines that differ from what is on the screen; lines past the
# view's end are cleared
paint : unsafe List String -> List String -> Int -> Int -> List String -> Unit .
paint old new row rows acc = if row > rows then flush acc else
  (case new of
      Nil -> (case old of
          Nil -> flush acc
        | _ :: orest -> paint orest Nil (row + 1) rows (strJoin "" (moveTo row 1 :: esc :: "[2K" :: Nil) :: acc))
    | n :: nrest -> (case old of
          Nil -> paint Nil nrest (row + 1) rows (strJoin "" (moveTo row 1 :: esc :: "[2K" :: n :: Nil) :: acc)
        | o :: orest -> (if o == n then paint orest nrest (row + 1) rows acc
                         else paint orest nrest (row + 1) rows (strJoin "" (moveTo row 1 :: esc :: "[2K" :: n :: Nil) :: acc)))).
flush : List String -> Unit .
flush acc = case acc of Nil -> Unit | _ -> _ = OS.write 1 (strJoin "" (rev acc Nil)); Unit.

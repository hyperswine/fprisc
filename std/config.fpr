# std/config.fpr -- Config: defaults, a file, the environment and the command
# line, combined in that order (ExtBase).
#
#   Config = use "std/config".
#   settings = Config.load { defaults = Json.object (("port", Json.Integer 8080) :: Nil),
#                            file = Option.Some "service.json", envPrefix = "SVC_",
#                            args = Program.args Unit }
#              |> Result.andThen (Decode.run settingsDecoder)
#
# Each later source overrides the earlier, key by key (top-level keys):
#   defaults  <  the JSON file  <  PREFIX_NAME in the environment  <  --name=value
# A missing file is fine (that is what defaults are for); a file that is there
# and is not a JSON object is an Err.  Environment and argument values are
# strings, typed as they LOOK (Decode.infer): 8080 is an integer, true a boolean.
# `--flag` alone is true.  Arguments that do not start with "--" are left for
# you (Config.positional).

J = use "json".
M = use "map".
O = use "option".
S = use "string".
D = use "decode".
F = use "file".

rev : (xs : List a | measure xs) -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

load : { defaults : J.Value, file : O.Option String, envPrefix : String, args : List String } -> Result J.Value String .
load c = case fileLayer c.file of
    Err why -> Err why
  | Ok fromFile ->
      base = (case c.defaults of J.Object m -> m | _ -> M.empty S.compare);
      merged = M.union fromFile base;
      keys = M.keys merged;
      Ok (J.Object (argLayer c.args (envLayer c.envPrefix keys merged))).

fileLayer : O.Option String -> Result (M.Map String J.Value) String .
fileLayer O.None = Ok (M.empty S.compare).
fileLayer (O.Some path) | not (F.exists path) = Ok (M.empty S.compare).
fileLayer (O.Some path) = case F.readText path of
    Err why -> Err "{path}: {why}"
  | Ok text -> (case J.parse text of
        Err why -> Err "{path}: {why}"
      | Ok (J.Object m) -> Ok m
      | Ok _ -> Err "{path}: expected a JSON object").

# only KNOWN keys are looked up in the environment (PREFIX + the key in capitals,
# "-" and "." as "_"): there is no portable way to list it, and no surprise
# settings can arrive by it
envLayer : String -> List String -> M.Map String J.Value -> M.Map String J.Value .
envLayer prefix keys m = envGo prefix keys m.
envGo : String -> (keys : List String | measure keys) -> M.Map String J.Value -> M.Map String J.Value .
envGo prefix keys m = case keys of
    Nil -> m
  | k :: r -> (case Sys.env (strcat prefix (envName k)) of
        Ok v -> envGo prefix r (M.insert k (D.infer v) m)
      | Err _ -> envGo prefix r m).
envName : String -> String .
envName k = k |> S.replace "-" "_" |> S.replace "." "_" |> S.toUpper.

argLayer : List String -> M.Map String J.Value -> M.Map String J.Value .
argLayer args m = argGo args m.
argGo : (args : List String | measure args) -> M.Map String J.Value -> M.Map String J.Value .
argGo args m = case args of
    Nil -> m
  | a :: r ->
      if not (S.startsWith "--" a and strlen a > 2) then argGo r m
      else
        body = S.dropLeft 2 a;
        at = strIndexOf "=" body;
        if at < 0 then argGo r (M.insert body (J.Boolean True) m)
        else argGo r (M.insert (S.left at body) (D.infer (S.dropLeft (at + 1) body)) m).

# the arguments that are not "--" settings, in order
positional : List String -> List String .
positional args = posGo args Nil.
posGo : (args : List String | measure args) -> List String -> List String .
posGo args acc = case args of
    Nil -> rev acc Nil
  | a :: r -> if S.startsWith "--" a then posGo r acc else posGo r (a :: acc).

# std/path.fpr -- Path: file names as text, taken apart and put together.
#
#   Path = use "std/path".
#   Path.join dir (Path.withExtension "html" (Path.fileName src))
#
# Pure string work: nothing here touches the file system, so it behaves the
# same everywhere.  "/" separates; a Path is just a String.

S = use "string".
O = use "option".

rev : (xs : List a | measure xs) -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

isAbsolute : String -> Bool .
isAbsolute p = S.startsWith "/" p.

# Path.join "a/b" "c" = "a/b/c"; an absolute second part wins, as `cd` would
join : String -> String -> String .
join a b | isAbsolute b = b.
join a b | strlen a == 0 = b.
join a b | S.endsWith "/" a = strcat a b.
join a b = "{a}/{b}".

joinAll : List String -> String .
joinAll parts = joinGo parts "".
joinGo : (parts : List String | measure parts) -> String -> String .
joinGo parts acc = case parts of Nil -> acc | p :: r -> joinGo r (join acc p).

# where the last "/" is (0-based), or -1
lastSlash : String -> Int .
lastSlash p = lastSlashGo p (strlen p - 1).
lastSlashGo : String -> (i : Int | measure i) -> Int .
lastSlashGo p i | i < 0 = 0 - 1.
lastSlashGo p i | charAt p i == 47 = i.
lastSlashGo p i = lastSlashGo p (i - 1).

# "a/b/c.txt" -> "c.txt"
fileName : String -> String .
fileName p = S.dropLeft (lastSlash p + 1) p.

# "a/b/c.txt" -> "a/b";  "c.txt" -> ".";  "/c" -> "/"
parent : String -> String .
parent p =
  at = lastSlash p;
  if at < 0 then "." else if at == 0 then "/" else S.left at p.

# where the extension's "." is within the FILE NAME (0-based), or -1 (a leading dot is a
# hidden file, not an extension: ".bashrc" has none)
extDot : String -> Int .
extDot name = extDotGo name (strlen name - 1).
extDotGo : String -> (i : Int | measure i) -> Int .
extDotGo name i | i <= 0 = 0 - 1.
extDotGo name i | charAt name i == 46 = i.
extDotGo name i = extDotGo name (i - 1).

# "c.tar.gz" -> Some "gz"; "Makefile" -> None
extension : String -> O.Option String .
extension p =
  name = fileName p;
  at = extDot name;
  if at < 0 then O.None else O.Some (S.dropLeft (at + 1) name).

# the file name without its extension: "a/b/c.txt" -> "c"
stem : String -> String .
stem p =
  name = fileName p;
  at = extDot name;
  if at < 0 then name else S.left at name.

# Path.withExtension "md" "notes/a.txt" = "notes/a.md"
withExtension : String -> String -> String .
withExtension ext p =
  dir = parent p;
  name = "{stem p}.{ext}";
  if lastSlash p < 0 then name else join dir name.

# the parts between slashes, empty ones dropped
parts : String -> List String .
parts p = partsGo (S.split "/" p) Nil.
partsGo : (ps : List String | measure ps) -> List String -> List String .
partsGo ps acc = case ps of
    Nil -> rev acc Nil
  | x :: r -> if strlen x == 0 then partsGo r acc else partsGo r (x :: acc).

# "." and empty parts dropped, "x/.." folded: "a/./b/../c" -> "a/c"
normalize : String -> String .
normalize p =
  body = strJoin "/" (rev (normGo (isAbsolute p) (parts p) Nil) Nil);
  if isAbsolute p then "/{body}"
  else if strlen body == 0 then "."
  else body.
# the kept parts, newest first.  ".." above the root of an ABSOLUTE path is
# the root; above a relative path it has to be kept.
normGo : Bool -> (ps : List String | measure ps) -> List String -> List String .
normGo abs ps acc = case ps of
    Nil -> acc
  | x :: r ->
      if x == "." then normGo abs r acc
      else if x == ".." then
        (case acc of
            Nil -> if abs then normGo abs r acc else normGo abs r (x :: acc)
          | top :: under -> if top == ".." then normGo abs r (x :: acc) else normGo abs r under)
      else normGo abs r (x :: acc).

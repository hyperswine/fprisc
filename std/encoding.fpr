# std/encoding.fpr -- Encoding: bytes as text, and back (ExtBase).
#
#   Encoding = use "std/encoding".
#   Encoding.hex bytes            Encoding.base64 bytes        Encoding.url "a b&c"
#
# Encoders cannot fail.  Decoders answer a Result that says where the input
# stopped being what it claimed (a 0-based byte position, as every position is).
# A String is bytes, so these work on any data.

S = use "string".

rev : (xs : List a | measure xs) -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# ---- hexadecimal (lower-case) --------------------------------------------------------
hexDigit : Int -> String .
hexDigit d = chr (if d < 10 then 48 + d else 87 + d).

hex : String -> String .
hex s = strJoin "" (hexGo s (strlen s - 1) Nil).
hexGo : String -> (i : Int | measure i) -> List String -> List String .
hexGo s i acc | i < 0 = acc.
hexGo s i acc = hexGo s (i - 1) (hexDigit (charAt s i / 16) :: hexDigit (band (charAt s i) 15) :: acc).

# 0..15, or -1
hexVal : Int -> Int
  | work hexVal <= 20 | alloc hexVal <= 48 .
hexVal c | c >= 48 and c <= 57 = c - 48.
hexVal c | c >= 97 and c <= 102 = c - 87.
hexVal c | c >= 65 and c <= 70 = c - 55.
hexVal _ = 0 - 1.

fromHex : String -> Result String String .
fromHex t | band (strlen t) 1 == 1 = Err "hex: an odd number of digits".
fromHex t = fromHexGo t 0 (strlen t) Nil.
fromHexGo : String -> (i : Int | measure (n - i)) -> (n : Int) -> List String -> Result String String .
fromHexGo t i n acc | i >= n = Ok (strJoin "" (rev acc Nil)).
fromHexGo t i n acc =
  hi = hexVal (charAt t i);
  lo = hexVal (charAt t (i + 1));
  if hi < 0 or lo < 0 then Err "hex: not a digit at position {i}"
  else fromHexGo t (i + 2) n (chr (hi * 16 + lo) :: acc).

# an Int as at least `width` hex digits
hexInt : Int -> Int -> String .
hexInt width n = S.padLeft width "0" (strJoin "" (hexIntGo 64 n Nil)).
hexIntGo : (fuel : Int | measure fuel) -> Int -> List String -> List String .
hexIntGo fuel n acc | fuel <= 0 = hexDigit n :: acc.
hexIntGo fuel n acc | n < 16 = hexDigit n :: acc.
hexIntGo fuel n acc = hexIntGo (fuel - 1) (n / 16) (hexDigit (band n 15) :: acc).

# ---- Base64 (RFC 4648, padded) --------------------------------------------------------
b64Char : Int -> String .
b64Char v = chr (if v < 26 then 65 + v
  else if v < 52 then 71 + v
  else if v < 62 then v - 4
  else if v == 62 then 43 else 47).

base64 : String -> String .
base64 s = strJoin "" (rev (b64Go s 0 (strlen s) Nil) Nil).
# pieces, newest first
b64Go : String -> (i : Int | measure (n - i)) -> (n : Int) -> List String -> List String .
b64Go s i n acc | i >= n = acc.
b64Go s i n acc =
  a = charAt s i;
  b = if i + 1 < n then charAt s (i + 1) else 0;
  c = if i + 2 < n then charAt s (i + 2) else 0;
  q3 = if i + 1 < n then b64Char (band (bor (BITSHIFTL b 2) (BITSHIFTR c 6)) 63) else "=";
  q4 = if i + 2 < n then b64Char (band c 63) else "=";
  b64Go s (i + 3) n (q4 :: q3 :: b64Char (band (bor (BITSHIFTL a 4) (BITSHIFTR b 4)) 63) :: b64Char (BITSHIFTR a 2) :: acc).

# 0..63; -1 for "=" ; -2 for anything else
b64Val : Int -> Int
  | work b64Val <= 30 | alloc b64Val <= 80 .
b64Val c | c >= 65 and c <= 90 = c - 65.
b64Val c | c >= 97 and c <= 122 = c - 71.
b64Val c | c >= 48 and c <= 57 = c + 4.
b64Val c | c == 43 or c == 45 = 62.
b64Val c | c == 47 or c == 95 = 63.
b64Val c | c == 61 = 0 - 1.
b64Val _ = 0 - 2.

# accepts the URL-safe alphabet too ("-" and "_"); whitespace is not skipped
fromBase64 : String -> Result String String .
fromBase64 t | band (strlen t) 3 != 0 = Err "base64: the length is not a multiple of four".
fromBase64 t = unB64Go t 0 (strlen t) Nil.
unB64Go : String -> (i : Int | measure (n - i)) -> (n : Int) -> List String -> Result String String .
unB64Go t i n acc | i >= n = Ok (strJoin "" (rev acc Nil)).
unB64Go t i n acc =
  a = b64Val (charAt t i);
  b = b64Val (charAt t (i + 1));
  c = b64Val (charAt t (i + 2));
  d = b64Val (charAt t (i + 3));
  last = i + 4 == n;
  if a < 0 or b < 0 or c < (0 - 1) or d < (0 - 1) or ((c < 0 or d < 0) and not last) or (c < 0 and d >= 0) then
    Err "base64: not valid at position {i}"
  else
    b1 = chr (band (bor (BITSHIFTL a 2) (BITSHIFTR b 4)) 255);
    b2 = if c < 0 then "" else chr (band (bor (BITSHIFTL b 4) (BITSHIFTR c 2)) 255);
    b3 = if d < 0 then "" else chr (band (bor (BITSHIFTL c 6) d) 255);
    unB64Go t (i + 4) n (b3 :: b2 :: b1 :: acc).

# ---- URL (percent) encoding, RFC 3986 ---------------------------------------------------
# letters, digits and - . _ ~ pass; every other BYTE is %XX, so UTF-8 encodes correctly
unreserved : Int -> Bool .
unreserved c = S.isAlpha c or S.isDigit c or c == 45 or c == 46 or c == 95 or c == 126.

url : String -> String .
url s = strJoin "" (urlGo s (strlen s - 1) Nil).
urlGo : String -> (i : Int | measure i) -> List String -> List String .
urlGo s i acc | i < 0 = acc.
urlGo s i acc =
  c = charAt s i;
  if unreserved c then urlGo s (i - 1) (chr c :: acc)
  else urlGo s (i - 1) ("%" :: S.toUpper (hexDigit (c / 16)) :: S.toUpper (hexDigit (band c 15)) :: acc).

# "+" is a space here too, as forms send it
fromUrl : String -> Result String String .
fromUrl t = fromUrlGo t 0 (strlen t) Nil.
fromUrlGo : String -> (i : Int | measure (n - i)) -> (n : Int) -> List String -> Result String String .
fromUrlGo t i n acc | i >= n = Ok (strJoin "" (rev acc Nil)).
fromUrlGo t i n acc =
  c = charAt t i;
  if c != 37 then
    fromUrlGo t (i + 1) n ((if c == 43 then " " else chr c) :: acc)
  else if i + 2 >= n or hexVal (charAt t (i + 1)) < 0 or hexVal (charAt t (i + 2)) < 0 then
    Err "url: a bad % escape at position {i}"
  else
    fromUrlGo t (i + 3) n (chr (hexVal (charAt t (i + 1)) * 16 + hexVal (charAt t (i + 2))) :: acc).

# "a=1&b=two%20words" -> pairs, decoded; a part that will not decode is kept as written
query : String -> List (String, String) .
query q = queryGo (S.split "&" q) Nil.
queryGo : (parts : List String | measure parts) -> List (String, String) -> List (String, String) .
queryGo parts acc = case parts of
    Nil -> rev acc Nil
  | p :: r ->
      if strlen p == 0 then queryGo r acc
      else
        at = strIndexOf "=" p;
        k = if at < 0 then p else S.left at p;
        v = if at < 0 then "" else S.dropLeft (at + 1) p;
        queryGo r ((orRaw k, orRaw v) :: acc).
orRaw : String -> String .
orRaw t = case fromUrl t of Ok d -> d | Err _ -> t.

# std/result.fpr -- helpers over the builtin `Result value error` (Ok | Err).
#
#   Result = use "std/result".
#   readConfig path |> Result.andThen parse |> Result.withDefault defaults

map : (a -> b) -> Result a e -> Result b e .
map f (Ok x) = Ok (f x).
map _ (Err e) = Err e.

mapError : (e -> f) -> Result a e -> Result a f .
mapError _ (Ok x) = Ok x.
mapError f (Err e) = Err (f e).

andThen : (a -> Result b e) -> Result a e -> Result b e .
andThen f (Ok x) = f x.
andThen _ (Err e) = Err e.

withDefault : a -> Result a e -> a
  | work withDefault <= 5 | alloc withDefault <= 0 .
withDefault _ (Ok x) = x.
withDefault d (Err _) = d.

isOk : Result a e -> Bool
  | work isOk <= 5 | alloc isOk <= 16 .
isOk (Ok _) = True.
isOk (Err _) = False.

isErr : Result a e -> Bool
  | work isErr <= 5 | alloc isErr <= 16 .
isErr (Ok _) = False.
isErr (Err _) = True.

rev : (xs : List a | measure xs) -> List a -> List a .
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).

# every value, or the FIRST failure
collect : List (Result a e) -> Result (List a) e .
collect rs = collectGo rs Nil.
collectGo : (rs : List (Result a e) | measure rs) -> List a -> Result (List a) e .
collectGo rs acc = case rs of
    Nil -> Ok (rev acc Nil)
  | r :: rest -> (case r of Ok x -> collectGo rest (x :: acc) | Err e -> Err e).

# keep the successes, drop the failures
oks : (rs : List (Result a e)) -> List a | size oks <= len rs .
oks rs = oksGo rs Nil.
oksGo : (rs : List (Result a e) | measure rs) -> List a -> List a .
oksGo rs acc = case rs of
    Nil -> rev acc Nil
  | r :: rest -> (case r of Ok x -> oksGo rest (x :: acc) | Err _ -> oksGo rest acc).

# turn a boolean condition into a Result guard
check : Bool -> e -> Result Unit e .
check True _ = Ok Unit.
check False why = Err why.

# map a fallible function over a list, stopping at the first failure
traverse : (a -> Result b e) -> List a -> Result (List b) e .
traverse f xs = traverseGo f xs Nil.
traverseGo : (a -> Result b e) -> (xs : List a | measure xs) -> List b -> Result (List b) e .
traverseGo f xs acc = case xs of
    Nil -> Ok (rev acc Nil)
  | x :: rest -> (case f x of Ok v -> traverseGo f rest (v :: acc) | Err e -> Err e).

# run a fallible step over each element, stopping at the first failure
each : (a -> Result b e) -> (xs : List a | measure xs) -> Result Unit e .
each f xs = case xs of
    Nil -> Ok Unit
  | x :: rest -> (case f x of Ok _ -> each f rest | Err e -> Err e).

# fallible left fold, stopping at the first failure
foldM : (b -> a -> Result b e) -> b -> (xs : List a | measure xs) -> Result b e .
foldM f acc xs = case xs of
    Nil -> Ok acc
  | x :: rest -> (case f acc x of Ok next -> foldM f next rest | Err e -> Err e).

# first failure in a list of unit checks, or Ok Unit
firstErr : (rs : List (Result Unit e) | measure rs) -> Result Unit e .
firstErr rs = case rs of
    Nil -> Ok Unit
  | Err e :: _ -> Err e
  | Ok _ :: rest -> firstErr rest.

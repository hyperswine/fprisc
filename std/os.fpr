# std/os.fpr -- the posix system's primitives, declared in ONE place.
#
# You do not normally use this module: std/file, std/dir, std/proc and
# std/clock are the API.  This is the seam under them -- signatures with no
# definition, implemented by machine/posix/os_*.c.  A system without them (a
# board) fails a program that imports them at LINK time, by name: a program's
# imports are its capability manifest (docs/2026-09-18-BASE.md).
#
# Sub-seams (`osfs`, `osio`, `osnet`, `oswatch`, `osconnection`) remain available
# for embedded targets that link only a subset of POSIX runtime units, while
# `std/os` provides the complete unified surface (`Fs`, `Io`, `Net`, `Watch`,
# `Conn`, plus top-level primitive bindings).

Fs = use "osfs".
Io = use "osio".
Net = use "osnet".
Watch = use "oswatch".
Conn = use "osconnection".

Os.run       : List String -> String -> String -> List String -> Int -> Result (Int, String, String) String .
Os.wallClock : Unit -> Int .
Os.tzOffset  : Int -> Int .
Os.exec      : List String -> Result Unit String .
Os.exePath   : Unit -> Result String String .
Os.ttyRaw    : Bool -> Result Unit String .
Os.ttySize   : Unit -> (Int, Int) .

readFile p = Fs.readFile p.
listDir p = Fs.listDir p.
stat p = Fs.stat p.
mkdir p = Fs.mkdir p.
remove p = Fs.remove p.
rename a b = Fs.rename a b.
cwd u = Fs.cwd u.

open path mode = Io.open path mode.
ready fd = Io.ready fd.
readyFor fd mask = Io.readyFor fd mask.
poll fds = Io.poll fds.
read fd n = Io.read fd n.
write fd bytes = Io.write fd bytes.
seek fd at = Io.seek fd at.
close fd = Io.close fd.

connect host port = Net.connect host port.
listen addr port = Net.listen addr port.
accept fd = Net.accept fd.
localPort fd = Net.localPort fd.
prepareSocket fd = Net.prepareSocket fd.

watchOpen u = Watch.watchOpen u.
watchArm w fds = Watch.watchArm w fds.
watchTake w = Watch.watchTake w.
watchArmEvents w events us = Watch.watchArmEvents w events us.
watchTakeEvents w = Watch.watchTakeEvents w.
watchClose w = Watch.watchClose w.

run argv dir input env limitMs = Os.run argv dir input env limitMs.
exec argv = Os.exec argv.
exePath u = Os.exePath u.
ttyRaw on = Os.ttyRaw on.
ttySize u = Os.ttySize u.
wallClock u = Os.wallClock u.
# the local time zone's offset from UTC at that instant, seconds east
tzOffset secs = Os.tzOffset secs.

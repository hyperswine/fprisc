# std/os.fpr -- the posix system's primitives, declared in ONE place.
#
# You do not normally use this module: std/file, std/dir, std/proc and
# std/clock are the API.  This is the seam under them -- signatures with no
# definition, implemented by machine/posix/os_*.c.  A system without them (a
# board) fails a program that imports them at LINK time, by name: a program's
# imports are its capability manifest (docs/2026-09-18-BASE.md).

# ---- Filesystem (machine/posix/os_fs.c) ------------------------------------------
Os.readFile  : String -> Result String String .
Os.listDir   : String -> Result (List String) String .
Os.stat      : String -> Result (Int, Int, Int) String .
Os.mkdir     : String -> Result Unit String .
Os.remove    : String -> Result Unit String .
Os.rename    : String -> String -> Result Unit String .
Os.cwd       : Unit -> String .

# ---- File descriptor I/O (machine/posix/os_io.c) ---------------------------------
Os.open      : String -> String -> Result Int String .
Os.ready     : Int -> Bool .
Os.readyFor  : Int -> Int -> Result Bool String .
Os.poll      : List Int -> List Int .
Os.read      : Int -> Int -> Result String String .
Os.write     : Int -> String -> Result Int String .
Os.seek      : Int -> Int -> Result Int String .
Os.close     : Int -> Result Unit String .

# ---- Networking (machine/posix/os_net.c) -----------------------------------------
Os.connect       : String -> Int -> Result Int String .
Os.listen        : String -> Int -> Result Int String .
Os.accept        : Int -> Result (Int, String) String .
Os.localPort     : Int -> Result Int String .
Os.prepareSocket : Int -> Result Unit String .

# ---- Kernel readiness watch (machine/posix/os_watch.c) ---------------------------
Os.watchOpen       : Unit -> Result Int String .
Os.watchArm        : Int -> List Int -> Unit .
Os.watchTake       : Int -> List Int .
# Directional off-hart wait, with a relative kernel timer (-1 means untimed).
# Timer-only expiry raises an IRQ; take then returns Nil. Policy lives above.
Os.watchArmEvents  : Int -> List (Int, Int) -> Int -> Result Unit String .
Os.watchTakeEvents : Int -> List (Int, Int) .
# Unsafe owned handle: stop arm/take first; retry after yielding while False.
# True releases the handle, which must never be used again (IRQ slots reuse).
Os.watchClose      : Int -> Bool .

# ---- Checked owned sockets (machine/posix/os_connection.c) -----------------------
# IDs never reuse. Raw Os.* is an unsafe escape hatch.
ConnHost.adopt  : Int -> Result Int String .
ConnHost.begin  : Int -> String -> Int -> Result Int String .
ConnHost.fd     : Int -> Result Int String .
ConnHost.status : Int -> Result Bool String .
ConnHost.read   : Int -> Int -> Result String String .
ConnHost.write  : Int -> String -> Result Int String .
ConnHost.close  : Int -> Result Unit String .

# ---- Processes, TTY, wall clock (machine/posix/os_*.c) ---------------------------
Os.run       : List String -> String -> String -> List String -> Int -> Result (Int, String, String) String .
Os.wallClock : Unit -> Int .
Os.tzOffset  : Int -> Int .
Os.exec      : List String -> Result Unit String .
Os.exePath   : Unit -> Result String String .
Os.ttyRaw    : Bool -> Result Unit String .
Os.ttySize   : Unit -> (Int, Int) .

readFile path = Os.readFile path.
listDir path = Os.listDir path.
stat path = Os.stat path.
mkdir path = Os.mkdir path.
remove path = Os.remove path.
rename from to = Os.rename from to.
cwd u = Os.cwd u.

open path mode = Os.open path mode.
ready fd = Os.ready fd.
# Readiness mask: 1 = read, 2 = write, 3 = either. Never blocks.
readyFor fd mask = Os.readyFor fd mask.
poll fds = Os.poll fds.
read fd n = Os.read fd n.
write fd bytes = Os.write fd bytes.
seek fd at = Os.seek fd at.
close fd = Os.close fd.

connect host port = Os.connect host port.
listen addr port = Os.listen addr port.
accept fd = Os.accept fd.
localPort fd = Os.localPort fd.
prepareSocket fd = Os.prepareSocket fd.

watchOpen u = Os.watchOpen u.
watchArm w fds = Os.watchArm w fds.
watchTake w = Os.watchTake w.
watchArmEvents w events us = Os.watchArmEvents w events us.
watchTakeEvents w = Os.watchTakeEvents w.
watchClose w = Os.watchClose w.

connAdopt fd = ConnHost.adopt fd.
connBegin family address port = ConnHost.begin family address port.
connFd id = ConnHost.fd id.
connStatus id = ConnHost.status id.
connRead id n = ConnHost.read id n.
connWrite id bytes = ConnHost.write id bytes.
connClose id = ConnHost.close id.

run argv dir input env limitMs = Os.run argv dir input env limitMs.
exec argv = Os.exec argv.
exePath u = Os.exePath u.
ttyRaw on = Os.ttyRaw on.
ttySize u = Os.ttySize u.
wallClock u = Os.wallClock u.
# the local time zone's offset from UTC at that instant, seconds east
tzOffset secs = Os.tzOffset secs.

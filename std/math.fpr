# std/math.fpr -- Math: the everyday numeric functions.
#
#   Math = use "std/math".
#   Math.clamp 0 255 x          Math.sqrt 2.0          Math.round 2.5
#
# Int functions are exact.  The rest are F64 (write literals with a point:
# `2.0`), over the runtime's primitives; `Math.toFloat` / `Math.truncate`
# cross between the two.  Nothing here panics: `sqrt` of a negative or `log`
# of zero answer what IEEE 754 says (NaN, -inf), and `isFinite` asks.

# ---- Int ---------------------------------------------------------------------------
abs : Int -> Int
  | work abs <= 4 | alloc abs <= 0 .
abs n | n < 0 = 0 - n.
abs n = n.

min : Int -> Int -> Int
  | work min <= 4 | alloc min <= 0 .
min a b | a < b = a.
min _ b = b.

max : Int -> Int -> Int
  | work max <= 4 | alloc max <= 0 .
max a b | a > b = a.
max _ b = b.

# Math.clamp lo hi x
clamp : Int -> Int -> Int -> Int
  | work clamp <= 6 | alloc clamp <= 0 .
clamp lo hi x | x < lo = lo.
clamp lo hi x | x > hi = hi.
clamp _ _ x = x.

sign : Int -> Int
  | work sign <= 6 | alloc sign <= 0 .
sign n | n < 0 = 0 - 1.
sign n | n == 0 = 0.
sign _ = 1.

# the remainder with the sign of the DIVISOR (so `mod (0 - 1) 12` is 11)
mod : Int -> (b : Int | b != 0) -> Int
  | work mod <= 20 | alloc mod <= 32 .
mod a b =
  r = a - (a / b) * b;
  if r != 0 and ((r < 0) != (b < 0)) then r + b else r.

# the remainder with the sign of the dividend, as `/` truncates
rem : Int -> (b : Int | b != 0) -> Int
  | work rem <= 6 | alloc rem <= 0 .
rem a b = a - (a / b) * b.

isEven : Int -> Bool
  | work isEven <= 10 | alloc isEven <= 16 .
isEven n = rem n 2 == 0.

gcd : Int -> Int -> Int .
gcd a b = gcdGo (abs a) (abs b).
gcdGo : unsafe Int -> Int -> Int .
gcdGo a b | b == 0 = a.
gcdGo a b = gcdGo b (rem a b).

# exact, by squaring; a negative exponent has no exact answer and gives 0
powInt : Int -> Int -> Int .
powInt a n | n < 0 = 0.
powInt a n = powGo a n 1.
powGo : unsafe Int -> Int -> Int -> Int .
powGo a n acc | n == 0 = acc.
powGo a n acc = powGo (a * a) (n / 2) (if rem n 2 == 1 then acc * a else acc).

# ---- F64 ---------------------------------------------------------------------------
pi = 3.141592653589793.
e = 2.718281828459045.

toFloat : Int -> F64 .
toFloat n = F64.ofInt n.

# toward zero
truncate : F64 -> Int .
truncate x = F64.toInt x.

floor : F64 -> Int .
floor x =
  t = F64.toInt x;
  if F64.ofInt t > x then t - 1 else t.

ceiling : F64 -> Int .
ceiling x =
  t = F64.toInt x;
  if F64.ofInt t < x then t + 1 else t.

# halves away from zero
round : F64 -> Int .
round x | x < 0.0 = 0 - floor (0.5 - x).
round x = floor (x + 0.5).

sqrt : F64 -> F64 .
sqrt x = F64.sqrt x.

pow : F64 -> F64 -> F64 .
pow x y = F64.pow x y.

exp : F64 -> F64 .
exp x = F64.exp x.

# natural
log : F64 -> F64 .
log x = F64.log x.

log2 : F64 -> F64 .
log2 x = F64.log2 x.

sin : F64 -> F64 .
sin x = F64.sin x.

cos : F64 -> F64 .
cos x = F64.cos x.

tan : F64 -> F64 .
tan x = F64.sin x / F64.cos x.

absF : F64 -> F64 .
absF x | x < 0.0 = 0.0 - x.
absF x = x.

minF : F64 -> F64 -> F64 .
minF a b | a < b = a.
minF _ b = b.

maxF : F64 -> F64 -> F64 .
maxF a b | a > b = a.
maxF _ b = b.

clampF : F64 -> F64 -> F64 -> F64 .
clampF lo hi x | x < lo = lo.
clampF lo hi x | x > hi = hi.
clampF _ _ x = x.

# not NaN and not an infinity
isFinite : F64 -> Bool .
isFinite x = x - x == 0.0.

format : F64 -> String .
format x = F64.str x.

# Structured browser autocomplete capability. FP-RISC syntax values are authoritative.
# No foreign source asset or Raw node is read at runtime.
JS = use "std/javascript".
G = use "std/view".

n = JS.Name.
t = JS.Text.
f = JS.Field.
num = JS.Number.
call name args = JS.Call (n name) args.
method target name args = JS.Call (f target name) args.
doMethod target name args = JS.Do (method target name args).

src u = JS.program [
  JS.Do (JS.Call (JS.Function Nil (setupAutocomplete Unit)) Nil)
].

onSuggestEvent u = [
  JS.Try [JS.Do (JS.AssignValue (n "lists") (method (n "JSON") "parse" [f (n "e") "detail"]))] "x" Nil Nil,
  JS.Do (call "refresh" Nil)
].

inputKind u = [
  JS.Return (JS.Choose (JS.Binary JS.And (n "el") (f (n "el") "getAttribute")) (method (n "el") "getAttribute" [t "data-ac"]) JS.Null)
].

scopedInputValue u = [
  JS.Var "scope" (JS.Binary JS.And (n "cur") (method (n "cur") "closest" [t "[data-ac-scope]"])),
  JS.Var "e" (JS.Binary JS.And (n "scope") (method (n "scope") "querySelector" [JS.Binary JS.Add (JS.Binary JS.Add (t "[data-input=\"") (n "name")) (t "\"]")])),
  JS.Return (JS.Choose (n "e") (f (n "e") "value") (t ""))
].

activePrefix u = [
  JS.Var "v" (f (n "el") "value"),
  JS.Return (method (method (JS.Choose (JS.Binary JS.Equal (call "kind" [n "el"]) (t "tags"))
    (method (n "v") "slice" [JS.Binary JS.Add (method (n "v") "lastIndexOf" [t ","]) (num 1)])
    (n "v")) "trim" Nil) "toLowerCase" Nil)
].

notInHere u = [
  JS.Return (JS.Binary JS.Less (method (n "here") "indexOf" [n "x"]) (num 0))
].

normalizeTag u = [
  JS.Return (method (method (n "t") "trim" Nil) "toLowerCase" Nil)
].

notInHave u = [
  JS.Return (JS.Binary JS.Less (method (n "have") "indexOf" [n "t"]) (num 0))
].

candidatePool u = [
  JS.Var "k" (call "kind" [n "el"]),
  JS.Var "sub" (JS.Binary JS.Or (f (n "lists") "sub") (JS.Object Nil)),
  JS.If (JS.Binary JS.Equal (n "k") (t "loc")) [JS.Return (JS.Binary JS.Or (f (n "lists") "loc") (JS.Array Nil))] Nil,
  JS.If (JS.Binary JS.Equal (n "k") (t "sub")) [
    JS.Var "here" (JS.Binary JS.Or (JS.Index (n "sub") (method (method (call "valueOf" [t "loc"]) "trim" Nil) "toLowerCase" Nil)) (JS.Array Nil)),
    JS.Return (method (n "here") "concat" [method (JS.Binary JS.Or (JS.Index (n "sub") (t "*")) (JS.Array Nil)) "filter" [JS.Function ["x"] (notInHere Unit)]])
  ] Nil,
  JS.If (JS.Binary JS.Equal (n "k") (t "tags")) [
    JS.Var "have" (method (method (method (f (n "el") "value") "split" [t ","]) "slice" [num 0, JS.Unary JS.Minus (num 1)]) "map" [JS.Function ["t"] (normalizeTag Unit)]),
    JS.Return (method (JS.Binary JS.Or (f (n "lists") "tags") (JS.Array Nil)) "filter" [JS.Function ["t"] (notInHave Unit)])
  ] Nil,
  JS.Return (JS.Array Nil)
].

bucketCandidate u = [
  JS.Var "l" (method (n "x") "toLowerCase" Nil),
  JS.If (JS.Binary JS.Equal (n "l") (n "p")) [JS.ReturnVoid] Nil,
  JS.If (JS.Binary JS.Or (JS.Unary JS.Not (n "p")) (JS.Binary JS.Equal (method (n "l") "indexOf" [n "p"]) (num 0)))
    [doMethod (n "a") "push" [n "x"]]
    [JS.If (JS.Binary JS.GreaterEqual (method (n "l") "indexOf" [JS.Binary JS.Add (t " ") (n "p")]) (num 0))
      [doMethod (n "b") "push" [n "x"]]
      [JS.If (JS.Binary JS.GreaterEqual (method (n "l") "indexOf" [n "p"]) (num 0))
        [doMethod (n "c") "push" [n "x"]] Nil]]
].

rankCandidates u = [
  JS.Var "p" (call "part" [n "el"]),
  JS.Var "all" (call "pool" [n "el"]),
  JS.Var "a" (JS.Array Nil),
  JS.Var "b" (JS.Array Nil),
  JS.Var "c" (JS.Array Nil),
  doMethod (n "all") "forEach" [JS.Function ["x"] (bucketCandidate Unit)],
  JS.Return (method (method (n "a") "concat" [n "b", n "c"]) "slice" [num 0, num 6])
].

hidePopup u = [
  JS.Do (JS.AssignValue (f (f (n "box") "style") "display") (t "none")),
  JS.Do (JS.AssignValue (n "opts") (JS.Array Nil))
].

clearBoxAttribute u = [
  JS.If (JS.Binary JS.NotEqual (f (n "a") "name") (t "style")) [doMethod (n "box") "removeAttribute" [f (n "a") "name"]] Nil
].

copyFrameAttribute u = [
  doMethod (n "box") "setAttribute" [f (n "a") "name", f (n "a") "value"]
].

onOptionPointerDown u = [
  doMethod (n "e") "preventDefault" Nil,
  JS.Do (call "take" [n "i"])
].

appendOptionButton u = [
  JS.Var "b" (method (method (n "prototypes") "querySelector" [
    JS.Binary JS.Add (JS.Binary JS.Add (t "[data-ac-option=\"")
      (JS.Choose (JS.Binary JS.Equal (n "i") (n "sel")) (t "selected") (t "normal"))) (t "\"]")
  ]) "cloneNode" [JS.Boolean True]),
  JS.Do (JS.AssignValue (f (n "b") "textContent") (n "o")),
  doMethod (n "b") "addEventListener" [t "pointerdown", JS.Function ["e"] (onOptionPointerDown Unit)],
  doMethod (n "box") "appendChild" [n "b"]
].

refreshPopup u = [
  JS.If (JS.Binary JS.Or (JS.Binary JS.Or (JS.Unary JS.Not (n "cur")) (JS.Unary JS.Not (method (n "document") "contains" [n "cur"])))
    (JS.Binary JS.NotEqual (f (n "document") "activeElement") (n "cur")))
    [JS.Do (call "hide" Nil), JS.ReturnVoid] Nil,
  JS.Var "scope" (method (n "cur") "closest" [t "[data-ac-scope]"]),
  JS.Var "prototypes" (JS.Binary JS.And (n "scope") (method (n "scope") "querySelector" [t "[data-ac-prototypes]"])),
  JS.Var "frame" (JS.Binary JS.And (n "prototypes") (method (n "prototypes") "querySelector" [t "[data-ac-frame]"])),
  JS.If (JS.Unary JS.Not (n "frame")) [JS.Do (call "hide" Nil), JS.ReturnVoid] Nil,
  JS.Do (JS.AssignValue (n "opts") (call "rank" [n "cur"])),
  JS.If (JS.Binary JS.GreaterEqual (n "sel") (f (n "opts") "length")) [JS.Do (JS.AssignValue (n "sel") (num 0))] Nil,
  JS.If (JS.Unary JS.Not (f (n "opts") "length")) [JS.Do (call "hide" Nil), JS.ReturnVoid] Nil,
  doMethod (method (n "Array") "from" [f (n "box") "attributes"]) "forEach" [JS.Function ["a"] (clearBoxAttribute Unit)],
  doMethod (method (n "Array") "from" [f (n "frame") "attributes"]) "forEach" [JS.Function ["a"] (copyFrameAttribute Unit)],
  doMethod (n "box") "setAttribute" [t "data-ac-popup", t ""],
  doMethod (n "box") "replaceChildren" Nil,
  doMethod (n "opts") "forEach" [JS.Function ["o", "i"] (appendOptionButton Unit)],
  JS.Var "hint" (method (method (n "prototypes") "querySelector" [t "[data-ac-hint]"]) "cloneNode" [JS.Boolean True]),
  JS.Do (JS.AssignValue (f (n "hint") "textContent")
    (JS.Choose (f (call "matchMedia" [t "(pointer: coarse)"]) "matches")
      (t "tap the field again for the first")
      (t "tab takes the highlighted one"))),
  doMethod (n "box") "appendChild" [n "hint"],
  JS.Var "r" (method (n "cur") "getBoundingClientRect" Nil),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "left") (JS.Binary JS.Add (JS.Binary JS.Add (f (n "r") "left") (n "scrollX")) (t "px"))),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "top") (JS.Binary JS.Add (JS.Binary JS.Add (JS.Binary JS.Add (f (n "r") "bottom") (n "scrollY")) (num 4)) (t "px"))),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "width") (JS.Binary JS.Add (f (n "r") "width") (t "px"))),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "display") (t "flex"))
].

acceptOption u = [
  JS.Var "o" (JS.Index (n "opts") (n "i")),
  JS.Var "v" (f (n "cur") "value"),
  JS.If (JS.Binary JS.Equal (n "o") (n "undefined")) [JS.ReturnVoid] Nil,
  JS.If (JS.Binary JS.Equal (call "kind" [n "cur"]) (t "tags")) [
    JS.Var "head" (method (method (n "v") "slice" [num 0, JS.Binary JS.Add (method (n "v") "lastIndexOf" [t ","]) (num 1)]) "trim" Nil),
    JS.Do (JS.AssignValue (f (n "cur") "value")
      (JS.Binary JS.Add (JS.Binary JS.Add (JS.Choose (n "head") (JS.Binary JS.Add (n "head") (t " ")) (t "")) (n "o")) (t ", ")))
  ] [
    JS.Do (JS.AssignValue (f (n "cur") "value") (n "o"))
  ],
  JS.Do (JS.AssignValue (n "sel") (num 0)),
  JS.Do (JS.AssignValue (n "moved") (JS.Boolean False)),
  doMethod (n "cur") "dispatchEvent" [JS.New (n "Event") [t "input", JS.Object [("bubbles", JS.Boolean True)]]],
  JS.If (JS.Binary JS.Equal (call "kind" [n "cur"]) (t "tags")) [JS.Do (call "refresh" Nil)] [JS.Do (call "hide" Nil)]
].

onFocusIn u = [
  JS.If (call "kind" [f (n "e") "target"])
    [JS.Do (JS.AssignValue (n "cur") (f (n "e") "target")), JS.Do (JS.AssignValue (n "sel") (num 0)), JS.Do (JS.AssignValue (n "moved") (JS.Boolean False)), JS.Do (call "refresh" Nil)]
    [JS.Do (JS.AssignValue (n "cur") JS.Null), JS.Do (call "hide" Nil)]
].

onFocusOut u = [
  JS.If (JS.Binary JS.Equal (f (n "e") "target") (n "cur")) [JS.Do (call "setTimeout" [n "refresh", num 0])] Nil
].

onInputEdit u = [
  JS.If (JS.Binary JS.Equal (f (n "e") "target") (n "cur"))
    [JS.Do (JS.AssignValue (n "sel") (num 0)), JS.Do (JS.AssignValue (n "moved") (JS.Boolean False)), JS.Do (call "refresh" Nil)] Nil
].

onKeyDown u = [
  JS.If (JS.Binary JS.Or (JS.Binary JS.Or (JS.Unary JS.Not (n "cur")) (JS.Binary JS.NotEqual (f (n "e") "target") (n "cur"))) (JS.Unary JS.Not (f (n "opts") "length")))
    [JS.ReturnVoid] Nil,
  JS.If (JS.Binary JS.Or (JS.Binary JS.Equal (f (n "e") "key") (t "ArrowDown")) (JS.Binary JS.Equal (f (n "e") "key") (t "ArrowUp"))) [
    JS.Do (JS.AssignValue (n "sel") (JS.Binary JS.Modulo
      (JS.Binary JS.Add (n "sel") (JS.Choose (JS.Binary JS.Equal (f (n "e") "key") (t "ArrowDown")) (num 1) (JS.Binary JS.Subtract (f (n "opts") "length") (num 1))))
      (f (n "opts") "length"))),
    JS.Do (JS.AssignValue (n "moved") (JS.Boolean True)),
    doMethod (n "e") "preventDefault" Nil,
    JS.Do (call "refresh" Nil)
  ] [
    JS.If (JS.Binary JS.And (JS.Binary JS.And (JS.Binary JS.Equal (f (n "e") "key") (t "Tab")) (JS.Unary JS.Not (f (n "e") "shiftKey")))
      (JS.Binary JS.Or (call "part" [n "cur"]) (n "moved")))
      [doMethod (n "e") "preventDefault" Nil, JS.Do (call "take" [n "sel"])]
      [JS.If (JS.Binary JS.And (JS.Binary JS.Equal (f (n "e") "key") (t "Enter")) (n "moved"))
        [doMethod (n "e") "preventDefault" Nil, JS.Do (call "take" [n "sel"])]
        [JS.If (JS.Binary JS.Equal (f (n "e") "key") (t "Escape")) [JS.Do (call "hide" Nil)] Nil]]
  ]
].

onPointerDown u = [
  JS.Do (JS.AssignValue (n "touchAgain") (JS.Binary JS.And (JS.Binary JS.And
    (JS.Binary JS.And (JS.Binary JS.NotEqual (f (n "e") "pointerType") (t "mouse")) (call "kind" [f (n "e") "target"]))
    (JS.Binary JS.Equal (f (n "e") "target") (n "cur")))
    (JS.Binary JS.Equal (f (n "document") "activeElement") (n "cur"))))
].

onClickTap u = [
  JS.If (JS.Binary JS.And (JS.Binary JS.And (n "touchAgain") (JS.Binary JS.Equal (f (n "e") "target") (n "cur"))) (f (n "opts") "length"))
    [JS.Do (call "take" [n "sel"])] Nil,
  JS.Do (JS.AssignValue (n "touchAgain") (JS.Boolean False))
].

setupAutocomplete u = [
  JS.Var "lists" (JS.Object [("loc", JS.Array Nil), ("sub", JS.Object Nil), ("tags", JS.Array Nil)]),
  JS.Var "cur" JS.Null,
  JS.Var "opts" (JS.Array Nil),
  JS.Var "sel" (num 0),
  JS.Var "moved" (JS.Boolean False),
  JS.Var "touchAgain" (JS.Boolean False),
  JS.Var "box" (method (n "document") "createElement" [t "div"]),
  JS.Do (JS.AssignValue (f (f (n "box") "style") "display") (t "none")),
  doMethod (f (n "document") "body") "appendChild" [n "box"],
  doMethod (n "document") "addEventListener" [t "live:suggest", JS.Function ["e"] (onSuggestEvent Unit)],
  JS.Define "kind" ["el"] (inputKind Unit),
  JS.Define "valueOf" ["name"] (scopedInputValue Unit),
  JS.Define "part" ["el"] (activePrefix Unit),
  JS.Define "pool" ["el"] (candidatePool Unit),
  JS.Define "rank" ["el"] (rankCandidates Unit),
  JS.Define "hide" Nil (hidePopup Unit),
  JS.Define "refresh" Nil (refreshPopup Unit),
  JS.Define "take" ["i"] (acceptOption Unit),
  doMethod (n "document") "addEventListener" [t "focusin", JS.Function ["e"] (onFocusIn Unit)],
  doMethod (n "document") "addEventListener" [t "focusout", JS.Function ["e"] (onFocusOut Unit)],
  doMethod (n "document") "addEventListener" [t "input", JS.Function ["e"] (onInputEdit Unit)],
  JS.Do (call "addEventListener" [t "resize", n "refresh"]),
  JS.Do (call "addEventListener" [t "scroll", n "refresh", JS.Boolean True]),
  doMethod (n "document") "addEventListener" [t "live:frame", n "refresh"],
  JS.Do (call "addEventListener" [t "pagehide", n "hide"]),
  doMethod (n "document") "addEventListener" [t "keydown", JS.Function ["e"] (onKeyDown Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "pointerdown", JS.Function ["e"] (onPointerDown Unit), JS.Boolean True],
  doMethod (n "document") "addEventListener" [t "click", JS.Function ["e"] (onClickTap Unit), JS.Boolean True]
].

# ---- the hooks the script reads -----------------------------------------------------
# the region whose inputs complete (prototypes inside it), and an input that
# completes from the server's list `name` ("tags": a comma-separated list)
scope : G.Attr .
scope = G.Att "data-ac-scope" "".
from : String -> G.Attr .
from name = G.Att "data-ac" name.

# ---- the popup the script clones ---------------------------------------------------
# A frame, an option in its two states (normal, selected) and a hint, in the
# page's theme (`palette`: std/view's theme tokens, as std/appearance gives
# them -- a clone is shown at the body, outside the page's own scope).  They
# are ordinary hidden nodes of the page, so their rules are in its stylesheet:
#   UI.vstackWith ... [Att "data-ac-scope" ""] (Autocomplete.prototypes palette :: kids)
prototypes : List G.Attr -> G.Node .
prototypes palette = G.El "div" [reset, G.Att "data-ac-prototypes" "", G.utilities [G.Display G.Hidden]]
  [ G.El "div" (reset :: G.Att "data-ac-frame" "" :: G.Att "role" "listbox" :: G.Att "aria-label" "Suggestions" ::
      G.utilities [G.Position G.Absolute, G.ZIndex 50, G.Display G.Flex, G.FlexWrap G.Wrap,
        G.Gap (G.Px 6), G.Padding (G.Px 8), G.Radius (G.Px 12),
        G.Background (G.ThemeColour G.Card), G.Foreground (G.ThemeColour G.Ink),
        G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour G.Line),
        G.Shadow (G.Px 0) (G.Px 8) (G.Px 24) (G.Px 0) (G.RgbaPercent 0 0 0 18),
        G.FontFamily G.ReadingFont, G.FontSize (G.Px 15), G.LineHeight 155] :: palette) Nil
  , option False, option True
  , G.El "span" [reset, G.Att "data-ac-hint" "", G.utilities [G.FontSize (G.Px 11), G.Foreground (G.ThemeColour G.Dim), G.AlignSelf G.AlignCenter]] Nil ].
reset = G.utilities [G.BoxSizing G.BorderBox, G.Margin (G.Px 0)].
option selected = G.El "button"
  [G.utilities [G.BoxSizing G.BorderBox, G.Margin (G.Px 0), G.FontFamily G.InheritFont, G.FontSize G.Inherit],
   G.Att "data-ac-option" (if selected then "selected" else "normal"), G.Att "type" "button", G.Att "role" "option",
   G.Att "tabindex" "-1", G.Att "aria-selected" (if selected then "true" else "false"), G.utilities [G.MinHeight (G.Px 34)],
   G.utilities [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder,
     G.BorderColour (G.ThemeColour (if selected then G.Ink else G.Line)), G.Radius (G.Px 999),
     G.PaddingX (G.Px 12), G.PaddingY (G.Px 2), G.FontSize (G.Px 13),
     G.Background (G.ThemeColour (if selected then G.Ink else G.Card)),
     G.Foreground (G.ThemeColour (if selected then G.Bg else G.Dim))],
   G.hover (if selected then Nil else [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)])] Nil.

B = use "../sol/lib/build".
CLI = use "../sol/lib/cli".
F = use "../tools/toolchain-files".
J = use "../sol/lib/json".
Map = use "../std/map".
groups = [
  ("Filament runout reported",["run out","ran out","runout"]),
  ("Filament cutter needs attention",["cutter"]),
  ("Temperature or heater needs attention",["temperature","heater","thermistor"]),
  ("Filament feeding needs attention",["filament","extrud"]),
  ("Fan needs attention",["fan"]),
  ("Movement or homing needs attention",["homing","motor","axis","leveling","levelling"]),
  ("Print file or storage needs attention",["sd card","sdcard","memory card","print file","parse the file"]),
  ("Build plate needs attention",["build plate","heatbed plate"])].
classify text = case List.filter (fn pair -> (_,words) = pair; List.any (fn w -> Str.contains w text) words) groups of
  (title,_) :: _ -> title | [] -> "".
codeOf value = case value of J.JStr s -> Str.upper s | J.JNum n -> "{n}" | _ -> "".
observe codes object =
  code = case J.get "ecode" object of Ok value -> codeOf value | Err _ -> "";
  if not (List.has (Str.len code) [8,16] and List.all (fn c -> Str.find c "0123456789ABCDEF" >= 0) (Str.codes code))
  then codes else
    intro = case J.get "intro" object of Ok value -> value | Err _ -> J.JStr "";
    case intro of J.JStr text ->
      label = classify (Str.lower text);
      previous = Map.getOr [] code codes;
      if List.has label previous then codes else Map.insert code (label :: previous) codes
    | _ -> codes.
walk : unsafe Map.Map String (List String) -> J.Json -> Map.Map String (List String) .
walk codes value = case value of
    J.JObj fields -> List.fold (fn acc pair -> (_,child) = pair; walk acc child) (observe codes value) fields
  | J.JArr items -> List.fold walk codes items
  | _ -> codes.
catalog : unsafe String -> (Map.Map String (List String),List J.Json) -> String -> (Map.Map String (List String),List J.Json) .
catalog dir state name =
  (codes,sources) = state;
  raw = F.readBytes (F.canonical "{dir}/{name}");
  json = unwrap (J.parse (unwrap (Utf8.decode raw)));
  version = case J.get "ver" json of Ok v -> v | Err _ -> J.JNull;
  source = J.JObj [("file",J.JStr name),("sha256",J.JStr (Hex.encode (Sha256.bytes raw))),("version",version)];
  (walk codes json,source :: sources).
generate : unsafe String -> String -> Unit .
generate root dir =
  ProcessResult status out err = unwrap (Proc.runNow (ProcessSpec ["find",".","-maxdepth","1","-name","hms_en_*.json","-print0"] dir [] "" 0));
  if status != 0 then error "listing English HMS catalogs: {err}" else
    names = F.ordered (List.map (fn p -> Str.slice p 2 (Str.len p)) (List.filter (fn p -> p != "") (Str.split 0 out)));
    if names == [] then error "No bundled English HMS catalogs found" else
      (seen,sources) = List.fold (catalog dir) (Map.strings,[]) names;
      codes = Map.entries seen;
      selected = List.map (fn group -> (title,_) = group;
        (title,List.concat (List.map (fn pair -> (code,labels) = pair; if labels == [title] then [code] else []) codes))) groups;
      counts = List.map (fn pair -> (title,items) = pair; (title,J.JNum (List.len items))) selected;
      lines = List.map (fn pair -> (title,items) = pair; "  (" + J.quote title + ", \"|" + Str.join "|" items + "|\")") selected;
      header = ["# Generated by scripts/generate-printer-alert-codes.sol; category labels are ours.",
        "# Exact identifiers only; ambiguous/unknown codes retain a generic fallback.","# Input hashes: docs/printer-alert-catalog.json.",
        "S = use \"string\".","L = use \"list\".","O = use \"option\".","groups = ["];
      body = Str.join "\n" header + "\n" + Str.join ",\n" lines + "].\n" +
        "title code fallback = case L.find (fn group -> case group of (_, codes) -> S.contains (\"|\" + code + \"|\") codes) groups of O.Some (label, _) -> label | _ -> fallback.\n";
      multiple = List.len (List.filter (fn pair -> (_,labels) = pair; List.len labels > 1) codes);
      provenance = J.JObj [("schema",J.JNum 1),("sources",J.JArr (List.rev sources)),("category_counts",J.JObj counts),
        ("ambiguous_codes_omitted",J.JNum multiple),("meaning",J.JStr "Exact-code categories, not diagnoses. Unknown/ambiguous codes retain raw identifiers and official help links."),
        ("protocol_source",J.JStr "https://github.com/bambulab/BambuStudio/blob/master/src/slic3r/GUI/DeviceCore/DevHMS.cpp")];
      _ = writePath "{root}/std/printeralertcodes.fpr" body;
      _ = writePath "{root}/docs/printer-alert-catalog.json" (J.pretty provenance + "\n");
      total = List.fold (fn n pair -> (_,items) = pair; n + List.len items) 0 selected;
      print "Generated {total} exact code categories".
main : unsafe Unit -> Unit .
> parsed = unwrap (CLI.parse [CLI.Option "root" "" CLI.One,CLI.Option "catalog-dir" "" CLI.One] (args Unit));
  root = CLI.valueOr "" "root" parsed;
  dir = CLI.valueOr "/Applications/BambuStudio.app/Contents/Resources/hms" "catalog-dir" parsed;
  if CLI.operands parsed != [] then error "expected [--catalog-dir DIRECTORY] [--root FP_RISC_CHECKOUT]" else
    generate (if root == "" then B.query ["git","rev-parse","--show-toplevel"] else root) dir.

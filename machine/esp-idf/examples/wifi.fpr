# wifi.fpr -- Wi-Fi from FP-RISC on the ESP32-P4, through the board's ESP32-C6.
# Every call is a job on the broker: the calling actor waits, the harts do
# not.  Meanwhile a ticker actor on the other core keeps counting, to show it.
#   1. the radio's identity   2. a scan of nearby networks
#   3. an access point anyone nearby can join (the password is printed)
#   4. who has joined, sampled for 60 s
unsafe base.
Esp = use "std/esp".
Wifi = use "std/wifi".
List = use "std/list".

T = Type (Tick Int).
ticker boss n me = case n > 0 of
    True -> _ = Sys.sleepUs 250000; ticker boss (n - 1) me
  | False -> _ = send boss (Tick (Esp.core Unit)); 0.

need r = case r of Ok x -> x | Err why -> error why.

stations : unsafe Int -> Int .
stations n = if n == 0 then 0 else
  _ = Sys.sleepUs 10000000;
  ss = need (Wifi.stations Unit);
  _ = print "[{Esp.ms Unit / 1000} s] {List.length ss} station(s) on the access point";
  _ = List.each (fn s -> print "  {s.mac} at {s.rssi} dBm") ss;
  stations (n - 1).

main =
  me = myself 0;
  _ = spawnOn 1 (ticker me 8);
  t0 = Esp.ms Unit;
  r = need (Wifi.info Unit);
  _ = print "radio: station {r.station}, access point {r.ap}, mode {r.mode}";
  nets = need (Wifi.scan Unit);
  _ = List.each (fn n -> print "  {n.ssid} | {n.rssi} dBm | channel {n.channel} | {n.auth}") nets;
  _ = print "{List.length nets} network(s) in {Esp.ms Unit - t0} ms";
  tick = receive me;
  _ = (case tick of Tick c -> print "ticker on core {c} finished its 2 s while Wi-Fi jobs ran");
  pass = "fpr-risc-{Esp.random Unit % 1000000}";
  ap = need (Wifi.startAp "fpr-p4-test" pass);
  _ = print "access point {ap.ssid} on channel {ap.channel}, {ap.auth}, at {ap.ip} ({ap.bssid}); password {pass}";
  _ = stations 6;
  "wifi: done".

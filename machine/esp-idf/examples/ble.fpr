# ble.fpr -- Bluetooth LE on the ESP32-P4 through its ESP32-C6.
#   1. advertise as "fpr-p4-ble" for 60 s (a phone's BLE scanner will list it)
#   2. meanwhile, scan three times for 5 s and list what was heard
#   3. an actor on core 1 keeps counting while the radio jobs run
unsafe base.
Esp = use "std/esp".
Ble = use "std/ble".
List = use "std/list".

T = Type (Count Int).
counter boss n k me = case Esp.ms Unit > k of
    True -> _ = send boss (Count n); 0
  | False -> _ = Sys.sleepUs 100000; counter boss (n + 1) k me.

need r = case r of Ok x -> x | Err why -> error why.

scans : unsafe Int -> Int .
scans n = if n == 0 then 0 else
  t0 = Esp.ms Unit;
  heard = need (Ble.scan 5000);
  named = List.filter (fn d -> strlen d.name > 0) heard;
  _ = print "[{Esp.ms Unit / 1000} s] scan: {List.length heard} device(s) in {Esp.ms Unit - t0} ms, {List.length named} named";
  _ = List.each (fn d -> print "  {d.address} | {d.rssi} | {d.name}") (List.take 12 heard);
  scans (n - 1).

main =
  me = myself 0;
  _ = spawnOn 1 (counter me 0 (Esp.ms Unit + 20000));
  a = need (Ble.advertise "fpr-p4-ble" 60000);
  _ = print "advertising as {a.name} from {a.address}";
  refused = (case Ble.advertise "a-name-far-too-long-for-an-advertisement" 1000 of Ok _ -> "accepted?" | Err why -> why);
  _ = print "an over-long name: {refused}";
  _ = scans 3;
  c = receive me;
  _ = (case c of Count n -> print "the core-1 counter ticked {n} times while the radio jobs ran");
  "ble: done".

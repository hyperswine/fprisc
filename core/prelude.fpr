# prelude.fpr -- prepended to every program by the Makefile.
#
# Pure FPRISC. The typed stdlib is ML-style modules (sigs + structures)
# layered over the low-level HAL/prim contract: a sig is a named row, a
# structure implements it, generic code abstracts over `(s : Sig)`, and
# the compiler monomorphizes. Operators (+ - * /) resolve by operand
# type -- Int hits the primitive opcode, Str.+ concatenates, and at a
# sig carrier the operator becomes s.(+) and specializes.
#
# The flat HAL names (send, read, Vec.push, strlen) still work; the
# structures are ADDITIONS that make Int.max / Str.len / VList.fold
# available and let generics typecheck.

# ---- linear runtime types (the `1` marks linear; the checker keys on it) ----

Handle 1 = Type Int.
newHandle : Int -> Handle.
newHandle v = Handle v.
closeHandle : Handle -> Int.
closeHandle h = case h of Handle v -> v.

Vector 1 a = Type Int.

and a b = case a of True -> b | False -> False.
or a b = case a of True -> True | False -> b.
not b = case b of True -> False | False -> True.

# SString: a fixed 128-byte inline string. No heap, no ARC -- it lives in
# a caller-provided slab, cheap to pass on bare metal. Width hardcoded
# (SStr.cap) system-wide for now; `SString n` (indexed width) is a
# deliberate future step, not in this cut.
SString 1 = Type Int.

# ---- signatures (rows; `t` is the carrier convention) -----------------------

Arith   = Sig { (+) : t -> t -> t, (-) : t -> t -> t, (*) : t -> t -> t, (/) : t -> t -> t, zero : t }.
Add     = Sig { (+) : t -> t -> t, zero : t }.
Eq      = Sig { (==) : t -> t -> Bool }.
Ord     = Sig { (<) : t -> t -> Bool, (<=) : t -> t -> Bool }.
Functor = Sig { map : (a -> b) -> t a -> t b }.
Seq     = Sig { fold : (b -> a -> b) -> b -> t a -> b, len : t a -> Int }.

# ---- value structures over primitives ---------------------------------------

Int = Struct Arith Eq Ord {
  (+) = fn a b -> a + b,
  (-) = fn a b -> a - b,
  (*) = fn a b -> a * b,
  (/) = fn a b -> a / b,
  zero = 0,
  (==) = fn a b -> a == b,
  (<) = fn a b -> a < b,
  (<=) = fn a b -> a <= b,
  abs = fn a -> case a < 0 of True -> 0 - a | False -> a,
  min = fn a b -> case a < b of True -> a | False -> b,
  max = fn a b -> case a > b of True -> a | False -> b,
  mod = fn a b -> a - (a / b) * b,
  neg = fn a -> 0 - a,
  pow = fn a n -> intPow a n
}.
# `^` resolves here: exact exponentiation by squaring.  A negative
# exponent has no exact answer and is refused by name, as in Sol.
intPow : unsafe Int -> Int -> Int .
intPow a n = case n < 0 of
    True -> error "(^): negative exponent"
  | False -> case n == 0 of
      True -> 1
    | False -> case n - (n / 2) * 2 == 0 of
        True -> intSq (intPow a (n / 2))
      | False -> a * intPow a (n - 1).
intSq x = x * x.

# the CHECKED decimal parse a generated message codec uses (FPRISC.hs codecFor):
# the whole string, an optional leading "-", digits -- or an Err
wireInt : String -> Result Int String .
wireInt s = case strlen s == 0 of
    True -> Err "not a number"
  | False -> (case charAt s 0 == 45 of
      True -> (case strlen s == 1 of True -> Err "not a number" | False -> wireDigits s 1 0 True)
    | False -> wireDigits s 0 0 False).
wireDigits : unsafe String -> Int -> Int -> Bool -> Result Int String .
wireDigits s i acc neg = case i >= strlen s of
    True -> Ok (case neg of True -> 0 - acc | False -> acc)
  | False -> (case charAt s i >= 48 and charAt s i <= 57 of
      True -> wireDigits s (i + 1) (acc * 10 + (charAt s i - 48)) neg
    | False -> Err "not a number").

# ---- Wire: the neutral tree a generated codec speaks (FPRISC.hs encE / decE) --------
# `@Msg` and `@Model.field` literals carry `enc : a -> Wire` and
# `dec : Wire -> Result a String`, generated from the type's declaration out of
# these names.  std/json turns a Wire into text and back.  A decoder is LENIENT
# about text where a number or a boolean is wanted ("10", "true"): what comes
# from a page's client state is always text.
Wire = Type (WInt Int | WStr String | WBool Bool | WList (List Wire) | WRec (List (String, Wire)) | WCon String (List Wire)).

wireMap : unsafe (a -> Wire) -> List a -> List Wire .
wireMap f xs = case xs of Nil -> Nil | x :: r -> f x :: wireMap f r.

wireAnd : Result a String -> (a -> Result b String) -> Result b String .
wireAnd r f = case r of Ok x -> f x | Err e -> Err e.

# name the place an error came from: "notes.2: expected a string"
wireAt : String -> Result a String -> Result a String .
wireAt place r = case r of Ok x -> Ok x | Err e -> Err (strcat place (strcat ": " e)).

wireToInt : Wire -> Result Int String .
wireToInt w = case w of WInt n -> Ok n | WStr t -> wireInt t | _ -> Err "expected a number".

wireToStr : Wire -> Result String String .
wireToStr w = case w of WStr t -> Ok t | WInt n -> Ok (str n) | _ -> Err "expected a string".

wireToBool : Wire -> Result Bool String .
wireToBool w = case w of
    WBool b -> Ok b
  | WStr t -> (case t == "True" or t == "true" of
      True -> Ok True
    | False -> (case t == "False" or t == "false" of True -> Ok False | False -> Err "expected True or False"))
  | _ -> Err "expected True or False".

wireToList : (Wire -> Result a String) -> Wire -> Result (List a) String .
wireToList dec w = case w of WList xs -> wireListGo dec xs 0 Nil | _ -> Err "expected a list".
wireListGo : unsafe (Wire -> Result a String) -> List Wire -> Int -> List a -> Result (List a) String .
wireListGo dec xs i acc = case xs of
    Nil -> Ok (wireRev acc Nil)
  | x :: r -> (case dec x of Ok v -> wireListGo dec r (i + 1) (v :: acc) | Err e -> Err (strcat (str i) (strcat ": " e))).
wireRev : unsafe List a -> List a -> List a .
wireRev xs acc = case xs of Nil -> acc | x :: r -> wireRev r (x :: acc).

wireField : unsafe String -> List (String, Wire) -> Result Wire String .
wireField name fs = case fs of
    Nil -> Err "missing"
  | (k, v) :: r -> (case k == name of True -> Ok v | False -> wireField name r).

# a constructor: WCon name fields, or the list [name, field, ...] text gives
wireCon : Wire -> Result (String, List Wire) String .
wireCon w = case w of
    WCon n as -> Ok (n, as)
  | WList (WStr n :: as) -> Ok (n, as)
  | _ -> Err "expected a message: [name, field, ...]".

# ---- Str: (+) concatenates; (-) is DEconcatenation --------------------------
# (a + b) - b == a: removes b when it is a suffix of a, else a unchanged.
strTake s n = strTakeGo s n 0 "".
strTakeGo : unsafe String -> Int -> Int -> String -> String .
strTakeGo s n i acc = case i >= n of True -> acc | False -> strTakeGo s n (i + 1) (strcat acc (chr (charAt s i))).
strSufEq : unsafe String -> String -> Int -> Int -> Bool .
strSufEq s t off i = case i >= strlen t of True -> True | False -> strSufEqAt s t off i.
strSufEqAt : unsafe String -> String -> Int -> Int -> Bool .
strSufEqAt s t off i = case charAt s (off + i) == charAt t i of True -> strSufEq s t off (i + 1) | False -> False.
strSub a b =
  la = strlen a;
  lb = strlen b;
  case lb > la of
    True -> a
  | False -> strSubGo a b la lb.
strSubGo a b la lb = case strSufEq a b (la - lb) 0 of True -> strTake a (la - lb) | False -> a.

# ---- string order, search and parse (were C in runtime.c) -------------------
# Same names and contracts as Sol's natives: byte strings, 0-based, -1 = not
# found (docs/2026-10-02-ZERO-BASED.md).  strJoin stays a primitive: it is
# one allocation and a copy, which repeated strcat cannot be.

# -1, 0, 1: bytewise, the shorter first on a tie
strCmp : String -> String -> Int .
strCmp a b = strCmpGo a b 0 (strlen a) (strlen b).
strCmpGo : unsafe String -> String -> Int -> Int -> Int -> Int .
strCmpGo a b i la lb = case i >= la or i >= lb of
    True -> (case la == lb of True -> 0 | False -> (case la < lb of True -> 0 - 1 | False -> 1))
  | False -> strCmpAt a b i la lb (charAt a i) (charAt b i).
strCmpAt : unsafe String -> String -> Int -> Int -> Int -> Int -> Int -> Int .
strCmpAt a b i la lb ca cb = case ca == cb of
    True -> strCmpGo a b (i + 1) la lb
  | False -> (case ca < cb of True -> 0 - 1 | False -> 1).

# the first match of p in s at or after `from` (a negative from is 0); -1 = none
strIndexFrom : String -> String -> Int -> Int .
strIndexFrom p s from = strIndexGo p s (case from < 0 of True -> 0 | False -> from) (strlen p) (strlen s).
strIndexGo : unsafe String -> String -> Int -> Int -> Int -> Int .
strIndexGo p s i lp ls = case lp == 0 of
    True -> (case i <= ls of True -> i | False -> 0 - 1)
  | False -> (case i + lp > ls of
      True -> 0 - 1
    | False -> (case strMatchAt p s i 0 lp of True -> i | False -> strIndexGo p s (i + 1) lp ls)).
strMatchAt : unsafe String -> String -> Int -> Int -> Int -> Bool .
strMatchAt p s i k lp = case k >= lp of
    True -> True
  | False -> (case charAt s (i + k) == charAt p k of True -> strMatchAt p s i (k + 1) lp | False -> False).
strIndexOf : String -> String -> Int .
strIndexOf p s = strIndexFrom p s 0.

# decimal, a leading "-" allowed, stops at the first non-digit; no digits is 0.
# The lenient parse; wireInt above is the checked one.
parseInt : String -> Int .
parseInt s = case strlen s == 0 of
    True -> 0
  | False -> (case charAt s 0 == 45 of
      True -> 0 - parseDigits s 1 0
    | False -> parseDigits s 0 0).
parseDigits : unsafe String -> Int -> Int -> Int .
parseDigits s i acc = case i >= strlen s of
    True -> acc
  | False -> parseDigit s i acc (charAt s i).
parseDigit : unsafe String -> Int -> Int -> Int -> Int .
parseDigit s i acc c = case c >= 48 and c <= 57 of
    True -> parseDigits s (i + 1) (acc * 10 + (c - 48))
  | False -> acc.

# ---- module tables: lookup and compatibility (were C in runtime/mod.c) ------
# mod.c is the registry and reads rows: Mod.plugs, Mod.hashAt, Mod.rows t and
# Mod.rowHash/rowName/rowIface/rowFn/rowArity t i.  Table -1 is the image's
# own; 0.. are attachments in attach order.  A miss is (0, 0), as it was.
modMiss : Unit -> (Int, a) .
modMiss u = (0, Mod.rowFn (0 - 2) 0).

# the first row of table t at or after i that p accepts; -1 = none
modRow : unsafe Int -> Int -> Int -> (Int -> Bool) -> Int .
modRow t i n p = case i >= n of
    True -> 0 - 1
  | False -> (case p i of True -> i | False -> modRow t (i + 1) n p).
modRowIn : Int -> (Int -> Bool) -> Int .
modRowIn t p = modRow t 0 (Mod.rows t) p.
modHit : Int -> Int -> (Unit -> (Int, a)) -> (Int, a) .
modHit t i next = case i >= 0 of True -> (1, Mod.rowFn t i) | False -> next Unit.

# does the image carry this module at all? (what a remote node answers an
# FPRLive resolve probe with)
modHas : String -> Bool .
modHas h = modHasFrom h (0 - 1) (Mod.plugs 0).
modHasFrom : unsafe String -> Int -> Int -> Bool .
modHasFrom h t n = case t >= n of
    True -> False
  | False -> (case modRowIn t (fn i -> Mod.rowHash t i == h) >= 0 of True -> True | False -> modHasFrom h (t + 1) n).

# (1, fn) | (0, 0) by (hash, name), the image's own table first: the
# URL-service resolver contract, where a miss is data
modResolve : String -> String -> (Int, a) .
modResolve h name = modResolveFrom h name (0 - 1) (Mod.plugs 0).
modResolveFrom : unsafe String -> String -> Int -> Int -> (Int, a) .
modResolveFrom h name t n = case t >= n of
    True -> modMiss Unit
  | False -> modHit t (modRowIn t (fn i -> Mod.rowHash t i == h and Mod.rowName t i == name)) (fn u -> modResolveFrom h name (t + 1) n).

# table t ONLY, its root module's exports: every app plugin exports the same
# names (appMeta, appInit, ...), so scoped search is what lets N apps coexist
modFindAt : Int -> String -> (Int, a) .
modFindAt t name = case t >= 0 and t < Mod.plugs 0 of
    True -> modHit t (modRowIn t (fn i -> Mod.rowHash t i == Mod.hashAt t and Mod.rowName t i == name)) (fn u -> modMiss Unit)
  | False -> modMiss Unit.

# by name only, ATTACHED tables only, NEWEST ATTACHMENT WINS: attach Math.v2
# beside Math.v1 and whoever re-resolves binds v2, while calls already in v1
# run to completion (the old table and image stay mapped)
modFind : String -> (Int, a) .
modFind name = modFindDown name (Mod.plugs 0 - 1).
modFindDown : unsafe String -> Int -> (Int, a) .
modFindDown name t = case t < 0 of
    True -> modMiss Unit
  | False -> modHit t (modRowIn t (fn i -> Mod.rowName t i == name)) (fn u -> modFindDown name (t - 1)).

# the live-reload gate: every root export of table o is in table n with the
# same arity and the same checked type, contract and ABI.  (1, "") or the
# first reason it is not.  Stamps are compiler claims for trusted images,
# not signatures.
modCompatAt : Int -> Int -> (Int, String) .
modCompatAt o n = case o >= 0 and o < Mod.plugs 0 and n >= 0 and n < Mod.plugs 0 of
    True -> modCompatRows o n 0 (Mod.rows o) 0
  | False -> (0, "no such attached table").
modCompatRows : unsafe Int -> Int -> Int -> Int -> Int -> (Int, String) .
modCompatRows o n i rows checked = case i >= rows of
    True -> (case checked == 0 of True -> (0, "old module has no callable root exports") | False -> (1, ""))
  | False -> (case Mod.rowHash o i == Mod.hashAt o of
      True -> modCompatRow o n i rows checked
    | False -> modCompatRows o n (i + 1) rows checked).
modCompatRow : unsafe Int -> Int -> Int -> Int -> Int -> (Int, String) .
modCompatRow o n i rows checked = case Mod.rowIface o i == "" of
    True -> (0, "old export has no checked interface")
  | False -> modCompatMatch o n i rows checked (modRowIn n (fn j -> Mod.rowHash n j == Mod.hashAt n and Mod.rowName n j == Mod.rowName o i)).
modCompatMatch : unsafe Int -> Int -> Int -> Int -> Int -> Int -> (Int, String) .
modCompatMatch o n i rows checked j = case j < 0 of
    True -> (0, "export missing in the new module")
  | False -> (case Mod.rowArity n j == Mod.rowArity o i of
      False -> (0, "arity changed for an export")
    | True -> (case Mod.rowIface n j == "" of
        True -> (0, "new export has no checked interface")
      | False -> (case Mod.rowIface n j == Mod.rowIface o i of
          False -> (0, "checked type, contract or ABI changed for an export")
        | True -> modCompatRows o n (i + 1) rows (checked + 1)))).

Mod = Struct {
  find = fn name -> modFind name,
  findAt = fn t name -> modFindAt t name,
  resolve = fn h name -> modResolve h name,
  has = fn h -> modHas h,
  compatAt = fn o n -> modCompatAt o n
}.

Str = Struct Add Eq {
  (+) = fn a b -> strcat a b,
  (-) = fn a b -> strSub a b,
  zero = "",
  (==) = fn a b -> a == b,
  len = fn s -> strlen s,
  at = fn s i -> charAt s i,
  fromCode = fn c -> chr c,
  parse = fn s -> parseInt s
}.

# ---- List: (+) appends; (-) removes a matching suffix -----------------------
listAppend : unsafe List c29 -> List c29 -> List c29 .
listAppend a b = case a of Nil -> b | x :: r -> x :: listAppend r b.
listLen : unsafe List d29 -> Int .
listLen l = case l of Nil -> 0 | _ :: r -> 1 + listLen r.
listTake : unsafe List e29 -> Int -> List e29 .
listTake l n = case n <= 0 of True -> Nil | False -> listTakeGo l n.
listTakeGo : unsafe List f29 -> Int -> List f29 .
listTakeGo l n = case l of Nil -> Nil | x :: r -> x :: listTake r (n - 1).
listDrop : unsafe List g29 -> Int -> List g29 .
listDrop l n = case n <= 0 of True -> l | False -> listDropGo l n.
listDropGo : unsafe List h29 -> Int -> List h29 .
listDropGo l n = case l of Nil -> Nil | _ :: r -> listDrop r (n - 1).
listSub a b =
  la = listLen a;
  lb = listLen b;
  case lb > la of
    True -> a
  | False -> listSubGo a b la lb.
# elementwise: whole-value == on cons cells is tag-shallow by design
listPrefEq : unsafe List j29 -> List j29 -> Bool .
listPrefEq a b = case b of Nil -> True | y :: br -> listPrefEqAt a y br.
listPrefEqAt : unsafe List k29 -> k29 -> List k29 -> Bool .
listPrefEqAt a y br = case a of Nil -> False | x :: ar -> listPrefEqCmp x y ar br.
listPrefEqCmp : unsafe l29 -> l29 -> List l29 -> List l29 -> Bool .
listPrefEqCmp x y ar br = case x == y of True -> listPrefEq ar br | False -> False.
listSubGo a b la lb = case listPrefEq (listDrop a (la - lb)) b of True -> listTake a (la - lb) | False -> a.

# the blessed list recursion scheme (recursive INSIDE, marked honestly;
# callers stay safe -- the library boundary is the trust line)
listFold : unsafe (a -> b -> b) -> b -> List a -> b .
listFold f z l = case l of Nil -> z | x :: r -> listFold f (f x z) r.
listMap : (a -> b) -> (l : List a | measure l) -> List b .
listMap f l = case l of Nil -> Nil | x :: r -> f x :: listMap f r.

List = Struct Add Functor {
  fold = fn f z l -> listFold f z l,
  map = fn f l -> listMap f l,
  (+) = fn a b -> listAppend a b,
  (-) = fn a b -> listSub a b,
  zero = Nil,
  len = fn l -> listLen l,
  take = fn l n -> listTake l n,
  drop = fn l n -> listDrop l n
}.

# ---- SString: fixed 128B inline string (runtime: sstr.c) --------------------

SStr = Struct {
  cap = 128,
  new = fn u -> sstrNew u,
  len = fn s -> sstrLen s,
  at = fn s i -> sstrAt s i,
  put = fn s i c -> sstrPut s i c,
  push = fn s c -> sstrPush s c,
  fromStr = fn str -> sstrFromStr str,
  toStr = fn s -> sstrToStr s,
  clear = fn s -> sstrClear s
}.

# ---- VList: the SoA vector (vec.c), linear carrier --------------------------
# Vector a is a linear carrier with an explicit element type. VList groups
# its operations; reads/length thread the consumed handle through the result.

foldRes r = (x, _) = r; x.
lenRes r = (n, _) = r; n.

vListFromList : List Int -> Vector Int .
vListFromList xs = Vec.fromList xs.

VList = Struct {
  map = fn f v -> Vec.mapSame f v,
  fold = fn f z v -> foldRes (Vec.fold f z v),
  len = fn v -> lenRes (Vec.len v),
  new = fn u -> Vec.newAs "i",
  push = fn x v -> Vec.push x v,
  get = fn i v -> Vec.get i v,
  set = fn i x v -> Vec.set i x v,
  filter = fn p v -> Vec.filter p v,
  split = fn i v -> Vec.split i v,
  fromList = fn xs -> vListFromList xs,
  toList = fn v -> Vec.toList v,
  free = fn v -> Vec.free v
}.

# ---- namespace-only structures over the HAL (no sig, pure grouping) ---------

Actor = Struct {
  send = fn a m -> send a m,
  recv = fn a -> receive a,
  recvRes = fn a -> receiveRes a,
  self = fn u -> myself u,
  spawn = fn f -> spawn f,
  spawnOn = fn h f -> spawnOn h f,
  yield = fn a -> yield a
}.

# ---- List helpers (bare functions; List is the built-in `::`/Nil type) ------

fromTo : unsafe Int -> Int -> List Int .
fromTo a b = case a > b of True -> Nil | False -> a :: fromTo (a + 1) b.
mapV : unsafe (l31 -> m31) -> List l31 -> List m31 .
mapV f v = case v of Nil -> Nil | x :: rest -> f x :: mapV f rest.
sumV : unsafe List Int -> Int .
sumV v = case v of Nil -> 0 | x :: rest -> x + sumV rest.

zipV : unsafe List f -> List j -> List (f, j) .
zipV xs ys = case (xs, ys) of
    (x :: xr, y :: yr) -> (x, y) :: zipV xr yr
  | _ -> Nil.
fstV : unsafe List (n31, o31) -> List n31 .
fstV ps = case ps of Nil -> Nil | (a, _) :: rest -> a :: fstV rest.
sndV : unsafe List (q31, p31) -> List p31 .
sndV ps = case ps of Nil -> Nil | (_, b) :: rest -> b :: sndV rest.
mapFstV : unsafe (r31 -> t31) -> List (r31, s31) -> List (t31, s31) .
mapFstV f ps = case ps of Nil -> Nil | (a, b) :: rest -> (f a, b) :: mapFstV f rest.
mapSndV : unsafe (v31 -> w31) -> List (u31, v31) -> List (u31, w31) .
mapSndV f ps = case ps of Nil -> Nil | (a, b) :: rest -> (a, f b) :: mapSndV f rest.

# ---- process/system seam + actor fork-join ---------------------------------

heapUsed : Unit -> Int.

parWorker self =
  case receive self of
    (parent, f, a) -> send parent (Ok (f a)).

# ---- the service shape, as ONE primitive ------------------------------------
# Every hand-written receive/destructure/dispatch/reply/drop loop is this
# function; the runtime-owned roots mean the drop can never go missing
# again (the gfxServe crash-loop class is unwritable through serve).
# The handler is pure: (state, request) in, (state, reply) out.  Replies
# may reference anything -- send deep-copies, so even parts of the
# request are safe to hand back (the copy happens BEFORE the drop).
# `ask` is the calling half: send (me, q), wait for the reply from a.

serve : unsafe Int -> (st -> q -> (st, r)) -> st -> a.
serve self h st =
  m = receive self;
  (rt, q) = m;
  (st2, r) = h st q;
  _ = send rt r;
  _ = drop m;
  serve self h st2.

ask : unsafe Int -> Int -> q -> r.
ask me a q =
  _ = send a (me, q);
  receiveFrom me a.

par2 h f a g b =
  me = myself 0;
  w = spawnOn h parWorker;
  _ = send w (me, f, a);
  rb = g b;
  case receiveRes me of
    Ok ra -> (ra, rb)
  | Err _ -> error "par2: the worker failed".

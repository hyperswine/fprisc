# Linode HTTPS -> private Tailscale TCP forward -> macm4 loopback dashboard.
# Access is configured separately in /etc/nginx/snippets/3dprint-access.conf.
map $http_upgrade $printer_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    listen [::]:80;
    server_name 3dprint.cswine.cloud;
    location /.well-known/acme-challenge/ { root /var/www/3dprint-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name 3dprint.cswine.cloud;
    ssl_certificate /etc/letsencrypt/live/3dprint.cswine.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/3dprint.cswine.cloud/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    include /etc/nginx/snippets/3dprint-access.conf;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location / {
        proxy_pass http://100.94.229.117:6730;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $printer_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # MJPEG frames and FP-RISC updates must flush immediately.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
    }
}

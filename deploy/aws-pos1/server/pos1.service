[Unit]
Description=POS v1 (FP-RISC examples/pos1.fpr, std/live)
After=network-online.target
Wants=network-online.target

[Service]
User=pos1
Group=pos1
# /var/lib/pos1: the shop log (pos1.log) and the registers' state (pos1.log.kvlog)
StateDirectory=pos1
StateDirectoryMode=0750
WorkingDirectory=/var/lib/pos1
# loopback only: Caddy is the public face
ExecStart=/opt/pos1/pos1 --address=127.0.0.1 --port=6710 --store=/var/lib/pos1/pos1.log
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

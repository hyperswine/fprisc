  "module_source": "unsafe base.\nValue = Type (Plus Int | Minus Int).\nTree = Type (Leaf | Branch Tree Value Tree).\nmake d n = if d <= 0 then Leaf else\n  left = make (d - 1) (n+1); right = make (d - 1) (n+2);\n  v = if n % 2 == 0 then Plus n else Minus n; Branch left v right.\nscore t = case t of Leaf -> 0 | Branch l v r -> case v of\n  Plus x -> score l + x + score r | Minus x -> score l - x + score r.\nsumTwice d = t = make d 1; a = score t; a + score t.\n",
  "client_source": "unsafe base. N = use \"std/native\". R = use \"std/reload\".\nunwrap r = case r of Ok x -> x | Err e -> error e.\nmain = _ = unwrap (N.attach \"/tmp/fpr-tree-202/boundaries/macos-x86_64.dylib\"); make = R.bindAt 0 \"make\"; read = R.bindAt 0 \"score\"; twice = R.bindAt 0 \"sumTwice\";\n  tree = keep (make 3 1); _ = print (read tree); print (twice 3).\n",

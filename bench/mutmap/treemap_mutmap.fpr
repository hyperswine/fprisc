# the treemap workload on std/mutmap: 500k inserts, 500k lookups; the keyhash
# folds the entries in ascending key order through MutMap.freeze, so the
# output is the std/map version's
Map = use "std/map".
MutMap = use "std/mutmap".
O = use "std/option".
Ord = use "std/order".

lcg : Int -> Int .
lcg x = (x * 1103515245 + 12345) % 2147483648.

inserts : (n : Int) -> (i : Int | measure (n - i)) -> Int -> MutMap Int Int -> (Int, MutMap Int Int) .
inserts n i x m = if i >= n then (x, m) else
  x2 = lcg x;
  inserts n (i + 1) x2 (MutMap.insert (x2 % 1000000) i m).

lookups : (n : Int) -> (i : Int | measure (n - i)) -> Int -> Int -> Int -> MutMap Int Int -> (Int, Int, MutMap Int Int) .
lookups n i x hits s m = if i >= n then (hits, s, m) else
  x2 = lcg x;
  (r, m2) = MutMap.get (x2 % 1000000) m;
  case r of
      O.Some v -> lookups n (i + 1) x2 (hits + 1) (s + v) m2
    | O.None -> lookups n (i + 1) x2 hits s m2.

main =
  n = 500000;
  (x, m) = inserts n 0 7 (MutMap.ints Unit);
  (hits, s, m2) = lookups n 0 x 0 0 m;
  frozen = MutMap.freeze Ord.int m2;
  print "size {Map.size frozen} hits {hits} sum {s} keyhash {Map.fold (fn h k v -> (h * 31 + k) % 1000000007) 0 frozen}".

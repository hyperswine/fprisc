# Native shared camera service. The gateway owns public HTTP authentication;
# this private loopback listener additionally requires a runtime capability.
T = use "std/transport".
OT = use "std/ownedtransport".
Sock = use "std/sockettransport".
ST = use "std/stream".
TLS = use "std/tls".
DNS = use "std/resolver".
C = use "std/connect".
R = use "std/readiness".
W = use "std/watchedtransport".
A = use "std/actor".
N = use "std/osnet".
IO = use "std/osio".
MJ = use "std/mjpeg".
H = use "std/httpcore".
HC = use "std/httpclient".
J = use "std/json".
L = use "std/list".
S = use "std/string".
O = use "std/option".
Clock = use "std/clock".
F = use "cameraframe".
Command = Type (Reserve Int | Join Int | Next Int Int | Leave Int | Observe Int String | Captured Int Int String | Fault Int | Inspect).
Reply = Type (Accepted | Refused | Waiting | Broken | Picture Int String | Snapshot J.Value).
now u = Sys.timeUs Unit / 1000.
firstFrameMs = 12000.
# Include the bounded error response and loopback relay scheduling margin.
headerBudgetMs = firstFrameMs + 2000.
budget ms = case Sock.forMs ms of Ok b -> b | Err _ -> error "camera: invalid duration".
ask me manager command = A.callWithin 500 me manager command.
initial = {tickets = Nil, viewers = Nil, source = 0, epoch = 0, seq = 0, frame = "", error = False, last = 0, wall = 0, buckets = Nil, starts = 0}.
stopSource state =
  _ = if state.source == 0 then Unit else _ = kill state.source; Unit;
  {state | source = 0, epoch = state.epoch + 1, frame = "", error = False, last = 0, wall = 0, buckets = Nil}.
expire state =
  tickets = L.filter (fn pair -> case pair of (_, until) -> until > now Unit) state.tickets;
  viewers = L.filter (fn ticket -> L.any (fn pair -> case pair of (id, _) -> id == ticket) tickets) state.viewers;
  fresh = {state | tickets = tickets, viewers = viewers};
  if viewers == Nil and (state.source != 0 or state.frame != "" or state.error) then stopSource fresh else fresh.
renew ticket state = {state | tickets = (ticket, now Unit + 3000) :: L.filter (fn pair -> case pair of (id, _) -> id != ticket) state.tickets}.
statsWith staleMs state =
  recent = L.filter (fn pair -> case pair of (second, _) -> second > now Unit / 1000 - 30) state.buckets;
  count = L.fold (fn n pair -> case pair of (_, c) -> n + c) 0 recent;
  rate = count * 100 / 30;
  J.object [("camera_state", J.Text (if state.viewers == Nil then "OFF" else if state.error then "UNAVAILABLE" else if state.last == 0 then "CONNECTING" else if now Unit - state.last > staleMs then "STALE" else "LIVE")),
    ("camera_viewers", J.Integer (L.length state.viewers)), ("camera_connections", J.Integer state.starts),
    ("camera_last_frame", J.Integer state.wall), ("camera_hz", J.Real "{rate / 100}.{S.padLeft 2 "0" (str (rate % 100))}")].
observed bytes state =
  second = now Unit / 1000;
  recent = L.filter (fn pair -> case pair of (at, _) -> at > second - 30 and at != second) state.buckets;
  old = O.withDefault (second, 0) (L.find (fn pair -> case pair of (at, _) -> at == second) state.buckets);
  count = case old of (_, n) -> n + 1;
  {state | seq = state.seq + 1, frame = bytes, last = now Unit, wall = Clock.now Unit, buckets = (second, count) :: recent}.
dispatch cfg pool watcher manager from command state = case command of
    Reserve ticket -> if L.length state.tickets >= 16 then (Refused, state) else
      # Header (2s), bounded error write (1s) and reply/release fit this lease.
      (Accepted, {state | tickets = (ticket, now Unit + 5000) :: state.tickets})
  | Join ticket -> if not (L.any (fn pair -> case pair of (id, _) -> id == ticket) state.tickets) or L.length state.viewers >= 8 then (Refused, state) else
      fresh = if state.source == 0 or state.viewers == Nil then stopSource state else state;
      epoch = fresh.epoch;
      source = if fresh.source != 0 then fresh.source else A.spawnWith (A.Static 16) (cfg.worker pool watcher manager epoch);
      (Accepted, renew ticket {fresh | viewers = ticket :: fresh.viewers, source = source, error = False, starts = fresh.starts + (if fresh.source == 0 then 1 else 0)})
  | Next ticket seq -> if not (L.member ticket state.viewers) then (Refused, state) else
      (if state.error then Broken else if state.seq > seq and state.frame != "" then Picture state.seq state.frame else Waiting, renew ticket state)
  | Leave ticket ->
      fresh = {state | viewers = L.filter (fn id -> id != ticket) state.viewers, tickets = L.filter (fn pair -> case pair of (id, _) -> id != ticket) state.tickets};
      (Accepted, if fresh.viewers == Nil then stopSource fresh else fresh)
  | Observe epoch bytes -> if epoch != state.epoch or from != state.source or state.viewers == Nil then (Refused, state) else (Accepted, observed bytes state)
  | Captured epoch wall bytes -> if epoch != state.epoch or from != state.source or state.viewers == Nil then (Refused, state) else
      (Accepted, {observed bytes state | wall = wall})
  | Fault epoch -> if epoch != state.epoch or from != state.source then (Refused, state) else (Accepted, {state | error = True, source = 0, frame = ""})
  | Inspect -> (Snapshot (statsWith cfg.staleMs state), state).
stats state = statsWith 10000 state.
managerStep cfg pool watcher me state =
  fresh = expire state;
  case receiveNow me of
    Err _ -> _ = Clock.sleepMs 10; (True, fresh)
  | Ok message ->
      (from, id, borrowed) = message;
      command = keep borrowed;
      _ = drop message;
      (reply, next) = dispatch cfg pool watcher me from command fresh;
      _ = A.reply (from, id) reply;
      (True, next).
manager cfg pool watcher me = _ = Sys.loop initial (managerStep cfg pool watcher me); Unit.
worker cfg pool watcher manager epoch me =
  limit = budget 5000;
  result = case OT.connectWith (W.wait watcher) limit pool cfg.host cfg.port 16384 of
      OT.OpenFailed why -> Err why
    | OT.Opened tcp -> (case OT.upgrade limit cfg.peer (TLS.CaFile cfg.ca) TLS.TLS12 tcp of
        OT.OpenFailed why -> Err why
      | OT.Opened secure ->
          (sent, next) = OT.writeAll limit cfg.login secure;
          (case sent of
              Err (why, _) -> _ = OT.close next; Err why
            | Ok _ ->
                (_, terminal) = Sys.loop (True, next) (sourceStep manager epoch me cfg.maxFrame);
                _ = OT.close terminal;
                Ok Unit));
  _ = ask me manager (Fault epoch);
  Unit.
sourceStep manager epoch me maximum state =
  (_, conn) = state;
  (result, next) = F.readOwned (budget 10000) maximum conn;
  case result of
    Err _ -> (False, (False, next))
  | Ok bytes -> (case ask me manager (Observe epoch bytes) of
      Ok Accepted -> (True, (True, next))
    | _ -> (False, (False, next))).
# One request in flight per printer, shared by all viewers. Decoder failures
# back off and retry while selected; old bytes are never republished as fresh.
snapshotWorker cfg pool watcher manager epoch me =
  _ = Sys.loop Unit (fn u ->
    began = now Unit;
    options = {HC.defaults | timeoutMs = 9500, bodyBytes = cfg.maxFrame};
    request = {method = "GET", url = "http://127.0.0.1:{cfg.port}/snapshot/{cfg.id}.jpg",
      headers = [("x-printer-camera-code", cfg.code)], body = ""};
    result = HC.requestOn (W.wait watcher) (budget 9500) pool options request;
    _ = case result of
      Ok response -> if response.status != 200 or not (F.jpeg response.body) then Unit else
        wall = case H.header "x-camera-captured-at" response of O.Some value -> (case S.toInt value of Ok n -> n | _ -> 0) | _ -> 0;
        if wall <= 0 or wall > Clock.now Unit + 5 or Clock.now Unit - wall > 10 then Unit else
          _ = ask me manager (Captured epoch wall response.body); Unit
    | _ -> Unit;
    remaining = cfg.intervalMs - (now Unit - began);
    _ = Clock.sleepMs (if remaining > 0 then remaining else 1000);
    (True, Unit)); Unit.
respond status body connection =
  (_, next) = ownedParts (budget 1000) [H.renderResponse (H.text status body)] connection; next.
respondStats value connection =
  (_, next) = ownedParts (budget 1000) [H.renderResponse (H.json 200 (J.render value))] connection; next.
request gate head extra = case S.split "\r\n" head of
    Nil -> Err 400
  | line :: lines ->
      headers = H.parseHeaders lines;
      keys = L.filter (fn pair -> case pair of (key, _) -> key == "x-fpr-camera") headers;
      lengths = L.filter (fn pair -> case pair of (key, _) -> key == "content-length") headers;
      if L.length lines > 64 or not (L.all (fn line -> strIndexOf ":" line > 0) lines) or L.length lengths > 1 or extra != "" or H.header "transfer-encoding" {headers = headers} != O.None or
         (case H.header "content-length" {headers = headers} of O.None -> False | O.Some n -> n != "0") then Err 400 else
      if keys != [("x-fpr-camera", gate)] then Err 403 else
      (case S.split " " line of ["GET", path, "HTTP/1.1"] -> if path == "/stream" or path == "/stats" then Ok path else Err 404 | _ -> Err 405).
connected connection = OT.connected (budget 100) connection.
viewerStep waitMs me manager ticket maximum state =
  (conn, seq, begun, until) = state;
  (alive, checked) = connected conn;
  if not alive or now Unit >= until then (False, (checked, seq, begun, until)) else
  case ask me manager (Next ticket seq) of
    Ok (Picture id bytes) ->
      limit = budget 1500;
      (header, started) = if begun then (Ok Unit, checked) else ownedParts limit [MJ.head] checked;
      (sent, next) = case header of Err why -> (Err why, started) | Ok _ -> ownedWrite limit maximum bytes started;
      (case sent of Ok _ -> True | Err _ -> False, (next, id, True, now Unit + waitMs))
  | Ok Waiting -> _ = Clock.sleepMs 25; (True, (checked, seq, begun, until))
  | _ -> (False, (checked, seq, begun, until)).
handle cfg manager ticket raw me =
  case OT.adopt 16384 (ST.Stream raw) of
    OT.OpenFailed _ -> _ = IO.close raw; _ = ask me manager (Leave ticket); Unit
  | OT.Opened conn ->
      (header, next) = ownedHead (budget 2000) 8192 conn;
      final = case header of
          Err _ -> respond 400 "Invalid request\n" next
        | Ok (head, extra) -> (case request cfg.gate head extra of
            Err status -> respond status "Camera request refused\n" next
          | Ok "/stats" -> (case ask me manager Inspect of
              Ok (Snapshot value) -> respondStats value next
            | _ -> respond 503 "Camera unavailable\n" next)
          | Ok _ -> (case ask me manager (Join ticket) of
              Ok Accepted ->
                (last, _, begun, _) = Sys.loop (next, 0, False, now Unit + firstFrameMs) (viewerStep cfg.waitMs me manager ticket cfg.maxFrame);
                if begun then last else respond 503 "Camera unavailable\n" last
            | _ -> respond 503 "Camera busy\n" next));
      _ = OT.close final;
      _ = ask me manager (Leave ticket);
      Unit.
acceptStep cfg manager listener me count = case IO.ready listener of
    False -> _ = Clock.sleepMs 1; (True, count)
  | True -> (case N.accept listener of
      Err _ -> _ = Clock.sleepMs 5; (True, count)
    | Ok (fd, _) ->
        ticket = Sys.nextId Unit;
        _ = (case ask me manager (Reserve ticket) of
          Ok Accepted -> _ = A.spawnWith (A.Static 16) (handle cfg manager ticket fd); Unit
        | _ -> _ = IO.close fd; Unit);
        (True, count + 1)).
start cfg = startUsing {gate = cfg.gate, maxFrame = cfg.maxFrame, worker = worker cfg, staleMs = 10000, waitMs = 12000}.
startSnapshot cfg = startUsing {gate = cfg.gate, maxFrame = cfg.maxFrame, worker = snapshotWorker cfg,
  staleMs = cfg.intervalMs + 10000, waitMs = cfg.intervalMs + 12000}.
startUsing cfg =
  pool = case DNS.create 1 of Ok p -> p | Err _ -> error "camera: resolver unavailable";
  watcher = R.start Unit;
  service = A.spawnWith (A.Static 64) (manager cfg pool watcher);
  listener = case N.listen "127.0.0.1" 0 of Ok fd -> fd | Err _ -> error "camera: listener unavailable";
  port = case N.localPort listener of Ok p -> p | Err _ -> 0;
  acceptor = A.spawnWith (A.Static 16) (fn me -> _ = Sys.loop 0 (acceptStep cfg service listener me); Unit);
  {port = port, manager = service, acceptor = acceptor}.
run cfg =
  service = start cfg;
  _ = print "camera-ready {service.port}";
  _ = receive (myself 0);
  Unit.

ownedParts budget pieces owner = OT.Connection raw = owner; (r, next) = MJ.parts budget pieces raw; (r, OT.Connection next).
ownedWrite budget limit bytes owner = OT.Connection raw = owner; (r, next) = MJ.write budget limit bytes raw; (r, OT.Connection next).
ownedHead budget limit owner = OT.Connection raw = owner; (r, next) = MJ.readHead budget limit raw; (r, OT.Connection next).

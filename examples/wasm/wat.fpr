# wat.fpr -- WebAssembly text format -> a wasmvm program, ported from the
# Haskell HaskPlayground/src/WASM/WatParser.hs.
#
# Module fields:
#   (type $t (func (param ..) (result ..)))
#   (import "mod" "name" (func $f (type $t) | (param ..)* (result ..)*))
#   (memory [$m] min [max])            (table [$t] n funcref)
#   (elem (i32.const n) [func] $f ...) (global $g (mut T)|T (T.const c))
#   (data (i32.const n) "...")         (export "n" (func $f))   (start $f)
#   (func $f (export "n")? (type $t)? (param $p T)* (result T)* (local $l T)* body)
#
# Instructions: everything in wasmvm's Instr, by its standard name, with
# memargs (offset= align=), br_table, call_indirect (type $t), folded and flat
# forms mixed, named labels resolved to depths.
#
# Not supported: flat `block ... end`, typed select, more than one memory or
# table, (elem) offsets other than i32.const, hexadecimal float literals.
#
#   parse source = Ok {program = p, funcNames = names} | Err why
#
# How it is written (docs/2026-10-03-STYLE-DIRECTION.md).  The source is
# external input, so everything it can get wrong is an Err.  Reading is
# folds with no recursion of our own: bytes to tokens (a state machine, one
# clause per state and byte), tokens to a tree (a stack), and the digits of
# a float; integers are I64.parse.
# The instruction compiler walks the tree and is the one recursive group; it
# descends into sub-lists, which the measure checker cannot follow, so it is
# marked unsafe, and with it everything that reaches it, up to `parse`.

List = use "std/list".
Map = use "std/map".
O = use "std/option".
R = use "std/result".
String = use "std/string".
V = use "wasmvm".

# ---- bytes ------------------------------------------------------------------------

isSpace c = c == 32 or c == 9 or c == 10 or c == 13 or c == 12.
isDigit c = c >= 48 and c <= 57.
hexVal c | isDigit c = c - 48.
hexVal c | c >= 97 and c <= 102 = c - 87.
hexVal c | c >= 65 and c <= 70 = c - 55.
hexVal _ = 0 - 1.

# ---- tokens: a state machine over the bytes ------------------------------------

Tok = Type (TOpen | TClose | TAtom String | TStr String).

# OpenSeen: a '(' that may begin "(;".   SemiSeen: a ';' that must begin ";;".
# HexDigit: the first digit of a \hh escape.  BlockSemi: a ';' inside (; ;).
Mode = Type (Idle | InAtom | InQuote | Escaped | HexDigit Int | OpenSeen | SemiSeen | LineComment | BlockComment | BlockSemi).

# text: the bytes of the atom or string being read, newest first.
# toks: the tokens so far, newest first.  err: "" until something is wrong.
Lexer = { mode : Mode, text : List String, toks : List Tok, err : String }.

emit : Tok -> Lexer -> Lexer .
emit tok st = {st | toks = tok :: st.toks}.
word st = st.text |> List.reverse |> strJoin "".
refused why st = {st | err = why}.
kept c st = {st | text = chr c :: st.text}.
inQuote c st = {st | mode = InQuote, text = chr c :: st.text}.

feed : Lexer -> Int -> Lexer .
feed st _ | st.err != "" = st.
feed st c = lexed st.mode c st.

lexed : Mode -> Int -> Lexer -> Lexer .
lexed Idle c st = idle c st.
lexed InAtom c st | isSpace c or c == 40 or c == 41 or c == 34 or c == 59 = idle c (emit (TAtom (word st)) st).
lexed InAtom c st = kept c st.
lexed InQuote 34 st = emit (TStr (word st)) {st | mode = Idle}.
lexed InQuote 92 st = {st | mode = Escaped}.
lexed InQuote c st = kept c st.
lexed Escaped c st = escaped c st.
lexed (HexDigit hi) c st | hexVal c >= 0 = inQuote (16 * hi + hexVal c) st.
lexed (HexDigit _) _ st = refused "bad string escape" st.
lexed OpenSeen 59 st = {st | mode = BlockComment}.
lexed OpenSeen c st = idle c (emit TOpen st).
lexed SemiSeen 59 st = {st | mode = LineComment}.
lexed SemiSeen _ st = refused "unexpected ';'" st.
lexed LineComment 10 st = {st | mode = Idle}.
lexed LineComment _ st = st.
lexed BlockComment 59 st = {st | mode = BlockSemi}.
lexed BlockComment _ st = st.
lexed BlockSemi 41 st = {st | mode = Idle}.
lexed BlockSemi 59 st = st.
lexed BlockSemi _ st = {st | mode = BlockComment}.

# a byte met between tokens
idle : Int -> Lexer -> Lexer .
idle c st | isSpace c = {st | mode = Idle}.
idle 40 st = {st | mode = OpenSeen}.
idle 41 st = emit TClose {st | mode = Idle}.
idle 34 st = {st | mode = InQuote, text = Nil}.
idle 59 st = {st | mode = SemiSeen}.
idle c st = {st | mode = InAtom, text = [chr c]}.

# the byte after a backslash
escaped : Int -> Lexer -> Lexer .
escaped 110 st = inQuote 10 st.
escaped 116 st = inQuote 9 st.
escaped 114 st = inQuote 13 st.
escaped 34 st = inQuote 34 st.
escaped 39 st = inQuote 39 st.
escaped 92 st = inQuote 92 st.
escaped c st | hexVal c >= 0 = {st | mode = HexDigit (hexVal c)}.
escaped _ st = refused "bad string escape" st.

# what the end of the input means in each state
ended : Mode -> Lexer -> Result (List Tok) String .
ended InAtom st = Ok (List.reverse (TAtom (word st) :: st.toks)).
ended OpenSeen st = Ok (List.reverse (TOpen :: st.toks)).
ended InQuote _ = Err "unterminated string".
ended Escaped _ = Err "unterminated string".
ended (HexDigit _) _ = Err "unterminated string".
ended SemiSeen _ = Err "unexpected ';'".
ended _ st = Ok (List.reverse st.toks).

lexedAll : Lexer -> Result (List Tok) String .
lexedAll st | st.err != "" = Err st.err.
lexedAll st = ended st.mode st.

tokens : String -> Result (List Tok) String .
tokens src = String.codes src |> List.fold feed {mode = Idle, text = Nil, toks = Nil, err = ""} |> lexedAll.

# ---- S-expressions: a stack of the lists still open ---------------------------

SExp = Type (Atom String | Str String | SList (List SExp)).

# open: the lists being read, innermost first, each newest first
Nest = { open : List (List SExp), err : String }.

place : Nest -> Tok -> Nest .
place st _ | st.err != "" = st.
place st TOpen = {st | open = Nil :: st.open}.
place st TClose = closed st.open st.
place st (TAtom a) = added (Atom a) st.open st.
place st (TStr s) = added (Str s) st.open st.

added e (top :: under) st = {st | open = (e :: top) :: under}.
added _ Nil st = st.
closed (top :: under :: rest) st = {st | open = (SList (List.reverse top) :: under) :: rest}.
closed _ st = {st | err = "unexpected ')'"}.

nested : Nest -> Result (List SExp) String .
nested st | st.err != "" = Err st.err.
nested st = topLevel st.open.
topLevel (top :: Nil) = Ok (List.reverse top).
topLevel _ = Err "unclosed '('".

tree : List Tok -> Result (List SExp) String .
tree toks = List.fold place {open = [Nil], err = ""} toks |> nested.

tokenize : String -> Result (List SExp) String .
tokenize src = tokens src |> R.andThen tree.

# ---- small helpers ---------------------------------------------------------------

isDollar a = strlen a > 0 and charAt a 0 == 36.
isName (Atom a) = isDollar a.
isName _ = False.
allDigits a = strlen a > 0 and List.all isDigit (String.codes a).
unnamed a = not (isDollar a).

# the rest of every (kind ...) field
restOf kind (SList (Atom k :: rest)) | k == kind = O.Some rest.
restOf _ _ = O.None.
fieldsOf kind fields = List.filterMap (restOf kind) fields.

headIs kinds (SList (Atom k :: _)) = List.member k kinds.
headIs _ _ = False.

atomOf (Atom a) = O.Some a.
atomOf _ = O.None.
atomsOf es = List.filterMap atomOf es.
strOf (Str s) = O.Some s.
strOf _ = O.None.
strsOf es = List.filterMap strOf es.

orErr why (O.Some x) = Ok x.
orErr why O.None = Err why.

# every item through a fallible step, in order
each f xs = List.map f xs |> R.collect.

strOrder = (case Map.strings of Map.Map cmp _ _ -> cmp).
intOrder = (case Map.ints of Map.Map cmp _ _ -> cmp).
byName pairs = Map.fromList strOrder pairs.

# ---- numbers --------------------------------------------------------------------

signOf text = charAt (strcat text " ") 0.
unsigned text = String.dropLeft 1 text.

# an integer literal as an i64: sign, 0x, and _ separators (I64.parse; a
# magnitude past the signed range wraps, as a wasm literal's does)
badInteger text _ = "bad integer: {text}".
readI64 : String -> Result I64 String .
readI64 text = I64.parse text |> R.mapError (badInteger text).

# the low 32 bits: an i32 constant, an offset, a count
readInt : String -> Result Int String .
readInt text = readI64 text |> R.map I64.lo.

# A decimal float: digits [. digits] [e [sign] digits].  The digits are read
# as one integer-valued double and scaled once by a power of ten.
Part = Type (Whole | Fraction | ExpSign | ExpDigits).
Decimal = { m : F64, seen : Int, frac : Int, part : Part, down : Bool, exp : Int, expSeen : Int, bad : Bool }.

isE c = c == 101 or c == 69.

mantissa : Int -> Decimal -> Decimal .
mantissa c st = {st | m = st.m * 10.0 + F64.ofInt (c - 48), seen = st.seen + 1}.
fraction : Int -> Decimal -> Decimal .
fraction c st = mantissa c {st | frac = st.frac + 1}.
expDigit : Int -> Decimal -> Decimal .
expDigit c st = {st | part = ExpDigits, exp = st.exp * 10 + c - 48, expSeen = st.expSeen + 1}.

decimalByte : Decimal -> Int -> Decimal .
decimalByte st _ | st.bad = st.
decimalByte st 95 = st.
decimalByte st c = inPart st.part c st.

inPart : Part -> Int -> Decimal -> Decimal .
inPart Whole c st | isDigit c = mantissa c st.
inPart Whole 46 st = {st | part = Fraction}.
inPart Fraction c st | isDigit c = fraction c st.
inPart Whole c st | isE c and st.seen > 0 = {st | part = ExpSign}.
inPart Fraction c st | isE c and st.seen > 0 = {st | part = ExpSign}.
inPart ExpSign 45 st = {st | part = ExpDigits, down = True}.
inPart ExpSign 43 st = {st | part = ExpDigits}.
inPart ExpSign c st | isDigit c = expDigit c st.
inPart ExpDigits c st | isDigit c = expDigit c st.
inPart _ _ st = {st | bad = True}.

# powers of ten by repeated multiplication: exact up to 10^22, where F64.pow
# is not exact even for 10^1
tenTo : (k : Int | measure k) -> F64 -> F64 .
tenTo k acc | k <= 0 = acc.
tenTo k acc = tenTo (k - 1) (acc * 10.0).
scale10 : F64 -> Int -> F64 .
scale10 m k | k < 0 = m / tenTo (0 - k) 1.0.
scale10 m k = m * tenTo k 1.0.

exponentOf : Decimal -> Int .
exponentOf st | st.down = 0 - st.exp.
exponentOf st = st.exp.

complete ExpSign _ = False.
complete ExpDigits st = st.expSeen > 0.
complete _ _ = True.

decimalValue : String -> Decimal -> Result F64 String .
decimalValue text st | st.bad or st.seen == 0 or not (complete st.part st) = Err "bad float: {text}".
decimalValue _ st = Ok (scale10 st.m (exponentOf st - st.frac)).

decimal : String -> Result F64 String .
decimal text = String.codes text
  |> List.fold decimalByte {m = 0.0, seen = 0, frac = 0, part = Whole, down = False, exp = 0, expSeen = 0, bad = False}
  |> decimalValue text.

positive : String -> Result F64 String .
positive text | text == "inf" = Ok (1.0 / 0.0).
positive text | substr text 0 3 == "nan" = Ok (0.0 / 0.0).
positive text | substr text 0 2 == "0x" = I64.parse text |> R.mapError (badInteger text) |> R.map I64.toF64U.
positive text = decimal text.

negated : F64 -> F64 .
negated x = x * (0.0 - 1.0).

readFloat : String -> Result F64 String .
readFloat text | signOf text == 45 = positive (unsigned text) |> R.map negated.
readFloat text | signOf text == 43 = positive (unsigned text).
readFloat text = positive text.

# ---- types and signatures ------------------------------------------------------

valType "i32" = Ok V.TI32.
valType "i64" = Ok V.TI64.
valType "f32" = Ok V.TF32.
valType "f64" = Ok V.TF64.
valType t = Err "unknown value type {t}".

typesIn group = atomsOf group |> List.filter unnamed |> each valType.

# (param $x i32) (param i32 i32) (result i32) ...
sigOf : List SExp -> Result V.FuncType String .
sigOf sig = fieldsOf "param" sig |> each typesIn |> R.andThen (withResults sig).
withResults sig ps = fieldsOf "result" sig |> each typesIn |> R.map (funcType ps).
funcType ps rs = V.FuncType (List.concat ps) (List.concat rs).

# one name per declared slot: a named slot is `$x T`, the rest are anonymous
# and still occupy indices
anonymous _ = "".
slotNames (Atom n :: _) | isDollar n = [n].
slotNames group = atomsOf group |> List.map anonymous.
slotsOf kind sig = fieldsOf kind sig |> List.concatMap slotNames.

# (type $t (func (param ..) (result ..))): (name or "", the type)
labelled n ft = (n, ft).
typeDecl (Atom n :: SList (Atom "func" :: sig) :: Nil) = sigOf sig |> R.map (labelled n).
typeDecl (SList (Atom "func" :: sig) :: Nil) = sigOf sig |> R.map (labelled "").
typeDecl _ = Err "bad (type ...)".

Names = { types : Map.Map String Int, funcs : Map.Map String Int, globals : Map.Map String Int }.

indexIn : Map.Map String Int -> String -> O.Option Int .
indexIn table n | allDigits n = O.Some (parseInt n).
indexIn table n = Map.get n table.

# a signature that is (type $t) or inline; an inline one is interned.
# Answers (the type, the types so far)
resolveSig : Names -> List V.FuncType -> List SExp -> Result (V.FuncType, List V.FuncType) String .
resolveSig names types sig = typeUse names types sig (fieldsOf "type" sig).

typeUse names types _ ((Atom t :: Nil) :: _) = indexIn names.types t |> O.andThen (typeAt types) |> orErr "unknown type {t}" |> R.map (among types).
typeUse _ types sig _ = sigOf sig |> R.map (interned types).

typeAt types i = List.get i types.
among types ft = (ft, types).
interned types ft | List.member ft types = (ft, types).
interned types ft = (ft, List.append types [ft]).

# ---- module assembly ---------------------------------------------------------------

Parsed = { program : V.Program, funcNames : Map.Map String Int }.

parse : unsafe String -> Result Parsed String .
parse src = tokenize src |> R.andThen wholeModule.

wholeModule : unsafe List SExp -> Result Parsed String .
wholeModule (SList (Atom "module" :: fs) :: Nil) = assemble (List.dropWhile isName fs).
wholeModule _ = Err "expected a single (module ...)".

# (index, a field's rest) -> its $name and index, when it has a name
namedAt base (i, Atom n :: _) | isDollar n = O.Some (n, base + i).
namedAt _ _ = O.None.
importNamed (i, Str _ :: Str _ :: SList (Atom "func" :: Atom n :: _) :: Nil) | isDollar n = O.Some (n, i).
importNamed _ = O.None.
typeNamed (_, ("", _)) = O.None.
typeNamed (i, (n, _)) = O.Some (n, i).

namesIn pick fields = List.indexed fields |> List.filterMap pick |> byName.
okOnly (Ok x) = O.Some x.
okOnly (Err _) = O.None.
second (_, x) = x.

# pass 1 names everything; pass 2 resolves the function types, interning the
# inline ones, and compiles the bodies
assemble : unsafe List SExp -> Result Parsed String .
assemble fields =
  typeDecls = fieldsOf "type" fields |> List.map typeDecl |> List.filterMap okOnly;
  importFields = fieldsOf "import" fields;
  funcFields = fieldsOf "func" fields;
  globalFields = fieldsOf "global" fields;
  nImp = List.length importFields;
  funcNames = Map.union (namesIn importNamed importFields) (namesIn (namedAt nImp) funcFields);
  names = {types = namesIn typeNamed typeDecls, funcs = funcNames, globals = namesIn (namedAt 0) globalFields};
  declaring (importDecl names) (List.map second typeDecls) importFields |> R.andThen (fn imported ->
  declaring (funcDecl names opTable) (second imported) funcFields |> R.andThen (fn defined ->
  each globalDecl globalFields |> R.andThen (fn globals ->
  each dataSeg (fieldsOf "data" fields) |> R.andThen (fn datas ->
  each (elemSeg names) (fieldsOf "elem" fields) |> R.map (fn segs ->
    {program = V.Program {
       types = second defined, imports = first imported,
       funcs = first defined |> List.indexed |> Map.fromList intOrder,
       tableSize = tableSize (List.concat segs) (fieldsOf "table" fields),
       table = Map.fromList intOrder (List.concat segs),
       memMin = memMin (fieldsOf "memory" fields), memMax = memMax (fieldsOf "memory" fields),
       globals = globals, datas = datas,
       exports = byName (List.append (List.filterMap (exportOf names) fields) (inlineExports nImp funcFields)),
       start = startOf names (fieldsOf "start" fields) },
     funcNames = funcNames}))))).

first (x, _) = x.

# thread the type list through the declarations, collecting what each makes:
# (the things declared in order, the types afterwards)
declaring decl types fields = List.fold (declared decl) (Ok (Nil, types)) fields |> R.map inOrder.
declared decl (Ok (acc, types)) field = decl types field |> R.map (after acc).
declared _ (Err why) _ = Err why.
after acc (x, types) = (x :: acc, types).
inOrder (acc, types) = (List.reverse acc, types).

numbersIn group = atomsOf group |> List.filter allDigits |> List.map parseInt.

limits Nil = Nil.
limits (group :: _) = numbersIn group.
memMin memories = bound 0 (limits memories) memories.
memMax memories = bound 1 (limits memories) memories.
# no (memory): none.  (memory a): min a, no max.  (memory a b): min a, max b.
bound _ _ Nil = 0 - 1.
bound 0 (a :: Nil) _ = a.
bound 0 (a :: _ :: Nil) _ = a.
bound 1 (_ :: b :: Nil) _ = b.
bound 0 _ _ = 0.
bound _ _ _ = 0 - 1.

# the declared size, or one past the highest element placed, whichever is more
declaredSize Nil = 0.
declaredSize (group :: _) = numbersIn group |> List.head |> O.withDefault 0.
reach size (i, _) | i + 1 > size = i + 1.
reach size _ = size.
tableSize elems tables = List.fold reach (declaredSize tables) elems.

exportOf names (SList (Atom "export" :: Str n :: SList (Atom "func" :: Atom f :: Nil) :: Nil)) = indexIn names.funcs f |> O.map (labelled n).
exportOf _ _ = O.None.

inlineExport index (SList (Atom "export" :: Str n :: Nil)) = O.Some (n, index).
inlineExport _ _ = O.None.
inlineOf nImp (i, rest) = List.filterMap (inlineExport (nImp + i)) rest.
inlineExports nImp funcFields = List.indexed funcFields |> List.concatMap (inlineOf nImp).

startOf names ((Atom f :: Nil) :: _) = indexIn names.funcs f |> O.withDefault (0 - 1).
startOf _ _ = 0 - 1.

importDecl : Names -> List V.FuncType -> List SExp -> Result (V.Import, List V.FuncType) String .
importDecl names types (Str md :: Str nm :: SList (Atom "func" :: r) :: Nil) = resolveSig names types (List.dropWhile isName r) |> R.map (importOf md nm).
importDecl _ _ _ = Err "only function imports are supported".
importOf md nm (ft, types) = (V.Import md nm ft, types).

isSig = headIs ["type", "param", "result"].
isLocal = headIs ["local"].
isExport = headIs ["export"].
notExport e = not (isExport e).
namedSlot (_, "") = O.None.
namedSlot (i, n) = O.Some (n, i).

# a function field: [$name] [(export ..)]* signature locals body
funcDecl : unsafe Names -> Map.Map String Op -> List V.FuncType -> List SExp -> Result (V.Func, List V.FuncType) String .
funcDecl names ops types rest = funcParts names ops types (List.dropWhile isName rest |> List.filter notExport).

funcParts : unsafe Names -> Map.Map String Op -> List V.FuncType -> List SExp -> Result (V.Func, List V.FuncType) String .
funcParts names ops types parts =
  sig = List.takeWhile isSig parts;
  locals = List.dropWhile isSig parts |> List.takeWhile isLocal;
  body = List.dropWhile isSig parts |> List.dropWhile isLocal;
  slots = List.append (slotsOf "param" sig) (slotsOf "local" locals);
  env = {names = names, ops = ops, locals = List.indexed slots |> List.filterMap namedSlot |> byName, labels = Nil};
  resolveSig names types sig |> R.andThen (fn resolved ->
  fieldsOf "local" locals |> each typesIn |> R.andThen (fn ltypes ->
  compileSeq env body |> R.map (fn code ->
    (V.Func (first resolved) (List.concat ltypes) code, second resolved)))).

globalDecl : List SExp -> Result V.Global String .
globalDecl rest = globalOf (List.dropWhile isName rest).
globalOf (SList (Atom "mut" :: Atom t :: Nil) :: initE :: Nil) = mkGlobal True t initE.
globalOf (Atom t :: initE :: Nil) = mkGlobal False t initE.
globalOf _ = Err "bad (global ...)".
mkGlobal mut t initE = valType t |> R.andThen (fn ty -> constExpr initE |> R.map (V.Global ty mut)).

f32Const : F64 -> V.Val .
f32Const x = V.VF32 (F32.ofF64 x).

constOf : String -> String -> Result V.Val String .
constOf "i32.const" n = readInt n |> R.map V.VI32.
constOf "i64.const" n = readI64 n |> R.map V.VI64.
constOf "f32.const" n = readFloat n |> R.map f32Const.
constOf "f64.const" n = readFloat n |> R.map V.VF64.
constOf _ _ = Err "unsupported constant expression".

constExpr (SList (Atom op :: Atom n :: Nil)) = constOf op n.
constExpr _ = Err "unsupported constant expression".

dataSeg : List SExp -> Result (Int, String) String .
dataSeg rest = dataOf (List.dropWhile isName rest).
dataOf (SList (Atom "i32.const" :: Atom n :: Nil) :: strs) = readInt n |> R.map (textAt (strsOf strs |> strJoin "")).
dataOf _ = Err "unsupported (data ...) form".
textAt text off = (off, text).

notFuncWord f = f != "func".
funcIndex names f = indexIn names.funcs f |> orErr "unknown func in elem: {f}".
placedFrom off (i, f) = (off + i, f).

# (elem (i32.const n) [func] $f ...): the (table index, function) pairs
elemSeg : Names -> List SExp -> Result (List (Int, Int)) String .
elemSeg names rest = elemOf names (List.dropWhile isName rest).
elemOf names (SList (Atom "i32.const" :: Atom n :: Nil) :: fs) = readInt n |> R.andThen (elemsAt names fs).
elemOf _ _ = Err "unsupported (elem ...) form".
elemsAt names fs off = atomsOf fs |> List.filter notFuncWord |> each (funcIndex names) |> R.map (fn idxs -> List.indexed idxs |> List.map (placedFrom off)).

# ---- instruction compilation ----------------------------------------------------
# env: names, the opcode table, the function's locals by name, and the label
# names innermost first ("" = an unnamed label)

Env = { names : Names, ops : Map.Map String Op, locals : Map.Map String Int, labels : List String }.

# unsafe: compileSeq, compileFolded and blockLike call each other down the
# tree.  They end because every call is on a strictly smaller piece of a
# finite tree; no measure can say that yet.
compileSeq : unsafe Env -> List SExp -> Result (List V.Instr) String .
compileSeq _ Nil = Ok Nil.
compileSeq env (Atom a :: rest) = plainInstr env a rest |> R.andThen (fn made -> compileSeq env (second made) |> R.map (List.append (first made))).
compileSeq env (SList l :: rest) = compileFolded env l |> R.andThen (fn ins -> compileSeq env rest |> R.map (List.append ins)).
compileSeq _ (Str _ :: _) = Err "unexpected string in code".

compileFolded : unsafe Env -> List SExp -> Result (List V.Instr) String .
compileFolded env (Atom "block" :: rest) = blockLike env (labelOf rest) (blockType (unlabelled rest)) V.Block.
compileFolded env (Atom "loop" :: rest) = blockLike env (labelOf rest) (blockType (unlabelled rest)) V.Loop.
compileFolded env (Atom "if" :: rest) = ifForm env (labelOf rest) (blockType (unlabelled rest)).
compileFolded env (Atom a :: rest) = plainInstr env a rest |> R.andThen (fn made -> compileSeq env (second made) |> R.map (fn operands -> List.append operands (first made))).
compileFolded _ _ = Err "cannot compile a form that does not start with an instruction".

under label env = {env | labels = label :: env.labels}.

blockLike : unsafe Env -> String -> (V.BlockType, List SExp) -> (V.BlockType -> List V.Instr -> V.Instr) -> Result (List V.Instr) String .
blockLike env label (bt, body) mk = compileSeq (under label env) body |> R.map (fn inner -> [mk bt inner]).

isArm = headIs ["then", "else"].
notArm e = not (isArm e).

# (if label? blocktype condition.. (then ..) (else ..)?)
ifForm : unsafe Env -> String -> (V.BlockType, List SExp) -> Result (List V.Instr) String .
ifForm env label (bt, parts) =
  compileSeq env (List.takeWhile notArm parts) |> R.andThen (fn cond ->
  compileSeq (under label env) (List.concat (fieldsOf "then" parts)) |> R.andThen (fn t ->
  compileSeq (under label env) (List.concat (fieldsOf "else" parts)) |> R.map (fn e ->
    List.append cond [V.If bt t e]))).

labelOf (Atom n :: _) | isDollar n = n.
labelOf _ = "".
unlabelled (Atom n :: r) | isDollar n = r.
unlabelled rest = rest.

# (param ..)* (result ..)* at the head of a block body; a (type $t) block is
# taken as no params and no results, as in the Haskell.
# Answers (the block type, the body)
blockType rest = (blockSig (List.takeWhile isSig rest), List.dropWhile isSig rest).
blockSig sig = typedBlock (fieldsOf "type" sig) (sigOf sig).
typedBlock Nil (Ok (V.FuncType ps rs)) = V.BT ps rs.
typedBlock _ _ = V.BT Nil Nil.

# An instruction and its immediates, which are consumed from the tokens that
# follow the opcode.  Answers (instructions, the tokens left)
plainInstr : Env -> String -> List SExp -> Result (List V.Instr, List SExp) String .
plainInstr _ "i32.const" rest = constant "i32.const" rest.
plainInstr _ "i64.const" rest = constant "i64.const" rest.
plainInstr _ "f32.const" rest = constant "f32.const" rest.
plainInstr _ "f64.const" rest = constant "f64.const" rest.
plainInstr env "local.get" rest = immIndex "local" env.locals rest |> R.map (one V.LocalGet).
plainInstr env "local.set" rest = immIndex "local" env.locals rest |> R.map (one V.LocalSet).
plainInstr env "local.tee" rest = immIndex "local" env.locals rest |> R.map (one V.LocalTee).
plainInstr env "global.get" rest = immIndex "global" env.names.globals rest |> R.map (one V.GlobalGet).
plainInstr env "global.set" rest = immIndex "global" env.names.globals rest |> R.map (one V.GlobalSet).
plainInstr env "br" rest = immLabel env rest |> R.map (one V.Br).
plainInstr env "br_if" rest = immLabel env rest |> R.map (one V.BrIf).
plainInstr env "br_table" rest = List.takeWhile isLabelAtom rest |> atomsOf |> each (labelDepth env) |> R.andThen (brTable (List.dropWhile isLabelAtom rest)).
plainInstr env "call" rest = immIndex "function" env.names.funcs rest |> R.map (one V.Call).
plainInstr env "call_indirect" rest = callIndirect env (List.dropWhile isName rest).
plainInstr env a rest = Map.get a env.ops |> opcode a rest.

one mk (k, rest) = ([mk k], rest).

constant op (Atom n :: rest) = constOf op n |> R.map (fn v -> ([V.Const v], rest)).
constant _ _ = Err "expected immediate".

# the targets, then the default last
brTable rest depths = List.reverse depths |> defaultLast rest.
defaultLast rest (d :: targets) = Ok ([V.BrTable (List.reverse targets) d], rest).
defaultLast _ Nil = Err "br_table needs a default label".

callIndirect env rest = typeUsed env (List.takeWhile isSig rest |> fieldsOf "type") (List.dropWhile isSig rest).
typeUsed env ((Atom t :: Nil) :: _) rest = indexIn env.names.types t |> orErr "unknown type {t}" |> R.map (fn i -> ([V.CallIndirect i], rest)).
typeUsed _ _ _ = Err "call_indirect requires (type $t)".

opcode _ rest (O.Some (Plain i)) = Ok ([i], rest).
opcode _ rest (O.Some (Loads ty bytes signed)) = Ok ([V.Load ty bytes signed (offsetIn rest)], pastMemarg rest).
opcode _ rest (O.Some (Stores ty bytes)) = Ok ([V.Store ty bytes (offsetIn rest)], pastMemarg rest).
opcode a _ O.None = Err "unknown instruction: {a}".

# offset=N and align=N, in any order, after a load or store
isMemarg (Atom a) = substr a 0 7 == "offset=" or substr a 0 6 == "align=".
isMemarg _ = False.
offsetOf (Atom a) | substr a 0 7 == "offset=" = readInt (String.dropLeft 7 a) |> R.withDefault 0.
offsetOf _ = 0.
offsetIn rest = List.takeWhile isMemarg rest |> List.map offsetOf |> List.sum.
pastMemarg rest = List.dropWhile isMemarg rest.

# ---- immediates -----------------------------------------------------------------

isLabelAtom (Atom n) = isDollar n or allDigits n.
isLabelAtom _ = False.

# a name or a number, looked up in `table`
immIndex what table (Atom n :: rest) = indexIn table n |> orErr "unknown {what}: {n}" |> R.map (fn i -> (i, rest)).
immIndex what _ _ = Err "expected {what} immediate".

immLabel env (Atom n :: rest) = labelDepth env n |> R.map (fn d -> (d, rest)).
immLabel _ _ = Err "expected label immediate".

# how many labels out the named one is
isLabel n (_, l) = l == n.
labelDepth env n | allDigits n = Ok (parseInt n).
labelDepth env n = List.indexed env.labels |> List.find (isLabel n) |> O.map first |> orErr "unknown label: {n}".

# ---- the opcode name table ----------------------------------------------------------

Op = Type (Plain V.Instr | Loads V.ValType Int Bool | Stores V.ValType Int).

isizes = [("i32", V.S32), ("i64", V.S64)].
fsizes = [("f32", V.P32), ("f64", V.P64)].

# every (size name).(operator name)
entry mk s sz (n, c) = ("{s}.{n}", Plain (mk sz c)).
forSize ops mk (s, sz) = List.map (entry mk s sz) ops.
sized sizes ops mk = List.concatMap (forSize ops mk) sizes.

truncsOf (is, isz) (fs, fsz) = [
  ("{is}.trunc_{fs}_s", Plain (V.Cvtop (V.TruncS isz fsz))),
  ("{is}.trunc_{fs}_u", Plain (V.Cvtop (V.TruncU isz fsz))),
  ("{is}.trunc_sat_{fs}_s", Plain (V.Cvtop (V.TruncSatS isz fsz))),
  ("{is}.trunc_sat_{fs}_u", Plain (V.Cvtop (V.TruncSatU isz fsz)))].
truncsInto isize = List.concatMap (truncsOf isize) fsizes.

convertsOf (fs, fsz) (is, isz) = [
  ("{fs}.convert_{is}_s", Plain (V.Cvtop (V.ConvertS fsz isz))),
  ("{fs}.convert_{is}_u", Plain (V.Cvtop (V.ConvertU fsz isz)))].
convertsInto fsize = List.concatMap (convertsOf fsize) isizes.

opTable = byName (List.concat [
  [ ("unreachable", Plain V.Unreachable), ("nop", Plain V.Nop), ("return", Plain V.Return),
    ("drop", Plain V.Drop), ("select", Plain V.Select),
    ("memory.size", Plain V.MemSize), ("memory.grow", Plain V.MemGrow),
    ("memory.fill", Plain V.MemFill), ("memory.copy", Plain V.MemCopy),
    ("i32.wrap_i64", Plain (V.Cvtop V.Wrap)),
    ("i64.extend_i32_s", Plain (V.Cvtop V.ExtendS)),
    ("i64.extend_i32_u", Plain (V.Cvtop V.ExtendU)),
    ("f32.demote_f64", Plain (V.Cvtop V.Demote)),
    ("f64.promote_f32", Plain (V.Cvtop V.Promote)),
    ("i32.reinterpret_f32", Plain (V.Cvtop (V.Reinterpret V.TI32))),
    ("i64.reinterpret_f64", Plain (V.Cvtop (V.Reinterpret V.TI64))),
    ("f32.reinterpret_i32", Plain (V.Cvtop (V.Reinterpret V.TF32))),
    ("f64.reinterpret_i64", Plain (V.Cvtop (V.Reinterpret V.TF64))),
    ("i64.extend32_s", Plain (V.IUnop V.S64 V.IExt32S)),
    ("i32.eqz", Plain (V.IEqz V.S32)), ("i64.eqz", Plain (V.IEqz V.S64)) ],
  sized isizes [
    ("add", V.IAdd), ("sub", V.ISub), ("mul", V.IMul), ("div_s", V.IDivS), ("div_u", V.IDivU),
    ("rem_s", V.IRemS), ("rem_u", V.IRemU), ("and", V.IAnd), ("or", V.IOr), ("xor", V.IXor),
    ("shl", V.IShl), ("shr_s", V.IShrS), ("shr_u", V.IShrU), ("rotl", V.IRotl), ("rotr", V.IRotr)]
    V.IBinop,
  sized isizes [
    ("clz", V.IClz), ("ctz", V.ICtz), ("popcnt", V.IPopcnt), ("extend8_s", V.IExt8S), ("extend16_s", V.IExt16S)]
    V.IUnop,
  sized isizes [
    ("eq", V.IEq), ("ne", V.INe), ("lt_s", V.ILtS), ("lt_u", V.ILtU), ("gt_s", V.IGtS),
    ("gt_u", V.IGtU), ("le_s", V.ILeS), ("le_u", V.ILeU), ("ge_s", V.IGeS), ("ge_u", V.IGeU)]
    V.IRelop,
  sized fsizes [
    ("add", V.FAdd), ("sub", V.FSub), ("mul", V.FMul), ("div", V.FDiv), ("min", V.FMin), ("max", V.FMax), ("copysign", V.FCopysign)]
    V.FBinop,
  sized fsizes [
    ("abs", V.FAbs), ("neg", V.FNeg), ("ceil", V.FCeil), ("floor", V.FFloor), ("trunc", V.FTrunc), ("nearest", V.FNearest), ("sqrt", V.FSqrt)]
    V.FUnop,
  sized fsizes [
    ("eq", V.FEq), ("ne", V.FNe), ("lt", V.FLt), ("gt", V.FGt), ("le", V.FLe), ("ge", V.FGe)]
    V.FRelop,
  List.concatMap truncsInto isizes,
  List.concatMap convertsInto fsizes,
  [ ("i32.load", Loads V.TI32 4 False), ("i64.load", Loads V.TI64 8 False),
    ("f32.load", Loads V.TF32 4 False), ("f64.load", Loads V.TF64 8 False),
    ("i32.load8_s", Loads V.TI32 1 True), ("i32.load8_u", Loads V.TI32 1 False),
    ("i32.load16_s", Loads V.TI32 2 True), ("i32.load16_u", Loads V.TI32 2 False),
    ("i64.load8_s", Loads V.TI64 1 True), ("i64.load8_u", Loads V.TI64 1 False),
    ("i64.load16_s", Loads V.TI64 2 True), ("i64.load16_u", Loads V.TI64 2 False),
    ("i64.load32_s", Loads V.TI64 4 True), ("i64.load32_u", Loads V.TI64 4 False),
    ("i32.store", Stores V.TI32 4), ("i64.store", Stores V.TI64 8),
    ("f32.store", Stores V.TF32 4), ("f64.store", Stores V.TF64 8),
    ("i32.store8", Stores V.TI32 1), ("i32.store16", Stores V.TI32 2),
    ("i64.store8", Stores V.TI64 1), ("i64.store16", Stores V.TI64 2), ("i64.store32", Stores V.TI64 4) ]]).

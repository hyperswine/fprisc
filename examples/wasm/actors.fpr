# actors.fpr -- the capability layer and round-robin scheduler over wasmvm,
# ported from the Haskell HaskPlayground/src/WASM/Actors.hs.
#
# An actor is a VM plus a descriptor table.  A host call that misses the
# grant cache parks the actor in WaitPerm while the round continues; one
# prompt is resolved at the end of each round.
#
# The host ABI is the toy "thin translation layer", not WASI preview1:
#   path_open (ptr, len, rights) -> fd | -1      rights 0 = read
#   fd_read   (fd, ptr, len)     -> bytes | -1
#   fd_write  (fd, ptr, len)     -> bytes | -1
#
# How it is written (docs/2026-10-03-STYLE-DIRECTION.md): one clause per host
# call, per descriptor kind and per step outcome.  What a guest asks for is
# input, so a bad descriptor or pointer answers -1 and is never a contract.
# The slice and the rounds are unsafe: a slice ends when its fuel does and
# the rounds when every guest has, and neither is a count a measure can see.

List = use "std/list".
Map = use "std/map".
O = use "std/option".
String = use "std/string".
V = use "wasmvm".

Rights = Type (R | W).
Resource = Type (FileCap Rights String).

# text as Haskell's `show` writes a String, so the transcripts compare
quoteByte 10 = "\\n".
quoteByte 9 = "\\t".
quoteByte 13 = "\\r".
quoteByte 34 = "\\\"".
quoteByte 92 = "\\\\".
quoteByte c = chr c.
quoted s = strJoin "" ["\"", String.codes s |> List.map quoteByte |> strJoin "", "\""].

rightsName R = "R".
rightsName W = "W".
showRes (FileCap rights path) = "FileCap {rightsName rights} {quoted path}".

# grants: decisions already made, by showRes.  files: contents by path.
# policy: what the user would answer to a prompt.
World = { grants : Map.Map String Bool, files : Map.Map String String, policy : Resource -> Bool }.

strOrder = (case Map.strings of Map.Map cmp _ _ -> cmp).
mkWorld files policy = {grants = Map.strings, files = Map.fromList strOrder files, policy = policy}.

FdEntry = Type (FdStdout | FdFile String Int).

Status = Type (
    Runnable V.VM
  | WaitPerm Resource String (List V.Val) V.VM   # suspended, awaiting the user
  | Dead String).

Actor = { name : String, status : Status, fds : Map.Map Int FdEntry, nextFd : Int }.

entering (Ok vm) = Runnable vm.
entering (Err why) = Dead "bad entry: {why}".

mkActor name inst entry = {
  name = name,
  status = V.newVM inst entry Nil |> entering,
  fds = Map.insert 1 FdStdout Map.ints,
  nextFd = 3 }.

onVM f (Runnable vm) = Runnable (f vm).
onVM f (WaitPerm res call args vm) = WaitPerm res call args (f vm).
onVM _ (Dead why) = Dead why.
withVM f a = {a | status = onVM f a.status}.

isDead (Dead _) = True.
isDead _ = False.
isWaiting (WaitPerm _ _ _ _) = True.
isWaiting _ = False.
finished a = isDead a.status.

# ---- host calls ---------------------------------------------------------------

i32v n = V.VI32 (V.m32 n).
argInt (V.VI32 w) = w.
argInt _ = 0.
failed = [i32v (0 - 1)].

# a host call's outcome: a capability miss (the user must be asked), or the
# world, the actor, the results and the lines to log
HostOut = Type (Miss Resource | Done World Actor (List V.Val) (List String)).

# `vm` is the calling actor's VM, stopped at the import
doHost : World -> Actor -> V.VM -> String -> List Int -> HostOut .
doHost w a vm "fd_write" (fd :: p :: n :: Nil) = fdWrite w a (Map.get fd a.fds) (V.memoryOf vm) p n.
doHost w a vm "fd_read" (fd :: p :: n :: Nil) = chunkBehind w (Map.get fd a.fds) n |> delivered w a vm fd p.
doHost w a vm "path_open" (p :: n :: rw :: Nil) = V.memReadString (V.memoryOf vm) p n |> opened w a rw.
doHost w a _ call _ = Done w a failed ["[host] unknown call {call}"].

fdWrite w a (O.Some FdStdout) mem p n = V.memReadString mem p n |> written w a n.
fdWrite _ _ (O.Some (FdFile path _)) _ _ _ = Miss (FileCap W path).
fdWrite w a O.None _ _ _ = Done w a failed Nil.

written w a n (Ok text) = Done w a [i32v n] ["[{a.name} stdout] {quoted text}"].
written w a _ (Err _) = Done w a failed Nil.

# the next n bytes of the file behind a descriptor: (path, offset, bytes)
chunkBehind w (O.Some (FdFile path off)) n = Map.get path w.files |> O.map (fn body -> (path, off, substr body off n)).
chunkBehind _ _ _ = O.None.

delivered w a _ _ _ O.None = Done w a failed Nil.
delivered w a vm fd p (O.Some (path, off, chunk)) = V.memWriteString (V.memoryOf vm) p chunk |> advanced w a fd path (off + strlen chunk) (strlen chunk).

advanced w a fd path off count (Ok mem) = Done w ({a | fds = Map.insert fd (FdFile path off) a.fds} |> withVM (V.withMemory mem)) [i32v count] Nil.
advanced w a _ _ _ _ (Err _) = Done w a failed Nil.

rightsOf 0 = R.
rightsOf _ = W.
pathIn (FileCap _ path) = path.

opened w a rw (Ok path) = granted w a (FileCap (rightsOf rw) path).
opened w a _ (Err _) = Done w a failed Nil.

granted w a res = decided w a res (Map.get (showRes res) w.grants).
decided w a res (O.Some True) = Done w {a | fds = Map.insert a.nextFd (FdFile (pathIn res) 0) a.fds, nextFd = a.nextFd + 1} [i32v a.nextFd]
  ["[cap] {a.name} uses cached grant for {showRes res} -> fd {a.nextFd}"].
decided w a res (O.Some False) = Done w a failed ["[cap] {a.name} denied (cached) for {showRes res}"].
decided _ _ res O.None = Miss res.

# ---- one time slice --------------------------------------------------------------

fuelSlice = 60.
hostFuelCost = 10.

# one step's effect on the slice: go on, or the actor leaves the slice
Turn = Type (Again World Actor | Parked World Actor).

charged vm = V.withFuel (V.fuelOf vm - hostFuelCost) vm.

stepOnce : World -> Actor -> Turn .
stepOnce w a = stepped w a a.status.
stepped w a (Runnable vm) = outcome w a (V.step vm).
stepped w a _ = Parked w a.

outcome : World -> Actor -> V.Step -> Turn .
outcome w a (V.Running next) = Again w {a | status = Runnable next}.
outcome w a (V.Yielded next) =
  _ = print "[sched] {a.name} fuel exhausted -> yields";
  Parked w {a | status = Runnable next}.
outcome w a (V.Finished _ _) =
  _ = print "[sched] {a.name} finished.";
  Parked w {a | status = Dead "ok"}.
outcome w a (V.Trapped why) =
  _ = print "[sched] {a.name} TRAPPED: {why}";
  Parked w {a | status = Dead why}.
outcome w a (V.NeedHost _ call args next) = hosted w {a | status = Runnable (charged next)} call args (charged next).

hosted w a call args vm = doHost w a vm call (List.map argInt args) |> afterHost w a call args vm.
afterHost _ _ _ _ _ (Done w a results logs) =
  _ = List.each print logs;
  Again w (withVM (V.resumeHost results) a).
afterHost w a call args vm (Miss res) =
  _ = print "[cap] {a.name} needs {showRes res} -> no grant cached; SUSPENDING actor, asking user";
  Parked w {a | status = WaitPerm res call args vm}.

# unsafe: a slice ends when its fuel does.  Fuel is spent per instruction, and
# the steps that only close a block or return spend none, so the number of
# steps is not the fuel and no measure on a counter here would be true.
slice : unsafe World -> Actor -> (World, Actor) .
slice w a = case stepOnce w a of
    Again w1 a1 -> slice w1 a1
  | Parked w1 a1 -> (w1, a1).

fuelled (Runnable vm) = Runnable (V.withFuel fuelSlice vm).
fuelled status = status.

runActorSlice : unsafe World -> Actor -> (World, Actor) .
runActorSlice w a = slice w {a | status = fuelled a.status}.

# (the world, the actors that have had their slice, newest first)
turn : unsafe (World, List Actor) -> Actor -> (World, List Actor) .
turn (w, ran) a = runActorSlice w a |> joined ran.
joined ran (w, a) = (w, a :: ran).
runRound : unsafe World -> List Actor -> (World, List Actor) .
runRound w actors = List.fold turn (w, Nil) actors |> inOrder.
inOrder (w, ran) = (w, List.reverse ran).

# ---- prompts and rounds ------------------------------------------------------------

verdictName True = "ALLOW".
verdictName False = "DENY".
notWaiting a = not (isWaiting a.status).

# the first waiting actor gets its answer; the others wait another round
resolveOnePrompt (w, actors) = answerFirst w (List.takeWhile notWaiting actors) (List.dropWhile notWaiting actors).
answerFirst w before Nil = (w, before).
answerFirst w before (a :: after) = prompted w before a after a.status.

prompted w before a after (WaitPerm res call args vm) =
  verdict = w.policy res;
  _ = print "[user] prompt: {quoted a.name} requests {showRes res} -> user says {verdictName verdict}";
  w1 = {w | grants = Map.insert (showRes res) verdict w.grants};
  retried = doHost w1 {a | status = Runnable vm} vm call (List.map argInt args) |> resumed a;
  (w1, List.append before (retried :: after)).
prompted w before a after _ = (w, List.append before (a :: after)).

resumed _ (Done _ a results logs) =
  _ = List.each print logs;
  withVM (V.resumeHost results) a.
resumed a (Miss _) = a.

# unsafe: the rounds go on until every actor is dead, and a guest need not die
runRounds : unsafe World -> List Actor -> Unit .
runRounds w actors = rounds 1 (w, actors).

rounds : unsafe Int -> (World, List Actor) -> Unit .
rounds _ (_, actors) | List.all finished actors = print "[sched] all actors finished.".
rounds r (w, actors) =
  _ = print "----- round {r} -----";
  rounds (r + 1) (runRound w actors |> resolveOnePrompt).

# wasmvm.fpr -- a small-step WebAssembly interpreter (MVP + bulk memory +
# sign extension + saturating truncation), ported from the Haskell
# HaskPlayground/src/WASM/WasmVM.hs.
#
# The whole execution state is one record, so running out of fuel or meeting
# a host call is "return the record":
#
#   * typed operand stack.  An Int here is 63 bits, so an i32 is its unsigned
#     value 0 .. 2^32-1 and an i64 is two such halves (high, low);
#     f32/f64 are F32/F64
#   * structured control flow with LABELS carrying arities (br with values,
#     multi-value blocks), br_table / return / unreachable / select
#   * FUNCTION FRAMES: call, call_indirect (table + runtime type check),
#     locals per activation, result arity, depth limit
#   * globals, memory.size/grow/fill/copy, all load/store widths
#   * linear memory is a persistent sparse byte map, bounds-checked; it and
#     the globals live in the instance the record carries
#   * host functions are imports; the VM stops with NeedHost and the embedder
#     decides what "fd_write" means (the capability layer is actors.fpr)
#
# How it is written (docs/2026-10-03-STYLE-DIRECTION.md): one clause per
# instruction and operand shape, guards for the trap conditions, a measure on
# every loop that ends by itself.  What the guest does is input, so a trap is
# a value (Trapped, Err) and never a contract.  Contracts sit on the internal
# arithmetic: shift counts, widths.  The one `unsafe` group is the run loop,
# which ends when the guest does.
#
# Differences from the Haskell, on purpose or for now:
#   * the instance is a value, not IORefs: a finished or stopped VM hands its
#     instance back, and the caller threads it to the next invocation
#   * nothing is reclaimed while a VM runs (each step allocates); long runs
#     want a flat code representation under Sys.loopWith
#   * f32.convert_i64 and decimal float literals may round twice

List = use "std/list".
Map = use "std/map".
O = use "std/option".
String = use "std/string".

# ---- values and types ---------------------------------------------------------

ValType = Type (TI32 | TI64 | TF32 | TF64).

Val = Type (VI32 Int | VI64 Int Int | VF32 F32 | VF64 F64).

typeOf (VI32 _) = TI32.
typeOf (VI64 _ _) = TI64.
typeOf (VF32 _) = TF32.
typeOf (VF64 _) = TF64.

zeroOf TI32 = VI32 0.
zeroOf TI64 = VI64 0 0.
zeroOf TF32 = VF32 (F32.ofInt 0).
zeroOf TF64 = VF64 0.0.

FuncType = Type (FuncType (List ValType) (List ValType)).

paramsOf (FuncType ps _) = ps.
resultsOf (FuncType _ rs) = rs.

# ---- instructions ---------------------------------------------------------------

ISz = Type (S32 | S64).
FSz = Type (P32 | P64).

IBin = Type (IAdd | ISub | IMul | IDivS | IDivU | IRemS | IRemU | IAnd | IOr | IXor | IShl | IShrS | IShrU | IRotl | IRotr).
IUn = Type (IClz | ICtz | IPopcnt | IExt8S | IExt16S | IExt32S).
IRel = Type (IEq | INe | ILtS | ILtU | IGtS | IGtU | ILeS | ILeU | IGeS | IGeU).
FBin = Type (FAdd | FSub | FMul | FDiv | FMin | FMax | FCopysign).
FUn = Type (FAbs | FNeg | FCeil | FFloor | FTrunc | FNearest | FSqrt).
FRel = Type (FEq | FNe | FLt | FGt | FLe | FGe).

Cvt = Type (
    Wrap | ExtendS | ExtendU
  | TruncS ISz FSz | TruncU ISz FSz
  | TruncSatS ISz FSz | TruncSatU ISz FSz
  | ConvertS FSz ISz | ConvertU FSz ISz
  | Demote | Promote
  | Reinterpret ValType).

# a block type, resolved to (params, results)
BlockType = Type (BT (List ValType) (List ValType)).

# Load: type, bytes read, sign-extend, offset.  Store: type, bytes, offset.
Instr = Type (
    Unreachable | Nop
  | Block BlockType (List Instr)
  | Loop BlockType (List Instr)
  | If BlockType (List Instr) (List Instr)
  | Br Int | BrIf Int | BrTable (List Int) Int
  | Return | Call Int | CallIndirect Int
  | Drop | Select
  | LocalGet Int | LocalSet Int | LocalTee Int
  | GlobalGet Int | GlobalSet Int
  | Load ValType Int Bool Int
  | Store ValType Int Int
  | MemSize | MemGrow | MemFill | MemCopy
  | Const Val
  | IBinop ISz IBin | IUnop ISz IUn | IEqz ISz | IRelop ISz IRel
  | FBinop FSz FBin | FUnop FSz FUn | FRelop FSz FRel
  | Cvtop Cvt).

# ---- module and instance ------------------------------------------------------

Func = Type (Func FuncType (List ValType) (List Instr)).
Import = Type (Import String String FuncType).
Global = Type (Global ValType Bool Val).

globalInit (Global _ _ v) = v.

# imports are the function imports in index order; funcs are the defined
# functions keyed by (funcidx - number of imports); memMin < 0 = no memory,
# memMax < 0 = no declared maximum; start < 0 = none
Module = {
  types : List FuncType, imports : List Import, funcs : Map.Map Int Func,
  tableSize : Int, table : Map.Map Int Int, memMin : Int, memMax : Int,
  globals : List Global, datas : List (Int, String), exports : Map.Map String Int,
  start : Int }.

# bytes: address -> byte, absent = 0.  size is in bytes.
Memory = { bytes : Map.Map Int Int, size : Int, maxPages : Int }.

Inst = { mod : Module, mem : Memory, globals : Map.Map Int Val }.

# A record type cannot be named from another module, so what crosses the
# module boundary is wrapped: a Program is a module as the parser made it,
# an Instance is one instantiation of it (and VM, below, a running machine).
Program = Type (Program Module).
Instance = Type (Instance Inst).

exportOf : String -> Program -> O.Option Int .
exportOf name (Program m) = Map.get name m.exports.

pageSize = 65536.
# the runtime cap: 64 MiB
maxPagesCap = 1024.

pagesAtLeast min | min < 0 = 0.
pagesAtLeast min = min.
pagesAtMost max | max < 0 or max > maxPagesCap = maxPagesCap.
pagesAtMost max = max.

numbered xs = xs |> List.indexed |> Map.fromList intOrder.
intOrder = (case Map.ints of Map.Map cmp _ _ -> cmp).

instantiate : Program -> Instance .
instantiate (Program m) = Instance {
  mod = m,
  mem = List.fold placeData {bytes = Map.ints, size = pagesAtLeast m.memMin * pageSize, maxPages = pagesAtMost m.memMax} m.datas,
  globals = m.globals |> List.map globalInit |> numbered }.

placeData mem (off, text) = {mem | bytes = poke off (String.codes text) mem.bytes}.

# function index space = imports ++ defined
funcTypeAt : Module -> Int -> O.Option FuncType .
funcTypeAt m i | i < List.length m.imports = List.get i m.imports |> O.map importType.
funcTypeAt m i = Map.get (i - List.length m.imports) m.funcs |> O.map funcType.
importType (Import _ _ ft) = ft.
funcType (Func ft _ _) = ft.

# ---- memory (bounds-checked; Err = trap) --------------------------------------
# Addresses and counts come from the guest, so a bad one is an Err.

oob = "out of bounds memory access".

byteAt bytes a = Map.getOr 0 a bytes.
pokeByte addr bytes (i, b) = Map.insert (addr + i) b bytes.
poke addr bs bytes = bs |> List.indexed |> List.fold (pokeByte addr) bytes.

# n bytes from addr, lowest address first
memReadBytes : Memory -> Int -> Int -> Result (List Int) String .
memReadBytes mem addr n | addr < 0 or n < 0 or addr + n > mem.size = Err oob.
memReadBytes mem addr n = List.range addr (addr + n - 1) |> List.map (byteAt mem.bytes) |> Ok.

memWriteBytes : Memory -> Int -> List Int -> Result Memory String .
memWriteBytes mem addr bs | addr < 0 or addr + List.length bs > mem.size = Err oob.
memWriteBytes mem addr bs = Ok {mem | bytes = poke addr bs mem.bytes}.

# (the old page count or -1, the memory)
memGrow : Memory -> Int -> (Int, Memory) .
memGrow mem delta | delta < 0 or mem.size / pageSize + delta > mem.maxPages = (0 - 1, mem).
memGrow mem delta = (mem.size / pageSize, {mem | size = mem.size + delta * pageSize}).

# convenience for embedders
memReadString : Memory -> Int -> Int -> Result String String .
memReadString mem p n = memReadBytes mem p n |> textOf.
textOf (Ok bs) = Ok (String.fromCodes bs).
textOf (Err why) = Err why.

memWriteString : Memory -> Int -> String -> Result Memory String .
memWriteString mem p s = memWriteBytes mem p (String.codes s).

# little-endian packing: up to four bytes to a word, and back
packByte b acc = acc * 256 + b.
bytesToWord bs = List.foldr packByte 0 bs.
byteOf w i = band (BITSHIFTR w (8 * i)) 255.
wordToBytes : (n : Int | n >= 0 and n <= 4) -> Int -> List Int .
wordToBytes n w = List.range 0 (n - 1) |> List.map (byteOf w).

# ---- i32: an unsigned 32-bit value in an Int ------------------------------------

two31 = 2147483648.
two32 = 4294967296.
ones = 4294967295.

m32 : Int -> Int .
m32 x = band x ones.

# the signed reading
# (literals, not two31: a named constant is costed as an allocating call)
s32 : Int -> Int | work s32 <= 3 | alloc s32 <= 0 .
s32 x | x >= 2147483648 = x - 4294967296.
s32 x = x.

# no product here passes 2^48, so nothing leans on how Int overflows
mul32 : Int -> Int -> Int .
mul32 a b = m32 (a * band b 65535 + BITSHIFTL (m32 (a * BITSHIFTR b 16)) 16).

divZero = "integer divide by zero".
intOverflow = "integer overflow".
badConv = "invalid conversion to integer".

# sign-extend the low `bits` of w to 32
sext : (bits : Int | bits >= 1 and bits <= 32) -> Int -> Int .
sext bits w = signExtended bits (band w (BITSHIFTL 1 bits - 1)).
signExtended bits low | BITTEST low (bits - 1) = m32 (bor low (ones - (BITSHIFTL 1 bits - 1))).
signExtended _ low = low.

shrS32 : Int -> (k : Int | k >= 0 and k < 32) -> Int .
shrS32 a k | a >= two31 = m32 (bor (BITSHIFTR a k) (m32 (BITSHIFTL ones (32 - k)))).
shrS32 a k = BITSHIFTR a k.

# a shift or rotate count is taken modulo the width, as wasm says
count32 b = band b 31.
count64 b = band b 63.

ibin32 : IBin -> Int -> Int -> Result Int String .
ibin32 IAdd a b = Ok (m32 (a + b)).
ibin32 ISub a b = Ok (m32 (a - b)).
ibin32 IMul a b = Ok (mul32 a b).
ibin32 IDivU _ 0 = Err divZero.
ibin32 IDivU a b = Ok (a / b).
ibin32 IRemU _ 0 = Err divZero.
ibin32 IRemU a b = Ok (a - (a / b) * b).
ibin32 IDivS _ 0 = Err divZero.
ibin32 IDivS a b | a == two31 and b == ones = Err intOverflow.
ibin32 IDivS a b = Ok (m32 (s32 a / s32 b)).
ibin32 IRemS _ 0 = Err divZero.
ibin32 IRemS _ b | b == ones = Ok 0.
ibin32 IRemS a b = Ok (m32 (s32 a - (s32 a / s32 b) * s32 b)).
ibin32 IAnd a b = Ok (band a b).
ibin32 IOr a b = Ok (bor a b).
ibin32 IXor a b = Ok (bxor a b).
ibin32 IShl a b = Ok (m32 (BITSHIFTL a (count32 b))).
ibin32 IShrU a b = Ok (BITSHIFTR a (count32 b)).
ibin32 IShrS a b = Ok (shrS32 a (count32 b)).
ibin32 IRotl a b = Ok (m32 (bor (BITSHIFTL a (count32 b)) (BITSHIFTR a (32 - count32 b)))).
ibin32 IRotr a b = Ok (m32 (bor (BITSHIFTR a (count32 b)) (BITSHIFTL a (32 - count32 b)))).

bitNumbers = List.range 0 31.
isSet a bit = BITTEST a bit.
clear a bit = not (BITTEST a bit).
clearFromTop a i = clear a (31 - i).
clz32 a = bitNumbers |> List.takeWhile (clearFromTop a) |> List.length.
ctz32 a = bitNumbers |> List.takeWhile (clear a) |> List.length.
popcnt32 a = bitNumbers |> List.count (isSet a).

iun32 : IUn -> Int -> Int .
iun32 IClz a = clz32 a.
iun32 ICtz a = ctz32 a.
iun32 IPopcnt a = popcnt32 a.
iun32 IExt8S a = sext 8 a.
iun32 IExt16S a = sext 16 a.
iun32 IExt32S a = a.

irel32 : IRel -> Int -> Int -> Bool | work irel32 <= 29 | alloc irel32 <= 0 .
irel32 IEq a b = a == b.
irel32 INe a b = a != b.
irel32 ILtU a b = a < b.
irel32 IGtU a b = a > b.
irel32 ILeU a b = a <= b.
irel32 IGeU a b = a >= b.
irel32 ILtS a b = s32 a < s32 b.
irel32 IGtS a b = s32 a > s32 b.
irel32 ILeS a b = s32 a <= s32 b.
irel32 IGeS a b = s32 a >= s32 b.

# ---- i64: (high, low), each an unsigned 32-bit value ----------------------------

add64 : (Int, Int) -> (Int, Int) -> (Int, Int) .
add64 (ah, al) (bh, bl) = (m32 (ah + bh + BITSHIFTR (al + bl) 32), m32 (al + bl)).

sub64 : (Int, Int) -> (Int, Int) -> (Int, Int) .
sub64 (ah, al) (bh, bl) | al < bl = (m32 (ah - bh - 1), m32 (al - bl)).
sub64 (ah, al) (bh, bl) = (m32 (ah - bh), al - bl).

neg64 a = sub64 (0, 0) a.
isNeg64 (h, _) = h >= two31.
isZero64 (h, l) = h == 0 and l == 0.
abs64 a | isNeg64 a = neg64 a.
abs64 a = a.

# the low 64 bits of the product, in 16-bit limbs
mul64 : (Int, Int) -> (Int, Int) -> (Int, Int) .
mul64 (ah, al) (bh, bl) =
  a0 = band al 65535; a1 = BITSHIFTR al 16; a2 = band ah 65535; a3 = BITSHIFTR ah 16;
  b0 = band bl 65535; b1 = BITSHIFTR bl 16; b2 = band bh 65535; b3 = BITSHIFTR bh 16;
  c0 = a0 * b0;
  c1 = a0 * b1 + a1 * b0 + BITSHIFTR c0 16;
  c2 = a0 * b2 + a1 * b1 + a2 * b0 + BITSHIFTR c1 16;
  c3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + BITSHIFTR c2 16;
  (bor (BITSHIFTL (band c3 65535) 16) (band c2 65535), bor (BITSHIFTL (band c1 65535) 16) (band c0 65535)).

# (16 bytes: destructuring two tuple arguments is costed as an allocation)
ltU64 : (Int, Int) -> (Int, Int) -> Bool | work ltU64 <= 15 | alloc ltU64 <= 16 .
ltU64 (ah, al) (bh, bl) = ah < bh or (ah == bh and al < bl).
ltS64 : (Int, Int) -> (Int, Int) -> Bool | work ltS64 <= 23 | alloc ltS64 <= 16 .
ltS64 (ah, al) (bh, bl) = s32 ah < s32 bh or (ah == bh and al < bl).

shl64 : (Int, Int) -> (k : Int | k >= 0 and k < 64) -> (Int, Int) .
shl64 a 0 = a.
shl64 (h, l) k | k < 32 = (m32 (bor (BITSHIFTL h k) (BITSHIFTR l (32 - k))), m32 (BITSHIFTL l k)).
shl64 (_, l) k = (m32 (BITSHIFTL l (k - 32)), 0).

shrU64 : (Int, Int) -> (k : Int | k >= 0 and k < 64) -> (Int, Int) .
shrU64 a 0 = a.
shrU64 (h, l) k | k < 32 = (BITSHIFTR h k, m32 (bor (BITSHIFTR l k) (BITSHIFTL h (32 - k)))).
shrU64 (h, _) k = (0, BITSHIFTR h (k - 32)).

shrS64 : (Int, Int) -> (k : Int | k >= 0 and k < 64) -> (Int, Int) .
shrS64 a 0 = a.
shrS64 (h, l) k | k < 32 = (shrS32 h k, m32 (bor (BITSHIFTR l k) (BITSHIFTL h (32 - k)))).
shrS64 (h, _) k = (signFill h, shrS32 h (k - 32)).

rotl64 a 0 = a.
rotl64 a k = or64 (shl64 a k) (shrU64 a (64 - k)).
rotr64 a 0 = a.
rotr64 a k = or64 (shrU64 a k) (shl64 a (64 - k)).

and64 (ah, al) (bh, bl) = (band ah bh, band al bl).
or64 (ah, al) (bh, bl) = (bor ah bh, bor al bl).
xor64 (ah, al) (bh, bl) = (bxor ah bh, bxor al bl).

# all ones when the 32-bit word is negative: the upper half of its extension
signFill : Int -> Int | work signFill <= 2 | alloc signFill <= 0 .
signFill l | l >= 2147483648 = 4294967295.
signFill _ = 0.

bit64 : (Int, Int) -> (i : Int | i >= 0 and i < 64) -> Int .
bit64 (h, _) i | i >= 32 = band (BITSHIFTR h (i - 32)) 1.
bit64 (_, l) i = band (BITSHIFTR l i) 1.

# unsigned (quotient, remainder).  Both small: one machine division.
# Otherwise one bit at a time from the top.
divMod64 : (Int, Int) -> (Int, Int) -> ((Int, Int), (Int, Int)) .
divMod64 (0, al) (0, bl) | bl != 0 = ((0, al / bl), (0, al - (al / bl) * bl)).
divMod64 a b = divBits a b 63 (0, 0) (0, 0).

divBits : (Int, Int) -> (Int, Int) -> (i : Int | measure (i + 1)) -> (Int, Int) -> (Int, Int) -> ((Int, Int), (Int, Int)) .
divBits a b i q r | i < 0 = (q, r).
divBits a b i q r | ltU64 (broughtDown a i r) b = divBits a b (i - 1) q (broughtDown a i r).
divBits a b i q r = divBits a b (i - 1) (or64 q (shl64 (0, 1) i)) (sub64 (broughtDown a i r) b).
# the remainder with the dividend's bit i brought down
broughtDown a i r = or64 (shl64 r 1) (0, bit64 a i).

quotient (q, _) = q.
remainder (_, r) = r.
signedAs True x = neg64 x.
signedAs False x = x.

minS64 = (two31, 0).
allOnes64 = (ones, ones).

ibin64 : IBin -> (Int, Int) -> (Int, Int) -> Result (Int, Int) String .
ibin64 IAdd a b = Ok (add64 a b).
ibin64 ISub a b = Ok (sub64 a b).
ibin64 IMul a b = Ok (mul64 a b).
ibin64 IDivU _ b | isZero64 b = Err divZero.
ibin64 IDivU a b = Ok (divMod64 a b |> quotient).
ibin64 IRemU _ b | isZero64 b = Err divZero.
ibin64 IRemU a b = Ok (divMod64 a b |> remainder).
ibin64 IDivS _ b | isZero64 b = Err divZero.
ibin64 IDivS a b | a == minS64 and b == allOnes64 = Err intOverflow.
ibin64 IDivS a b = Ok (divMod64 (abs64 a) (abs64 b) |> quotient |> signedAs (isNeg64 a != isNeg64 b)).
ibin64 IRemS _ b | isZero64 b = Err divZero.
ibin64 IRemS a b = Ok (divMod64 (abs64 a) (abs64 b) |> remainder |> signedAs (isNeg64 a)).
ibin64 IAnd a b = Ok (and64 a b).
ibin64 IOr a b = Ok (or64 a b).
ibin64 IXor a b = Ok (xor64 a b).
ibin64 IShl a (_, bl) = Ok (shl64 a (count64 bl)).
ibin64 IShrU a (_, bl) = Ok (shrU64 a (count64 bl)).
ibin64 IShrS a (_, bl) = Ok (shrS64 a (count64 bl)).
ibin64 IRotl a (_, bl) = Ok (rotl64 a (count64 bl)).
ibin64 IRotr a (_, bl) = Ok (rotr64 a (count64 bl)).

# a 32-bit word as the i64 it sign-extends to
widened l = (signFill l, l).

iun64 : IUn -> (Int, Int) -> (Int, Int) .
iun64 IClz (0, l) = (0, 32 + clz32 l).
iun64 IClz (h, _) = (0, clz32 h).
iun64 ICtz (h, 0) = (0, 32 + ctz32 h).
iun64 ICtz (_, l) = (0, ctz32 l).
iun64 IPopcnt (h, l) = (0, popcnt32 h + popcnt32 l).
iun64 IExt8S (_, l) = widened (sext 8 l).
iun64 IExt16S (_, l) = widened (sext 16 l).
iun64 IExt32S (_, l) = widened l.

irel64 : IRel -> (Int, Int) -> (Int, Int) -> Bool .
irel64 IEq a b = a == b.
irel64 INe a b = a != b.
irel64 ILtU a b = ltU64 a b.
irel64 IGtU a b = ltU64 b a.
irel64 ILeU a b = not (ltU64 b a).
irel64 IGeU a b = not (ltU64 a b).
irel64 ILtS a b = ltS64 a b.
irel64 IGtS a b = ltS64 b a.
irel64 ILeS a b = not (ltS64 b a).
irel64 IGeS a b = not (ltS64 a b).

# ---- floats ---------------------------------------------------------------------
# F64 carries the work; an f32 operation that is exact in doubles (rounding to
# an integer, min, max, copysign) goes there and back.  Every function here
# has a signature: an operator with no float in sight is typed as Int.
# The contract language is integer-only, so this part is clauses and guards.

fTwo32 : F64 .
fTwo32 = 4294967296.0.
fTwo52 : F64 .
fTwo52 = 4503599627370496.0.
fTwo63 : F64 .
fTwo63 = 4294967296.0 * 2147483648.0.
fTwo64 : F64 .
fTwo64 = 4294967296.0 * 4294967296.0.
nan64 : F64 .
nan64 = 0.0 / 0.0.
negZero : F64 .
negZero = 0.0 * (0.0 - 1.0).

isNan : F64 -> Bool .
isNan x = not (x == x).
isInf : F64 -> Bool .
isInf a = a * 0.5 == a.
signBit : F64 -> Bool .
signBit x = x < 0.0 or (x == 0.0 and 1.0 / x < 0.0).
bothZero : F64 -> F64 -> Bool .
bothZero a b = a == 0.0 and b == 0.0.

fneg : F64 -> F64 .
fneg x = x * (0.0 - 1.0).
fabs : F64 -> F64 .
fabs x | signBit x = fneg x.
fabs x = x.
fcopysign : F64 -> F64 -> F64 .
fcopysign a b | signBit b = fneg (fabs a).
fcopysign a _ = fabs a.

fmin : F64 -> F64 -> F64 .
fmin a b | isNan a or isNan b = nan64.
fmin a b | bothZero a b and (signBit a or signBit b) = negZero.
fmin a b | a < b = a.
fmin _ b = b.

fmax : F64 -> F64 -> F64 .
fmax a b | isNan a or isNan b = nan64.
fmax a b | bothZero a b and signBit a and signBit b = negZero.
fmax a b | bothZero a b = 0.0.
fmax a b | a > b = a.
fmax _ b = b.

# these four take a finite x with |x| < 2^52
truncF : F64 -> F64 .
truncF x = F64.ofInt (F64.toInt x).
floorF : F64 -> F64 .
floorF x | truncF x > x = truncF x - 1.0.
floorF x = truncF x.
ceilF : F64 -> F64 .
ceilF x | truncF x < x = truncF x + 1.0.
ceilF x = truncF x.
# ties go to the even neighbour
nearestF : F64 -> F64 .
nearestF x | x - floorF x < 0.5 = floorF x.
nearestF x | x - floorF x > 0.5 = floorF x + 1.0.
nearestF x | band (F64.toInt (floorF x)) 1 == 0 = floorF x.
nearestF x = floorF x + 1.0.

# rounding to an integer keeps NaN, infinities, large values and the sign of zero
roundWith : (F64 -> F64) -> F64 -> F64 .
roundWith _ x | isNan x or fabs x >= fTwo52 = x.
roundWith f x | f x == 0.0 = fcopysign 0.0 x.
roundWith f x = f x.

fbin64 : FBin -> F64 -> F64 -> F64 .
fbin64 FAdd a b = a + b.
fbin64 FSub a b = a - b.
fbin64 FMul a b = a * b.
fbin64 FDiv a b = a / b.
fbin64 FMin a b = fmin a b.
fbin64 FMax a b = fmax a b.
fbin64 FCopysign a b = fcopysign a b.

fbin32 : FBin -> F32 -> F32 -> F32 .
fbin32 FAdd a b = a + b.
fbin32 FSub a b = a - b.
fbin32 FMul a b = a * b.
fbin32 FDiv a b = a / b.
fbin32 op a b = F32.ofF64 (fbin64 op (F64.ofF32 a) (F64.ofF32 b)).

fun64 : FUn -> F64 -> F64 .
fun64 FAbs x = fabs x.
fun64 FNeg x = fneg x.
fun64 FCeil x = roundWith ceilF x.
fun64 FFloor x = roundWith floorF x.
fun64 FTrunc x = roundWith truncF x.
fun64 FNearest x = roundWith nearestF x.
fun64 FSqrt x = F64.sqrt x.

fun32 : FUn -> F32 -> F32 .
fun32 FSqrt x = F32.sqrt x.
fun32 op x = F32.ofF64 (fun64 op (F64.ofF32 x)).

frel64 : FRel -> F64 -> F64 -> Bool .
frel64 FEq a b = a == b.
frel64 FNe a b = not (a == b).
frel64 FLt a b = a < b.
frel64 FGt a b = a > b.
frel64 FLe a b = a <= b.
frel64 FGe a b = a >= b.

# ---- float <-> integer ----------------------------------------------------------

zeroOfSz S32 = VI32 0.
zeroOfSz S64 = VI64 0 0.
minOf False sz = zeroOfSz sz.
minOf True S32 = VI32 two31.
minOf True S64 = VI64 two31 0.
maxOf True S32 = VI32 (two31 - 1).
maxOf False S32 = VI32 ones.
maxOf True S64 = VI64 (two31 - 1) ones.
maxOf False S64 = VI64 ones ones.

# would the truncation of x fall below / above the type (signed, size)
below : Bool -> ISz -> F64 -> Bool .
below False _ x = x <= 0.0 - 1.0.
below True S32 x = x <= 0.0 - 2147483649.0.
below True S64 x = x < 0.0 - fTwo63.
above : Bool -> ISz -> F64 -> Bool .
above True S32 x = x >= 2147483648.0.
above False S32 x = x >= fTwo32.
above True S64 x = x >= fTwo63.
above False S64 x = x >= fTwo64.

# a finite double with an integral value, as an i64
splitF : F64 -> Val .
splitF t = VI64 (m32 (F64.toInt (floorF (t / fTwo32)))) (F64.toInt (t - floorF (t / fTwo32) * fTwo32)).

integral : F64 -> F64 .
integral x | fabs x >= fTwo52 = x.
integral x = truncF x.

intOfFloat : ISz -> F64 -> Val .
intOfFloat S32 x = VI32 (m32 (F64.toInt x)).
intOfFloat S64 x = splitF (integral x).

saturated True v = Ok v.
saturated False _ = Err intOverflow.

# float -> integer with wasm's trap / saturate rules: signed, size, saturating
truncFloat : Bool -> ISz -> Bool -> F64 -> Result Val String .
truncFloat _ sz True x | isNan x = Ok (zeroOfSz sz).
truncFloat _ _ False x | isNan x = Err badConv.
truncFloat signed sz sat x | below signed sz x = saturated sat (minOf signed sz).
truncFloat signed sz sat x | above signed sz x = saturated sat (maxOf signed sz).
truncFloat _ sz _ x = Ok (intOfFloat sz x).

# The IEEE bits.  There is no primitive from a float to its bits, so the
# exponent is found by scaling: (m, e) with x = m * 2^e and 1 <= m < 2.
# `left` bounds the scaling steps; a double needs at most 34 + 31 of them.
normalize : (left : Int | measure left) -> F64 -> Int -> (F64, Int) .
normalize left m e | left <= 0 = (m, e).
normalize left m e | m >= fTwo32 = normalize (left - 1) (m / fTwo32) (e + 32).
normalize left m e | m >= 2.0 = normalize (left - 1) (m / 2.0) (e + 1).
normalize left m e | m * fTwo32 < 2.0 = normalize (left - 1) (m * fTwo32) (e - 32).
normalize left m e | m < 1.0 = normalize (left - 1) (m * 2.0) (e - 1).
normalize _ m e = (m, e).

# exact, where F64.pow is not: it answers 9.99999999999999 for 10^1
twoTo : (k : Int | measure k) -> F64 -> F64 .
twoTo k acc | k <= 0 = acc.
twoTo k acc = twoTo (k - 1) (acc * 2.0).
pow2 : Int -> F64 .
pow2 k | k < 0 = 1.0 / twoTo (0 - k) 1.0.
pow2 k = twoTo k 1.0.

signWord : F64 -> Int .
signWord x | signBit x = two31.
signWord _ = 0.

# (high, low) of a double
bits64 : F64 -> (Int, Int) .
bits64 x | isNan x = (2146959360, 0).
bits64 x | x == 0.0 = (signWord x, 0).
bits64 x | isInf x = (bor (signWord x) 2146435072, 0).
bits64 x = normalize 128 (fabs x) 0 |> packBits64 (signWord x).

packBits64 : Int -> (F64, Int) -> (Int, Int) .
packBits64 sign (m, e) | e < 0 - 1022 = fields64 sign 0 (F64.toInt (m * pow2 (e + 1022) * fTwo52)).
packBits64 sign (m, e) = fields64 sign (e + 1023) (F64.toInt ((m - 1.0) * fTwo52)).
fields64 sign biased mant = (bor sign (bor (BITSHIFTL biased 20) (BITSHIFTR mant 32)), m32 mant).

bits32 : F32 -> Int .
bits32 f = wordOf (F64.ofF32 f).
wordOf : F64 -> Int .
wordOf x | isNan x = 2143289344.
wordOf x | x == 0.0 = signWord x.
wordOf x | isInf x = bor (signWord x) 2139095040.
wordOf x = normalize 128 (fabs x) 0 |> packBits32 (signWord x).

packBits32 : Int -> (F64, Int) -> Int .
packBits32 sign (m, e) | e < 0 - 126 = bor sign (F64.toInt (m * pow2 (e + 126) * 8388608.0)).
packBits32 sign (m, e) = bor sign (bor (BITSHIFTL (e + 127) 23) (F64.toInt ((m - 1.0) * 8388608.0))).

signedF : Val -> F64 .
signedF (VI32 w) = F64.ofInt (s32 w).
signedF (VI64 h l) = F64.ofInt (s32 h) * fTwo32 + F64.ofInt l.
signedF _ = nan64.
unsignedF : Val -> F64 .
unsignedF (VI32 w) = F64.ofInt w.
unsignedF (VI64 h l) = F64.ofInt h * fTwo32 + F64.ofInt l.
unsignedF _ = nan64.

mkF : FSz -> F64 -> Val .
mkF P32 d = VF32 (F32.ofF64 d).
mkF P64 d = VF64 d.

isInt (VI32 _) = True.
isInt (VI64 _ _) = True.
isInt _ = False.

convErr = Err "type error in conversion".

cvt : Cvt -> Val -> Result Val String .
cvt Wrap (VI64 _ l) = Ok (VI32 l).
cvt ExtendS (VI32 w) = Ok (VI64 (signFill w) w).
cvt ExtendU (VI32 w) = Ok (VI64 0 w).
cvt (TruncS sz _) (VF32 f) = truncFloat True sz False (F64.ofF32 f).
cvt (TruncS sz _) (VF64 d) = truncFloat True sz False d.
cvt (TruncU sz _) (VF32 f) = truncFloat False sz False (F64.ofF32 f).
cvt (TruncU sz _) (VF64 d) = truncFloat False sz False d.
cvt (TruncSatS sz _) (VF32 f) = truncFloat True sz True (F64.ofF32 f).
cvt (TruncSatS sz _) (VF64 d) = truncFloat True sz True d.
cvt (TruncSatU sz _) (VF32 f) = truncFloat False sz True (F64.ofF32 f).
cvt (TruncSatU sz _) (VF64 d) = truncFloat False sz True d.
cvt (ConvertS fs _) v | isInt v = Ok (mkF fs (signedF v)).
cvt (ConvertU fs _) v | isInt v = Ok (mkF fs (unsignedF v)).
cvt Demote (VF64 d) = Ok (VF32 (F32.ofF64 d)).
cvt Promote (VF32 f) = Ok (VF64 (F64.ofF32 f)).
cvt (Reinterpret TI32) (VF32 f) = Ok (VI32 (bits32 f)).
cvt (Reinterpret TI64) (VF64 d) = Ok (bits64 d |> i64Val).
cvt (Reinterpret TF32) (VI32 w) = Ok (VF32 (f32frombits w)).
cvt (Reinterpret TF64) (VI64 h l) = Ok (VF64 (f64frombits h l)).
cvt _ _ = convErr.

i64Val (h, l) = VI64 h l.

# ---- the VM state -----------------------------------------------------------------
#
# a label: arity  = values a branch carries to it
#          stack  = operand stack below the label's params
#          cont   = code after the construct
#          br     = code to run when branching here (a loop re-enters)
# a frame is a suspended caller
# the machine: stk has its top at the head; arity is the result count of the
#          current function

Label = { arity : Int, stack : List Val, cont : List Instr, br : List Instr }.
Frame = { arity : Int, code : List Instr, labels : List Label, locals : Map.Map Int Val, stack : List Val }.
Machine = {
  inst : Inst, code : List Instr, stk : List Val, labels : List Label,
  locals : Map.Map Int Val, arity : Int, frames : List Frame, depth : Int, fuel : Int }.

# the machine as other modules hold it, read through the functions below
VM = Type (VM Machine).

Step = Type (
    Running VM
  | Yielded VM                               # fuel exhausted: a yield point
  | NeedHost String String (List Val) VM     # import (module, name), args in order
  | Finished (List Val) Instance
  | Trapped String).

maxDepth = 2000.

instOf (VM m) = Instance m.inst.
memoryOf (VM m) = m.inst.mem.
withInst (Instance inst) (VM m) = VM {m | inst = inst}.
instanceMemory (Instance inst) = inst.mem.
instanceWithMemory mem (Instance inst) = Instance {inst | mem = mem}.
withMemory mem (VM m) = VM (remembering mem m).
fuelOf (VM m) = m.fuel.
withFuel fuel (VM m) = VM {m | fuel = fuel}.
# push host-call results back (results in order)
resumeHost rs (VM m) = VM {m | stk = List.append (List.reverse rs) m.stk}.

remembering : Memory -> Machine -> Machine .
remembering mem m = {m | inst = (case m.inst of i -> {i | mem = mem})}.

localsOf args locals = List.append args (List.map zeroOf locals) |> numbered.

# a VM ready to run function `idx` with `args`
newVM : Instance -> Int -> List Val -> Result VM String .
newVM (Instance inst) idx _ | idx < List.length inst.mod.imports = Err "cannot start in an imported function".
newVM (Instance inst) idx args = Map.get (idx - List.length inst.mod.imports) inst.mod.funcs |> entered inst idx args.

entered _ idx _ O.None = Err "no such function {idx}".
entered _ _ args (O.Some (Func ft _ _)) | List.map typeOf args != paramsOf ft = Err "argument type mismatch".
entered inst _ args (O.Some (Func ft locals body)) = Ok (VM {
  inst = inst, code = body, stk = Nil, labels = Nil,
  locals = localsOf args locals, arity = List.length (resultsOf ft),
  frames = Nil, depth = 0, fuel = 0 }).

# ---- the small-step transition --------------------------------------------------

step : VM -> Step .
step (VM m) | m.fuel <= 0 = Yielded (VM m).
step (VM m) = advance m.code m.labels m.

advance : List Instr -> List Label -> Machine -> Step .
advance Nil Nil m = doReturn m.
# fall off the end of a block: keep exactly `arity` results
advance Nil (l :: ls) m = running {m | code = l.cont, labels = ls, stk = carried l m.stk}.
advance (i :: rest) _ m = exec i m.stk {m | code = rest, fuel = m.fuel - 1}.

running : Machine -> Step .
running m = Running (VM m).

# what a label keeps of the stack when control reaches it
carried l stk = List.append (List.take l.arity stk) l.stack.

doReturn : Machine -> Step .
doReturn m = returnTo m.frames (List.take m.arity m.stk) m.
returnTo Nil results m = Finished (List.reverse results) (Instance m.inst).
returnTo (f :: fs) results m = running {m |
  code = f.code, stk = List.append results f.stack, labels = f.labels, locals = f.locals,
  arity = f.arity, frames = fs, depth = m.depth - 1}.

branch : Int -> Machine -> Step .
branch n m = branchTo n (List.drop n m.labels) m.
branchTo n Nil _ = Trapped "br depth {n} exceeds label stack".
branchTo _ (l :: ls) m = running {m | code = l.br, labels = ls, stk = carried l m.stk}.

# body runs under a new label; `after` is the code that follows the construct
enterBlock : Int -> Int -> List Instr -> List Instr -> List Instr -> Machine -> Step .
enterBlock nparams arity body brCode after m = running {m |
  code = body,
  labels = {arity = arity, stack = List.drop nparams m.stk, cont = after, br = brCode} :: m.labels}.

push : Val -> List Val -> Machine -> Step .
push v vs m = running {m | stk = v :: vs}.
bool True = VI32 1.
bool False = VI32 0.

# the result of an operator that may trap, pushed over `vs`
pushed vs m (Ok v) = push v vs m.
pushed _ _ (Err why) = Trapped why.
pushedI32 vs m (Ok w) = push (VI32 w) vs m.
pushedI32 _ _ (Err why) = Trapped why.
pushedI64 vs m (Ok (h, l)) = push (VI64 h l) vs m.
pushedI64 _ _ (Err why) = Trapped why.
# a memory operation's outcome
stored vs m (Ok mem) = running (remembering mem {m | stk = vs}).
stored _ _ (Err why) = Trapped why.

chosen 0 _ otherwise = otherwise.
chosen _ taken _ = taken.

# One clause per instruction and operand shape: the instruction, the operand
# stack, the machine (its code already past the instruction).  A stack that
# fits no clause of its instruction falls to the last two.
exec : Instr -> List Val -> Machine -> Step .
exec Unreachable _ _ = Trapped "unreachable executed".
exec Nop _ m = running m.
exec (Block (BT ps rs) body) _ m = enterBlock (List.length ps) (List.length rs) body m.code m.code m.
exec (Loop (BT ps rs) body) _ m = enterBlock (List.length ps) (List.length ps) body (Loop (BT ps rs) body :: m.code) m.code m.
exec (If (BT ps rs) t e) (VI32 c :: vs) m = enterBlock (List.length ps) (List.length rs) (chosen c t e) m.code m.code {m | stk = vs}.
exec (Br n) _ m = branch n m.
exec (BrIf n) (VI32 0 :: vs) m = running {m | stk = vs}.
exec (BrIf n) (VI32 _ :: vs) m = branch n {m | stk = vs}.
exec (BrTable ls d) (VI32 c :: vs) m = branch (List.get c ls |> O.withDefault d) {m | stk = vs}.
exec Return _ m = doReturn m.
exec (Call idx) _ m = callFunc idx m.
exec (CallIndirect tyIdx) (VI32 k :: vs) m = callIndirect tyIdx k {m | stk = vs}.
exec Drop (_ :: vs) m = running {m | stk = vs}.
exec Select (VI32 c :: v2 :: v1 :: vs) m = push (chosen c v1 v2) vs m.
exec (LocalGet k) stk m = Map.get k m.locals |> fetched "local" k stk m.
exec (LocalSet k) (v :: vs) m = running {m | locals = Map.insert k v m.locals, stk = vs}.
exec (LocalTee k) (v :: _) m = running {m | locals = Map.insert k v m.locals}.
exec (GlobalGet k) stk m = Map.get k m.inst.globals |> fetched "global" k stk m.
exec (GlobalSet k) (v :: vs) m = running {m | inst = (case m.inst of i -> {i | globals = Map.insert k v i.globals}), stk = vs}.
exec (Load ty bytes signed off) (VI32 a :: vs) m = memReadBytes m.inst.mem (a + off) bytes |> loadedTo ty bytes signed vs m.
exec (Store ty bytes off) (v :: VI32 a :: vs) m = memWriteBytes m.inst.mem (a + off) (storedBytes bytes v) |> stored vs m.
exec MemSize stk m = push (VI32 (m.inst.mem.size / pageSize)) stk m.
exec MemGrow (VI32 d :: vs) m = memGrow m.inst.mem d |> grown vs m.
exec MemFill (VI32 n :: VI32 v :: VI32 d :: vs) m = memWriteBytes m.inst.mem d (List.repeat n (band v 255)) |> stored vs m.
exec MemCopy (VI32 n :: VI32 s :: VI32 d :: vs) m = memReadBytes m.inst.mem s n |> copiedTo d vs m.
exec (Const v) stk m = push v stk m.
exec (IBinop _ op) (VI32 y :: VI32 x :: vs) m = ibin32 op x y |> pushedI32 vs m.
exec (IBinop _ op) (VI64 yh yl :: VI64 xh xl :: vs) m = ibin64 op (xh, xl) (yh, yl) |> pushedI64 vs m.
exec (IUnop _ op) (VI32 x :: vs) m = push (VI32 (iun32 op x)) vs m.
exec (IUnop _ op) (VI64 xh xl :: vs) m = push (iun64 op (xh, xl) |> i64Val) vs m.
exec (IEqz _) (VI32 x :: vs) m = push (bool (x == 0)) vs m.
exec (IEqz _) (VI64 xh xl :: vs) m = push (bool (isZero64 (xh, xl))) vs m.
exec (IRelop _ op) (VI32 y :: VI32 x :: vs) m = push (bool (irel32 op x y)) vs m.
exec (IRelop _ op) (VI64 yh yl :: VI64 xh xl :: vs) m = push (bool (irel64 op (xh, xl) (yh, yl))) vs m.
exec (FBinop _ op) (VF32 y :: VF32 x :: vs) m = push (VF32 (fbin32 op x y)) vs m.
exec (FBinop _ op) (VF64 y :: VF64 x :: vs) m = push (VF64 (fbin64 op x y)) vs m.
exec (FUnop _ op) (VF32 x :: vs) m = push (VF32 (fun32 op x)) vs m.
exec (FUnop _ op) (VF64 x :: vs) m = push (VF64 (fun64 op x)) vs m.
exec (FRelop _ op) (VF32 y :: VF32 x :: vs) m = push (bool (frel64 op (F64.ofF32 x) (F64.ofF32 y))) vs m.
exec (FRelop _ op) (VF64 y :: VF64 x :: vs) m = push (bool (frel64 op x y)) vs m.
exec (Cvtop op) (v :: vs) m = cvt op v |> pushed vs m.
exec _ Nil _ = Trapped "stack underflow".
exec _ _ _ = Trapped "operand type mismatch".

fetched _ _ stk m (O.Some v) = push v stk m.
fetched what k _ _ O.None = Trapped "unknown {what} {k}".

grown vs m (old, mem) = running (remembering mem {m | stk = VI32 (m32 old) :: vs}).

copiedTo d vs m (Ok bs) = memWriteBytes m.inst.mem d bs |> stored vs m.
copiedTo _ _ _ (Err why) = Trapped why.

loadedTo ty bytes signed vs m (Ok bs) = push (loaded ty bytes signed (bytesToWord (List.take 4 bs)) (bytesToWord (List.drop 4 bs))) vs m.
loadedTo _ _ _ _ _ (Err why) = Trapped why.

# the low word of a load narrower than 32 bits, extended as asked
narrow : Int -> Bool -> Int -> Int .
narrow bytes True lo | bytes >= 1 and bytes < 4 = sext (8 * bytes) lo.
narrow _ _ lo = lo.

# the value a load of `bytes` bytes makes from its low and high words
loaded : ValType -> Int -> Bool -> Int -> Int -> Val .
loaded TI32 bytes signed lo _ = VI32 (narrow bytes signed lo).
loaded TI64 8 _ lo hi = VI64 hi lo.
loaded TI64 bytes True lo _ = narrow bytes True lo |> widened |> i64Val.
loaded TI64 _ False lo _ = VI64 0 lo.
loaded TF32 _ _ lo _ = VF32 (f32frombits lo).
loaded TF64 _ _ lo hi = VF64 (f64frombits hi lo).

# how many of a store's bytes come from the low word and from the high word
lowBytes : Int -> Int | work lowBytes <= 4 | alloc lowBytes <= 0 .
lowBytes bytes | bytes > 4 = 4.
lowBytes bytes | bytes < 0 = 0.
lowBytes bytes = bytes.
highBytes : Int -> Int | work highBytes <= 5 | alloc highBytes <= 0 .
highBytes bytes | bytes > 8 = 4.
highBytes bytes | bytes > 4 = bytes - 4.
highBytes _ = 0.

twoWords bytes (h, l) = List.append (wordToBytes (lowBytes bytes) l) (wordToBytes (highBytes bytes) h).

storedBytes : Int -> Val -> List Int .
storedBytes bytes (VI32 x) = wordToBytes (lowBytes bytes) x.
storedBytes bytes (VI64 h l) = twoWords bytes (h, l).
storedBytes bytes (VF32 f) = wordToBytes (lowBytes bytes) (bits32 f).
storedBytes bytes (VF64 d) = twoWords bytes (bits64 d).

callIndirect : Int -> Int -> Machine -> Step .
callIndirect _ k m | k >= m.inst.mod.tableSize = Trapped "undefined element".
callIndirect tyIdx k m = Map.get k m.inst.mod.table |> throughTable tyIdx m.

throughTable _ _ O.None = Trapped "uninitialized element".
throughTable tyIdx m (O.Some fidx) = checkedCall fidx (List.get tyIdx m.inst.mod.types) (funcTypeAt m.inst.mod fidx) m.

checkedCall fidx (O.Some want) (O.Some have) m | want == have = callFunc fidx m.
checkedCall _ (O.Some _) (O.Some _) _ = Trapped "indirect call type mismatch".
checkedCall _ _ _ _ = Trapped "bad type index in call_indirect".

callFunc : Int -> Machine -> Step .
callFunc idx m | idx < List.length m.inst.mod.imports = List.get idx m.inst.mod.imports |> hostCall idx m.
callFunc _ m | m.depth >= maxDepth = Trapped "call stack exhausted".
callFunc idx m = Map.get (idx - List.length m.inst.mod.imports) m.inst.mod.funcs |> called idx m.

arguments ft stk = List.take (List.length (paramsOf ft)) stk |> List.reverse.
belowArguments ft stk = List.drop (List.length (paramsOf ft)) stk.

hostCall idx _ O.None = Trapped "unknown function {idx}".
hostCall _ m (O.Some (Import md nm ft)) = NeedHost md nm (arguments ft m.stk) (VM {m | stk = belowArguments ft m.stk}).

called idx _ O.None = Trapped "unknown function {idx}".
called _ m (O.Some (Func ft locals body)) = running {m |
  code = body, stk = Nil, labels = Nil,
  locals = localsOf (arguments ft m.stk) locals,
  arity = List.length (resultsOf ft),
  frames = {arity = m.arity, code = m.code, labels = m.labels, locals = m.locals, stack = belowArguments ft m.stk} :: m.frames,
  depth = m.depth + 1}.

# ---- a driver: run to the end with a synchronous host ------------------------
# `host md nm args inst` answers Ok (results, inst) or Err why.  The answer is
# (Ok results | Err why, the instance as the run left it).
#
# unsafe: the loop ends when the guest does, and a guest may loop forever.
# The marker is contagious, so everything from here up to an embedder's main
# carries it.

runFuel = 1000000.

runToEnd : unsafe (String -> String -> List Val -> Instance -> Result (List Val, Instance) String) -> VM -> (Result (List Val) String, Instance) .
runToEnd host vm = runOn host (withFuel runFuel vm).

runOn : unsafe (String -> String -> List Val -> Instance -> Result (List Val, Instance) String) -> VM -> (Result (List Val) String, Instance) .
runOn host vm = settle host vm (step vm).

settle : unsafe (String -> String -> List Val -> Instance -> Result (List Val, Instance) String) -> VM -> Step -> (Result (List Val) String, Instance) .
settle host _ (Running next) = runOn host next.
settle host _ (Yielded next) = runOn host (withFuel runFuel next).
settle _ _ (Finished rs inst) = (Ok rs, inst).
settle _ before (Trapped why) = (Err "trap: {why}", instOf before).
settle host _ (NeedHost md nm args next) = answered host next (host md nm args (instOf next)).

answered : unsafe (String -> String -> List Val -> Instance -> Result (List Val, Instance) String) -> VM -> Result (List Val, Instance) String -> (Result (List Val) String, Instance) .
answered _ next (Err why) = (Err why, instOf next).
answered host next (Ok (rs, inst)) = runOn host (next |> withInst inst |> resumeHost rs).

invoke : unsafe (String -> String -> List Val -> Instance -> Result (List Val, Instance) String) -> Instance -> String -> List Val -> (Result (List Val) String, Instance) .
invoke host (Instance inst) name args = Map.get name inst.mod.exports |> started host (Instance inst) name args.

started : unsafe (String -> String -> List Val -> Instance -> Result (List Val, Instance) String) -> Instance -> String -> List Val -> O.Option Int -> (Result (List Val) String, Instance) .
started _ inst name _ O.None = (Err "no export {name}", inst).
started host inst _ args (O.Some idx) = newVM inst idx args |> launched host inst.

launched : unsafe (String -> String -> List Val -> Instance -> Result (List Val, Instance) String) -> Instance -> Result VM String -> (Result (List Val) String, Instance) .
launched _ inst (Err why) = (Err why, inst).
launched host _ (Ok vm) = runToEnd host vm.

# ---- showing values (a structure holding a float cannot be printed) ---------

showVal : Val -> String .
showVal (VI32 w) = "{s32 w}".
showVal (VI64 h l) = show64 (h, l).
showVal (VF32 f) = F32.str f.
showVal (VF64 d) = F64.str d.

# signed decimal of an i64
show64 a | isNeg64 a = strcat "-" (showU64 (neg64 a)).
show64 a = showU64 a.
showU64 (0, l) = "{l}".
showU64 a = digits64 20 a Nil |> strJoin "".
# an unsigned 64-bit value has at most 20 decimal digits
digits64 : (left : Int | measure left) -> (Int, Int) -> List String -> List String .
digits64 left a acc | left <= 0 = acc.
digits64 left a acc | isZero64 a = acc.
digits64 left a acc = digits64 (left - 1) (divMod64 a (0, 10) |> quotient) ("{divMod64 a (0, 10) |> remainder |> lowWord}" :: acc).
lowWord (_, l) = l.

valEq : Val -> Val -> Bool .
valEq (VI32 x) (VI32 y) = x == y.
valEq (VI64 xh xl) (VI64 yh yl) = xh == yh and xl == yl.
valEq (VF32 x) (VF32 y) = x == y.
valEq (VF64 x) (VF64 y) = x == y.
valEq _ _ = False.

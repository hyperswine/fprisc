#!/usr/bin/env -S fpr run
# wasmtest.fpr -- the VM's semantics suite: every case of the Haskell
# HaskPlayground/src/WASM/TestMain.hs, run against tests.wat.
#
#   fpr run examples/wasm/wasmtest.fpr [path/to/tests.wat]
#
# One instance serves every case in order, so state carries from one call to
# the next: global_inc answers 10 and then 20, and oob_grown reads memory that
# memgrow added.
profile base.
unsafe program.

V = use "wasmvm".
W = use "wat".
File = use "std/file".
List = use "std/list".
Program = use "std/program".

Expect = Type (Returns (List V.Val) | Traps String).

i32c n = V.VI32 (V.m32 n).
# from an Int that holds the value (anything within 63 bits)
i64c n = low = V.m32 n; V.VI64 (V.m32 ((n - low) / 4294967296)) low.
f32c : F64 -> V.Val .
f32c x = V.VF32 (F32.ofF64 x).
f64c : F64 -> V.Val .
f64c x = V.VF64 x.

suite = [
  ("fib", [i32c 20], Returns [i32c 6765]),
  ("dispatch", [i32c 0, i32c 7, i32c 5], Returns [i32c 12]),
  ("dispatch", [i32c 1, i32c 7, i32c 5], Returns [i32c 2]),
  ("dispatch", [i32c 2, i32c 7, i32c 5], Returns [i32c 35]),
  ("dispatch_badtype", [i32c 5], Traps "type mismatch"),
  ("dispatch_oob", Nil, Traps "undefined element"),
  ("wrap", Nil, Returns [i32c (0 - 2147483648)]),
  ("divtrap", Nil, Traps "integer overflow"),
  ("divzero", Nil, Traps "divide by zero"),
  ("rem_s", Nil, Returns [i32c (0 - 1)]),
  ("i64mul", Nil, Returns [i64c 0]),
  ("i64big", Nil, Returns [i64c 12884901888]),
  ("shr_s", Nil, Returns [i32c (0 - 4)]),
  ("shr_u", Nil, Returns [i32c 1073741820]),
  ("rotl", Nil, Returns [i32c 3]),
  ("clz", Nil, Returns [i32c 31]),
  ("ctz64", Nil, Returns [i64c 32]),
  ("popcnt", Nil, Returns [i32c 8]),
  ("ext8", Nil, Returns [i32c (0 - 128)]),
  ("lt_u", Nil, Returns [i32c 0]),
  ("lt_s", Nil, Returns [i32c 1]),
  ("extend_u", Nil, Returns [i64c 4294967295]),
  ("extend_s", Nil, Returns [i64c (0 - 1)]),
  ("f64div", Nil, Returns [f64c 0.25]),
  ("nearest_even", Nil, Returns [f64c 2.0]),
  ("nearest_odd", Nil, Returns [f64c 4.0]),
  ("fmin_zero", Nil, Returns [V.VI64 2147483648 0]),
  ("copysign", Nil, Returns [f32c (0.0 - 3.0)]),
  ("truncsat", Nil, Returns [i32c 4294967295]),
  ("truncsat_neg", Nil, Returns [i32c (0 - 2147483648)]),
  ("truncsat_nan", Nil, Returns [i32c 0]),
  ("trunctrap", Nil, Traps "integer overflow"),
  ("trunc_ok", Nil, Returns [i32c (0 - 7)]),
  ("reinterp", Nil, Returns [i32c 1065353216]),
  ("convert", Nil, Returns [f64c 4294967295.0]),
  ("demote", Nil, Returns [f32c 0.1]),
  ("brtable", [i32c 0], Returns [i32c 0]),
  ("brtable", [i32c 1], Returns [i32c 10]),
  ("brtable", [i32c 2], Returns [i32c 20]),
  ("brtable", [i32c 5], Returns [i32c 20]),
  ("brval", Nil, Returns [i32c 43]),
  ("select", [i32c 1], Returns [i32c 111]),
  ("select", [i32c 0], Returns [i32c 222]),
  ("loop_sum", [i32c 100], Returns [i32c 5050]),
  ("early_return", Nil, Returns [i32c 7]),
  ("unreachable", Nil, Traps "unreachable"),
  ("stack_overflow", Nil, Traps "call stack exhausted"),
  ("global_inc", Nil, Returns [i32c 10]),
  ("global_inc", Nil, Returns [i32c 20]),
  ("mem_le", Nil, Returns [i32c 68]),
  ("mem16s", Nil, Returns [i32c (0 - 2)]),
  ("mem_i64", Nil, Returns [i64c 4294967294]),
  ("mem_f64", Nil, Returns [f64c 2.5]),
  ("memgrow", Nil, Returns [i32c 3]),
  ("memfill", Nil, Returns [i32c 117901063]),
  ("oob", Nil, Traps "out of bounds"),
  ("oob_grown", Nil, Returns [i32c 0])].

noHost md nm args inst = Err "unexpected host call {md}.{nm}".

typeTag v = case v of V.VI32 _ -> "i32" | V.VI64 _ _ -> "i64" | V.VF32 _ -> "f32" | V.VF64 _ -> "f64".
showV v = "{V.showVal v}{typeTag v}".
showVs vs = "[{strJoin ", " (List.map showV vs)}]".

sameVals got want = List.length got == List.length want
  and List.all (fn p -> case p of (a, b) -> V.valEq a b) (List.zip got want).

met result want = case result of
    Ok vs -> (case want of Returns ws -> sameVals vs ws | Traps _ -> False)
  | Err e -> (case want of Traps part -> strIndexOf part e >= 0 | Returns _ -> False).

# (the instance, suite passed)
runCase (inst, passed) (name, args, want) =
  (result, next) = V.invoke noHost inst name args;
  ok = met result want;
  shown = (case result of Ok vs -> showVs vs | Err e -> e);
  _ = print "{(case ok of True -> "  ok   " | False -> "  FAIL ")}{name}{showVs args} -> {shown}";
  (next, (case ok of True -> passed + 1 | False -> passed)).

pathOf args = case args of p :: _ -> p | Nil -> "examples/wasm/tests.wat".

main = path = pathOf (Program.args Unit); case File.readText path of
    Err why -> Program.fail 1 "wasmtest: {path}: {why}"
  | Ok src -> (case W.parse src of
        Err why -> Program.fail 1 "wasmtest: parse error: {why}"
      | Ok pm -> runAll pm.module).

runAll m =
  start = (V.instantiate m, 0);
  (inst, count) = List.fold runCase start suite;
  _ = print "{count}/{List.length suite} passed";
  case count == List.length suite of True -> Unit | False -> Program.exit 1.

#!/usr/bin/env -S fpr run
# calc.fpr -- the calculator demo of the Haskell HaskPlayground/src/WASM/Main.hs:
# a hand-written WebAssembly calculator (calc.wat) run by the VM in wasmvm.fpr,
# under the capability scheduler in actors.fpr.
#
#   fpr run examples/wasm/calc.fpr                    # the Haskell demo's five runs
#   fpr run examples/wasm/calc.fpr "6 * 7" "81 / 9"   # your expressions
#
# The calculator opens "expr.txt", which the world holds in memory; the open
# is capability-gated, so the first one suspends the actor and asks the user
# (here a policy that allows reading expr.txt and nothing else).  With no
# arguments the first run interleaves it with ticker.wat, slice by slice.
# The .wat files are read from WASM_DIR, by default examples/wasm.
#
# Everything from `main` down to the scheduler is marked unsafe: the rounds
# end when the guests do, and that is theirs to decide.
profile base.

A = use "actors".
V = use "wasmvm".
W = use "wat".
File = use "std/file".
List = use "std/list".
O = use "std/option".
Program = use "std/program".
R = use "std/result".

mayRead (A.FileCap A.R "expr.txt") = True.
mayRead _ = False.

worldFor expr = A.mkWorld [("expr.txt", "{expr}\n")] mayRead.

inFile path why = "{path}: {why}".

# (the program, its _start function)
entryOf path parsed = V.exportOf "_start" parsed.program |> O.map (fn entry -> (parsed.program, entry)) |> O.toResult "{path}: no _start export".

load : unsafe String -> Result (V.Program, Int) String .
load path = File.readText path |> R.andThen W.parse |> R.mapError (inFile path) |> R.andThen (entryOf path).

actorFrom name (program, entry) = A.mkActor name (V.instantiate program) entry.

runCalc : unsafe (V.Program, Int) -> String -> Unit .
runCalc calc expr =
  _ = print "";
  _ = print "=== run: {A.quoted expr} ===";
  A.runRounds (worldFor expr) [actorFrom "calc" calc].

# the Haskell demo: calc and ticker interleaved, then four more expressions
demo : unsafe (V.Program, Int) -> Result (V.Program, Int) String -> Unit .
demo _ (Err why) = Program.fail 1 "calc: {why}".
demo calc (Ok tick) =
  _ = print "=== run 1: \"23 * 45\"  (calc + ticker interleaved; open prompts user) ===";
  _ = A.runRounds (worldFor "23 * 45") [actorFrom "calc" calc, actorFrom "ticker" tick];
  List.each (runCalc calc) ["100 / 7", "7 - 100", "9 / 0", "1 ? 2"].

run : unsafe String -> List String -> Result (V.Program, Int) String -> Unit .
run _ _ (Err why) = Program.fail 1 "calc: {why}".
run dir Nil (Ok calc) = demo calc (load "{dir}/ticker.wat").
run _ exprs (Ok calc) = List.each (runCalc calc) exprs.

start : unsafe String -> Unit .
start dir = run dir (Program.args Unit) (load "{dir}/calc.wat").

main : Unit .
main = start (Program.envOr "examples/wasm" "WASM_DIR").

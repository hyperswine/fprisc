# ============================================================================
# pos1.fpr -- POS v1 (qos/docs/2026-09-07-POS1-DESIGN.md): a point of sale for one small
# shop, in FP-RISC Base on the posix system, served by std/live (the posix
# driver of FPRLive; the QOS original is qos/programs/pos1.fpr).  Registers
# are websocket sessions over ONE model actor; the disk holds ONE append-only
# log, and that log is the shop.
#
#   fpr run examples/pos1.fpr [--port=6710] [--address=0.0.0.0] [--store=pos1.log]
#                             [--metrics=pos1.prom]   (stock gauges, Prometheus text)
#
# THE ONE RULE.  Every change to the shop is a LINE, and one function --
# `apply` -- is the only thing that reads a line into the model.  A live
# handler validates (guards that refuse and say why), then `commit`s the
# line: apply it and queue it for the disk.  Boot is the same `apply`
# folded over the log.  So the state a register shows is, by construction,
# what a restart would rebuild -- there is no second interpretation of a
# sale anywhere.  Stock, revenue and the "void" mark on a receipt are
# caches of that fold; `rebuild` folds the disk again and compares.
#
#   product <sku> <price> <stock> <name...>       (a new product; cents)
#   retire <sku> <cashier> <at>
#   staff <name> <pin>
#   tax <basis points>   lowat <n>   price <sku> <cents> <cashier> <at>
#   restock <sku> <delta> <cashier> <at>
#   sale <n> <cashier> <at> <pay> <tendered> <total> <tax> <sku>=<qty>=<price>...
#   void <n> <cashier> <at>
#
# A checkout is ONE line, appended in one write, so a receipt, its stock
# change and its revenue all come from that line or none of them do.  The
# log is written from `update` itself, in event order: std/live performs
# commands in their own actors, and the ORDER of this log is its meaning.  A void or
# a restock is a NEW line that names what it corrects; a committed sale
# is never rewritten.
#
# Live pricing (from this checkout; use an isolated store while experimenting):
#   fpr commit examples/pos1_pricing.fpr
#   fpr watch examples/pos1.fpr --module pos1_pricing
# Commit edits to examples/pos1_pricing.fpr in another terminal in the same cwd.
# POS1_PORT / POS1_STORE select the listener and receipt log. Ordinary fpr run
# uses the statically imported default policy.
#
#   login ana / 1234 (or ben / 2222)
#
# qos/tests-host/pos1-check.py drives it as websocket registers, the
# well-behaved and the adversarial (the last-unit race, a void twice, a
# crash across a checkout, a thousand receipts, delta-not-reshape edits).
# ============================================================================

unsafe base.

Live = use "std/live".
Reload = use "std/livereload".
Notice = use "std/livenotice".
Watch = use "std/watch".
Pricing = use "pos1_pricing".
G = use "std/view".
Appearance = use "std/appearance".
C = use "std/clientcalc".
B = use "std/browsercalc".
Money = use "std/money".
LJ = use "std/livejs".
Metrics = use "std/livemetrics".
VC = use "std/viewcache".
List = use "std/list".
S = use "std/string".
File = use "std/file".
LF = use "std/logfile".
Clock = use "std/clock".
Config = use "std/config".
Decode = use "std/decode".
Json = use "std/json".
Program = use "std/program".
Option = use "std/option".
Result = use "std/result".

element tag attrs kids = G.El tag (elementDefaults tag :: attrs) kids.
elementDefaults tag = G.utilities ([G.BoxSizing G.BorderBox, G.Margin (G.Px 0)] + (if tag == "button" then [G.FontFamily G.InheritFont, G.FontSize G.Inherit] else Nil)).
Txt = G.Txt.
Dyn = G.Dyn.
Cls = G.Cls.
Att = G.Att.
input attrs = G.Inp (elementDefaults "input" :: attrs).
strEq : String -> String -> Bool .
strEq a b = a == b.

# every message a register can send, and its wire: the arguments that come
# from the page's own inputs arrive as the LAST field (G.wireOpen), "a|b" when
# there are two
# What happens IN the page stays in the page: the tab, the cart's quantities,
# the inputs are client state (Client, and one quantity per product), and
# changing them sends nothing.  `ClientState` is the mirror: the page's
# locals as JSON, sent every half second when they changed and just before
# any other message (Live.SyncClientState), so a checkout sees the cart the
# cashier saw.  The server still decides: it clamps to stock, prices, sells.
Msg = Type (Login String | Logout | Quit | ClientState String
          | Cash String | Card | Void Int | Restock String | Admin String | Rebuild | Dismiss | Theme | PricingPoll | NoticeTick).
codec = @Msg.
Client = { tab : String, open : String, tender : String, delta : String, rsku : String, cmd : String, name : String, pin : String }.

# the QOS fold took the element first; the app is written that way
foldE f z l = List.fold (fn acc x -> f x acc) z l.

# ---- the model --------------------------------------------------------------------
# products carry their stock (the cache of the fold); sessions are the
# registers: cart, toast and console output live per session

initModel = { cat = Nil, tax = 0, lowAt = 3, sales = Nil, nsale = 0, revenue = 0, staff = Nil,
              sess = Nil, pend = Nil, events = 0, theme = 0, fsOn = 0, booted = 0, prof = noProf, pricing = staticPricing, reloadNotice = Notice.init False 3000, metrics = "", sink = LF.sink "" 0 }.

# ---- profiling ---------------------------------------------------------------------------
# What the app measures about itself, shown on the Admin tab (microseconds):
#   update   per kind of event: how long `step` took, i.e. the app's own work
#   flush    how long the disk append took, per event that wrote
#   boot     folding the log at start
#   render   per SESSION, in its writer: how long `view` took, and the view
#            cache's hits and misses (kept in the writer's cache, so it lags
#            the render that shows it by one)
#   memory   the runtime's ledgers (Sys.memInfo, Sys.memStats) and harts
#   rtt      in the browser: from a click's send to the next frame received
# A Stat is a count, a sum and a maximum; the profile is only projected to a
# session on the Admin tab, so measuring costs the other registers nothing.
noStat = { n = 0, sum = 0, max = 0, last = 0 }.
note st us = { n = st.n + 1, sum = st.sum + us, max = imax st.max us, last = us }.
avg st = case st.n == 0 of True -> 0 | False -> st.sum / st.n.
noProf = { bootUs = 0, bootLines = 0, upd = Nil, flush = noStat, nev = 0 }.
noteUpd kind us prof = { prof | upd = noteKind prof.upd kind us, nev = prof.nev + 1 }.
noteKind Nil kind us = (kind, note noStat us) :: Nil.
noteKind ((k, st) :: r) kind us | strEq k kind = (k, note st us) :: r.
noteKind (e :: r) kind us = e :: noteKind r kind us.
kindOf ev = case ev of
    Live.Msg sid msg -> msgKind msg
  | Live.Joined sid -> "join"
  | Live.Left sid -> "leave"
  | Live.Refused sid why -> "refused".
msgKind msg = case msg of
    Login a -> "login" | Logout -> "logout" | Quit -> "quit" | ClientState a -> "sync"
  | Cash a -> "cash" | Card -> "card" | Void a -> "void" | Restock a -> "restock" | Admin a -> "admin" | Rebuild -> "rebuild"
  | Dismiss -> "dismiss" | Theme -> "theme" | PricingPoll -> "pricing" | NoticeTick -> "reload-notice".
statLine label st = "{S.padRight 9 " " label} n {S.padLeft 6 " " "{st.n}"}  avg {S.padLeft 7 " " "{avg st}"} us  max {S.padLeft 7 " " "{st.max}"} us  last {st.last} us".
noSess = { sid = 0, cashier = "", cart = Nil, toast = "", role = "", con = Nil, tab = 1 }.
mkProduct sku price stock name = { sku = sku, name = name, price = price, stock = stock, retired = 0 }.

# the seed: a shop that has never been opened gets this, on the disk
seed =
  "product FW 500 12 flat white" :: "product LB 400 12 long black" :: "product CT 900 12 cheese toastie" ::
  "product BR 600 12 brownie" :: "product CC 700 12 carrot cake" :: "product SW 300 12 sparkling water" ::
  "staff ana 1234" :: "staff ben 2222" :: "tax 1000" :: "lowat 3" :: Nil.

# ---- little prelude -----------------------------------------------------------------

rev l acc = l |> foldE (fn x xs -> x :: xs) acc.
# the leading digits of s, 0 when there are none (a line's numbers are our own)
num s = numGo s 0 (strlen s) 0.
numGo s i n acc | i >= n = acc.
numGo s i n acc | isDig (charAt s i) = numGo s (i + 1) n (acc * 10 + charAt s i - 48).
numGo s i n acc = acc.
words s = S.words s.
unwords ws = S.join " " ws.
# "a|b" -> (a, b) at the first bar; no bar: (s, "")
splitBar s = sbGo s 0 (strlen s).
sbGo s i n | i >= n = (s, "").
sbGo s i n | charAt s i == 124 = (substr s 0 i, substr s (i + 1) (n - i - 1)).
sbGo s i n = sbGo s (i + 1) n.
# "a=b=c" -> list of parts
splitEq s = seGo s 0 0 (strlen s) Nil.
seGo s st i n acc | i >= n = rev (substr s st (i - st) :: acc) Nil.
seGo s st i n acc | charAt s i == 61 = seGo s (i + 1) (i + 1) n (substr s st (i - st) :: acc).
seGo s st i n acc = seGo s st (i + 1) n acc.
takeN l 0 = Nil.
takeN Nil n = Nil.
takeN (x :: r) n = x :: takeN r (n - 1).
imax a b | a > b = a.
imax a b = b.
imin a b | a < b = a.
imin a b = b.
# a name for the log: letters and digits only, 1..16 of them
wordy s = strlen s >= 1 and strlen s <= 16 and wdGo s 0 (strlen s).
wdGo s i n | i >= n = True.
wdGo s i n =
  c = charAt s i;
  ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122);
  case ok of True -> wdGo s (i + 1) n | False -> False.
pad2 n | n < 10 = "0{n}".
pad2 n = "{n}".
money c = Money.format c.
# "12.50", "12.5" or "12" -> cents (other characters are skipped)
cents s = cWhole s 0 (strlen s) 0.
cWhole s i n acc | i >= n = acc * 100.
cWhole s i n acc | charAt s i == 46 = acc * 100 + cFrac s (i + 1) n 10 0.
cWhole s i n acc | isDig (charAt s i) = cWhole s (i + 1) n (acc * 10 + charAt s i - 48).
cWhole s i n acc = cWhole s (i + 1) n acc.
cFrac s i n mul acc | i >= n or mul == 0 = acc.
cFrac s i n mul acc | isDig (charAt s i) = cFrac s (i + 1) n (mul / 10) (acc + (charAt s i - 48) * mul).
cFrac s i n mul acc = acc.
isDig c = c >= 48 and c <= 57.
bi True = 1.
bi False = 0.

# ---- time ---------------------------------------------------------------------------
# epoch seconds -> "YYYY-MM-DD HH:MM" (UTC; civil-from-days)

fmtTime 0 = "--".
fmtTime t =
  days = t / 86400;
  secs = t % 86400;
  (y, mo, d) = civil days;
  "{y}-{pad2 mo}-{pad2 d} {pad2 (secs / 3600)}:{pad2 (secs % 3600 / 60)}".
civil z0 =
  z = z0 + 719468;
  era = z / 146097;
  doe = z - era * 146097;
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  mp = (5 * doy + 2) / 153;
  d = doy - (153 * mp + 2) / 5 + 1;
  mo = case mp < 10 of True -> mp + 3 | False -> mp - 9;
  y = yoe + era * 400 + bi (mo <= 2);
  (y, mo, d).
dayOf t = t / 86400.

# ---- products -------------------------------------------------------------------------

findP Nil sku = mkProduct "" 0 0 "".
findP (p :: r) sku | strEq p.sku sku = p.
findP (p :: r) sku = findP r sku.
hasP cat sku =
  p = findP cat sku;
  strlen p.sku > 0.
priceOf cat sku = p = findP cat sku; p.price.
stockOf cat sku = p = findP cat sku; p.stock.
nameOf cat sku = p = findP cat sku; p.name.
# the product sku changed by f
mapP Nil sku f = Nil.
mapP (p :: r) sku f | strEq p.sku sku = f p :: r.
mapP (p :: r) sku f = p :: mapP r sku f.
setStock cat sku d = mapP cat sku (fn p -> { p | stock = p.stock + d }).
live Nil = Nil.
live (p :: r) | p.retired == 1 = live r.
live (p :: r) = p :: live r.
pCount cat = List.length (live cat).

# ---- the interpreter: one line into the model --------------------------------------
# the whole meaning of the log, live and at boot alike

apply m line =
  case words line of
    Nil -> m
  | w :: r -> applyW m w r.
applyW m w r | strEq w "product" = (case r of
    sku :: price :: stock :: nameWs -> addP m sku (num price) (num stock) (unwords nameWs)
  | x -> m).
applyW m w r | strEq w "retire" = (case r of
    sku :: x -> { m | cat = mapP m.cat sku (fn p -> { p | retired = 1 }) }
  | x -> m).
applyW m w r | strEq w "staff" = (case r of
    name :: pin :: x -> { m | staff = (name, pin) :: dropStaff m.staff name }
  | x -> m).
applyW m w r | strEq w "tax" = (case r of n :: x -> { m | tax = num n } | x -> m).
applyW m w r | strEq w "lowat" = (case r of n :: x -> { m | lowAt = num n } | x -> m).
applyW m w r | strEq w "price" = (case r of
    sku :: c :: x -> { m | cat = mapP m.cat sku (fn p -> { p | price = num c }) }
  | x -> m).
applyW m w r | strEq w "restock" = (case r of
    sku :: d :: x -> addStock m sku (num d)
  | x -> m).
applyW m w r | strEq w "sale" = applySale m r.
applyW m w r | strEq w "void" = (case r of
    n :: who :: at :: x -> applyVoid m (num n) who (num at)
  | x -> m).
applyW m w r = m.

addP m sku price stock name | hasP m.cat sku = m.
addP m sku price stock name = { m | cat = m.cat + (mkProduct sku price stock name :: Nil) }.
addStock m sku d = { m | cat = setStock m.cat sku d }.
dropStaff Nil name = Nil.
dropStaff ((nm, pn) :: r) name | strEq nm name = dropStaff r name.
dropStaff (e :: r) name = e :: dropStaff r name.

# sale <n> <cashier> <at> <pay> <tendered> <total> <tax> <items...>
applySale m r = case r of
    n :: who :: at :: pay :: tend :: total :: tax :: items ->
      ls = items |> List.map (fn it -> lineOf m it);
      s = { n = num n, cashier = who, at = num at, pay = num pay, tendered = num tend, total = num total,
            tax = num tax, lines = ls, voided = 0, voidBy = "", voidAt = 0 };
      { m | sales = s :: m.sales, nsale = imax m.nsale (num n), revenue = m.revenue + num total,
            cat = ls |> foldE (fn l c -> takeLine c l) m.cat }
  | x -> m.
takeLine cat (sku, q, pr, nm) = setStock cat sku (0 - q).
giveLine cat (sku, q, pr, nm) = setStock cat sku q.
lineOf m it = case splitEq it of
    sku :: q :: pr :: x -> (sku, num q, num pr, nameOf m.cat sku)
  | x -> ("?", 0, 0, "?").

applyVoid m n who at =
  s = findSale m.sales n;
  case s.n == n and s.voided == 0 of
    False -> m
  | True ->
    { m | sales = m.sales |> List.map (fn x -> markVoid x n who at),
          revenue = m.revenue - s.total,
          cat = s.lines |> foldE (fn l c -> giveLine c l) m.cat }.
markVoid x n who at | x.n == n = { x | voided = 1, voidBy = who, voidAt = at }.
markVoid x n who at = x.
noSale = { n = 0, cashier = "", at = 0, pay = 0, tendered = 0, total = 0, tax = 0, lines = Nil, voided = 0, voidBy = "", voidAt = 0 }.
findSale Nil n = noSale.
findSale (s :: r) n | s.n == n = s.
findSale (s :: r) n = findSale r n.

# a validated change: applied now, queued for the disk
commit m line = apply { m | pend = line :: m.pend, events = m.events + 1 } line.

# ---- the disk ----------------------------------------------------------------------------

# the log is a text file, one line per change; a shop that has no log yet
# gets the seed, written as its first lines.
#
# The log is read once.  A last line without its newline is a torn append (the
# process died mid-write): it is cut off before anything is appended after it,
# or the next line would be glued to it and lost as well.  The writer's sink
# (std/logfile) starts at the size that is left, so its first write knows it is
# still that file.  A log that is there and cannot be read stops the start: a
# shop must never be seeded over one it could not see.
boot path =
  m0 = { initModel | booted = Clock.now Unit };
  t0 = Sys.timeUs Unit;
  bytes = logBytes path;
  keep = LF.wholeLines bytes;
  _ = (case keep < strlen bytes of
         True -> (case LF.truncate path keep of
             Ok _ -> Sys.stderr "[pos1] cut a torn last line ({strlen bytes - keep} bytes) off {path}\n"
           | Err why -> error "pos1: cannot cut the torn end off {path}: {why}")
       | False -> Unit);
  m2 = replayed m0 (Ok (S.lines (substr bytes 0 keep)));
  t1 = Sys.timeUs Unit;
  m3 = case pCount m2.cat == 0 of
    True -> seed |> foldE (fn l mm -> commit mm l) m2
  | False -> m2;
  _ = print "[pos1] log {path}: {m3.events} lines folded in {t1 - t0} us, {pCount m3.cat} products, {List.length m3.sales} sales, revenue {money m3.revenue}";
  flush path { m3 | fsOn = 1, sink = LF.sink path keep, prof = { noProf | bootUs = t1 - t0, bootLines = m2.events } }.
# no log yet is an empty one, created now so the writer opens the file it
# expects; a log that is there and cannot be read stops the start
logBytes path | not (File.exists path) = (case File.writeText path "" of
    Ok _ -> ""
  | Err why -> error "pos1: cannot create {path}: {why}").
logBytes path = case File.readBytes path of
    Ok bytes -> bytes
  | Err why -> error "pos1: cannot read {path}: {why}".
replayed m (Ok ls) = ls |> foldE (fn l mm -> apply { mm | events = mm.events + 1 } l) m.
replayed m (Err e) = m.

# The pending lines, oldest first, in ONE write to the log the server keeps
# open (std/logfile: opening the file for every append was most of an
# append's cost).  A write that fails stops the server: a register must never
# show a change the log does not have (THE ONE RULE), and the supervisor's
# restart folds the log again.
#
# Before each write the sink checks the path still names the file it left.
# When it does not -- a backup restored over it, the file emptied or replaced
# while the server runs -- the change still goes in (every line stands alone),
# and then the server stops, to fold what the file holds now.
flush path m = case m.pend of
    Nil -> m
  | ls ->
    bytes = S.concat (List.map (fn l -> "{l}\n") (rev ls Nil));
    (case LF.ready m.sink of
        LF.Same s -> wrote path m (LF.write s bytes)
      | LF.Fresh s -> underUs path s bytes "is empty now"
      | LF.Other s -> underUs path s bytes "is not the file this server wrote"
      | LF.Failed s why -> error "pos1: cannot write {path}: {why}").
wrote path m (Ok s) = { m | pend = Nil, sink = s }.
wrote path m (Err why) = error "pos1: cannot write {path}: {why}".
underUs path s bytes what =
  _ = (case LF.write s bytes of Ok _ -> Unit | Err why -> Sys.stderr "[pos1] cannot write {path}: {why}\n");
  error "pos1: {path} {what}: wrote this change to it and stopped, to fold the file again".

# ---- stock, for a scraper ------------------------------------------------------------------
# With --metrics=FILE the stock of every live product, and the low-stock mark,
# are kept in FILE as Prometheus text (a node_exporter / Alloy textfile
# collector reads it).  It is a VIEW of the model like the page is: rewritten
# after any update that moved a stock or the mark (a sale, a void, a restock,
# a product added or retired, a rebuild) and at boot, written beside and
# renamed over so a reader never sees half of it.  The log is still the shop.
stockMoved m n = not (n.cat == m.cat) or n.lowAt != m.lowAt.
writeStock m | strEq m.metrics "" = 0.
writeStock m = case File.writeText "{m.metrics}.tmp" (promText m) of
    Err why -> _ = Sys.stderr "[pos1] metrics: {why}\n"; 1
  | Ok _ -> (case File.rename "{m.metrics}.tmp" m.metrics of
      Ok _ -> 0
    | Err why -> _ = Sys.stderr "[pos1] metrics: {why}\n"; 1).
promText m = S.concat (
  "# HELP pos1_stock Units in stock, per live product (the shop log, folded).\n# TYPE pos1_stock gauge\n" ::
  (live m.cat |> List.map promLine) +
  ("# HELP pos1_low_stock_at A product at or below this stock is low.\n# TYPE pos1_low_stock_at gauge\npos1_low_stock_at {m.lowAt}\n" :: Nil)).
promLine p = "pos1_stock\{sku=\"{promEsc p.sku}\",name=\"{promEsc p.name}\"} {p.stock}\n".
promEsc v = S.replace "\"" "\\\"" (S.replace "\\" "\\\\" v).

# the log wins: fold the disk again and compare every product's stock
rebuild path m = case File.lines path of
    Err why -> (m, "cannot read the log: {why}")
  | Ok ls -> rebuildWith m (replayed initModel (Ok ls)).
rebuildWith m m2 =
  diffs = m.cat |> foldE (fn p acc -> acc + bi (stockOf m2.cat p.sku != p.stock)) 0;
  case diffs == 0 of
    True -> (m, "stock matches the log ({List.length m2.sales} sales folded)")
  | False -> ({ m | cat = m2.cat, revenue = m2.revenue, sales = m2.sales }, "rebuilt from the log: {diffs} products corrected").

# ---- sessions ----------------------------------------------------------------------------

sGet Nil sid = { noSess | sid = sid }.
sGet (s :: r) sid | s.sid == sid = s.
sGet (s :: r) sid = sGet r sid.
sPut m s = { m | sess = s :: sDel m.sess s.sid }.
sDel Nil sid = Nil.
sDel (s :: r) sid | s.sid == sid = sDel r sid.
sDel (s :: r) sid = s :: sDel r sid.
forget m sid = { m | sess = sDel m.sess sid }.
# a toast: text with a role (ok, warn, bad, celebrate)
toast m sid role text =
  s = sGet m.sess sid;
  sPut m { s | toast = text, role = role }.
say m sid text = toast m sid "ok" text.
refuse m sid text = toast m sid "warn" text.
withCart m sid cart =
  s = sGet m.sess sid;
  sPut m { s | cart = cart }.

# ---- update ------------------------------------------------------------------------------

update path ev m =
  t0 = Sys.timeUs Unit;
  (m2, cs) = step path ev m;
  t1 = Sys.timeUs Unit;
  wrote = not (List.isEmpty m2.pend);
  m3 = flush path m2;
  t2 = Sys.timeUs Unit;
  # after t2: the profile's "append" is the log's write alone
  _ = case stockMoved m m3 of True -> writeStock m3 | False -> 0;
  prof = noteUpd (kindOf ev) (t1 - t0) m3.prof;
  ({ m3 | prof = (case wrote of True -> { prof | flush = note prof.flush (t2 - t1) } | False -> prof) }, cs).
step path ev m = case ev of
    Live.Msg sid msg -> pMsg path sid msg m
  | Live.Left sid -> (forget m sid, Nil)
  | Live.Joined sid -> (m, Nil)
  | Live.Refused sid why -> (refuse m sid "refused: {why}", Nil).

pMsg path sid msg m = case msg of
    Login arg -> signIn m sid (login m sid arg)
  # signing out empties the page's cart too, so the next cashier starts clean
  | Logout -> signOut m sid (sGet m.sess sid)
  | PricingPoll -> (case sid == 0 of True -> (pollPricing m, Nil) | False -> (m, Nil))
  | NoticeTick -> (case sid == 0 of True -> ({m | reloadNotice = Notice.tick m.reloadNotice}, Nil) | False -> (m, Nil))
  | Quit -> (m, Live.Quit :: Nil)
  | ClientState json -> mirror m sid json
  | other -> withUser path sid other m (sGet m.sess sid).

# a PIN has done its work once it is checked: the page forgets it
signIn m sid m2 = s = sGet m2.sess sid; (m2, case strEq s.cashier "" of True -> Nil | False -> Live.Emit sid "locals" (localsJson (("pin", "") :: Nil)) :: Nil).
signOut m sid s = (forget m sid, Live.Emit sid "locals" (localsJson (("tender", "") :: ("tab", "1") :: zeros m s.cart)) :: Nil).

# signing in keeps what the page already mirrored (its tab, its cart)
login m sid arg =
  (name, pin) = splitBar arg;
  s0 = sGet m.sess sid;
  case wordy name and wordy pin and pinOk m.staff name pin of
    True -> sPut m { s0 | cashier = name, toast = "", role = "", con = Nil }
  | False -> refuse m sid "unknown cashier or PIN".

# ---- the mirror: the page's client state, as the server knows it --------------------
# {"tab":"2","q_FW":"3","tender":"20",...}: every local is text.  The cart is
# the quantities of the products that exist, each inside [0, stock]; a
# quantity the page holds past that is put right in the page.
mirror m sid json = case Json.parse json of
    Err why -> (m, Nil)
  | Ok v ->
    s = sGet m.sess sid;
    asked = live m.cat |> List.map (fn p -> (p, num (localOf v "q_{p.sku}")));
    cart = rev (asked |> foldE (fn pq acc -> keepLine pq acc) Nil) Nil;
    fixes = asked |> foldE (fn pq acc -> fixLine pq acc) Nil;
    (sPut m { s | tab = num (localOf v "tab"), cart = cart },
     case fixes of Nil -> Nil | fs -> Live.Emit sid "locals" (localsJson fs) :: Nil).
clampQ p q = imax 0 (imin q (imin 999 p.stock)).
keepLine (p, q) acc = case clampQ p q > 0 of True -> (p.sku, clampQ p q) :: acc | False -> acc.
fixLine (p, q) acc = case clampQ p q == q of True -> acc | False -> ("q_{p.sku}", "{clampQ p q}") :: acc.
localOf v name = Option.withDefault "" (Option.andThen Json.asString (Json.field name v)).
localsJson kvs = Json.render (Json.object (kvs |> List.map (fn kv -> (case kv of (k, x) -> (k, Json.Text x))))).
zeros m cart = cart |> List.map (fn l -> (case l of (k, q) -> ("q_{k}", "0"))).
# a sale empties the cart: the page's copy of it as well
sold m sid s m2 =
  s2 = sGet m2.sess sid;
  case List.isEmpty s2.cart and not (List.isEmpty s.cart) of
    True -> (m2, Live.Emit sid "locals" (localsJson (("tender", "") :: zeros m s.cart)) :: Nil)
  | False -> (m2, Nil).
pinOk Nil name pin = False.
pinOk ((nm, pn) :: r) name pin | strEq nm name = strEq pn pin.
pinOk (e :: r) name pin = pinOk r name pin.

withUser path sid msg m s | strEq s.cashier "" = (refuse m sid "sign in first", Nil).
withUser path sid msg m s = case msg of
    Cash arg -> sold m sid s (checkout m sid s 0 (cents arg))
  | Card -> sold m sid s (checkout m sid s 1 0)
  | Void n -> (voidSale m sid s n, Nil)
  | Restock arg -> (restock m sid s (splitBar arg), Nil)
  | Admin cmd -> (console path m sid s cmd, Nil)
  | Rebuild -> (console path m sid s "rebuild", Nil)
  | Dismiss -> (toast m sid "" "", Nil)
  | Theme -> ({ m | theme = 1 - m.theme }, Nil)
  | other -> (refuse m sid "no such action", Nil).

# ---- the cart ------------------------------------------------------------------------------

qtyOf Nil sku = 0.
qtyOf ((k, q) :: r) sku | strEq k sku = q.
qtyOf (l :: r) sku = qtyOf r sku.
subtotal m cart = cart |> foldE (fn l acc -> acc + lineTotal m l) 0.
lineTotal m (k, q) = q * priceOf m.cat k.
taxOn m sub = Money.tax sub (activeRate m).
totalOf m cart = sub = subtotal m cart; sub + taxOn m sub.

# ---- checkout: one line ------------------------------------------------------------------------

covered m Nil = "".
covered m ((k, q) :: r) | q > stockOf m.cat k = "{nameOf m.cat k}: only {stockOf m.cat k} left".
covered m (l :: r) = covered m r.

checkout m sid s pay tendered | List.length s.cart == 0 = refuse m sid "the cart is empty".
checkout m sid s pay tendered =
  short = covered m s.cart;
  sub = subtotal m s.cart;
  tax = taxOn m sub;
  total = sub + tax;
  case strlen short > 0 of
    True -> refuse m sid short
  | False -> (case pay == 0 and tendered < total of
      True -> refuse m sid "cash short by {money (total - tendered)}"
    | False -> sell m sid s pay tendered total tax).
sell m sid s pay tendered total tax =
  n = m.nsale + 1;
  at = Clock.now Unit;
  first = case m.sales of Nil -> True | x :: r -> dayOf x.at != dayOf at;
  items = s.cart |> List.map (fn l -> itemWord m l);
  line = "sale {n} {s.cashier} {at} {pay} {case pay == 0 of True -> tendered | False -> total} {total} {tax} " + unwords items;
  m2 = withCart (commit m line) sid Nil;
  change = case pay == 0 of True -> "   change {money (tendered - total)}" | False -> "";
  toast m2 sid (case first of True -> "celebrate" | False -> "ok")
        (case first of True -> "first sale of the day: receipt #{n} for {money total}{change}" | False -> "receipt #{n} for {money total}{change}").

itemWord m (k, q) = "{k}={q}={priceOf m.cat k}".

voidSale m sid s n =
  x = findSale m.sales n;
  case x.n == n of
    False -> refuse m sid "no receipt #{n}"
  | True -> (case x.voided == 1 of
      True -> refuse m sid "receipt #{n} is already void"
    | False -> say (commit m "void {n} {s.cashier} {Clock.now Unit}") sid "receipt #{n} void: stock returned").

restock m sid s (sku, ds) =
  p = findP m.cat sku;
  d = num ds;
  case strlen p.sku == 0 of
    True -> refuse m sid "no such product"
  | False -> (case d < 1 or d > 999 of
      True -> refuse m sid "restock by 1 to 999"
    | False -> (case p.stock + d > 9999 of
        True -> refuse m sid "{p.name}: the shelf holds 9999"
      | False -> say (commit m "restock {sku} {d} {s.cashier} {Clock.now Unit}") sid "{p.name}: +{d}, now {p.stock + d}")).

# ---- the admin console: the data model, live ---------------------------------------------------

console path m sid s cmd =
  (m2, out) = run path m s (words cmd);
  s2 = sGet m2.sess sid;
  sPut m2 { s2 | con = takeN (("> " + cmd) :: out :: s2.con) 12 }.
run path m s ws = case ws of
    w :: r -> runW path m s w r
  | Nil -> (m, "help: get tax|lowat|revenue|price SKU|stock SKU; set tax N|lowat N|price SKU N; add SKU PRICE STOCK NAME; retire SKU; staff NAME PIN; rebuild").
runW path m s w r | strEq w "help" = run path m s Nil.
runW path m s w r | strEq w "get" = (m, getV m r).
runW path m s w r | strEq w "set" = setV m s r.
runW path m s w r | strEq w "add" = addCmd m r.
runW path m s w r | strEq w "retire" = retireCmd m s r.
runW path m s w r | strEq w "staff" = staffCmd m r.
runW path m s w r | strEq w "rebuild" = rebuild path m.
runW path m s w r = (m, "unknown: {w} (try help)").

addCmd m (sku :: price :: stock :: nameWs) | wordy sku and not (hasP m.cat sku) and List.length nameWs > 0 =
  (commit m "product {sku} {num price} {num stock} {unwords nameWs}", "added {sku}").
addCmd m (sku :: price :: stock :: nameWs) = (m, "add: a new letters-and-digits SKU, a price in cents, a stock, a name").
addCmd m r = (m, "add SKU PRICE STOCK NAME...").
retireCmd m s (sku :: x) | hasP m.cat sku = (commit m "retire {sku} {s.cashier} {Clock.now Unit}", "retired {sku}").
retireCmd m s (sku :: x) = (m, "no such SKU").
retireCmd m s r = (m, "retire SKU").
staffCmd m (name :: pin :: x) | wordy name and wordy pin = (commit m "staff {name} {pin}", "staff {name} set").
staffCmd m (name :: pin :: x) = (m, "staff NAME PIN: letters and digits").
staffCmd m r = (m, "staff NAME PIN").
getV m (k :: x) | strEq k "tax" = "tax {m.tax} basis points ({m.tax / 100}.{pad2 (m.tax % 100)}%)".
getV m (k :: x) | strEq k "lowat" = "lowat {m.lowAt}".
getV m (k :: x) | strEq k "revenue" = "revenue {money m.revenue} over {List.length m.sales} sales".
getV m (k :: sku :: x) | strEq k "price" = "price {sku} {money (priceOf m.cat sku)}".
getV m (k :: sku :: x) | strEq k "stock" = "stock {sku} {stockOf m.cat sku}".
getV m r = "get tax|lowat|revenue|price SKU|stock SKU".
setV m s (k :: n :: x) | strEq k "tax" = (commit m "tax {num n}", "tax {num n}").
setV m s (k :: n :: x) | strEq k "lowat" = (commit m "lowat {num n}", "lowat {num n}").
setV m s (k :: sku :: c :: x) | strEq k "price" and hasP m.cat sku = (commit m "price {sku} {num c} {s.cashier} {Clock.now Unit}", "price {sku} {money (num c)}").
setV m s (k :: sku :: c :: x) | strEq k "price" = (m, "no such SKU").
setV m s r = (m, "set tax N|lowat N|price SKU CENTS").

# every page mirrors its client state, twice a second when it changed
subs m = Live.SyncClientState 500 (ClientState "") ::
  List.append (case m.pricing.journal == "" of True -> Nil | False -> Live.Every 300 PricingPoll :: Nil)
  (case Notice.pending m.reloadNotice of True -> Live.Every 100 NoticeTick :: Nil | False -> Nil).

# ---- what a session sees (Live.serveProjected) --------------------------------------------------
# The register hands each session's writer THIS, not the model: its own
# session, the catalogue and the numbers on the page, and the newest 50
# receipts.  A writer whose projection did not change renders nothing and
# sends nothing, so an event at one register costs the others nothing.
# The field names are the model's, so the view code reads `v.cat`, `v.tax`
# ... exactly as it read the model.

project sid m =
  s0 = sGet m.sess sid;
  onAdmin = s0.tab == 4;
  # of the session, only what is DRAWN: its cart and its tab are the page's own,
  # so a mirror arriving changes nothing here and the writer stays quiet
  { s = { cashier = s0.cashier, toast = s0.toast, role = s0.role, con = s0.con }, cat = m.cat, tax = activeRate m, pricingLabel = m.pricing.value.label Unit, reloadNotice = m.reloadNotice.text, lowAt = m.lowAt, revenue = m.revenue,
    nsales = List.length m.sales, sales = takeN m.sales 50, theme = m.theme, fsOn = m.fsOn,
    events = m.events, booted = m.booted, online = List.length m.sess,
    # the profile changes on every event: a session not looking at it must not re-render for it
    prof = (case onAdmin of True -> m.prof | False -> noProf),
    mem = (case onAdmin of True -> Sys.memInfo 0 | False -> Nil),
    grows = (case onAdmin of True -> Sys.memStats 0 | False -> (0, 0)),
    harts = Sys.harts Unit }.

# ---- view: per session ------------------------------------------------------------------------
# All four tabs are in the page and the PAGE shows one (client state), so a
# tab switch is instant and sends nothing.  Product cards and receipt rows are
# remembered per writer (std/viewcache): a card is a function of its product
# and the low-water mark, a row of its receipt, so they render once each and
# again only when that changes.

pageRoot v kids = element "div" (G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 18), G.Padding (G.Px 18), G.Height (G.Vh 100), G.Height (G.Dvh 100), G.Width (G.Vw 100), G.MaxWidth (G.Vw 100), G.Overflow G.OverflowHidden]] :: Cls "col gap-4 p-4 screen" :: Att "data-theme" (if v.theme == 1 then "night" else "day") ::
  List.append (Appearance.frame (v.theme != 1)) locals) kids.
locals = G.locals @Client { tab = "1", open = "0", tender = "", delta = "10", rsku = "", cmd = "", name = "", pin = "" }.

Product = { sku : String, name : String, price : Int, stock : Int, retired : Int }.
CardIn = { p : Product, lowAt : Int }.
renderCard : CardIn -> G.Node .
renderCard i = productCard i.lowAt i.p.

# the writer's own statistics: renders timed, cache hits and misses summed
noRender = { st = noStat, hits = 0, misses = 0, cards = 0, rows = 0 }.
view sid v old = case old of (cardsOld, rowsOld, rs) ->
  s = v.s;
  t0 = Sys.timeUs Unit;
  (case strEq s.cashier "" of
    True -> (G.renderStyled (pageRoot v [loginView s, Notice.view v.reloadNotice]), old)
  | False ->
    (case VC.many (fn i -> i.p.sku) renderCard (List.map (fn p -> { p = p, lowAt = v.lowAt }) (live v.cat)) (VC.begin "pos1-card-v1" verify cardsOld) of (cards, cc) ->
    (case VC.many (fn x -> "{x.n}") receiptRow v.sales (VC.begin "pos1-receipt-v1" verify rowsOld) of (rows, rc) ->
      out = G.renderStyled (pageRoot v (Notice.view v.reloadNotice :: nav v s :: toasts s :: body v s cards rows rs));
      (ch, cm, cn) = VC.stats cc;
      (rh, rm, rn) = VC.stats rc;
      rs2 = { st = note rs.st (Sys.timeUs Unit - t0), hits = rs.hits + ch + rh, misses = rs.misses + cm + rm, cards = cn, rows = rn };
      (out, (VC.finish cc, VC.finish rc, rs2))))).
verify = Program.envOr "0" "POS1_VIEW_VERIFY" == "1".

# the same page with nothing remembered: the stylesheet's sample, and the check
# that the cached page is the fresh one
viewFresh v = pageRoot v
  (Notice.view v.reloadNotice :: nav v v.s :: toasts v.s :: body v v.s (List.map renderCard (List.map (fn p -> { p = p, lowAt = v.lowAt }) (live v.cat))) (List.map receiptRow v.sales) noRender).

# The stylesheet is a function of the tree -- and the page is served
# from the signed-out view, so the rules the register needs would never
# be emitted.  The sheet is therefore built over a SAMPLE tree that
# shows everything: a signed-in session with a cart, receipts with a
# void, the console -- every class the app can ever use appears once.
cssAll v = G.cssWith Notice.styles (element "div" Nil (viewFresh (project 1 sampleModel) :: loginView noSess :: Nil)).
# The layout rule: the page is the viewport (`screen`), every region has its
# size from the viewport (flex-auto min-h-0), and what does not fit SCROLLS
# inside its region (overflow-auto).  Nothing is sized by its contents, so
# adding to the cart, opening a receipt's lines or a long product name moves
# nothing else.  On a narrow screen the register stacks: the products above,
# the cart docked below at a fixed share of the height.
# Shared component dimensions compose locally with other attributes.
rowHeight = G.utilities [G.MinHeight (G.Px 46)].
badgeWidth = G.utilities [G.Width (G.Px 56)].
sampleModel =
  m0 = seed |> foldE (fn l mm -> apply mm l) initModel;
  m1 = apply (apply m0 "sale 1 ana 0 0 0 1650 150 FW=3=500") "sale 2 ben 0 1 550 550 50 LB=1=400";
  m2 = apply m1 "void 1 ana 0";
  sPut m2 { noSess | sid = 1, cashier = "ana", cart = ("FW", 2) :: ("BR", 1) :: Nil, toast = "sample", role = "ok", con = "> help" :: Nil }.

loginView s =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 12), G.Padding (G.Px 26), G.BackgroundImages [G.TokenImage G.Panel], G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Radius (G.Px 14), G.MarginLeft (G.Auto), G.MarginRight (G.Auto), G.MarginTop (G.Px 18), G.Width (G.Pct 100)]], Cls "col gap-3 p-6 panel round mx-auto mt-4 w-full", G.utilities [G.MaxWidth (G.Px 420)]]
    [ element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt "point of sale"]
    , element "div" [G.Utilities [G.Base [G.FontSize (G.Px 30), G.FontWeight 700]], Cls "text-2xl bold"] [Txt "Sign in"]
    , input [G.Utilities [G.Base [G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Ink)), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.Radius (G.Px 10), G.FontFamily G.InheritFont, G.FontSize G.Inherit, G.OutlineWidth (G.Px 0), G.Width (G.Pct 100)]], Cls "field w-full", G.bind @Client.name, Att "placeholder" "cashier", Att "maxlength" "16"]
    , input [G.Utilities [G.Base [G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Ink)), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.Radius (G.Px 10), G.FontFamily G.InheritFont, G.FontSize G.Inherit, G.OutlineWidth (G.Px 0), G.Width (G.Pct 100)]], Cls "field w-full", G.bind @Client.pin, G.OnEnter (G.wireOpen codec (Login "")) "name,pin", Att "placeholder" "PIN", Att "type" "password", Att "maxlength" "16"]
    , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 14), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8), G.Shadow (G.Px 0) (G.Px 0) (G.Px 24) (G.Px 0) (G.RgbaPercent 87 226 210 22)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn round px-3 py-2 glow", G.OnClick (G.wireOpen codec (Login "")) "name,pin"] [Txt "open register"]
    , element "div" [G.Utilities [G.Base [G.Foreground (G.Rgb 255 138 92), G.FontSize (G.Px 13)]], Cls "warm text-sm"] [Dyn s.toast] ].

nav m s =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.SpaceBetween, G.AlignItems G.AlignCenter, G.Gap (G.Px 8), G.FlexWrap G.Wrap, G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto)]], Cls "row between center gap-2 wrap flex-none"]
    [ element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8), G.AlignItems G.AlignCenter, G.FlexWrap G.Wrap]], Cls "row gap-2 center wrap"]
        [ element "div" [G.Utilities [G.Base [G.FontWeight 700]], Cls "bold"] [Txt "POS"], element "div" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 11)]], Cls "dim text-xs"] [Txt "v1"]
        , tab "1" "Register", tab "2" "Receipts", tab "3" "Inventory", tab "4" "Admin" ]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8), G.AlignItems G.AlignCenter, G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 13), G.FlexWrap G.Wrap]], Cls "row gap-2 center dim text-sm wrap"]
        [ element "span" [Cls (case m.fsOn == 1 of True -> "badge ok" | False -> "badge warn")] [Txt (case m.fsOn == 1 of True -> "disk" | False -> "no disk")]
        , element "span" [Att "id" "lv-link", G.Utilities [G.Base [G.Display G.InlineBlock, G.PaddingY (G.Px 2), G.PaddingX (G.Px 9), G.Radius (G.Px 999), G.FontSize (G.Px 11), G.FontWeight 700, G.LetterSpacing (G.Em 60), G.TextCase G.UpperCase, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Dim))]], Cls "badge"] [Txt "live"]
        , element "span" [Att "id" "pricing-policy", G.Utilities [G.Base [G.Display G.InlineBlock, G.PaddingY (G.Px 2), G.PaddingX (G.Px 9), G.Radius (G.Px 999), G.FontSize (G.Px 11), G.FontWeight 700, G.LetterSpacing (G.Em 60), G.TextCase G.UpperCase, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Dim))]], Cls "badge"] [Dyn m.pricingLabel]
        , Txt "cashier ", element "b" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Ink))]], Cls "ink"] [Dyn s.cashier]
        , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.send codec Theme] [Txt (case m.theme == 1 of True -> "day" | False -> "night")]
        , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.send codec Logout] [Txt "sign out"] ] ].
tab n label = element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.setTo @Client.tab n, G.localStyle "tab" "{n}" [G.Background (G.ThemeColour G.Ink), G.Foreground (G.ThemeColour G.Bg), G.BorderColour (G.ThemeColour G.Ink)], Att "data-on" "tab:{n}"] [Txt label].

# four toast slots, one role each; only the live one has text (a role
# change is then a delta, not a reshape); an empty toast is not shown
toasts s =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8)]], Cls "row gap-2"]
    [ element "div" [G.Att "data-hide-empty" "", G.Utilities [G.Base [G.PaddingY (G.Px 10), G.PaddingX (G.Px 14), G.Radius (G.Px 12), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.BackgroundImages [G.TokenImage G.Panel], G.MinHeight (G.Px 0), G.Background (G.Rgb 15 51 40), G.BorderColour (G.Rgb 31 107 80), G.Foreground (G.Rgb 87 226 166)]], Cls "toast min-h-0 ok"] [Dyn (roleText s "ok")]
    , element "div" [G.Att "data-hide-empty" "", G.Utilities [G.Base [G.PaddingY (G.Px 10), G.PaddingX (G.Px 14), G.Radius (G.Px 12), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.BackgroundImages [G.TokenImage G.Panel], G.MinHeight (G.Px 0), G.Background (G.Rgb 42 26 58), G.BorderColour (G.Rgb 107 63 154), G.Foreground (G.Rgb 217 166 255)]], Cls "toast min-h-0 celebrate"] [Dyn (roleText s "celebrate")]
    , element "div" [G.Att "data-hide-empty" "", G.Utilities [G.Base [G.PaddingY (G.Px 10), G.PaddingX (G.Px 14), G.Radius (G.Px 12), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.BackgroundImages [G.TokenImage G.Panel], G.MinHeight (G.Px 0), G.Background (G.Rgb 58 42 16), G.BorderColour (G.Rgb 122 90 24), G.Foreground (G.Rgb 255 198 92)]], Cls "toast min-h-0 warn"] [Dyn (roleText s "warn")]
    , element "div" [G.Att "data-hide-empty" "", G.Utilities [G.Base [G.PaddingY (G.Px 10), G.PaddingX (G.Px 14), G.Radius (G.Px 12), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.BackgroundImages [G.TokenImage G.Panel], G.MinHeight (G.Px 0), G.Background (G.Rgb 58 18 32), G.BorderColour (G.Rgb 122 34 56), G.Foreground (G.Rgb 255 125 149)]], Cls "toast min-h-0 bad"] [Dyn (roleText s "bad")] ].
roleText s role | strEq s.role role = s.toast.
roleText s role = "".

body v s cards rows rs =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)]], Cls "col flex-auto min-h-0", G.showIf @Client.tab "1"] [register v cards] ::
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)]], Cls "col flex-auto min-h-0", G.showIf @Client.tab "2"] [receipts v rows] ::
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)]], Cls "col flex-auto min-h-0", G.showIf @Client.tab "3"] [inventory v] ::
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)]], Cls "col flex-auto min-h-0", G.showIf @Client.tab "4"] [admin v s rs] :: Nil.

# ---- register ------------------------------------------------------------------------------------

# The register is the PAGE's: adding a flat white changes a quantity the page
# holds (one local per product, q_<sku>), inside [0, stock] as the button says.
# The cart panel has a line per product, shown while its quantity is not 0; the
# line totals, the subtotal, the tax and the total are computed in the page
# from those quantities (cartScript below).  None of it depends on a session,
# so nothing here is rendered again until the catalogue or the tax changes.
register v cards =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 18), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)], G.Narrow [G.Display G.Flex, G.Direction G.Column]], Cls "row gap-4 flex-auto min-h-0 narrow:col"]
    [ element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.FlexWrap G.Wrap, G.Gap (G.Px 8), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0), G.AlignContent G.AlignStart, G.Overflow G.OverflowAuto, G.MinHeight (G.Px 0)], G.Narrow [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto)]], Cls "row wrap gap-2 grow content-start overflow-auto min-h-0 narrow:flex-auto"] cards
    , cartPanel v ].
qLocal p = "q_{p.sku}".
productCard lowAt p =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 8), G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Radius (G.Px 14), G.Padding (G.Px 12), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto), G.JustifyContent G.SpaceBetween]], Cls "col gap-2 card round p-3 flex-none between",
    G.utilities [G.Width (G.Px 180), G.Height (G.Px 140)],
    G.narrow [G.Width (G.Less (G.Pct 50) (G.Px 4))]]
    [ element "div" [G.Utilities [G.Base [G.FontWeight 700]], Cls "bold"] [Txt p.name]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.SpaceBetween, G.AlignItems G.AlignCenter]], Cls "row between center"]
        [ element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals]], Cls "tabular"] [Txt "$", Dyn (money p.price)]
        , stockBadge lowAt p ]
    , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.OnSet (qLocal p) "+1", Att "data-min" "0", Att "data-max" "{imin 999 p.stock}"] [Txt "add"] ].
# the badge takes a role: sold out is danger, at or under the threshold warning
stockBadge lowAt p =
  element "span" [G.Utilities [G.Base [G.Display G.InlineBlock, G.PaddingY (G.Px 2), G.PaddingX (G.Px 9), G.Radius (G.Px 999), G.FontSize (G.Px 11), G.FontWeight 700, G.LetterSpacing (G.Em 60), G.TextCase G.UpperCase, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Dim))]], Cls "badge", Att "data-role" "stock"] [Dyn (stockText lowAt p)].
stockText lowAt p | p.stock == 0 = "sold out".
stockText lowAt p | p.stock <= lowAt = "low: {p.stock}".
stockText lowAt p = "{p.stock} in stock".

cartPanel m =
  ps = live m.cat;
  element "div" (G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 8), G.BackgroundImages [G.TokenImage G.Panel], G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Radius (G.Px 14), G.Padding (G.Px 18), G.Width (G.Px 400), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto), G.MinHeight (G.Px 0)], G.Narrow [G.Width (G.Pct 100)]] :: Cls "col gap-2 panel round p-4 w-cart min-h-0 narrow:w-full" :: G.narrow [G.Basis (G.Vh 46)] :: Att "data-tax" "{m.tax}" :: (ps |> List.map (fn p -> G.Local (qLocal p) "0")))
    [ element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt "cart"]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 4), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0), G.Overflow G.OverflowAuto]], Cls "col gap-1 flex-auto min-h-0 overflow-auto"] (element "div" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 13)]], Cls "dim text-sm", Att "id" "cart-empty"] [Txt "nothing yet"] :: (ps |> List.map (fn p -> cartLine p)))
    , element "div" [G.Utilities [G.Base [G.BorderTop (G.Px 1) (G.ThemeColour (G.Line))]], Cls "rule"] []
    , totalRow "subtotal" "cart-sub"
    , totalRow "tax {m.tax / 100}.{pad2 (m.tax % 100)}%" "cart-tax"
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.SpaceBetween, G.AlignItems G.AlignCenter]], Cls "row between center"]
        [ element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt "total"]
        , element "div" [G.Utilities [G.Base [G.FontSize (G.Px 30), G.FontWeight 700, G.Numerals G.TabularNumerals]], Cls "text-2xl bold tabular", Att "id" "cart-total"] [Txt "$0.00"] ]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8), G.AlignItems G.AlignCenter]], Cls "row gap-2 center"]
        [ input [G.Utilities [G.Base [G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Ink)), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.Radius (G.Px 10), G.FontFamily G.InheritFont, G.FontSize G.Inherit, G.OutlineWidth (G.Px 0), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0)]], Cls "field grow", G.bind @Client.tender, G.enterWith codec (Cash "") @Client.tender, Att "placeholder" "cash tendered"]
        , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 14), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8), G.Shadow (G.Px 0) (G.Px 0) (G.Px 24) (G.Px 0) (G.RgbaPercent 87 226 210 22)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn round px-3 py-2 glow", G.sendWith codec (Cash "") @Client.tender] [Txt "cash"]
        , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 14), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn round px-3 py-2", G.send codec Card] [Txt "card"] ] ].
totalRow label slot =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.SpaceBetween, G.AlignItems G.AlignCenter, G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 13)]], Cls "row between center dim text-sm"] [ Txt label, element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals]], Cls "tabular", Att "id" slot] [Txt "$0.00"] ].
cartLine p =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.SpaceBetween, G.AlignItems G.AlignCenter, G.Gap (G.Px 8), G.BorderBottom (G.Px 1) (G.ThemeColour (G.Line)), G.PaddingY (G.Px 6), G.PaddingX (G.Px 0), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto)]], Cls "row between center gap-2 tr flex-none", rowHeight, G.ShowIf (qLocal p), Att "data-line" p.sku, Att "data-price" "{p.price}"]
    [ element "div" [G.Utilities [G.Base [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0), G.WhiteSpace G.NoWrapSpace, G.Overflow G.OverflowHidden, G.TextOverflow G.Ellipsis, G.MinWidth (G.Px 0)]], Cls "grow truncate min-w-0"] [Txt p.name]
    , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.OnSet (qLocal p) "-1", Att "data-min" "0"] [Txt "-"]
    , element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals, G.Width (G.Px 40), G.TextAlign G.TextEnd]], Cls "tabular w-40 right"] [G.LTxt (qLocal p)]
    , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.OnSet (qLocal p) "+1", Att "data-min" "0", Att "data-max" "{imin 999 p.stock}"] [Txt "+"]
    , element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals, G.Width (G.Px 96), G.TextAlign G.TextEnd]], Cls "tabular w-24 right", Att "data-line-total" p.sku] [Txt "$0.00"]
    , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.OnSet (qLocal p) "0"] [Txt "x"] ].

# ---- receipts ---------------------------------------------------------------------------------------

receipts v rows =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 12), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)]], Cls "col gap-3 flex-auto min-h-0"]
    [ element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 18), G.AlignItems G.AlignCenter]], Cls "row gap-4 center"]
        [ element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column]], Cls "col"] [ element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt "receipts"], element "div" [G.Utilities [G.Base [G.FontSize (G.Px 30), G.FontWeight 700, G.Numerals G.TabularNumerals]], Cls "text-2xl bold tabular"] [Dyn "{v.nsales}"] ]
        , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column]], Cls "col"] [ element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt "revenue"], element "div" [G.Utilities [G.Base [G.FontSize (G.Px 30), G.FontWeight 700, G.Numerals G.TabularNumerals]], Cls "text-2xl bold tabular"] [Txt "$", Dyn (money v.revenue)] ]
        , element "div" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 13)]], Cls "dim text-sm"] [Txt "newest 50 shown"] ]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0), G.Overflow G.OverflowAuto]], Cls "col flex-auto min-h-0 overflow-auto"] rows ].
receiptRow x =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.BorderBottom (G.Px 1) (G.ThemeColour (G.Line)), G.PaddingY (G.Px 6), G.PaddingX (G.Px 0), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto)]], Cls "col tr flex-none", rowHeight]
    [ element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 12), G.AlignItems G.AlignCenter]], Cls "row gap-3 center"]
        [ element "div" [G.Utilities [G.Base [G.FontWeight 700, G.Numerals G.TabularNumerals, G.Width (G.Px 96)]], Cls "bold tabular w-24"] [Txt "#{x.n}"]
        , element "div" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 13), G.Width (G.Px 96)]], Cls "dim text-sm w-24"] [Txt x.cashier]
        , element "div" [G.Utilities [G.Base [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0), G.FontSize (G.Px 13), G.WhiteSpace G.NoWrapSpace, G.Overflow G.OverflowHidden, G.TextOverflow G.Ellipsis, G.MinWidth (G.Px 0)]], Cls "grow text-sm truncate min-w-0"] [Txt (summary x.lines)]
        , element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals, G.Width (G.Px 96), G.TextAlign G.TextEnd]], Cls "tabular w-24 right"] [Txt "$", Txt (money x.total)]
        , element "div" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 11)]], Cls "dim text-xs"] [Txt (fmtTime x.at)]
        , element "span" [G.Utilities [G.Base [G.Display G.InlineBlock, G.PaddingY (G.Px 2), G.PaddingX (G.Px 9), G.Radius (G.Px 999), G.FontSize (G.Px 11), G.FontWeight 700, G.LetterSpacing (G.Em 60), G.TextCase G.UpperCase, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Dim)), G.TextAlign G.TextCenter, G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto)]], Cls "badge text-center flex-none", badgeWidth] [Txt (case x.pay == 0 of True -> "cash" | False -> "card")]
        , element "span" [Cls (case x.voided == 1 of True -> "badge bad text-center flex-none" | False -> "badge ok text-center flex-none"), badgeWidth] [Txt (case x.voided == 1 of True -> "void" | False -> "paid")]
        , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.setTo @Client.open "{x.n}", G.localStyle "open" "{x.n}" [G.Background (G.ThemeColour G.Ink), G.Foreground (G.ThemeColour G.Bg), G.BorderColour (G.ThemeColour G.Ink)], Att "data-on" "open:{x.n}"] [Txt "lines"]
        , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.JustifyEnd, G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto)]], Cls "row justify-end flex-none", G.utilities [G.Width (G.Px 72)]] [voidButton x] ]
    , element "div" [G.showIf @Client.open "{x.n}", G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.FontSize (G.Px 13), G.Foreground (G.ThemeColour (G.Dim)), G.Padding (G.Px 8), G.Overflow G.OverflowAuto, G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto)]], Cls "col text-sm dim p-2 overflow-auto flex-none", G.utilities [G.MaxHeight (G.Px 180)]] (x.lines |> List.map (fn l -> lineRow l) |> withVoid x) ].
voidButton x | x.voided == 1 = element "div" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 11), G.WhiteSpace G.NoWrapSpace, G.Overflow G.OverflowHidden, G.TextOverflow G.Ellipsis, G.MinWidth (G.Px 0)]], Cls "dim text-xs truncate min-w-0"] [Txt "by {x.voidBy}"].
voidButton x = element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.send codec (Void x.n)] [Txt "void"].
lineRow (sku, q, pr, nm) = element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.SpaceBetween]], Cls "row between"] [ Txt "{q} x {nm}", element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals]], Cls "tabular"] [Txt (money (q * pr))] ].
withVoid x rows | x.voided == 1 = rows + (element "div" [G.Utilities [G.Base [G.Foreground (G.Rgb 255 138 92)]], Cls "warm"] [Txt "void by {x.voidBy} at {fmtTime x.voidAt}"] :: Nil).
withVoid x rows = rows + (element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.JustifyContent G.SpaceBetween]], Cls "row between"] [ Txt "tax", element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals]], Cls "tabular"] [Txt (money x.tax)] ] :: Nil).
summary ls = S.join ", " (ls |> List.map (fn l -> lineWord l)).
lineWord (sku, q, pr, nm) = "{q}x {nm}".

# ---- inventory --------------------------------------------------------------------------------------

inventory m =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 12), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)]], Cls "col gap-3 flex-auto min-h-0"]
    [ element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8), G.AlignItems G.AlignCenter]], Cls "row gap-2 center"]
        [ element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt "restock by"]
        , input [G.Utilities [G.Base [G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Ink)), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.Radius (G.Px 10), G.FontFamily G.InheritFont, G.FontSize G.Inherit, G.OutlineWidth (G.Px 0), G.Width (G.Px 96)]], Cls "field w-24", G.bind @Client.delta, Att "placeholder" "10"] ]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0), G.Overflow G.OverflowAuto]], Cls "col flex-auto min-h-0 overflow-auto"] (live m.cat |> List.map (fn p -> invRow m p)) ].
invRow m p =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 12), G.AlignItems G.AlignCenter, G.BorderBottom (G.Px 1) (G.ThemeColour (G.Line)), G.PaddingY (G.Px 6), G.PaddingX (G.Px 0), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto)]], Cls "row gap-3 center tr flex-none", rowHeight]
    [ element "div" [G.Utilities [G.Base [G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0)]], Cls "grow"] [Txt p.name]
    , element "div" [G.Utilities [G.Base [G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 11), G.FontFamily G.MonoFont, G.Width (G.Px 96)]], Cls "dim text-xs mono w-24"] [Txt p.sku]
    , element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals, G.Width (G.Px 96), G.TextAlign G.TextEnd]], Cls "tabular w-24 right"] [Txt "$", Dyn (money p.price)]
    , element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals, G.Width (G.Px 96), G.TextAlign G.TextEnd]], Cls "tabular w-24 right"] [Dyn "{p.stock}"]
    , stockBadge m.lowAt p
    , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 999), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn pill px-3 py-2", G.OnBoth (G.wireOpen codec (Restock "")) "rsku,delta" "rsku" p.sku] [Txt "restock"] ].

# ---- admin: the data console ---------------------------------------------------------------------------

admin m s rs =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Gap (G.Px 12), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0)]], Cls "col gap-3 flex-auto min-h-0"]
    [ element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8), G.FlexWrap G.Wrap]], Cls "row gap-2 wrap"]
        [ watch "tax" "{m.tax / 100}.{pad2 (m.tax % 100)}%", watch "low at" "{m.lowAt}", watch "products" "{pCount m.cat}"
        , watch "sales" "{m.nsales}", watch "revenue" (money m.revenue), watch "log lines" "{m.events}"
        , watch "since" (fmtTime m.booted), watch "online" "{m.online}" ]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8), G.AlignItems G.AlignCenter]], Cls "row gap-2 center"]
        [ input [G.Utilities [G.Base [G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Foreground (G.ThemeColour (G.Ink)), G.PaddingY (G.Px 8), G.PaddingX (G.Px 12), G.Radius (G.Px 10), G.FontFamily G.InheritFont, G.FontSize G.Inherit, G.OutlineWidth (G.Px 0), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Pct 0), G.FontFamily G.MonoFont]], Cls "field grow mono", G.bind @Client.cmd, G.enterWith codec (Admin "") @Client.cmd, Att "placeholder" "get tax | set price FW 550 | add SKU 450 10 name | rebuild | help"]
        , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 14), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn round px-3 py-2", G.sendWith codec (Admin "") @Client.cmd] [Txt "run"]
        , element "button" [G.Utilities [G.Base [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Background (G.ThemeColour (G.Card)), G.Foreground (G.ThemeColour (G.Dim)), G.TransitionAll 150, G.Radius (G.Px 14), G.PaddingLeft (G.Px 12), G.PaddingRight (G.Px 12), G.PaddingTop (G.Px 8), G.PaddingBottom (G.Px 8)]], G.hover [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)], Cls "btn round px-3 py-2", G.send codec Rebuild] [Txt "rebuild stock"] ]
    , element "div" [G.Utilities [G.Base [G.FontFamily G.MonoFont, G.FontSize (G.Px 13), G.WhiteSpace G.PreWrapSpace, G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Radius (G.Px 14), G.Padding (G.Px 12), G.FlexGrow 1, G.FlexShrink 1, G.Basis (G.Auto), G.MinHeight (G.Px 0), G.Overflow G.OverflowAuto]], Cls "mono text-sm pre show-empty card round p-3 flex-auto min-h-0 overflow-auto"] [Dyn (S.join "\n" (rev s.con Nil))]
    , element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt "profile"]
    , element "div" [G.Att "data-hide-empty" "", G.Utilities [G.Base [G.FontFamily G.MonoFont, G.FontSize (G.Px 11), G.WhiteSpace G.PreWrapSpace, G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Radius (G.Px 14), G.Padding (G.Px 12), G.FlexGrow 0, G.FlexShrink 0, G.Basis (G.Auto), G.Overflow G.OverflowAuto]], Cls "mono text-xs pre card round p-3 flex-none overflow-auto", G.utilities [G.MaxHeight (G.Vh 38)]] [Dyn (profileText m rs)]
    , element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Row, G.Gap (G.Px 8), G.AlignItems G.AlignCenter, G.Foreground (G.ThemeColour (G.Dim)), G.FontSize (G.Px 11)]], Cls "row gap-2 center dim text-xs"] [ Txt "browser round trip: ", element "span" [Att "id" "pos-rtt"] [Txt "measuring"] ] ].

profileText v rs =
  S.join "\n"
    ( "update, per kind of event ({v.prof.nev} events since boot)"
      :: List.map (fn e -> (case e of (k, st) -> "  {statLine k st}")) v.prof.upd
      + ( "disk"
       :: "  {statLine "append" v.prof.flush}"
       :: "  boot: {v.prof.bootLines} lines folded in {v.prof.bootUs} us"
       :: "this session's writer"
       :: "  {statLine "render" rs.st}"
       :: "  view cache: {rs.hits} hits, {rs.misses} misses; {rs.cards} cards and {rs.rows} receipt rows remembered"
       :: "runtime"
       :: memLines v.mem v.grows
       + ("  harts {v.harts}, sessions online {v.online}" :: Nil))).
memLines mem (grows, mib) = case mem of
    arena :: free :: reqs :: waits :: direct :: frees :: denied :: inl :: x ->
      "  arena {arena / 1024} MiB reserved, {(arena - free) / 1024} MiB in use, grown {grows} times ({mib} MiB)"
      :: "  memory actor: {reqs} requests, {waits} waits, {direct} direct, {inl} inline, {frees} frees, {denied} denied" :: Nil
  | x -> "  memory: not sampled" :: Nil.
watch label v =
  element "div" [G.Utilities [G.Base [G.Display G.Flex, G.Direction G.Column, G.Background (G.ThemeColour (G.Card)), G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour (G.Line)), G.Radius (G.Px 14), G.Padding (G.Px 8)]], Cls "col card round p-2", G.utilities [G.MinWidth (G.Px 120)]]
    [ element "div" [G.Utilities [G.Base [G.FontSize (G.Px 11), G.TextCase G.UpperCase, G.LetterSpacing (G.Em 180), G.Foreground (G.ThemeColour (G.Dim))]], Cls "text-xs upper dim"] [Txt label], element "div" [G.Utilities [G.Base [G.Numerals G.TabularNumerals, G.FontWeight 700]], Cls "tabular bold"] [Dyn v] ].

# the page's script: the client, plus the round trip it sees -- from a send to
# the next frame that arrives -- written into the Admin tab's slot when there is one
script = strcat rttScript (strcat cartScript (LJ.src 0)).
# the cart's arithmetic, in the page: after every paint of the locals, each
# line's total and the cart's, from the quantities the page holds and the
# prices and the tax the server drew. The program below is data: numeric/text
# expressions and scoped DOM effects, with no embedded JavaScript. Money.amount
# and Money.taxExpr are also the definitions used by native checkout above.
dollars n = C.Concat [C.Text "$", Money.amount n].
cartScript = B.onLocals
  [B.Each (B.Attribute "data-tax")
    [B.ReadAttribute "rate" "data-tax", B.SetNumber "sub" (C.Literal 0), B.SetNumber "count" (C.Literal 0),
     B.Each (B.Attribute "data-line")
       [B.ReadTextAttribute "sku" "data-line", B.ReadAttribute "price" "data-price",
        B.ReadLocal "qty" (C.Concat [C.Text "q_", C.StringVar "sku"]),
        B.SetNumber "line" (C.Mul (C.Number "qty") (C.Number "price")),
        B.PutText (B.Attribute "data-line-total") (dollars (C.Number "line")),
        B.SetNumber "sub" (C.Add (C.Number "sub") (C.Number "line")),
        B.SetNumber "count" (C.Add (C.Number "count")
          (C.IfInt (C.Less (C.Literal 0) (C.Number "qty")) (C.Literal 1) (C.Literal 0)))],
     B.SetNumber "tax" (Money.taxExpr (C.Number "sub") (C.Number "rate")),
     B.PutText (B.Id "cart-sub") (dollars (C.Number "sub")),
     B.PutText (B.Id "cart-tax") (dollars (C.Number "tax")),
     B.PutText (B.Id "cart-total") (dollars (C.Add (C.Number "sub") (C.Number "tax"))),
     B.Show (B.Id "cart-empty") (C.Equal (C.Number "count") (C.Literal 0))]].
# installed BEFORE the client, which opens its socket as soon as it runs
rttScript = Metrics.script (B.Id "pos-rtt") " (a tab the browser pauses or throttles inflates this; the server side is above)".

# ---- dynamic pricing: only the register's internal subscription can adopt ----
# Runtime session/function values never enter disk receipts or browser projections.
# Every adopted policy is checked at the same single-writer boundary as checkout.
staticPricing = {journal = "", name = "pos1_pricing", cursor = 0, table = 0, hash = "",
                 value = {rate = Pricing.rate, label = Pricing.label}}.
pricingBindings : Int -> Result {rate : Int -> Int, label : Unit -> String} String .
pricingBindings table = case Reload.function table "rate" of
    Err why -> Err why
  | Ok rate -> case Reload.function table "label" of
      Err why -> Err why
    | Ok label -> Ok {rate = rate, label = label}.
pricingSpec = {name = "pos1_pricing", bind = pricingBindings}.
bootPricing store metrics reloadNotice =
  booted = {boot store | reloadNotice = Notice.init reloadNotice 3000, metrics = metrics};
  _ = writeStock booted;
  model = booted;
  case Program.env "FPR_RELOAD_JOURNAL" of
    Option.None -> model
  | Option.Some journal -> case Reload.open pricingSpec of
      Err why -> error "pos1: pricing startup refused: {why}"
    | Ok pricing -> {model | pricing = pricing}.
activeRate model = model.pricing.value.rate model.tax.
pollPricing model = case Watch.poll model.pricing.journal model.pricing.name model.pricing.cursor of
    Err why -> model
  | Ok pair ->
      (cursor, candidates) = pair;
      current = {model.pricing | cursor = cursor};
      case List.reverse candidates of
        Nil -> {model | pricing = current}
      | candidate :: rest -> pricingAdopted model current
          (Reload.reload pricingSpec 0 (Watch.identity candidate) current).
pricingAdopted model current result = case result of
    Err why -> _ = Sys.stderr "[pos1] pricing refused: {why}\n"; {model | pricing = current}
  | Ok pricing ->
      _ = print "[pos1] pricing adopted: {pricing.value.label Unit}#{pricing.hash}";
      notice = case pricing.hash == current.hash of
        True -> model.reloadNotice
      | False -> Notice.adopted pricing.name pricing.hash model.reloadNotice;
      {model | pricing = pricing, reloadNotice = notice}.

# ---- main ---------------------------------------------------------------------------------------------

Settings = Type (Settings port address store metrics reloadNotice).
settings = Decode.map5 Settings (Decode.field "port" Decode.int) (Decode.field "address" Decode.string) (Decode.field "store" Decode.string) (Decode.field "metrics" Decode.string) (Decode.field "reload-notice" Decode.bool).

main = case Config.load { defaults = Json.object (("port", Json.Integer 6710) :: ("address", Json.Text "127.0.0.1") :: ("store", Json.Text "pos1.log") :: ("metrics", Json.Text "") :: ("reload-notice", Json.Boolean False) :: Nil),
                          file = Option.None, envPrefix = "POS1_", args = Program.args Unit } |> Result.andThen (Decode.run settings) of
    Err why -> Program.fail 2 "pos1: {why}"
  | Ok (Settings port address store metrics reloadNotice) ->
      # the shop is the log, folded at boot; std/live's own store holds nothing
      # of the model (fields = Nil, no journal), it is there because the driver
      # wants one
      cfg = { address = address, port = port, title = "POS v1", store = "{store}.kvlog", journal = False,
              script = script, watch = Nil, rebuild = Nil, restart = Nil };
      _ = Live.serveProjectedBody [G.utilities [G.Margin (G.Px 0), G.Overflow G.OverflowHidden]] cfg { init = bootPricing store metrics reloadNotice, update = update store, subs = subs, fields = Nil, codec = codec,
                                    project = project, same = (fn a b -> a == b),
                                    view = view, cache = (VC.empty Unit, VC.empty Unit, noRender), css = cssAll };
      0.

# Read-only printer dashboard. std/live owns the model and per-tab controls;
# the LAN bridge atomically replaces a small, public telemetry snapshot.
# Run tools/printer_dashboard.py --demo, or see examples/printer-dashboard/README.md.
unsafe base.
Live = use "std/live".
G = use "std/view".
LJ = use "std/livejs".
Media = use "std/browsermedia".
List = use "std/list".
S = use "std/string".
File = use "std/file".
Clock = use "std/clock".
Config = use "std/config".
Decode = use "std/decode".
Json = use "std/json".
Option = use "std/option".
Program = use "std/program".
UI = use "examples/printer-dashboard/presentation".
El = UI.element.
Txt = G.Txt.
Dyn = G.Dyn.
Att = G.Att.
Msg = Type (Tick | Expand String | Camera String).
codec = @Msg.
Sess = {sid : Int, expanded : List String, cameras : List String}.
# Public allowlist only. The gateway verifies signatures and gates HTTP/WS/camera;
# private keys, challenges and bearer sessions never enter the live model.
Model = {printers : List Json.Value, auth : List Json.Value, generated : Int, now : Int,
         tickUs : Int, lastTick : Int, ticks : Int, sessions : List Sess, demo : Bool, issue : String}.
noSess = { sid = 0, expanded = Nil, cameras = Nil }.
getSess sid m = Option.withDefault { noSess | sid = sid } (List.find (fn s -> s.sid == sid) m.sessions).
putSess m s = { m | sessions = s :: List.filter (fn old -> old.sid != s.sid) m.sessions }.
toggle k xs = if List.member k xs then List.filter (fn x -> x != k) xs else k :: xs.
text k v = Option.withDefault "" (Option.andThen Json.asString (Json.field k v)).
integer k v = Option.withDefault 0 (Option.andThen Json.asInt (Json.field k v)).
boolean k v = Option.withDefault False (Option.andThen Json.asBool (Json.field k v)).
number k v = Option.withDefault "—" (Option.andThen Json.asReal (Json.field k v)).
values k v = Option.withDefault Nil (Option.andThen Json.asList (Json.field k v)).
validPrinter p = strlen (text "id" p) > 0 and strlen (text "name" p) > 0.
validSnapshot v = case Option.andThen Json.asList (Json.field "printers" v) of
    Option.None -> False
  | Option.Some ps -> List.length ps <= 24 and List.all validPrinter ps and List.length (List.unique (List.map (text "id") ps)) == List.length ps and integer "generated_at" v > 0.
load path m = case File.readText path of
    Err _ -> { m | issue = "Waiting for the local printer bridge. Last known values may be out of date." }
  | Ok raw -> (if strlen raw > 262144 then { m | issue = "Printer snapshot is too large; keeping the previous values." }
      else case Json.parse raw of
        Err _ -> { m | issue = "Could not read the printer snapshot; keeping the previous values." }
      | Ok v -> (if integer "schema" v != 1 or not (validSnapshot v) then { m | issue = "Unsupported printer snapshot; keeping the previous values." }
          else { m | printers = values "printers" v, auth = values "auth" v, generated = integer "generated_at" v, demo = boolean "demo" v, issue = "" })).
initial : String -> Model.
seed u = { printers = Nil, auth = Nil, generated = 0, now = Clock.now Unit, tickUs = 0, lastTick = Clock.monotonic Unit,
                          ticks = 0, sessions = Nil, demo = False, issue = "" }.
initial path = load path (seed Unit).
update path ev m = updateWith (load path) ev m.
updateWith refresh ev m = case ev of
    Live.Msg 0 Tick ->
      t = Clock.monotonic Unit;
      next = refresh m;
      ({ next | now = Clock.now Unit, tickUs = t - m.lastTick, lastTick = t, ticks = m.ticks + 1 }, Nil)
  | Live.Msg sid (Expand id) ->
      s = getSess sid m;
      (if List.any (fn p -> text "id" p == id) m.printers then (putSess m { s | expanded = toggle id s.expanded }, Nil) else (m, Nil))
  | Live.Msg sid (Camera id) ->
      s = getSess sid m;
      allowed = List.any (fn p -> text "id" p == id and boolean "camera_available" p) m.printers;
      (if allowed then (putSess m { s | cameras = toggle id s.cameras, expanded = (if List.member id s.expanded then s.expanded else id :: s.expanded) }, Nil) else (m, Nil))
  | Live.Left sid -> ({ m | sessions = List.filter (fn s -> s.sid != sid) m.sessions }, Nil)
  | _ -> (m, Nil).
subs ms m = [Live.Every ms Tick].
project sid m = { printers = m.printers, now = m.now, generated = m.generated, tickUs = m.tickUs, ticks = m.ticks,
                   demo = m.demo, issue = m.issue, session = getSess sid m }.
age now at = if at <= 0 then "No report yet" else "{(if now > at then now - at else 0)}s ago".
stale v = v.generated == 0 or v.now - v.generated > 5 or strlen v.issue > 0.
link p v = if stale v then "STALE" else text "connection" p.
pill attrs s = El "span" attrs [Txt s].
metric title value suffix = El "div" Nil [El "dt" UI.term [Txt title], El "dd" UI.value [Dyn value, El "small" UI.unit [Txt suffix]]].
row title value = El "div" Nil [El "dt" UI.rowTerm [Txt title], El "dd" UI.rowValue [Dyn value]].
button label msg attrs = El "button" (G.send codec msg :: Att "type" "button" :: List.append UI.button attrs) [Txt label].
card v p =
  id = text "id" p;
  expanded = List.member id v.session.expanded;
  camera = List.member id v.session.cameras;
  available = boolean "camera_available" p;
  connection = link p v;
  progress = integer "progress" p;
  G.key id (El "article" UI.card
    [ El "div" UI.cardHead
        [ El "div" UI.identity [El "span" (Att "aria-hidden" "true" :: UI.mark) [Txt "▤"], El "div" Nil
            [El "h2" UI.heading [Dyn (text "name" p)], El "p" [UI.muted, UI.text 12] [Dyn (text "model" p), Txt " · ", Dyn (text "location" p)]]]
        , pill ((if connection == "ONLINE" then UI.online else UI.offline) :: UI.badge) connection ]
    , El "div" UI.jobLine [El "strong" UI.jobState [Dyn (text "state" p)], El "span" [UI.muted] [Dyn (text "remaining" p)]]
    , El "p" UI.jobName [Dyn (text "job" p)]
    , El "div" (List.append UI.progress [Att "role" "progressbar", Att "aria-valuemin" "0", Att "aria-valuemax" "100", Att "aria-valuenow" (str progress), Att "aria-label" "Print progress"])
        [El "div" (UI.progressFill progress) Nil]
    , El "div" UI.progressLabel [Dyn "{progress}%", El "span" [UI.muted] [Dyn (text "layers" p)]]
    , El "dl" UI.metrics [metric "Nozzle" (number "nozzle" p) "°C", metric "Bed" (number "bed" p) "°C", metric "Reports" (number "report_hz" p) "Hz"]
    , El "div" UI.freshness [El "span" UI.pulse Nil, Txt "Last report ", Dyn (age v.now (integer "last_report" p)), Txt " · ", Dyn (text "wifi" p)]
    , El "div" UI.actions
        [button (if expanded then "Hide details ↑" else "View details ↓") (Expand id)
            (Att "aria-expanded" (if expanded then "true" else "false") :: Att "aria-controls" "details-{id}" :: UI.quiet)
        , El "button" (List.append UI.button (List.append (UI.camera camera available)
            [G.send codec (Camera id), Att "type" "button", Att "role" "switch", Att "aria-checked" (if camera then "true" else "false"), Att "aria-disabled" (if available then "false" else "true")]))
            [El "span" (Att "aria-hidden" "true" :: UI.cameraDot camera) Nil, Txt (if camera then "Camera on" else "Camera off")]]
    , El "section" (Att "id" "details-{id}" :: UI.hidden (not expanded) :: UI.details)
        [El "dl" UI.detailGrid
          [row "Nozzle target" (number "nozzle_target" p), row "Bed target" (number "bed_target" p), row "Print error" (text "error" p), row "Filament" (text "filament" p), row "Reports received" (number "reports" p), row "Last report (UTC)" (text "last_report_iso" p)]
        , El "p" UI.notice [Dyn (text "note" p)]
        , El "div" [UI.divider, UI.hidden (not camera)]
          [El "div" UI.cameraHeading [Txt "LIVE VIEW", El "span" [UI.muted] [Txt "Native camera cadence"]]
          , El "div" (List.append UI.cameraHost [Att "data-camera-id" id, Att "data-camera-on" (if camera and expanded then "true" else "false"), Att "aria-label" "Camera view from {text "name" p}"]) Nil
          , El "p" (Att "data-camera-status" id :: UI.footnote) [Txt "Camera is off"]
          , El "p" UI.footnote [Txt "Stream: ", Dyn (text "camera_state" p), Txt " · ", Dyn (number "camera_hz" p), Txt " Hz · last frame ", Dyn (age v.now (integer "camera_last_frame" p))]
          , El "p" UI.footnote [Txt "Camera sleeps when this tab is hidden. A printer camera may update slowly; telemetry is the source of truth."]]]]).
palette = {bg = G.Rgb 246 245 240, ink = G.Rgb 38 51 46, dim = G.Rgb 116 128 120,
  card = G.Rgb 255 254 250, panel = G.Rgb 255 254 250, line = G.Rgb 228 231 223}.
frame = [G.theme palette, G.utilities [G.MinHeight (G.Vh 100), G.ColourScheme G.LightScheme,
  G.Background (G.ThemeColour G.Bg), G.Foreground (G.ThemeColour G.Ink),
  G.DefineColour (G.NamedToken "paper") palette.card, G.DefineColour (G.NamedToken "muted") palette.dim,
  G.DefineColour (G.NamedToken "green") (G.Rgb 38 108 81), G.DefineColour (G.NamedToken "orange") (G.Rgb 189 113 58)]].
view ms sid v = G.renderStyled (El "div" frame [El "main" UI.page
  [ El "header" UI.header
      [El "div" Nil [El "p" UI.eyebrow [Txt "LOCAL WORKSHOP / PRINTERS"], El "h1" UI.title [Txt "Print room"], El "p" UI.subtitle [Txt "A quiet view of what’s happening on the beds."]]
      , El "div" UI.pills [pill UI.badge "READ ONLY", pill (UI.hidden (not v.demo) :: UI.demo :: UI.badge) "DEMO DATA",
          El "button" (List.append UI.button (List.append UI.quiet [Att "type" "button", Att "data-sign-out" "true"])) [Txt "Sign out"]]]
  , El "section" (Att "aria-label" "Dashboard health" :: UI.overview)
      [El "div" Nil [El "strong" [UI.u [G.Foreground UI.ink]] [Dyn (str (List.length v.printers))], Txt " printers"]
      , El "div" Nil [Txt "Refresh ", El "strong" [UI.u [G.Foreground UI.ink]] [Txt "{ms} ms"], Txt " · observed ", Dyn "{v.tickUs / 1000} ms"]
      , El "div" (UI.health (stale v)) [Dyn (if stale v then "Bridge stale / unavailable" else "Bridge connected")]
      , El "div" [Att "id" "lv-link", UI.muted] [Txt "live"]]
  , El "p" (Att "role" "status" :: UI.hidden (strlen v.issue == 0) :: UI.banner) [Dyn v.issue]
  , El "section" (Att "aria-label" "Printers" :: UI.cards) (List.map (card v) v.printers)
  , El "p" (UI.hidden (List.length v.printers != 0) :: UI.empty) [Txt "No printers yet. Start the bridge in demo mode or configure your local printers."]
  , El "footer" UI.footer [Txt "FP-RISC · Shared live telemetry, per-tab controls. No print, motion or temperature commands."]]]).
setting d k v = case Decode.run (Decode.field k d) v of Ok x -> x | Err why -> Program.fail 2 "printers: {why}".
main = case Config.load { defaults = Json.object [("port", Json.Integer 6732), ("address", Json.Text "127.0.0.1"), ("status", Json.Text "printers-status.json"), ("store", Json.Text "printers.kvlog"), ("poll-ms", Json.Integer 1000)], file = Option.None, envPrefix = "PRINTERS_", args = Program.args Unit } of
    Err why -> Program.fail 2 "printers: {why}"
  | Ok v ->
      ms = setting Decode.int "poll-ms" v;
      (if ms < 250 or ms > 10000 then Program.fail 2 "printers: poll-ms must be 250..10000" else
        path = setting Decode.string "status" v;
        cfg = { Live.defaults | port = setting Decode.int "port" v, address = setting Decode.string "address" v, store = setting Decode.string "store" v, journal = False, title = "Print room", script = strcat (LJ.src Unit) cameraScript };
        _ = Live.serveProjectedBody UI.document cfg { init = initial path, update = update path, subs = subs ms, fields = Nil, codec = codec, project = project, same = (fn a b -> a == b), cache = Unit, view = (fn sid v cache -> (view ms sid v, Unit)), css = css };
        0).

# Local rules travel with the view; no global or component stylesheet.
css v = "".
cameraScript = Media.program {hostAttribute = "data-camera-id", onAttribute = "data-camera-on",
  statusAttribute = "data-camera-status", rootId = "lv-root", linkId = "lv-link",
  routePrefix = "/camera/", routeSuffix = ".mjpg",
  image = El "img" [UI.u [G.Display G.Block, G.Width (G.Pct 100), G.Height (G.Pct 100), G.AspectRatio 16 9, G.ObjectFit G.Contain, G.Radius (G.Px 8)]] Nil,
  labels = {off = "Camera is off", paused = "Camera paused while this tab is hidden or disconnected",
    connecting = "Connecting to camera…", connected = "Camera connected · native frame rate",
    failed = "Camera unavailable. Switch off and on to retry."}}.

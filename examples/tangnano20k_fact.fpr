profile builtin.

# Factorial over SimpleRisc's UART on the Tang Nano 20K
# (docs/2026-10-05-TANG-NANO-BUILTIN.md).  The program prints "n?", reads a
# decimal number ended by a newline and answers with n!; an empty line stops
# it.  Int is 31 bits on RV32, so 12! is the largest factorial that fits.
#
# The UART is driven directly through raw memory: STATUS at 0x1000_0004
# (bit 1 = a received byte is waiting) and RXDATA at 0x1000_0008 (a load
# returns the byte and consumes it).  The receiver holds one byte, so input
# is only read after the prompt, never while printing.

byteWaiting s = (s / 2) - (s / 4) * 2 == 1.

getc status rx = if byteWaiting (Mem.read8 status) then Mem.read8 rx else getc status rx.

isDigit c = if c < 48 then False else c <= 57.

# What readLine returns besides a number.
emptyLine = 0 - 1.
notANumber = 0 - 2.
tooLarge = 1001.

# Read up to a newline, ignoring carriage returns.  Values above 1000
# saturate at tooLarge instead of overflowing.
readLine status rx count value ok =
  c = getc status rx;
  if c == 10
    then (if ok then if count == 0 then emptyLine else value else notANumber)
    else if c == 13
      then readLine status rx count value ok
      else if isDigit c
        then readLine status rx (count + 1) (if value > 100 then tooLarge else value * 10 + c - 48) ok
        else readLine status rx (count + 1) value False.

fact n acc = if n == 0 then acc else fact (n - 1) (acc * n).

answer n =
  if n == notANumber
    then print "send digits only"
    else if n >= tooLarge
      then print "too large: 12! is the largest factorial a 31-bit Int holds"
      else if n > 12
        then print "{n}! does not fit a 31-bit Int: 12! is the largest"
        else print "{n}! = {fact n 1}".

session status rx =
  _ = print "n?";
  n = readLine status rx 0 0 True;
  if n == emptyLine
    then print "bye"
    else
      _ = answer n;
      session status rx.

main =
  # Built once: in manual mode every I64 or Addr value is a heap box.
  status = Addr.ofI64 (I64.trunc 268435460);
  rx = Addr.ofI64 (I64.trunc 268435464);
  _ = print "factorial on SimpleRisc RV32IM: answer each prompt with a number, an empty line to stop";
  session status rx.

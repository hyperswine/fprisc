#!/usr/bin/env -S fpr run
# todo.fpr -- a terminal application: the same shape as a web one (std/term.fpr).
#
#   fpr run examples/todo.fpr [todo.kvlog]
#
#   type and press Enter to add    Up / Down to move    Tab to tick    Delete to remove
#   Ctrl-q or Escape to quit
#
# `update` is a pure function of events; saving is a COMMAND.  The list is a
# DURABLE FIELD, named by its path (`Live.field Live.Always @Model.items`): the
# codec, the key and the restart that brings it back are the declaration's, and
# the store is an append-only log (std/kvlog), so every change is one record and
# the file is the list's whole history.  No file handle lives in the model: the
# command closes over the store.
profile base.

Term = use "std/term".
Live = use "std/live".
KvLog = use "std/kvlog".
Map = use "std/map".
List = use "std/list".
String = use "std/string".
Program = use "std/program".
Clock = use "std/clock".

Todo = {text : String, done : Bool}.
Model = {items : List Todo, at : Int, draft : String, note : String, seconds : Int}.
Msg = Type (Saved String | Second).

# the one durable field; everything else is the session's
fields = Live.field Live.Always @Model.items :: Nil.
init = {items = Nil, at = 0, draft = "", note = "", seconds = 0}.

save db saved m = Term.Run (fn u -> _ = Live.flush fields db m saved; Saved "saved").

count m = List.length m.items.
clampAt m = {m | at = (if m.at < 0 then 0 else if m.at >= count m then (if count m == 0 then 0 else count m - 1) else m.at)}.

updateWith db saved ev m = case ev of
    Term.Resized _ _ -> (m, Nil)
  | Term.Msg (Saved what) -> ({m | note = what}, Nil)
  | Term.Msg Second -> ({m | seconds = m.seconds + 1}, Nil)
  | Term.Key k -> (case k of
        Term.Char c -> ({m | draft = strcat m.draft c}, Nil)
      | Term.Backspace -> ({m | draft = dropLastChar m.draft}, Nil)
      | Term.Enter -> (if strlen (String.trim m.draft) == 0 then (m, Nil)
                       else changed db saved {m | items = List.append m.items ({text = String.trim m.draft, done = False} :: Nil), draft = "", at = count m})
      | Term.Up -> (clampAt {m | at = m.at - 1}, Nil)
      | Term.Down -> (clampAt {m | at = m.at + 1}, Nil)
      | Term.Tab -> changed db saved {m | items = List.indexedMap (fn i t -> if i == m.at then {t | done = not t.done} else t) m.items}
      | Term.Delete -> changed db saved (clampAt {m | items = List.map (fn p -> case p of (_, t) -> t) (List.filter (fn p -> case p of (i, _) -> i != m.at) (List.indexed m.items))})
      | Term.Escape -> (m, Term.Quit :: Nil)
      | Term.Ctrl "q" -> (m, Term.Quit :: Nil)
      | _ -> (m, Nil)).

changed db saved m = (m, save db saved m :: Nil).

# one whole UTF-8 character off the end
# drop the last UTF-8 character: `k` bytes remain to look at, and shrinks
dropLastChar s = dropGo s (strlen s).
dropGo : String -> (k : Int | measure k) -> String .
dropGo s k = if k <= 0 then "" else if charAt s (k - 1) >= 128 and charAt s (k - 1) < 192 then dropGo s (k - 1) else substr s 0 (k - 1).

view size m = case size of (cols, rows) ->
  Term.bold "To do" :: Term.dim "{List.length (List.filter (fn t -> t.done) m.items)} of {count m} done   up {m.seconds} s   {m.note}" :: ""
  :: List.append (List.indexedMap (fn i t -> row (i == m.at) t) m.items)
       ("" :: "> {m.draft}_" :: "" :: Term.dim "Enter add   Up/Down move   Tab tick   Delete remove   Esc quit" :: Nil).

row here t =
  line = "{(if t.done then "[x]" else "[ ]")} {t.text}";
  if here then Term.inverse line else (if t.done then Term.dim line else line).

subs m = Term.Every 1000 Second :: Nil.

main =
  path = (case Program.args Unit of p :: _ -> p | Nil -> "todo.kvlog");
  db = (case KvLog.open path of Ok d -> d | Err why -> Program.fail 1 "todo: {path}: {why}");
  model = (case Live.restore fields db init of Ok m -> m | Err why -> Program.fail 1 "todo: {path}: {why}");
  saved = Live.start fields db model Map.strings;
  Term.run { init = model, update = updateWith db saved, view = view, subs = subs }.

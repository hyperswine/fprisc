#!/usr/bin/env -S fpr run
# Same terminal app, durable list and commands as ../todo.fpr.
profile base.
Term = use "std/term".
Live = use "std/live".
Durable = use "std/durable".
List = use "std/list".
String = use "std/string".
Program = use "std/program".

Todo = {text : String, done : Bool}.
Model = {items : List Todo, at : Int, draft : String, note : String, seconds : Int}.
Msg = Type (Saved String | Second).
# the one durable field, by its path; the store (std/durable) saves what differs
fields = [Live.field Live.Always @Model.items].
init = {items = Nil, at = 0, draft = "", note = "", seconds = 0}.

save store m = Term.Run (fn u -> _ = Durable.save store m; Saved "saved").
changed store m = (m, save store m :: Nil).
unchanged m = (m, Nil).
quit m = (m, Term.Quit :: Nil).
count m = List.length m.items.

# Internal arithmetic invariant: an empty list selects 0, otherwise 0..n-1.
selection : (n : Int | n >= 0) -> Int -> Int | work selection <= 12 | alloc selection <= 0 .
selection 0 _ = 0.
selection _ at | at < 0 = 0.
selection n at | at >= n = n - 1.
selection _ at = at.
clampAt m = {m | at = selection (count m) m.at}.
move delta m = {m | at = m.at + delta} |> clampAt |> unchanged.

toggleAt at i t | i == at = {t | done = not t.done}.
toggleAt _ _ t = t.
notSelected at (i, _) = i != at.
itemOf (_, item) = item.
removeAt at items = items |> List.indexed |> List.filter (notSelected at) |> List.map itemOf.
addDraft store text m | strlen text == 0 = unchanged m.
addDraft store text m = {m | items = List.append m.items [{text = text, done = False}], draft = "", at = count m} |> changed store.

# One event per clause. Commands remain values; update performs no I/O: the
# store is closed over by the save command, never held in the model.
updateWith store (Term.Resized _ _) m = unchanged m.
updateWith store (Term.Msg (Saved what)) m = {m | note = what} |> unchanged.
updateWith store (Term.Msg Second) m = {m | seconds = m.seconds + 1} |> unchanged.
updateWith store (Term.Key (Term.Char c)) m = {m | draft = strcat m.draft c} |> unchanged.
updateWith store (Term.Key Term.Backspace) m = {m | draft = dropLastChar m.draft} |> unchanged.
updateWith store (Term.Key Term.Enter) m = addDraft store (String.trim m.draft) m.
updateWith store (Term.Key Term.Up) m = move (-1) m.
updateWith store (Term.Key Term.Down) m = move 1 m.
updateWith store (Term.Key Term.Tab) m = {m | items = List.indexedMap (toggleAt m.at) m.items} |> changed store.
updateWith store (Term.Key Term.Delete) m = {m | items = removeAt m.at m.items} |> clampAt |> changed store.
updateWith store (Term.Key Term.Escape) m = quit m.
updateWith store (Term.Key (Term.Ctrl "q")) m = quit m.
updateWith store (Term.Key _) m = unchanged m.

# UTF-8 backspace: remaining byte positions prove this recursion terminates.
dropLastChar s = dropGo s (strlen s - 1).
dropGo : String -> (i : Int | measure (i + 1)) -> String .
dropGo _ i | i < 0 = "".
dropGo s i | i >= 0 and charAt s i >= 128 and charAt s i < 192 = dropGo s (i - 1).
dropGo s i = substr s 0 i.

mark True = "[x]".
mark False = "[ ]".
style True _ line = Term.inverse line.
style False True line = Term.dim line.
style False False line = line.
row here t = "{mark t.done} {t.text}" |> style here t.done.
done t = t.done.
rowAt at i t = row (i == at) t.
view (_, _) m =
  Term.bold "To do" :: Term.dim "{List.length (List.filter done m.items)} of {count m} done   up {m.seconds} s   {m.note}" :: ""
  :: List.append (List.indexedMap (rowAt m.at) m.items)
       ["", "> {m.draft}_", "", Term.dim "Enter add   Up/Down move   Tab tick   Delete remove   Esc quit"].
subs _ = Term.Every 1000 Second :: Nil.

pathOf (path :: _) = path.
pathOf Nil = "todo.kvlog".
# the store opened once: the list's last value laid over `init`, or a refusal by name
opened (Ok (model, store)) = Term.run {init = model, update = updateWith store, view = view, subs = subs}.
opened (Err why) = Program.fail 1 "todo: {why}".
run : String -> Int .
run path = Durable.open fields path init |> opened.
main : Int .
main = Program.args Unit |> pathOf |> run.

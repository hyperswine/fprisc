# ============================================================================
# inventory.fpr -- where everything in the house is.  A household inventory in
# FP-RISC Base on the posix system, served by std/live, shaped like pos1.fpr:
# phones and laptops are websocket sessions over ONE model actor, and the disk
# holds ONE append-only log, which is the inventory.
#
#   fpr run examples/inventory.fpr [--port=6720] [--address=127.0.0.1] [--store=inventory.log]
#                                  [--page-size=20] [--cache-items=200]
#   fpr run examples/inventory.fpr --member=NAME --password=SECRET      (add a member, then exit)
#   fpr run examples/inventory.fpr --import=firestore.json             (the old app's items, then exit)
#
# Every setting is also INV_<NAME> in the environment (INV_PASSWORD keeps a
# password out of the shell history).
#
# THE ONE RULE (pos1's).  Every change is a LINE, and `apply` is the only thing
# that reads a line into the model.  A handler validates, then `commit`s the
# line: apply it now and queue it for the disk.  Boot is the same `apply`
# folded over the log, so what a phone shows is what a restart would rebuild.
# A line is one JSON object, because names and notes are free text:
#
#   {"op":"item","id":7,"name":..,"loc":..,"sub":..,"desc":..,"tags":[..],"by":..,"at":..[,"created":..]}
#   {"op":"del","id":7,"by":..,"at":..}
#   {"op":"member","name":..,"salt":..,"hash":..,"at":..}     a password, salted and hashed
#   {"op":"device","name":..,"hash":..,"at":..}               a remembered phone (the token's hash)
#   {"op":"undevice","hash":..,"at":..}   {"op":"revoke","name":..,"at":..}
#
# An edit is a new "item" line with the same id, so the log is every item's
# history: the model keeps the last few places an item was moved from.
#
# PAGES.  A tab shows `page-size` items at a time.  Its writer remembers the
# rendered cards of the pages it showed lately, up to `cache-items` of them
# (std/viewcache `retain`): going back a page is free, and a tab that has
# looked at every page still holds at most that many cards -- past that, a card
# is rendered again from the model.
#
# AUTOCOMPLETE.  When the editor opens, the server hands the page the household's
# rooms, spots (per room) and tags, the ones edited lately first and your own
# edits before others'.  The page's script suggests from them as you type:
# Tab (or Enter after choosing with the arrow keys) takes a suggestion, and on a
# phone tapping the field you are already in takes the first one.
#
# THE ADMIN PANE (pos1's).  A profile of the app measuring itself -- each kind
# of event's update, the disk append, the boot fold, this tab's renders and
# its card cache, the runtime's memory, the browser's round trip -- projected
# only to a tab looking at it.  And a console over the data: `help` lists the
# commands; the ones that change things commit lines like any other edit.
#
# SIGNING IN.  A member signs in once per device with a name and password; the
# server then hands the page a random token, which the page keeps in
# localStorage and mirrors back on every connection.  Only its hash is in the
# log.  Signing out forgets that device; "sign out other devices" forgets the rest.
# ============================================================================

unsafe base.

Live = use "std/live".
G = use "std/view".
Appearance = use "std/appearance".
LJ = use "std/livejs".
Metrics = use "std/livemetrics".
B = use "std/browsercalc".
Console = use "std/browserconsole".
VC = use "std/viewcache".
List = use "std/list".
S = use "std/string".
File = use "std/file".
Stream = use "std/stream".
LF = use "std/logfile".
Clock = use "std/clock".
Config = use "std/config".
Decode = use "std/decode".
Json = use "std/json".
Program = use "std/program".
Option = use "std/option".
Order = use "std/order".
Digest = use "std/digest".

El = G.El.
Txt = G.Txt.
Dyn = G.Dyn.
Cls = G.Cls.
Att = G.Att.
Inp = G.Inp.

Msg = Type (Login String | Logout | ClientState String | New | Edit Int | Save | Cancel | Delete Int
          | AddTag String | AddMember String | Password String | ForgetDevices | Theme | Dismiss | Clear Int Int | Page Int
          | Admin String).
codec = @Msg.

# What the page holds.  The search, the sort and the editor's drafts are
# mirrored to the server (Live.SyncClientState), so a Save reads the draft the
# person saw; password inputs never are -- they travel only as a sign-in's or
# a member form's argument.  `tok` is the remembered device, put there by the
# page's script from localStorage.
Client = { pane : String, q : String, sort : String, confirm : String,
           name : String, loc : String, sub : String, desc : String, tags : String,
           user : String, pw : String, tok : String, mname : String, mpw : String, npw : String, cmd : String }.

Move = { at : Int, from : String }.
Item = { id : Int, name : String, loc : String, sub : String, desc : String, tags : List String,
         created : Int, at : Int, by : String, moves : List Move }.

# ---- the model --------------------------------------------------------------------
# members are (name, salt, hash); devices are (token hash, name)

initModel = { items = Nil, nextId = 1, members = Nil, devices = Nil, pend = Nil, events = 0, skipped = 0,
              fails = Nil, sess = Nil, booted = 0, path = "", prof = noProf, sink = LF.sink "" 0 }.
noDraft = { name = "", loc = "", sub = "", desc = "", tags = "" }.
noSess = { sid = 0, user = "", toast = "", role = "", tn = 0, editing = 0 - 1, q = "", sort = "recent", page = 0, pane = "items", con = Nil,
           tried = "", theme = 1, d = noDraft }.

# the tags offered while editing, before the household has its own
quickTags = ["electronics", "cables", "tools", "kitchen", "bathroom", "office", "bedroom", "storage",
             "cleaning", "books", "clothes", "charging", "computer", "gaming", "furniture", "documents"].

# ---- little prelude -----------------------------------------------------------------

strEq : String -> String -> Bool .
strEq a b = a == b.
imax a b | a > b = a.
imax a b = b.
num s = numGo s 0 (strlen s) 0.
numGo s i n acc | i >= n = acc.
numGo s i n acc | isDig (charAt s i) = numGo s (i + 1) n (acc * 10 + charAt s i - 48).
numGo s i n acc = acc.
isDig c = c >= 48 and c <= 57.
# "a|b" -> (a, b) at the first bar; no bar: (s, "")
splitBar s = sbGo s 0 (strlen s).
sbGo s i n | i >= n = (s, "").
sbGo s i n | charAt s i == 124 = (substr s 0 i, substr s (i + 1) (n - i - 1)).
sbGo s i n = sbGo s (i + 1) n.
# a member's name: lower-case letters and digits, 1..16 of them
wordy s = strlen s >= 1 and strlen s <= 16 and wdGo s 0 (strlen s).
wdGo s i n | i >= n = True.
wdGo s i n =
  c = charAt s i;
  case (c >= 48 and c <= 57) or (c >= 97 and c <= 122) of True -> wdGo s (i + 1) n | False -> False.
clip n s | strlen s > n = substr s 0 n.
clip n s = s.
lower s = S.toLower s.
place it | strlen it.sub == 0 = it.loc.
place it = "{it.loc} / {it.sub}".
# "USB, cables ,usb" -> ["usb", "cables"]
tagsOf raw = List.unique (List.filter (fn t -> strlen t > 0) (List.map (fn t -> clip 32 (lower (S.trim t))) (S.split "," raw))).

memName (n, salt, hash) = n.
memSalt (n, salt, hash) = salt.
memHash (n, salt, hash) = hash.
devHash (h, n) = h.
devName (h, n) = n.

# ---- reading a line ----------------------------------------------------------------

txt k v = Option.withDefault "" (Option.andThen Json.asString (Json.field k v)).
int k v = Option.withDefault 0 (Option.andThen Json.asInt (Json.field k v)).
strs k v = case Option.andThen Json.asList (Json.field k v) of
    Option.Some xs -> List.filterMap Json.asString xs
  | Option.None -> Nil.

# ---- the interpreter: one line into the model --------------------------------------
# the whole meaning of the log, live and at boot alike

apply m line | strlen (S.trim line) == 0 = m.
apply m line = case Json.parse line of
    Err why -> { m | skipped = m.skipped + 1 }
  | Ok v -> applyOp m (txt "op" v) v.

applyOp m op v | strEq op "item" =
  at = int "at" v;
  made = int "created" v;
  # a place renamed (the console's `rename`) is the same place: not a move
  putItem (strEq (txt "why" v) "rename") m { id = int "id" v, name = txt "name" v, loc = txt "loc" v, sub = txt "sub" v, desc = txt "desc" v,
              tags = strs "tags" v, created = (case made == 0 of True -> at | False -> made), at = at, by = txt "by" v, moves = Nil }.
applyOp m op v | strEq op "del" = { m | items = List.filter (fn it -> it.id != int "id" v) m.items }.
applyOp m op v | strEq op "member" =
  { m | members = (txt "name" v, txt "salt" v, txt "hash" v) :: List.filter (fn mm -> not (strEq (memName mm) (txt "name" v))) m.members }.
applyOp m op v | strEq op "device" = { m | devices = (txt "hash" v, txt "name" v) :: m.devices }.
applyOp m op v | strEq op "undevice" = { m | devices = List.filter (fn d -> not (strEq (devHash d) (txt "hash" v))) m.devices }.
applyOp m op v | strEq op "revoke" = { m | devices = List.filter (fn d -> not (strEq (devName d) (txt "name" v))) m.devices }.
applyOp m op v = m.

findItem items id = List.find (fn x -> x.id == id) items.
putItem renamed m it = case findItem m.items it.id of
    Option.None -> { m | items = it :: m.items, nextId = imax m.nextId (it.id + 1) }
  | Option.Some old ->
      new = { it | created = old.created, moves = (case renamed of True -> old.moves | False -> movedFrom old it) };
      { m | items = List.map (fn x -> (case x.id == it.id of True -> new | False -> x)) m.items, nextId = imax m.nextId (it.id + 1) }.
movedFrom old it | strEq (place old) (place it) = old.moves.
movedFrom old it = List.take 3 ({ at = it.at, from = place old } :: old.moves).

# a validated change: applied now, queued for the disk
commit m line = apply { m | pend = line :: m.pend, events = m.events + 1 } line.

itemLine it by at = Json.render (Json.object
  [("op", Json.Text "item"), ("id", Json.Integer it.id), ("name", Json.Text it.name), ("loc", Json.Text it.loc),
   ("sub", Json.Text it.sub), ("desc", Json.Text it.desc), ("tags", Json.strings it.tags), ("by", Json.Text by),
   ("at", Json.Integer at), ("created", Json.Integer it.created)]).
# the same, marked as a rename of the place it is in
renameLine it by at = Json.render (Json.object
  [("op", Json.Text "item"), ("why", Json.Text "rename"), ("id", Json.Integer it.id), ("name", Json.Text it.name), ("loc", Json.Text it.loc),
   ("sub", Json.Text it.sub), ("desc", Json.Text it.desc), ("tags", Json.strings it.tags), ("by", Json.Text by),
   ("at", Json.Integer at), ("created", Json.Integer it.created)]).
delLine id by at = Json.render (Json.object [("op", Json.Text "del"), ("id", Json.Integer id), ("by", Json.Text by), ("at", Json.Integer at)]).
memberLine name salt hash at = Json.render (Json.object
  [("op", Json.Text "member"), ("name", Json.Text name), ("salt", Json.Text salt), ("hash", Json.Text hash), ("at", Json.Integer at)]).
deviceLine name hash at = Json.render (Json.object [("op", Json.Text "device"), ("name", Json.Text name), ("hash", Json.Text hash), ("at", Json.Integer at)]).
undeviceLine hash at = Json.render (Json.object [("op", Json.Text "undevice"), ("hash", Json.Text hash), ("at", Json.Integer at)]).
revokeLine name at = Json.render (Json.object [("op", Json.Text "revoke"), ("name", Json.Text name), ("at", Json.Integer at)]).

# ---- secrets -------------------------------------------------------------------------------
# 32 bytes of the kernel's randomness, as 64 hex digits
randomHex u = case File.open "/dev/urandom" "r" of
    Err why -> error "inventory: no randomness: {why}"
  | Ok st -> (case Stream.read 32 st of
      Ok bytes -> _ = Stream.close st; Digest.sha256 bytes
    | Err why -> _ = Stream.close st; error "inventory: no randomness: {why}").
# a password is stored as sha256 iterated over salt and password: slow enough to
# make a stolen log a chore, quick enough for a sign-in
pwHash salt pw = stretch 200 (Digest.sha256 "{salt}:{pw}") salt.
stretch 0 h salt = h.
stretch n h salt = stretch (n - 1) (Digest.sha256 "{salt}{h}") salt.
checkPw members name pw = case List.find (fn mm -> strEq (memName mm) name) members of
    Option.Some mm -> strEq (pwHash (memSalt mm) pw) (memHash mm)
  | Option.None -> _ = pwHash "x" pw; False.   # the same work for a name that does not exist
hasMember m name = List.any (fn mm -> strEq (memName mm) name) m.members.
deviceUser devices h = case List.find (fn d -> strEq (devHash d) h) devices of
    Option.Some d -> Option.Some (devName d)
  | Option.None -> Option.None.

# ---- the disk ----------------------------------------------------------------------------

# The log is read once.  A last line without its newline is a torn append (the
# process died mid-write): it is cut off before anything is appended after it,
# or the next line would be glued to it and lost as well.  The sink starts at
# the size that is left, so the first write knows it is still that file.
boot path =
  m0 = { initModel | booted = Clock.now Unit };
  t0 = Sys.timeUs Unit;
  bytes = logBytes path;
  keep = LF.wholeLines bytes;
  _ = (case keep < strlen bytes of
         True -> (case LF.truncate path keep of
             Ok _ -> Sys.stderr "[inventory] cut a torn last line ({strlen bytes - keep} bytes) off {path}\n"
           | Err why -> error "inventory: cannot cut the torn end off {path}: {why}")
       | False -> Unit);
  m2 = replayed m0 (Ok (S.lines (substr bytes 0 keep)));
  t1 = Sys.timeUs Unit;
  _ = print "[inventory] log {path}: {m2.events} lines in {t1 - t0} us, {List.length m2.items} items, {List.length m2.members} members, {List.length m2.devices} devices";
  _ = (case m2.skipped > 0 of True -> Sys.stderr "[inventory] {m2.skipped} unreadable lines skipped\n" | False -> Unit);
  _ = (case List.isEmpty m2.members of True -> Sys.stderr "[inventory] no members yet: add one with --member=NAME and INV_PASSWORD\n" | False -> Unit);
  { m2 | path = path, sink = LF.sink path keep, prof = { noProf | bootUs = t1 - t0, bootLines = m2.events } }.
# no log yet is an empty one; a log that is there and cannot be read stops the start
logBytes path | not (File.exists path) = "".
logBytes path = case File.readBytes path of
    Ok bytes -> bytes
  | Err why -> error "inventory: cannot read {path}: {why}".
replayed m (Ok ls) = List.fold (fn mm l -> apply { mm | events = mm.events + 1 } l) m ls.
replayed m (Err e) = m.

# The pending lines, oldest first, in ONE write to the log the server keeps
# open (std/logfile; opening the file for every append was most of an append's
# cost).  A write that fails stops the server: the page must never show a
# change the disk does not have.
#
# Before each write the sink checks the path still names the file it left.
# When it does not -- a backup restored over it, a member added from the
# command line while the server runs -- the change still goes in (every line
# stands alone), and then the server stops; launchd starts it again, and the
# model is folded from what the file holds now.
flush path m = case m.pend of
    Nil -> m
  | ls ->
      bytes = S.concat (List.map (fn l -> "{l}\n") (List.reverse ls));
      (case LF.ready m.sink of
        LF.Same s -> wrote m (LF.write s bytes)
      | LF.Fresh s -> underUs m s bytes "is empty now"
      | LF.Other s -> underUs m s bytes "is not the file this server wrote"
      | LF.Failed s why -> error "inventory: cannot write {path}: {why}").
wrote m (Ok s) = { m | pend = Nil, sink = s }.
wrote m (Err why) = error "inventory: cannot write {m.path}: {why}".
underUs m s bytes what =
  _ = (case LF.write s bytes of Ok _ -> Unit | Err why -> Sys.stderr "[inventory] cannot write {m.path}: {why}\n");
  error "inventory: {m.path} {what}: wrote this change to it and stopped, to fold the file again".

# ---- sessions ----------------------------------------------------------------------------

sGet Nil sid = { noSess | sid = sid }.
sGet (s :: r) sid | s.sid == sid = s.
sGet (s :: r) sid = sGet r sid.
sPut m s = { m | sess = s :: sDel m.sess s.sid }.
sDel Nil sid = Nil.
sDel (s :: r) sid | s.sid == sid = sDel r sid.
sDel (s :: r) sid = s :: sDel r sid.
forget m sid = { m | sess = sDel m.sess sid }.
# a toast: text with a role (ok, warn); it clears itself after a while unless
# a newer one replaced it
toast m sid role text =
  s = sGet m.sess sid;
  (sPut m { s | toast = text, role = role, tn = s.tn + 1 }, Live.After 4000 (Clear sid (s.tn + 1)) :: Nil).
say m sid text = toast m sid "ok" text.
refuse m sid text = toast m sid "warn" text.
also (m, cs) more = (m, List.append cs more).

localOf v name = Option.withDefault "" (Option.andThen Json.asString (Json.field name v)).
localsJson kvs = Json.render (Json.object (List.map (fn kv -> (case kv of (k, x) -> (k, Json.Text x))) kvs)).
setLocals sid kvs = Live.Emit sid "locals" (localsJson kvs).
draftLocals d = [("name", d.name), ("loc", d.loc), ("sub", d.sub), ("desc", d.desc), ("tags", d.tags)].

# ---- update ------------------------------------------------------------------------------

# every event is timed: the app's own work, and the disk append when it wrote
update path ev m =
  t0 = Sys.timeUs Unit;
  (m2, cs) = step ev m;
  t1 = Sys.timeUs Unit;
  wrote = not (List.isEmpty m2.pend);
  m3 = flush path m2;
  t2 = Sys.timeUs Unit;
  prof = noteUpd (kindOf ev) (t1 - t0) m3.prof;
  ({ m3 | prof = (case wrote of True -> { prof | flush = note prof.flush (t2 - t1) } | False -> prof) }, cs).
step ev m = case ev of
    Live.Msg sid msg -> pMsg sid msg m
  | Live.Left sid -> (forget m sid, Nil)
  | Live.Joined sid -> (m, Nil)
  | Live.Refused sid why -> refuse m sid "refused: {why}".

pMsg sid msg m = case msg of
    Login arg -> login m sid arg
  | ClientState json -> mirror m sid json
  | Clear who n -> (case sid == 0 of True -> (clearToast m who n, Nil) | False -> (m, Nil))
  | Dismiss -> (dismiss m (sGet m.sess sid), Nil)
  | Theme -> (flipTheme m (sGet m.sess sid), Nil)
  | other -> withUser sid other m (sGet m.sess sid).
dismiss m s = clearToast m s.sid s.tn.
flipTheme m s = sPut m { s | theme = 1 - s.theme }.
clearToast m sid n =
  s = sGet m.sess sid;
  case s.tn == n of True -> sPut m { s | toast = "", role = "" } | False -> m.

# ---- profiling -----------------------------------------------------------------------------
# What the app measures about itself, shown on the admin pane (microseconds):
#   update  per kind of event: how long `step` took, i.e. the app's own work
#   append  how long the disk append took, per event that wrote
#   boot    folding the log at start
#   render  per TAB, in its writer: how long `view` took, the card cache's hits
#           and misses and how many cards it keeps (kept in the writer's cache,
#           so it lags the render that shows it by one)
#   memory  the runtime's ledgers (Sys.memInfo, Sys.memStats) and harts
#   rtt     in the browser: from a click's send to the next frame received
# A Stat is a count, a sum, a maximum and the last.
noStat = { n = 0, sum = 0, max = 0, last = 0 }.
note st us = { n = st.n + 1, sum = st.sum + us, max = imax st.max us, last = us }.
avg st = case st.n == 0 of True -> 0 | False -> st.sum / st.n.
noProf = { bootUs = 0, bootLines = 0, upd = Nil, flush = noStat, nev = 0 }.
noteUpd kind us prof = { prof | upd = noteKind prof.upd kind us, nev = prof.nev + 1 }.
noteKind Nil kind us = (kind, note noStat us) :: Nil.
noteKind ((k, st) :: r) kind us | strEq k kind = (k, note st us) :: r.
noteKind (e :: r) kind us = e :: noteKind r kind us.
kindOf ev = case ev of
    Live.Msg sid msg -> msgKind msg
  | Live.Joined sid -> "join"
  | Live.Left sid -> "leave"
  | Live.Refused sid why -> "refused".
msgKind msg = case msg of
    Login a -> "login" | Logout -> "logout" | ClientState a -> "sync" | New -> "new" | Edit a -> "edit" | Save -> "save"
  | Cancel -> "cancel" | Delete a -> "delete" | AddTag a -> "tag" | AddMember a -> "member" | Password a -> "password"
  | ForgetDevices -> "forget" | Theme -> "theme" | Dismiss -> "dismiss" | Clear a b -> "toast" | Page a -> "page" | Admin a -> "admin".
statLine label st = "{S.padRight 9 " " label} n {S.padLeft 6 " " "{st.n}"}  avg {S.padLeft 7 " " "{avg st}"} us  max {S.padLeft 7 " " "{st.max}"} us  last {st.last} us".

# ---- signing in ---------------------------------------------------------------------------
# at most 8 wrong passwords in five minutes, for the whole house: a guesser
# gains nothing by opening more tabs
login m sid arg =
  (name0, pw) = splitBar arg;
  name = lower (S.trim name0);
  now = Clock.now Unit;
  recent = List.filter (fn t -> t > now - 300) m.fails;
  case List.length recent >= 8 of
    True -> refuse { m | fails = recent } sid "too many wrong passwords: try again in a few minutes"
  | False -> (case checkPw m.members name pw of
      False -> refuse { m | fails = now :: recent } sid "unknown name or wrong password"
    | True ->
        tok = randomHex Unit;
        m2 = commit m (deviceLine name (Digest.sha256 tok) now);
        s = sGet m2.sess sid;
        (sPut m2 { s | user = name, tried = tok, toast = "", role = "" }, setLocals sid [("pw", ""), ("tok", tok)] :: Nil)).

# The mirror: the page's locals, as the server knows them.  A page that is not
# signed in but holds a token is signed in by it, once per token.
mirror m sid json = case Json.parse json of
    Err why -> (m, Nil)
  | Ok v ->
    s0 = sGet m.sess sid;
    q = clip 100 (S.trim (localOf v "q"));
    sort = localOf v "sort";
    # a new search or a new order starts at the first page
    page = (case strEq q s0.q and strEq sort s0.sort of True -> s0.page | False -> 0);
    s = { s0 | q = q, sort = sort, page = page, pane = localOf v "pane",
               d = { name = localOf v "name", loc = localOf v "loc", sub = localOf v "sub", desc = localOf v "desc", tags = localOf v "tags" } };
    resume m sid s (localOf v "tok").
resume m sid s tok | strlen s.user > 0 or strlen tok == 0 or strEq tok s.tried = (sPut m s, Nil).
resume m sid s tok = case deviceUser m.devices (Digest.sha256 tok) of
    Option.Some name -> (sPut m { s | user = name, tried = tok }, Nil)
  | Option.None -> (sPut m { s | tried = tok }, setLocals sid [("tok", "")] :: Nil).

withUser sid msg m s | strEq s.user "" = refuse m sid "sign in first".
withUser sid msg m s = case msg of
    Logout -> signOut m sid s
  | New -> (sPut m { s | editing = 0, d = noDraft }, setLocals sid (draftLocals noDraft) :: suggest sid s.user m :: Nil)
  | Page n -> (sPut m { s | page = imax 0 n }, Nil)
  | Edit id -> edit m sid s id
  | Cancel -> (sPut m { s | editing = 0 - 1 }, setLocals sid (draftLocals noDraft) :: Nil)
  | Save -> save m sid s
  | Delete id -> delete m sid s id
  | AddTag t -> addTag m sid s t
  | AddMember arg -> addMember m sid s (splitBar arg)
  | Password pw -> password m sid s pw
  | ForgetDevices -> forgetDevices m sid s
  | Admin cmd -> console m sid s cmd
  | other -> refuse m sid "no such action".

signOut m sid s =
  m2 = (case strlen s.tried > 0 of True -> commit m (undeviceLine (Digest.sha256 s.tried) (Clock.now Unit)) | False -> m);
  (forget m2 sid, setLocals sid [("tok", ""), ("pane", "items")] :: Nil).

# ---- items ---------------------------------------------------------------------------------

edit m sid s id = case findItem m.items id of
    Option.None -> refuse m sid "that item is gone"
  | Option.Some it ->
      d = { name = it.name, loc = it.loc, sub = it.sub, desc = it.desc, tags = S.join ", " it.tags };
      (sPut m { s | editing = id, d = d }, setLocals sid (draftLocals d) :: suggest sid s.user m :: Nil).

save m sid s =
  d = s.d;
  name = clip 120 (S.trim d.name);
  loc = clip 60 (S.trim d.loc);
  isNew = s.editing <= 0;
  old = findItem m.items s.editing;
  case strlen name == 0 of
    True -> refuse m sid "give the item a name"
  | False -> (case strlen loc == 0 of
      True -> refuse m sid "where is it? a room or place is needed"
    | False -> (case not isNew and old == Option.None of
        True -> refuse (sPut m { s | editing = 0 - 1 }) sid "that item was deleted while you were editing it"
      | False ->
          now = Clock.now Unit;
          id = (case isNew of True -> m.nextId | False -> s.editing);
          it = { id = id, name = name, loc = loc, sub = clip 60 (S.trim d.sub), desc = clip 2000 (S.trim d.desc),
                 tags = List.take 12 (tagsOf d.tags), created = (case old of Option.Some o -> o.created | Option.None -> now),
                 at = now, by = s.user, moves = Nil };
          m2 = sPut (commit m (itemLine it s.user now)) { s | editing = 0 - 1, d = noDraft };
          also (say m2 sid (case isNew of True -> "added {name}" | False -> "saved {name}")) (setLocals sid (draftLocals noDraft) :: Nil))).

delete m sid s id = case findItem m.items id of
    Option.None -> refuse m sid "already deleted"
  | Option.Some it ->
      m2 = commit m (delLine id s.user (Clock.now Unit));
      s2 = sGet m2.sess sid;
      m3 = sPut m2 { s2 | editing = (case s2.editing == id of True -> 0 - 1 | False -> s2.editing) };
      also (say m3 sid "deleted {it.name}") (setLocals sid [("confirm", "")] :: Nil).

addTag m sid s t =
  have = tagsOf s.d.tags;
  case List.member t have of
    True -> (m, Nil)
  | False ->
      tags = S.join ", " (have + [t]);
      (sPut m { s | d = { s.d | tags = tags } }, setLocals sid [("tags", tags)] :: Nil).

# ---- autocomplete: what the editor's script suggests from ----------------------------------------
# Rooms, spots and tags in the order they were last used, a member's own edits
# counted as a month more recent than they are; the page does the matching.
#   {"loc": [...], "sub": {"*": [...], "<room, lower case>": [...]}, "tags": [...]}
suggest sid user m = Live.Emit sid "suggest" (suggestJson user m.items).
suggestJson user items =
  recent = List.sortBy (Order.reverse Order.int) (fn it -> it.at + (case strEq it.by user of True -> 2592000 | False -> 0)) items;
  locs = List.take 100 (uniqueCi (List.map (fn it -> it.loc) recent));
  spots l = List.take 30 (uniqueCi (List.map (fn it -> it.sub) (List.filter (fn it -> strEq (lower it.loc) (lower l)) recent)));
  Json.render (Json.object
    [ ("loc", Json.strings locs)
    , ("sub", Json.object (("*", Json.strings (List.take 100 (uniqueCi (List.map (fn it -> it.sub) recent))))
                           :: List.map (fn l -> (lower l, Json.strings (spots l))) locs))
    , ("tags", Json.strings (List.take 100 (List.unique (List.concatMap (fn it -> it.tags) recent)))) ]).
# the first spelling of each value, ignoring case and the empty one
uniqueCi xs = List.reverse (List.fold (fn seen x -> (case strlen x == 0 or List.any (fn y -> strEq (lower y) (lower x)) seen of True -> seen | False -> x :: seen)) Nil xs).

# ---- the console: the data, live -------------------------------------------------------------------
# A command and what it answered go on this tab's console (the newest 40
# lines); the input is emptied for the next one.

console m sid s cmd =
  line = S.trim cmd;
  (m2, out) = run m s line;
  s2 = sGet m2.sess sid;
  con = (case strEq line "clear" of True -> Nil | False -> List.take 40 (out :: "> {line}" :: s2.con));
  (sPut m2 { s2 | con = con }, setLocals sid [("cmd", "")] :: Nil).

run m s line = case S.words line of
    Nil -> (m, helpText)
  | w :: r -> runW m s (lower w) (S.trim (S.dropLeft (strlen w) line)).
runW m s w rest | strEq w "help" = (m, helpText).
runW m s w rest | strEq w "clear" = (m, "").
runW m s w rest | strEq w "stats" = (m, statsText m).
runW m s w rest | strEq w "find" = (m, findText m rest).
runW m s w rest | strEq w "show" = (m, withItem m rest showText).
runW m s w rest | strEq w "history" = (m, historyText m (idOf rest)).
runW m s w rest | strEq w "places" = (m, countsText (ranked (List.map (fn it -> it.loc) m.items))).
runW m s w rest | strEq w "tags" = (m, countsText (ranked (List.concatMap (fn it -> it.tags) m.items))).
runW m s w rest | strEq w "spots" = (m, spotsText m rest).
runW m s w rest | strEq w "move" = moveCmd m s (splitArrow rest).
runW m s w rest | strEq w "rename" = renameCmd m s (splitArrow rest).
runW m s w rest | strEq w "retag" = retagCmd m s (splitArrow rest).
runW m s w rest | strEq w "delete" = deleteCmd m s (idOf rest).
runW m s w rest | strEq w "rebuild" = rebuildCmd m.
runW m s w rest = (m, "unknown: {w} (try help)").

helpText = S.join "\n"
  [ "stats                       counts, the log, who is signed in"
  , "find WORDS                  matching items, with their ids"
  , "show ID                     an item, every field"
  , "history ID                  every change to an item, read from the log"
  , "places | tags               each, with how many items have it"
  , "spots PLACE                 the spots in a place"
  , "move ID -> PLACE [/ SPOT]   put an item somewhere else"
  , "rename OLD -> NEW           rename a place on every item in it"
  , "retag ID -> TAGS            replace an item's tags (comma separated)"
  , "delete ID                   delete an item"
  , "rebuild                     fold the log again and compare with the model"
  , "clear                       empty this console" ].

# "#12", "12" -> 12; anything else is 0, which no item has
idOf s = num (S.trim (case S.startsWith "#" (S.trim s) of True -> S.dropLeft 1 (S.trim s) | False -> s)).
# "a -> b" -> (a, b); no arrow: (s, "")
splitArrow s = case S.indexOf "->" s of
    Option.Some i -> (S.trim (S.left i s), S.trim (S.dropLeft (i + 2) s))
  | Option.None -> (S.trim s, "").
# "room / spot" -> (room, spot)
splitSlash s = case S.indexOf "/" s of
    Option.Some i -> (S.trim (S.left i s), S.trim (S.dropLeft (i + 1) s))
  | Option.None -> (S.trim s, "").

withItem m arg f = case findItem m.items (idOf arg) of
    Option.None -> "no item {S.trim arg} (find WORDS gives ids)"
  | Option.Some it -> f it.
itemRow it = "#{S.padRight 4 " " "{it.id}"} {it.name}  @ {place it}".
plural 1 one many = "1 {one}".
plural n one many = "{n} {many}".

statsText m =
  places = List.length (List.unique (List.map (fn it -> lower it.loc) m.items));
  tags = List.length (List.unique (List.concatMap (fn it -> it.tags) m.items));
  S.join "\n"
    [ "{plural (List.length m.items) "item" "items"} in {plural places "place" "places"}, {plural tags "tag" "tags"}"
    , "{plural (List.length m.members) "member" "members"} ({S.join ", " (List.map memName m.members)}), {plural (List.length m.devices) "signed-in device" "signed-in devices"}"
    , "signed in now: {S.join ", " (List.filter (fn u -> strlen u > 0) (List.map (fn x -> x.user) m.sess))}"
    , "log {m.path}: {m.events} lines ({m.skipped} unreadable), next id {m.nextId}"
    , "up since {Clock.stamp m.booted}" ].

findText m words | strlen words == 0 = "find WORDS".
findText m words =
  hits = List.filter (matches (lower words)) m.items;
  case hits of
    Nil -> "nothing matches \"{words}\""
  | _ -> S.join "\n" (List.map itemRow (List.take 25 hits) + (case List.length hits > 25 of True -> ["... and {List.length hits - 25} more"] | False -> Nil)).

showText it = S.join "\n"
  ( "#{it.id} {it.name}"
  :: "  place  {place it}"
  :: "  tags   {S.join ", " it.tags}"
  :: "  added  {Clock.stamp it.created}, updated {Clock.stamp it.at} by {it.by}"
  :: List.map (fn mv -> "  moved from {mv.from} on {Clock.stamp mv.at}") it.moves
  + (case strlen it.desc == 0 of True -> Nil | False -> ["  notes  " + S.replace "\n" "\n         " it.desc]) ).

# from the disk, not the model: every line that wrote this item, oldest first
historyText m id = case File.lines m.path of
    Err why -> "cannot read the log: {why}"
  | Ok ls ->
      evs = List.filterMap (fn l -> (case Json.parse l of
                Ok v -> (case int "id" v == id and (strEq (txt "op" v) "item" or strEq (txt "op" v) "del") of True -> Option.Some v | False -> Option.None)
              | Err _ -> Option.None)) ls;
      case evs of
        Nil -> "no item #{id} in the log"
      | _ -> S.join "\n" (List.map histLine (List.drop (imax 0 (List.length evs - 30)) evs)).
histLine v | strEq (txt "op" v) "del" = "{Clock.stamp (int "at" v)}  {S.padRight 8 " " (txt "by" v)} deleted".
histLine v =
  where = (case strlen (txt "sub" v) == 0 of True -> txt "loc" v | False -> "{txt "loc" v} / {txt "sub" v}");
  why = (case strEq (txt "why" v) "rename" of True -> " (place renamed)" | False -> "");
  "{Clock.stamp (int "at" v)}  {S.padRight 8 " " (txt "by" v)} {txt "name" v} @ {where}  [{S.join ", " (strs "tags" v)}]{why}".

countsText kcs | List.isEmpty kcs = "none yet".
countsText kcs = S.join "\n" (List.map (fn kc -> (case kc of (k, c) -> "{S.padLeft 5 " " "{c}"}  {k}")) kcs).

spotsText m p | strlen p == 0 = "spots PLACE".
spotsText m p =
  here = List.filter (fn it -> strEq (lower it.loc) (lower p)) m.items;
  case here of
    Nil -> "no items in {p}"
  | _ -> countsText (ranked (List.map (fn it -> (case strlen it.sub == 0 of True -> "(no spot)" | False -> it.sub)) here)).

moveCmd m s (l, r) = case findItem m.items (idOf l) of
    Option.None -> (m, "move ID -> PLACE [/ SPOT]")
  | Option.Some it ->
      (loc, sub) = splitSlash r;
      (case strlen loc == 0 of
        True -> (m, "move ID -> PLACE [/ SPOT]")
      | False ->
          new = { it | loc = clip 60 loc, sub = clip 60 sub };
          (commit m (itemLine new s.user (Clock.now Unit)), "#{it.id} {it.name}: {place it} -> {place new}")).

renameCmd m s (old, new) | strlen old == 0 or strlen new == 0 = (m, "rename OLD -> NEW").
renameCmd m s (old, new) =
  hits = List.filter (fn it -> strEq (lower it.loc) (lower old)) m.items;
  now = Clock.now Unit;
  case hits of
    Nil -> (m, "no items in {old} (places lists them)")
  | _ -> (List.fold (fn mm it -> commit mm (renameLine { it | loc = clip 60 new } s.user now)) m hits,
          "{old} -> {new} on {plural (List.length hits) "item" "items"}").

retagCmd m s (l, r) = case findItem m.items (idOf l) of
    Option.None -> (m, "retag ID -> TAGS")
  | Option.Some it ->
      new = { it | tags = List.take 12 (tagsOf r) };
      (commit m (itemLine new s.user (Clock.now Unit)), "#{it.id} {it.name}: [{S.join ", " new.tags}]").

deleteCmd m s id = case findItem m.items id of
    Option.None -> (m, "delete ID")
  | Option.Some it -> (commit m (delLine id s.user (Clock.now Unit)), "deleted #{id} {it.name}").

# the log wins: fold the disk again and compare every item
rebuildCmd m = case File.lines m.path of
    Err why -> (m, "cannot read the log: {why}")
  | Ok ls ->
      d = replayed initModel (Ok ls);
      wrong = List.length (List.filter (fn it -> findItem m.items it.id != Option.Some it) d.items)
            + List.length (List.filter (fn it -> findItem d.items it.id == Option.None) m.items);
      case wrong == 0 of
        True -> (m, "the model matches the log: {d.events} lines, {plural (List.length d.items) "item" "items"}")
      | False -> ({ m | items = d.items, nextId = d.nextId }, "rebuilt from the log: {plural wrong "item" "items"} corrected").

# ---- the household ---------------------------------------------------------------------------

addMember m sid s (name0, pw) =
  name = lower (S.trim name0);
  case not (wordy name) of
    True -> refuse m sid "a name is 1 to 16 letters or digits"
  | False -> (case hasMember m name of
      True -> refuse m sid "{name} is already a member"
    | False -> (case strlen pw < 8 of
        True -> refuse m sid "a password is at least 8 characters"
      | False ->
          salt = randomHex Unit;
          m2 = commit m (memberLine name salt (pwHash salt pw) (Clock.now Unit));
          also (say m2 sid "{name} can sign in now") (setLocals sid [("mname", ""), ("mpw", "")] :: Nil))).

password m sid s pw | strlen pw < 8 = refuse m sid "a password is at least 8 characters".
password m sid s pw =
  salt = randomHex Unit;
  m2 = commit m (memberLine s.user salt (pwHash salt pw) (Clock.now Unit));
  also (say m2 sid "password changed") (setLocals sid [("npw", "")] :: Nil).

# every device of this member is forgotten, then this one is remembered again
forgetDevices m sid s =
  now = Clock.now Unit;
  n = List.length (List.filter (fn d -> strEq (devName d) s.user) m.devices);
  m2 = commit m (revokeLine s.user now);
  m3 = (case strlen s.tried > 0 of True -> commit m2 (deviceLine s.user (Digest.sha256 s.tried) now) | False -> m2);
  say m3 sid "signed out {imax 0 (n - 1)} other devices".

# every page mirrors its locals, a third of a second after they change
subs m = Live.SyncClientState 300 (ClientState "") :: Nil.

# ---- what a session sees (Live.serveProjected) -------------------------------------------------
# Its own search, sorted and filtered here; the counts; the chips.  A session
# whose projection did not change renders nothing.

matches q it = List.all (fn w -> hit w it) (S.words q).
hit w it = S.contains w (lower it.name) or S.contains w (lower it.loc) or S.contains w (lower it.sub)
        or S.contains w (lower it.desc) or List.any (fn t -> S.contains w t) it.tags.

sorted key items | strEq key "name" = List.sortBy Order.string (fn it -> lower it.name) items.
sorted key items | strEq key "place" = List.sortBy Order.string (fn it -> lower "{place it} {it.name}") items.
sorted key items = List.sortBy (Order.reverse Order.int) (fn it -> it.at) items.

# the most used values first: (value, count).  groupBy groups RUNS of equal
# values, hence the sort first
ranked xs = List.sortBy (Order.reverse Order.int) (fn kc -> (case kc of (k, c) -> c))
              (List.map (fn g -> (case g of (k, vs) -> (k, List.length vs))) (List.groupBy (fn x -> x) (List.sortBy Order.string (fn x -> x) xs))).
firsts kcs = List.map (fn kc -> (case kc of (k, c) -> k)) kcs.

noView = { signed = 0, user = "", toast = "", role = "", theme = 1, editing = 0 - 1, items = Nil, total = 0, shown = 0,
           page = 0, pages = 1, first = 0, q = "", places = Nil, tags = Nil, quick = Nil, members = Nil, devices = 0, online = 0,
           events = 0, booted = 0, con = Nil, nplaces = 0, ntags = 0, ndevices = 0, skipped = 0, pageSize = 0, keep = 0,
           prof = noProf, mem = Nil, grows = (0, 0), harts = 0 }.

# `size` items a page; a page past the end (the list shrank under it) is the last one.
# The profile and the runtime's numbers change on every event: only a tab on
# the admin pane gets them, so the others do not re-render for them.
project size keep sid m =
  s = sGet m.sess sid;
  case strEq s.user "" of
    True -> { noView | toast = s.toast, role = s.role, theme = s.theme }
  | False ->
      hits = sorted s.sort (List.filter (matches (lower s.q)) m.items);
      n = List.length hits;
      pages = imax 1 ((n + size - 1) / size);
      page = (case s.page >= pages of True -> pages - 1 | False -> s.page);
      onAdmin = strEq s.pane "admin";
      places = firsts (ranked (List.map (fn it -> it.loc) m.items));
      tags = firsts (ranked (List.concatMap (fn it -> it.tags) m.items));
      { signed = 1, user = s.user, toast = s.toast, role = s.role, theme = s.theme, editing = s.editing,
        items = List.take size (List.drop (page * size) hits), total = List.length m.items, shown = n,
        page = page, pages = pages, first = page * size, q = s.q,
        places = List.take 8 places, tags = List.take 12 tags,
        quick = List.take 18 (List.unique (tags + quickTags)),
        members = List.map memName m.members,
        devices = List.length (List.filter (fn d -> strEq (devName d) s.user) m.devices),
        online = List.length (List.filter (fn x -> strlen x.user > 0) m.sess),
        events = m.events, booted = m.booted, con = s.con,
        nplaces = List.length places, ntags = List.length tags, ndevices = List.length m.devices, skipped = m.skipped,
        pageSize = size, keep = keep,
        prof = (case onAdmin of True -> m.prof | False -> noProf),
        mem = (case onAdmin of True -> Sys.memInfo 0 | False -> Nil),
        grows = (case onAdmin of True -> Sys.memStats 0 | False -> (0, 0)),
        harts = Sys.harts Unit }.

# ---- view ------------------------------------------------------------------------------------------
# Mobile first: one column the width of a phone, capped on a desktop; buttons
# a thumb can hit.  Item cards are remembered per writer (std/viewcache): a
# card is a function of its item alone, so it renders once and again only when
# that item changes.

locals = G.locals @Client { pane = "items", q = "", sort = "recent", confirm = "", name = "", loc = "", sub = "", desc = "",
                            tags = "", user = "", pw = "", tok = "", mname = "", mpw = "", npw = "", cmd = "" }.
pageSize = G.utilities [G.MaxWidth (G.Px 760), G.Width (G.Pct 100),
  G.MarginY (G.Px 0), G.MarginX G.Auto, G.Padding (G.Px 14), G.PaddingBottom (G.Px 48)].
touchSize = G.utilities [G.MinHeight (G.Px 44)].
chipSize = G.utilities [G.MinHeight (G.Px 34)].
inputSize = G.utilities [G.FontSize (G.Px 16)]. # avoids iOS input zoom
# the remembered device lives in a hidden input, so the page's script can fill it
root v kids = El "div" (Att "data-theme" (if v.theme == 1 then "day" else "night") :: Appearance.frame (v.theme == 1))
  [El "div" (Att "data-ac-scope" "" :: Cls "col gap-4" :: pageSize :: locals)
    (Inp [G.bind @Client.tok, Att "type" "hidden"] :: autocompletePrototypes v :: kids)].

# Browser-owned suggestions clone these ordinary view nodes. The appearance,
# selected state and explicit palette live here, with all rules retained by
# renderStyled even while the prototypes themselves are hidden.
autocompletePrototypes v = El "div" [Att "data-ac-prototypes" "", G.utilities [G.Display G.Hidden]]
  [El "div" (Att "data-ac-frame" "" :: Att "role" "listbox" :: Att "aria-label" "Suggestions" ::
      G.utilities [G.Position G.Absolute, G.ZIndex 50, G.Display G.Flex, G.FlexWrap G.Wrap,
        G.Gap (G.Px 6), G.Padding (G.Px 8), G.Radius (G.Px 12),
        G.Background (G.ThemeColour G.Card), G.Foreground (G.ThemeColour G.Ink),
        G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder, G.BorderColour (G.ThemeColour G.Line),
        G.Shadow (G.Px 0) (G.Px 8) (G.Px 24) (G.Px 0) (G.RgbaPercent 0 0 0 18),
        G.FontFamily G.ReadingFont, G.FontSize (G.Px 15), G.LineHeight 155] :: Appearance.tokens (v.theme == 1)) Nil,
   autocompleteOption False, autocompleteOption True,
   El "span" [Att "data-ac-hint" "", G.utilities [G.FontSize (G.Px 11), G.Foreground (G.ThemeColour G.Dim), G.AlignSelf G.AlignCenter]] Nil].
autocompleteOption selected = El "button"
  [Att "data-ac-option" (if selected then "selected" else "normal"), Att "type" "button", Att "role" "option",
   Att "tabindex" "-1", Att "aria-selected" (if selected then "true" else "false"), chipSize,
   G.utilities [G.Cursor G.PointerCursor, G.BorderWidth (G.Px 1), G.BorderStyle G.SolidBorder,
     G.BorderColour (G.ThemeColour (if selected then G.Ink else G.Line)), G.Radius (G.Px 999),
     G.PaddingX (G.Px 12), G.PaddingY (G.Px 2), G.FontSize (G.Px 13),
     G.Background (G.ThemeColour (if selected then G.Ink else G.Card)),
     G.Foreground (G.ThemeColour (if selected then G.Bg else G.Dim))],
   G.hover (if selected then Nil else [G.Foreground (G.ThemeColour G.Ink), G.BorderColour (G.ThemeColour G.Line)])] Nil.

# `keep`: how many cards this tab's writer remembers, this page's and then the
# ones it drew most recently.  The writer's cache also holds its own render
# statistics, which the admin pane shows.
noRender = { st = noStat, hits = 0, misses = 0, kept = 0 }.
view keep sid v old = case old of (cardsOld, rs) ->
  (case v.signed == 0 of
    True -> (G.renderStyled (root v [loginView v]), old)
  | False ->
      t0 = Sys.timeUs Unit;
      (case VC.many (fn it -> "{it.id}") itemCard v.items (VC.begin "inventory-card-v1" verify cardsOld) of (cards, cc) ->
        out = G.renderStyled (root v (signedIn v cards rs));
        kept = VC.retain keep cc;
        (h, mi, n) = VC.stats cc;
        (out, (kept, { st = note rs.st (Sys.timeUs Unit - t0), hits = rs.hits + h, misses = rs.misses + mi, kept = VC.size kept })))).
verify = Program.envOr "0" "INV_VIEW_VERIFY" == "1".

btn label attrs = El "button" (Cls "btn round px-3 py-2" :: touchSize :: attrs) [Txt label].
primary label attrs = El "button" (Cls "btn round px-3 py-2 glow ink bold" :: touchSize :: attrs) [Txt label].
field attrs = Inp (Cls "field w-full" :: inputSize :: touchSize :: attrs).
labelled label kid = El "label" [Cls "col gap-1 grow min-w-0"] [El "div" [Cls "text-xs upper dim"] [Txt label], kid].

loginView v =
  El "div" [Cls "col gap-3 p-6 panel round mt-4"]
    [ El "div" [Cls "text-xs upper dim"] [Txt "home inventory"]
    , El "div" [Cls "text-2xl bold"] [Txt "Sign in"]
    , field [G.bind @Client.user, Att "placeholder" "name", Att "autocomplete" "username", Att "autocapitalize" "none", Att "maxlength" "16"]
    , field [G.bind @Client.pw, G.OnEnter (G.wireOpen codec (Login "")) "user,pw", Att "type" "password", Att "placeholder" "password", Att "autocomplete" "current-password"]
    , primary "sign in" [G.OnClick (G.wireOpen codec (Login "")) "user,pw"]
    , El "div" [Cls "warm text-sm"] [Dyn v.toast] ].

signedIn v cards rs =
  [ header v
  , El "div" [Cls "toast ok"] [Dyn (roleText v "ok")]
  , El "div" [Cls "toast warn"] [Dyn (roleText v "warn")]
  , itemsPane v cards
  , housePane v
  , adminPane v rs ].
roleText v role | strEq v.role role = v.toast.
roleText v role = "".

# on a phone the title takes its own line and the pane buttons go below it
header v =
  El "div" [Cls "row center gap-2 wrap"]
    [ El "div" [Cls "col grow min-w-0", G.narrow [G.Basis (G.Pct 100)]]
        [ El "div" [Cls "text-xs upper dim"] [Txt "home inventory"]
        , El "div" [Cls "text-2xl bold tabular"] [Dyn (things v.total)] ]
    , El "button" [Cls "btn pill px-3 py-2", touchSize, G.setTo @Client.pane "items", Att "data-on" "pane:items"] [Txt "items"]
    , El "button" [Cls "btn pill px-3 py-2", touchSize, G.setTo @Client.pane "house", Att "data-on" "pane:house"] [Txt "household"]
    , El "button" [Cls "btn pill px-3 py-2", touchSize, G.setTo @Client.pane "admin", Att "data-on" "pane:admin"] [Txt "admin"] ].
things 1 = "1 thing".
things n = "{n} things".

itemsPane v cards =
  El "div" [Cls "col gap-3", G.showIf @Client.pane "items"]
    ( El "div" [Cls "row gap-2 center"]
        [ Inp [Cls "field grow min-w-0", inputSize, touchSize, G.bind @Client.q, now, Att "type" "search", Att "placeholder" "search names, places, notes, tags",
               Att "autocomplete" "off", Att "autocapitalize" "none"]
        , primary "+ add" [G.send codec New] ]
    :: El "div" [Cls "row gap-2 wrap center text-sm"]
        [ El "span" [Cls "dim"] [Txt "sort"], sortBtn "recent" "recent", sortBtn "name" "a-z", sortBtn "place" "by place"
        , El "button" [Cls "btn pill px-3", chipSize, G.ShowIf "q", G.setTo @Client.q "", now] [Txt "clear search"] ]
    :: chipRow (List.map (fn p -> El "button" [Cls "btn pill px-3 text-sm flex-none", chipSize, G.setTo @Client.q (lower p), now] [Txt p]) v.places)
    :: chipRow (List.map (fn t -> El "button" [Cls "btn pill px-3 text-sm dim flex-none", chipSize, G.setTo @Client.q t, now] [Txt "#{t}"]) v.tags)
    :: (case v.editing == 0 of True -> [editor v] | False -> Nil)
    + [ El "div" [Cls "text-sm dim", Att "id" "inv-list"] [Dyn (countText v)]
      , G.key "items" (El "div" [Cls "col gap-3"] (case List.isEmpty cards of True -> [empty v] | False -> inPlace v cards))
      , pager v ]).
# the pager, when there is more than one page
pager v | v.pages <= 1 = El "span" Nil Nil.
pager v =
  El "div" [Cls "row center gap-2"]
    [ pageBtn "previous" (v.page - 1) (v.page == 0)
    , El "div" [Cls "grow text-center text-sm dim tabular"] [Dyn "page {v.page + 1} of {v.pages}"]
    , pageBtn "next" (v.page + 1) (v.page + 1 >= v.pages) ].
pageBtn label n off = El "button" [Cls "btn round px-3 py-2", touchSize,
                                   G.utilities (if off then [G.Opacity 35, G.PointerEvents G.PointerNone] else Nil),
                                   G.send codec (Page n), Att "data-pager" ""] [Txt label].
# the item being edited is its editor, where its card was
inPlace v cards | v.editing <= 0 = cards.
inPlace v cards = List.zipWith (fn it card -> (case it.id == v.editing of True -> G.key "edit-{it.id}" (editor v) | False -> card)) v.items cards.
# what changes the search is mirrored at once (std/livejs data-sync-now), not
# on the next tick: the list is what someone is waiting to see
now = Att "data-sync-now" "".
sortBtn key label = El "button" [Cls "btn pill px-3", chipSize, G.setTo @Client.sort key, now, Att "data-on" "sort:{key}"] [Txt label].
countText v | v.shown == 0 = "".
countText v =
  range = (case v.pages <= 1 of True -> "" | False -> "{v.first + 1}-{v.first + List.length v.items} of ");
  case strlen v.q == 0 of
    True -> (case v.pages <= 1 of True -> "" | False -> "{range}{v.total}")
  | False -> "{range}{v.shown} matching \"{v.q}\"".
empty v | v.total == 0 = El "div" [Cls "card round p-6 text-center dim"] [Txt "Nothing here yet. Add the first thing with + add."].
empty v = El "div" [Cls "card round p-6 text-center dim"] [Txt "Nothing matches."].

# a tap on a place or a tag searches for it; a row scrolls sideways on a phone
chipRow kids = El "div" [Cls "row gap-2", G.utilities [G.OverflowX G.OverflowAuto,
  G.PaddingBottom (G.Px 4), G.ScrollbarWidth G.ScrollbarThin]] kids.

editor v =
  El "div" [Cls "col gap-3 panel round p-4"]
      [ El "div" [Cls "text-lg bold"] [Txt (case v.editing == 0 of True -> "Add an item" | False -> "Edit item")]
      , labelled "name" (field [G.bind @Client.name, Att "placeholder" "e.g. USB-C cable", Att "maxlength" "120"])
      , El "div" [Cls "row gap-2 narrow:col"]
          [ labelled "room or place" (field [G.bind @Client.loc, Att "data-ac" "loc", Att "placeholder" "e.g. study", Att "maxlength" "60", Att "autocomplete" "off"])
          , labelled "spot" (field [G.bind @Client.sub, Att "data-ac" "sub", Att "placeholder" "e.g. top drawer", Att "maxlength" "60", Att "autocomplete" "off"]) ]
      , labelled "notes" (El "textarea" [Cls "field w-full", inputSize, G.bind @Client.desc, Att "rows" "3", Att "maxlength" "2000"] Nil)
      , labelled "tags, comma separated" (field [G.bind @Client.tags, Att "data-ac" "tags", Att "placeholder" "e.g. electronics, cables", Att "autocapitalize" "none", Att "autocomplete" "off"])
      , El "div" [Cls "row gap-2 wrap"] (List.map (fn t -> El "button" [Cls "btn pill px-3 text-sm", chipSize, G.send codec (AddTag t)] [Txt t]) v.quick)
      , El "div" [Cls "row gap-2"] [ primary (case v.editing == 0 of True -> "add item" | False -> "save") [G.send codec Save, Cls "grow"],
                                     btn "cancel" [G.send codec Cancel] ] ].

itemCard : Item -> G.Node .
itemCard it =
  El "div" [Cls "col gap-2 card round p-4"]
    ( El "div" [Cls "row center gap-2"]
        [ El "div" [Cls "text-lg bold grow min-w-0"] [Txt it.name]
        , El "button" [Cls "btn pill px-3 text-sm", chipSize, G.send codec (Edit it.id)] [Txt "edit"]
        , El "button" [Cls "btn pill px-3 text-sm", chipSize, G.setTo @Client.confirm "{it.id}"] [Txt "delete"] ]
    :: El "div" [Cls "row gap-2 center wrap"] (El "span" [Cls "badge ok"] [Txt it.loc] :: (case strlen it.sub == 0 of True -> Nil | False -> [El "span" [Cls "badge"] [Txt it.sub]]))
    :: (case strlen it.desc == 0 of True -> Nil | False -> [El "div" [Cls "text-sm pre"] [Txt it.desc]])
    + (case List.isEmpty it.tags of True -> Nil | False -> [El "div" [Cls "row gap-1 wrap"] (List.map (fn t -> El "button" [Cls "btn pill px-3 text-xs dim", chipSize, G.setTo @Client.q t, now] [Txt "#{t}"]) it.tags)])
    + [ El "div" [Cls "text-xs dim"] [Txt (metaText it)]
      , El "div" [Cls "row gap-2 center wrap", G.showIf @Client.confirm "{it.id}"]
          [ El "span" [Cls "warm text-sm grow"] [Txt "Delete {it.name}?"]
          , El "button" [Cls "btn round px-3 py-2 bad", touchSize, G.send codec (Delete it.id)] [Txt "delete"]
          , btn "keep" [G.setTo @Client.confirm ""] ] ]).
metaText it =
  moved = (case it.moves of Nil -> "" | mv :: r -> " · moved from {mv.from} on {Clock.date mv.at}");
  "added {Clock.date it.created} · updated {Clock.date it.at} by {it.by}{moved}".

housePane v =
  El "div" [Cls "col gap-3", G.showIf @Client.pane "house"]
    [ El "div" [Cls "col gap-3 card round p-4"]
        [ El "div" [Cls "text-lg bold"] [Txt "Signed in as {v.user}"]
        , El "div" [Cls "text-sm dim"] [Dyn (devicesText v.devices)]
        , El "div" [Cls "row gap-2 wrap"]
            [ btn "sign out" [G.send codec Logout], btn "sign out my other devices" [G.send codec ForgetDevices]
            , btn "day / night" [G.send codec Theme] ] ]
    , El "div" [Cls "col gap-3 card round p-4"]
        [ El "div" [Cls "text-lg bold"] [Txt "Change my password"]
        , field [G.bind @Client.npw, Att "type" "password", Att "placeholder" "new password, 8 or more characters", Att "autocomplete" "new-password"]
        , btn "change password" [G.OnClick (G.wireOpen codec (Password "")) "npw"] ]
    , El "div" [Cls "col gap-3 card round p-4"]
        [ El "div" [Cls "text-lg bold"] [Txt "Members"]
        , El "div" [Cls "row gap-2 wrap"] (List.map (fn n -> El "span" [Cls "badge"] [Txt n]) v.members)
        , El "div" [Cls "row gap-2 narrow:col"]
            [ field [G.bind @Client.mname, Att "placeholder" "name", Att "autocapitalize" "none", Att "maxlength" "16"]
            , field [G.bind @Client.mpw, Att "type" "password", Att "placeholder" "their password", Att "autocomplete" "new-password"] ]
        , btn "add member" [G.OnClick (G.wireOpen codec (AddMember "")) "mname,mpw"] ]
    , El "div" [Cls "text-xs dim"] [Dyn "{v.events} changes in the log · {v.online} signed in now · up since {Clock.stamp v.booted}"] ].
# ---- the admin pane: the numbers, the console, the profile ----------------------------------------

adminPane v rs =
  El "div" [Cls "col gap-3", G.showIf @Client.pane "admin", Att "data-console-scope" ""]
    [ El "div" [Cls "row gap-2 wrap"]
        [ watch "items" "{v.total}", watch "places" "{v.nplaces}", watch "tags" "{v.ntags}", watch "members" "{List.length v.members}"
        , watch "devices" "{v.ndevices}", watch "online" "{v.online}", watch "log lines" "{v.events}", watch "since" (Clock.stamp v.booted) ]
    , El "div" [Cls "row gap-2 center"]
        [ Inp [Cls "field grow mono min-w-0", inputSize, touchSize, G.bind @Client.cmd, G.enterWith codec (Admin "") @Client.cmd, Att "data-console" "",
               Att "placeholder" "help | find usb | move 12 -> Room 2 / desk", Att "autocapitalize" "none", Att "autocomplete" "off", Att "spellcheck" "false"]
        , btn "run" [G.sendWith codec (Admin "") @Client.cmd, Att "data-console-run" ""] ]
    , El "div" [Cls "mono text-sm pre show-empty card round p-3 console", Att "data-console-output" "",
        G.utilities [G.MinHeight (G.Px 120), G.MaxHeight (G.Vh 50), G.Overflow G.OverflowAuto]] [Dyn (consoleText v.con)]
    , El "div" [Cls "text-xs upper dim"] [Txt "profile"]
    , El "div" [Cls "mono text-xs card round p-3", G.utilities [G.WhiteSpace G.PreSpace, G.OverflowX G.OverflowAuto]] [Dyn (profileText v rs)]
    , El "div" [Cls "row gap-2 center dim text-xs"] [Txt "browser round trip: ", El "span" [Att "id" "inv-rtt"] [Txt "measuring"]] ].
consoleText Nil = "type help and press enter".
consoleText con = S.join "\n" (List.reverse con).
watch label v =
  El "div" [Cls "col card round p-2", G.utilities [G.MinWidth (G.Px 96)]] [El "div" [Cls "text-xs upper dim"] [Txt label], El "div" [Cls "tabular bold"] [Dyn v]].

profileText v rs =
  S.join "\n"
    ( "update, per kind of event ({v.prof.nev} events since boot)"
      :: List.map (fn e -> (case e of (k, st) -> "  {statLine k st}")) v.prof.upd
      + ( "disk"
       :: "  {statLine "append" v.prof.flush}"
       :: "  boot: {v.prof.bootLines} lines folded in {v.prof.bootUs} us"
       :: "this tab's writer"
       :: "  {statLine "render" rs.st}"
       :: "  card cache: {rs.hits} hits, {rs.misses} misses; {rs.kept} cards kept of at most {v.keep} ({v.pageSize} a page)"
       :: "runtime"
       :: memLines v.mem v.grows
       + ("  harts {v.harts}, tabs signed in {v.online}" :: Nil))).
memLines mem (grows, mib) = case mem of
    arena :: free :: reqs :: waits :: direct :: frees :: denied :: inl :: x ->
      "  arena {arena / 1024} MiB reserved, {(arena - free) / 1024} MiB in use, grown {grows} times ({mib} MiB)"
      :: "  memory actor: {reqs} requests, {waits} waits, {direct} direct, {inl} inline, {frees} frees, {denied} denied" :: Nil
  | x -> "  memory: not sampled" :: Nil.

devicesText 1 = "this is your only signed-in device".
devicesText n = "{n} devices signed in as you".

# The stylesheet is a function of the tree, so it is made from a SAMPLE that
# shows everything -- the editor, a card with every part, both panes, the
# sign-in -- not from the signed-out page the server first sends.
sampleItem = { id = 1, name = "USB-C cable", loc = "study", sub = "top drawer", desc = "two of them", tags = ["cables"],
               created = 0, at = 0, by = "sam", moves = [{ at = 0, from = "garage" }] }.
sampleView = { noView | signed = 1, user = "sam", toast = "sample", role = "ok", editing = 0, items = [sampleItem], total = 41, shown = 41,
               page = 1, pages = 3, first = 20, q = "x", places = ["study"], tags = ["cables"], quick = quickTags, members = ["sam"], devices = 2,
               con = ["> help"] }.
cssAll v = G.cssFor (El "div" Nil [root sampleView (signedIn sampleView [itemCard sampleItem, empty sampleView] noRender), loginView sampleView]).

# The page's own script: the remembered device.  Once the client has painted,
# the token from localStorage goes into the hidden `tok` input (so it is
# mirrored, and the server signs this page in); afterwards whatever the server
# puts in `tok` -- a new token at sign-in, "" at sign-out or when it no longer
# knows the token -- is what localStorage keeps.
script = strcat rttScript (strcat (LJ.src 0) "
(function () \{
  var KEY = 'inventory-device', ready = false;
  function stored() \{ try \{ return localStorage.getItem(KEY) || ''; } catch (e) \{ return ''; } }
  function keep(t) \{ try \{ if (t) localStorage.setItem(KEY, t); else localStorage.removeItem(KEY); } catch (e) \{} }
  document.addEventListener('live:locals', function (e) \{
    if (!ready) return;
    var t = e.detail.tok || '';
    if (t !== stored()) keep(t);
  });
  var t = stored(), el = document.querySelector('[data-input=\"tok\"]');
  if (t && el) \{ el.value = t; el.dispatchEvent(new Event('input')); }
  ready = true;
})();
" + autocomplete + pagerScript + consoleScript + pendingScript).

# The console behaves like a terminal: the newest output is at the bottom and in
# view, and the arrow keys walk back through the commands this browser ran.
consoleScript = Console.script {scope = B.Attribute "data-console-scope", input = B.Attribute "data-console",
  run = B.Attribute "data-console-run", output = B.Attribute "data-console-output",
  storageKey = "inventory-console", limit = 50}.
pagerScript = Console.pager (B.Id "lv-root") (B.Attribute "data-pager") (B.Id "inv-list").
# Never frozen.  A button pressed gives way at once.  Anything that waits on
# the server -- a message, a search -- shows a thin bar at the top, pulses the
# button and fades the list if nothing has come back after 100 ms, until the
# next frame does (or 2.5 s, for an
# action that changed nothing the page shows).  A dropped connection (a phone
# waking, a network change) shows "reconnecting" until the client is back:
# std/livejs writes its link state into #lv-link, which lives here, outside
# the live root, so no render replaces it.  Animations are the Web Animations
# API, so the app still has no CSS text.
pendingScript = "
(function () \{
  var root = document.getElementById('lv-root');
  function theme(v) \{ var p = root.querySelector('[data-theme]'); return p ? getComputedStyle(p).getPropertyValue(v) : ''; }
  var bar = document.createElement('div'), anim = null, showT = null, failT = null, pulses = [], faded = null;
  bar.style.cssText = 'position:fixed;top:0;left:0;height:3px;width:30%;z-index:60;pointer-events:none;display:none;border-radius:0 3px 3px 0;opacity:.6';
  document.body.appendChild(bar);
  function done() \{
    clearTimeout(showT); showT = null; clearTimeout(failT); failT = null;
    if (anim) \{ anim.cancel(); anim = null; }
    bar.style.display = 'none';
    pulses.forEach(function (a) \{ a.cancel(); }); pulses = [];
    if (faded) \{ faded.style.opacity = ''; faded = null; }
  }
  function waiting(el, ms) \{
    clearTimeout(failT); failT = setTimeout(done, ms);
    if (showT || anim) return;
    showT = setTimeout(function () \{
      showT = null;
      bar.style.background = theme('--ink') || '#888';
      bar.style.display = 'block';
      anim = bar.animate([\{ transform: 'translateX(-100%)' }, \{ transform: 'translateX(340%)' }], \{ duration: 900, iterations: Infinity, easing: 'ease-in-out' });
      if (el && document.contains(el)) pulses.push(el.animate([\{ opacity: 1 }, \{ opacity: .45 }, \{ opacity: 1 }], \{ duration: 800, iterations: Infinity }));
      /* the list on show is about to change: say so (a render replaces it anyway) */
      faded = root.querySelector('[data-lv-key=\"items\"]');
      if (faded) \{ faded.style.transition = 'opacity .15s'; faded.style.opacity = '.55'; }
    }, 100);
  }
  document.addEventListener('live:frame', done);
  /* every button gives way the moment it is pressed, client-only ones too */
  document.addEventListener('pointerdown', function (e) \{
    var b = e.target.closest && e.target.closest('#lv-root button');
    if (b) b.animate([\{ transform: 'scale(1)' }, \{ transform: 'scale(.94)' }, \{ transform: 'scale(1)' }], \{ duration: 160, easing: 'ease-out' });
  }, true);
  /* what goes to the server: a message (data-click), a search (data-sync-now) */
  document.addEventListener('click', function (e) \{
    var b = e.target.closest && e.target.closest('#lv-root [data-click], #lv-root button[data-sync-now]');
    if (b) waiting(b, 2500);
  }, true);
  document.addEventListener('input', function (e) \{
    if (e.target.hasAttribute && e.target.hasAttribute('data-sync-now')) waiting(null, 1200);
  }, true);
  document.addEventListener('keydown', function (e) \{
    if (e.key === 'Enter' && e.target.hasAttribute && e.target.hasAttribute('data-enter')) waiting(null, 2500);
  }, true);
  /* the link */
  var link = document.createElement('span');
  link.id = 'lv-link';
  link.style.cssText = 'position:fixed;top:10px;left:50%;transform:translateX(-50%);z-index:61;display:none;padding:4px 12px;border-radius:999px;font-size:12px;' +
    'background:#3a2a10;border:1px solid #7a5a18;color:#ffc65c';
  document.body.appendChild(link);
  new MutationObserver(function () \{
    var up = link.textContent === 'live';
    link.style.display = up ? 'none' : 'block';
    if (!up) link.textContent.indexOf('reconnecting') < 0 && (link.textContent = 'reconnecting');
  }).observe(link, \{ childList: true, characterData: true, subtree: true });
})();
".
# Shared generated monitor, installed before the client opens its socket.
# Observes successful Live sends and accepted frames through explicit events.
rttScript = Metrics.script (B.Id "inv-rtt") "".

# The editor's autocomplete, in the page so it answers each keystroke at once.
# An input with data-ac=loc|sub|tags is completed from the lists the server
# sent ('live:suggest'); tags complete the part after the last comma.  The
# box lives outside the live root and clones FP-RISC-owned appearance
# prototypes inside its explicit data-ac-scope. Taking a suggestion fires
# 'input', which is how the client hears the change (and mirrors it).
autocomplete = "
(function () \{
  var lists = \{ loc: [], sub: \{}, tags: [] }, cur = null, opts = [], sel = 0, moved = false, touchAgain = false;
  var box = document.createElement('div');
  box.style.display = 'none';
  document.body.appendChild(box);
  document.addEventListener('live:suggest', function (e) \{
    try \{ lists = JSON.parse(e.detail); } catch (x) \{}
    refresh();
  });
  function kind(el) \{ return el && el.getAttribute ? el.getAttribute('data-ac') : null; }
  function valueOf(name) \{ var scope = cur && cur.closest('[data-ac-scope]'); var e = scope && scope.querySelector('[data-input=\"' + name + '\"]'); return e ? e.value : ''; }
  function part(el) \{
    var v = el.value;
    return (kind(el) === 'tags' ? v.slice(v.lastIndexOf(',') + 1) : v).trim().toLowerCase();
  }
  function pool(el) \{
    var k = kind(el), sub = lists.sub || \{};
    if (k === 'loc') return lists.loc || [];
    if (k === 'sub') \{
      var here = sub[valueOf('loc').trim().toLowerCase()] || [];
      return here.concat((sub['*'] || []).filter(function (x) \{ return here.indexOf(x) < 0; }));
    }
    if (k === 'tags') \{
      var have = el.value.split(',').slice(0, -1).map(function (t) \{ return t.trim().toLowerCase(); });
      return (lists.tags || []).filter(function (t) \{ return have.indexOf(t) < 0; });
    }
    return [];
  }
  /* what starts with the typed text, then what has a word starting with it, then the rest that contains it */
  function rank(el) \{
    var p = part(el), all = pool(el), a = [], b = [], c = [];
    all.forEach(function (x) \{
      var l = x.toLowerCase();
      if (l === p) return;
      if (!p || l.indexOf(p) === 0) a.push(x);
      else if (l.indexOf(' ' + p) >= 0) b.push(x);
      else if (l.indexOf(p) >= 0) c.push(x);
    });
    return a.concat(b, c).slice(0, 6);
  }
  function hide() \{ box.style.display = 'none'; opts = []; }
  function refresh() \{
    if (!cur || !document.contains(cur) || document.activeElement !== cur) \{ hide(); return; }
    var scope = cur.closest('[data-ac-scope]');
    var prototypes = scope && scope.querySelector('[data-ac-prototypes]');
    var frame = prototypes && prototypes.querySelector('[data-ac-frame]');
    if (!frame) \{ hide(); return; }
    opts = rank(cur);
    if (sel >= opts.length) sel = 0;
    if (!opts.length) \{ hide(); return; }
    Array.from(box.attributes).forEach(function (a) \{ if (a.name !== 'style') box.removeAttribute(a.name); });
    Array.from(frame.attributes).forEach(function (a) \{ box.setAttribute(a.name, a.value); });
    box.setAttribute('data-ac-popup', '');
    box.replaceChildren();
    opts.forEach(function (o, i) \{
      var b = prototypes.querySelector('[data-ac-option=\"' + (i === sel ? 'selected' : 'normal') + '\"]').cloneNode(true);
      b.textContent = o;
      b.addEventListener('pointerdown', function (e) \{ e.preventDefault(); take(i); });
      box.appendChild(b);
    });
    var hint = prototypes.querySelector('[data-ac-hint]').cloneNode(true);
    hint.textContent = matchMedia('(pointer: coarse)').matches ? 'tap the field again for the first' : 'tab takes the highlighted one';
    box.appendChild(hint);
    var r = cur.getBoundingClientRect();
    box.style.left = (r.left + scrollX) + 'px';
    box.style.top = (r.bottom + scrollY + 4) + 'px';
    box.style.width = r.width + 'px';
    box.style.display = 'flex';
  }
  function take(i) \{
    var o = opts[i], v = cur.value;
    if (o === undefined) return;
    if (kind(cur) === 'tags') \{
      var head = v.slice(0, v.lastIndexOf(',') + 1).trim();
      cur.value = (head ? head + ' ' : '') + o + ', ';
    } else cur.value = o;
    sel = 0; moved = false;
    cur.dispatchEvent(new Event('input', \{ bubbles: true }));
    if (kind(cur) === 'tags') refresh(); else hide();
  }
  document.addEventListener('focusin', function (e) \{
    if (kind(e.target)) \{ cur = e.target; sel = 0; moved = false; refresh(); } else \{ cur = null; hide(); }
  });
  document.addEventListener('focusout', function (e) \{ if (e.target === cur) setTimeout(refresh, 0); });
  document.addEventListener('input', function (e) \{ if (e.target === cur) \{ sel = 0; moved = false; refresh(); } });
  addEventListener('resize', refresh);
  addEventListener('scroll', refresh, true);
  document.addEventListener('live:frame', refresh);
  addEventListener('pagehide', hide);
  /* Tab takes a suggestion once you have typed, or chosen one with the arrows;
     on an empty field Tab moves on as usual */
  document.addEventListener('keydown', function (e) \{
    if (!cur || e.target !== cur || !opts.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') \{
      sel = (sel + (e.key === 'ArrowDown' ? 1 : opts.length - 1)) % opts.length; moved = true;
      e.preventDefault(); refresh();
    } else if (e.key === 'Tab' && !e.shiftKey && (part(cur) || moved)) \{
      e.preventDefault(); take(sel);
    } else if (e.key === 'Enter' && moved) \{
      e.preventDefault(); take(sel);
    } else if (e.key === 'Escape') hide();
  }, true);
  /* on a touch screen, tapping the field you are already in takes the first */
  document.addEventListener('pointerdown', function (e) \{
    touchAgain = e.pointerType !== 'mouse' && kind(e.target) && e.target === cur && document.activeElement === cur;
  }, true);
  document.addEventListener('click', function (e) \{
    if (touchAgain && e.target === cur && opts.length) take(sel);
    touchAgain = false;
  }, true);
})();
".

# ---- the old app's items: a Firestore REST listing ------------------------------------------------
# GET .../documents/inventory?pageSize=1000 saved to a file.  Items already
# here (same name and place) are skipped, so an import can be run again.

importFirestore path store = case File.readText path of
    Err why -> Program.fail 1 "inventory: {why}"
  | Ok text -> (case Json.parse text of
      Err why -> Program.fail 1 "inventory: {path}: {why}"
    | Ok v ->
        m = boot store;
        docs = Option.withDefault Nil (Option.andThen Json.asList (Json.field "documents" v));
        its = List.filterMap fsItem docs;
        fresh = List.filter (fn it -> not (List.any (fn x -> strEq (lower x.name) (lower it.name) and strEq (lower (place x)) (lower (place it))) m.items)) its;
        numbered = List.indexedMap (fn i it -> { it | id = m.nextId + i }) fresh;
        _ = (case File.appendText store (S.concat (List.map (fn it -> "{itemLine it "import" it.at}\n") numbered)) of
               Ok _ -> Unit | Err why -> Program.fail 1 "inventory: {why}");
        _ = print "[inventory] imported {List.length numbered} items ({List.length its - List.length fresh} already here)";
        0).
fsStr k doc = Option.withDefault "" (Option.andThen Json.asString (Json.at ["fields", k, "stringValue"] doc)).
fsTime k doc = isoSecs (Option.withDefault "" (Option.andThen Json.asString (Json.at ["fields", k, "timestampValue"] doc))).
fsTags doc = case Option.andThen Json.asList (Json.at ["fields", "tags", "arrayValue", "values"] doc) of
    Option.Some xs -> List.filterMap (fn x -> Option.andThen Json.asString (Json.field "stringValue" x)) xs
  | Option.None -> Nil.
fsItem doc =
  name = S.trim (fsStr "name" doc);
  made = fsTime "createdAt" doc;
  upd = fsTime "updatedAt" doc;
  case strlen name == 0 of
    True -> Option.None
  | False -> Option.Some { id = 0, name = clip 120 name, loc = clip 60 (S.trim (fsStr "location" doc)), sub = clip 60 (S.trim (fsStr "subLocation" doc)),
                           desc = clip 2000 (S.trim (fsStr "description" doc)), tags = tagsOf (S.join "," (fsTags doc)),
                           created = made, at = (case upd == 0 of True -> made | False -> upd), by = "import", moves = Nil }.
# "2025-06-01T12:34:56.789Z" -> epoch seconds (UTC)
isoSecs s | strlen s < 19 = 0.
isoSecs s = days (num (substr s 0 4)) (num (substr s 5 2)) (num (substr s 8 2)) * 86400
          + num (substr s 11 2) * 3600 + num (substr s 14 2) * 60 + num (substr s 17 2).
days y0 mo d =
  y = (case mo <= 2 of True -> y0 - 1 | False -> y0);
  era = y / 400;
  yoe = y - era * 400;
  mp = (case mo > 2 of True -> mo - 3 | False -> mo + 9);
  doy = (153 * mp + 2) / 5 + d - 1;
  era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468.

# ---- a member from the command line ------------------------------------------------------------

addMemberCli store name0 pw =
  name = lower (S.trim name0);
  m = boot store;
  case not (wordy name) of
    True -> Program.fail 2 "inventory: a member's name is 1 to 16 letters or digits"
  | False -> (case strlen pw < 8 of
      True -> Program.fail 2 "inventory: give a password of 8 or more characters (--password or INV_PASSWORD)"
    | False ->
        salt = randomHex Unit;
        _ = (case File.appendText store "{memberLine name salt (pwHash salt pw) (Clock.now Unit)}\n" of
               Ok _ -> Unit | Err why -> Program.fail 1 "inventory: {why}");
        _ = print "[inventory] {name} {case hasMember m name of True -> "has a new password" | False -> "is a member"}";
        0).

# ---- main ---------------------------------------------------------------------------------------------

setting d k v = case Decode.run (Decode.field k d) v of
    Ok x -> x
  | Err why -> Program.fail 2 "inventory: {why}".

main = case Config.load { defaults = Json.object [("port", Json.Integer 6720), ("address", Json.Text "127.0.0.1"), ("store", Json.Text "inventory.log"),
                                                  ("page-size", Json.Integer 20), ("cache-items", Json.Integer 200),
                                                  ("member", Json.Text ""), ("password", Json.Text ""), ("import", Json.Text "")],
                          file = Option.None, envPrefix = "INV_", args = Program.args Unit } of
    Err why -> Program.fail 2 "inventory: {why}"
  | Ok v ->
      store = setting Decode.string "store" v;
      member = setting Decode.string "member" v;
      from = setting Decode.string "import" v;
      (case strlen member > 0 of
        True -> addMemberCli store member (setting Decode.string "password" v)
      | False -> (case strlen from > 0 of
          True -> importFirestore from store
        | False ->
            port = setting Decode.int "port" v;
            address = setting Decode.string "address" v;
            size = imax 1 (setting Decode.int "page-size" v);
            # at least a page: the cards on show are always kept
            keep = imax size (setting Decode.int "cache-items" v);
            # the inventory is the log, folded at boot; std/live's own store holds
            # nothing of the model, it is there because the driver wants one
            cfg = { address = address, port = port, title = "Home inventory", store = "{store}.kvlog", journal = False,
                    script = script, watch = Nil, rebuild = Nil, restart = Nil };
            _ = Live.serveProjected cfg { init = boot store, update = update store, subs = subs, fields = Nil, codec = codec,
                                          project = project size keep, same = (fn a b -> a == b),
                                          view = view keep, cache = (VC.empty Unit, noRender), css = cssAll };
            0)).
